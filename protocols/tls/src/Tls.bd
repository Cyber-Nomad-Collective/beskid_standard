/// Tls package root: TLS 1.3 (RFC 8446) client and server.
pub mod Tls.Wire;
pub mod Tls.Alert;
pub mod Tls.TlsErrors;
pub mod Tls.Suites;
pub mod Tls.KeySchedule;
pub mod Tls.Record;
pub mod Tls.Emit;
pub mod Tls.Messages;
pub mod Tls.Der;
pub mod Tls.PeerKeys;
pub mod Tls.TlsPk;
pub mod Tls.TlsConfig;
pub mod Tls.PeerVerify;
pub mod Tls.Handshake;
pub mod Tls.Connection;
pub mod Tls.TlsStream;

use Core.Optional.Option;
use Core.Results;
use Core.Time.Deadline;
use Network.Tcp.TcpStream;
use Tls.TlsConfig;
use Tls.TlsErrors;
use Tls.TlsStream;

pub i64 PackageVersion() { return 1_i64; }

/// TLS 1.3 client handshake over `tcp`. The deadline bounds the handshake; on failure the
/// TCP stream is closed and the typed error returned.
pub Result<TlsStream, TlsError> Connect(TcpStream tcp, TlsClientConfig config, Option<Deadline> deadline) {
    return TlsStream.Connect(tcp, config, deadline);
}

/// TLS 1.3 server handshake over an accepted `tcp` stream.
pub Result<TlsStream, TlsError> Accept(TcpStream tcp, TlsServerConfig config, Option<Deadline> deadline) {
    return TlsStream.Accept(tcp, config, deadline);
}
