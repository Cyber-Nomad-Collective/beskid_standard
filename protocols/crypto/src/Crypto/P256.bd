/// NIST P-256 (secp256r1, SEC 2 section 2.4.2): field and scalar arithmetic, points, ECDH.
///
/// Points are projective (X:Y:Z) with coordinates in Montgomery form; the identity is
/// (0:1:0). Addition and doubling are the complete a = -3 formulas of Renes, Costello and
/// Batina, "Complete addition formulas for prime order elliptic curves" (ePrint 2015/1060,
/// algorithms 4 and 6), so no input needs a special case. Scalar multiplication is a fixed
/// 4-bit window with a branch-free table scan: its time depends on neither the scalar nor
/// the point. Public keys are uncompressed SEC 1 encodings (0x04 || X || Y, 65 bytes).
///
/// All field values live in one `ModArith` workspace (see the workspace notes there): a
/// point is a register of three consecutive slots, addressed by limb offset.
use Core.Bytes.Slice;
use Core.Results;
use Crypto.BigNat;
use Crypto.ModArith;
use Crypto.PkErrors;
use Crypto.Scratch;

/// The field and scalar workspaces. One `Curve` must not be shared between threads.
pub type Curve {
    /// Field workspace modulo p with the slots and point registers below.
    pub u32[] w,
    /// Scalar workspace modulo the group order n with `ScalarSlots()` slots.
    pub u32[] s,
}

pub i64 ScalarSlots() { return 4_i64; }

/// Field slots: the coefficient b, formula temporaries, general scratch, and point registers.
i64 Slot(i64 index) { return ModArith.WSlot(8_i64, index); }
i64 SlotB() { return Slot(0_i64); }
i64 SlotPowAcc() { return Slot(13_i64); }
i64 Scratch(i64 index) { return Slot(9_i64 + index); }
i64 RegisterCount() { return 36_i64; }

/// Limb offset of point register `index` (X, then Y at +8, then Z at +16).
pub i64 Reg(i64 index) { return Slot(14_i64 + 3_i64 * index); }
i64 RegAcc() { return Reg(0_i64); }
i64 RegPick() { return Reg(1_i64); }
/// Register holding the generator after `NewCurve`.
pub i64 RegGenerator() { return Reg(2_i64); }
/// A free register for callers.
pub i64 RegA() { return Reg(3_i64); }
/// The scalar multiplication accumulator; results may be written here (out == RegB()).
pub i64 RegB() { return RegAcc(); }
i64 TableP() { return Reg(4_i64); }
i64 TableQ() { return Reg(20_i64); }

/// Length of private keys, scalars and shared secrets.
pub i64 ScalarLength() { return 32_i64; }
/// Length of an uncompressed SEC 1 public key.
pub i64 PublicKeyLength() { return 65_i64; }

/// p = 2^256 - 2^224 + 2^192 + 2^96 - 1, little-endian limbs.
pub u32[] FieldPrime() { return [0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0_u32, 0_u32, 0_u32, 1_u32, 0xFFFFFFFF_u32]; }
/// The group order n.
pub u32[] Order() { return [0xFC632551_u32, 0xF3B9CAC2_u32, 0xA7179E84_u32, 0xBCE6FAAD_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0_u32, 0xFFFFFFFF_u32]; }
u32[] CoefficientB() { return [0x27D2604B_u32, 0x3BCE3C3E_u32, 0xCC53B0F6_u32, 0x651D06B0_u32, 0x769886BC_u32, 0xB3EBBD55_u32, 0xAA3A93E7_u32, 0x5AC635D8_u32]; }
u32[] GeneratorX() { return [0xD898C296_u32, 0xF4A13945_u32, 0x2DEB33A0_u32, 0x77037D81_u32, 0x63A440F2_u32, 0xF8BCE6E5_u32, 0xE12C4247_u32, 0x6B17D1F2_u32]; }
u32[] GeneratorY() { return [0x37BF51F5_u32, 0xCBB64068_u32, 0x6B315ECE_u32, 0x2BCE3357_u32, 0x7C0F9E16_u32, 0x8EE7EB4A_u32, 0xFE1A7F9B_u32, 0x4FE342E2_u32]; }

/// `m - 2` as 32 big-endian bytes: the Fermat inversion exponent for a prime `m`.
pub u8[] InverseExponent(u32[] m) {
    u32[] e = BigNat.Copy(m);
    BigNat.SubInPlace(e, [2_u32]);
    u8[] out = BigNat.ZeroBytes(32_i64);
    BigNat.WriteBytes(e, out, 0_i64, 32_i64);
    return out;
}

pub Result<Curve, PkError> NewCurve() {
    Result<u32[], PkError> fieldWs = ModArith.NewWorkspace(FieldPrime(), 14_i64 + 3_i64 * RegisterCount());
    Result<u32[], PkError> orderCtx = ModArith.NewWorkspace(Order(), ScalarSlots());
    return match fieldWs {
        Result::Error(error) => Result::Error(error),
        Result::Ok(w) => match orderCtx {
            Result::Error(error) => Result::Error(error),
            Result::Ok(sw) => {
                i64 n = 8_i64;
                ModArith.WLoad(w, n, SlotB(), CoefficientB());
                ModArith.WToMont(w, n, SlotB(), SlotB());
                i64 g = RegGenerator();
                ModArith.WLoad(w, n, g, GeneratorX());
                ModArith.WToMont(w, n, g, g);
                ModArith.WLoad(w, n, g + 8_i64, GeneratorY());
                ModArith.WToMont(w, n, g + 8_i64, g + 8_i64);
                ModArith.WToMont(w, n, g + 16_i64, ModArith.WOne(n));
                return Result::Ok(Curve { w: w, s: sw });
            },
        },
    };
}

/// Register `r` = the identity (0:1:0).
pub unit SetIdentity(u32[] w, i64 r) {
    ModArith.WSetSmall(w, 8_i64, r, 0_u32);
    ModArith.WToMont(w, 8_i64, r + 8_i64, ModArith.WOne(8_i64));
    ModArith.WSetSmall(w, 8_i64, r + 16_i64, 0_u32);
    return;
}

pub unit CopyReg(u32[] w, i64 dst, i64 src) { ModArith.WCopy(w, 24_i64, dst, src); return; }

/// 1 for the identity (Z = 0), else 0.
pub u32 IsIdentityBit(u32[] w, i64 r) { return ModArith.WIsZeroBit(w, 8_i64, r + 16_i64); }

/// `out = p + q`; complete, any inputs, `out` may alias either.
pub unit Add(u32[] w, i64 out, i64 p, i64 q) {
    i64 n = 8_i64;
    i64 b = SlotB();
    i64 t0 = Slot(1_i64); i64 t1 = Slot(2_i64); i64 t2 = Slot(3_i64); i64 t3 = Slot(4_i64); i64 t4 = Slot(5_i64);
    i64 x3 = Slot(6_i64); i64 y3 = Slot(7_i64); i64 z3 = Slot(8_i64);
    i64 px = p; i64 py = p + 8_i64; i64 pz = p + 16_i64;
    i64 qx = q; i64 qy = q + 8_i64; i64 qz = q + 16_i64;
    ModArith.WMul(w, n, t0, px, qx);
    ModArith.WMul(w, n, t1, py, qy);
    ModArith.WMul(w, n, t2, pz, qz);
    ModArith.WAdd(w, n, t3, px, py);
    ModArith.WAdd(w, n, t4, qx, qy);
    ModArith.WMul(w, n, t3, t3, t4);
    ModArith.WAdd(w, n, t4, t0, t1);
    ModArith.WSub(w, n, t3, t3, t4);
    ModArith.WAdd(w, n, t4, py, pz);
    ModArith.WAdd(w, n, x3, qy, qz);
    ModArith.WMul(w, n, t4, t4, x3);
    ModArith.WAdd(w, n, x3, t1, t2);
    ModArith.WSub(w, n, t4, t4, x3);
    ModArith.WAdd(w, n, x3, px, pz);
    ModArith.WAdd(w, n, y3, qx, qz);
    ModArith.WMul(w, n, x3, x3, y3);
    ModArith.WAdd(w, n, y3, t0, t2);
    ModArith.WSub(w, n, y3, x3, y3);
    ModArith.WMul(w, n, z3, b, t2);
    ModArith.WSub(w, n, x3, y3, z3);
    ModArith.WAdd(w, n, z3, x3, x3);
    ModArith.WAdd(w, n, x3, x3, z3);
    ModArith.WSub(w, n, z3, t1, x3);
    ModArith.WAdd(w, n, x3, t1, x3);
    ModArith.WMul(w, n, y3, b, y3);
    ModArith.WAdd(w, n, t1, t2, t2);
    ModArith.WAdd(w, n, t2, t1, t2);
    ModArith.WSub(w, n, y3, y3, t2);
    ModArith.WSub(w, n, y3, y3, t0);
    ModArith.WAdd(w, n, t1, y3, y3);
    ModArith.WAdd(w, n, y3, t1, y3);
    ModArith.WAdd(w, n, t1, t0, t0);
    ModArith.WAdd(w, n, t0, t1, t0);
    ModArith.WSub(w, n, t0, t0, t2);
    ModArith.WMul(w, n, t1, t4, y3);
    ModArith.WMul(w, n, t2, t0, y3);
    ModArith.WMul(w, n, y3, x3, z3);
    ModArith.WAdd(w, n, y3, y3, t2);
    ModArith.WMul(w, n, x3, t3, x3);
    ModArith.WSub(w, n, x3, x3, t1);
    ModArith.WMul(w, n, z3, t4, z3);
    ModArith.WMul(w, n, t1, t3, t0);
    ModArith.WAdd(w, n, z3, z3, t1);
    // x3 y3 z3 are consecutive slots, like a register.
    ModArith.WCopy(w, 24_i64, out, x3);
    return;
}

/// `out = 2p`; complete, `out` may alias `p`.
pub unit Double(u32[] w, i64 out, i64 p) {
    i64 n = 8_i64;
    i64 b = SlotB();
    i64 t0 = Slot(1_i64); i64 t1 = Slot(2_i64); i64 t2 = Slot(3_i64); i64 t3 = Slot(4_i64);
    i64 x3 = Slot(6_i64); i64 y3 = Slot(7_i64); i64 z3 = Slot(8_i64);
    i64 px = p; i64 py = p + 8_i64; i64 pz = p + 16_i64;
    ModArith.WMul(w, n, t0, px, px);
    ModArith.WMul(w, n, t1, py, py);
    ModArith.WMul(w, n, t2, pz, pz);
    ModArith.WMul(w, n, t3, px, py);
    ModArith.WAdd(w, n, t3, t3, t3);
    ModArith.WMul(w, n, z3, px, pz);
    ModArith.WAdd(w, n, z3, z3, z3);
    ModArith.WMul(w, n, y3, b, t2);
    ModArith.WSub(w, n, y3, y3, z3);
    ModArith.WAdd(w, n, x3, y3, y3);
    ModArith.WAdd(w, n, y3, x3, y3);
    ModArith.WSub(w, n, x3, t1, y3);
    ModArith.WAdd(w, n, y3, t1, y3);
    ModArith.WMul(w, n, y3, x3, y3);
    ModArith.WMul(w, n, x3, x3, t3);
    ModArith.WAdd(w, n, t3, t2, t2);
    ModArith.WAdd(w, n, t2, t2, t3);
    ModArith.WMul(w, n, z3, b, z3);
    ModArith.WSub(w, n, z3, z3, t2);
    ModArith.WSub(w, n, z3, z3, t0);
    ModArith.WAdd(w, n, t3, z3, z3);
    ModArith.WAdd(w, n, z3, z3, t3);
    ModArith.WAdd(w, n, t3, t0, t0);
    ModArith.WAdd(w, n, t0, t3, t0);
    ModArith.WSub(w, n, t0, t0, t2);
    ModArith.WMul(w, n, t0, t0, z3);
    ModArith.WAdd(w, n, y3, y3, t0);
    ModArith.WMul(w, n, t0, py, pz);
    ModArith.WAdd(w, n, t0, t0, t0);
    ModArith.WMul(w, n, z3, t0, z3);
    ModArith.WSub(w, n, x3, x3, z3);
    ModArith.WMul(w, n, z3, t0, t1);
    ModArith.WAdd(w, n, z3, z3, z3);
    ModArith.WAdd(w, n, z3, z3, z3);
    ModArith.WCopy(w, 24_i64, out, x3);
    return;
}

/// Fills the 16 registers at `table` with 0P .. 15P.
unit BuildTable(u32[] w, i64 table, i64 p) {
    SetIdentity(w, table);
    CopyReg(w, table + 24_i64, p);
    mut i64 i = 2_i64;
    while i < 16_i64 {
        i64 entry = table + 24_i64 * i;
        if (i & 1_i64) == 0_i64 {
            Double(w, entry, table + 24_i64 * (i / 2_i64));
        } else {
            Add(w, entry, table + 24_i64 * (i - 1_i64), p);
        }
        i = i + 1_i64;
    }
    return;
}

u32 Nibble(u32[] scalar, i64 index) {
    return (scalar[index / 8_i64] >> u32((index % 8_i64) * 4_i64)) & 15_u32;
}

/// Register `out` = `k * p` for a plain (not Montgomery) eight-limb scalar. Constant-time.
/// `out` and `p` are registers of `c.w`; `out` may alias `p`.
pub unit ScalarMult(Curve c, i64 out, u32[] k, i64 p) {
    u32[] w = c.w;
    BuildTable(w, TableP(), p);
    i64 acc = RegAcc();
    i64 pick = RegPick();
    SetIdentity(w, acc);
    mut i64 i = 63_i64;
    while i >= 0_i64 {
        Double(w, acc, acc);
        Double(w, acc, acc);
        Double(w, acc, acc);
        Double(w, acc, acc);
        ModArith.WSelect(w, 24_i64, pick, TableP(), 16_i64, Nibble(k, i));
        Add(w, acc, acc, pick);
        i = i - 1_i64;
    }
    CopyReg(w, out, acc);
    return;
}

/// Register `out` = `k1 * p + k2 * q` with one shared doubling chain. Constant-time.
pub unit DoubleScalarMult(Curve c, i64 out, u32[] k1, i64 p, u32[] k2, i64 q) {
    u32[] w = c.w;
    BuildTable(w, TableP(), p);
    BuildTable(w, TableQ(), q);
    i64 acc = RegAcc();
    i64 pick = RegPick();
    SetIdentity(w, acc);
    mut i64 i = 63_i64;
    while i >= 0_i64 {
        Double(w, acc, acc);
        Double(w, acc, acc);
        Double(w, acc, acc);
        Double(w, acc, acc);
        ModArith.WSelect(w, 24_i64, pick, TableP(), 16_i64, Nibble(k1, i));
        Add(w, acc, acc, pick);
        ModArith.WSelect(w, 24_i64, pick, TableQ(), 16_i64, Nibble(k2, i));
        Add(w, acc, acc, pick);
        i = i - 1_i64;
    }
    CopyReg(w, out, acc);
    return;
}

/// Affine coordinates of a non-identity point as plain eight-limb values.
pub type Affine { pub u32[] x, pub u32[] y, }

/// The affine form of register `r`; fails for the identity.
pub Result<Affine, PkError> ToAffine(Curve c, i64 r) {
    u32[] w = c.w;
    i64 n = 8_i64;
    if IsIdentityBit(w, r) == 1_u32 { return Result::Error(PkError::InvalidPoint()); }
    i64 inv = Scratch(0_i64);
    i64 x = Scratch(1_i64);
    i64 y = Scratch(2_i64);
    ModArith.WPowPublic(w, n, inv, r + 16_i64, SlotPowAcc(), InverseExponent(FieldPrime()));
    ModArith.WMul(w, n, x, r, inv);
    ModArith.WMul(w, n, y, r + 8_i64, inv);
    ModArith.WFromMont(w, n, x, x);
    ModArith.WFromMont(w, n, y, y);
    return Result::Ok(Affine { x: ModArith.WStore(w, n, x), y: ModArith.WStore(w, n, y) });
}

/// Uncompressed SEC 1 encoding of register `r`; fails for the identity.
pub Result<u8[], PkError> Encode(Curve c, i64 r) {
    Result<Affine, PkError> affine = ToAffine(c, r);
    return match affine {
        Result::Error(error) => Result::Error(error),
        Result::Ok(a) => {
            u8[] out = BigNat.ZeroBytes(65_i64);
            out[0] = u8(4);
            BigNat.WriteBytes(a.x, out, 1_i64, 32_i64);
            BigNat.WriteBytes(a.y, out, 33_i64, 32_i64);
            return Result::Ok(out);
        },
    };
}

/// Decodes an uncompressed SEC 1 point into register `r` and checks it: 65 bytes, prefix
/// 0x04, both coordinates below p, and y^2 = x^3 - 3x + b. The identity has no encoding.
pub Result<unit, PkError> Decode(Curve c, i64 r, u8[] encoded) {
    if Slice.Len(encoded) != 65_i64 { return Result::Error(PkError::InvalidPoint()); }
    if encoded[0] != u8(4) { return Result::Error(PkError::InvalidPoint()); }
    Result<u32[], PkError> xr = BigNat.FromBytesFixed(Scratch.Sub(encoded, 1_i64, 32_i64), 8_i64);
    Result<u32[], PkError> yr = BigNat.FromBytesFixed(Scratch.Sub(encoded, 33_i64, 32_i64), 8_i64);
    return match xr {
        Result::Error(_) => Result::Error(PkError::InvalidPoint()),
        Result::Ok(x) => match yr {
            Result::Error(_) => Result::Error(PkError::InvalidPoint()),
            Result::Ok(y) => FromAffine(c, r, x, y),
        },
    };
}

Result<unit, PkError> FromAffine(Curve c, i64 r, u32[] x, u32[] y) {
    u32[] p = FieldPrime();
    if ModArith.LessBit(x, p) == 0_u32 || ModArith.LessBit(y, p) == 0_u32 { return Result::Error(PkError::InvalidPoint()); }
    u32[] w = c.w;
    i64 n = 8_i64;
    ModArith.WLoad(w, n, r, x);
    ModArith.WToMont(w, n, r, r);
    ModArith.WLoad(w, n, r + 8_i64, y);
    ModArith.WToMont(w, n, r + 8_i64, r + 8_i64);
    ModArith.WToMont(w, n, r + 16_i64, ModArith.WOne(n));
    // y^2 = x^3 - 3x + b in Montgomery form.
    i64 lhs = Scratch(0_i64);
    i64 rhs = Scratch(1_i64);
    i64 three = Scratch(2_i64);
    ModArith.WMul(w, n, lhs, r + 8_i64, r + 8_i64);
    ModArith.WMul(w, n, rhs, r, r);
    ModArith.WMul(w, n, rhs, rhs, r);
    ModArith.WAdd(w, n, three, r, r);
    ModArith.WAdd(w, n, three, three, r);
    ModArith.WSub(w, n, rhs, rhs, three);
    ModArith.WAdd(w, n, rhs, rhs, SlotB());
    if ModArith.WEqualBit(w, n, lhs, rhs) == 0_u32 { return Result::Error(PkError::InvalidPoint()); }
    return Result::Ok(());
}

/// A private scalar as eight plain limbs; fails unless it is 32 bytes in [1, n-1].
pub Result<u32[], PkError> DecodeScalar(u8[] bytes) {
    if Slice.Len(bytes) != 32_i64 { return Result::Error(PkError::InvalidLength()); }
    Result<u32[], PkError> decoded = BigNat.FromBytesFixed(bytes, 8_i64);
    return match decoded {
        Result::Error(_) => Result::Error(PkError::InvalidScalar()),
        Result::Ok(k) => {
            if (ModArith.IsZeroBit(k) | (1_u32 - ModArith.LessBit(k, Order()))) == 1_u32 { return Result::Error(PkError::InvalidScalar()); }
            return Result::Ok(k);
        },
    };
}

/// The uncompressed public key `d * G` for a 32-byte private key `d` in [1, n-1].
pub Result<u8[], PkError> PublicKey(u8[] privateKey) {
    Result<u32[], PkError> scalar = DecodeScalar(privateKey);
    Result<Curve, PkError> curve = NewCurve();
    return match scalar {
        Result::Error(error) => Result::Error(error),
        Result::Ok(d) => match curve {
            Result::Error(error) => Result::Error(error),
            Result::Ok(c) => {
                ScalarMult(c, RegA(), d, RegGenerator());
                return Encode(c, RegA());
            },
        },
    };
}

/// Checks that `publicKey` is a valid uncompressed P-256 point.
pub Result<unit, PkError> ValidatePublicKey(u8[] publicKey) {
    Result<Curve, PkError> curve = NewCurve();
    return match curve {
        Result::Error(error) => Result::Error(error),
        Result::Ok(c) => {
            Result<unit, PkError> decoded = Decode(c, RegA(), publicKey);
            return match decoded { Result::Error(error) => Result::Error(error), Result::Ok(_) => Result::Ok(()), };
        },
    };
}

/// ECDH (SEC 1 section 3.3.1): the 32-byte x-coordinate of `d * Q`. The peer key is fully
/// validated; P-256 has cofactor 1, so a valid point never yields the identity for d in [1, n-1].
pub Result<u8[], PkError> SharedSecret(u8[] privateKey, u8[] peerPublicKey) {
    Result<u32[], PkError> scalar = DecodeScalar(privateKey);
    Result<Curve, PkError> curve = NewCurve();
    return match scalar {
        Result::Error(error) => Result::Error(error),
        Result::Ok(d) => match curve {
            Result::Error(error) => Result::Error(error),
            Result::Ok(c) => {
                Result<unit, PkError> peer = Decode(c, RegA(), peerPublicKey);
                return match peer {
                    Result::Error(error) => Result::Error(error),
                    Result::Ok(_) => {
                        ScalarMult(c, RegB(), d, RegA());
                        Result<Affine, PkError> affine = ToAffine(c, RegB());
                        return match affine {
                            Result::Error(_) => Result::Error(PkError::ZeroSharedSecret()),
                            Result::Ok(a) => {
                                u8[] out = BigNat.ZeroBytes(32_i64);
                                BigNat.WriteBytes(a.x, out, 0_i64, 32_i64);
                                return Result::Ok(out);
                            },
                        };
                    },
                };
            },
        },
    };
}
