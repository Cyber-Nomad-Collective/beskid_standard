//! `SystemSuite`: the system tests of corelib_tests, merged into one target so the matrix lowers
//! the system closure once. Each section keeps the tests of one former target unchanged.

use Testing.Assert;
use Core.Syscall;
use Core.Results;
use Core.Syscall.Descriptor;
use Core.Syscall.StandardStream;
use Core.Syscall.WriteRequest;
use Core.Syscall.ReadRequest;
use Core.Syscall.ReadLimit;
use Core.FS;
use Core.FS.FsError;
use Core.Time;
use Core.Time.Date;
use Core.Time.Duration;
use Core.Time.Deadline;
use Core.Time.Instant;
use Core.Time.TimerError;
use Core.Environment;
use Core.Environment.EnvironmentError;
use Core.Optional.Option;
use Runtime.Init;
use Testing.Expect;
use Core.Path.Lexical;
use Core.Time.Calendar;
use Core.Time.TimeError;

// ---- SyscallWriteTests.bd (formerly target `SystemSyscallWriteTests`) ----

// Syscall write smoke tests via `Core.Syscall` facade.

test SyscallWriteEmptyStringReturnsNonNegative {
    Core.Results.Result<i64, Core.Syscall.SyscallError> result =
        Core.Syscall.Write(Core.Syscall.StdoutFd(), "");
    Assert.True(Results.IsOk(result), "empty Write should succeed");
    match result {
        Result::Ok(written) => {
            Assert.True(written >= 0, "empty write byte count should be non-negative");
        },
        Result::Error(_) => {},
    };
}

test SyscallWriteStdoutSmoke {
    Core.Results.Result<i64, Core.Syscall.SyscallError> result =
        Core.Syscall.Write(Core.Syscall.StdoutFd(), "corelib");
    Assert.True(Results.IsOk(result), "stdout Write should succeed");
    match result {
        Result::Ok(written) => {
            Assert.True(written >= 1, "non-empty write should return at least one byte");
        },
        Result::Error(_) => {},
    };
}

test SyscallWritePrintsNewline {
    Core.Results.Result<i64, Core.Syscall.SyscallError> letter =
        Core.Syscall.Write(Core.Syscall.StdoutFd(), "a");
    Core.Results.Result<i64, Core.Syscall.SyscallError> newline =
        Core.Syscall.Write(Core.Syscall.StdoutFd(), "\\n");
    Assert.True(Results.IsOk(letter), "letter write should succeed");
    Assert.True(Results.IsOk(newline), "newline write should succeed");
    match letter {
        Result::Ok(written) => {
            Assert.True(written >= 1, "expected one byte for letter a");
        },
        Result::Error(_) => {},
    };
    match newline {
        Result::Ok(written) => {
            Assert.True(written >= 1, "expected one byte for newline");
        },
        Result::Error(_) => {},
    };
}

// ---- SyscallApiTests.bd (formerly target `SystemSyscallApiTests`) ----

// Syscall API contract checks for `Core.Syscall` read boundaries.

test SyscallReadRejectsUnsupportedFd {
    Core.Results.Result<string, Core.Syscall.SyscallError> result =
        Core.Syscall.Read(99_i64, 8_i64);
    Assert.True(Results.IsError(result), "Read on non-stdin fd should fail");
}

test SyscallReadRejectsInvalidLimit {
    Core.Results.Result<string, Core.Syscall.SyscallError> result =
        Core.Syscall.Read(Core.Syscall.StdinFd(), 0_i64);
    Assert.True(Results.IsError(result), "non-positive read limit should fail");
}

// ---- SyscallErgonomicsTests.bd (formerly target `SystemSyscallErgonomicsTests`) ----

// Runtime-backed syscall contract checks via `Core.Syscall` typed requests.

test SyscallWriteStdoutTypedSmoke {
    StandardStream stream = StandardStream::Stdout;
    Descriptor descriptor = Descriptor::Standard(stream);
    Core.Results.Result<i64, Core.Syscall.SyscallError> result =
        Core.Syscall.WriteWith(
            WriteRequest {
                descriptor: descriptor,
                data: "ergonomic-write"
            }
        );
    Assert.True(Results.IsOk(result), "stdout WriteWith should succeed");
    match result {
        Result::Ok(written) => {
            Assert.True(written >= 1, "stdout write should return at least one byte");
        },
        Result::Error(_) => {},
    };
}

test SyscallReadUnsupportedFdReturnsError {
    StandardStream stream = StandardStream::Stdout;
    Descriptor descriptor = Descriptor::Standard(stream);
    Core.Results.Result<string, Core.Syscall.SyscallError> result =
        Core.Syscall.ReadWith(
            ReadRequest {
                descriptor: descriptor,
                limit: ReadLimit::UpTo(4_i64)
            }
        );
    Assert.True(Results.IsError(result), "read from stdout should fail in v1");
}

test SyscallWriteInvalidFdReturnsError {
    Core.Results.Result<i64, Core.Syscall.SyscallError> result =
        Core.Syscall.Write(-1_i64, "x");
    Assert.True(Results.IsError(result), "invalid fd write should return error");
}

