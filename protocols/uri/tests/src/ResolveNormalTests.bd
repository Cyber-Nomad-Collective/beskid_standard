use Testing.Assert;
use Core.Results;
use Uri.Errors;
use Uri.Resolve;

// RFC 3986 section 5.4.1, normal examples, base http://a/b/c/d;p?q
string R(string ref) {
    Result<string, UriError> r = Resolve.ResolveText("http://a/b/c/d;p?q", ref);
    return match r { Result::Ok(s) => s, Result::Error(e) => "ERR" + Errors.Code(e), };
}

test scheme_and_path_forms {
    Assert.Equal<string>(R("g:h"), "g:h", "g:h");
    Assert.Equal<string>(R("g"), "http://a/b/c/g", "g");
    Assert.Equal<string>(R("./g"), "http://a/b/c/g", "./g");
    Assert.Equal<string>(R("g/"), "http://a/b/c/g/", "g/");
    Assert.Equal<string>(R("/g"), "http://a/g", "/g");
    Assert.Equal<string>(R("//g"), "http://g", "//g");
}

test query_and_fragment_forms {
    Assert.Equal<string>(R("?y"), "http://a/b/c/d;p?y", "?y");
    Assert.Equal<string>(R("g?y"), "http://a/b/c/g?y", "g?y");
    Assert.Equal<string>(R("#s"), "http://a/b/c/d;p?q#s", "#s");
    Assert.Equal<string>(R("g#s"), "http://a/b/c/g#s", "g#s");
    Assert.Equal<string>(R("g?y#s"), "http://a/b/c/g?y#s", "g?y#s");
}

test param_forms_and_empty {
    Assert.Equal<string>(R(";x"), "http://a/b/c/;x", ";x");
    Assert.Equal<string>(R("g;x"), "http://a/b/c/g;x", "g;x");
    Assert.Equal<string>(R("g;x?y#s"), "http://a/b/c/g;x?y#s", "g;x?y#s");
    Assert.Equal<string>(R(""), "http://a/b/c/d;p?q", "empty reference");
}

test dot_forms {
    Assert.Equal<string>(R("."), "http://a/b/c/", ".");
    Assert.Equal<string>(R("./"), "http://a/b/c/", "./");
    Assert.Equal<string>(R(".."), "http://a/b/", "..");
    Assert.Equal<string>(R("../"), "http://a/b/", "../");
    Assert.Equal<string>(R("../g"), "http://a/b/g", "../g");
    Assert.Equal<string>(R("../.."), "http://a/", "../..");
    Assert.Equal<string>(R("../../"), "http://a/", "../../");
    Assert.Equal<string>(R("../../g"), "http://a/g", "../../g");
}
