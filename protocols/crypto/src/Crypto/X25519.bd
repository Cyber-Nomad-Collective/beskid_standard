/// X25519 Diffie-Hellman (RFC 7748 section 5) over GF(2^255 - 19).
///
/// Field arithmetic is the constant-time Montgomery engine of `Crypto.ModArith` with
/// eight 32-bit limbs. The ladder runs a fixed 255 steps with branch-free conditional
/// swaps, so its time does not depend on the scalar or the peer's u-coordinate.
use Core.Bytes.Slice;
use Core.Results;
use Crypto.BigNat;
use Crypto.ModArith;
use Crypto.PkErrors;

/// Length of scalars, u-coordinates and shared secrets.
pub i64 KeyLength() { return 32_i64; }

/// p = 2^255 - 19, little-endian limbs.
u32[] FieldPrime() {
    return [0xFFFFFFED_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0xFFFFFFFF_u32, 0x7FFFFFFF_u32];
}

/// p - 2 big-endian, the Fermat inversion exponent.
u8[] InverseExponent() {
    u8[] e = Slice.Fill(BigNat.ZeroBytes(32_i64), 0_i64, 32_i64, u8(255));
    e[0] = u8(127);
    e[31] = u8(235);
    return e;
}

/// Little-endian 32 bytes to eight limbs, bit 255 masked (RFC 7748 decodeUCoordinate).
u32[] DecodeLittleEndian(u8[] bytes) {
    u32[] limbs = BigNat.Zeros(8_i64);
    mut i64 i = 0_i64;
    while i < 32_i64 {
        mut u32 b = u32(bytes[i]);
        if i == 31_i64 { b = b & 127_u32; }
        limbs[i / 4_i64] = limbs[i / 4_i64] | (b << u32((i % 4_i64) * 8_i64));
        i = i + 1_i64;
    }
    return limbs;
}

u8[] EncodeLittleEndian(u32[] limbs) {
    u8[] out = BigNat.ZeroBytes(32_i64);
    mut i64 i = 0_i64;
    while i < 32_i64 {
        out[i] = u8((limbs[i / 4_i64] >> u32((i % 4_i64) * 8_i64)) & 255_u32);
        i = i + 1_i64;
    }
    return out;
}

/// RFC 7748 decodeScalar25519: clear bits 0, 1, 2 and 255, set bit 254.
u8[] Clamp(u8[] scalar) {
    u8[] k = BigNat.ZeroBytes(32_i64);
    Slice.Copy(k, 0_i64, scalar, 0_i64, 32_i64);
    k[0] = k[0] & u8(248);
    k[31] = (k[31] & u8(127)) | u8(64);
    return k;
}

/// The raw X25519 function of RFC 7748 section 5: `scalar` and `u` are 32 bytes each.
/// Non-canonical u-coordinates (at or above p) are accepted and reduced, as the RFC requires.
/// The all-zero output is returned as is; key agreement uses `SharedSecret`, which rejects it.
pub Result<u8[], PkError> ScalarMult(u8[] scalar, u8[] u) {
    if Slice.Len(scalar) != 32_i64 || Slice.Len(u) != 32_i64 { return Result::Error(PkError::InvalidLength()); }
    Result<u32[], PkError> created = ModArith.NewWorkspace(FieldPrime(), 18_i64);
    return match created {
        Result::Error(error) => Result::Error(error),
        Result::Ok(w) => Result::Ok(Ladder(w, Clamp(scalar), u)),
    };
}

/// Workspace slot offsets (n = 8).
i64 S(i64 index) { return ModArith.WSlot(8_i64, index); }

u8[] Ladder(u32[] w, u8[] k, u8[] u) {
    i64 n = 8_i64;
    i64 x1 = S(0_i64); i64 x2 = S(1_i64); i64 z2 = S(2_i64); i64 x3 = S(3_i64); i64 z3 = S(4_i64);
    i64 a24 = S(5_i64); i64 a = S(6_i64); i64 aa = S(7_i64); i64 b = S(8_i64); i64 bb = S(9_i64);
    i64 e = S(10_i64); i64 cc = S(11_i64); i64 d = S(12_i64); i64 da = S(13_i64); i64 cb = S(14_i64);
    i64 raw = S(15_i64); i64 reduced = S(16_i64); i64 acc = S(17_i64);
    // raw < 2^255 < 2p: one branch-free conditional subtraction (raw - p) makes it canonical.
    u32[] limbs = DecodeLittleEndian(u);
    ModArith.WLoad(w, n, raw, limbs);
    u32[] minusP = BigNat.Copy(limbs);
    i64 borrow = BigNat.SubInPlace(minusP, FieldPrime());
    ModArith.WLoad(w, n, reduced, minusP);
    ModArith.WCondAssign(w, n, raw, reduced, 1_u32 - u32(borrow));

    ModArith.WToMont(w, n, x1, raw);
    ModArith.WToMont(w, n, x2, ModArith.WOne(n));
    ModArith.WSetSmall(w, n, z2, 0_u32);
    ModArith.WCopy(w, n, x3, x1);
    ModArith.WCopy(w, n, z3, x2);
    ModArith.WSetSmall(w, n, a24, 121665_u32);
    ModArith.WToMont(w, n, a24, a24);

    // All 255 ladder steps run inside one CLIF loop (tools/clifgen.py).
    i64[] meta = [254_i64, 0_i64];
    LadderLoop(w, k, meta);
    u32 swap = u32(meta[1]);
    ModArith.WCondSwap(w, 2_i64 * n, x2, x3, swap);

    ModArith.WPowPublic(w, n, z2, z2, acc, InverseExponent());
    ModArith.WMul(w, n, x2, x2, z2);
    ModArith.WFromMont(w, n, x2, x2);
    return EncodeLittleEndian(ModArith.WStore(w, n, x2));
}

/// The X25519 public key for a 32-byte private key: `ScalarMult(privateKey, 9)`.
pub Result<u8[], PkError> PublicKey(u8[] privateKey) {
    u8[] basePoint = BigNat.ZeroBytes(32_i64);
    basePoint[0] = u8(9);
    return ScalarMult(privateKey, basePoint);
}

/// The X25519 shared secret. Fails with ZeroSharedSecret when the peer key is a
/// small-order point (all-zero output), as TLS 1.3 (RFC 8446 section 7.4.2) requires.
pub Result<u8[], PkError> SharedSecret(u8[] privateKey, u8[] peerPublicKey) {
    Result<u8[], PkError> raw = ScalarMult(privateKey, peerPublicKey);
    return match raw {
        Result::Error(error) => Result::Error(error),
        Result::Ok(secret) => {
            mut u8 acc = u8(0);
            mut i64 i = 0_i64;
            while i < 32_i64 {
                acc = acc | secret[i];
                i = i + 1_i64;
            }
            if acc == u8(0) { return Result::Error(PkError::ZeroSharedSecret()); }
            return Result::Ok(secret);
        },
    };
}

