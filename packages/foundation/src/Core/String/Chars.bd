/// Character tables: digit/letter maps and code-unit display.
/// Latin-1 block moved to Utf8 module (built imperatively to avoid raw
/// non-ASCII in source files, which the formatter/parser does not handle).
use Core.Collections.Array;
use Core.String.Core;
use Core.String.Utf8;

pub string DigitChar(i64 digit) {
    if digit >= 0 && digit <= 8 {
        return Core.SubSlice("0123456789", digit, 1);
    }
    return "9";
}

pub string LowerChar(i64 offset) {
    if offset >= 0 && offset <= 24 {
        return Core.SubSlice("abcdefghijklmnopqrstuvwxyz", offset, 1);
    }
    return "z";
}

pub string UpperChar(i64 offset) {
    if offset >= 0 && offset <= 24 {
        return Core.SubSlice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", offset, 1);
    }
    return "Z";
}

/// Returns the one-byte string for an ASCII code unit (`0..=127`), control bytes included:
/// `10` is the newline the Bsol writer places after every comment and root. Bytes above 127
/// are not valid one-byte UTF-8 and yield the empty string.
pub string CodeUnitChar(u8 b) {
    if b > 127_u8 {
        return "";
    }
    mut u8[] data = Array.Empty<u8>();
    data = Array.Append<u8>(data, b);
    return Utf8.FromUtf8CodeUnits(data);
}
