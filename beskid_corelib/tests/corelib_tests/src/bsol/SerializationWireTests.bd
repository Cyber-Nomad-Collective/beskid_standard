//! `BsolSerializationWireTests`: the precise serialization.v1 BSOL representation (BSOL-06-08) and the bounded
//! owned value policies it applies (SER-05). Each section keeps the tests of one former target unchanged.

use Core.Optional;
use Core.Bsol.Serialization;
use Core.Bsol.Syntax;
use Core.FS;
use Core.Environment;
use Core.Serialization.Contracts;
use Core.Serialization.Errors;
use Core.Serialization.Numeric;
use Core.Collections.Array;
use Core.Results;
use Core.Serialization.DataValue;
use Core.Serialization.Descriptors;
use Core.Serialization.Limits;
use Core.Serialization.Metadata;
use Core.Serialization.Registry;
use Testing.Assert;
use Core.Bsol.Limits as BsolLimits;
use Core.Bsol.Schema;
use Core.Bsol.Typed;
use Core.String;
use Core.Serialization.Decimal;

// ---- SerializationWireTests.bd (target `BsolSerializationWireTests`) ----

string WireFixture(string name)
{
    match (Environment.Get("BESKID_BSOL_CORPUS"))
    {
        Result::Error(_) => {
            Assert.Fail("shared corpus configured");
            return "";
        },
        Result::Ok(root) => match (FS.ReadAllText(root + "/cases/serialization-v1/" + name + ".bsol"))
        {
            Result::Error(_) => {
                Assert.Fail("shared typed fixture readable");
                return "";
            },
            Result::Ok(text) => {
                return text;
            },
        },
    };
}

ShapeId Register(Registry.ShapeRegistry table, string signature, ShapeKind kind, u8 width, ShapeId[] arguments)
{
    ShapeId id = match (Registry.SignatureId(signature, 8388608_i64))
    {
        Result::Ok(value) => value,

        Result::Error(_) => {
            Assert.Fail("fixture signature hash");
            return Register(table, signature, kind, width, arguments);
        },
    };
    ShapeDescriptor descriptor = ShapeDescriptor
    {
        id: id,

        signature: signature,

        packageIdentity: "fixture@1.0.0",

        sourcePath: "Fixture.bd",

        declarationPath: signature,

        schemaVersion: "1",

        kind: kind,

        width: width,

        arguments: arguments,

        fields: Array.Empty<FieldDescriptor>(),

        variants: Array.Empty<VariantDescriptor>(),

        extras: Optional.Empty<ExtrasBinding>(),
    };
    Assert.True(Results.IsOk(Registry.Register(table, descriptor, 8388608_i64, 100000_i64)), "fixture descriptor registered");
    return id;
}

DataValue Roundtrip(ShapeId shape, DataValue value, Registry.ShapeRegistry table)
{
    match (Serialization.WriteValue(shape, value, table, Limits.DefaultLimits()))
    {
        Result::Error(_) => {
            Assert.Fail("native tagged output");
        },

        Result::Ok(text) => match (Serialization.ReadValue(text, shape, table, Limits.DefaultLimits()))
        {
            Result::Error(_) => {
                Assert.Fail("native tagged input");
            },

            Result::Ok(decoded) => {
                return decoded;
            },
        },
    };
    return DataValue::Unit;
}

string Envelope(ShapeId id, string value)
{
    return "serialized \"" + Metadata.FormatShapeId(id) + "\" { version = 1 value = " + value + " }";
}

test BsolSerializationWireExactUnsignedWidth
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId shape = Register(table, "unsigned64", ShapeKind::Unsigned, 64_u8, Array.Empty<ShapeId>());

    match (Roundtrip(shape, DataValue::Unsigned(18446744073709551615_u64, 64_u8), table))
    {
        DataValue::Unsigned(value, width) => {
            Assert.Equal(value, 18446744073709551615_u64, "u64 has no float intermediate");
            Assert.Equal(width, 64_u8, "declared width retained");
        },

        _ => Assert.Fail("unsigned typed tag"),
    };

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"u32\" { data = 1 }"), shape, table, Limits.DefaultLimits())), "wrong width rejects");
}

test BsolSerializationWireFloatPreservesNegativeZero
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId shape = Register(table, "float64", ShapeKind::Float, 64_u8, Array.Empty<ShapeId>());

    match (Roundtrip(shape, DataValue::Float(9223372036854775808_u64, 64_u8), table))
    {
        DataValue::Float(bits, width) => Assert.Equal(bits, 9223372036854775808_u64, "finite decimal retains sign bit"),

        _ => Assert.Fail("float typed tag"),
    };
}

test BsolSerializationWireStrictCanonicalBase64
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId shape = Register(table, "bytes", ShapeKind::Bytes, 0_u8, Array.Empty<ShapeId>());

    match (Roundtrip(shape, DataValue::Bytes([0_u8, 255_u8, 65_u8]), table))
    {
        DataValue::Bytes(bytes) => {
            Assert.Equal(Array.Len<u8>(bytes), 3_i64, "owned byte output");
            Assert.Equal(bytes[1_i64], 255_u8, "all bits retained");
        },

        _ => Assert.Fail("bytes typed tag"),
    };

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"bytes\" { encoding = base64 data = \"Zh==\" }"), shape, table, Limits.DefaultLimits())), "nonzero unused pad bits reject");
}

test BsolSerializationWireOptionalCardinalityAndTag
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId integer = Register(table, "i64", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());

    ShapeId optional = Register(table, "optional-i64", ShapeKind::Optional, 0_u8, [integer]);

    match (Roundtrip(optional, DataValue::Optional(true, [DataValue::Signed(-42_i64, 64_u8)]), table))
    {
        DataValue::Optional(present, payload) => {
            Assert.True(present, "present flag");
            Assert.Equal(Array.Len<DataValue>(payload), 1_i64, "exact one payload");
        },

        _ => Assert.Fail("optional typed tag"),
    };

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(optional, "value \"optional\" { present = false value = value \"i64\" { data = 1 } }"), optional, table, Limits.DefaultLimits())), "absent cannot carry payload");
}

test BsolSerializationWireRejectsUnknownDuplicateAndMalformedFields
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId shape = Register(table, "string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"string\" { data = \"a\" data = \"b\" }"), shape, table, Limits.DefaultLimits())), "duplicate scalar field");
    match (Serialization.ReadValue(Envelope(shape, "value \"string\" { data = \"a\" data = \"b\" }"), shape, table, Limits.DefaultLimits()))
    {
        Result::Ok(_) => Assert.Fail("duplicate has checked source diagnostics"),
        Result::Error(error) => {
            Assert.Equal(Errors.Code(error), "DuplicateField", "duplicate field is a checked diagnostic");
            Assert.True(Errors.HasRelated(error), "duplicate retains first declaration span");
            Assert.True(Errors.RelatedStart(error) >= 0_i64 && Errors.RelatedEnd(error) > Errors.RelatedStart(error), "related span is nonempty");
            Assert.True(Errors.Start(error) > Errors.RelatedEnd(error) && Errors.End(error) > Errors.Start(error), "primary span belongs to second field");
        },
    };
    Assert.True(!Errors.HasRelated(Errors.NumericError("NoSource")), "source-free errors have no invented related location");

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"string\" { data { } }"), shape, table, Limits.DefaultLimits())), "wrong field node rejects without indexing empty children");

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"string\" { data = \"a\" extra = true }"), shape, table, Limits.DefaultLimits())), "unknown field closed");
}

test BsolSerializationWireCharScalarAndDepthPolicy
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId shape = Register(table, "char", ShapeKind::Scalar, 0_u8, Array.Empty<ShapeId>());

    match (Roundtrip(shape, DataValue::Scalar(char(128512_u32)), table))
    {
        DataValue::Scalar(value) => Assert.Equal(u32(value), 128512_u32, "astral scalar exact"),

        _ => Assert.Fail("char typed tag"),
    };

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(shape, "value \"char\" { data = \"ab\" }"), shape, table, Limits.DefaultLimits())), "two scalars reject");
}

test BsolSerializationWireArrayListShapesAreDistinct
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId integer = Register(table, "element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());

    ShapeId array = Register(table, "i64-array", ShapeKind::Array, 0_u8, [integer]);

    match (Roundtrip(array, DataValue::Sequence(SequenceKind::Array, [DataValue::Signed(1_i64, 64_u8)]), table))
    {
        DataValue::Sequence(kind, values) => Assert.Equal(Array.Len<DataValue>(values), 1_i64, "array typed contents"),

        _ => Assert.Fail("array tag"),
    };

    Assert.True(Results.IsError(Serialization.WriteValue(array, DataValue::Sequence(SequenceKind::List, Array.Empty<DataValue>()), table, Limits.DefaultLimits())), "writer rejects list under array descriptor");

    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(array, "value \"list\" { items = [] }"), array, table, Limits.DefaultLimits())), "reader rejects list under array descriptor");
}

ShapeId RegisterStructured(Registry.ShapeRegistry table, string signature, ShapeKind kind, FieldDescriptor[] fields, VariantDescriptor[] variants)
{
    ShapeId id = match (Registry.SignatureId(signature, 8388608_i64))
    {
        Result::Ok(value) => value,

        Result::Error(_) => {
            Assert.Fail("structured fixture signature");
            return RegisterStructured(table, signature, kind, fields, variants);
        },
    };
    ShapeDescriptor descriptor = ShapeDescriptor
    {
        id: id,

        signature: signature,

        packageIdentity: "fixture@1.0.0",

        sourcePath: "Fixture.bd",

        declarationPath: signature,

        schemaVersion: "1",

        kind: kind,

        width: 0_u8,

        arguments: Array.Empty<ShapeId>(),

        fields: fields,

        variants: variants,

        extras: Optional.Empty<ExtrasBinding>(),
    };
    Assert.True(Results.IsOk(Registry.Register(table, descriptor, 8388608_i64, 100000_i64)), "structured descriptor registered");
    return id;
}

test BsolSerializationWireRecordDeclaredOrderAndRequiredFields
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId integer = Register(table, "record-element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());

    ShapeId record = RegisterStructured(table, "record", ShapeKind::Record, [FieldDescriptor
    {
        name: "z",

        shape: integer,

        required: true,

        optional: false,

        defaultSignature: "",
    }, FieldDescriptor
    {
        name: "a",

        shape: integer,

        required: true,

        optional: false,

        defaultSignature: "",
    }], Array.Empty<VariantDescriptor>());

    match (Roundtrip(record, DataValue::Record(record, [RecordField
    {
        name: "a",

        value: DataValue::Signed(2_i64, 64_u8),
    }, RecordField
    {
        name: "z",

        value: DataValue::Signed(1_i64, 64_u8),
    }]), table))
    {
        DataValue::Record(identity, fields) => Assert.Equal(fields[0_i64].name, "z", "declaration order rather than alphabetical order"),

        _ => Assert.Fail("record typed tag"),
    };

    Assert.True(Results.IsError(Serialization.WriteValue(record, DataValue::Record(record, Array.Empty<RecordField>()), table, Limits.DefaultLimits())), "required fields reject");
}

test BsolSerializationWireMapOrdinalKeysAndDuplicateRejection
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId integer = Register(table, "map-element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());

    ShapeId map = Register(table, "map", ShapeKind::Map, 0_u8, [integer]);

    match (Roundtrip(map, DataValue::Map([MapEntry
    {
        key: "é",

        value: DataValue::Signed(2_i64, 64_u8),
    }, MapEntry
    {
        key: "a",

        value: DataValue::Signed(1_i64, 64_u8),
    }]), table))
    {
        DataValue::Map(entries) => Assert.Equal(entries[0_i64].key, "a", "UTF8 ordinal canonical order"),

        _ => Assert.Fail("map typed tag"),
    };

    Assert.True(Results.IsError(Serialization.WriteValue(map, DataValue::Map([MapEntry
    {
        key: "a",

        value: DataValue::Signed(1_i64, 64_u8),
    }, MapEntry
    {
        key: "a",

        value: DataValue::Signed(2_i64, 64_u8),
    }]), table, Limits.DefaultLimits())), "duplicate map key rejects");
}

test BsolSerializationWireVariantExactDiscriminantAndPayload
{
    Registry.ShapeRegistry table = Registry.Create();

    ShapeId integer = Register(table, "variant-element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());

    ShapeId variant = RegisterStructured(table, "variant", ShapeKind::Variant, Array.Empty<FieldDescriptor>(), [VariantDescriptor
    {
        name: "Empty",

        ordinal: 0_u32,

        fields: Array.Empty<FieldDescriptor>(),
    }, VariantDescriptor
    {
        name: "Some",

        ordinal: 1_u32,

        fields: [FieldDescriptor
        {
            name: "value",

            shape: integer,

            required: true,

            optional: false,

            defaultSignature: "",
        }],
    }]);

    match (Roundtrip(variant, DataValue::Variant(variant, "Some", [DataValue::Signed(42_i64, 64_u8)]), table))
    {
        DataValue::Variant(identity, name, payload) => {
            Assert.Equal(name, "Some", "declared variant");
            Assert.Equal(Array.Len<DataValue>(payload), 1_i64, "exact payload arity");
        },

        _ => Assert.Fail("variant typed tag"),
    };

    Assert.True(Results.IsError(Serialization.WriteValue(variant, DataValue::Variant(variant, "Some", Array.Empty<DataValue>()), table, Limits.DefaultLimits())), "missing payload rejects");

    Assert.True(Results.IsError(Serialization.WriteValue(variant, DataValue::Variant(variant, "Foreign", Array.Empty<DataValue>()), table, Limits.DefaultLimits())), "unknown discriminant rejects");
}

// Exercises the format-independent Encoder directly: no aggregate DataValue tree.
test BsolSerializationStreamEncoderValidatesShapeAndTransaction
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId integer = Register(table, "stream-element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    ShapeId record = RegisterStructured(table, "stream-record", ShapeKind::Record, [FieldDescriptor
    {
        name: "count",
        shape: integer,
        required: true,
        optional: false,
        defaultSignature: "",
    }], Array.Empty<VariantDescriptor>());
    Serialization.WireEncoder encoder = Serialization.CreateEncoder(record, table);
    Assert.True(Results.IsOk(encoder.Begin(Limits.DefaultLimits())), "begin private transaction");
    Assert.True(Results.IsError(Serialization.EncodedText(encoder)), "uncommitted bytes remain private");
    Assert.True(Results.IsOk(encoder.BeginRecord(record, 1_i64)), "exact record declaration");
    Assert.True(Results.IsOk(encoder.BeginField("count")), "declared typed field");
    Assert.True(Results.IsOk(encoder.WriteSigned(9007199254740993_i64, 64_u8)), "ordinary typed signed call");
    Assert.True(Results.IsOk(encoder.EndField()), "field boundary");
    Assert.True(Results.IsOk(encoder.EndRecord()), "record arity");
    Assert.True(Results.IsOk(encoder.Commit()), "atomic publication");
    match (Serialization.EncodedText(encoder))
    {
        Result::Error(_) => Assert.Fail("committed native text"),
        Result::Ok(text) => Assert.True(Results.IsOk(Serialization.ReadValue(text, record, table, Limits.DefaultLimits())), "shared wire policy validates direct stream"),
    };
    Assert.True(Results.IsOk(encoder.Begin(Limits.DefaultLimits())), "fresh transaction");
    Assert.True(Results.IsError(encoder.WriteString("wrong")), "root shape mismatch rejects");
    Assert.True(Results.IsError(encoder.Commit()), "ignored operation error still poisons transaction");
    Assert.True(Results.IsError(Serialization.EncodedText(encoder)), "failed transaction publishes no prior/new text");
    encoder.Abort();
}

test BsolSerializationStreamEncoderChecksNestedArity
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId integer = Register(table, "stream-list-element", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    ShapeId array = Register(table, "stream-array", ShapeKind::Array, 0_u8, [integer]);
    Serialization.WireEncoder encoder = Serialization.CreateEncoder(array, table);
    Assert.True(Results.IsOk(encoder.Begin(Limits.DefaultLimits())), "stream begin");
    Assert.True(Results.IsOk(encoder.BeginSequence(2_i64)), "declared array count");
    Assert.True(Results.IsOk(encoder.WriteSigned(1_i64, 64_u8)), "first item");
    Assert.True(Results.IsError(encoder.EndSequence()), "missing second item rejects");
    Assert.True(Results.IsError(encoder.Commit()), "arity error latches until abort");
    encoder.Abort();
}

pub type WireCounter : Contracts.Serializable<Serialization.WireEncoder>
{
    pub i64 count;
    ShapeId shape;

    pub Result<unit, SerializationError> WriteTyped(Serialization.WireEncoder encoder, SerializationLimits limits)
    {
        encoder.BeginRecord(this.shape, 1_i64);
        encoder.BeginField("count");
        encoder.WriteSigned(this.count, 64_u8);
        encoder.EndField();
        return encoder.EndRecord();
    }
}

pub type CounterReader : Serialization.WireReader<WireCounter>
{
    pub Result<WireCounter, SerializationError> ReadSyntax(Syntax.Document document, ShapeId shape, Registry.ShapeRegistry table, SerializationLimits limits)
    {
        mut i64 i = 0_i64;
        while (i < Array.Len<Syntax.Node>(document.nodes))
        {
            Syntax.Node field = document.nodes[i];
            if (field.kind == Syntax.NodeKind::Block && field.name == "field" && field.hasLabel && field.label == "count")
            {
                Syntax.Node fieldAssignment = document.nodes[field.children[0_i64]];
                Syntax.Node value = document.nodes[fieldAssignment.children[0_i64]];
                Syntax.Node data = document.nodes[value.children[0_i64]];
                Syntax.Node number = document.nodes[data.children[0_i64]];
                match (Numeric.ParseSigned(number.raw, 64_i64))
                {
                    Result::Error(error) => {
                        return Result::Error(error);
                    },
                    Result::Ok(count) => {
                        return Result::Ok(WireCounter
                        {
                            count: count,
                            shape: shape,
                        });
                    },
                };
            }
            i = i + 1_i64;
        }
        return Result::Error(Errors.NumericError("MissingTypedField"));
    }
}

test BsolSerializationSharedGenericEncoderDecoderConstructsFreshT
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId integer = Register(table, "generic-count", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    ShapeId record = RegisterStructured(table, "generic-counter", ShapeKind::Record, [FieldDescriptor
    {
        name: "count",
        shape: integer,
        required: true,
        optional: false,
        defaultSignature: "",
    }], Array.Empty<VariantDescriptor>());
    WireCounter original = WireCounter
    {
        count: 9007199254740993_i64,
        shape: record,
    };
    match (Serialization.WriteTyped<WireCounter>(original, record, table, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("shared Serializable<WireEncoder> body"),
        Result::Ok(text) => {
            Serialization.WireDecoder<WireCounter, CounterReader> decoder = Serialization.CreateDecoder<WireCounter, CounterReader>(text, record, table, CounterReader { });
            match (Contracts.Decode<WireCounter, Serialization.WireDecoder<WireCounter, CounterReader>>(decoder, Limits.DefaultLimits()))
            {
                Result::Error(_) => Assert.Fail("concrete Decoder<T> typed constructor"),
                Result::Ok(decoded) => Assert.Equal(decoded.count, 9007199254740993_i64, "fresh exact T from native syntax"),
            };
        },
    };
}

test BsolSerializationSharedTaggedCorpusUsesSameNativePolicy
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId unsigned = Register(table, "unsigned64", ShapeKind::Unsigned, 64_u8, Array.Empty<ShapeId>());
    Assert.True(Results.IsOk(Serialization.ReadValue(WireFixture("u64"), unsigned, table, Limits.DefaultLimits())), "shared exact unsigned case");
    Assert.True(Results.IsError(Serialization.ReadValue(WireFixture("wrong-width"), unsigned, table, Limits.DefaultLimits())), "shared exact width rejection");
    ShapeId bytes = Register(table, "bytes", ShapeKind::Bytes, 0_u8, Array.Empty<ShapeId>());
    Assert.True(Results.IsOk(Serialization.ReadValue(WireFixture("bytes"), bytes, table, Limits.DefaultLimits())), "shared canonical base64");
    Assert.True(Results.IsError(Serialization.ReadValue(WireFixture("bad-padbits"), bytes, table, Limits.DefaultLimits())), "shared canonical pad bits");
    ShapeId scalar = Register(table, "char", ShapeKind::Scalar, 0_u8, Array.Empty<ShapeId>());
    Assert.True(Results.IsOk(Serialization.ReadValue(WireFixture("char-astral"), scalar, table, Limits.DefaultLimits())), "shared astral scalar");
    Assert.True(Results.IsError(Serialization.ReadValue(WireFixture("char-two"), scalar, table, Limits.DefaultLimits())), "shared scalar count");
}

test BsolSerializationActivePathRejectsCycleNotSharedSiblings
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId recursive = match (Registry.SignatureId("recursive-array", 8388608_i64))
    {
        Result::Ok(id) => id,
        Result::Error(_) => {
            Assert.Fail("recursive fixture identity");
            return;
        },
    };
    Register(table, "recursive-array", ShapeKind::Array, 0_u8, [recursive]);
    mut DataValue[] items = [DataValue::Unit];
    DataValue cycle = DataValue::Sequence(SequenceKind::Array, items);
    Array.Set<DataValue>(items, 0_i64, cycle);
    match (Serialization.WriteValue(recursive, cycle, table, Limits.DefaultLimits()))
    {
        Result::Ok(_) => Assert.Fail("cyclic managed arena must reject before output"),
        Result::Error(error) => Assert.Equal(Errors.Code(error), "CycleDetected", "cyclic arena rejects with the cycle code"),
    };
    ShapeId scalar = Register(table, "identity-string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());
    ShapeId sequence = Register(table, "identity-string-array", ShapeKind::Array, 0_u8, [scalar]);
    DataValue shared = DataValue::String("same allocation in two sibling edges");
    Assert.True(Results.IsOk(Serialization.WriteValue(sequence, DataValue::Sequence(SequenceKind::Array, [shared, shared]), table, Limits.DefaultLimits())), "acyclic shared aliases remain legal");
}

test CheckedArrayAppendPublishesScalarAndManagedOwners
{
    mut i64[] scalar = Array.Empty<i64>();
    Assert.True(Array.TryAppend<i64>(scalar, 7_i64), "checked scalar append admitted");
    Assert.Equal(Array.Len<i64>(scalar), 1_i64, "scalar append publishes one element");
    Assert.Equal(scalar[0_i64], 7_i64, "appended scalar is readable");
    mut DataValue[] managed = Array.Empty<DataValue>();
    DataValue value = DataValue::String("typed rooted payload");
    Assert.True(Array.TryAppend<DataValue>(managed, value), "checked managed append admitted");
    Assert.Equal(Array.Len<DataValue>(managed), 1_i64, "managed append publishes one element");
    match (managed[0_i64])
    {
        DataValue::String(text) => Assert.Equal(text, "typed rooted payload", "managed payload survives append"),
        _ => Assert.Fail("exact traced payload preserved"),
    };
}

test SerializationFailurePublicationHasNoMutablePayload
{
    SerializationError failure = SerializationError::AllocationFailure;
    Assert.Equal(Errors.Code(failure), "AllocationFailed", "reserved failure code");
    Assert.Equal(Errors.Path(failure), "", "reserved failure has no path");
    Assert.Equal(Errors.Start(failure), -1_i64, "reserved failure has no start");
    Assert.Equal(Errors.End(failure), -1_i64, "reserved failure has no end");
    Assert.True(!Errors.HasRelated(failure), "reserved allocation failure has no borrowed diagnostic");
    SerializationError first = Errors.Diagnostic("DuplicateField", "root.field", 20_i64, 30_i64, true, 0_i64, 10_i64);
    SerializationError second = Errors.NumericError("Range");
    Assert.Equal(Errors.Code(first), "DuplicateField", "diagnostic code retained");
    Assert.Equal(Errors.Code(second), "Range", "numeric code retained");
    Assert.Equal(Errors.RelatedStart(first), 0_i64, "related start retained");
    Assert.Equal(Errors.RelatedEnd(first), 10_i64, "related end retained");
    Assert.True(Errors.HasRelated(first), "ordinary immutable diagnostics retain related source");
    Assert.Equal(Errors.Code(failure), "AllocationFailed", "reserved failure code is immutable");
}

test WireEncoderPreparesFallibleWorkBeforeNonallocatingCommit
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId shape = Register(table, "publication-i64", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    Serialization.WireEncoder encoder = Serialization.CreateEncoder(shape, table);
    Assert.True(Results.IsError(encoder.Commit()), "unopened transaction cannot publish");
    encoder.Abort();
    Assert.True(Results.IsOk(encoder.Begin(Limits.DefaultLimits())), "begin after unopened rollback");
    Assert.True(Results.IsOk(encoder.WriteSigned(42_i64, 64_u8)), "fallible root completion validates unpublished bytes");
    Assert.True(Results.IsError(Serialization.EncodedText(encoder)), "prepared bytes remain unpublished");
    Assert.True(Results.IsOk(encoder.Commit()), "commit transfers already prepared result");
    Assert.True(Results.IsOk(Serialization.EncodedText(encoder)), "published bytes become visible");
    Assert.True(Results.IsError(encoder.Commit()), "second commit rejected without replacing publication");
    encoder.Abort();
    Assert.True(Results.IsError(Serialization.EncodedText(encoder)), "rollback revokes output visibility");
    Assert.True(Results.IsOk(encoder.Begin(Limits.DefaultLimits())), "reusable encoder starts a fresh transaction");
    Assert.True(Results.IsOk(encoder.WriteSigned(43_i64, 64_u8)), "fresh payload prepared");
    Assert.True(Results.IsOk(encoder.Commit()), "fresh transaction committed");
}

// ---- TypedBindingTests.bd (formerly target `BsolTypedBindingTests`) ----

pub type Counter
{
    pub i64 count;
}

Syntax.Node Node(Syntax.NodeKind kind, string name, string raw, move i64[] children)
{
    return Syntax.Node
    {
        kind: kind,

        span: Syntax.Span
        {
            start: -1_i64,

            end: -1_i64,
        },

        raw: raw,

        text: raw,

        name: name,

        label: "",

        hasLabel: false,

        schemaless: false,

        children: children,

        attributes: Array.Empty<i64>(),
    };
}

/// Explicit native binding fixture; the real Serialization Mod must generate
/// equivalent typed field/constructor calls with exact source authority.
pub type CounterBinding : Typed.BsolBinding<Counter>
{
    pub Result<Counter, Schema.Diagnostic[]> ReadDocument(Schema.ValidatedDocument checked, SerializationLimits limits)
    {
        Syntax.Document document = checked.document;
        mut i64 i = 0_i64;
        while (i < Array.Len<Schema.FieldBinding>(checked.fields))
        {
            Schema.FieldBinding field = checked.fields[i];
            Syntax.Node assignment = document.nodes[field.assignment];
            if (assignment.name == "count" && Array.Len<i64>(assignment.children) == 1_i64)
            {
                Syntax.Node number = document.nodes[assignment.children[0_i64]];
                match (Numeric.ParseSigned(number.raw, 64_i64))
                {
                    Result::Ok(count) => {
                        return Result::Ok(Counter
                        {
                            count: count,
                        });
                    },
                    Result::Error(error) => {
                        return Result::Error([BindingError(Errors.Code(error), number.span)]);
                    },
                };
            }
            i = i + 1_i64;
        }
        return Result::Error([BindingError("MissingTypedField", Syntax.Span
        {
            start: 0_i64,
            end: 0_i64,
        })]);
    }

    pub Result<Syntax.Document, Schema.Diagnostic[]> WriteDocument(Counter value, Schema.Profile profile, SerializationLimits limits)
    {
        Syntax.Node number = Node(Syntax.NodeKind::Number, "", Decimal.Signed(value.count), Array.Empty<i64>());
        Syntax.Node assignment = Node(Syntax.NodeKind::Assignment, "count", "", [0_i64]);
        Syntax.Node block = Node(Syntax.NodeKind::Block, "config", "", [1_i64]);
        return Result::Ok(Syntax.Document
        {
            source: "",
            nodes: [number, assignment, block],
            roots: [2_i64],
            trivia: Array.Empty<Syntax.Trivia>(),
        });
    }
}

Schema.Diagnostic BindingError(string code, Syntax.Span span)
{
    return Schema.Diagnostic
    {
        code: code,

        stage: Schema.DiagnosticStage::Validation,

        span: span,

        field: "count",

        rule: "config",

        profile: "counter.v2",

        hasRelated: false,

        relatedSpan: Syntax.Span
        {
            start: -1_i64,

            end: -1_i64,
        },

        message: code,
    };
}

Schema.Profile Profile()
{
    return match (Schema.ParseProfile("profile \"counter.v2\" { version = 2 rule \"config\" { scope = top match = keyword keyword = config label = forbidden cardinality = one extras = false field \"count\" { type = i64 required = true } } }", BsolLimits.DefaultLimits()))
    {
        Result::Ok(profile) => profile,

        Result::Error(_) => {
            Assert.Fail("binding profile valid");
            return Profile();
        },
    };
}

test BsolExplicitTypedBindingReadsExactIntegerAfterValidation
{
    CounterBinding binding = CounterBinding { };

    match (Typed.ReadResolved<Counter, CounterBinding>("config { count = 9007199254740993 }", Profile(), binding, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("validated typed binding"),

        Result::Ok(value) => Assert.Equal(value.count, 9007199254740993_i64, "typed value beyond float precision"),
    };
}

test BsolExplicitTypedBindingWriteRoundtripIsProfileChecked
{
    CounterBinding binding = CounterBinding { };

    match (Typed.Write<Counter, CounterBinding>(Counter
    {
        count: 9007199254740993_i64,
    }, Profile(), binding, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("bounded native typed writer"),

        Result::Ok(text) => {
            match (Typed.ReadResolved<Counter, CounterBinding>(text, Profile(), binding, Limits.DefaultLimits()))
            {
                Result::Error(_) => Assert.Fail("typed canonical reread"),

                Result::Ok(value) => Assert.Equal(value.count, 9007199254740993_i64, "same typed config"),
            };
        },
    };
}

test BsolTypedBindingMissingDuplicateAndWrongKindReject
{
    CounterBinding binding = CounterBinding { };

    Assert.True(Results.IsError(Typed.ReadResolved<Counter, CounterBinding>("config { }", Profile(), binding, Limits.DefaultLimits())), "required field rejects before construction");

    Assert.True(Results.IsError(Typed.ReadResolved<Counter, CounterBinding>("config { count = 1 count = 2 }", Profile(), binding, Limits.DefaultLimits())), "duplicates reject before typed decode");

    Assert.True(Results.IsError(Typed.ReadResolved<Counter, CounterBinding>("config { count = \"bad\" }", Profile(), binding, Limits.DefaultLimits())), "kind mismatch rejects");
}

// ---- Release case tests (SER-05 bounded atomic owned values, precision and Unicode) ----

SerializationLimits WithLimits(i64 input, i64 output, i64 depth, i64 nodes, i64 scalar)
{
    mut SerializationLimits limits = Limits.DefaultLimits();
    limits.maxInputBytes = input;
    limits.maxOutputBytes = output;
    limits.maxDepth = depth;
    limits.maxNodes = nodes;
    limits.maxScalarBytes = scalar;
    return limits;
}

string ErrorCode(Result<string, SerializationError> result)
{
    return match (result)
    {
        Result::Ok(_) => "",
        Result::Error(error) => Errors.Code(error),
    };
}

/// Smallest budget (1..64) for which `write` succeeds when only the selected limit varies, or 0.
i64 RequiredWriteBudget(ShapeId shape, DataValue value, Registry.ShapeRegistry table, bool depth)
{
    mut i64 budget = 1_i64;
    while (budget <= 64_i64)
    {
        mut SerializationLimits limits = WithLimits(8388608_i64, 8388608_i64, 128_i64, budget, 1048576_i64);
        if (depth)
        {
            limits = WithLimits(8388608_i64, 8388608_i64, budget, 100000_i64, 1048576_i64);
        }
        if (Results.IsOk(Serialization.WriteValue(shape, value, table, limits)))
        {
            return budget;
        }
        budget = budget + 1_i64;
    }
    return 0_i64;
}

test SerializationEachConfiguredLimitSucceedsAndPlusOneReturnsLimitExceededWithoutPartialOutput
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId text = Register(table, "limit-string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());
    ShapeId list = Register(table, "limit-string-list", ShapeKind::List, 0_u8, [text]);
    ShapeId nested = Register(table, "limit-string-list-list", ShapeKind::List, 0_u8, [list]);
    DataValue items = DataValue::Sequence(SequenceKind::List, [DataValue::String("ab"), DataValue::String("cd"), DataValue::String("ef")]);
    string canonical = match (Serialization.WriteValue(list, items, table, Limits.DefaultLimits()))
    {
        Result::Ok(value) => value,
        Result::Error(_) => {
            Assert.Fail("boundary fixture writes under default limits");
            return;
        },
    };
    i64 bytes = String.Len(canonical);
    match (Serialization.WriteValue(list, items, table, WithLimits(8388608_i64, bytes, 128_i64, 100000_i64, 1048576_i64)))
    {
        Result::Error(_) => Assert.Fail("output exactly at the byte limit is admitted"),
        Result::Ok(bounded) => Assert.Equal(bounded, canonical, "bounded output is the complete text"),
    };
    Assert.Equal(ErrorCode(Serialization.WriteValue(list, items, table, WithLimits(8388608_i64, bytes - 1_i64, 128_i64, 100000_i64, 1048576_i64))), "OutputLimit", "one output byte over the limit returns OutputLimit and no text");
    Assert.True(Results.IsOk(Serialization.ReadValue(canonical, list, table, WithLimits(bytes, 8388608_i64, 128_i64, 100000_i64, 1048576_i64))), "input exactly at the byte limit is admitted");
    Assert.True(Results.IsError(Serialization.ReadValue(canonical, list, table, WithLimits(bytes - 1_i64, 8388608_i64, 128_i64, 100000_i64, 1048576_i64))), "one input byte over the limit returns no value");
    // The largest scalar is a 100-byte string, longer than every tag and the 64-byte shape identity.
    mut string longText = "";
    while (String.Len(longText) < 100_i64)
    {
        longText = longText + "x";
    }
    DataValue wide = DataValue::Sequence(SequenceKind::List, [DataValue::String(longText), DataValue::String("cd")]);
    string wideText = match (Serialization.WriteValue(list, wide, table, Limits.DefaultLimits()))
    {
        Result::Ok(value) => value,
        Result::Error(_) => {
            Assert.Fail("scalar fixture writes under default limits");
            return;
        },
    };
    Assert.True(Results.IsOk(Serialization.WriteValue(list, wide, table, WithLimits(8388608_i64, 8388608_i64, 128_i64, 100000_i64, 100_i64))), "a scalar exactly at the byte limit is written");
    Assert.Equal(ErrorCode(Serialization.WriteValue(list, wide, table, WithLimits(8388608_i64, 8388608_i64, 128_i64, 100000_i64, 99_i64))), "ScalarLimit", "one scalar byte over the limit returns ScalarLimit");
    Assert.True(Results.IsOk(Serialization.ReadValue(wideText, list, table, WithLimits(8388608_i64, 8388608_i64, 128_i64, 100000_i64, 100_i64))), "a decoded scalar exactly at the byte limit is read");
    Assert.True(Results.IsError(Serialization.ReadValue(wideText, list, table, WithLimits(8388608_i64, 8388608_i64, 128_i64, 100000_i64, 99_i64))), "one decoded scalar byte over the limit returns no value");
    i64 nodes = RequiredWriteBudget(list, items, table, false);
    Assert.True(nodes > 0_i64, "fixture fits a bounded node budget");
    DataValue longer = DataValue::Sequence(SequenceKind::List, [DataValue::String("ab"), DataValue::String("cd"), DataValue::String("ef"), DataValue::String("gh")]);
    i64 longerNodes = RequiredWriteBudget(list, longer, table, false);
    Assert.True(longerNodes > nodes, "one more collection entry is charged to the node budget");
    Assert.Equal(ErrorCode(Serialization.WriteValue(list, longer, table, WithLimits(8388608_i64, 8388608_i64, 128_i64, longerNodes - 1_i64, 1048576_i64))), "CollectionLimit", "one node over the limit returns CollectionLimit");
    DataValue deeper = DataValue::Sequence(SequenceKind::List, [items]);
    i64 depth = RequiredWriteBudget(list, items, table, true);
    Assert.True(depth > 0_i64, "fixture fits a bounded depth budget");
    i64 deeperDepth = RequiredWriteBudget(nested, deeper, table, true);
    Assert.True(deeperDepth > depth, "one more nesting level is charged to the depth budget");
    Assert.Equal(ErrorCode(Serialization.WriteValue(nested, deeper, table, WithLimits(8388608_i64, 8388608_i64, deeperDepth - 1_i64, 100000_i64, 1048576_i64))), "CollectionLimit", "one level over the depth limit returns CollectionLimit");
}

test SerializationCycleRejectsAndAcyclicAliasCopiesByValue
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId recursive = match (Registry.SignatureId("alias-recursive-list", 8388608_i64))
    {
        Result::Ok(id) => id,
        Result::Error(_) => {
            Assert.Fail("recursive fixture identity");
            return;
        },
    };
    Register(table, "alias-recursive-list", ShapeKind::List, 0_u8, [recursive]);
    mut DataValue[] slots = [DataValue::Unit];
    DataValue cycle = DataValue::Sequence(SequenceKind::List, slots);
    Array.Set<DataValue>(slots, 0_i64, cycle);
    Assert.Equal(ErrorCode(Serialization.WriteValue(recursive, cycle, table, Limits.DefaultLimits())), "CycleDetected", "a value reachable from itself rejects before output");
    ShapeId text = Register(table, "alias-string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());
    ShapeId pair = Register(table, "alias-string-list", ShapeKind::List, 0_u8, [text]);
    DataValue shared = DataValue::String("one allocation, two edges");
    match (Serialization.WriteValue(pair, DataValue::Sequence(SequenceKind::List, [shared, shared]), table, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("acyclic repeated alias is legal"),
        Result::Ok(written) => {
            i64 first = String.IndexOf(written, "one allocation, two edges");
            Assert.True(first >= 0_i64, "aliased value is written");
            string rest = String.SubSlice(written, first + 1_i64, String.Len(written) - first - 1_i64);
            Assert.True(String.Contains(rest, "one allocation, two edges"), "the alias is written again by value, not as a reference");
            match (Serialization.ReadValue(written, pair, table, Limits.DefaultLimits()))
            {
                Result::Error(_) => Assert.Fail("by-value copies read back"),
                Result::Ok(value) => match (value)
                {
                    DataValue::Sequence(kind, values) => {
                        Assert.Equal(Array.Len<DataValue>(values), 2_i64, "two independent entries");
                        match (values[1])
                        {
                            DataValue::String(second) => Assert.Equal(second, "one allocation, two edges", "second copy keeps the shared contents"),
                            _ => Assert.Fail("second entry is a string"),
                        };
                    },
                    _ => Assert.Fail("list reads back as a sequence"),
                },
            };
        },
    };
}

string RecordText(ShapeId record, string fields)
{
    return Envelope(record, "value \"record\" { shape = \"" + Metadata.FormatShapeId(record) + "\" fields = [" + fields + "] }");
}

string ReadCode(string text, ShapeId shape, Registry.ShapeRegistry table)
{
    return match (Serialization.ReadValue(text, shape, table, Limits.DefaultLimits()))
    {
        Result::Ok(_) => "",
        Result::Error(error) => Errors.Code(error),
    };
}

test SerializationRecordMissingRequiredDuplicateAndUnknownFieldsRejectAndOptionalFieldsMayBeAbsent
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId integer = Register(table, "policy-i64", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    ShapeId text = Register(table, "policy-string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());
    ShapeId record = RegisterStructured(table, "policy-record", ShapeKind::Record, [FieldDescriptor
    {
        name: "id",
        shape: integer,
        required: true,
        optional: false,
        defaultSignature: "",
    }, FieldDescriptor
    {
        name: "note",
        shape: text,
        required: false,
        optional: true,
        defaultSignature: "",
    }], Array.Empty<VariantDescriptor>());
    string id = "field \"id\" { value = value \"i64\" { data = 7 } }";
    string note = "field \"note\" { value = value \"string\" { data = \"n\" } }";
    match (Serialization.ReadValue(RecordText(record, id), record, table, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("absent optional field is admitted"),
        Result::Ok(value) => match (value)
        {
            DataValue::Record(shape, fields) => {
                Assert.Equal(Array.Len<RecordField>(fields), 1_i64, "absent fields are not fabricated by the format");
                Assert.Equal(fields[0].name, "id", "the present field is read");
            },
            _ => Assert.Fail("record reads back as a record"),
        },
    };
    Assert.True(Results.IsOk(Serialization.ReadValue(RecordText(record, id + ", " + note), record, table, Limits.DefaultLimits())), "present optional field is read");
    Assert.Equal(ReadCode(RecordText(record, note), record, table), "MissingField", "missing required field rejects");
    Assert.Equal(ReadCode(RecordText(record, id + ", " + id), record, table), "DuplicateField", "duplicate field rejects");
    Assert.Equal(ReadCode(RecordText(record, id + ", field \"extra\" { value = value \"i64\" { data = 1 } }"), record, table), "UnknownField", "unknown field rejects without an extras binding");
    Assert.Equal(ErrorCode(Serialization.WriteValue(record, DataValue::Record(record, [RecordField
    {
        name: "note",
        value: DataValue::String("n"),
    }]), table, Limits.DefaultLimits())), "MissingField", "writer rejects a missing required field");
}

test SerializationPrecisionUnicodeScalarsAndInvalidSurrogatesRoundtripOrReject
{
    Registry.ShapeRegistry table = Registry.Create();
    ShapeId signed = Register(table, "precision-i64", ShapeKind::Signed, 64_u8, Array.Empty<ShapeId>());
    ShapeId unsigned = Register(table, "precision-u64", ShapeKind::Unsigned, 64_u8, Array.Empty<ShapeId>());
    ShapeId text = Register(table, "precision-string", ShapeKind::String, 0_u8, Array.Empty<ShapeId>());
    ShapeId scalar = Register(table, "precision-char", ShapeKind::Scalar, 0_u8, Array.Empty<ShapeId>());
    match (Roundtrip(signed, DataValue::Signed(-9007199254740993_i64, 64_u8), table))
    {
        DataValue::Signed(value, width) => Assert.Equal(value, -9007199254740993_i64, "negative integer beyond 2^53 is exact"),
        _ => Assert.Fail("signed reads back as signed"),
    };
    match (Roundtrip(signed, DataValue::Signed(9007199254740993_i64, 64_u8), table))
    {
        DataValue::Signed(value, width) => Assert.Equal(value, 9007199254740993_i64, "positive integer beyond 2^53 is exact"),
        _ => Assert.Fail("signed reads back as signed"),
    };
    match (Roundtrip(unsigned, DataValue::Unsigned(18446744073709551615_u64, 64_u8), table))
    {
        DataValue::Unsigned(value, width) => Assert.Equal(value, 18446744073709551615_u64, "u64 maximum is exact"),
        _ => Assert.Fail("unsigned reads back as unsigned"),
    };
    match (Roundtrip(text, DataValue::String("a😀b"), table))
    {
        DataValue::String(value) => {
            Assert.Equal(value, "a😀b", "non-BMP scalar keeps its identity without normalization");
            Assert.Equal(String.Len(value), 6_i64, "exact UTF-8 bytes");
        },
        _ => Assert.Fail("string reads back as string"),
    };
    match (Roundtrip(scalar, DataValue::Scalar(char(66376_u32)), table))
    {
        DataValue::Scalar(value) => Assert.Equal(u32(value), 66376_u32, "non-BMP char is one scalar"),
        _ => Assert.Fail("char reads back as char"),
    };
    Assert.True(Results.IsOk(Serialization.ReadValue(Envelope(text, "value \"string\" { data = \"\\uD83D\\uDE00\" }"), text, table, Limits.DefaultLimits())), "escaped surrogate pair is one valid scalar");
    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(text, "value \"string\" { data = \"\\uD800\" }"), text, table, Limits.DefaultLimits())), "lone high surrogate rejects");
    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(text, "value \"string\" { data = \"\\uDC00\" }"), text, table, Limits.DefaultLimits())), "lone low surrogate rejects");
    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(scalar, "value \"char\" { data = \"\\uDFFF\" }"), scalar, table, Limits.DefaultLimits())), "surrogate is not a char");
    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(signed, "value \"i64\" { data = 9223372036854775808 }"), signed, table, Limits.DefaultLimits())), "i64 overflow rejects instead of rounding");
    Assert.True(Results.IsError(Serialization.ReadValue(Envelope(unsigned, "value \"u64\" { data = 1.0 }"), unsigned, table, Limits.DefaultLimits())), "float spelling is not an exact integer");
}
