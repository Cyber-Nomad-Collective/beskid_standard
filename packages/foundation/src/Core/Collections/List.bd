/// Growable list backed by typed `T[]` storage.
/// @tier(supported)
/// Lists are persistent values: every operation returns a new version and leaves earlier versions
/// unchanged, even when they share storage (see `Core.Collections.Storage`). Element equality (`Contains`, `IndexOf`, `Remove`) uses `==`, which compares
/// primitives and strings by value and other types by identity.
use Core.Collections.Array;
use Core.Collections.CollectionError;
use Core.Optional.Option;
use Core.Collections.Storage;
use Core.Results;

pub type List<T> {
    T[] storage,
    i64 count,

    pub i64 Count() {
        return count;
    }

    pub bool IsEmpty() {
        return count == 0;
    }

    pub List<T> Push(T value) {
        T[] nextStorage = Storage.AppendAt<T>(storage, count, value);
        return List<T> { storage: nextStorage, count: count + 1 };
    }

    /// Returns the list without its last element. Storage is left untouched because earlier
    /// versions may still own the removed slot; the next `Push` copies the prefix instead.
    pub List<T> Pop() {
        if count == 0 {
            return self;
        }
        return List<T> { storage: storage, count: count - 1 };
    }

    /// Returns the element at `index`, or `IndexOutOfRange(index, Count())`.
    pub Result<T, CollectionError> Get(i64 index) {
        if index < 0 || index >= count {
            return Result::Error(CollectionError::IndexOutOfRange(index, count));
        }
        return Result::Ok(Array.Get<T>(storage, index));
    }

    /// Returns the element at `index`, or `None` when out of range.
    pub Option<T> TryGet(i64 index) {
        if index < 0 || index >= this.count {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, index));
    }

    /// Returns the first element, or `None` when empty.
    pub Option<T> First() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, 0));
    }

    /// Returns the last element, or `None` when empty.
    pub Option<T> Last() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, this.count - 1));
    }

    /// Returns the index of the first element equal to `value`, or `-1`.
    pub i64 IndexOf(T value) {
        return Storage.IndexOf<T>(this.storage, this.count, value);
    }

    /// Returns true when an element equal to `value` is present.
    pub bool Contains(T value) {
        return Storage.IndexOf<T>(this.storage, this.count, value) >= 0;
    }

    /// Replaces the element at `index`.
    pub Result<List<T>, CollectionError> Set(i64 index, T value) {
        return SetIn<T>(this.storage, this.count, index, value);
    }

    /// Inserts `value` before `index`; `index == Count()` appends.
    pub Result<List<T>, CollectionError> Insert(i64 index, T value) {
        return InsertIn<T>(this.storage, this.count, index, value);
    }

    /// Removes the element at `index`, shifting later elements left.
    pub Result<List<T>, CollectionError> RemoveAt(i64 index) {
        return RemoveAtIn<T>(this.storage, this.count, index);
    }

    /// Removes the first element equal to `value`; returns the list unchanged when absent.
    pub List<T> Remove(T value) {
        return RemoveFirstIn<T>(this.storage, this.count, value);
    }

    /// Returns a new list with the elements in reverse order.
    pub List<T> Reverse() {
        return List<T> { storage: Storage.Reversed<T>(this.storage, this.count), count: this.count };
    }

    /// Returns up to `length` elements starting at `start`, clamped to the list bounds.
    pub List<T> Slice(i64 start, i64 length) {
        return SliceIn<T>(this.storage, this.count, start, length);
    }

    /// Returns a new list with every element of `other` appended after this list's elements.
    pub List<T> Concat(List<T> other) {
        return List<T> { storage: Storage.Concat<T>(this.storage, this.count, other.storage, other.count), count: this.count + other.count };
    }

    /// Copies the elements into a new array of exactly `Count()` elements.
    pub T[] ToArray() {
        return Storage.CopyRange<T>(this.storage, 0, this.count);
    }

    /// Returns an empty list.
    pub List<T> Clear() {
        return List<T> { storage: Array.Empty<T>(), count: 0 };
    }
}

pub List<T> New<T>() {
    return List<T> { storage: Array.Empty<T>(), count: 0 };
}

/// Bulk constructor: packs call-site scalars into a list.
/// Iterates the bulk array and appends each value via `List.Push`.
pub List<T> Of<T>(bulk T[] values) {
    mut List<T> result = List.New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result = result.Push(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}

/// Builds a list holding a copy of every element of `values`.
pub List<T> FromArray<T>(T[] values) {
    i64 count = Array.Len<T>(values);
    return List<T> { storage: Storage.CopyRange<T>(values, 0, count), count: count };
}

Result<List<T>, CollectionError> SetIn<T>(T[] storage, i64 count, i64 index, T value) {
    if index < 0 || index >= count {
        return Result<List<T>, CollectionError>::Error(CollectionError::IndexOutOfRange(index, count));
    }
    mut T[] copy = Storage.CopyRange<T>(storage, 0, count);
    copy = Array.Set<T>(copy, index, value);
    return Result<List<T>, CollectionError>::Ok(List<T> { storage: copy, count: count });
}

Result<List<T>, CollectionError> InsertIn<T>(T[] storage, i64 count, i64 index, T value) {
    if index < 0 || index > count {
        return Result<List<T>, CollectionError>::Error(CollectionError::IndexOutOfRange(index, count));
    }
    mut T[] next = Array.Empty<T>();
    mut i64 i = 0;
    while i < count {
        if i == index {
            next = Array.Append<T>(next, value);
        }
        next = Array.Append<T>(next, Array.Get<T>(storage, i));
        i = i + 1;
    }
    if index == count {
        next = Array.Append<T>(next, value);
    }
    return Result<List<T>, CollectionError>::Ok(List<T> { storage: next, count: count + 1 });
}

Result<List<T>, CollectionError> RemoveAtIn<T>(T[] storage, i64 count, i64 index) {
    if index < 0 || index >= count {
        return Result<List<T>, CollectionError>::Error(CollectionError::IndexOutOfRange(index, count));
    }
    T[] next = Storage.CopyWithout<T>(storage, count, index);
    return Result<List<T>, CollectionError>::Ok(List<T> { storage: next, count: count - 1 });
}

List<T> RemoveFirstIn<T>(T[] storage, i64 count, T value) {
    i64 index = Storage.IndexOf<T>(storage, count, value);
    if index < 0 {
        return List<T> { storage: storage, count: count };
    }
    T[] next = Storage.CopyWithout<T>(storage, count, index);
    return List<T> { storage: next, count: count - 1 };
}

List<T> SliceIn<T>(T[] storage, i64 count, i64 start, i64 length) {
    mut i64 from = start;
    if from < 0 {
        from = 0;
    }
    mut i64 to = from + length;
    if length < 0 {
        to = from;
    }
    if to > count {
        to = count;
    }
    mut i64 taken = to - from;
    if taken < 0 {
        taken = 0;
    }
    return List<T> { storage: Storage.CopyRange<T>(storage, from, taken), count: taken };
}

