use Core.Bytes.Slice;
use Core.IO.Closer;
use Core.IO.IoError;
use Core.IO.Reader;
use Core.IO.Stream;
use Core.IO.Writer;
use Core.Results;

// An in-memory `Core.IO.Stream` for tests and frame-level tools: reads
// return the preloaded `input` (then EOF) and writes collect into `output`.
// Like `TcpStream` it also declares Reader/Writer/Closer: Core.IO.ReadExact and
// WriteAll take those contracts, and 0.5.2 conformance is nominal.

pub type MemoryTransport: Stream, Reader, Writer, Closer {
    pub u8[] input,
    pub i64[] position,
    pub u8[] output,
    pub bool closed,
    pub Result<i64, IoError> Read(u8[] destination, i64 offset, i64 count) { return DoRead(this, destination, offset, count); }
    pub Result<i64, IoError> Write(u8[] source, i64 offset, i64 count) { return DoWrite(this, source, offset, count); }
    pub Result<unit, IoError> Close() { return DoClose(this); }
}

pub MemoryTransport New(u8[] input) {
    return MemoryTransport { input: input, position: [0_i64], output: Slice.New(0_i64), closed: false };
}

Result<i64, IoError> DoRead(MemoryTransport self, u8[] destination, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(destination), offset, count) { return Result::Error(IoError::InvalidRange); }
    i64 at = self.position[0];
    i64 available = Slice.Len(self.input) - at;
    mut i64 take = count;
    if take > available { take = available; }
    if take <= 0_i64 { return Result::Ok(0_i64); }
    Slice.Copy(destination, offset, self.input, at, take);
    self.position[0] = at + take;
    return Result::Ok(take);
}

Result<i64, IoError> DoWrite(MemoryTransport self, u8[] source, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(source), offset, count) { return Result::Error(IoError::InvalidRange); }
    i64 have = Slice.Len(self.output);
    u8[] out = Slice.New(have + count);
    if have > 0_i64 { Slice.Copy(out, 0_i64, self.output, 0_i64, have); }
    Slice.Copy(out, have, source, offset, count);
    self.output = out;
    return Result::Ok(count);
}

Result<unit, IoError> DoClose(MemoryTransport self) {
    self.closed = true;
    return Result::Ok(());
}

// `a` followed by `b`.
pub u8[] Join(u8[] a, u8[] b) {
    i64 na = Slice.Len(a);
    i64 nb = Slice.Len(b);
    u8[] out = Slice.New(na + nb);
    if na > 0_i64 { Slice.Copy(out, 0_i64, a, 0_i64, na); }
    if nb > 0_i64 { Slice.Copy(out, na, b, 0_i64, nb); }
    return out;
}
