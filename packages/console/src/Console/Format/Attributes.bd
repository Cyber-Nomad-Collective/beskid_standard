/// Parses `&[fg=…, bg=…]` attribute lists into `Ansi.StyleChain` steps.
use Ansi.StyleChain;
use Core.String;
use Core.Text.Number;

pub type ParsedRgb {
    bool ok,
    i64 r,
    i64 g,
    i64 b,
}

pub StyleChain ApplyPaletteTag(StyleChain chain, string tagName) {
    ParsedRgb rgb = ParseNamedColor(tagName);
    if rgb.ok {
        return StyleChain.ForegroundRgb(chain, rgb.r, rgb.g, rgb.b);
    }
    return chain;
}

pub StyleChain ApplyAttrList(mut StyleChain chain, string attrs) {
    mut string rest = attrs;
    while !String.IsEmpty(rest) {
        mut string token = "";
        i64 comma = String.IndexOf(rest, ",");
        if comma < 0 {
            token = String.Trim(rest);
            rest = "";
        } else {
            token = String.Trim(String.SubSlice(rest, 0, comma));
            rest = String.Trim(String.SubSlice(rest, comma + 1, String.Len(rest) - comma - 1));
        }
        if token != "" {
            chain = ApplyAttrToken(chain, token);
        }
    }
    return chain;
}

pub StyleChain ApplyAttrToken(StyleChain chain, string token) {
    if String.StartsWith(token, "fg=") {
        string value = String.Trim(String.RemovePrefix(token, "fg="));
        ParsedRgb rgb = ParseColor(value);
        if rgb.ok {
            return StyleChain.ForegroundRgb(chain, rgb.r, rgb.g, rgb.b);
        }
        return chain;
    }
    if String.StartsWith(token, "bg=") {
        string value = String.Trim(String.RemovePrefix(token, "bg="));
        ParsedRgb rgb = ParseColor(value);
        if rgb.ok {
            return StyleChain.BackgroundRgb(chain, rgb.r, rgb.g, rgb.b);
        }
        return chain;
    }
    return chain;
}

pub ParsedRgb ParseColor(string value) {
    if value == "" {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    if String.StartsWith(value, "#") {
        return ParseHexColor(String.RemovePrefix(value, "#"));
    }
    if String.StartsWith(value, "rgb(") {
        i64 close = String.IndexOfFrom(value, 4, ")");
        if close < 0 {
            return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
        }
        string inner = String.SubSlice(value, 4, close - 4);
        return ParseRgbTriplet(inner);
    }
    ParsedRgb triplet = ParseRgbTriplet(value);
    if triplet.ok {
        return triplet;
    }
    return ParseNamedColor(value);
}

pub ParsedRgb ParseNamedColor(string name) {
    if name == "black" {
        return ParsedRgb { ok: true, r: 0, g: 0, b: 0 };
    }
    if name == "red" {
        return ParsedRgb { ok: true, r: 205, g: 0, b: 0 };
    }
    if name == "green" {
        return ParsedRgb { ok: true, r: 0, g: 205, b: 0 };
    }
    if name == "yellow" {
        return ParsedRgb { ok: true, r: 205, g: 205, b: 0 };
    }
    if name == "blue" {
        return ParsedRgb { ok: true, r: 0, g: 0, b: 238 };
    }
    if name == "magenta" {
        return ParsedRgb { ok: true, r: 205, g: 0, b: 205 };
    }
    if name == "cyan" {
        return ParsedRgb { ok: true, r: 0, g: 205, b: 205 };
    }
    if name == "white" {
        return ParsedRgb { ok: true, r: 229, g: 229, b: 229 };
    }
    return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
}

pub ParsedRgb ParseRgbTriplet(string value) {
    i64 c1 = String.IndexOf(value, ",");
    if c1 < 0 {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    i64 c2 = String.IndexOfFrom(value, c1 + 1, ",");
    if c2 < 0 {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    i64 r = ChannelValue(String.Trim(String.SubSlice(value, 0, c1)));
    i64 g = ChannelValue(String.Trim(String.SubSlice(value, c1 + 1, c2 - c1 - 1)));
    i64 b = ChannelValue(String.Trim(String.SubSlice(value, c2 + 1, String.Len(value) - c2 - 1)));
    if r < 0 || g < 0 || b < 0 {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    return ParsedRgb { ok: true, r: r, g: g, b: b };
}

/// Parses `#rgb` (each digit doubled) or `#rrggbb` hex colors, without the `#`.
pub ParsedRgb ParseHexColor(string hex) {
    i64 n = String.Len(hex);
    if n != 3 && n != 6 {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    i64 width = n / 3;
    mut i64 r = Number.DigitsAt(hex, 0, width, 16);
    mut i64 g = Number.DigitsAt(hex, width, width, 16);
    mut i64 b = Number.DigitsAt(hex, width * 2, width, 16);
    if r < 0 || g < 0 || b < 0 {
        return ParsedRgb { ok: false, r: 0, g: 0, b: 0 };
    }
    if width == 1 {
        r = r * 17;
        g = g * 17;
        b = b * 17;
    }
    return ParsedRgb { ok: true, r: r, g: g, b: b };
}

/// A decimal color channel `0..=255` (leading zeros allowed, no sign), or `-1`.
i64 ChannelValue(string digits) {
    i64 n = String.Len(digits);
    if n == 0 || n > 18 {
        return -1;
    }
    i64 value = Number.DigitsAt(digits, 0, n, 10);
    if value > 255 {
        return -1;
    }
    return value;
}
