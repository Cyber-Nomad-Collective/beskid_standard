// ---- SchemaPatternTests.bd (formerly target `BsolSchemaPatternTests`) ----

string ReadPattern(string name, string part)
{
    match Environment.Get("BESKID_BSOL_CORPUS")
    {
        Result::Error(_) => {
            Assert.Fail("shared pattern corpus root required");
            return "";
        },

        Result::Ok(directory) => match FS.ReadAllText(directory + "/cases/schema-patterns/" + name + "." + part + ".bsol")
        {
            Result::Error(_) => {
                Assert.Fail("shared pattern source readable");
                return "";
            },

            Result::Ok(source) => {
                return source;
            },
        },
    };
}

unit ExpectPatternCode(Schema.Diagnostic[] errors, string code)
{
    mut bool found = false;
    mut i64 i = 0_i64;
    while (i < Array.Len<Schema.Diagnostic>(errors))
    {
        Schema.Diagnostic error = errors[i];
        if (error.code == code)
        {
            found = true;
            Assert.True(error.span.end > error.span.start, "checked pattern failure source-spanned");
        }
        i = i + 1_i64;
    }
    Assert.True(found, "exact shared pattern diagnostic");
}

unit CheckPatternCase(string name, string outcome)
{
    mut Limits.BsolLimits syntaxLimits = Limits.DefaultLimits();
    if (name == "subject-over-limit")
    {
        syntaxLimits.maxScalarBytes = 1048577_i64;
    }
    match Schema.ParseProfile(ReadPattern(name, "profile"), Limits.DefaultLimits())
    {
        Result::Error(errors) => {
            Assert.Equal(outcome, "InvalidPattern", "supported pattern must load profile");
            ExpectPatternCode(errors, "InvalidPattern");
        },

        Result::Ok(profile) => {
            Assert.True(outcome != "InvalidPattern", "invalid grammar cannot publish profile");
            match Parser.Parse(ReadPattern(name, "input"), syntaxLimits)
            {
                Result::Error(_) => Assert.Fail("pattern subject valid BSOL syntax"),

                Result::Ok(document) => match Schema.Validate(document, profile, syntaxLimits)
                {
                    Result::Error(errors) => {
                        Assert.True(outcome != "ok", "shared native pattern must match");
                        ExpectPatternCode(errors, outcome);
                    },

                    Result::Ok(_) => Assert.Equal(outcome, "ok", "shared native invalid subject rejected"),
                },
            };
        },
    };
}

unit CheckPatternPolicy(string pattern, string value, i64 subject, i64 work, i64 depth, string outcome)
{
    string source = "profile \"policy.v2\" { version = 2 rule \"config\" { match = keyword keyword = config label = forbidden cardinality = one field \"value\" { type = quoted required = true pattern = \"" + pattern + "\" } } }";
    match Schema.ParseProfile(source, Limits.DefaultLimits())
    {
        Result::Error(_) => Assert.Fail("caller policy profile valid"),

        Result::Ok(profile) => match Parser.Parse("config { value = \"" + value + "\" }", Limits.DefaultLimits())
        {
            Result::Error(_) => Assert.Fail("caller policy subject valid"),

            Result::Ok(document) => {
                Schema.PatternLimits policy = Schema.PatternLimits
                {
                    maxSubjectBytes: subject,

                    maxWork: work,

                    maxDepth: depth,
                };
                match Schema.ValidateWithPatternLimits(document, profile, Limits.DefaultLimits(), policy)
                {
                    Result::Error(errors) => {
                        Assert.True(outcome != "ok", "explicit caller policy should succeed");
                        ExpectPatternCode(errors, outcome);
                    },

                    Result::Ok(_) => Assert.Equal(outcome, "ok", "explicit caller policy checked failure"),
                };
            },
        },
    };
}

