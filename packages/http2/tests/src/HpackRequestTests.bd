use Testing.Assert;
use Core.Results;
use Http2.Hpack;
use Http2.HpackDecoder;
use Http2.HpackEncoder;
use HpackSupport;

// RFC 7541 Appendix C.3 and C.4 request sequences (generated from the RFC text).

test C3RequestsWithoutHuffmanDecode
{
    mut Decoder decoder = NewTestDecoder(4096_i64);
    HeaderField[] block1 = DecodeOk(decoder, "828684410f7777772e6578616d706c652e636f6d", "C.3.1");
    ExpectFields(block1, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], "C.3.1 header list");
    ExpectTable(decoder, [":authority", "www.example.com"], 57_i64, "C.3.1");
    HeaderField[] block2 = DecodeOk(decoder, "828684be58086e6f2d6361636865", "C.3.2");
    ExpectFields(block2, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"], "C.3.2 header list");
    ExpectTable(decoder, ["cache-control", "no-cache", ":authority", "www.example.com"], 110_i64, "C.3.2");
    HeaderField[] block3 = DecodeOk(decoder, "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565", "C.3.3");
    ExpectFields(block3, [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"], "C.3.3 header list");
    ExpectTable(decoder, ["custom-key", "custom-value", "cache-control", "no-cache", ":authority", "www.example.com"], 164_i64, "C.3.3");
}

test C3RequestsWithoutHuffmanEncode
{
    mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, false));
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"])), "828684410f7777772e6578616d706c652e636f6d", "C.3.1");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 57_i64, "C.3.1 encoder table size");
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"])), "828684be58086e6f2d6361636865", "C.3.2");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 110_i64, "C.3.2 encoder table size");
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"])), "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565", "C.3.3");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 164_i64, "C.3.3 encoder table size");
}

test C3RequestsWithoutHuffmanRoundTrip
{
    mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, false));
    mut Decoder decoder = NewTestDecoder(4096_i64);
    u8[] wire1 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"]));
    Result<HeaderField[], HpackError> decoded1 = HpackDecoder.Decode(decoder, wire1);
    match (decoded1)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], "C.3.1 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.3.1 round trip decode");
        },
    };
    u8[] wire2 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"]));
    Result<HeaderField[], HpackError> decoded2 = HpackDecoder.Decode(decoder, wire2);
    match (decoded2)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"], "C.3.2 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.3.2 round trip decode");
        },
    };
    u8[] wire3 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"]));
    Result<HeaderField[], HpackError> decoded3 = HpackDecoder.Decode(decoder, wire3);
    match (decoded3)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"], "C.3.3 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.3.3 round trip decode");
        },
    };
}

test C4RequestsWithHuffmanDecode
{
    mut Decoder decoder = NewTestDecoder(4096_i64);
    HeaderField[] block1 = DecodeOk(decoder, "828684418cf1e3c2e5f23a6ba0ab90f4ff", "C.4.1");
    ExpectFields(block1, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], "C.4.1 header list");
    ExpectTable(decoder, [":authority", "www.example.com"], 57_i64, "C.4.1");
    HeaderField[] block2 = DecodeOk(decoder, "828684be5886a8eb10649cbf", "C.4.2");
    ExpectFields(block2, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"], "C.4.2 header list");
    ExpectTable(decoder, ["cache-control", "no-cache", ":authority", "www.example.com"], 110_i64, "C.4.2");
    HeaderField[] block3 = DecodeOk(decoder, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", "C.4.3");
    ExpectFields(block3, [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"], "C.4.3 header list");
    ExpectTable(decoder, ["custom-key", "custom-value", "cache-control", "no-cache", ":authority", "www.example.com"], 164_i64, "C.4.3");
}

test C4RequestsWithHuffmanEncode
{
    mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, true));
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"])), "828684418cf1e3c2e5f23a6ba0ab90f4ff", "C.4.1");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 57_i64, "C.4.1 encoder table size");
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"])), "828684be5886a8eb10649cbf", "C.4.2");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 110_i64, "C.4.2 encoder table size");
    ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"])), "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", "C.4.3");
    Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 164_i64, "C.4.3 encoder table size");
}

test C4RequestsWithHuffmanRoundTrip
{
    mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, true));
    mut Decoder decoder = NewTestDecoder(4096_i64);
    u8[] wire1 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"]));
    Result<HeaderField[], HpackError> decoded1 = HpackDecoder.Decode(decoder, wire1);
    match (decoded1)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com"], "C.4.1 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.4.1 round trip decode");
        },
    };
    u8[] wire2 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"]));
    Result<HeaderField[], HpackError> decoded2 = HpackDecoder.Decode(decoder, wire2);
    match (decoded2)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "http", ":path", "/", ":authority", "www.example.com", "cache-control", "no-cache"], "C.4.2 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.4.2 round trip decode");
        },
    };
    u8[] wire3 = HpackEncoder.Encode(encoder, Fields([":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"]));
    Result<HeaderField[], HpackError> decoded3 = HpackDecoder.Decode(decoder, wire3);
    match (decoded3)
    {
        Result::Ok(fields) => {
            ExpectFields(fields, [":method", "GET", ":scheme", "https", ":path", "/index.html", ":authority", "www.example.com", "custom-key", "custom-value"], "C.4.3 round trip");
        },
        Result::Error(_) => {
            Assert.Fail("C.4.3 round trip decode");
        },
    };
}
