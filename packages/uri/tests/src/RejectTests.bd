use Testing.Assert;
use Core.Results;
use Core.String;
use Uri.Errors;
use Uri.Parse;
use Uri.Types;

// Error code of ParseReference, or 0 when it succeeds.
i64 C(string text) {
    Result<UriRef, UriError> r = Parse.ParseReference(text);
    return match r { Result::Ok(_) => 0_i64, Result::Error(e) => Errors.Code(e), };
}
// UriError codes: 2 InvalidCharacter, 3 InvalidPercentEncoding, 4 InvalidScheme, 5 InvalidAuthority,
// 6 InvalidUserinfo, 7 InvalidHost, 8 InvalidIpv4, 9 InvalidIpv6, 10 IpvFutureNotAllowed,
// 11 InvalidPort, 12 PortOutOfRange, 13 InvalidPath, 14 InvalidQuery, 15 InvalidFragment.

test illegal_bytes_space_group { Assert.Equal<i64>(C("http://h/a b"), 2_i64, "space"); Assert.Equal<i64>(C("http://h/a\"b"), 2_i64, "double quote"); Assert.Equal<i64>(C("http://h/<a>"), 2_i64, "angle brackets"); Assert.Equal<i64>(C("http://h/a|b"), 2_i64, "pipe"); Assert.Equal<i64>(C("http://h/a\\b"), 2_i64, "backslash"); Assert.Equal<i64>(C("http://h/a^b"), 2_i64, "caret"); Assert.Equal<i64>(C("http://h/a`b"), 2_i64, "backtick"); Assert.Equal<i64>(C("http://h/{a}"), 2_i64, "braces"); }
test illegal_bytes_newline_group { Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 10_u8])), 2_i64, "newline"); Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 0_u8])), 2_i64, "NUL"); Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 195_u8, 169_u8])), 2_i64, "non-ASCII"); Assert.Equal<i64>(C("http://h/%"), 3_i64, "lone percent"); Assert.Equal<i64>(C("http://h/%4"), 3_i64, "one digit"); Assert.Equal<i64>(C("http://h/%zz"), 3_i64, "non hex"); Assert.Equal<i64>(C("http://h/a%2"), 3_i64, "cut escape at end"); Assert.Equal<i64>(C("http://h/?q=%g1"), 3_i64, "in query"); }
test percent_encoding_is_strict_in_fragment_group { Assert.Equal<i64>(C("http://h/#%1"), 3_i64, "in fragment"); Assert.Equal<i64>(C("http://%zz@h/"), 3_i64, "in userinfo"); Assert.Equal<i64>(C("http://h%/"), 3_i64, "in host"); Assert.Equal<i64>(C("http://h/%41%7e"), 0_i64, "valid escapes"); Assert.Equal<i64>(C("1http://h/"), 4_i64, "digit first"); Assert.Equal<i64>(C("://h/"), 4_i64, "empty scheme"); Assert.Equal<i64>(C("ht_tp://h/"), 4_i64, "underscore"); Assert.Equal<i64>(C("ht tp://h/"), 2_i64, "space is an illegal byte first"); }
test scheme_rules_allowed_scheme_characters_group { Assert.Equal<i64>(C("a+b-c.d://h/"), 0_i64, "allowed scheme characters"); Assert.Equal<i64>(C("HTTP://h/"), 0_i64, "uppercase scheme"); Assert.Equal<i64>(C("http://us er@h/"), 2_i64, "space in userinfo"); Assert.Equal<i64>(C("http://a@b@c/"), 7_i64, "two at signs"); Assert.Equal<i64>(C("http://h:1:2/"), 7_i64, "two colons in host"); Assert.Equal<i64>(C("http://[::1/"), 7_i64, "unclosed bracket"); Assert.Equal<i64>(C("http://[::1]x/"), 5_i64, "junk after bracket"); Assert.Equal<i64>(C("http://h[1]/"), 7_i64, "brackets inside reg-name"); }
test authority_rules_bracket_in_userinfo_group { Assert.Equal<i64>(C("http://a[b@h/"), 6_i64, "bracket in userinfo"); Assert.Equal<i64>(C("http://h:65536/"), 12_i64, "65536"); Assert.Equal<i64>(C("http://h:99999999999999999999/"), 12_i64, "huge"); Assert.Equal<i64>(C("http://h:-1/"), 11_i64, "negative"); Assert.Equal<i64>(C("http://h:8a/"), 11_i64, "letters"); Assert.Equal<i64>(C("http://[::1]:x/"), 11_i64, "ipv6 letters"); Assert.Equal<i64>(C("http://[::1]:65536/"), 12_i64, "ipv6 out of range"); Assert.Equal<i64>(C("http://h/a[b]"), 13_i64, "brackets in path"); }
test component_character_sets_brackets_in_query_group { Assert.Equal<i64>(C("http://h/?a[b]"), 14_i64, "brackets in query"); Assert.Equal<i64>(C("http://h/#a[b]"), 15_i64, "brackets in fragment"); Assert.Equal<i64>(C("http://h/#a#b"), 15_i64, "second hash"); Assert.Equal<i64>(C("http://h/p?a#b?c"), 0_i64, "question mark after hash is data"); }
test length_limit0 { Result<UriRef, UriError> r = Parse.ParseWith("http://h/aaaaaaaaaa", 10_i64, false, false); }
i64 Lim(string text, i64 max) {
    Result<UriRef, UriError> r = Parse.ParseWith(text, max, false, false);
    return match r { Result::Ok(_) => 0_i64, Result::Error(e) => Errors.Code(e), };
}
test length_limit_toolong_group { Assert.Equal<i64>(Lim("http://h/aaaaaaaaaa", 10_i64), 1_i64, "TooLong"); Assert.Equal<i64>(Lim("http://h/", 9_i64), 0_i64, "at limit"); }
