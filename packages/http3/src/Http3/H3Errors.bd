// RFC 9114 section 8.1 and RFC 9204 section 6 error codes, and the typed
// failure returned by the HTTP/3 API.

pub i64 NoError() { return 256_i64; }
pub i64 GeneralProtocolError() { return 257_i64; }
pub i64 InternalError() { return 258_i64; }
pub i64 StreamCreationError() { return 259_i64; }
pub i64 ClosedCriticalStream() { return 260_i64; }
pub i64 FrameUnexpected() { return 261_i64; }
pub i64 FrameError() { return 262_i64; }
pub i64 ExcessiveLoad() { return 263_i64; }
pub i64 IdError() { return 264_i64; }
pub i64 SettingsError() { return 265_i64; }
pub i64 MissingSettings() { return 266_i64; }
pub i64 RequestRejected() { return 267_i64; }
pub i64 RequestCancelled() { return 268_i64; }
pub i64 RequestIncomplete() { return 269_i64; }
pub i64 MessageError() { return 270_i64; }
pub i64 ConnectError() { return 271_i64; }
pub i64 VersionFallback() { return 272_i64; }
pub i64 QpackDecompressionFailed() { return 512_i64; }
pub i64 QpackEncoderStreamError() { return 513_i64; }
pub i64 QpackDecoderStreamError() { return 514_i64; }

/// Typed HTTP/3 failures. Codes are the RFC 9114 / RFC 9204 values above.
pub enum H3Error {
    /// The connection is closed (or must close) with this application error code.
    Connection(i64 code),
    /// One request stream failed with this code; the connection stays usable.
    Stream(i64 code),
    /// The message cannot be expressed in HTTP/3 (bad pseudo-headers, framing, ...).
    InvalidMessage(),
    /// The peer sent GOAWAY; no new request may start (retry on a new connection).
    GoingAway(),
    /// The operation did not complete within its poll budget or deadline.
    Timeout(),
    /// The QUIC transport failed or was closed.
    Transport(),
}

/// The numeric code of an error (0 for errors without a wire code).
pub i64 CodeOf(H3Error error) {
    return match error {
        H3Error::Connection(code) => code,
        H3Error::Stream(code) => code,
        H3Error::InvalidMessage() => MessageError(),
        H3Error::GoingAway() => RequestRejected(),
        H3Error::Timeout() => 0_i64,
        H3Error::Transport() => 0_i64,
    };
}
