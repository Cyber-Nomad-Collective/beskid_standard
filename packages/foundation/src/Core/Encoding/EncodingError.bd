/// Shared encoding failure variants.
/// @tier(standard)
pub enum EncodingError {
    /// Byte sequence is not valid for this encoding; carries offset and offending byte.
    InvalidSequence(i64 offset, i64 byte),
    /// Base64 padding or length is invalid; carries position and padding char.
    InvalidPadding(i64 position, i64 char),
    /// Hex input has odd length; carries the length received.
    OddLength(i64 length),
}
