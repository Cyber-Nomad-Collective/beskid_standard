serialization_mod_tests {
  name = "serialization_mod_tests"
  version = "0.6.0"
  root = "."
}
dependency "corelib_foundation" { source = path path = "../../../packages/foundation" }
dependency "corelib_compiler_sdk" { source = path path = "../../../packages/compiler-sdk" }
dependency "serialization_mod" { source = path path = ".." }
target "SerializationModSyntaxTests" { kind = Test entry = "SyntaxTests.bd" }
target "SerializationModGenerationTests" { kind = Test entry = "GenerationTests.bd" }
target "SerializationModEligibilityTests" { kind = Test entry = "EligibilityTests.bd" }
