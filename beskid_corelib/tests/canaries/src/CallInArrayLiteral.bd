/// Canary: Array literals may contain concatenations of call results.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Collections.Array;

string Piece(string text) {
    return text;
}

test concatenated_calls_inside_array_literal {
    string[] values = [Piece("a") + Piece("b"), Piece("c")];
    Assert.True(Array.Get<string>(values, 0) == "ab", "array literal with concatenated calls");
}
