use Core.Bytes.Slice;

/// Compares two byte arrays without an early exit on the first differing byte.
/// Only the lengths are compared in variable time; lengths are public in every caller.
pub bool Equal(u8[] left, u8[] right) {
    i64 count = Slice.Len(left);
    if count != Slice.Len(right) { return false; }
    return EqualRange(left, 0_i64, right, 0_i64, count);
}

/// Compares `count` bytes of `left` at `leftOffset` with `right` at `rightOffset`
/// in time that depends only on `count`. Out-of-range requests return false.
pub bool EqualRange(u8[] left, i64 leftOffset, u8[] right, i64 rightOffset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(left), leftOffset, count) { return false; }
    if !Slice.IsValidRange(Slice.Len(right), rightOffset, count) { return false; }
    mut u32 diff = 0_u32;
    mut i64 i = 0_i64;
    while i < count {
        u32 a = u32(left[leftOffset + i]);
        u32 b = u32(right[rightOffset + i]);
        diff = diff | ((a | b) - (a & b));
        i = i + 1_i64;
    }
    return diff == 0_u32;
}

/// Returns 1 when `value` is zero and 0 otherwise, without a branch on `value`.
pub u32 IsZero(u32 value) {
    // (value - 1) has its top bit set only when value is 0 or value >= 2^31;
    // masking with NOT value removes the second case.
    u32 notValue = 0xFFFFFFFF_u32 - value;
    return ((value - 1_u32) & notValue) >> 31_u32;
}

/// Overwrites every byte with zero. Used to drop key material and rejected plaintext.
pub unit Wipe(u8[] data) {
    mut i64 i = 0_i64;
    i64 count = Slice.Len(data);
    while i < count { data[i] = 0_u8; i = i + 1_i64; }
    return;
}
