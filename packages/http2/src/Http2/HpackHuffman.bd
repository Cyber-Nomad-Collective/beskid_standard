/// Decoding tables built once and shared by a decoder.
pub type HuffmanTables { pub i64[] fsm, pub i64[] stateInfo, pub u32[] codes, pub u8[] lengths, }

pub HuffmanTables NewHuffmanTables() {
    return HuffmanTables { fsm: FsmTable(), stateInfo: StateInfo(), codes: Codes(), lengths: Lengths() };
}

/// Decodes `count` octets at `offset`. Output longer than `maxOutput` is
/// StringTooLong; EOS is HuffmanEos; padding longer than 7 bits or not all
/// ones is rejected (RFC 7541 section 5.2).
pub Result<u8[],HpackError> HuffmanDecode(HuffmanTables tables, u8[] src, i64 offset, i64 count, i64 maxOutput) {
    // Codes are at least 5 bits, so `count` octets hold fewer than 2 * count symbols.
    u8[] out = Mem.Zeroed(2_i64 * count + 2_i64);
    i64[] fsm = tables.fsm;
    mut i64 produced = 0_i64;
    mut i64 state = 0_i64;
    mut i64 i = 0_i64;
    while i < count {
        i64 octet = i64(src[offset + i]);
        i64 high = fsm[(state << 4_i64) | (octet >> 4_i64)];
        if (high & 512_i64) != 0_i64 { return Result::Error(HpackError::HuffmanEos); }
        out[produced] = u8((high >> 16_i64) & 255_i64);
        produced = produced + ((high >> 8_i64) & 1_i64);
        if produced > maxOutput { return Result::Error(HpackError::StringTooLong(produced)); }
        state = high & 255_i64;
        i64 low = fsm[(state << 4_i64) | (octet & 15_i64)];
        if (low & 512_i64) != 0_i64 { return Result::Error(HpackError::HuffmanEos); }
        out[produced] = u8((low >> 16_i64) & 255_i64);
        produced = produced + ((low >> 8_i64) & 1_i64);
        if produced > maxOutput { return Result::Error(HpackError::StringTooLong(produced)); }
        state = low & 255_i64;
        i = i + 1_i64;
    }
    i64 info = tables.stateInfo[state];
    if (info & 255_i64) > 7_i64 { return Result::Error(HpackError::HuffmanPaddingTooLong); }
    if (info >> 8_i64) == 0_i64 { return Result::Error(HpackError::HuffmanInvalidPadding); }
    return Result::Ok(Mem.SubSlice(out, 0_i64, produced));
}

/// Octets needed to Huffman-encode `data`.
pub i64 HuffmanEncodedLength(HuffmanTables tables, u8[] data) {
    mut i64 total = 0_i64;
    mut i64 i = 0_i64;
    while i < Slice.Len(data) { total = total + i64(tables.lengths[i64(data[i])]); i = i + 1_i64; }
    return (total + 7_i64) / 8_i64;
}

/// Appends the Huffman encoding of `data`, padded with the EOS prefix (all ones).
/// Returns the grown buffer.
pub u8[] HuffmanEncode(HuffmanTables tables, mut u8[] out, u8[] data) {
    mut i64 acc = 0_i64;
    mut i64 pending = 0_i64;
    mut i64 i = 0_i64;
    while i < Slice.Len(data) {
        i64 symbol = i64(data[i]);
        i64 length = i64(tables.lengths[symbol]);
        acc = (acc << length) | i64(tables.codes[symbol]);
        pending = pending + length;
        while pending >= 8_i64 {
            pending = pending - 8_i64;
            Array.Append<u8>(out, u8((acc >> pending) & 255_i64));
        }
        acc = acc & ((1_i64 << pending) - 1_i64);
        i = i + 1_i64;
    }
    if pending > 0_i64 {
        i64 padBits = 8_i64 - pending;
        Array.Append<u8>(out, u8(((acc << padBits) | ((1_i64 << padBits) - 1_i64)) & 255_i64));
    }
    return out;
}
