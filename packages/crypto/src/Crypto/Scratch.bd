/// A zero-filled byte buffer of `count` bytes (`count` < 0 gives an empty buffer).
pub u8[] Bytes(i64 count) {
    if count == 16_i64 { return Zero16(); }
    if count == 32_i64 { return Zero32(); }
    if count == 64_i64 { return Zero64(); }
    if count == 128_i64 { return Zero128(); }
    if count == 176_i64 { return Zero176(); }
    if count == 208_i64 { return Zero208(); }
    if count == 240_i64 { return Zero240(); }
    mut u8[] result = Zero16();
    mut i64 len = 16_i64;
    if count > 16_i64 { result = Zero128(); len = 128_i64; }
    mut i64 target = count;
    if target < 0_i64 { target = 0_i64; }
    while len > target {
        Array.RemoveLast<u8>(result);
        len = len - 1_i64;
    }
    while len < target {
        Array.Append<u8>(result, 0_u8);
        len = len + 1_i64;
    }
    return result;
}

/// A copy of `source[offset, offset + count)`. Precondition: the range is in bounds.
pub u8[] Sub(u8[] source, i64 offset, i64 count) {
    u8[] out = Bytes(count);
    mut i64 i = 0_i64;
    while i < count {
        out[i] = source[offset + i];
        i = i + 1_i64;
    }
    return out;
}
