/// A frozen array: `ReadOnlyArray<T>` is built only by `Freeze`, which consumes the caller's
/// array binding, and offers no operation that writes an element or exposes the backing array.
///
/// It is Shared when `T` is Shared and not transferable otherwise, so a frozen array of Shared
/// elements crosses to other isolates by pointer.
use Core.Collections.Array;
use Core.Optional.Option;

[Immutable]
pub type ReadOnlyArray<T> {
    [ImmutableStorage] T[] items,

    /// Number of elements.
    pub i64 Count() {
        return Array.Len<T>(this.items);
    }

    /// The element at `index`. Panics when `index` is out of range.
    pub T Get(i64 index) {
        if index < 0 || index >= Array.Len<T>(this.items) {
            __panic_str("ReadOnlyArray.Get: index out of range");
        }
        return Array.Get<T>(this.items, index);
    }

    /// The element at `index`, or `None` when `index` is out of range.
    pub Option<T> TryGet(i64 index) {
        if index < 0 || index >= Array.Len<T>(this.items) {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.items, index));
    }
}

/// Freezes `items`. The array binding of the caller is consumed: nothing can write the array
/// afterwards, so the result is safe to share.
pub ReadOnlyArray<T> Freeze<T>(move T[] items) where T: Core.Parallel.Transferable {
    return ReadOnlyArray<T> { items: items };
}
