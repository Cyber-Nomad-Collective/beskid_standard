/// Unsigned big integers as little-endian `u32[]` limb vectors.
///
/// Limb vectors may carry leading zero limbs; every function treats missing limbs as zero.
/// Products and carries use `i64` locals as unsigned 64-bit values: Beskid 0.5.2 `i64`
/// arithmetic wraps and `>>` is logical, so `(a * b + c + d) >> 32` is the exact high
/// word for 32-bit `a b c d`. Limbs are stored in `u32[]` because `i64[]` stores are slow
/// under the 0.5.2 JIT (see protocols/COMPILER-GAPS.md).
///
/// These helpers are variable-time and meant for public values (RSA moduli, signatures,
/// encodings). Secret-dependent arithmetic goes through `Crypto.ModArith`.
use Core.Collections.Array;
use Core.Bytes.Slice;
use Core.Results;
use Crypto.PkErrors;

/// Largest supported operand: 8192 bits (twice an RSA-4096 modulus, room for products).
pub i64 MaxLimbs() { return 256_i64; }

pub i64 Mask32() { return 4294967295_i64; }

/// A zero-filled limb vector of `count` limbs.
/// Array literals allocate in one step while `Array.Append` costs about 200 ns per element
/// under the 0.5.2 JIT, so this trims a literal tier with the cheap `Array.RemoveLast`
/// and only appends beyond 1024 limbs.
pub u32[] Zeros(i64 count) {
    if count <= 16_i64 { return FitLimbs(ZeroLimbs16(), 16_i64, count); }
    return FitLimbs(ZeroLimbs1024(), 1024_i64, count);
}

u32[] FitLimbs(u32[] literal, i64 size, i64 count) {
    mut u32[] result = literal;
    mut i64 len = size;
    mut i64 target = count;
    if target < 0_i64 { target = 0_i64; }
    while len > target {
        Array.RemoveLast<u32>(result);
        len = len - 1_i64;
    }
    while len < target {
        Array.Append<u32>(result, 0_u32);
        len = len + 1_i64;
    }
    return result;
}

/// A zero-filled byte buffer of `count` bytes; `Slice.New` appends one byte at a time.
pub u8[] ZeroBytes(i64 count) {
    if count <= 64_i64 { return FitBytes(ZeroBytes64(), 64_i64, count); }
    return FitBytes(ZeroBytes512(), 512_i64, count);
}

u8[] FitBytes(u8[] literal, i64 size, i64 count) {
    mut u8[] result = literal;
    mut i64 len = size;
    mut i64 target = count;
    if target < 0_i64 { target = 0_i64; }
    while len > target {
        Array.RemoveLast<u8>(result);
        len = len - 1_i64;
    }
    while len < target {
        Array.Append<u8>(result, 0_u8);
        len = len + 1_i64;
    }
    return result;
}

u32[] ZeroLimbs16() {
    return [
        0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32,
    ];
}

