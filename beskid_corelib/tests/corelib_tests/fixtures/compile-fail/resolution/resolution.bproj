resolution {
  name = "resolution"
  version = "0.1.0"
  root = "."
}

dependency "corelib" {
  source = path
  path = "../../../../.."
}

target "LegacyCollectionsNamespace" {
  kind = Lib
  entry = "LegacyCollectionsNamespace.bd"
}

target "DynamicCompositionLookup" {
  kind = Lib
  entry = "DynamicCompositionLookup.bd"
}
