/// Threading module tests — OS-thread surface (gate-level; Spawn/Join bodies not evaluated).

use Testing.Assert;
use Core.Threading.Thread;
use Core.Threading.ThreadError;
use Core.Results;


test thread_yield_returns_unit {
    Thread.Yield();
    Assert.True(true, "Yield returns unit without crashing");
}

test thread_surface_imports {
    Core.Results.Result<Thread, ThreadError> result =
        Result::Error(ThreadError::SpawnFailed(1_i64));
    Assert.True(Results.IsError(result), "Thread and ThreadError are exposed from their canonical modules");
}
