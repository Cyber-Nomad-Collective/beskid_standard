/// Query.Iterator — contract-based iteration for Beskid collections.
/// @tier(supported)
/// Modeled after Rust's `Iterator` trait. Concrete iterators implement this contract, binding
/// `Item` to their own element type and returning `This` from `MoveNext` so the fluent chain
/// stays typed as the concrete implementor.

use Core.Optional.Option;

pub contract Iterator<T> {
    type Item;
    Option<Item> Current();
    This MoveNext();
}
