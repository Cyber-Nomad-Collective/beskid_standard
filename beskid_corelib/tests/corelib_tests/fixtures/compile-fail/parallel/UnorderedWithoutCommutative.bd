// EXPECT: E1610
// `ReduceUnordered` requires `Commutative<string>`; the report names the missing contract.
use Core.Collections.List;
use Core.Parallel;
use Core.Parallel.Combiners;
use Core.Parallel.ParallelSeq;

[Immutable]
pub type Append : Associative<string> {
    pub string Combine(string a, string b) {
        return a + b;
    }
}

test UnorderedReduceNeedsACommutativeCombiner {
    List<string> words = List.New<string>();
    string joined = words.Parallel().ReduceUnordered("", Append { });
}
