/// Exact IEEE bit projections. These operations preserve NaN payloads and signed zero.
pub u32 ToBits32(f32 value) { return __float_to_bits32(value); }
pub f32 FromBits32(u32 value) { return __float_from_bits32(value); }
pub u64 ToBits64(f64 value) { return __float_to_bits64(value); }
pub f64 FromBits64(u64 value) { return __float_from_bits64(value); }
