/// Recursive-backtracking regex engine: pattern matching, quantifiers,
/// character classes, escapes, literals, and pattern-navigation helpers.
use Core.String;
use Core.Text.Cursor;
use Core.Text.Parser;
use Core.Text.Regex.Generated;
use Core.Text.Regex.Types;

pub MatchStep MatchPat(string pattern, i64 patPos, string text, i64 textPos) {
    mut i64 branchStart = patPos;
    while branchStart < PatLen(pattern) {
        MatchStep branch = MatchBranch(pattern, branchStart, text, textPos);
        if branch.ok {
            return branch;
        }
        i64 nextBranch = NextPatBranch(pattern, branchStart);
        if nextBranch < 0 {
            break;
        }
        branchStart = nextBranch;
    }
    return MatchStep { patPos: patPos, textPos: textPos, ok: false };
}

MatchStep MatchBranch(string pattern, i64 patPos, string text, i64 textPos) {
    mut i64 pos = patPos;
    mut i64 curText = textPos;
    while pos < PatLen(pattern) {
        if IsBranchTerminator(PatAt(pattern, pos)) {
            break;
        }
        MatchStep piece = MatchPiece(pattern, pos, text, curText);
        if !piece.ok {
            return MatchStep { patPos: patPos, textPos: textPos, ok: false };
        }
        pos = piece.patPos;
        curText = piece.textPos;
    }
    return MatchStep { patPos: pos, textPos: curText, ok: true };
}

bool IsBranchTerminator(string ch) {
    return ch == "|" || ch == ")";
}

MatchStep MatchPiece(string pattern, i64 patPos, string text, i64 textPos) {
    if patPos >= PatLen(pattern) {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    mut i64 pieceEnd = 0;
    mut string quant = "";
    MatchStep one = MatchPieceCore(pattern, patPos, text, textPos);
    if !one.ok {
        return one;
    }
    pieceEnd = one.patPos;
    if pieceEnd < PatLen(pattern) {
        string q = PatAt(pattern, pieceEnd);
        if q == "*" || q == "+" || q == "?" {
            quant = q;
            pieceEnd = pieceEnd + 1;
        }
    }
    if quant == "" {
        return MatchStep { patPos: pieceEnd, textPos: one.textPos, ok: true };
    }
    return MatchQuant(pattern, patPos, pieceEnd, text, textPos, quant);
}

MatchStep MatchPieceCore(string pattern, i64 patPos, string text, i64 textPos) {
    string ch = PatAt(pattern, patPos);
    if ch == "^" {
        if textPos != 0 {
            return MatchStep { patPos: patPos, textPos: textPos, ok: false };
        }
        return MatchStep { patPos: patPos + 1, textPos: textPos, ok: true };
    }
    if ch == "$" {
        if textPos != PatLen(text) {
            return MatchStep { patPos: patPos, textPos: textPos, ok: false };
        }
        return MatchStep { patPos: patPos + 1, textPos: textPos, ok: true };
    }
    if ch == "(" {
        i64 close = FindClosingParen(pattern, patPos);
        if close < 0 {
            return MatchStep { patPos: patPos, textPos: textPos, ok: false };
        }
        MatchStep inner = MatchPat(pattern, patPos + 1, text, textPos);
        if !inner.ok {
            return inner;
        }
        return MatchStep { patPos: close + 1, textPos: inner.textPos, ok: true };
    }
    if ch == "[" {
        i64 close = FindClosingBracket(pattern, patPos);
        if close < 0 {
            return MatchStep { patPos: patPos, textPos: textPos, ok: false };
        }
        return MatchClass(pattern, patPos + 1, close, text, textPos);
    }
    if ch == "\\" {
        return MatchEscape(pattern, patPos, text, textPos);
    }
    if ch == "." {
        return MatchDot(text, textPos, patPos + 1);
    }
    return MatchLiteral(pattern, patPos, text, textPos);
}

MatchStep MatchQuant(string pattern, i64 pieceStart, i64 patAfter, string text, i64 textPos, string quant) {
    mut i64 min = 1;
    mut i64 max = 1000000;
    if quant == "*" {
        min = 0;
    }
    if quant == "?" {
        min = 0;
        max = 1;
    }
    mut i64 count = 0;
    mut i64 curText = textPos;
    mut i64 lastGood = textPos;
    while count < max {
        MatchStep one = MatchPieceCore(pattern, pieceStart, text, curText);
        if !one.ok {
            break;
        }
        if one.textPos == curText {
            return MatchStep { patPos: pieceStart, textPos: textPos, ok: false };
        }
        count = count + 1;
        curText = one.textPos;
        if count >= min {
            lastGood = curText;
        }
    }
    if count < min {
        return MatchStep { patPos: pieceStart, textPos: textPos, ok: false };
    }
    return MatchStep { patPos: patAfter, textPos: lastGood, ok: true };
}

pub MatchStep MatchDot(string text, i64 textPos, i64 patAfter) {
    Cursor.TextCursor c = Cursor.Advance(Cursor.From(text), textPos);
    Parser.Result.TextParseResult<string> parsed = Generated.ParseAnyUnit(c);
    if !Parser.IsOk(parsed) {
        return MatchStep { patPos: patAfter, textPos: textPos, ok: false };
    }
    Cursor.TextCursor rest = Parser.RestOnOk(parsed, c);
    return MatchStep { patPos: patAfter, textPos: Cursor.Position(rest), ok: true };
}

MatchStep MatchEscape(string pattern, i64 patPos, string text, i64 textPos) {
    if patPos + 1 >= PatLen(pattern) {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    string esc = PatAt(pattern, patPos + 1);
    Cursor.TextCursor c = Cursor.Advance(Cursor.From(text), textPos);
    mut Parser.Result.TextParseResult<string> parsed = Generated.ParseDigit(c);
    if esc == "d" {
        parsed = Generated.ParseDigit(c);
    } else if esc == "D" {
        parsed = MatchNotDigit(c);
    } else if esc == "w" {
        parsed = Generated.ParseWordTail(c);
    } else if esc == "W" {
        parsed = MatchNotWord(c);
    } else if esc == "s" {
        parsed = Generated.ParseSpace(c);
    } else if esc == "S" {
        parsed = MatchNotSpace(c);
    } else if esc == "." || esc == "\\" || esc == "/" || esc == "-" || esc == "+" || esc == "|" || esc == "(" || esc == ")" || esc == "[" || esc == "]" {
        string lit = PatAt(pattern, patPos + 1);
        parsed = Parser.Literal(c, lit, "escape");
    } else {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    if !Parser.IsOk(parsed) {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    Cursor.TextCursor rest = Parser.RestOnOk(parsed, c);
    return MatchStep { patPos: patPos + 2, textPos: Cursor.Position(rest), ok: true };
}

pub Parser.Result.TextParseResult<string> MatchNotDigit(Cursor.TextCursor c) {
    Parser.Result.TextParseResult<string> digit = Generated.ParseDigit(c);
    if Parser.IsOk(digit) {
        return Parser.Fail(c, ParseErrorKind::ExpectedRule("not_digit"), "not_digit");
    }
    return Generated.ParseAnyUnit(c);
}

pub Parser.Result.TextParseResult<string> MatchNotWord(Cursor.TextCursor c) {
    Parser.Result.TextParseResult<string> word = Generated.ParseWordTail(c);
    if Parser.IsOk(word) {
        return Parser.Fail(c, ParseErrorKind::ExpectedRule("not_word"), "not_word");
    }
    return Generated.ParseAnyUnit(c);
}

pub Parser.Result.TextParseResult<string> MatchNotSpace(Cursor.TextCursor c) {
    Parser.Result.TextParseResult<string> space = Generated.ParseSpace(c);
    if Parser.IsOk(space) {
        return Parser.Fail(c, ParseErrorKind::ExpectedRule("not_space"), "not_space");
    }
    return Generated.ParseAnyUnit(c);
}

MatchStep MatchClass(string pattern, i64 start, i64 close, string text, i64 textPos) {
    mut bool neg = false;
    mut i64 pos = start;
    if pos < close && PatAt(pattern, pos) == "^" {
        neg = true;
        pos = pos + 1;
    }
    Cursor.TextCursor c = Cursor.Advance(Cursor.From(text), textPos);
    if Cursor.AtEnd(c) {
        return MatchStep { patPos: close + 1, textPos: textPos, ok: false };
    }
    string ch = Cursor.Slice(c, c.pos, 1);
    bool matched = ClassMatches(pattern, pos, close, ch, neg);
    if !matched {
        return MatchStep { patPos: close + 1, textPos: textPos, ok: false };
    }
    return MatchStep { patPos: close + 1, textPos: textPos + 1, ok: true };
}

bool ClassMatches(string pattern, i64 start, i64 close, string ch, bool neg) {
    mut i64 pos = start;
    mut bool found = false;
    while pos < close {
        string first = PatAt(pattern, pos);
        if pos + 2 < close && PatAt(pattern, pos + 1) == "-" {
            string last = PatAt(pattern, pos + 2);
            if CharInRange(ch, first, last) {
                found = true;
            }
            pos = pos + 3;
            continue;
        }
        if first == ch {
            found = true;
        }
        pos = pos + 1;
    }
    if neg {
        return !found;
    }
    return found;
}

bool CharInRange(string ch, string lo, string hi) {
    u8 cb = Core.String.ByteAt(ch, 0);
    u8 lb = Core.String.ByteAt(lo, 0);
    u8 hb = Core.String.ByteAt(hi, 0);
    if cb >= lb && cb <= hb {
        return true;
    }
    return false;
}

MatchStep MatchLiteral(string pattern, i64 patPos, string text, i64 textPos) {
    mut i64 end = patPos;
    while end < PatLen(pattern) {
        string ch = PatAt(pattern, end);
        if ch == "|" || ch == "(" || ch == ")" || ch == "[" || ch == "]" || ch == "*" || ch == "+" || ch == "?" || ch == "^" || ch == "$" || ch == "." || ch == "\\" {
            break;
        }
        end = end + 1;
    }
    if end == patPos {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    string lit = Cursor.Slice(Cursor.From(pattern), patPos, end - patPos);
    Cursor.TextCursor c = Cursor.Advance(Cursor.From(text), textPos);
    Parser.Result.TextParseResult<string> parsed = Parser.Literal(c, lit, "literal");
    if !Parser.IsOk(parsed) {
        return MatchStep { patPos: patPos, textPos: textPos, ok: false };
    }
    Cursor.TextCursor rest = Parser.RestOnOk(parsed, c);
    return MatchStep { patPos: end, textPos: Cursor.Position(rest), ok: true };
}

pub i64 NextPatBranch(string pattern, i64 patPos) {
    mut i64 pos = patPos;
    mut i64 depth = 0;
    while pos < PatLen(pattern) {
        string ch = PatAt(pattern, pos);
        if ch == "(" {
            depth = depth + 1;
        } else if ch == ")" {
            if depth < 1 {
                return -1;
            }
            depth = depth - 1;
        } else if ch == "|" && depth == 0 {
            return pos + 1;
        }
        pos = pos + 1;
    }
    return -1;
}

pub i64 FindClosingParen(string pattern, i64 openPos) {
    mut i64 pos = openPos + 1;
    mut i64 depth = 1;
    while pos < PatLen(pattern) {
        string ch = PatAt(pattern, pos);
        if ch == "(" {
            depth = depth + 1;
        } else if ch == ")" {
            depth = depth - 1;
            if depth == 0 {
                return pos;
            }
        }
        pos = pos + 1;
    }
    return -1;
}

pub i64 FindClosingBracket(string pattern, i64 openPos) {
    mut i64 pos = openPos + 1;
    while pos < PatLen(pattern) {
        if PatAt(pattern, pos) == "]" {
            return pos;
        }
        pos = pos + 1;
    }
    return -1;
}

pub i64 PatLen(string pattern) {
    return Core.String.Len(pattern);
}

pub string PatAt(string pattern, i64 index) {
    return Cursor.Slice(Cursor.From(pattern), index, 1);
}
