use Testing.Assert;
use Core.Collections.Array;
use Http2.Hpack;
use Http2.HpackDecoder;
use Http2.HpackEncoder;
use HpackSupport;

mod FieldsTests
{
    // RFC 7541 Appendix C.2 header field representations, each on a fresh context.
    test C21LiteralWithIndexingDecode
    {
        mut Decoder decoder = NewTestDecoder(4096_i64);
        HeaderField[] fields = DecodeOk(decoder, "400a637573746f6d2d6b65790d637573746f6d2d686561646572", "C.2.1");
        ExpectFields(fields, ["custom-key", "custom-header"], "C.2.1");
        ExpectTable(decoder, ["custom-key", "custom-header"], 55_i64, "C.2.1");
    }

    test C21LiteralWithIndexingEncode
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, false));
        ExpectBytes(HpackEncoder.Encode(encoder, Fields(["custom-key", "custom-header"])), "400a637573746f6d2d6b65790d637573746f6d2d686561646572", "C.2.1");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 55_i64, "C.2.1 encoder table");
    }

    test C22LiteralWithoutIndexingDecode
    {
        mut Decoder decoder = NewTestDecoder(4096_i64);
        HeaderField[] fields = DecodeOk(decoder, "040c2f73616d706c652f70617468", "C.2.2");
        ExpectFields(fields, [":path", "/sample/path"], "C.2.2");
        ExpectTable(decoder, Array.Empty<string>(), 0_i64, "C.2.2");
        HeaderField first = Array.Get<HeaderField>(fields, 0_i64);
        Assert.False(first.sensitive, "not sensitive");
    }

    test C22LiteralWithoutIndexingEncode
    {
        mut EncoderPolicy policy = RfcPolicy(4096_i64, false);
        policy.indexing = false;
        mut Encoder encoder = NewTestEncoder(policy);
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":path", "/sample/path"])), "040c2f73616d706c652f70617468", "C.2.2");
        Assert.Equal<i64>(HpackEncoder.EncoderTableCount(encoder), 0_i64, "C.2.2 encoder table");
    }

    test C23LiteralNeverIndexedDecode
    {
        mut Decoder decoder = NewTestDecoder(4096_i64);
        HeaderField[] fields = DecodeOk(decoder, "100870617373776f726406736563726574", "C.2.3");
        ExpectFields(fields, ["password", "secret"], "C.2.3");
        ExpectTable(decoder, Array.Empty<string>(), 0_i64, "C.2.3");
        HeaderField first = Array.Get<HeaderField>(fields, 0_i64);
        Assert.True(first.sensitive, "never-indexed is sensitive");
    }

    test C23LiteralNeverIndexedEncode
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, false));
        mut HeaderField[] fields = Array.Empty<HeaderField>();
        Array.Append<HeaderField>(fields, Hpack.SensitiveField("password", "secret"));
        ExpectBytes(HpackEncoder.Encode(encoder, fields), "100870617373776f726406736563726574", "C.2.3");
        Assert.Equal<i64>(HpackEncoder.EncoderTableCount(encoder), 0_i64, "C.2.3 encoder table");
    }

    test C24IndexedFieldDecode
    {
        mut Decoder decoder = NewTestDecoder(4096_i64);
        HeaderField[] fields = DecodeOk(decoder, "82", "C.2.4");
        ExpectFields(fields, [":method", "GET"], "C.2.4");
        ExpectTable(decoder, Array.Empty<string>(), 0_i64, "C.2.4");
    }

    test C24IndexedFieldEncode
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(4096_i64, false));
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":method", "GET"])), "82", "C.2.4");
    }
}
