/// Core.Text.Toml tests.

use Testing.Expect;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Core.Text.Toml;

// ---------------------------------------------------------------------------------------------
// TOML
// ---------------------------------------------------------------------------------------------

Toml.TomlValue Doc(string text) {
    return match Toml.Parse(text) {
        Result::Ok(v) => v,
        Result::Error(_) => Toml.TomlValue::Text("<parse error>"),
    };
}

string TextAt(Toml.TomlValue doc, string path) {
    return match Toml.GetPath(doc, path) {
        Option::Some(v) => match Toml.AsText(v) {
            Option::Some(t) => t,
            Option::None => "<not text>",
        },
        Option::None => "<missing>",
    };
}

i64 IntAt(Toml.TomlValue doc, string path) {
    return match Toml.GetPath(doc, path) {
        Option::Some(v) => match Toml.AsInteger(v) {
            Option::Some(n) => n,
            Option::None => -999_i64,
        },
        Option::None => -998_i64,
    };
}

Toml.TomlValue ValueAt(Toml.TomlValue doc, string path) {
    return match Toml.GetPath(doc, path) {
        Option::Some(v) => v,
        Option::None => Toml.TomlValue::Text("<missing>"),
    };
}

string TomlFailure(string text) {
    return match Toml.Parse(text) {
        Result::Ok(_) => "ok",
        Result::Error(error) => match error {
            Toml.TomlError::UnexpectedCharacter(_) => "unexpected",
            Toml.TomlError::UnexpectedEnd(_) => "end",
            Toml.TomlError::UnterminatedString(_) => "unterminated",
            Toml.TomlError::InvalidEscape(_) => "escape",
            Toml.TomlError::InvalidNumber(_) => "number",
            Toml.TomlError::DuplicateKey(_) => "duplicate",
            Toml.TomlError::InvalidTable(_) => "table",
        },
    };
}

string Q(string text) {
    return String.Replace(text, "'", "\"");
}

string N() {
    return String.Newline();
}

test toml_tables_keys_and_scalars {
    string source = "# project" + N() + "title = 'TOML'" + N() + "[package]" + N() + "name = 'beskid'" + N() + "version.major = 0" + N() + "version.minor = 5" + N() + "[package.links]" + N() + Q("'home page' = 'https://beskid-lang.org'") + N();
    Toml.TomlValue doc = Doc(Q(source));
    Expect.EqualString(TextAt(doc, "title"), "TOML", "top-level key");
    Expect.EqualString(TextAt(doc, "package.name"), "beskid", "table key");
    Expect.EqualI64(IntAt(doc, "package.version.minor"), 5, "dotted key");
    Toml.TomlValue links = ValueAt(doc, "package.links");
    Expect.EqualStringArray(Toml.Keys(links), ["home page"], "quoted key");
    Expect.EqualStringArray(Toml.Keys(doc), ["title", "package"], "document order");
}

test toml_numbers_and_booleans {
    Toml.TomlValue doc = Doc("a = 1_000" + N() + "b = -17" + N() + "c = 0xff" + N() + "d = 0o17" + N() + "e = 0b101" + N() + "f = 3.25" + N() + "g = 1e3" + N() + "h = true" + N() + "i = 9223372036854775807" + N());
    Expect.EqualI64(IntAt(doc, "a"), 1000, "underscores");
    Expect.EqualI64(IntAt(doc, "b"), -17, "negative");
    Expect.EqualI64(IntAt(doc, "c"), 255, "hex");
    Expect.EqualI64(IntAt(doc, "d"), 15, "octal");
    Expect.EqualI64(IntAt(doc, "e"), 5, "binary");
    Expect.EqualI64(IntAt(doc, "i"), 9223372036854775807_i64, "full i64 precision");
    f64 f = match Toml.AsFloat(ValueAt(doc, "f")) {
        Option::Some(v) => v,
        Option::None => 0.0,
    };
    Expect.NearF64(f, 3.25, 0.0, "float");
    bool h = match Toml.AsBool(ValueAt(doc, "h")) {
        Option::Some(v) => v,
        Option::None => false,
    };
    Expect.EqualBool(h, true, "boolean");
    Expect.EqualString(TomlFailure("x = 1__0"), "number", "double underscore");
    Expect.EqualString(TomlFailure("x = 012"), "number", "leading zero");
    Expect.EqualString(TomlFailure("x = 1."), "number", "fraction needs digits");
}
