/// Constant-time Montgomery arithmetic modulo an odd modulus over fixed-width `u32[]` limbs.
///
/// All modular arithmetic runs on a workspace: one `u32[]` that holds the modulus, the
/// Montgomery constants, scratch, and numbered caller slots of `n` limbs each. The W
/// functions take the workspace and limb offsets. Under the 0.5.2 JIT every array argument
/// of a call costs roughly 40 ns and struct types with array fields are slow to compile,
/// so this shape keeps both small (see protocols/COMPILER-GAPS.md).
///
/// Multiplication is CIOS (Koc, Acar, Kaliski 1996) with a branch-free final subtraction;
/// add, subtract, select and swap are branch-free too, so the running time depends only on
/// `n`, never on operand values. Slot values are below the modulus; outputs may alias
/// inputs. A workspace must not be used by two threads at once.
///
/// Layout for modulus width n (offsets in limbs):
///   [0, n)          modulus m
///   n               -m^-1 mod 2^32
///   [n+1, 2n+3)     CIOS accumulator (n + 2 limbs)
///   [2n+3, 3n+3)    add/sub scratch
///   [3n+3, 4n+3)    R^2 mod m, R = 2^(32n)
///   [4n+3, 5n+3)    the integer 1
///   5n+3 + i*n      caller slot i
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Crypto.BigNat;
use Crypto.PkErrors;

pub u32 Xor(u32 a, u32 b) { return (a | b) - (a & b); }

/// All-ones when `bit` is 1, zero when `bit` is 0.
pub u32 MaskOf(u32 bit) { return 0_u32 - bit; }

pub i64 WRr(i64 n) { return 3_i64 * n + 3_i64; }
pub i64 WOne(i64 n) { return 4_i64 * n + 3_i64; }
pub i64 WSlot(i64 n, i64 index) { return 5_i64 * n + 3_i64 + index * n; }

/// A workspace for an odd modulus `m > 1` of at most `BigNat.MaxLimbs()` significant limbs,
/// with `slots` zeroed caller slots. Its width n is the significant limb count of `m`.
pub Result<u32[], PkError> NewWorkspace(u32[] modulus, i64 slots) {
    u32[] m = BigNat.Normalize(modulus);
    i64 n = BigNat.SignificantLimbs(m);
    if n > BigNat.MaxLimbs() || !BigNat.IsOdd(m) { return Result::Error(PkError::InvalidModulus()); }
    if n == 1_i64 && m[0] == 1_u32 { return Result::Error(PkError::InvalidModulus()); }
    u32[] w = BigNat.Zeros(WSlot(n, slots));
    mut i64 j = 0_i64;
    while j < n {
        w[j] = m[j];
        j = j + 1_i64;
    }
    // -m^-1 mod 2^32 by Newton iteration: each step doubles the correct low bits.
    u32 m0 = m[0];
    mut u32 inv = m0;
    mut i64 k = 0_i64;
    while k < 5_i64 {
        inv = inv * (2_u32 - m0 * inv);
        k = k + 1_i64;
    }
    w[n] = 0_u32 - inv;
    w[WOne(n)] = 1_u32;
    // R^2 mod m (public modulus: variable time is fine). Write 32n = odd * 2^s. Start from
    // 2^(bits-1) < m and double up to R * 2^odd mod m; each Montgomery squaring then maps
    // R * 2^t to R * 2^2t, so s squarings reach R * 2^(32n) = R^2.
    mut i64 odd = 32_i64 * n;
    mut i64 squarings = 0_i64;
    while (odd & 1_i64) == 0_i64 {
        odd = odd / 2_i64;
        squarings = squarings + 1_i64;
    }
    u32[] x = BigNat.Zeros(n + 1_i64);
    i64 top = BigNat.BitLength(m) - 1_i64;
    x[top / 32_i64] = 1_u32 << u32(top % 32_i64);
    mut i64 d = top;
    while d < 32_i64 * n + odd {
        BigNat.ShiftLeft1(x, 0_u32);
        if BigNat.Compare(x, m) >= 0_i64 { BigNat.SubInPlace(x, m); }
        d = d + 1_i64;
    }
    i64 rr = WRr(n);
    j = 0_i64;
    while j < n {
        w[rr + j] = x[j];
        j = j + 1_i64;
    }
    k = 0_i64;
    while k < squarings {
        WMul(w, n, rr, rr, rr);
        k = k + 1_i64;
    }
    return Result::Ok(w);
}

/// Copies `src` (n limbs) into slot offset `dst`.
pub unit WLoad(u32[] w, i64 n, i64 dst, u32[] src) {
    mut i64 j = 0_i64;
    while j < n {
        w[dst + j] = src[j];
        j = j + 1_i64;
    }
    return;
}

/// Copies slot offset `src` into a fresh n-limb array.
pub u32[] WStore(u32[] w, i64 n, i64 src) {
    u32[] out = BigNat.Zeros(n);
    mut i64 j = 0_i64;
    while j < n {
        out[j] = w[src + j];
        j = j + 1_i64;
    }
    return out;
}

pub unit WCopy(u32[] w, i64 n, i64 dst, i64 src) {
    mut i64 j = 0_i64;
    while j < n {
        w[dst + j] = w[src + j];
        j = j + 1_i64;
    }
    return;
}

/// Sets slot `dst` to the small value `v` (plain, not Montgomery form).
pub unit WSetSmall(u32[] w, i64 n, i64 dst, u32 v) {
    mut i64 j = 0_i64;
    while j < n {
        w[dst + j] = 0_u32;
        j = j + 1_i64;
    }
    w[dst] = v;
    return;
}

/// `w[out] = w[a] * w[b] * R^-1 mod m` (CIOS, branch-free final subtraction).
pub unit WMul(u32[] w, i64 n, i64 out, i64 a, i64 b) {
    i64 t = n + 1_i64;
    i64 m0inv = i64(w[n]);
    i64 mask = 4294967295_i64;
    mut i64 j = 0_i64;
    while j < n + 2_i64 {
        w[t + j] = 0_u32;
        j = j + 1_i64;
    }
    mut i64 i = 0_i64;
    while i < n {
        i64 bi = i64(w[b + i]);
        mut i64 carry = 0_i64;
        j = 0_i64;
        while j < n {
            i64 s = i64(w[t + j]) + i64(w[a + j]) * bi + carry;
            w[t + j] = u32(s & mask);
            carry = s >> 32_i64;
            j = j + 1_i64;
        }
        i64 top = i64(w[t + n]) + carry;
        w[t + n] = u32(top & mask);
        w[t + n + 1_i64] = u32(top >> 32_i64);
        i64 t0 = i64(w[t]);
        i64 q = (t0 * m0inv) & mask;
        carry = (t0 + q * i64(w[0])) >> 32_i64;
        j = 1_i64;
        while j < n {
            i64 s = i64(w[t + j]) + q * i64(w[j]) + carry;
            w[t + j - 1_i64] = u32(s & mask);
            carry = s >> 32_i64;
            j = j + 1_i64;
        }
        i64 last = i64(w[t + n]) + carry;
        w[t + n - 1_i64] = u32(last & mask);
        w[t + n] = u32((i64(w[t + n + 1_i64]) + (last >> 32_i64)) & mask);
        i = i + 1_i64;
    }
    mut i64 borrow = 0_i64;
    j = 0_i64;
    while j < n {
        i64 d = i64(w[t + j]) - i64(w[j]) - borrow;
        w[out + j] = u32(d & mask);
        borrow = (d >> 63_i64) & 1_i64;
        j = j + 1_i64;
    }
    u32 keepT = MaskOf(u32(((i64(w[t + n]) - borrow) >> 63_i64) & 1_i64));
    u32 keepD = 4294967295_u32 - keepT;
    j = 0_i64;
    while j < n {
        w[out + j] = (w[t + j] & keepT) | (w[out + j] & keepD);
        j = j + 1_i64;
    }
    return;
}

/// `w[out] = w[a] + w[b] mod m`.
pub unit WAdd(u32[] w, i64 n, i64 out, i64 a, i64 b) {
    i64 s = 2_i64 * n + 3_i64;
    i64 mask = 4294967295_i64;
    mut i64 carry = 0_i64;
    mut i64 j = 0_i64;
    while j < n {
        i64 v = i64(w[a + j]) + i64(w[b + j]) + carry;
        w[s + j] = u32(v & mask);
        carry = v >> 32_i64;
        j = j + 1_i64;
    }
    mut i64 borrow = 0_i64;
    j = 0_i64;
    while j < n {
        i64 d = i64(w[s + j]) - i64(w[j]) - borrow;
        w[out + j] = u32(d & mask);
        borrow = (d >> 63_i64) & 1_i64;
        j = j + 1_i64;
    }
    u32 keepS = MaskOf(u32(((carry - borrow) >> 63_i64) & 1_i64));
    u32 keepD = 4294967295_u32 - keepS;
    j = 0_i64;
    while j < n {
        w[out + j] = (w[s + j] & keepS) | (w[out + j] & keepD);
        j = j + 1_i64;
    }
    return;
}

/// `w[out] = w[a] - w[b] mod m`.
pub unit WSub(u32[] w, i64 n, i64 out, i64 a, i64 b) {
    i64 mask = 4294967295_i64;
    mut i64 borrow = 0_i64;
    mut i64 j = 0_i64;
    while j < n {
        i64 d = i64(w[a + j]) - i64(w[b + j]) - borrow;
        w[out + j] = u32(d & mask);
        borrow = (d >> 63_i64) & 1_i64;
        j = j + 1_i64;
    }
    u32 addM = MaskOf(u32(borrow));
    mut i64 carry = 0_i64;
    j = 0_i64;
    while j < n {
        i64 v = i64(w[out + j]) + i64(w[j] & addM) + carry;
        w[out + j] = u32(v & mask);
        carry = v >> 32_i64;
        j = j + 1_i64;
    }
    return;
}

pub unit WToMont(u32[] w, i64 n, i64 out, i64 a) { WMul(w, n, out, a, WRr(n)); return; }
pub unit WFromMont(u32[] w, i64 n, i64 out, i64 a) { WMul(w, n, out, a, WOne(n)); return; }

/// `w[dst, dst+count) = w[src, src+count)` when `bit` is 1. Branch-free.
pub unit WCondAssign(u32[] w, i64 count, i64 dst, i64 src, u32 bit) {
    u32 mask = MaskOf(bit);
    u32 keep = 4294967295_u32 - mask;
    mut i64 j = 0_i64;
    while j < count {
        w[dst + j] = (w[src + j] & mask) | (w[dst + j] & keep);
        j = j + 1_i64;
    }
    return;
}

/// Swaps `w[a, a+count)` and `w[b, b+count)` when `bit` is 1. Branch-free.
pub unit WCondSwap(u32[] w, i64 count, i64 a, i64 b, u32 bit) {
    u32 mask = MaskOf(bit);
    mut i64 j = 0_i64;
    while j < count {
        u32 x = Xor(w[a + j], w[b + j]) & mask;
        w[a + j] = Xor(w[a + j], x);
        w[b + j] = Xor(w[b + j], x);
        j = j + 1_i64;
    }
    return;
}

/// `w[dst, dst+stride) = entry `index` of the table of `entries` records of `stride` limbs
/// starting at `table`. Every entry is read with a mask, so the access pattern does not
/// depend on `index`.
pub unit WSelect(u32[] w, i64 stride, i64 dst, i64 table, i64 entries, u32 index) {
    mut i64 e = 0_i64;
    while e < entries {
        u32 diff = Xor(u32(e), index);
        u32 mask = MaskOf(1_u32 - ((diff | (0_u32 - diff)) >> 31_u32));
        u32 keep = 4294967295_u32 - mask;
        i64 base = table + e * stride;
        mut i64 j = 0_i64;
        while j < stride {
            w[dst + j] = (w[base + j] & mask) | (w[dst + j] & keep);
            j = j + 1_i64;
        }
        e = e + 1_i64;
    }
    return;
}

/// 1 when `w[a, a+count)` is all zero, else 0. Branch-free.
pub u32 WIsZeroBit(u32[] w, i64 count, i64 a) {
    mut u32 acc = 0_u32;
    mut i64 j = 0_i64;
    while j < count {
        acc = acc | w[a + j];
        j = j + 1_i64;
    }
    return 1_u32 - ((acc | (0_u32 - acc)) >> 31_u32);
}

/// 1 when slots `a` and `b` are equal, else 0. Branch-free.
pub u32 WEqualBit(u32[] w, i64 n, i64 a, i64 b) {
    mut u32 acc = 0_u32;
    mut i64 j = 0_i64;
    while j < n {
        acc = acc | Xor(w[a + j], w[b + j]);
        j = j + 1_i64;
    }
    return 1_u32 - ((acc | (0_u32 - acc)) >> 31_u32);
}

/// `w[out] = w[base]^exp` in Montgomery form for a big-endian public exponent; `acc` is a
/// scratch slot distinct from `base`. The time depends on `exp`, never on `w[base]`.
pub unit WPowPublic(u32[] w, i64 n, i64 out, i64 base, i64 acc, u8[] exp) {
    WToMont(w, n, acc, WOne(n));
    i64 len = Slice.Len(exp);
    mut i64 i = 0_i64;
    while i < len {
        u8 byte = exp[i];
        mut i64 bit = 7_i64;
        while bit >= 0_i64 {
            WMul(w, n, acc, acc, acc);
            if ((byte >> u8(bit)) & u8(1)) == u8(1) { WMul(w, n, acc, acc, base); }
            bit = bit - 1_i64;
        }
        i = i + 1_i64;
    }
    WCopy(w, n, out, acc);
    return;
}

/// `dst = src` when `bit` is 1, unchanged when 0. Branch-free.
pub unit CondAssign(u32[] dst, u32[] src, u32 bit) {
    u32 mask = MaskOf(bit);
    i64 n = Array.Len<u32>(dst);
    mut i64 j = 0_i64;
    while j < n {
        dst[j] = (src[j] & mask) | (dst[j] & (4294967295_u32 - mask));
        j = j + 1_i64;
    }
    return;
}

/// Swaps `a` and `b` when `bit` is 1. Branch-free.
pub unit CondSwap(u32[] a, u32[] b, u32 bit) {
    u32 mask = MaskOf(bit);
    i64 n = Array.Len<u32>(a);
    mut i64 j = 0_i64;
    while j < n {
        u32 x = Xor(a[j], b[j]) & mask;
        a[j] = Xor(a[j], x);
        b[j] = Xor(b[j], x);
        j = j + 1_i64;
    }
    return;
}

/// 1 when every limb is zero, else 0. Branch-free over the fixed width.
pub u32 IsZeroBit(u32[] a) {
    mut u32 acc = 0_u32;
    i64 n = Array.Len<u32>(a);
    mut i64 j = 0_i64;
    while j < n {
        acc = acc | a[j];
        j = j + 1_i64;
    }
    // acc == 0 exactly when (acc | -acc) has a clear top bit.
    return 1_u32 - ((acc | (0_u32 - acc)) >> 31_u32);
}

/// 1 when `a == b` limb for limb, else 0. Branch-free over the fixed width.
pub u32 EqualBit(u32[] a, u32[] b) {
    mut u32 acc = 0_u32;
    i64 n = Array.Len<u32>(a);
    mut i64 j = 0_i64;
    while j < n {
        acc = acc | Xor(a[j], b[j]);
        j = j + 1_i64;
    }
    return 1_u32 - ((acc | (0_u32 - acc)) >> 31_u32);
}

/// 1 when `a < b` (same width), else 0. Branch-free.
pub u32 LessBit(u32[] a, u32[] b) {
    i64 n = Array.Len<u32>(a);
    mut i64 borrow = 0_i64;
    mut i64 j = 0_i64;
    while j < n {
        i64 d = i64(a[j]) - i64(b[j]) - borrow;
        borrow = (d >> 63_i64) & 1_i64;
        j = j + 1_i64;
    }
    return u32(borrow);
}

