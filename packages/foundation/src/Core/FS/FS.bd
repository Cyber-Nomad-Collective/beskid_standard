/// File system helper API backed by compiler-minted Corelib services.
/// Types are split under `Core/FS/` with one type per file.
/// @tier(supported)
/// @ref(Core.Results.Result) envelopes for read/write helpers.

use Core.FS.FsError;
use Core.Results;

Core.Results.Result<unit, FsError> MutationResult(i32 status, string path) {
    return match status {
        0 => Result::Ok(()),
        1 => Result::Error(FsError::NotFound(path)),
        2 => Result::Error(FsError::PermissionDenied(path)),
        3 => Result::Error(FsError::IOError(path)),
        4 => Result::Error(FsError::InvalidPath(path)),
        5 => Result::Error(FsError::AlreadyExists(path)),
        _ => Result::Error(FsError::IOError(path)),
    };
}

pub Core.Results.Result<string, FsError> ReadAllText(string path) {
    mut string text = "";
    i32 status = __fs_read_text(path, text);
    return match status {
        0 => Result::Ok(text),
        1 => Result::Error(FsError::NotFound(path)),
        2 => Result::Error(FsError::PermissionDenied(path)),
        3 => Result::Error(FsError::IOError(path)),
        4 => Result::Error(FsError::InvalidPath(path)),
        5 => Result::Error(FsError::AlreadyExists(path)),
        _ => Result::Error(FsError::IOError(path)),
    };
}

pub Core.Results.Result<unit, FsError> WriteAllText(string path, string text) {
    return MutationResult(__fs_write_text(path, text), path);
}

pub Core.Results.Result<unit, FsError> Delete(string path) {
    return MutationResult(__fs_delete(path), path);
}

pub Core.Results.Result<unit, FsError> CreateDirectory(string path) {
    return MutationResult(__fs_mkdir(path), path);
}

pub Core.Results.Result<bool, FsError> Exists(string path) {
    i32 status = __fs_exists(path);
    return match status {
        0 => Result::Ok(true),
        1 => Result::Ok(false),
        2 => Result::Error(FsError::PermissionDenied(path)),
        3 => Result::Error(FsError::IOError(path)),
        4 => Result::Error(FsError::InvalidPath(path)),
        5 => Result::Error(FsError::AlreadyExists(path)),
        _ => Result::Error(FsError::IOError(path)),
    };
}

pub Core.Results.Result<unit, FsError> Copy(string source, string destination) {
    Core.Results.Result<string, FsError> read = ReadAllText(source);
    return match read {
        Result::Ok(text) => WriteAllText(destination, text),
        Result::Error(err) => Result::Error(err),
    };
}
