/// Query.Operators — transformation and consumption combinators for iterators.
/// @tier(supported)
/// Operators take an `ArrayIterator<T>` positioned at its current element and work on the
/// remaining elements. The 0.5.2 compiler cannot lower lambdas, so selection uses masks
/// (`Where`) or value comparison (`WhereEquals`, `Distinct`) rather than predicate callbacks;
/// equality is `==` (value equality for primitives and strings).

use Core.Collections.Array;
use Core.Collections.Sort;
use Core.Optional.Option;
use Query.ArrayIterator;

/// Returns the first `count` elements as a new array.
pub T[] Take<T>(mut ArrayIterator<T> it, i64 count) {
    if count < 1 {
        return Array.Empty<T>();
    }
    i64 remaining = ArrayIterator.Remaining<T>(it);
    mut i64 take = count;
    if take > remaining {
        take = remaining;
    }
    mut T[] result = Array.Empty<T>();
    mut i64 outIndex = 0;
    while outIndex < take {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                result = Array.Append<T>(result, value);
                outIndex = outIndex + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { },
        };
    }
    return result;
}

/// Skips the first `count` elements, returns the rest as a new array.
pub T[] Skip<T>(mut ArrayIterator<T> it, i64 count) {
    mut i64 skipped = 0;
    while skipped < count {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(_) => {
                skipped = skipped + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { skipped = count; },
        };
    }
    i64 remaining = ArrayIterator.Remaining<T>(it);
    return Take<T>(it, remaining);
}

/// Counts remaining elements in the iterator.
pub i64 Count<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Remaining<T>(it);
}

/// Returns the first element or `None`.
pub Option<T> First<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Current<T>(it);
}

/// Returns the last element or `None`.
pub Option<T> Last<T>(mut ArrayIterator<T> it) {
    mut Option<T> last = Option::None();
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                last = Option::Some(value);
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return last;
}

/// Collects all remaining elements into a new array.
pub T[] ToArray<T>(mut ArrayIterator<T> it) {
    i64 remaining = ArrayIterator.Remaining<T>(it);
    if remaining < 1 {
        return Array.Empty<T>();
    }
    mut T[] result = Array.Empty<T>();
    mut i64 outIndex = 0;
    while outIndex < remaining {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                result = Array.Append<T>(result, value);
                outIndex = outIndex + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { },
        };
    }
    return result;
}

/// Returns true when any remaining element equals `value`.
pub bool Any<T>(mut ArrayIterator<T> it, T value) {
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(elem) => {
                if elem == value {
                    return true;
                }
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return false;
}

/// Returns true when all remaining elements equal `value` (empty = true).
pub bool All<T>(mut ArrayIterator<T> it, T value) {
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(elem) => {
                if elem != value {
                    return false;
                }
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return true;
}

/// Returns true when the iterator has no remaining elements.
pub bool IteratorIsEmpty<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Remaining<T>(it) == 0;
}

/// Sorts the remaining `i64` elements, ascending or descending, with the stable merge sort in
/// `Core.Collections.Sort`. Descending order lists equal values in reverse input order.
pub i64[] OrderBy(mut ArrayIterator<i64> it, bool ascending) {
    i64[] sorted = Sort.I64(ToArray<i64>(it));
    if ascending {
        return sorted;
    }
    return Sort.Reverse<i64>(sorted);
}

/// Keeps the remaining elements whose position in `keep` is `true`. `keep[0]` belongs to the
/// current element; positions beyond `keep` are dropped. This is the lambda-free form of a
/// filter: compute the mask in a loop, then apply it.
pub T[] Where<T>(mut ArrayIterator<T> it, bool[] keep) {
    T[] items = ToArray<T>(it);
    mut T[] result = Array.Empty<T>();
    mut i64 i = 0;
    while i < Array.Len<T>(items) && i < Array.Len<bool>(keep) {
        if Array.Get<bool>(keep, i) {
            result = Array.Append<T>(result, Array.Get<T>(items, i));
        }
        i = i + 1;
    }
    return result;
}

/// Keeps the remaining elements equal (`==`) to `value`.
pub T[] WhereEquals<T>(mut ArrayIterator<T> it, T value) {
    T[] items = ToArray<T>(it);
    mut T[] result = Array.Empty<T>();
    mut i64 i = 0;
    while i < Array.Len<T>(items) {
        if Array.Get<T>(items, i) == value {
            result = Array.Append<T>(result, Array.Get<T>(items, i));
        }
        i = i + 1;
    }
    return result;
}

/// Drops the remaining elements equal (`==`) to `value`.
pub T[] WhereNotEquals<T>(mut ArrayIterator<T> it, T value) {
    T[] items = ToArray<T>(it);
    mut T[] result = Array.Empty<T>();
    mut i64 i = 0;
    while i < Array.Len<T>(items) {
        if Array.Get<T>(items, i) != value {
            result = Array.Append<T>(result, Array.Get<T>(items, i));
        }
        i = i + 1;
    }
    return result;
}

bool ContainsIn<T>(T[] items, i64 count, T value) {
    mut i64 i = 0;
    while i < count {
        if Array.Get<T>(items, i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The remaining elements with duplicates removed, keeping first occurrences in order.
pub T[] Distinct<T>(mut ArrayIterator<T> it) {
    T[] items = ToArray<T>(it);
    mut T[] result = Array.Empty<T>();
    mut i64 kept = 0;
    mut i64 i = 0;
    while i < Array.Len<T>(items) {
        if !ContainsIn<T>(result, kept, Array.Get<T>(items, i)) {
            result = Array.Append<T>(result, Array.Get<T>(items, i));
            kept = kept + 1;
        }
        i = i + 1;
    }
    return result;
}

/// Number of remaining elements equal to `value`.
pub i64 CountOf<T>(mut ArrayIterator<T> it, T value) {
    T[] items = ToArray<T>(it);
    mut i64 n = 0;
    mut i64 i = 0;
    while i < Array.Len<T>(items) {
        if Array.Get<T>(items, i) == value {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// Offset (from the current element) of the first element equal to `value`, or `-1`.
pub i64 IndexOf<T>(mut ArrayIterator<T> it, T value) {
    T[] items = ToArray<T>(it);
    mut i64 i = 0;
    while i < Array.Len<T>(items) {
        if Array.Get<T>(items, i) == value {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// The remaining elements followed by every element of `tail`.
pub T[] Concat<T>(mut ArrayIterator<T> it, T[] tail) {
    mut T[] result = ToArray<T>(it);
    mut i64 i = 0;
    while i < Array.Len<T>(tail) {
        result = Array.Append<T>(result, Array.Get<T>(tail, i));
        i = i + 1;
    }
    return result;
}

/// The remaining elements in reverse order.
pub T[] Reverse<T>(mut ArrayIterator<T> it) {
    return Sort.Reverse<T>(ToArray<T>(it));
}

/// Sum of the remaining elements (wrapping on overflow); `0` when empty.
pub i64 SumI64(mut ArrayIterator<i64> it) {
    i64[] items = ToArray<i64>(it);
    mut i64 total = 0;
    mut i64 i = 0;
    while i < Array.Len<i64>(items) {
        total = total + Array.Get<i64>(items, i);
        i = i + 1;
    }
    return total;
}

/// Sum of the remaining elements; `0.0` when empty.
pub f64 SumF64(mut ArrayIterator<f64> it) {
    f64[] items = ToArray<f64>(it);
    mut f64 total = 0.0;
    mut i64 i = 0;
    while i < Array.Len<f64>(items) {
        total = total + Array.Get<f64>(items, i);
        i = i + 1;
    }
    return total;
}

/// Smallest remaining element, or `None` when empty.
pub Option<i64> MinI64(mut ArrayIterator<i64> it) {
    i64[] items = ToArray<i64>(it);
    if Array.Len<i64>(items) == 0 {
        return Option::None;
    }
    mut i64 best = Array.Get<i64>(items, 0);
    mut i64 i = 1;
    while i < Array.Len<i64>(items) {
        if Array.Get<i64>(items, i) < best {
            best = Array.Get<i64>(items, i);
        }
        i = i + 1;
    }
    return Option::Some(best);
}

/// Largest remaining element, or `None` when empty.
pub Option<i64> MaxI64(mut ArrayIterator<i64> it) {
    i64[] items = ToArray<i64>(it);
    if Array.Len<i64>(items) == 0 {
        return Option::None;
    }
    mut i64 best = Array.Get<i64>(items, 0);
    mut i64 i = 1;
    while i < Array.Len<i64>(items) {
        if Array.Get<i64>(items, i) > best {
            best = Array.Get<i64>(items, i);
        }
        i = i + 1;
    }
    return Option::Some(best);
}

/// Arithmetic mean of the remaining elements, or `None` when empty.
pub Option<f64> AverageF64(mut ArrayIterator<f64> it) {
    f64[] items = ToArray<f64>(it);
    i64 count = Array.Len<f64>(items);
    if count == 0 {
        return Option::None;
    }
    mut f64 total = 0.0;
    mut i64 i = 0;
    while i < count {
        total = total + Array.Get<f64>(items, i);
        i = i + 1;
    }
    return Option::Some(total / f64(count));
}
