use Core.Optional.Option;
use Core.Results;
use Core.Serialization.Metadata;

/// Format-independent shape kinds. Width and fields are separate typed facts.
pub enum ShapeKind
{
    Unit,

    Boolean,

    Signed,

    Unsigned,

    Float,

    Scalar,

    String,

    Bytes,

    Array,

    List,

    Record,

    Map,

    Variant,

    Optional,
}

pub type FieldDescriptor
{
    pub string name,

    pub Metadata.ShapeId shape,

    pub bool required,

    pub bool optional,

    pub string defaultSignature,
}

pub type VariantDescriptor
{
    pub string name,

    pub u32 ordinal,

    pub FieldDescriptor[] fields,
}

/// Canonical signatures are compiler-generated length-delimited UTF8 strings.
/// Runtime registration verifies the hash and exact descriptors independently.
pub type ShapeDescriptor
{
    pub Metadata.ShapeId id,

    pub string signature,

    pub string packageIdentity,

    pub string sourcePath,

    pub string declarationPath,

    pub string schemaVersion,

    pub ShapeKind kind,

    pub u8 width,

    pub Metadata.ShapeId[] arguments,

    pub FieldDescriptor[] fields,

    pub VariantDescriptor[] variants,

    pub Option<ExtrasBinding> extras,
}


/// Sealed compiler-issued managed metadata. Empty ordinary construction is
/// forbidden by the exact canonical source/ownership authority.
pub type ExtrasBinding {
    Metadata.ShapeId target,
    string member,
    Metadata.ShapeId map,
    Metadata.ShapeId value,
    string bindingSignature,
}

Metadata.ShapeId CompiledId(string text) {
    match Metadata.ParseShapeId(text) {
        Result::Ok(identity) => { return identity; },
        Result::Error(_) => { __panic_str("Invalid compiler-issued extras identity"); },
    };
}

// This private constructor is the sole literal site admitted for ExtrasBinding.
// The backend calls it only after revalidating a retained exact target/field/map.
ShapeDescriptor[] AttachCompiledExtras(ShapeDescriptor[] graph, string member, string map, string value, string signature) {
    mut ShapeDescriptor root = graph[0_i64];
    root.extras = Option.FromValue<ExtrasBinding>(ExtrasBinding {
        target: root.id, member: member, map: CompiledId(map), value: CompiledId(value), bindingSignature: signature,
    });
    return graph;
}

ShapeDescriptor CompiledRoot(ShapeDescriptor[] graph) { return graph[0_i64]; }

/// Read-only facts of an already-issued binding; these cannot construct one.
pub string ExtrasMember(ExtrasBinding binding) { return binding.member; }
pub Metadata.ShapeId ExtrasTarget(ExtrasBinding binding) { return binding.target; }
pub Metadata.ShapeId ExtrasMap(ExtrasBinding binding) { return binding.map; }
pub Metadata.ShapeId ExtrasValue(ExtrasBinding binding) { return binding.value; }

pub bool SameExtras(Option<ExtrasBinding> left, Option<ExtrasBinding> right) {
    match left {
        Option::None => { return match right { Option::None => true, Option::Some(_) => false, }; },
        Option::Some(a) => { return match right { Option::None => false, Option::Some(b) => Metadata.FormatShapeId(a.target) == Metadata.FormatShapeId(b.target) && a.member == b.member && Metadata.FormatShapeId(a.map) == Metadata.FormatShapeId(b.map) && Metadata.FormatShapeId(a.value) == Metadata.FormatShapeId(b.value) && a.bindingSignature == b.bindingSignature, }; },
    };
}

[Extern(Abi:"C", Library:"beskid_runtime")]
contract CompiledShapeBridge<T> {
    ShapeDescriptor beskid_serialization_compiled_shape();
    ShapeDescriptor[] beskid_serialization_compiled_descriptors();
}

/// This managed getter is emitted only with an exact retained generated target
/// and current immutable metadata-policy proof. It has no runtime symbol fallback.
pub ShapeDescriptor CompiledShape<T>() {
    return CompiledShapeBridge<T>.beskid_serialization_compiled_shape();
}

/// The full issued closure is required when registering nested shapes.
pub ShapeDescriptor[] CompiledDescriptors<T>() {
    return CompiledShapeBridge<T>.beskid_serialization_compiled_descriptors();
}
