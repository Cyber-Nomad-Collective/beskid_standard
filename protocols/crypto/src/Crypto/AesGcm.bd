use Core.Bytes.Slice;
use Core.Results;
use Crypto.Aes;
use Crypto.ConstantTime;
use Crypto.Errors;
use Crypto.Scratch;

/// AES-GCM AEAD (NIST SP 800-38D) with a 96-bit IV and a 16-byte tag.
/// AES is constant-time vpaes (`Crypto.Aes`); GHASH is BearSSL's constant-time
/// ghash_ctmul64 (integer multiplies with 4-bit holes, no tables), both as CLIF kernels
/// generated by tools/clifgen.py.
pub type AesGcmKey {
    AesKey aes,
    i64[] hash,
}

pub i64 TagLength() { return 16_i64; }
pub i64 NonceLength() { return 12_i64; }

i64 Be64(u8[] data, i64 offset) {
    mut i64 v = 0_i64;
    mut i64 i = 0_i64;
    while i < 8_i64 { v = (v << 8_i64) | i64(data[offset + i]); i = i + 1_i64; }
    return v;
}

unit PutBe64(u8[] out, i64 offset, i64 value) {
    mut i64 i = 0_i64;
    while i < 8_i64 { out[offset + i] = u8((value >> ((7_i64 - i) * 8_i64)) & 0xFF_i64); i = i + 1_i64; }
    return;
}

/// Expands the AES key (16, 24, or 32 bytes) and derives the GHASH key H = E(K, 0^128).
pub Result<AesGcmKey, CryptoError> New(u8[] key) {
    return match Aes.NewKey(key) {
        Result::Error(error) => Result::Error(error),
        Result::Ok(aes) => {
            u8[] h = Scratch.Bytes(16_i64);
            Aes.EncryptBlock(aes, h, 0_i64, h, 0_i64);
            i64[] g = [0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64];
            g[2] = Be64(h, 0_i64);
            g[3] = Be64(h, 8_i64);
            GhashPrepare(g);
            return Result::Ok(AesGcmKey { aes: aes, hash: g });
        },
    };
}

/// A fresh GHASH state (Y = 0) for `key`.
i64[] Start(AesGcmKey key) {
    i64[] t = key.hash;
    i64[] g = [0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64];
    mut i64 i = 2_i64;
    while i < 8_i64 { g[i] = t[i]; i = i + 1_i64; }
    return g;
}

/// Absorbs `count` bytes zero-padded to whole blocks into the GHASH state `g`.
unit Absorb(i64[] g, u8[] data, i64 offset, i64 count) {
    i64 whole = (count / 16_i64) * 16_i64;
    if whole > 0_i64 {
        g[8] = offset;
        g[9] = offset + whole;
        GhashBlocks(g, data);
    }
    i64 rest = count - whole;
    if rest > 0_i64 {
        u8[] last = Scratch.Bytes(16_i64);
        mut i64 i = 0_i64;
        while i < rest { last[i] = data[offset + whole + i]; i = i + 1_i64; }
        g[8] = 0_i64;
        g[9] = 16_i64;
        GhashBlocks(g, last);
    }
    return;
}

/// The tag E(K, J0) xor GHASH(aad || pad || ciphertext || pad || lengths).
u8[] ComputeTag(AesGcmKey key, u8[] j0, u8[] aad, u8[] ciphertext, i64 offset, i64 count) {
    i64[] g = Start(key);
    Absorb(g, aad, 0_i64, Slice.Len(aad));
    Absorb(g, ciphertext, offset, count);
    u8[] lengths = Scratch.Bytes(16_i64);
    PutBe64(lengths, 0_i64, Slice.Len(aad) * 8_i64);
    PutBe64(lengths, 8_i64, count * 8_i64);
    Absorb(g, lengths, 0_i64, 16_i64);
    u8[] y = Scratch.Bytes(16_i64);
    PutBe64(y, 0_i64, g[0]);
    PutBe64(y, 8_i64, g[1]);
    u8[] mask = Scratch.Bytes(16_i64);
    Aes.EncryptBlock(key.aes, j0, 0_i64, mask, 0_i64);
    mut i64 i = 0_i64;
    while i < 16_i64 { u8 a = y[i]; u8 b = mask[i]; y[i] = (a | b) - (a & b); i = i + 1_i64; }
    return y;
}

/// GCTR from counter block inc32(J0): XORs `count` bytes of `input` into `output`.
unit Ctr(AesGcmKey key, u8[] j0, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    Aes.CtrXorInto(key.aes, j0, 2_i64, input, inputOffset, count, output, outputOffset);
    return;
}

u8[] InitialCounter(u8[] nonce) {
    u8[] j0 = Scratch.Bytes(16_i64);
    Slice.Copy(j0, 0_i64, nonce, 0_i64, 12_i64);
    j0[15] = 1_u8;
    return j0;
}

