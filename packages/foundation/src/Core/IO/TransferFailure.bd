/// Portable reason for a failed transfer. A cause never carries a native error code.
/// Transports map each failure to exactly one cause and use Unspecified for any other failure.
/// @tier(standard)
pub enum TransferFailure {
    Unspecified(),
    Busy(),
    Closed(),
    Cancelled(),
    TimedOut(),
    PeerReset(),
    PeerAborted(),
}
