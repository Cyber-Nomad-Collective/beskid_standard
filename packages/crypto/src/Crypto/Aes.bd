use Core.Bytes.Slice;
use Core.Results;
use Crypto.Errors;
use Crypto.Scratch;

/// AES-128/192/256 block encryption (FIPS 197) as vector-permute AES ("vpaes": Hamburg,
/// CHES 2009, as in OpenSSL vpaes-x86_64): S-box inversion through 4-bit `swizzle`
/// (pshufb) lookups in registers, so no memory access depends on key or data and the
/// running time is constant. The round keys are kept in the vpaes basis. The kernels are
/// generated from the checked model in tools/vpaes.py by tools/clifgen.py.
pub type AesKey {
    u8[] keys,
    i64 rounds,
    u8[] tables,
}

/// Expands a 16-, 24-, or 32-byte key. Other lengths fail with InvalidKeyLength.
pub Result<AesKey, CryptoError> NewKey(u8[] key) {
    i64 keyLength = Slice.Len(key);
    if keyLength != 16_i64 && keyLength != 24_i64 && keyLength != 32_i64 {
        return Result::Error(CryptoError::InvalidKeyLength());
    }
    i64 rounds = keyLength / 4_i64 + 6_i64;
    u8[] tables = Tables();
    u8[] keys = Scratch.Bytes(16_i64 * (rounds + 1_i64));
    if keyLength == 16_i64 { Schedule128(key, tables, keys); }
    if keyLength == 24_i64 { Schedule192(key, tables, keys); }
    if keyLength == 32_i64 { Schedule256(key, tables, keys); }
    return Result::Ok(AesKey { keys: keys, rounds: rounds, tables: tables });
}

/// Encrypts one 16-byte block from `input[inputOffset..]` into `output[outputOffset..]`.
/// Returns false for out-of-range offsets. Input and output may alias.
pub bool EncryptBlock(AesKey key, u8[] input, i64 inputOffset, u8[] output, i64 outputOffset) {
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, 16_i64) { return false; }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, 16_i64) { return false; }
    i64 rounds = key.rounds;
    i64[] meta = [inputOffset, outputOffset, inputOffset + 1_i64, 0_i64, 0_i64, rounds];
    Block1(key.keys, key.tables, input, input, output, Scratch.Bytes(16_i64), meta);
    return true;
}

/// CTR mode (SP 800-38A) with a 32-bit big-endian block counter in bytes 12..16 of each
/// counter block, wrapping modulo 2^32 (the GCM inc32): XORs `count` bytes of `input` at
/// `inputOffset` with the keystream of the counter blocks `prefix[0, 12) || counter`,
/// `counter + 1`, ... into `output` at `outputOffset`. Returns false for invalid ranges or
/// a prefix shorter than 16 bytes. Input and output may be the same range.
pub bool CtrXorInto(AesKey key, u8[] prefix, i64 counter, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    if Slice.Len(prefix) < 16_i64 { return false; }
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, count) { return false; }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count) { return false; }
    i64 grouped = (count / 64_i64) * 64_i64;
    if grouped > 0_i64 {
        i64 rounds = key.rounds;
        i64[] meta = [inputOffset, outputOffset - inputOffset, inputOffset + grouped, counter & 4294967295_i64, 0_i64, rounds];
        Blocks4(key.keys, key.tables, prefix, input, output, Scratch.Bytes(64_i64), meta);
    }
    mut i64 next = (counter + grouped / 16_i64) & 4294967295_i64;
    u8[] block = Scratch.Bytes(16_i64);
    mut i64 i = 0_i64;
    while i < 12_i64 { block[i] = prefix[i]; i = i + 1_i64; }
    u8[] stream = Scratch.Bytes(16_i64);
    mut i64 done = grouped;
    while done < count {
        block[12] = u8((next >> 24_i64) & 255_i64);
        block[13] = u8((next >> 16_i64) & 255_i64);
        block[14] = u8((next >> 8_i64) & 255_i64);
        block[15] = u8(next & 255_i64);
        EncryptBlock(key, block, 0_i64, stream, 0_i64);
        next = (next + 1_i64) & 4294967295_i64;
        mut i64 take = 16_i64;
        if count - done < take { take = count - done; }
        mut i64 j = 0_i64;
        while j < take {
            u8 a = input[inputOffset + done + j];
            u8 b = stream[j];
            output[outputOffset + done + j] = (a | b) - (a & b);
            j = j + 1_i64;
        }
        done = done + take;
    }
    return true;
}

/// One-shot encryption of a single 16-byte block (also the QUIC AES header-protection sample cipher).
pub Result<u8[], CryptoError> Encrypt(u8[] key, u8[] block) {
    if Slice.Len(block) != 16_i64 { return Result::Error(CryptoError::InvalidLength()); }
    return match NewKey(key) {
        Result::Error(error) => Result::Error(error),
        Result::Ok(expanded) => {
            u8[] out = Scratch.Bytes(16_i64);
            EncryptBlock(expanded, block, 0_i64, out, 0_i64);
            return Result::Ok(out);
        },
    };
}

