use Testing.Assert;
use Core.Bytes.Slice;
use Core.String;
use Core.Results;
use Crypto.Errors;
use Crypto.Aes;
use Crypto.AesGcm;

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}
u8[] Hex(string text) {
    i64 n = String.Len(text) / 2_i64;
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = Nibble(String.ByteAt(text, 2_i64 * i)) * 16_u8 + Nibble(String.ByteAt(text, 2_i64 * i + 1_i64)); i = i + 1_i64; }
    return out;
}
bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }


u8[] Unwrap(Result<u8[], CryptoError> r) {
    return match r { Result::Ok(v) => v, Result::Error(_) => Slice.New(0_i64), };
}
u8[] Range(i64 n) { u8[] o = Slice.New(n); mut i64 i = 0_i64; while i < n { o[i] = u8(i); i = i + 1_i64; } return o; }

test aes128_fips197_c1 { Assert.True(Same(Unwrap(Aes.Encrypt(Range(16_i64), Hex("00112233445566778899aabbccddeeff"))), Hex("69c4e0d86a7b0430d8cdb78070b4c55a")), "aes128"); }
test aes192_fips197_c2 { Assert.True(Same(Unwrap(Aes.Encrypt(Range(24_i64), Hex("00112233445566778899aabbccddeeff"))), Hex("dda97ca4864cdfe06eaf70a0ec0d7191")), "aes192"); }
test aes256_fips197_c3 { Assert.True(Same(Unwrap(Aes.Encrypt(Range(32_i64), Hex("00112233445566778899aabbccddeeff"))), Hex("8ea2b7ca516745bfeafc49904b496089")), "aes256"); }
test aes_rejects_bad_key_length {
    bool rejected = match Aes.NewKey(Slice.New(20_i64)) { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::InvalidKeyLength => true, _ => false, }, };
    Assert.True(rejected, "20-byte key");
}
test aes_gcm_tc1 {
    match AesGcm.New(Hex("00000000000000000000000000000000")) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("000000000000000000000000"), Hex(""), Hex("")));
            Assert.True(Same(sealed, Hex("58e2fccefa7e3061367f1d57a4e7455a")), "sealed");
            Assert.True(Same(Unwrap(AesGcm.Open(key, Hex("000000000000000000000000"), Hex(""), sealed)), Hex("")), "opened");
        },
    };
}
test aes_gcm_tc2 {
    match AesGcm.New(Hex("00000000000000000000000000000000")) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("000000000000000000000000"), Hex(""), Hex("00000000000000000000000000000000")));
            Assert.True(Same(sealed, Hex("0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")), "sealed");
            Assert.True(Same(Unwrap(AesGcm.Open(key, Hex("000000000000000000000000"), Hex(""), sealed)), Hex("00000000000000000000000000000000")), "opened");
        },
