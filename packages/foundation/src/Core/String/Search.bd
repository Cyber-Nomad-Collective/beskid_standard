/// Core.String.Search — prefix, suffix, occurrence, and ordinal comparison helpers.
/// @tier(supported)
/// All positions are zero-based UTF-8 byte offsets; comparison is ordinal (byte-wise).
use Core.String.Ascii;
use Core.String.Core;

/// Returns true when `prefix` occurs in `text` at byte offset `at`. Offsets outside `text` never
/// match; the empty prefix matches at any offset from `0` to `Len(text)`.
pub bool StartsWithAt(string text, i64 at, string prefix) {
    i64 plen = Core.Len(prefix);
    if at < 0 || at + plen > Core.Len(text) {
        return false;
    }
    mut i64 i = 0;
    while i < plen {
        if Core.ByteAt(text, at + i) != Core.ByteAt(prefix, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Returns true when `text` begins with `prefix`. Every string starts with the empty prefix.
pub bool StartsWith(string text, string prefix) {
    return StartsWithAt(text, 0, prefix);
}

/// Returns true when `text` ends with `suffix`. Every string ends with the empty suffix.
pub bool EndsWith(string text, string suffix) {
    return StartsWithAt(text, Core.Len(text) - Core.Len(suffix), suffix);
}

/// Returns the first offset at or after `at` whose byte is not ASCII whitespace (space, tab, CR,
/// LF), or `Len(text)` when only whitespace remains.
pub i64 SkipWhitespace(string text, i64 at) {
    i64 len = Core.Len(text);
    mut i64 i = at;
    while i < len && Ascii.IsWhitespace(Core.ByteAt(text, i)) {
        i = i + 1;
    }
    return i;
}

/// Returns the byte offset of the first `needle` in `text`, or `-1`.
/// An empty needle matches at offset 0.
pub i64 IndexOf(string text, string needle) {
    return Core.IndexOfFrom(text, 0, needle);
}

/// Returns the byte offset of the last `needle` in `text`, or `-1`.
/// An empty needle matches at the end of `text`.
pub i64 LastIndexOf(string text, string needle) {
    i64 tlen = Core.Len(text);
    i64 nlen = Core.Len(needle);
    if nlen == 0 {
        return tlen;
    }
    mut i64 i = tlen - nlen;
    while i >= 0 {
        if StartsWithAt(text, i, needle) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

/// Counts non-overlapping occurrences of `needle` in `text`. An empty needle counts zero.
pub i64 Count(string text, string needle) {
    i64 nlen = Core.Len(needle);
    if nlen == 0 {
        return 0;
    }
    mut i64 total = 0;
    mut i64 at = Core.IndexOfFrom(text, 0, needle);
    while at >= 0 {
        total = total + 1;
        at = Core.IndexOfFrom(text, at + nlen, needle);
    }
    return total;
}

/// Ordinal comparison: `-1` when `a` sorts before `b`, `0` when equal, `1` when after.
/// Bytes compare as unsigned values; a proper prefix sorts first.
pub i64 Compare(string a, string b) {
    i64 alen = Core.Len(a);
    i64 blen = Core.Len(b);
    mut i64 limit = alen;
    if blen < limit {
        limit = blen;
    }
    mut i64 i = 0;
    while i < limit {
        u8 x = Core.ByteAt(a, i);
        u8 y = Core.ByteAt(b, i);
        if x < y {
            return -1;
        }
        if x > y {
            return 1;
        }
        i = i + 1;
    }
    if alen < blen {
        return -1;
    }
    if alen > blen {
        return 1;
    }
    return 0;
}

/// Returns true when `a` sorts strictly before `b` under `Compare`.
pub bool Less(string a, string b) {
    return Compare(a, b) < 0;
}

/// Returns true when `text` is empty or contains only ASCII whitespace (space, tab, CR, LF).
pub bool IsBlank(string text) {
    i64 len = Core.Len(text);
    mut i64 i = 0;
    while i < len {
        if !Ascii.IsWhitespace(Core.ByteAt(text, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
