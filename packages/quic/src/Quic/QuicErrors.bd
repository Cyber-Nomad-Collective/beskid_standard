use Network.Errors;

// QUIC transport error codes (RFC 9000 section 20.1) and the package error type.

pub i64 NoError() { return 0_i64; }
pub i64 InternalError() { return 1_i64; }
pub i64 ConnectionRefused() { return 2_i64; }
pub i64 FlowControlError() { return 3_i64; }
pub i64 StreamLimitError() { return 4_i64; }
pub i64 StreamStateError() { return 5_i64; }
pub i64 FinalSizeError() { return 6_i64; }
pub i64 FrameEncodingError() { return 7_i64; }
pub i64 TransportParameterError() { return 8_i64; }
pub i64 ConnectionIdLimitError() { return 9_i64; }
pub i64 ProtocolViolation() { return 10_i64; }
pub i64 InvalidToken() { return 11_i64; }
pub i64 ApplicationError() { return 12_i64; }
pub i64 CryptoBufferExceeded() { return 13_i64; }
pub i64 KeyUpdateError() { return 14_i64; }
pub i64 AeadLimitReached() { return 15_i64; }
pub i64 NoViablePath() { return 16_i64; }
/// CRYPTO_ERROR range base: 0x0100 + TLS alert.
pub i64 CryptoErrorBase() { return 256_i64; }

/// Typed failures of the QUIC package.
pub enum QuicError {
    /// This side closed the connection with a transport error code (RFC 9000 section 20.1).
    Transport(i64 code),
    /// The peer closed the connection; `application` tells which code space `code` uses.
    PeerClosed(i64 code, bool application),
    /// The connection was closed with an application error code.
    Application(i64 code),
    /// The UDP socket failed.
    Network(NetworkError error),
    /// The idle timeout expired (RFC 9000 section 10.1).
    IdleTimeout(),
    /// An operation deadline expired.
    TimedOut(),
    /// The connection or stream is closed.
    Closed(),
    /// An argument is outside its documented domain.
    InvalidArgument(),
    /// The stream is not in a state that allows the operation.
    StreamState(),
    /// A local limit (streams, buffers, connections) was reached.
    LimitExceeded(),
    /// The server does not support QUIC version 1.
    VersionNegotiation(),
    /// The peer reset the stream with an application error code.
    StreamReset(i64 code),
}

/// The transport error code a QuicError maps to on the wire.
pub i64 WireCode(QuicError error) {
    return match error {
        QuicError::Transport(code) => code,
        QuicError::PeerClosed(code, _) => code,
        QuicError::Application(code) => code,
        QuicError::StreamReset(code) => code,
        _ => 1_i64,
    };
}
