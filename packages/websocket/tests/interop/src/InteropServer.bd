use Concurrency.Fiber;
use Core.Results;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Network.Types;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Testing.Assert;
use WebSocket.WsConnection;
use WebSocket.WsErrors;

// Beskid echo server for run.sh: listens on 127.0.0.1:18765, serves
// ConnectionCount() connections one after another, echoing text and binary.

i64 ConnectionCount() { return 2_i64; }

SocketAddress Listen() {
    Port value = match Network.Types.PortNumber(18765_i64) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

Option<Deadline> Within(i64 millis) {
    return match Deadline.After(Time.FromMilliseconds(millis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

i64 Serve(TcpStream stream) {
    WsOptions options = WsConnection.WithTimeouts(WsConnection.WithProtocols(WsConnection.DefaultOptions(), ["chat"]), 10000_i64, 5000_i64, 30000_i64);
    return match WsConnection.Accept(stream, options) {
        Result::Error(_) => 0_i64,
        Result::Ok(conn) => EchoLoop(conn),
    };
}

i64 EchoLoop(WsConnection conn) {
    mut i64 echoed = 0_i64;
    mut bool running = true;
    while running {
        match conn.Receive() {
            Result::Error(_) => { running = false; },
            Result::Ok(message) => {
                running = Echo(conn, message);
                if running { echoed = echoed + 1_i64; }
            },
        };
    }
    return echoed;
}

bool Echo(WsConnection conn, WsMessage message) {
    return match message {
        WsMessage::Text(text) => Sent(conn.SendText(text)),
        WsMessage::Binary(data) => Sent(conn.SendBinary(data)),
        WsMessage::Close(_, _) => false,
    };
}

bool Sent(Result<unit, WsError> r) { return match r { Result::Ok(_) => true, Result::Error(_) => false, }; }

// Network waits must run on a spawned fiber, as in the other loopback targets.
unit RunServer() {
    match TcpListener.Bind(Listen(), 8_i64) {
        Result::Error(_) => { Assert.Fail("bind 127.0.0.1:18765"); },
        Result::Ok(listener) => {
            mut i64 served = 0_i64;
            mut i64 echoed = 0_i64;
            while served < ConnectionCount() {
                match listener.Accept(Within(300000_i64)) {
                    Result::Error(_) => { served = ConnectionCount(); },
                    Result::Ok(stream) => { echoed = echoed + Serve(stream); served = served + 1_i64; },
                };
            }
            listener.Close();
            Assert.Equal<i64>(echoed, 4_i64, "echoed text, two binaries and a 64 KiB message");
        },
    };
    return;
}

test interop_echo_server {
    Fiber<unit> server = spawn RunServer();
    Assert.True(match server.Join() { Result::Ok(_) => true, _ => false, }, "server joins");
}
