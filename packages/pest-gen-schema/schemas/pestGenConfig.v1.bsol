profile "pestGenConfig.v1" {
  version = 1
  import_schema "configuration.v1" {
    from = file
    path = "configuration.v1.bsol"
  }
  rule "config" {
    scope = top
    match = keyword
    keyword = config
    label = forbidden
    cardinality = one
    field "version" { type = u32 required = false }
    field "profile" { type = quoted required = false }
    field "module" { type = quoted required = false }
    field "package" { type = quoted required = false }
  }
  rule "option" {
    scope = top
    match = keyword
    keyword = option
    label = forbidden
    cardinality = many
    field "section" { type = quoted required = false }
    field "key" { type = quoted required = true }
    field "value" { type = loose required = true }
  }
  rule "pestGenConfig" {
    scope = top
    match = keyword
    keyword = pestGenConfig
    label = forbidden
    cardinality = zero_or_one
    field "ruleCallablePrefix" { type = quoted required = false }
    field "emitUseTerms" { type = enum_or_quoted values = [true, false] required = false }
  }
}
