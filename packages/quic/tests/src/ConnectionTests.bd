//! QUIC connections end to end: an in-memory handshake and stream echo, Retry, loss, flow control,
//! key update and timeouts, lost credit frames, and client and server endpoints over UDP on
//! 127.0.0.1 with and without the TLS 1.3 handshake.

use Testing.Assert;
use Core.Bytes.Slice;
use Core.String;
use Quic.QuicConfig;
use Quic.QuicConnection;
use Quic.QuicPacket;
use Quic.QuicWire;
use Codec.Hex;
use Quic.QuicErrors;
use Quic.QuicProtection;
use Concurrency.Fiber;
use Core.Results;
use Network.Types;
use Quic.QuicEndpoint;
use Tls.PeerKeys;
use Tls.TlsConfig;

string[] Protocols() { return ["hq-interop", "h3"]; }

Connection Server(QuicConfig cfg, Connection client, i64 now) {
    Header h = QuicPacket.ParseHeader(client.out, 0_i64, 1200_i64, 0_i64);
    return QuicConnection.NewServer(cfg, h.dcid, h.scid, h.dcid, Slice.New(0_i64), now);
}

// Moves every datagram `from` has to send into `to`; returns how many were moved.
i64 Pump(Connection from, Connection to, i64 now) {
    mut i64 moved = 0_i64;
    mut i64 length = QuicConnection.BuildDatagram(from, now);
    while length > 0_i64 && moved < 64_i64 {
        u8[] copy = QuicWire.CopyOf(from.out, 0_i64, length);
        QuicConnection.OnDatagram(to, copy, length, now);
        moved = moved + 1_i64;
        length = QuicConnection.BuildDatagram(from, now);
    }
    return moved;
}

i64 Exchange(Connection a, Connection b, i64 now) {
    mut i64 rounds = 0_i64;
    mut i64 total = 1_i64;
    while total > 0_i64 && rounds < 20_i64 {
        total = Pump(a, b, now) + Pump(b, a, now);
        rounds = rounds + 1_i64;
    }
    return rounds;
}

u8[] Bytes(string text) {
    u8[] out = Slice.New(String.Len(text));
    mut i64 i = 0_i64;
    while i < Slice.Len(out) { out[i] = String.ByteAt(text, i); i = i + 1_i64; }
    return out;
}

// Moves datagrams from `from` to `to`; drops the first `drop` of them. Returns how many moved.
i64 PumpDropping(Connection from, Connection to, i64 now, i64 drop) {
    mut i64 moved = 0_i64;
    mut i64 length = QuicConnection.BuildDatagram(from, now);
    while length > 0_i64 && moved < 64_i64 {
        if moved >= drop { QuicConnection.OnDatagram(to, QuicWire.CopyOf(from.out, 0_i64, length), length, now); }
        moved = moved + 1_i64;
        length = QuicConnection.BuildDatagram(from, now);
    }
    return moved;
}

i64 Earliest(Connection a, Connection b, i64 now) {
    i64 x = QuicConnection.NextTimeout(a, now);
    i64 y = QuicConnection.NextTimeout(b, now);
    if x < 0_i64 { return y; }
    if y < 0_i64 || x < y { return x; }
    return y;
}

// Exchanges until quiet, advancing the clock to the next timer when nothing moves.
// Returns the final clock.
i64 Settle(Connection a, Connection b, i64 start, i64 rounds) {
    mut i64 now = start;
    mut i64 r = 0_i64;
    while r < rounds {
        i64 moved = PumpDropping(a, b, now, 0_i64) + PumpDropping(b, a, now, 0_i64);
        if moved == 0_i64 {
            i64 t = Earliest(a, b, now);
            if t < 0_i64 || t - now > 2000000000_i64 { return now; }
            if t > now { now = t; }
            QuicConnection.OnTimeout(a, now);
            QuicConnection.OnTimeout(b, now);
        }
        r = r + 1_i64;
    }
    return now;
}

// Moves the datagrams `from` has to send into `to`. With `dropAll` every datagram is lost;
// otherwise each `dropEvery`-th datagram (counted in counter[0]) is lost (0 = none).
// Returns how many datagrams were built.
i64 PumpLosingCredit(Connection from, Connection to, i64 now, bool dropAll, i64 dropEvery, i64[] counter) {
    mut i64 moved = 0_i64;
    mut i64 length = QuicConnection.BuildDatagram(from, now);
    while length > 0_i64 && moved < 64_i64 {
        counter[0] = counter[0] + 1_i64;
        bool lost = dropAll || (dropEvery > 0_i64 && counter[0] % dropEvery == 0_i64);
        if lost { counter[1] = counter[1] + 1_i64; } else {
            QuicConnection.OnDatagram(to, QuicWire.CopyOf(from.out, 0_i64, length), length, now);
        }
        moved = moved + 1_i64;
        length = QuicConnection.BuildDatagram(from, now);
    }
    return moved;
}

i64 TotalBytes() { return 100000_i64; }

u8 PatternAt(i64 i) { return u8((i * 7_i64 + 3_i64) & 255_i64); }

SocketAddress LocalHost() {
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
}

Endpoint Open(QuicConfig cfg, bool server) {
    Result<Endpoint, QuicError> r = QuicEndpoint.Bind(LocalHost(), cfg, server);
    return match r {
        Result::Ok(ep) => ep,
        Result::Error(_) => Fail(),
    };
}

Endpoint Fail() {
    Assert.Fail("bind");
    return Fail();
}

SocketAddress AddressOf(Endpoint ep) {
    return match QuicEndpoint.LocalAddress(ep) {
        Result::Ok(a) => a,
        Result::Error(_) => LocalHost(),
    };
}

i64 Value(Result<i64, QuicError> r) {
    return match r { Result::Ok(v) => v, Result::Error(e) => -1000_i64 - QuicErrors.WireCode(e), };
}

bool Done(Result<unit, QuicError> r) {
    return match r { Result::Ok(_) => true, Result::Error(_) => false, };
}

// Server side: accept one connection and one stream, echo it back, then wait for the close.
i64 Echo(Endpoint ep) {
    i64 conn = Value(QuicEndpoint.Accept(ep, 10000_i64));
    if conn < 0_i64 { return conn; }
    i64 stream = Value(QuicEndpoint.AcceptStream(ep, conn, 10000_i64));
    if stream < 0_i64 { return stream; }
    u8[] buf = Slice.New(2048_i64);
    mut i64 total = 0_i64;
    mut bool reading = true;
    while reading {
        i64 n = Value(QuicEndpoint.Read(ep, conn, stream, buf, 0_i64, 2048_i64, 10000_i64));
        if n < 0_i64 { return n; }
        if n == 0_i64 { reading = false; } else {
            if !Done(QuicEndpoint.Write(ep, conn, stream, buf, 0_i64, n, 10000_i64)) { return -2_i64; }
            total = total + n;
        }
    }
    if !Done(QuicEndpoint.Finish(ep, conn, stream)) { return -3_i64; }
    return total;
}

// The scenario runs inside a fiber: the test root is not a fiber, so its sleeps and socket
// waits would not let the driver fibers run. Returns 0 or the number of the failed step.
i64 RetryScenario() {
    QuicConfig cfg = QuicConfig.InsecureLoopbackForTestsOnly(["echo/1"], 0_i64);
    Endpoint server = Open(QuicConfig.WithRetry(cfg, true), true);
    Endpoint client = Open(cfg, false);
    SocketAddress target = AddressOf(server);
    Fiber<unit> serverDriver = QuicEndpoint.Start(server);
    Fiber<unit> clientDriver = QuicEndpoint.Start(client);
    Fiber<i64> echo = spawn (() => Echo(server));
    i64 step = RetryTalk(client, server, target);
    i64 echoed = match echo.Join() { Result::Ok(v) => v, Result::Error(_) => -9_i64, };
    QuicEndpoint.Stop(client);
    QuicEndpoint.Stop(server);
    bool c1 = match clientDriver.Join() { Result::Ok(_) => true, Result::Error(_) => false, };
    bool c2 = match serverDriver.Join() { Result::Ok(_) => true, Result::Error(_) => false, };
    if step != 0_i64 { return step; }
    if echoed != 3000_i64 { return 20_i64; }
    if !c1 || !c2 { return 21_i64; }
    return 0_i64;
}

i64 RetryTalk(Endpoint client, Endpoint server, SocketAddress target) {
    i64 conn = Value(QuicEndpoint.Connect(client, target, 10000_i64));
    if conn < 0_i64 { return 1_i64; }
    if QuicEndpoint.Alpn(client, conn) != "echo/1" { return 2_i64; }
    if QuicEndpoint.RetriesSent(server) != 1_i64 { return 3_i64; }
    i64 stream = Value(QuicEndpoint.OpenStream(client, conn, true, 5000_i64));
    if stream != 0_i64 { return 4_i64; }
    u8[] data = Slice.New(3000_i64);
    mut i64 i = 0_i64;
    while i < 3000_i64 { data[i] = u8((i * 7_i64) & 255_i64); i = i + 1_i64; }
    if !Done(QuicEndpoint.Write(client, conn, stream, data, 0_i64, 3000_i64, 10000_i64)) { return 5_i64; }
    if !Done(QuicEndpoint.Finish(client, conn, stream)) { return 6_i64; }
    u8[] back = Slice.New(4096_i64);
    mut i64 total = 0_i64;
    mut bool reading = true;
    while reading {
        i64 n = Value(QuicEndpoint.Read(client, conn, stream, back, total, 4096_i64 - total, 10000_i64));
        if n < 0_i64 { return 7_i64; }
        if n == 0_i64 { reading = false; }
        total = total + n;
    }
    if total != 3000_i64 { return 8_i64; }
    i = 0_i64;
    while i < 3000_i64 { if back[i] != data[i] { return 9_i64; } i = i + 1_i64; }
    if !Done(QuicEndpoint.Close(client, conn, 7_i64, 3000_i64)) { return 10_i64; }
    return 0_i64;
}

QuicConfig ServerQuic() {
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    return QuicConfig.TlsServerConfigFor(TlsConfig.Server(TlsConfig.Chain1(ServerCertDer()), key), ["echo/1"]);
}

QuicConfig ClientQuic() {
    return QuicConfig.TlsClientConfigFor(TlsConfig.Client("localhost", TlsConfig.AcceptAnyCertificateForTestsOnly()), ["other", "echo/1"]);
}

// Runs inside a fiber (the test root is not a fiber). Returns 0 or the failed step.
i64 TlsScenario() {
    Endpoint server = Open(ServerQuic(), true);
    Endpoint client = Open(ClientQuic(), false);
    SocketAddress target = AddressOf(server);
    Fiber<unit> serverDriver = QuicEndpoint.Start(server);
    Fiber<unit> clientDriver = QuicEndpoint.Start(client);
    Fiber<i64> echo = spawn (() => Echo(server));
    i64 step = TlsTalk(client, target);
    i64 echoed = match echo.Join() { Result::Ok(v) => v, Result::Error(_) => -9_i64, };
    QuicEndpoint.Stop(client);
    QuicEndpoint.Stop(server);
    bool c1 = match clientDriver.Join() { Result::Ok(_) => true, Result::Error(_) => false, };
    bool c2 = match serverDriver.Join() { Result::Ok(_) => true, Result::Error(_) => false, };
    if step != 0_i64 { return step; }
    if echoed != 1500_i64 { return 20_i64; }
    if !c1 || !c2 { return 21_i64; }
    return 0_i64;
}

i64 TlsTalk(Endpoint client, SocketAddress target) {
    i64 conn = Value(QuicEndpoint.Connect(client, target, 20000_i64));
    if conn < 0_i64 { return 100_i64 - conn; }
    if QuicEndpoint.Alpn(client, conn) != "echo/1" { return 2_i64; }
    i64 stream = Value(QuicEndpoint.OpenStream(client, conn, true, 5000_i64));
    if stream != 0_i64 { return 4_i64; }
    u8[] data = Slice.New(1500_i64);
    mut i64 i = 0_i64;
    while i < 1500_i64 { data[i] = u8((i * 13_i64) & 255_i64); i = i + 1_i64; }
    if !Done(QuicEndpoint.Write(client, conn, stream, data, 0_i64, 1500_i64, 10000_i64)) { return 5_i64; }
    if !Done(QuicEndpoint.Finish(client, conn, stream)) { return 6_i64; }
    u8[] back = Slice.New(2048_i64);
    mut i64 total = 0_i64;
    mut bool reading = true;
    while reading {
        i64 n = Value(QuicEndpoint.Read(client, conn, stream, back, total, 2048_i64 - total, 10000_i64));
        if n < 0_i64 { return 7_i64; }
        if n == 0_i64 { reading = false; }
        total = total + n;
    }
    if total != 1500_i64 { return 8_i64; }
    i = 0_i64;
    while i < 1500_i64 { if back[i] != data[i] { return 9_i64; } i = i + 1_i64; }
    if !Done(QuicEndpoint.Close(client, conn, 0_i64, 3000_i64)) { return 10_i64; }
    return 0_i64;
}

