use Core.Bytes.Slice;
use Core.Results;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Errors;
use Crypto.Hmac;
use Crypto.Scratch;
use Crypto.Sha256;
use CryptoOpenSsl.Native;
use CryptoOpenSsl.NativeAesGcm;
use CryptoOpenSsl.NativeChaCha20Poly1305;
use CryptoOpenSsl.NativeHmac;
use CryptoOpenSsl.NativeSha256;

/// Which implementation serves a crypto call (ruling R20).
pub enum ProviderKind { Pure(), Native(), }

/// `BESKID_CRYPTO_PROVIDER` as a NUL-terminated C string.
pub u8[] SwitchName() { return [66_u8, 69_u8, 83_u8, 75_u8, 73_u8, 68_u8, 95_u8, 67_u8, 82_u8, 89_u8, 80_u8, 84_u8, 79_u8, 95_u8, 80_u8, 82_u8, 79_u8, 86_u8, 73_u8, 68_u8, 69_u8, 82_u8, 0_u8]; }

/// The switch value that forces the pure provider.
pub u8[] PureValue() { return [112_u8, 117_u8, 114_u8, 101_u8, 0_u8]; }

/// True when `BESKID_CRYPTO_PROVIDER=pure` is set.
pub bool PureForced() { return Native.EnvEquals(SwitchName(), PureValue()); }

bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }

u8[] Pattern(i64 n, i64 mul, i64 add) {
    u8[] out = Scratch.Bytes(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = u8((i * mul + add) & 255_i64); i = i + 1_i64; }
    return out;
}

bool AesAgrees(i64 keyLength, u8[] nonce, u8[] aad, u8[] message) {
    u8[] key = Pattern(keyLength, 1_i64, 0_i64);
    return match AesGcm.New(key) {
        Result::Error(_) => false,
        Result::Ok(pure) => match NativeAesGcm.New(key) {
            Result::Error(_) => false,
            Result::Ok(native) => {
                u8[] a = match AesGcm.Seal(pure, nonce, aad, message) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(0_i64), };
                u8[] b = match NativeAesGcm.Seal(native, nonce, aad, message) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(1_i64), };
                if !Same(a, b) { return false; }
                u8[] opened = match NativeAesGcm.Open(native, nonce, aad, b) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(0_i64), };
                if !Same(opened, message) { return false; }
                b[0] = (b[0] | 1_u8) - (b[0] & 1_u8);
                return match NativeAesGcm.Open(native, nonce, aad, b) {
                    Result::Ok(_) => false,
                    Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, },
                };
            },
        },
    };
}

bool ChaChaAgrees(u8[] nonce, u8[] aad, u8[] message) {
    u8[] key = Pattern(32_i64, 3_i64, 1_i64);
    u8[] a = match ChaCha20Poly1305.Seal(key, nonce, aad, message) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(0_i64), };
    u8[] b = match NativeChaCha20Poly1305.Seal(key, nonce, aad, message) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(1_i64), };
    if !Same(a, b) { return false; }
    u8[] opened = match NativeChaCha20Poly1305.Open(key, nonce, aad, b) { Result::Ok(v) => v, Result::Error(_) => Scratch.Bytes(0_i64), };
    if !Same(opened, message) { return false; }
    i64 last = Slice.Len(b) - 1_i64;
    b[last] = (b[last] | 1_u8) - (b[last] & 1_u8);
    return match NativeChaCha20Poly1305.Open(key, nonce, aad, b) {
        Result::Ok(_) => false,
        Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, },
    };
}

/// Known-answer self-test of the native provider against the pure reference: SHA-256,
/// HMAC-SHA-256/384, AES-128/256-GCM and ChaCha20-Poly1305 seal, open, and tag rejection.
/// False when libcrypto misbehaves; callers then use the pure provider.
pub bool SelfTest() {
    u8[] abc = [97_u8, 98_u8, 99_u8];
    if !Same(NativeSha256.Hash(abc), Sha256.Hash(abc)) { return false; }
    // SHA-256("abc") = ba7816bf ... f20015ad (FIPS 180-4 example).
    u8[] d = NativeSha256.Hash(abc);
    if d[0] != 186_u8 || d[31] != 173_u8 { return false; }
    u8[] key = Pattern(20_i64, 0_i64, 11_i64);
    u8[] msg = Pattern(77_i64, 5_i64, 2_i64);
    if !Same(NativeHmac.Compute(HashAlgorithm::Sha256(), key, msg), Hmac.Compute(HashAlgorithm::Sha256(), key, msg)) { return false; }
    if !Same(NativeHmac.Compute(HashAlgorithm::Sha384(), key, msg), Hmac.Compute(HashAlgorithm::Sha384(), key, msg)) { return false; }
    u8[] nonce = Pattern(12_i64, 7_i64, 9_i64);
    u8[] aad = Pattern(13_i64, 1_i64, 0_i64);
    if !AesAgrees(16_i64, nonce, aad, msg) { return false; }
    if !AesAgrees(32_i64, nonce, aad, msg) { return false; }
    return ChaChaAgrees(nonce, aad, msg);
}

/// Chooses the provider: Pure when `BESKID_CRYPTO_PROVIDER=pure` is set or the self-test
/// fails, else Native. Call it once and keep the result (for example in a TLS config);
/// it runs the self-test each time it is called.
pub ProviderKind Select() {
    if PureForced() { return ProviderKind::Pure(); }
    if !SelfTest() { return ProviderKind::Pure(); }
    return ProviderKind::Native();
}
