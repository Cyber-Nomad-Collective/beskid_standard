// TLS 1.3 wire constants (RFC 8446 sections 4, 4.2, 5.1, B.3).

// Record content types.
pub i64 ContentChangeCipherSpec() { return 20_i64; }
pub i64 ContentAlert() { return 21_i64; }
pub i64 ContentHandshake() { return 22_i64; }
pub i64 ContentApplicationData() { return 23_i64; }

// Handshake message types.
pub i64 MsgClientHello() { return 1_i64; }
pub i64 MsgServerHello() { return 2_i64; }
pub i64 MsgNewSessionTicket() { return 4_i64; }
pub i64 MsgEndOfEarlyData() { return 5_i64; }
pub i64 MsgEncryptedExtensions() { return 8_i64; }
pub i64 MsgCertificate() { return 11_i64; }
pub i64 MsgCertificateRequest() { return 13_i64; }
pub i64 MsgCertificateVerify() { return 15_i64; }
pub i64 MsgFinished() { return 20_i64; }
pub i64 MsgKeyUpdate() { return 24_i64; }
pub i64 MsgMessageHash() { return 254_i64; }

// Extension types.
pub i64 ExtServerName() { return 0_i64; }
pub i64 ExtMaxFragmentLength() { return 1_i64; }
pub i64 ExtStatusRequest() { return 5_i64; }
pub i64 ExtSupportedGroups() { return 10_i64; }
pub i64 ExtSignatureAlgorithms() { return 13_i64; }
pub i64 ExtUseSrtp() { return 14_i64; }
pub i64 ExtHeartbeat() { return 15_i64; }
pub i64 ExtAlpn() { return 16_i64; }
pub i64 ExtSignedCertificateTimestamp() { return 18_i64; }
pub i64 ExtClientCertificateType() { return 19_i64; }
pub i64 ExtServerCertificateType() { return 20_i64; }
pub i64 ExtPadding() { return 21_i64; }
pub i64 ExtRecordSizeLimit() { return 28_i64; }
pub i64 ExtPreSharedKey() { return 41_i64; }
pub i64 ExtEarlyData() { return 42_i64; }
pub i64 ExtSupportedVersions() { return 43_i64; }
pub i64 ExtCookie() { return 44_i64; }
pub i64 ExtPskKeyExchangeModes() { return 45_i64; }
pub i64 ExtCertificateAuthorities() { return 47_i64; }
pub i64 ExtOidFilters() { return 48_i64; }
pub i64 ExtPostHandshakeAuth() { return 49_i64; }
pub i64 ExtSignatureAlgorithmsCert() { return 50_i64; }
pub i64 ExtKeyShare() { return 51_i64; }
pub i64 ExtQuicTransportParameters() { return 57_i64; }

// Versions.
pub i64 VersionTls12() { return 0x0303_i64; }
pub i64 VersionTls13() { return 0x0304_i64; }

// Named groups (RFC 8446 section 4.2.7).
pub i64 GroupSecp256r1() { return 0x0017_i64; }
pub i64 GroupSecp384r1() { return 0x0018_i64; }
pub i64 GroupSecp521r1() { return 0x0019_i64; }
pub i64 GroupX25519() { return 0x001D_i64; }
pub i64 GroupX448() { return 0x001E_i64; }

// Signature schemes (RFC 8446 section 4.2.3).
pub i64 SchemeRsaPkcs1Sha256() { return 0x0401_i64; }
pub i64 SchemeRsaPkcs1Sha384() { return 0x0501_i64; }
pub i64 SchemeRsaPkcs1Sha512() { return 0x0601_i64; }
pub i64 SchemeEcdsaSecp256r1Sha256() { return 0x0403_i64; }
pub i64 SchemeEcdsaSecp384r1Sha384() { return 0x0503_i64; }
pub i64 SchemeRsaPssRsaeSha256() { return 0x0804_i64; }
pub i64 SchemeRsaPssRsaeSha384() { return 0x0805_i64; }
pub i64 SchemeRsaPssRsaeSha512() { return 0x0806_i64; }
pub i64 SchemeEd25519() { return 0x0807_i64; }

// PSK key exchange modes.
pub i64 PskModeDhe() { return 1_i64; }

// Encryption levels shared with QUIC (RFC 9001 section 4.1.4).
pub i64 LevelInitial() { return 0_i64; }
pub i64 LevelEarlyData() { return 1_i64; }
pub i64 LevelHandshake() { return 2_i64; }
pub i64 LevelApplication() { return 3_i64; }

// Record limits (RFC 8446 section 5.1, 5.2).
pub i64 MaxPlaintext() { return 16384_i64; }
pub i64 MaxCiphertext() { return 16640_i64; }
pub i64 RecordHeaderLength() { return 5_i64; }
// Largest handshake message this implementation accepts (certificate chains included).
pub i64 MaxHandshakeMessage() { return 32768_i64; }
