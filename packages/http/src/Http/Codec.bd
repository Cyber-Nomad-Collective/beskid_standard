string TrimOws(string value) { mut i64 start = 0_i64; mut i64 end = String.Len(value); while start < end && (String.ByteAt(value,start) == u8(32) || String.ByteAt(value,start) == u8(9)) { start = start + 1_i64; } while end > start && (String.ByteAt(value,end-1_i64) == u8(32) || String.ByteAt(value,end-1_i64) == u8(9)) { end = end - 1_i64; } return String.SubSlice(value,start,end-start); }
Result<string,HttpError> Ascii(u8[] bytes,i64 offset,i64 count) { Result<string,Core.Encoding.EncodingError> value = Encoding.DecodeHttpAscii(Slice.SubSlice(bytes,offset,count)); return match value { Result::Ok(text) => Result::Ok(text), Result::Error(_) => Result::Error(HttpError::InvalidFraming()), }; }
/// Index of the CRLFCRLF that ends the head. The field section, including the last field line's CRLF, is bytes[0, end + 2).
i64 HeaderEnd(u8[] bytes, Limits limits) { mut i64 count = Slice.Len(bytes); if count > limits.maxHeaderBytes + 4_i64 { count = limits.maxHeaderBytes + 4_i64; } mut i64 i = 0_i64; while i + 3_i64 < count { if bytes[i] == u8(13) && bytes[i+1_i64] == u8(10) && bytes[i+2_i64] == u8(13) && bytes[i+3_i64] == u8(10) { return i; } i = i + 1_i64; } return -1_i64; }
/// A lone LF inside the header section is never HTTP/1.1 framing; body octets are not scanned.
bool HasBareLf(u8[] bytes, i64 end) {
    mut i64 i = 0_i64;
    while i < end {
        if bytes[i] == u8(10) && (i == 0_i64 || bytes[i - 1_i64] != u8(13)) { return true; }
        i = i + 1_i64;
    }
    return false;
}

/// The header-section prefix that may be scanned: through CRLFCRLF when found, else the bounded head.
i64 HeadScanEnd(u8[] bytes, i64 end, Limits limits) {
    if end >= 0_i64 { return end + 4_i64; }
    i64 count = Slice.Len(bytes);
    if count > limits.maxHeaderBytes + 4_i64 { return limits.maxHeaderBytes + 4_i64; }
    return count;
}

/// Index of the CRLFCRLF head terminator. Bare LF wins over size so malformed framing is reported as such.
pub Result<i64,HttpError> HeadBoundary(u8[] bytes, Limits limits) {
    i64 end = HeaderEnd(bytes, limits);
    if HasBareLf(bytes, HeadScanEnd(bytes, end, limits)) { return Result::Error(HttpError::InvalidFraming()); }
    if end < 0_i64 { return Result::Error(HttpError::HeaderTooLarge()); }
    return Result::Ok(end);
}
Result<i64,HttpError> Decimal(string value) { if String.Len(value) == 0_i64 { return Result::Error(HttpError::InvalidContentLength()); } mut i64 out = 0_i64; mut i64 i = 0_i64; while i < String.Len(value) { u8 b = String.ByteAt(value,i); if b < u8(48) || b > u8(57) || out > (9223372036854775807_i64-i64(b-u8(48)))/10_i64 { return Result::Error(HttpError::InvalidContentLength()); } out = out*10_i64+i64(b-u8(48)); i = i+1_i64; } return Result::Ok(out); }
Result<Header[],HttpError> Headers(u8[] bytes,i64 start,i64 end,Limits limits) {
