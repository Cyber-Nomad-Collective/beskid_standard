use Core.Bytes.Slice;
use Core.Results;
use Crypto.AesGcm;
use Crypto.Errors;
use Crypto.Scratch;
use CryptoOpenSsl.Native;

/// AES-GCM (NIST SP 800-38D, 96-bit IV, 16-byte tag) through OpenSSL EVP; drop-in for
/// `Crypto.AesGcm` with its own key type. The key keeps the raw key bytes (OpenSSL expands
/// them per call) and the pure key, which serves inputs above `Native.MaxEvpLength()`.
pub type NativeAesGcmKey {
    u8[] raw,
    i64 cipher,
    AesGcmKey pure,
}

pub i64 TagLength() { return 16_i64; }
pub i64 NonceLength() { return 12_i64; }

/// Accepts a 16, 24, or 32-byte key.
pub Result<NativeAesGcmKey, CryptoError> New(u8[] key) {
    return match AesGcm.New(key) {
        Result::Error(error) => Result::Error(error),
        Result::Ok(pure) => {
            i64 n = Slice.Len(key);
            u8[] raw = Scratch.Bytes(n);
            Slice.Copy(raw, 0_i64, key, 0_i64, n);
            return Result::Ok(NativeAesGcmKey { raw: raw, cipher: Native.AesGcmCipher(n), pure: pure });
        },
    };
}

bool Small(u8[] aad, i64 count) { return count < Native.MaxEvpLength() && Slice.Len(aad) < Native.MaxEvpLength(); }

/// Same contract as `Crypto.AesGcm.SealInto`. Input and output must be the same range or disjoint.
pub Result<unit, CryptoError> SealInto(NativeAesGcmKey key, u8[] nonce, u8[] aad, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    if count < 0_i64 || !Small(aad, count) { return AesGcm.SealInto(key.pure, nonce, aad, input, inputOffset, count, output, outputOffset); }
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, count) { return Result::Error(CryptoError::InvalidLength()); }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count + 16_i64) { return Result::Error(CryptoError::InvalidLength()); }
    if !Native.AeadSeal(key.cipher, key.raw, nonce, aad, input, inputOffset, count, output, outputOffset) {
        return AesGcm.SealInto(key.pure, nonce, aad, input, inputOffset, count, output, outputOffset);
    }
    return Result::Ok(());
}

/// Same contract as `Crypto.AesGcm.OpenInto`, except that a wrong tag zeroes the output range
/// (OpenSSL decrypts before it verifies; no unverified plaintext is left behind).
pub Result<i64, CryptoError> OpenInto(NativeAesGcmKey key, u8[] nonce, u8[] aad, u8[] sealed, i64 sealedOffset, i64 sealedCount, u8[] output, i64 outputOffset) {
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    if !Slice.IsValidRange(Slice.Len(sealed), sealedOffset, sealedCount) { return Result::Error(CryptoError::InvalidLength()); }
    if sealedCount < 16_i64 { return Result::Error(CryptoError::AuthenticationFailed()); }
    i64 count = sealedCount - 16_i64;
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count) { return Result::Error(CryptoError::InvalidLength()); }
    if !Small(aad, count) { return AesGcm.OpenInto(key.pure, nonce, aad, sealed, sealedOffset, sealedCount, output, outputOffset); }
    i64 result = Native.AeadOpen(key.cipher, key.raw, nonce, aad, sealed, sealedOffset, count, output, outputOffset);
    if result == 1_i64 { return Result::Ok(count); }
    return Result::Error(CryptoError::AuthenticationFailed());
}

/// Same contract as `Crypto.AesGcm.Seal`.
pub Result<u8[], CryptoError> Seal(NativeAesGcmKey key, u8[] nonce, u8[] aad, u8[] plaintext) {
    i64 count = Slice.Len(plaintext);
    u8[] out = Scratch.Bytes(count + 16_i64);
    return match SealInto(key, nonce, aad, plaintext, 0_i64, count, out, 0_i64) {
        Result::Ok(_) => Result::Ok(out),
        Result::Error(error) => Result::Error(error),
    };
}

/// Same contract as `Crypto.AesGcm.Open`: a wrong tag returns AuthenticationFailed and no plaintext.
pub Result<u8[], CryptoError> Open(NativeAesGcmKey key, u8[] nonce, u8[] aad, u8[] sealed) {
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    i64 total = Slice.Len(sealed);
    if total < 16_i64 { return Result::Error(CryptoError::AuthenticationFailed()); }
    u8[] out = Scratch.Bytes(total - 16_i64);
    return match OpenInto(key, nonce, aad, sealed, 0_i64, total, out, 0_i64) {
        Result::Ok(_) => Result::Ok(out),
        Result::Error(error) => Result::Error(error),
    };
}
