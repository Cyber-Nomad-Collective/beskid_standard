use Beskid.Syntax.Nodes.NodeRef;
use Beskid.Syntax.Nodes.NodeSpan;
use Beskid.Syntax.Nodes.PrimitiveType;

use Core.Optional.Option;

use Core.Results;

pub type SemanticHandle
{
    u64 token,
}

pub type SemanticError
{
    pub string code,

    pub string message,
}

pub enum Ownership
{
    NativeOrScalar,

    GcManaged,
}

pub type Declaration
{
    pub string sourceUnit,

    pub u64 generation,

    pub u32 node,

    pub NodeSpan span,
}

pub enum FieldType
{
    Scalar(PrimitiveType primitive),

    Nominal(SemanticHandle handle),

    Array(FieldType[] element),
}

pub type Field
{
    pub string name,

    pub Declaration declaration,

    pub FieldType ty,

    pub Ownership ownership,
}

pub type Variant
{
    pub string name,

    pub u32 ordinal,

    pub Declaration declaration,

    pub Field[] fields,
}

pub enum ShapeBody
{
    Record(Field[] fields),

    Enum(Variant[] variants),
}

pub type PackageDeclaration
{
    pub string sourcePath,

    pub string[] lexicalPath,
}

pub enum PackageSource
{
    Local,

    Corelib,

    Registry(string origin, string artifactDigest),
}

pub type PackageIdentity
{
    pub string name,

    pub string version,

    pub PackageSource source,

    pub string sourceDigest,
}

pub type Shape
{
    pub string name,

    pub string declarationIdentity,

    pub Option<PackageDeclaration> packageDeclaration,

    pub Declaration declaration,

    pub FieldType[] typeArguments,

    pub ShapeBody body,

    pub Option<PackageIdentity> package,
}

/// A transported token is not a grant; only its issuer may resolve it.
pub SemanticHandle HandleValue(u64 token)
{
    return SemanticHandle
    {
        token: token,
    };
}

pub u64 HandleToken(SemanticHandle handle)
{
    return handle.token;
}

pub SemanticError ErrorValue(string code, string message)
{
    return SemanticError
    {
        code: code,

        message: message,
    };
}

pub Declaration DeclarationValue(string sourceUnit, u64 generation, u32 node, NodeSpan span)
{
    return Declaration
    {
        sourceUnit: sourceUnit,

        generation: generation,

        node: node,

        span: span,
    };
}

pub FieldType ScalarValue(PrimitiveType primitive)
{
    return FieldType::Scalar(primitive);
}

pub FieldType NominalValue(SemanticHandle handle)
{
    return FieldType::Nominal(handle);
}

pub FieldType ArrayValue(FieldType element)
{
    return FieldType::Array([element]);
}

pub Field FieldValue(string name, Declaration declaration, FieldType ty, Ownership ownership)
{
    return Field
    {
        name: name,

        declaration: declaration,

        ty: ty,

        ownership: ownership,
    };
}

pub Variant VariantValue(string name, u32 ordinal, Declaration declaration, Field[] fields)
{
    return Variant
    {
        name: name,

        ordinal: ordinal,

        declaration: declaration,

        fields: fields,
    };
}

pub ShapeBody RecordValue(Field[] fields)
{
    return ShapeBody::Record(fields);
}

pub ShapeBody EnumValue(Variant[] variants)
{
    return ShapeBody::Enum(variants);
}

pub PackageDeclaration PackageDeclarationValue(string sourcePath, string[] lexicalPath)
{
    return PackageDeclaration
    {
        sourcePath: sourcePath,

        lexicalPath: lexicalPath,
    };
}

pub PackageSource LocalValue()
{
    return PackageSource::Local;
}

pub PackageSource CorelibValue()
{
    return PackageSource::Corelib;
}

pub PackageSource RegistryValue(string origin, string artifactDigest)
{
    return PackageSource::Registry(origin, artifactDigest);
}

pub PackageIdentity PackageValue(string name, string version, PackageSource source, string sourceDigest)
{
    return PackageIdentity
    {
        name: name,

        version: version,

        source: source,

        sourceDigest: sourceDigest,
    };
}

pub Option<PackageIdentity> NoPackage()
{
    return Option::None;
}

pub Option<PackageIdentity> SomePackage(PackageIdentity identity)
{
    return Option::Some(identity);
}

pub Option<PackageDeclaration> NoPackageDeclaration()
{
    return Option::None;
}

pub Option<PackageDeclaration> SomePackageDeclaration(PackageDeclaration declaration)
{
    return Option::Some(declaration);
}

pub Shape ShapeValue(string name, string declarationIdentity, Option<PackageDeclaration> packageDeclaration, Declaration declaration, FieldType[] typeArguments, ShapeBody body, Option<PackageIdentity> package)
{
    return Shape
    {
        name: name,

        declarationIdentity: declarationIdentity,

        packageDeclaration: packageDeclaration,

        declaration: declaration,

        typeArguments: typeArguments,

        body: body,

        package: package,
    };
}

/// Implemented only by the registered invocation-scoped native semantic bridge.
/// Missing/stale/foreign issuer authority returns SemanticError; no file reads.
pub Result<SemanticHandle, SemanticError> ResolveType(Declaration declaration)
{
    return __mod_semantic_resolve_type(declaration);
}

pub Result<Shape, SemanticError> TypeShape(SemanticHandle handle)
{
    return __mod_semantic_type_shape(handle);
}

/// Source factories preserve exact enum declarations; wire ordinals are never authority.
pub NodeSpan SpanValue(u64 start, u64 end, u64 lineStart, u64 columnStart, u64 lineEnd, u64 columnEnd) {
    return NodeSpan { start: start, end: end, lineStart: lineStart, columnStart: columnStart, lineEnd: lineEnd, columnEnd: columnEnd };
}
pub Ownership NativeOwnershipValue() { return Ownership::NativeOrScalar; }
pub Ownership GcOwnershipValue() { return Ownership::GcManaged; }
pub PrimitiveType PrimitiveBoolValue() { return PrimitiveType::Bool; }
pub PrimitiveType PrimitiveI8Value() { return PrimitiveType::I8; }
pub PrimitiveType PrimitiveI16Value() { return PrimitiveType::I16; }
pub PrimitiveType PrimitiveI32Value() { return PrimitiveType::I32; }
pub PrimitiveType PrimitiveI64Value() { return PrimitiveType::I64; }
pub PrimitiveType PrimitiveU8Value() { return PrimitiveType::U8; }
pub PrimitiveType PrimitiveU16Value() { return PrimitiveType::U16; }
pub PrimitiveType PrimitiveU32Value() { return PrimitiveType::U32; }
pub PrimitiveType PrimitiveU64Value() { return PrimitiveType::U64; }
pub PrimitiveType PrimitiveF32Value() { return PrimitiveType::F32; }
pub PrimitiveType PrimitiveF64Value() { return PrimitiveType::F64; }
pub PrimitiveType PrimitivePointerValue() { return PrimitiveType::Pointer; }
pub PrimitiveType PrimitiveWordValue() { return PrimitiveType::Word; }
pub PrimitiveType PrimitiveCharValue() { return PrimitiveType::Char; }
pub PrimitiveType PrimitiveStringValue() { return PrimitiveType::String; }
pub PrimitiveType PrimitiveUnitValue() { return PrimitiveType::Unit; }
pub PrimitiveType PrimitiveNeverValue() { return PrimitiveType::Never; }

/// Exact callback return constructors. The native bridge invokes these registered source
/// functions; it never manufactures a Result/Option tag or managed payload offset.
pub Result<SemanticHandle, SemanticError> ResolveTypeOk(SemanticHandle handle) {
    return Result::Ok(handle);
}
pub Result<SemanticHandle, SemanticError> ResolveTypeError(SemanticError error) {
    return Result::Error(error);
}
pub Result<Shape, SemanticError> TypeShapeOk(Shape shape) {
    return Result::Ok(shape);
}
pub Result<Shape, SemanticError> TypeShapeError(SemanticError error) {
    return Result::Error(error);
}

/// Readonly mirror of a current invocation's retained private catchall proof.
/// The token and facts do not reconstruct eligibility after the scope closes.
pub type CatchallWitness {
    u64 token,
    SemanticHandle owner,
    Declaration field,
    SemanticHandle map,
    FieldType value,
}
pub CatchallWitness CatchallValue(u64 token, SemanticHandle owner, Declaration field, SemanticHandle map, FieldType value) {
    return CatchallWitness { token: token, owner: owner, field: field, map: map, value: value };
}
pub SemanticHandle CatchallOwner(CatchallWitness witness) { return witness.owner; }
pub Declaration CatchallField(CatchallWitness witness) { return witness.field; }
pub SemanticHandle CatchallMap(CatchallWitness witness) { return witness.map; }
pub FieldType CatchallValueType(CatchallWitness witness) { return witness.value; }
pub Result<CatchallWitness, SemanticError> CaptureCatchall(SemanticHandle owner, Declaration field) {
    return __mod_semantic_capture_catchall(owner, field);
}
pub Result<CatchallWitness, SemanticError> ValidateCatchall(CatchallWitness witness) {
    return __mod_semantic_validate_catchall(witness.token);
}
pub Result<CatchallWitness, SemanticError> CatchallOk(CatchallWitness witness) { return Result::Ok(witness); }
pub Result<CatchallWitness, SemanticError> CatchallError(SemanticError error) { return Result::Error(error); }

/// Resolves only an exact current invocation-issued concrete nominal declaration.
pub Result<SemanticHandle, SemanticError> ResolveSyntaxType(NodeRef reference) {
    return __mod_semantic_resolve_syntax_type(reference);
}

/// Invocation-scoped generic declaration description; never a concrete shape handle.
pub type TypeTemplate { NodeRef reference, }
pub Result<TypeTemplate, SemanticError> ResolveSyntaxTemplate(NodeRef reference) {
    return __mod_semantic_resolve_syntax_template(reference);
}
pub NodeRef TemplateReference(TypeTemplate template) { return template.reference; }
pub TypeTemplate TemplateValue(NodeRef reference) { return TypeTemplate { reference: reference }; }
pub Result<TypeTemplate, SemanticError> TemplateOk(TypeTemplate template) { return Result::Ok(template); }
pub Result<TypeTemplate, SemanticError> TemplateError(SemanticError error) { return Result::Error(error); }

/// Descriptive route to an exact canonical declaration visible from an issued caller.
pub type CanonicalPath {pub string logicalName,pub string[] segments,}
pub Result<CanonicalPath[],SemanticError> PlanCanonicalPaths(NodeRef caller,string[] requested) {
    return __mod_semantic_plan_canonical_paths(caller,requested);
}
pub CanonicalPath CanonicalPathValue(string logicalName,string[] segments) {
    return CanonicalPath {logicalName:logicalName,segments:segments};
}
pub Result<CanonicalPath[],SemanticError> CanonicalPathsOk(CanonicalPath[] paths) {return Result::Ok(paths);}
pub Result<CanonicalPath[],SemanticError> CanonicalPathsError(SemanticError error) {return Result::Error(error);}

/// Issued signature of a caller-visible source function. Parameter and result FieldTypes
/// carry the same issuer handles TypeShape returns, so equal applications compare equal by
/// handle. The signature describes a declaration; it never grants invocation.
pub type FunctionSignature {
    pub Declaration declaration,
    pub u32 genericCount,
    pub FieldType[] parameters,
    pub FieldType result,
}
/// Canonical name resolution of `path` from the issued `caller` scope (imports, modules,
/// packages). A function the caller cannot see is unresolvable, never a private grant.
pub Result<FunctionSignature, SemanticError> ResolveFunction(NodeRef caller, string[] path) {
    return __mod_semantic_resolve_function(caller, path);
}
pub FunctionSignature FunctionSignatureValue(Declaration declaration, u32 genericCount, FieldType[] parameters, FieldType result) {
    return FunctionSignature { declaration: declaration, genericCount: genericCount, parameters: parameters, result: result };
}
pub Result<FunctionSignature, SemanticError> FunctionSignatureOk(FunctionSignature signature) { return Result::Ok(signature); }
pub Result<FunctionSignature, SemanticError> FunctionSignatureError(SemanticError error) { return Result::Error(error); }

/// Host serialization gate for an issued concrete handle. It rejects process and
/// runtime-managed opaque resources whose representation TypeShape does not expose.
pub Result<unit, SemanticError> CheckSerializable(SemanticHandle handle) {
    return __mod_semantic_check_serializable(handle);
}
pub Result<unit, SemanticError> SerializableOk(unit admitted) { return Result::Ok(admitted); }
pub Result<unit, SemanticError> SerializableError(SemanticError error) { return Result::Error(error); }
