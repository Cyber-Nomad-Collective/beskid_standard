use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.String;
use Tls.Suites;
use Tls.Wire;

// Explicit client and server policy. There is no insecure default: a client config needs a
// server name and a verification mode; skipping verification is a separate, loudly named
// mode meant for tests only.

pub type Blob { pub u8[] data, }

/// Trust anchors as DER certificates (roots the chain must end at).
pub type TrustAnchors { pub Blob[] certificates, }

pub enum CertificateVerification {
    // Validate the chain to one of these anchors and check the server name (RFC 6125).
    Anchors(TrustAnchors anchors),
    // Accept any certificate chain. Only the CertificateVerify signature is still checked,
    // which proves possession of the presented key but not who owns it. Tests only.
    DangerousAcceptAnyCertificate,
}

pub type TlsClientConfig {
    // DNS name (sent as SNI and verified) or an IP literal (verified, not sent as SNI).
    pub string serverName,
    pub CertificateVerification verification,
    // Offered ALPN protocols in preference order; empty offers none.
    pub string[] alpn,
    // Fail with no_application_protocol when ALPN was offered and the server selected none.
    pub bool alpnRequired,
    pub CipherSuite[] cipherSuites,
    // Named groups in preference order; the first gets a key share in the first ClientHello.
    pub i64[] groups,
    // RSA keys below this size fail CertificateVerify with insufficient_security.
    pub i64 minRsaBits,
    // Seconds since the Unix epoch for certificate validity; 0 uses the system clock.
    pub i64 nowSeconds,
    // QUIC (RFC 9001): set `quic` and the encoded transport parameters.
    pub bool quic,
    pub u8[] quicTransportParameters,
}

pub type TlsServerConfig {
    // End-entity certificate first, DER.
    pub Blob[] certificateChain,
    // P-256 private scalar (32 bytes); see PeerKeys.P256PrivateKeyFromDer.
    pub u8[] privateKey,
    // Supported ALPN protocols in server preference order; empty disables ALPN.
    pub string[] alpn,
    // Abort with missing_extension when the client sends no server_name.
    pub bool requireSni,
    // When non-empty, a received server_name must be one of these (else unrecognized_name).
    pub string[] serverNames,
    pub CipherSuite[] cipherSuites,
    pub i64[] groups,
    pub bool quic,
    pub u8[] quicTransportParameters,
}

/// Client defaults: all three suites (AES-128-GCM first), X25519 then P-256, no ALPN.
pub TlsClientConfig Client(string serverName, CertificateVerification verification) {
    mut string[] alpn = Array.Empty<string>();
    return TlsClientConfig {
        serverName: serverName, verification: verification, alpn: alpn, alpnRequired: false,
        cipherSuites: Suites.All(), groups: [Wire.GroupX25519(), Wire.GroupSecp256r1()],
        minRsaBits: 2048_i64, nowSeconds: 0_i64, quic: false, quicTransportParameters: Slice.New(0_i64),
    };
}

/// Server defaults: all three suites (AES-128-GCM first), X25519 then P-256, no ALPN, SNI optional.
pub TlsServerConfig Server(Blob[] certificateChain, u8[] privateKey) {
    mut string[] alpn = Array.Empty<string>();
    mut string[] names = Array.Empty<string>();
    return TlsServerConfig {
        certificateChain: certificateChain, privateKey: privateKey, alpn: alpn, requireSni: false,
        serverNames: names, cipherSuites: Suites.All(), groups: [Wire.GroupX25519(), Wire.GroupSecp256r1()],
        quic: false, quicTransportParameters: Slice.New(0_i64),
    };
}

pub Blob[] Chain1(u8[] leaf) {
    mut Blob[] chain = Array.Empty<Blob>();
    Array.Append<Blob>(chain, Blob { data: leaf });
    return chain;
}

pub CertificateVerification AcceptAnyCertificateForTestsOnly() { return CertificateVerification::DangerousAcceptAnyCertificate; }

/// True for an IPv4 dotted quad or an IPv6 literal (contains ':').
pub bool IsIpLiteral(string name) {
    if String.Contains(name, ":") { return true; }
    i64 n = String.Len(name);
    if n == 0_i64 { return false; }
    mut i64 i = 0_i64;
    while i < n {
        u8 c = String.ByteAt(name, i);
        if !(c == 46_u8 || (c >= 48_u8 && c <= 57_u8)) { return false; }
        i = i + 1_i64;
    }
    return true;
}
