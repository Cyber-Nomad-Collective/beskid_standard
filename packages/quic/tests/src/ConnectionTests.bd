}

// In-memory client/server connections exchanging datagrams with a simulated clock.
mod InMemoryTests
{
    test HandshakeAndStreamEchoInMemory {
        QuicConfig cfg = QuicConfig.InsecureLoopbackForTestsOnly(Protocols(), 0_i64);
        mut i64 now = 1000000000_i64;
        Connection client = QuicConnection.NewClient(cfg, now);
        Assert.Equal<i64>(QuicConnection.BuildDatagram(client, now), 1200_i64, "padded client Initial");
        Connection server = Server(cfg, client, now);
        QuicConnection.OnDatagram(server, QuicWire.CopyOf(client.out, 0_i64, 1200_i64), 1200_i64, now);
        Exchange(server, client, now);
        Assert.True(QuicConnection.IsEstablished(client), "client established");
        Assert.True(QuicConnection.IsEstablished(server), "server established");
        Assert.True(QuicConnection.IsHandshakeConfirmed(client), "client confirmed by HANDSHAKE_DONE");
        Assert.Equal<string>(QuicConnection.Alpn(client), "hq-interop", "ALPN");
        i64 id = QuicConnection.OpenStream(client, true);
        Assert.Equal<i64>(id, 0_i64, "first client bidi stream");
        u8[] hello = Bytes("hello quic");
        Assert.Equal<i64>(QuicConnection.StreamWrite(client, id, hello, 0_i64, 10_i64), 10_i64, "buffered");
        Assert.True(QuicConnection.StreamFinish(client, id), "fin");
        now = now + 1000000_i64;
        Exchange(client, server, now);
        i64 accepted = QuicConnection.AcceptStream(server);
        Assert.Equal<i64>(accepted, 0_i64, "server accepts stream 0");
        u8[] got = Slice.New(64_i64);
        Assert.Equal<i64>(QuicConnection.StreamRead(server, accepted, got, 0_i64, 64_i64), 10_i64, "server reads");
        Assert.True(QuicConnection.StreamAtEnd(server, accepted), "fin received");
        Assert.Equal<i64>(QuicConnection.StreamWrite(server, accepted, got, 0_i64, 10_i64), 10_i64, "echo");
        QuicConnection.StreamFinish(server, accepted);
        now = now + 1000000_i64;
        Exchange(server, client, now);
        u8[] back = Slice.New(64_i64);
        Assert.Equal<i64>(QuicConnection.StreamRead(client, id, back, 0_i64, 64_i64), 10_i64, "client reads echo");
        Assert.True(QuicWire.Equal(QuicWire.CopyOf(back, 0_i64, 10_i64), hello), "echo matches");
        Assert.True(QuicConnection.StreamAtEnd(client, id), "echo fin");
        QuicConnection.Close(client, 0_i64, now);
        Exchange(client, server, now);
        Assert.True(QuicConnection.IsClosingOrClosed(server), "server draining after CONNECTION_CLOSE");
    }
}

// In-memory connections under Retry, loss, flow control, key update, version negotiation
// and idle timeout, with a simulated clock. One test keeps codegen to one pass.
mod RecoveryFlowTests
{
    test RetryLossFlowControlKeyUpdateAndTimeouts {
        QuicConfig cfg = QuicConfig.WithIdleTimeout(QuicConfig.InsecureLoopbackForTestsOnly(["h3"], 2_i64), 3000_i64);
        mut i64 now = 5000000000_i64;
        // Retry (RFC 9000 section 8.1): the client restarts with the token and the new ID.
        Connection client = QuicConnection.NewClient(cfg, now);
        i64 first = QuicConnection.BuildDatagram(client, now);
        Header h = QuicPacket.ParseHeader(client.out, 0_i64, first, 0_i64);
        u8[] retryScid = Hex.Of("a1a2a3a4a5a6a7a8");
        u8[] retry = QuicProtection.BuildRetry(h.dcid, h.scid, retryScid, Hex.Of("746f6b"));
        QuicConnection.OnDatagram(client, retry, Slice.Len(retry), now);
        Assert.True(QuicConnection.Retried(client), "Retry accepted");
        i64 second = QuicConnection.BuildDatagram(client, now);
        Assert.Equal<i64>(second, 1200_i64, "Initial resent");
        Header h2 = QuicPacket.ParseHeader(client.out, 0_i64, second, 0_i64);
        Assert.True(QuicWire.Equal(h2.dcid, retryScid), "new destination ID");
        Assert.Equal<string>(Hex.Encode(h2.token), "746f6b", "token echoed");
        Connection server = QuicConnection.NewServer(cfg, h2.dcid, h2.scid, h.dcid, retryScid, now);
        QuicConnection.OnDatagram(server, QuicWire.CopyOf(client.out, 0_i64, second), second, now);
        // Loss: the server's first flight never arrives; the client's PTO recovers.
        PumpDropping(server, client, now, 8_i64);
        now = Settle(client, server, now, 60_i64);
        Assert.True(QuicConnection.IsHandshakeConfirmed(client), "handshake completes after loss");
        Assert.True(QuicConnection.IsEstablished(server), "server established");
        Assert.True(QuicConnection.AddressValidated(server), "address validated by Retry");
        // Flow control: 20000 bytes through 8 KiB stream windows.
        i64 id = QuicConnection.OpenStream(client, true);
        u8[] chunk = Slice.New(1000_i64);
        u8[] sink = Slice.New(4096_i64);
        mut i64 written = 0_i64;
        mut i64 received = 0_i64;
        mut i64 sid = -1_i64;
        mut bool ok = true;
        mut i64 guard = 0_i64;
        while (written < 20000_i64 || received < 20000_i64) && guard < 400_i64 {
            if written < 20000_i64 {
                mut i64 k = 0_i64;
                while k < 1000_i64 { chunk[k] = u8((written + k) & 255_i64); k = k + 1_i64; }
                i64 n = QuicConnection.StreamWrite(client, id, chunk, 0_i64, 1000_i64);
                if n > 0_i64 { written = written + n; }
                if written == 20000_i64 { QuicConnection.StreamFinish(client, id); }
            }
            now = now + 1000000_i64;
            PumpDropping(client, server, now, 0_i64);
            PumpDropping(server, client, now, 0_i64);
            if sid < 0_i64 { sid = QuicConnection.AcceptStream(server); }
            if sid >= 0_i64 {
                i64 got = QuicConnection.StreamRead(server, sid, sink, 0_i64, 4096_i64);
                mut i64 j = 0_i64;
                while j < got {
                    if i64(sink[j]) != ((received + j) & 255_i64) { ok = false; }
                    j = j + 1_i64;
                }
                if got > 0_i64 { received = received + got; }
            }
            guard = guard + 1_i64;
        }
        Assert.Equal<i64>(received, 20000_i64, "all bytes delivered");
        Assert.True(ok, "bytes in order");
        Assert.True(QuicConnection.StreamAtEnd(server, sid), "fin delivered");
        // Key update initiated by the client, then data in both directions.
        now = Settle(client, server, now, 20_i64);
        Assert.True(QuicConnection.InitiateKeyUpdate(client), "key update allowed");
        i64 id2 = QuicConnection.OpenStream(client, true);
        QuicConnection.StreamWrite(client, id2, chunk, 0_i64, 100_i64);
        QuicConnection.StreamFinish(client, id2);
        now = Settle(client, server, now + 1000000_i64, 20_i64);
        i64 sid2 = QuicConnection.AcceptStream(server);
        Assert.Equal<i64>(QuicConnection.StreamRead(server, sid2, sink, 0_i64, 4096_i64), 100_i64, "data after key update");
        Assert.Equal<i64>(QuicConnection.KeyUpdates(server), 1_i64, "server followed the key update");
        Assert.Equal<i64>(QuicConnection.KeyUpdates(client), 1_i64, "client updated once");
        // Idle timeout: no traffic for longer than 3 s closes both silently.
        now = now + 10000000000_i64;
        QuicConnection.OnTimeout(client, now);
        QuicConnection.OnTimeout(server, now);
        Assert.True(QuicConnection.IsClosed(client), "client idle-closed");
        Assert.True(QuicConnection.IsClosed(server), "server idle-closed");
        Assert.Equal<i64>(QuicErrors.WireCode(QuicConnection.Error(client)), 1_i64, "idle timeout is not a peer close");
        // Version negotiation without version 1 ends a fresh client attempt.
        Connection other = QuicConnection.NewClient(cfg, now);
        i64 n3 = QuicConnection.BuildDatagram(other, now);
        Header h3 = QuicPacket.ParseHeader(other.out, 0_i64, n3, 0_i64);
        Writer w = QuicWire.NewWriter(Slice.New(64_i64), 0_i64, 64_i64);
        QuicWire.PutByte(w, 128_i64);
        QuicWire.PutUint(w, 4_i64, 0_i64);
        QuicWire.PutByte(w, 8_i64);
        QuicWire.PutAll(w, h3.scid);
        QuicWire.PutByte(w, 8_i64);
        QuicWire.PutAll(w, h3.dcid);
        QuicWire.PutUint(w, 4_i64, 0xff00001d_i64);
        QuicConnection.OnDatagram(other, w.buf, QuicWire.WPos(w), now);
        Assert.True(QuicConnection.IsClosed(other), "version negotiation failure");
    }
}

// Flow-control credit under loss, in memory with a simulated clock (WEB7).
// RFC 9000 section 13.3: a lost MAX_DATA or MAX_STREAM_DATA is sent again with the current
// limit. RFC 9002 section 6.2: a PTO sends an ack-eliciting probe, so a lost credit frame
// that is the last packet in flight is still recovered. The receiver below loses the first
// copy of every credit update it sends; the sender must not stall.
mod CreditLossTests
{
    test LostCreditFramesDoNotStallTheSender {
        // 8 KiB stream windows and a 64 KiB connection window: 100 KB needs both
        // MAX_STREAM_DATA and MAX_DATA updates.
        QuicConfig cfg = QuicConfig.InsecureLoopbackForTestsOnly(["h3"], 0_i64);
        mut i64 now = 1000000000_i64;
        i64 start = now;
        Connection client = QuicConnection.NewClient(cfg, now);
        i64 first = QuicConnection.BuildDatagram(client, now);
        Header h = QuicPacket.ParseHeader(client.out, 0_i64, first, 0_i64);
        Connection server = QuicConnection.NewServer(cfg, h.dcid, h.scid, h.dcid, Slice.New(0_i64), now);
        QuicConnection.OnDatagram(server, QuicWire.CopyOf(client.out, 0_i64, first), first, now);
        i64[] cs = [0_i64, 0_i64];
        i64[] sc = [0_i64, 0_i64];
        mut i64 r = 0_i64;
        while r < 20_i64 {
            now = now + 1000000_i64;
            PumpLosingCredit(server, client, now, false, 0_i64, sc);
            PumpLosingCredit(client, server, now, false, 0_i64, cs);
            r = r + 1_i64;
        }
        Assert.True(QuicConnection.IsHandshakeConfirmed(client), "handshake confirmed");
        i64 id = QuicConnection.OpenStream(client, true);
        Assert.True(id >= 0_i64, "stream opened");
        u8[] chunk = Slice.New(1500_i64);
        u8[] sink = Slice.New(4096_i64);
        mut i64 written = 0_i64;
        mut i64 received = 0_i64;
        mut i64 sid = -1_i64;
        mut bool ordered = true;
        mut bool dropCredit = false;
        mut i64 guard = 0_i64;
        while received < TotalBytes() && guard < 20000_i64 && now - start < 60000000000_i64 {
            mut i64 progress = 0_i64;
            if written < TotalBytes() {
                mut i64 want = TotalBytes() - written;
                if want > 1500_i64 { want = 1500_i64; }
                mut i64 k = 0_i64;
                while k < want { chunk[k] = PatternAt(written + k); k = k + 1_i64; }
                i64 n = QuicConnection.StreamWrite(client, id, chunk, 0_i64, want);
                if n > 0_i64 { written = written + n; progress = progress + n; }
                if written == TotalBytes() { QuicConnection.StreamFinish(client, id); }
            }
            // Every 7th client datagram is lost as well (data and ACKs).
            progress = progress + PumpLosingCredit(client, server, now, false, 7_i64, cs);
            if sid < 0_i64 { sid = QuicConnection.AcceptStream(server); }
            if sid >= 0_i64 {
                i64 got = QuicConnection.StreamRead(server, sid, sink, 0_i64, 4096_i64);
                mut i64 j = 0_i64;
                while j < got {
                    if sink[j] != PatternAt(received + j) { ordered = false; }
                    j = j + 1_i64;
                }
                if got > 0_i64 { received = received + got; progress = progress + got; dropCredit = true; }
            }
            // The first flight after each read carries the credit update: it is lost.
            i64 out = PumpLosingCredit(server, client, now, dropCredit, 0_i64, sc);
            if out > 0_i64 { dropCredit = false; }
            progress = progress + out;
            if progress == 0_i64 {
                i64 t = Earliest(client, server, now);
                if t > now { now = t; }
            } else {
                now = now + 1000000_i64;
            }
            QuicConnection.OnTimeout(client, now);
            QuicConnection.OnTimeout(server, now);
            guard = guard + 1_i64;
        }
        Assert.Equal<i64>(received, TotalBytes(), "all bytes delivered despite lost credit frames");
        Assert.True(ordered, "bytes in order");
        Assert.True(sc[1] > 0_i64 && cs[1] > 0_i64, "datagrams were lost in both directions");
        // Each lost credit update costs about one probe timeout; 100 KB must not take
        // anywhere near the 10 s HTTP/3 write timeout of simulated time.
        i64 elapsedMillis = (now - start) / 1000000_i64;
        Assert.True(elapsedMillis < 5000_i64, "transfer finished in bounded simulated time");
    }
}

// A Beskid QUIC client and server over UDP on 127.0.0.1: Retry address validation, the
// handshake, a bidirectional stream echo and connection close, with one driver fiber per
// endpoint.
mod UdpLoopbackTests
{
    test RetryHandshakeEchoAndClose {
        Fiber<i64> scenario = spawn RetryScenario();
        i64 result = match scenario.Join() { Result::Ok(v) => v, Result::Error(_) => -1_i64, };
        Assert.Equal<i64>(result, 0_i64, "loopback scenario");
    }
}

// A Beskid QUIC client and server over UDP on 127.0.0.1 with the TLS 1.3 handshake
// (RFC 9001): handshake, ALPN, a bidirectional stream echo and connection close.
mod TlsLoopbackTests
{
    test HandshakeEchoAndClose {
        Fiber<i64> scenario = spawn TlsScenario();
        i64 result = match scenario.Join() { Result::Ok(v) => v, Result::Error(_) => -1_i64, };
        Assert.Equal<i64>(result, 0_i64, "TLS loopback scenario");
    }
}
