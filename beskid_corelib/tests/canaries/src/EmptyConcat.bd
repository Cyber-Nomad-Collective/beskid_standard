/// Canary: Concatenating two empty strings yields a valid empty string.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.String;

test empty_plus_empty_concatenation {
    string a = "";
    string joined = a + "";
    Assert.True(String.Len(joined) == 0, "empty concatenation length");
    Assert.True(joined + "x" == "x", "empty concatenation stays usable");
}
