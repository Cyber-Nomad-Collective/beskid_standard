// A member body of a generic type is judged against the type's own parameters: `Second`
// declares `A` and returns the `B` field (beskid-lings milestone 3).
pub type Pair<A, B>
{
    A first;
    B second;

    pub A Second()
    {
        return this.second;
    }
}

pub unit Trigger()
{
    Pair<string, string> pair = Pair<string, string> { first: "one", second: "two" };
    pair.Second();
    return;
}
