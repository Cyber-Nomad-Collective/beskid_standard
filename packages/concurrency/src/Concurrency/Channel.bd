/// FIFO channel for cross-fiber communication.
use Concurrency.ChannelError;
use Concurrency.ChannelOptions;
use Concurrency.Status;
use Concurrency.TryResult;
use Core.Results;

/// Success marker for [`Send`] / [`TrySend`] (`Result<SendOk, ChannelError>` per platform spec `Result<(), _>`).
pub type SendOk {
}

/// Opaque channel handle (move-only at language layer).
pub type Channel<T> {
    i64 handle,
}

/// Runtime queue id for `Hub.Register` and builtins.
pub i64 Handle<T>(Channel<T> self) {
    return self.handle;
}

/// Creates an unbounded channel (default per platform spec).
pub Channel<T> Create<T>() {
    return CreateWithOptions<T>(ChannelOptions.Default());
}

/// Creates a channel with explicit options.
pub Channel<T> CreateWithOptions<T>(ChannelOptions options) {
    i64 capacity = ChannelOptions.EncodeCapacity(options);
    i64 flags = ChannelOptions.EncodeFlags(options);
    i64 handle = __channel_create(capacity, flags);
    return Channel<T> { handle: handle };
}

/// Sends a value; parks the current fiber when the queue is full (bounded + wait mode).
pub Core.Results.Result<SendOk, ChannelError> Send<T>(Channel<T> self, T value) {
    i64 raw = __channel_send(self.handle, value);
    return MapSendStatus(Status.FromCode(raw));
}

/// Receives a value; parks when empty and open.
pub Core.Results.Result<T, ChannelError> Receive<T>(Channel<T> self) {
    i64 raw = __channel_receive(self.handle);
    Status status = Status.FromCode(raw);
    return match status {
        Status::Ok => Results.Success<T, ChannelError>(__channel_receive_value(self.handle)),
        _ => Results.Failure<T, ChannelError>(MapReceiveError(status)),
    };
}

/// Non-blocking send; `WouldBlock` when full, `Err` on close or cancel.
pub TryResult<SendOk, ChannelError> TrySend<T>(Channel<T> self, T value) {
    i64 raw = __channel_try_send(self.handle, value);
    return MapTrySendStatus(Status.FromCode(raw));
}

/// Non-blocking receive; `WouldBlock` when empty, `Err` on close or cancel.
pub TryResult<T, ChannelError> TryReceive<T>(Channel<T> self) {
    mut i64 value = 0;
    i64 raw = __channel_try_receive(self.handle, value);
    return MapTryReceiveStatus<T>(Status.FromCode(raw), value);
}

/// Idempotent writer shutdown.
pub unit Close<T>(Channel<T> self) {
    __channel_close(self.handle);
    return;
}

pub Core.Results.Result<SendOk, ChannelError> MapSendStatus(Status status) {
    return match status {
        Status::Ok => Results.Success<SendOk, ChannelError>(SendOk { }),
        Status::Closed(endpoint) => Results.Failure<SendOk, ChannelError>(ChannelError::Closed(endpoint)),
        Status::Cancelled(reason) => Results.Failure<SendOk, ChannelError>(ChannelError::Cancelled(reason)),
        _ => Results.Failure<SendOk, ChannelError>(ChannelError::Closed(0)),
    };
}

pub ChannelError MapReceiveError(Status status) {
    return match status {
        Status::Cancelled(reason) => ChannelError::Cancelled(reason),
        Status::Closed(endpoint) => ChannelError::Closed(endpoint),
        _ => ChannelError::Closed(0),
    };
}

pub TryResult<SendOk, ChannelError> MapTrySendStatus(Status status) {
    return match status {
        Status::Ok => TryResult::Ok(SendOk { }),
        Status::WouldBlock => TryResult::WouldBlock,
        Status::Closed(endpoint) => TryResult::Err(ChannelError::Closed(endpoint)),
        Status::Cancelled(reason) => TryResult::Err(ChannelError::Cancelled(reason)),
        _ => TryResult::WouldBlock,
    };
}

pub TryResult<T, ChannelError> MapTryReceiveStatus<T>(Status status, i64 value) {
    return match status {
        Status::Ok => TryResult::Ok(value),
        Status::WouldBlock => TryResult::WouldBlock,
        Status::Cancelled(reason) => TryResult::Err(ChannelError::Cancelled(reason)),
        Status::Closed(endpoint) => TryResult::Err(ChannelError::Closed(endpoint)),
        _ => TryResult::WouldBlock,
    };
}
