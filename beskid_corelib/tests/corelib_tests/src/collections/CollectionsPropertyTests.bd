/// Seeded property and model-based tests for sorting, hash maps, and the priority queue.
/// A 64-bit linear congruential generator keeps every run reproducible.

use Testing.Expect;
use Core.Collections.Array;
use Core.Collections.Hash;
use Core.Collections.HashTable;
use Core.Collections.I64Map;
use Core.Collections.Map;
use Core.Collections.PriorityQueue;
use Core.Collections.Sort;
use Core.Collections.StringMap;
use Core.Optional.Option;

/// Advances the generator state.
i64 Next(i64 state) {
    return state * 6364136223846793005_i64 + 1442695040888963407_i64;
}

/// A value in `0..bound` drawn from the high bits of `state`.
i64 Below(i64 state, i64 bound) {
    return Hash.ShiftRightLogical(state, 33) % bound;
}

i64 OptionOr(Option<i64> value, i64 fallback) {
    return match value {
        Option::Some(v) => v,
        Option::None => fallback,
    };
}

/// Counts occurrences of `value` in `values`.
i64 Occurrences(i64[] values, i64 value) {
    mut i64 n = 0;
    mut i64 i = 0;
    while i < Array.Len<i64>(values) {
        if Array.Get<i64>(values, i) == value {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

test sort_is_ordered_permutation_and_stable {
    mut i64 state = 20261007;
    mut i64 round = 0;
    while round < 150 {
        state = Next(state);
        i64 length = Below(state, 40);
        mut i64[] values = Array.Empty<i64>();
        mut i64[] positions = Array.Empty<i64>();
        mut i64 i = 0;
        while i < length {
            state = Next(state);
            values = Array.Append<i64>(values, Below(state, 21) - 10);
            positions = Array.Append<i64>(positions, i);
            i = i + 1;
        }
        i64[] sorted = Sort.I64(values);
        Expect.EqualI64(Array.Len<i64>(sorted), length, "length preserved");
        Expect.EqualBool(Sort.IsSortedI64(sorted), true, "ascending");
        mut i64 v = -10;
        while v <= 10 {
            Expect.EqualI64(Occurrences(sorted, v), Occurrences(values, v), "same multiset");
            v = v + 1;
        }
        // Stability: positions sorted by value keep ascending order within equal values.
        i64[] order = Sort.ByI64Key<i64>(positions, values);
        mut i64 k = 1;
        while k < length {
            i64 previous = Array.Get<i64>(order, k - 1);
            i64 current = Array.Get<i64>(order, k);
            if Array.Get<i64>(values, previous) == Array.Get<i64>(values, current) {
                Expect.EqualBool(previous < current, true, "equal keys keep input order");
            }
            k = k + 1;
        }
        round = round + 1;
    }
}

test binary_search_agrees_with_linear_scan {
    mut i64 state = 7;
    mut i64[] values = Array.Empty<i64>();
    mut i64 i = 0;
    while i < 60 {
        state = Next(state);
        values = Array.Append<i64>(values, Below(state, 200));
        i = i + 1;
    }
    i64[] sorted = Sort.I64(values);
    mut i64 probe = -5;
    while probe < 205 {
        i64 found = Sort.BinarySearchI64(sorted, probe);
        if Occurrences(sorted, probe) > 0 {
            Expect.EqualI64(Array.Get<i64>(sorted, found), probe, "found index holds probe");
        } else {
            i64 insertion = 0 - found - 1;
            Expect.EqualBool(insertion >= 0 && insertion <= Array.Len<i64>(sorted), true, "insertion point in range");
            if insertion > 0 {
                Expect.EqualBool(Array.Get<i64>(sorted, insertion - 1) < probe, true, "left neighbour smaller");
            }
            if insertion < Array.Len<i64>(sorted) {
                Expect.EqualBool(Array.Get<i64>(sorted, insertion) > probe, true, "right neighbour larger");
            }
        }
        probe = probe + 1;
    }
}

test string_map_matches_linear_map_model {
    mut StringMap<i64> fast = StringMap.New<i64>();
    mut Map<string, i64> model = Map.New<string, i64>();
    mut i64 state = 42;
    mut i64 step = 0;
    while step < 1500 {
        state = Next(state);
        string key = "k${Below(state, 40)}";
        state = Next(state);
        i64 op = Below(state, 10);
        if op < 5 {
            fast = fast.Insert(key, step);
            model = model.Insert(key, step);
        } else {
            if op < 8 {
                fast = fast.Remove(key);
                model = model.Remove(key);
            }
        }
        Expect.EqualI64(fast.Count(), model.Count(), "same size");
        Expect.EqualBool(fast.ContainsKey(key), model.ContainsKey(key), "same membership");
        Expect.EqualI64(OptionOr(fast.Get(key), -1), OptionOr(model.TryGet(key), -1), "same value");
        step = step + 1;
    }
    string[] keys = model.Keys();
    mut i64 i = 0;
    while i < Array.Len<string>(keys) {
        string key = Array.Get<string>(keys, i);
        Expect.EqualI64(OptionOr(fast.Get(key), -1), OptionOr(model.TryGet(key), -1), "final contents agree");
        i = i + 1;
    }
    Expect.EqualI64(Array.Len<string>(fast.Keys()), Array.Len<string>(keys), "same key count");
}

test i64_map_matches_linear_map_model {
    mut I64Map<i64> fast = I64Map.New<i64>();
    mut Map<i64, i64> model = Map.New<i64, i64>();
    mut i64 state = 99;
    mut i64 step = 0;
    while step < 1500 {
        state = Next(state);
        i64 key = Below(state, 61) - 30;
        state = Next(state);
        i64 op = Below(state, 10);
        if op < 5 {
            fast = fast.Insert(key, step);
            model = model.Insert(key, step);
        } else {
            if op < 8 {
                fast = fast.Remove(key);
                model = model.Remove(key);
            }
        }
        Expect.EqualI64(fast.Count(), model.Count(), "same size");
        Expect.EqualI64(OptionOr(fast.Get(key), -1), OptionOr(model.TryGet(key), -1), "same value");
        step = step + 1;
    }
}

test hash_table_survives_total_collision {
    // Every key shares one hash, so all entries sit on a single probe chain.
    mut HashTable<string, i64> table = HashTable.New<string, i64>();
    mut i64 i = 0;
    while i < 40 {
        table = HashTable.Insert<string, i64>(table, "c${i}", 7, i);
        i = i + 1;
    }
    Expect.EqualI64(HashTable.Size<string, i64>(table), 40, "all inserted");
    i = 0;
    while i < 40 {
        if i % 3 == 0 {
            table = HashTable.Remove<string, i64>(table, "c${i}", 7);
        }
        i = i + 1;
    }
    i = 0;
    while i < 40 {
        mut i64 expected = i;
        if i % 3 == 0 {
            expected = -1;
        }
        Expect.EqualI64(HashTable.GetOr<string, i64>(table, "c${i}", 7, -1), expected, "chain lookup after removals");
        i = i + 1;
    }
    table = HashTable.Remove<string, i64>(table, "c39", 7);
    table = HashTable.Insert<string, i64>(table, "fresh", 7, 1000);
    Expect.EqualI64(HashTable.GetOr<string, i64>(table, "fresh", 7, -1), 1000, "insert reuses deleted slot");
    Expect.EqualI64(HashTable.GetOr<string, i64>(table, "c38", 7, -1), 38, "neighbour intact");
}

test hash_table_remove_cycles_keep_size_bounded {
    mut StringMap<i64> map = StringMap.New<i64>();
    mut i64 round = 0;
    while round < 30 {
        mut i64 i = 0;
        while i < 20 {
            map = map.Insert("r${i}", round);
            i = i + 1;
        }
        i = 0;
        while i < 20 {
            map = map.Remove("r${i}");
            i = i + 1;
        }
        round = round + 1;
    }
    Expect.EqualI64(map.Count(), 0, "empty after cycles");
    map = map.Insert("last", 1);
    Expect.EqualI64(OptionOr(map.Get("last"), -1), 1, "usable after cycles");
}

test priority_queue_matches_reference_under_interleaving {
    mut PriorityQueue<i64> queue = PriorityQueue.New<i64>();
    mut i64[] refPriority = Array.Empty<i64>();
    mut i64[] refValue = Array.Empty<i64>();
    mut i64 state = 5;
    mut i64 serial = 0;
    mut i64 step = 0;
    while step < 600 {
        state = Next(state);
        bool push = Below(state, 3) != 0 || Array.Len<i64>(refValue) == 0;
        if push {
            state = Next(state);
            i64 priority = Below(state, 8);
            queue = queue.Push(serial, priority);
            refPriority = Array.Append<i64>(refPriority, priority);
            refValue = Array.Append<i64>(refValue, serial);
            serial = serial + 1;
        } else {
            // Reference minimum: lowest priority, earliest insertion (smallest serial).
            mut i64 best = 0;
            mut i64 i = 1;
            while i < Array.Len<i64>(refValue) {
                i64 p = Array.Get<i64>(refPriority, i);
                i64 bp = Array.Get<i64>(refPriority, best);
                if p < bp || (p == bp && Array.Get<i64>(refValue, i) < Array.Get<i64>(refValue, best)) {
                    best = i;
                }
                i = i + 1;
            }
            Expect.EqualI64(OptionOr(queue.Peek(), -1), Array.Get<i64>(refValue, best), "same minimum");
            queue = queue.Pop();
            mut i64[] nextPriority = Array.Empty<i64>();
            mut i64[] nextValue = Array.Empty<i64>();
            i = 0;
            while i < Array.Len<i64>(refValue) {
                if i != best {
                    nextPriority = Array.Append<i64>(nextPriority, Array.Get<i64>(refPriority, i));
                    nextValue = Array.Append<i64>(nextValue, Array.Get<i64>(refValue, i));
                }
                i = i + 1;
            }
            refPriority = nextPriority;
            refValue = nextValue;
        }
        Expect.EqualI64(queue.Count(), Array.Len<i64>(refValue), "same size");
        step = step + 1;
    }
}
