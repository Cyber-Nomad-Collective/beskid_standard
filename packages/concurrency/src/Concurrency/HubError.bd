/// Errors from `Hub.WaitReceive`.
/// @variant(Limit) Registration cap exceeded; carries cap and attempted index.
/// @variant(Cancelled) Waiting fiber was cancelled; carries a cancel reason.
/// @variant(Closed) Member channel(s) closed; carries the member index, or -1 when no member is named (an empty or unknown hub).
/// @variant(Unexpected) The runtime returned a status outside the hub contract; carries the raw status code.
pub enum HubError {
    Limit(i64 cap, i64 attemptedIndex),
    Cancelled(i64 reason),
    Closed(i64 memberIndex),
    Unexpected(i64 code),
}
