/// Canary: An enum variant passed directly as a method argument (`h.Pick(Option::None)`) lowers.
/// Binding the variant to a local first works. Fails on 0.5.3; passes once the gap is fixed.

use Testing.Assert;
use Core.Optional.Option;

pub type Holder {
    i64 n,

    pub i64 Pick(Option<i64> other) {
        return match other {
            Option::Some(v) => v,
            Option::None => this.n,
        };
    }
}

test enum_variant_passed_inline_to_method {
    Holder h = Holder { n: 1 };
    Assert.True(h.Pick(Option::None) == 1, "inline Option::None argument");
}
