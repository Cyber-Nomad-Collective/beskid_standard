use Core.Results;
use Core.String;
use Core.Serialization.Errors;

/// Complete canonical wire identity; descriptor registration additionally
/// validates its full locked package/type/generic/version signature.
pub type ShapeId {
    string hex,
}

pub Result<ShapeId, SerializationError> ParseShapeId(string digest) {
    if (String.Len(digest) != 64_i64) {
        return Result::Error(Errors.Diagnostic("InvalidShapeId", "shape", -1_i64, -1_i64, false, -1_i64, -1_i64));
    }
    mut i64 index = 0_i64;
    while (index < 64_i64) {
        u8 byte = String.ByteAt(digest, index);
        if (!((byte >= 48_u8 && byte <= 57_u8) || (byte >= 97_u8 && byte <= 102_u8))) {
            return Result::Error(Errors.Diagnostic("InvalidShapeId", "shape", -1_i64, -1_i64, false, -1_i64, -1_i64));
        }
        index = index + 1_i64;
    }
    return Result::Ok(ShapeId { hex: digest });
}

pub string FormatShapeId(ShapeId shape) {
    return shape.hex;
}
