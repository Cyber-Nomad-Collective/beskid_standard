web_tests {
  name = "web_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "WebSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "WebPlain" { kind = Lib entry = "WebPlainTests.bd" }
target "WebHttpsH1" { kind = Lib entry = "WebHttpsH1Tests.bd" }
target "WebHttpsH2" { kind = Lib entry = "WebHttpsH2Tests.bd" }
