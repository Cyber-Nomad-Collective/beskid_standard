/// Core.Collections.StringMap — hash map from `string` keys to values, with expected O(1)
/// lookup, insertion, and removal.
/// @tier(supported)
/// Keys compare by value and hash with FNV-1a. Iteration order is insertion order until the first
/// removal. `Insert` and `Remove` change the map in place.
use Core.Collections.Hash;
use Core.Collections.HashTable;
use Core.Optional.Option;

[Isolated]
pub type StringMap<V>
{
    HashTable<string, V> table;

    /// Number of entries.
    pub i64 Count()
    {
        return HashTable.Size<string, V>(this.table);
    }

    /// Returns true when the map has no entries.
    pub bool IsEmpty()
    {
        return HashTable.Size<string, V>(this.table) == 0;
    }

    /// Returns true when `key` is present.
    pub bool ContainsKey(string key)
    {
        return HashTable.Contains<string, V>(this.table, key, Hash.String(key));
    }

    /// Returns the value for `key`, or `None` when absent.
    pub Option<V> Get(string key)
    {
        return HashTable.Get<string, V>(this.table, key, Hash.String(key));
    }

    /// Returns the value for `key`, or `fallback` when absent.
    pub V GetOr(string key, V fallback)
    {
        return HashTable.GetOr<string, V>(this.table, key, Hash.String(key), fallback);
    }

    /// Inserts or replaces the value for `key`.
    pub unit Insert(mut this, string key, V value)
    {
        HashTable.Insert<string, V>(this.table, key, Hash.String(key), value);
        return;
    }

    /// Removes `key`; returns false when it is absent.
    pub bool Remove(mut this, string key)
    {
        return HashTable.Remove<string, V>(this.table, key, Hash.String(key));
    }

    /// Copies the keys in iteration order.
    pub string[] Keys()
    {
        return HashTable.Keys<string, V>(this.table);
    }

    /// Copies the values in the same order as `Keys()`.
    pub V[] Values()
    {
        return HashTable.Values<string, V>(this.table);
    }
}

/// Creates an empty map.
pub StringMap<V> New<V>()
{
    return StringMap<V>
    {
        table: HashTable.New<string, V>(),
    };
}
