use Core.Collections.Array;
use Http2.Hpack;

// RFC 9204 Appendix A: the 99-entry QPACK static table (index 0..98).

pub i64 StaticCount() { return 99_i64; }

/// The static table, built once and held by an encoder or decoder.
pub HeaderField[] StaticEntries() {
    mut HeaderField[] out = Array.Empty<HeaderField>();
    Array.Append<HeaderField>(out, Hpack.Field(":authority", ""));
    Array.Append<HeaderField>(out, Hpack.Field(":path", "/"));
    Array.Append<HeaderField>(out, Hpack.Field("age", "0"));
    Array.Append<HeaderField>(out, Hpack.Field("content-disposition", ""));
    Array.Append<HeaderField>(out, Hpack.Field("content-length", "0"));
    Array.Append<HeaderField>(out, Hpack.Field("cookie", ""));
    Array.Append<HeaderField>(out, Hpack.Field("date", ""));
    Array.Append<HeaderField>(out, Hpack.Field("etag", ""));
    Array.Append<HeaderField>(out, Hpack.Field("if-modified-since", ""));
    Array.Append<HeaderField>(out, Hpack.Field("if-none-match", ""));
    Array.Append<HeaderField>(out, Hpack.Field("last-modified", ""));
    Array.Append<HeaderField>(out, Hpack.Field("link", ""));
    Array.Append<HeaderField>(out, Hpack.Field("location", ""));
    Array.Append<HeaderField>(out, Hpack.Field("referer", ""));
    Array.Append<HeaderField>(out, Hpack.Field("set-cookie", ""));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "CONNECT"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "DELETE"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "GET"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "HEAD"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "OPTIONS"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "POST"));
    Array.Append<HeaderField>(out, Hpack.Field(":method", "PUT"));
    Array.Append<HeaderField>(out, Hpack.Field(":scheme", "http"));
    Array.Append<HeaderField>(out, Hpack.Field(":scheme", "https"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "103"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "200"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "304"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "404"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "503"));
    Array.Append<HeaderField>(out, Hpack.Field("accept", "*/*"));
    Array.Append<HeaderField>(out, Hpack.Field("accept", "application/dns-message"));
    Array.Append<HeaderField>(out, Hpack.Field("accept-encoding", "gzip, deflate, br"));
    Array.Append<HeaderField>(out, Hpack.Field("accept-ranges", "bytes"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-headers", "cache-control"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-headers", "content-type"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-origin", "*"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "max-age=0"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "max-age=2592000"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "max-age=604800"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "no-cache"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "no-store"));
    Array.Append<HeaderField>(out, Hpack.Field("cache-control", "public, max-age=31536000"));
    Array.Append<HeaderField>(out, Hpack.Field("content-encoding", "br"));
    Array.Append<HeaderField>(out, Hpack.Field("content-encoding", "gzip"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "application/dns-message"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "application/javascript"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "application/json"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "application/x-www-form-urlencoded"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "image/gif"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "image/jpeg"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "image/png"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "text/css"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "text/html; charset=utf-8"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "text/plain"));
    Array.Append<HeaderField>(out, Hpack.Field("content-type", "text/plain;charset=utf-8"));
    Array.Append<HeaderField>(out, Hpack.Field("range", "bytes=0-"));
    Array.Append<HeaderField>(out, Hpack.Field("strict-transport-security", "max-age=31536000"));
    Array.Append<HeaderField>(out, Hpack.Field("strict-transport-security", "max-age=31536000; includesubdomains"));
    Array.Append<HeaderField>(out, Hpack.Field("strict-transport-security", "max-age=31536000; includesubdomains; preload"));
    Array.Append<HeaderField>(out, Hpack.Field("vary", "accept-encoding"));
    Array.Append<HeaderField>(out, Hpack.Field("vary", "origin"));
    Array.Append<HeaderField>(out, Hpack.Field("x-content-type-options", "nosniff"));
    Array.Append<HeaderField>(out, Hpack.Field("x-xss-protection", "1; mode=block"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "100"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "204"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "206"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "302"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "400"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "403"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "421"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "425"));
    Array.Append<HeaderField>(out, Hpack.Field(":status", "500"));
    Array.Append<HeaderField>(out, Hpack.Field("accept-language", ""));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-credentials", "FALSE"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-credentials", "TRUE"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-headers", "*"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-methods", "get"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-methods", "get, post, options"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-allow-methods", "options"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-expose-headers", "content-length"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-request-headers", "content-type"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-request-method", "get"));
    Array.Append<HeaderField>(out, Hpack.Field("access-control-request-method", "post"));
    Array.Append<HeaderField>(out, Hpack.Field("alt-svc", "clear"));
    Array.Append<HeaderField>(out, Hpack.Field("authorization", ""));
    Array.Append<HeaderField>(out, Hpack.Field("content-security-policy", "script-src 'none'; object-src 'none'; base-uri 'none'"));
    Array.Append<HeaderField>(out, Hpack.Field("early-data", "1"));
    Array.Append<HeaderField>(out, Hpack.Field("expect-ct", ""));
    Array.Append<HeaderField>(out, Hpack.Field("forwarded", ""));
    Array.Append<HeaderField>(out, Hpack.Field("if-range", ""));
    Array.Append<HeaderField>(out, Hpack.Field("origin", ""));
    Array.Append<HeaderField>(out, Hpack.Field("purpose", "prefetch"));
    Array.Append<HeaderField>(out, Hpack.Field("server", ""));
    Array.Append<HeaderField>(out, Hpack.Field("timing-allow-origin", "*"));
    Array.Append<HeaderField>(out, Hpack.Field("upgrade-insecure-requests", "1"));
    Array.Append<HeaderField>(out, Hpack.Field("user-agent", ""));
    Array.Append<HeaderField>(out, Hpack.Field("x-forwarded-for", ""));
    Array.Append<HeaderField>(out, Hpack.Field("x-frame-options", "deny"));
    Array.Append<HeaderField>(out, Hpack.Field("x-frame-options", "sameorigin"));
    return out;
}

/// Index of the entry equal to `field` (name and value), or -1.
pub i64 FindExact(HeaderField[] entries, HeaderField field) {
    mut i64 i = 0_i64;
    while i < 99_i64 {
        HeaderField entry = Array.Get<HeaderField>(entries, i);
        if Hpack.BytesEqual(entry.name, field.name) && Hpack.BytesEqual(entry.value, field.value) { return i; }
        i = i + 1_i64;
    }
    return -1_i64;
}

/// Index of the first entry whose name equals `field.name`, or -1.
pub i64 FindName(HeaderField[] entries, HeaderField field) {
    mut i64 i = 0_i64;
    while i < 99_i64 {
        HeaderField entry = Array.Get<HeaderField>(entries, i);
        if Hpack.BytesEqual(entry.name, field.name) { return i; }
        i = i + 1_i64;
    }
    return -1_i64;
}
