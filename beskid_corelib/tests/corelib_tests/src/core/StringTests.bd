/// String module tests — pure string helpers, char tables, and UTF-8 rune sizing.

use Testing.Assert;
use Core.String;
use Core.Bytes.Slice;


test string_len_basic {
    Assert.Equal(String.Len("hello"), 5, "Len of \"hello\" is 5");
}

test string_is_empty {
    Assert.True(String.IsEmpty(""), "empty string is empty");
    Assert.False(String.IsEmpty("x"), "non-empty string is not empty");
}

test string_indexof_found {
    Assert.Equal(String.IndexOfFrom("hello", 0, "ll"), 2, "IndexOfFrom finds \"ll\" at 2");
}

test string_indexof_not_found {
    Assert.Equal(String.IndexOfFrom("hello", 0, "z"), -1, "IndexOfFrom returns -1 when not found");
}

test string_indexof_empty_needle_returns_start {
    Assert.Equal(String.IndexOfFrom("hello", 2, ""), 2, "empty needle returns the start index");
}

test string_contains_true_false {
    Assert.True(String.Contains("hello", "ell"), "Contains finds \"ell\"");
    Assert.False(String.Contains("hello", "xyz"), "Contains misses \"xyz\"");
}

test string_subslice {
    Assert.Equal(String.SubSlice("hello", 1, 3), "ell", "SubSlice(1,3) of \"hello\" is \"ell\"");
}

test string_trim_spaces {
    Assert.Equal(String.Trim("  hi  "), "hi", "Trim trims surrounding spaces");
}

test string_trim_empty {
    Assert.Equal(String.Trim("   "), "", "Trim of all spaces is empty");
}

test string_byte_at {
    Assert.Equal(String.ByteAt("ABC", 0), 65, "ByteAt(0) of \"ABC\" is 65");
}

test string_digit_char {
    Assert.Equal(String.DigitChar(0), "0", "DigitChar(0) is \"0\"");
    Assert.Equal(String.DigitChar(9), "9", "DigitChar(9) is \"9\"");
    Assert.Equal(String.DigitChar(10), "9", "DigitChar(10) clamps to \"9\"");
}

test string_lower_char {
    Assert.Equal(String.LowerChar(0), "a", "LowerChar(0) is \"a\"");
    Assert.Equal(String.LowerChar(25), "z", "LowerChar(25) is \"z\"");
    Assert.Equal(String.LowerChar(26), "z", "LowerChar(26) clamps to \"z\"");
}

test string_upper_char {
    Assert.Equal(String.UpperChar(0), "A", "UpperChar(0) is \"A\"");
    Assert.Equal(String.UpperChar(25), "Z", "UpperChar(25) is \"Z\"");
}

test string_utf8_rune_byte_len {
    Assert.Equal(String.Utf8RuneByteLen(65_u8), 1, "ASCII lead is 1 byte");
    Assert.Equal(String.Utf8RuneByteLen(128_u8), 0, "continuation byte is 0");
    Assert.Equal(String.Utf8RuneByteLen(192_u8), 2, "192 lead is 2 bytes");
    Assert.Equal(String.Utf8RuneByteLen(224_u8), 3, "224 lead is 3 bytes");
    Assert.Equal(String.Utf8RuneByteLen(240_u8), 4, "240 lead is 4 bytes");
}

test string_from_utf8_code_units_ascii {
    u8[] arr = Slice.New(2);
    Slice.Set(arr, 0, 72);
    Slice.Set(arr, 1, 105);
    Assert.Equal(String.FromUtf8CodeUnits(arr), "Hi", "FromUtf8CodeUnits([72,105]) is \"Hi\"");
}

test string_ordering_follows_utf8_bytes {
    string a = "a";
    string b = "b";
    string ab = "ab";
    string empty = "";
    Assert.True(a < b, "a < b");
    Assert.False(b < a, "b < a is false");
    Assert.True(b > a, "b > a");
    Assert.True(a <= a, "a <= a");
    Assert.True(a >= a, "a >= a");
    Assert.False(a < a, "a < a is false");
    Assert.True(a < ab, "a proper prefix sorts first");
    Assert.True(ab > a, "a longer string with the same prefix sorts last");
    Assert.True(empty < a, "the empty string sorts first");
    Assert.True(empty <= empty, "the empty string equals itself");
    Assert.True("Z" < "a", "ordinal order puts uppercase ASCII before lowercase");
    Assert.True("z" < "é", "a two-byte code point sorts after ASCII");
}

test string_interpolation_spells_bools {
    bool yes = true;
    bool no = false;
    Assert.Equal("${yes}", "true", "true interpolates as true");
    Assert.Equal("${no}", "false", "false interpolates as false");
    Assert.Equal("flag=${yes}/${no}", "flag=true/false", "bools inside text");
}

test string_interpolation_formats_minimum_i64 {
    i64 minimum = -9223372036854775807 - 1;
    i64 maximum = 9223372036854775807;
    i64 negative = -42;
    Assert.Equal("${minimum}", "-9223372036854775808", "minimum i64");
    Assert.Equal("${maximum}", "9223372036854775807", "maximum i64");
    Assert.Equal("${negative}", "-42", "negative i64");
}

test string_interpolation_formats_f64_as_shortest_round_trip_text {
    f64 one = 1.0;
    f64 tenth = 0.1;
    f64 sum = 0.1 + 0.2;
    f64 negative = -2.5;
    f64 plainLimit = 100000000000000000000.0;
    f64 exponentLimit = 1.0e21;
    f64 small = 0.000001;
    f64 smaller = 1.0e-7;
    f64 largest = 1.7976931348623157e308;
    f64 zero = 0.0;
    Assert.Equal("${one}", "1", "integral values print without a fraction");
    Assert.Equal("${tenth}", "0.1", "shortest digits of 0.1");
    Assert.Equal("${sum}", "0.30000000000000004", "shortest digits of 0.1 + 0.2");
    Assert.Equal("${negative}", "-2.5", "negative value");
    Assert.Equal("${plainLimit}", "100000000000000000000", "plain decimal below 1e21");
    Assert.Equal("${exponentLimit}", "1e+21", "exponent form from 1e21");
    Assert.Equal("${small}", "0.000001", "plain decimal from 1e-6");
    Assert.Equal("${smaller}", "1e-7", "exponent form below 1e-6");
    Assert.Equal("${largest}", "1.7976931348623157e+308", "largest finite f64");
    Assert.Equal("${zero}", "0", "zero");
    Assert.Equal("${zero / zero}", "NaN", "NaN");
    Assert.Equal("${one / zero}", "Infinity", "positive infinity");
    Assert.Equal("${negative / zero}", "-Infinity", "negative infinity");
}

test string_interpolation_formats_f32_through_exact_widening {
    f32 half = 1.5_f32;
    f32 tenth = 0.1_f32;
    Assert.Equal("${half}", "1.5", "an exactly representable f32");
    Assert.Equal("${tenth}", "0.10000000149011612", "an f32 prints the shortest text of its exact binary64 value");
}
