quic_tests {
  name = "quic_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "QuicSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "QuicProtection" { kind = Lib entry = "ProtectionTests.bd" }
target "QuicFrames" { kind = Lib entry = "FrameTests.bd" }
target "QuicStreams" { kind = Lib entry = "StreamTests.bd" }
target "QuicRecovery" { kind = Lib entry = "RecoveryTests.bd" }
target "QuicConnection" { kind = Lib entry = "ConnectionTests.bd" }
target "QuicConnectionStress" { kind = Lib entry = "RecoveryFlowTests.bd" }
target "QuicLoopback" { kind = Lib entry = "LoopbackTests.bd" }
target "QuicTlsLoopback" { kind = Lib entry = "TlsLoopbackTests.bd" }
target "QuicBench" { kind = Lib entry = "BenchTests.bd" }
