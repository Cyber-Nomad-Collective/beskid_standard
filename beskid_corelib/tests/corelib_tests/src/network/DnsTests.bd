use Core.Collections.Array;
use Concurrency.Fiber;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Dns;
use Testing.Assert;

unit ResolveIpv4() {
    Result<SocketAddress[], NetworkError> result = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 80_u8), Option::Some(AddressFamily::V4), Option.Empty<Deadline>());
    match result {
        Result::Error(_) => Assert.Fail("numeric IPv4 resolution must succeed"),
        Result::Ok(addresses) => {
            Assert.True(Array.Len<SocketAddress>(addresses) > 0_i64, "resolver returns all matching results");
            mut i64 index = 0_i64;
            while index < Array.Len<SocketAddress>(addresses) {
                SocketAddress address = addresses[index];
                Assert.Equal(address.port.Value(), 80_i64, "requested port survives resolution");
                Assert.True(match address.address { IpAddress::V4(_, _, _, _) => true, _ => false, }, "family filter excludes IPv6");
                index = index + 1_i64;
            }
        },
    };
}

test network_dns_ipv4_filter_preserves_typed_addresses {
    Fiber<unit> scenario = spawn ResolveIpv4();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "resolver scenario completes");
}

test network_dns_port_zero_is_rejected_before_resolving {
    Result<SocketAddress[], NetworkError> result = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 0_u8), Option::None, Option.Empty<Deadline>());
    Assert.True(match result { Result::Error(NetworkError::InvalidAddress) => true, _ => false, }, "port zero is reserved for binding");
}

unit ResolveTwice() {
    Result<SocketAddress[], NetworkError> first = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 81_u8), Option::None, Option.Empty<Deadline>());
    Result<SocketAddress[], NetworkError> second = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 82_u8), Option::None, Option.Empty<Deadline>());
    match first {
        Result::Error(_) => Assert.Fail("first independent resolver call"),
        Result::Ok(addresses) => Assert.Equal(addresses[0].port.Value(), 81_i64, "first result retains its own port"),
    };
    match second {
        Result::Error(_) => Assert.Fail("second independent resolver call"),
        Result::Ok(addresses) => Assert.Equal(addresses[0].port.Value(), 82_i64, "second call has fresh results"),
    };
}

test network_dns_repeated_calls_return_independently_owned_results {
    Fiber<unit> scenario = spawn ResolveTwice();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "independent resolver scenario completes");
}

unit ResolveWithExpiredDeadline() {
    match Deadline.After(Time.FromMilliseconds(0_i64)) {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(deadline) => {
            Result<SocketAddress[], NetworkError> result = Dns.Resolve(
                "127.0.0.1",
                Network.Types.PortBytes(0_u8, 53_u8),
                Option::Some(AddressFamily::V4),
                Option.FromValue<Deadline>(deadline)
            );
            Assert.True(match result {
                Result::Error(NetworkError::TimedOut) => true,
                _ => false,
            }, "already expired DNS deadline wins before resolver submission");
        },
    };
}

test network_dns_expired_typed_deadline_times_out_before_submission {
    Fiber<unit> scenario = spawn ResolveWithExpiredDeadline();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "DNS deadline scenario completes");
}
