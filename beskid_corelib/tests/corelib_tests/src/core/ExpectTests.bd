/// Testing.Expect passing-path coverage. A failed expectation aborts the run, so failure
/// messages are exercised manually rather than in the suite.

use Testing.Expect;
use Core.Optional.Option;
use Core.Results;

test ExpectScalars {
    Expect.Equal<i64>(2 + 2, 4, "sum");
    Expect.Equal<string>("a" + "b", "ab", "concat");
    Expect.Equal<bool>(1 < 2, true, "ordering");
    Expect.NearF64(0.1 + 0.2, 0.3, 0.000001, "float tolerance");
}

test ExpectEqualTakesEveryFormattingType
{
    Expect.Equal<u8>(200_u8, 200_u8, "u8");
    Expect.Equal<u64>(18446744073709551615_u64, 18446744073709551615_u64, "u64");
    Expect.Equal<f64>(0.5_f64, 0.5_f64, "f64");
    Expect.Equal<char>('x', 'x', "char");
    Expect.Equal(7_i32, 7_i32, "inferred i32");
}

test ExpectText {
    Expect.ContainsText("beskid corelib", "core", "substring");
    Expect.StartsWithText("beskid corelib", "besk", "prefix");
}

test ExpectArrays {
    Expect.EqualI64Array([1_i64, 2_i64], [1_i64, 2_i64], "i64 arrays");
    Expect.EqualStringArray(["x", "y"], ["x", "y"], "string arrays");
}

test ExpectOptionAndResult {
    Option<i64> some = Option::Some(1_i64);
    Option<i64> none = Option::None;
    Expect.IsSome<i64>(some, "some");
    Expect.IsNone<i64>(none, "none");
    Result<i64, string> ok = Result::Ok(1_i64);
    Result<i64, string> failed = Result::Error("no");
    Expect.IsOk<i64, string>(ok, "ok");
    Expect.IsError<i64, string>(failed, "error");
}
