/// Process module tests for the exact v0.4 current-process surface.

use Testing.Assert;
use Core.Process;

test process_id_returns_positive {
    Assert.True(Core.Process.Id() > 0, "pid should be positive");
}

test process_current_id_matches_id {
    Assert.Equal(Core.Process.CurrentId(), Core.Process.Id(), "CurrentId aliases Id");
}

test process_is_current_process_true_for_self {
    Assert.True(Core.Process.IsCurrentProcess(Core.Process.Id()), "self pid is current");
}

test process_is_current_process_false_for_other {
    Assert.False(Core.Process.IsCurrentProcess(999999), "alien pid is not current");
}
