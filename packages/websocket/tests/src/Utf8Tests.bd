use Testing.Assert;
use Core.Bytes.Slice;
use WebSocket.WsUtf8;

bool Ok(u8[] d) { return WsUtf8.IsValid(d, 0_i64, Slice.Len(d)); }

test utf8_valid_sequences {
    Assert.True(Ok(Slice.New(0_i64)), "empty");
    Assert.True(Ok([0x48_u8, 0x69_u8]), "ascii");
    Assert.True(Ok([0xC2_u8, 0x80_u8]), "U+0080");
    Assert.True(Ok([0xDF_u8, 0xBF_u8]), "U+07FF");
    Assert.True(Ok([0xE0_u8, 0xA0_u8, 0x80_u8]), "U+0800");
    Assert.True(Ok([0xED_u8, 0x9F_u8, 0xBF_u8]), "U+D7FF");
    Assert.True(Ok([0xEE_u8, 0x80_u8, 0x80_u8]), "U+E000");
    Assert.True(Ok([0xEF_u8, 0xBF_u8, 0xBF_u8]), "U+FFFF");
    Assert.True(Ok([0xF0_u8, 0x90_u8, 0x80_u8, 0x80_u8]), "U+10000");
    Assert.True(Ok([0xF4_u8, 0x8F_u8, 0xBF_u8, 0xBF_u8]), "U+10FFFF");
    // "Hello-µ@ßöäüàá-UTF-8!!" fragment from Autobahn 6.2
    Assert.True(Ok([0xCE_u8, 0xBA_u8, 0xE1_u8, 0xBD_u8, 0xB9_u8, 0xCF_u8, 0x83_u8, 0xCE_u8, 0xBC_u8, 0xCE_u8, 0xB5_u8]), "kosme");
}

test utf8_overlongs {
    Assert.False(Ok([0xC0_u8, 0xAF_u8]), "overlong slash 2");
    Assert.False(Ok([0xC1_u8, 0xBF_u8]), "overlong C1");
    Assert.False(Ok([0xE0_u8, 0x80_u8, 0xAF_u8]), "overlong slash 3");
    Assert.False(Ok([0xE0_u8, 0x9F_u8, 0xBF_u8]), "overlong U+07FF");
    Assert.False(Ok([0xF0_u8, 0x80_u8, 0x80_u8, 0xAF_u8]), "overlong slash 4");
    Assert.False(Ok([0xF0_u8, 0x8F_u8, 0xBF_u8, 0xBF_u8]), "overlong U+FFFF");
}

test utf8_surrogates_and_range {
    Assert.False(Ok([0xED_u8, 0xA0_u8, 0x80_u8]), "U+D800");
    Assert.False(Ok([0xED_u8, 0xAF_u8, 0xBF_u8]), "U+DBFF");
    Assert.False(Ok([0xED_u8, 0xB0_u8, 0x80_u8]), "U+DC00");
    Assert.False(Ok([0xED_u8, 0xBF_u8, 0xBF_u8]), "U+DFFF");
    Assert.False(Ok([0xF4_u8, 0x90_u8, 0x80_u8, 0x80_u8]), "U+110000");
    Assert.False(Ok([0xF5_u8, 0x80_u8, 0x80_u8, 0x80_u8]), "F5 lead");
    Assert.False(Ok([0xFF_u8]), "FF");
    Assert.False(Ok([0xFE_u8]), "FE");
}

test utf8_truncated_and_stray {
    Assert.False(Ok([0x80_u8]), "lone continuation");
    Assert.False(Ok([0xC2_u8]), "truncated 2");
    Assert.False(Ok([0xE1_u8, 0x80_u8]), "truncated 3");
    Assert.False(Ok([0xF1_u8, 0x80_u8, 0x80_u8]), "truncated 4");
    Assert.False(Ok([0xC2_u8, 0x41_u8]), "ascii inside sequence");
    Assert.False(Ok([0xE1_u8, 0x80_u8, 0xC0_u8]), "bad third byte");
}

test utf8_incremental_split {
    u8[] euro = [0xE2_u8, 0x82_u8, 0xAC_u8, 0xF0_u8, 0x9F_u8, 0x98_u8, 0x80_u8];
    mut i64 split = 0_i64;
    while split <= 7_i64 {
        i64[] st = WsUtf8.New();
        Assert.True(WsUtf8.Feed(st, euro, 0_i64, split), "first part");
        Assert.True(WsUtf8.Feed(st, euro, split, 7_i64 - split), "second part");
        Assert.True(WsUtf8.Complete(st), "complete");
        split = split + 1_i64;
    }
    i64[] partial = WsUtf8.New();
    Assert.True(WsUtf8.Feed(partial, euro, 0_i64, 2_i64), "prefix ok");
    Assert.False(WsUtf8.Complete(partial), "mid-sequence");
    i64[] failFast = WsUtf8.New();
    Assert.False(WsUtf8.Feed(failFast, [0xED_u8, 0xA0_u8], 0_i64, 2_i64), "surrogate detected before completion");
}
