use Core.Bytes.Slice;
use Core.Collections.Array;

/// Incremental SHA-256 (FIPS 180-4). All fields are arrays so `Update` and
/// `Finish` mutate the state through a plain parameter.
/// `meta[0]` is the number of buffered bytes, `meta[1]` the total message length
/// in bytes, `meta[2]` is 1 after `Finish`.
pub type Sha256State {
    u32[] h,
    u32[] k,
    u32[] w,
    u8[] buffer,
    i64[] meta,
}

pub i64 DigestLength() { return 32_i64; }
pub i64 BlockLength() { return 64_i64; }

u32[] RoundConstants() {
    return [
        0x428a2f98_u32, 0x71374491_u32, 0xb5c0fbcf_u32, 0xe9b5dba5_u32, 0x3956c25b_u32, 0x59f111f1_u32, 0x923f82a4_u32, 0xab1c5ed5_u32,
        0xd807aa98_u32, 0x12835b01_u32, 0x243185be_u32, 0x550c7dc3_u32, 0x72be5d74_u32, 0x80deb1fe_u32, 0x9bdc06a7_u32, 0xc19bf174_u32,
        0xe49b69c1_u32, 0xefbe4786_u32, 0x0fc19dc6_u32, 0x240ca1cc_u32, 0x2de92c6f_u32, 0x4a7484aa_u32, 0x5cb0a9dc_u32, 0x76f988da_u32,
        0x983e5152_u32, 0xa831c66d_u32, 0xb00327c8_u32, 0xbf597fc7_u32, 0xc6e00bf3_u32, 0xd5a79147_u32, 0x06ca6351_u32, 0x14292967_u32,
        0x27b70a85_u32, 0x2e1b2138_u32, 0x4d2c6dfc_u32, 0x53380d13_u32, 0x650a7354_u32, 0x766a0abb_u32, 0x81c2c92e_u32, 0x92722c85_u32,
        0xa2bfe8a1_u32, 0xa81a664b_u32, 0xc24b8b70_u32, 0xc76c51a3_u32, 0xd192e819_u32, 0xd6990624_u32, 0xf40e3585_u32, 0x106aa070_u32,
        0x19a4c116_u32, 0x1e376c08_u32, 0x2748774c_u32, 0x34b0bcb5_u32, 0x391c0cb3_u32, 0x4ed8aa4a_u32, 0x5b9cca4f_u32, 0x682e6ff3_u32,
        0x748f82ee_u32, 0x78a5636f_u32, 0x84c87814_u32, 0x8cc70208_u32, 0x90befffa_u32, 0xa4506ceb_u32, 0xbef9a3f7_u32, 0xc67178f2_u32
    ];
}

/// Starts a new SHA-256 computation.
pub Sha256State New() {
    mut u32[] w = Array.Empty<u32>();
    mut i64 i = 0_i64;
    while i < 64_i64 { Array.Append<u32>(w, 0_u32); i = i + 1_i64; }
    return Sha256State {
        h: [0x6a09e667_u32, 0xbb67ae85_u32, 0x3c6ef372_u32, 0xa54ff53a_u32, 0x510e527f_u32, 0x9b05688c_u32, 0x1f83d9ab_u32, 0x5be0cd19_u32],
        k: RoundConstants(),
        w: w,
        buffer: Slice.New(64_i64),
        meta: [0_i64, 0_i64, 0_i64],
    };
}

/// Returns an independent copy, used to read a running transcript hash without ending it.
pub Sha256State Clone(Sha256State state) {
    Sha256State copy = New();
    mut i64 i = 0_i64;
    while i < 8_i64 { copy.h[i] = state.h[i]; i = i + 1_i64; }
    Slice.Copy(copy.buffer, 0_i64, state.buffer, 0_i64, 64_i64);
    copy.meta[0] = state.meta[0];
    copy.meta[1] = state.meta[1];
    copy.meta[2] = state.meta[2];
    return copy;
}

u32 Rotr(u32 x, u32 n) { return (x >> n) | (x << (32_u32 - n)); }
u32 Xor(u32 a, u32 b) { return (a | b) - (a & b); }

unit Compress(Sha256State state, u8[] data, i64 offset) {
    u32[] w = state.w;
    u32[] k = state.k;
    mut i64 t = 0_i64;
    while t < 16_i64 {
        i64 p = offset + t * 4_i64;
        w[t] = (u32(data[p]) << 24_u32) | (u32(data[p + 1_i64]) << 16_u32) | (u32(data[p + 2_i64]) << 8_u32) | u32(data[p + 3_i64]);
        t = t + 1_i64;
    }
    while t < 64_i64 {
        u32 w15 = w[t - 15_i64];
        u32 w2 = w[t - 2_i64];
        u32 s0 = Xor(Xor(Rotr(w15, 7_u32), Rotr(w15, 18_u32)), w15 >> 3_u32);
        u32 s1 = Xor(Xor(Rotr(w2, 17_u32), Rotr(w2, 19_u32)), w2 >> 10_u32);
        w[t] = w[t - 16_i64] + s0 + w[t - 7_i64] + s1;
        t = t + 1_i64;
    }
    u32[] h = state.h;
    mut u32 a = h[0]; mut u32 b = h[1]; mut u32 c = h[2]; mut u32 d = h[3];
    mut u32 e = h[4]; mut u32 f = h[5]; mut u32 g = h[6]; mut u32 hh = h[7];
    t = 0_i64;
    while t < 64_i64 {
        u32 bigS1 = Xor(Xor(Rotr(e, 6_u32), Rotr(e, 11_u32)), Rotr(e, 25_u32));
        // Ch(e,f,g) = (e & f) ^ (~e & g); the two terms share no bits, so ^ is |.
        u32 ch = (e & f) | ((0xFFFFFFFF_u32 - e) & g);
        u32 t1 = hh + bigS1 + ch + k[t] + w[t];
        u32 bigS0 = Xor(Xor(Rotr(a, 2_u32), Rotr(a, 13_u32)), Rotr(a, 22_u32));
        // Maj(a,b,c) = (a & b) | (c & (a | b)).
        u32 maj = (a & b) | (c & (a | b));
        u32 t2 = bigS0 + maj;
        hh = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
        t = t + 1_i64;
    }
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
    h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
    return;
}

/// Absorbs `count` bytes of `data` starting at `offset`.
/// An invalid range or an update after `Finish` absorbs nothing and returns false.
pub bool UpdateRange(Sha256State state, u8[] data, i64 offset, i64 count) {
    if state.meta[2] != 0_i64 { return false; }
    if !Slice.IsValidRange(Slice.Len(data), offset, count) { return false; }
    mut i64 pos = offset;
    i64 end = offset + count;
    mut i64 buffered = state.meta[0];
    state.meta[1] = state.meta[1] + count;
    if buffered > 0_i64 {
        while buffered < 64_i64 && pos < end {
            state.buffer[buffered] = data[pos];
            buffered = buffered + 1_i64;
            pos = pos + 1_i64;
        }
        if buffered < 64_i64 { state.meta[0] = buffered; return true; }
        Compress(state, state.buffer, 0_i64);
        buffered = 0_i64;
    }
    while end - pos >= 64_i64 {
        Compress(state, data, pos);
        pos = pos + 64_i64;
    }
    while pos < end {
        state.buffer[buffered] = data[pos];
        buffered = buffered + 1_i64;
        pos = pos + 1_i64;
    }
    state.meta[0] = buffered;
    return true;
}

/// Absorbs all of `data`.
pub bool Update(Sha256State state, u8[] data) {
    return UpdateRange(state, data, 0_i64, Slice.Len(data));
}

/// Pads, finishes, and returns the 32-byte digest. The state cannot be updated afterwards.
pub u8[] Finish(Sha256State state) {
    u8[] out = Slice.New(32_i64);
    if state.meta[2] != 0_i64 {
        // A second Finish returns the same digest.
        WriteDigest(state, out);
        return out;
    }
    i64 bitLength = state.meta[1] * 8_i64;
    mut i64 buffered = state.meta[0];
    state.buffer[buffered] = 0x80_u8;
    buffered = buffered + 1_i64;
    if buffered > 56_i64 {
        while buffered < 64_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
        Compress(state, state.buffer, 0_i64);
        buffered = 0_i64;
    }
    while buffered < 56_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
    mut i64 i = 0_i64;
    while i < 8_i64 {
        state.buffer[56_i64 + i] = u8((bitLength >> ((7_i64 - i) * 8_i64)) & 0xFF_i64);
        i = i + 1_i64;
    }
    Compress(state, state.buffer, 0_i64);
    state.meta[0] = 0_i64;
    state.meta[2] = 1_i64;
    WriteDigest(state, out);
    return out;
}

unit WriteDigest(Sha256State state, u8[] out) {
    mut i64 i = 0_i64;
    while i < 8_i64 {
        u32 v = state.h[i];
        out[i * 4_i64] = u8(v >> 24_u32);
        out[i * 4_i64 + 1_i64] = u8((v >> 16_u32) & 0xFF_u32);
        out[i * 4_i64 + 2_i64] = u8((v >> 8_u32) & 0xFF_u32);
        out[i * 4_i64 + 3_i64] = u8(v & 0xFF_u32);
        i = i + 1_i64;
    }
    return;
}

/// One-shot SHA-256 of `data`.
pub u8[] Hash(u8[] data) {
    Sha256State state = New();
    Update(state, data);
    return Finish(state);
}
