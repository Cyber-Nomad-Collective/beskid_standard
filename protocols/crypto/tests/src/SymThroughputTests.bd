use Testing.Assert;
use Core.Bytes.Slice;
use Core.Results;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Errors;
use Crypto.Sha256;

/// 16 in-place seal/open round trips of one 16 KiB record (the TLS maximum) per AEAD,
/// 256 KiB sealed and 256 KiB opened per test, with one reused record buffer.
/// The record buffer is allocated once: Beskid 0.5.2 grows u8[] one append at a time
/// (quadratic) and caps single large values near 128 KiB (see COMPILER-GAPS.md).

i64 RecordLength() { return 16384_i64; }

u8[] Record() {
    u8[] d = Slice.New(RecordLength() + 16_i64);
    Reset(d);
    return d;
}

unit Reset(u8[] d) {
    mut i64 i = 0_i64;
    while i < RecordLength() { d[i] = u8(i & 255_i64); i = i + 1_i64; }
    return;
}

bool Intact(u8[] d) {
    mut i64 i = 0_i64;
    while i < RecordLength() { if d[i] != u8(i & 255_i64) { return false; } i = i + 1_i64; }
    return true;
}

test throughput_chacha20poly1305_16k_x16 {
    u8[] key = Slice.New(32_i64);
    u8[] nonce = Slice.New(12_i64);
    u8[] aad = Slice.New(5_i64);
    u8[] record = Record();
    mut i64 round = 0_i64;
    while round < 16_i64 {
        nonce[11] = u8(round);
        bool sealed = match ChaCha20Poly1305.SealInto(key, nonce, aad, record, 0_i64, RecordLength(), record, 0_i64) { Result::Ok(_) => true, Result::Error(_) => false, };
        Assert.True(sealed, "sealed");
        Assert.False(Intact(record), "encrypted in place");
        i64 opened = match ChaCha20Poly1305.OpenInto(key, nonce, aad, record, 0_i64, RecordLength() + 16_i64, record, 0_i64) { Result::Ok(n) => n, Result::Error(_) => -1_i64, };
        Assert.Equal<i64>(opened, RecordLength(), "opened");
        Assert.True(Intact(record), "round trip");
        round = round + 1_i64;
    }
}

test throughput_aes128gcm_16k_x16 {
    match AesGcm.New(Slice.New(16_i64)) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] nonce = Slice.New(12_i64);
            u8[] aad = Slice.New(5_i64);
            u8[] record = Record();
            mut i64 round = 0_i64;
            while round < 16_i64 {
                nonce[11] = u8(round);
                bool sealed = match AesGcm.SealInto(key, nonce, aad, record, 0_i64, RecordLength(), record, 0_i64) { Result::Ok(_) => true, Result::Error(_) => false, };
                Assert.True(sealed, "sealed");
                i64 opened = match AesGcm.OpenInto(key, nonce, aad, record, 0_i64, RecordLength() + 16_i64, record, 0_i64) { Result::Ok(n) => n, Result::Error(_) => -1_i64, };
                Assert.Equal<i64>(opened, RecordLength(), "opened");
                Assert.True(Intact(record), "round trip");
                round = round + 1_i64;
            }
        },
    };
}

test throughput_open_into_rejects_without_writing {
    u8[] key = Slice.New(32_i64);
    u8[] nonce = Slice.New(12_i64);
    u8[] record = Record();
    ChaCha20Poly1305.SealInto(key, nonce, Slice.New(0_i64), record, 0_i64, RecordLength(), record, 0_i64);
    record[RecordLength() + 3_i64] = record[RecordLength() + 3_i64] + 1_u8;
    u8[] out = Slice.New(64_i64);
    out[0] = 0xAA_u8;
    // Output too small is rejected before any work; a bad tag never writes plaintext.
    bool small = match ChaCha20Poly1305.OpenInto(key, nonce, Slice.New(0_i64), record, 0_i64, RecordLength() + 16_i64, out, 0_i64) { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::InvalidLength => true, _ => false, }, };
    Assert.True(small, "short output");
    u8[] full = Record();
    full[0] = 0xAA_u8;
    bool rejected = match ChaCha20Poly1305.OpenInto(key, nonce, Slice.New(0_i64), record, 0_i64, RecordLength() + 16_i64, full, 0_i64) { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, }, };
    Assert.True(rejected, "bad tag");
    Assert.Equal<u8>(full[0], 0xAA_u8, "output untouched");
}

test throughput_sha256_16k_x16 {
    u8[] data = Record();
    Sha256State state = Sha256.New();
    mut i64 round = 0_i64;
    while round < 16_i64 { Sha256.UpdateRange(state, data, 0_i64, RecordLength()); round = round + 1_i64; }
    Assert.Equal<i64>(Slice.Len(Sha256.Finish(state)), 32_i64, "digest");
}
