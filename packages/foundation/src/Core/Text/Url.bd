/// Core.Text.Url — RFC 3986 URI parsing, percent-encoding, query parameters, and reference
/// resolution.
/// @tier(supported)
/// `Parse` splits an absolute URI or a relative reference into its components without
/// decoding them; use `PercentDecode` on the parts you need. Hosts are kept as written (IPv6
/// literals keep their brackets); scheme and hostname are not case-normalized.
use Core.Collections.Array;
use Core.Results;
use Core.String.Ascii;
use Core.String;
use Core.Text.Number;

/// URI components. `port` is `-1` when absent; `hasAuthority`, `hasQuery`, and `hasFragment`
/// distinguish an empty component from a missing one.
pub type Url {
    string scheme,
    bool hasAuthority,
    string userInfo,
    string hostname,
    i64 port,
    string path,
    bool hasQuery,
    string query,
    bool hasFragment,
    string fragment,
}

/// Parse failures.
/// @variant(InvalidScheme) The scheme does not start with a letter or has invalid characters.
/// @variant(InvalidPort) The port is not a decimal number in `0..=65535`.
/// @variant(InvalidHost) An IPv6 literal is not closed with `]`.
/// @variant(InvalidPercentEncoding) A `%` is not followed by two hex digits.
pub enum UrlError {
    InvalidScheme,
    InvalidPort,
    InvalidHost,
    InvalidPercentEncoding,
}

/// One decoded `key=value` pair from a query string.
pub type QueryParam {
    string key,
    string value,
}

bool IsSchemeByte(u8 b) {
    return Ascii.IsAlphanumeric(b) || b == 43 || b == 45 || b == 46;
}

/// Byte offset of the first of `bytes` (given as a string of single-byte characters) at or after
/// `from`, or `Len(text)` when none occurs.
i64 FindAny(string text, i64 from, string bytes) {
    i64 len = String.Len(text);
    i64 count = String.Len(bytes);
    mut i64 i = from;
    while i < len {
        u8 b = String.ByteAt(text, i);
        mut i64 k = 0;
        while k < count {
            if b == String.ByteAt(bytes, k) {
                return i;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return len;
}

/// Parses `text` as a URI or relative reference, such as `https://user@example.com:8443/a?q=1#top`,
/// `mailto:someone@example.com`, `//cdn.example/x`, or `../img.png`.
pub Result<Url, UrlError> Parse(string text) {
    i64 len = String.Len(text);
    mut string scheme = "";
    mut i64 i = 0;
    i64 colon = FindAny(text, 0, ":/?#");
    if colon < len && String.ByteAt(text, colon) == 58 && colon > 0 {
        if !Ascii.IsAlpha(String.ByteAt(text, 0)) {
            return Result<Url, UrlError>::Error(UrlError::InvalidScheme);
        }
        mut i64 k = 1;
        while k < colon {
            if !IsSchemeByte(String.ByteAt(text, k)) {
                return Result<Url, UrlError>::Error(UrlError::InvalidScheme);
            }
            k = k + 1;
        }
        scheme = String.SubSlice(text, 0, colon);
        i = colon + 1;
    }
    mut bool hasAuthority = false;
    mut string userInfo = "";
    mut string hostname = "";
    mut i64 port = -1;
    if i + 1 < len && String.ByteAt(text, i) == 47 && String.ByteAt(text, i + 1) == 47 {
        hasAuthority = true;
        i64 start = i + 2;
        i64 end = FindAny(text, start, "/?#");
        string authority = String.SubSlice(text, start, end - start);
        mut string hostPort = authority;
        i64 at = String.LastIndexOf(authority, "@");
        if at >= 0 {
            userInfo = String.SubSlice(authority, 0, at);
            hostPort = String.SubSlice(authority, at + 1, String.Len(authority) - at - 1);
        }
        mut string portText = "";
        mut bool hasPort = false;
        if String.StartsWith(hostPort, "[") {
            i64 close = String.IndexOf(hostPort, "]");
            if close < 0 {
                return Result<Url, UrlError>::Error(UrlError::InvalidHost);
            }
            hostname = String.SubSlice(hostPort, 0, close + 1);
            string after = String.SubSlice(hostPort, close + 1, String.Len(hostPort) - close - 1);
            if String.StartsWith(after, ":") {
                hasPort = true;
                portText = String.SubSlice(after, 1, String.Len(after) - 1);
            } else {
                if String.Len(after) > 0 {
                    return Result<Url, UrlError>::Error(UrlError::InvalidHost);
                }
            }
        } else {
            i64 portColon = String.LastIndexOf(hostPort, ":");
            if portColon >= 0 {
                hostname = String.SubSlice(hostPort, 0, portColon);
                hasPort = true;
                portText = String.SubSlice(hostPort, portColon + 1, String.Len(hostPort) - portColon - 1);
            } else {
                hostname = hostPort;
            }
        }
        if hasPort && String.Len(portText) > 0 {
            i64 parsed = match Number.ParseI64(portText) {
                Result::Ok(value) => value,
                Result::Error(_) => -1_i64,
            };
            if parsed < 0 || parsed > 65535 || String.StartsWith(portText, "+") || String.StartsWith(portText, "-") {
                return Result<Url, UrlError>::Error(UrlError::InvalidPort);
            }
            port = parsed;
        }
        i = end;
    }
    i64 pathEnd = FindAny(text, i, "?#");
    string path = String.SubSlice(text, i, pathEnd - i);
    i = pathEnd;
    mut bool hasQuery = false;
    mut string query = "";
    if i < len && String.ByteAt(text, i) == 63 {
        hasQuery = true;
        i64 queryEnd = FindAny(text, i + 1, "#");
        query = String.SubSlice(text, i + 1, queryEnd - i - 1);
        i = queryEnd;
    }
    mut bool hasFragment = false;
    mut string fragment = "";
    if i < len && String.ByteAt(text, i) == 35 {
        hasFragment = true;
        fragment = String.SubSlice(text, i + 1, len - i - 1);
    }
    return Result<Url, UrlError>::Ok(Url {
        scheme: scheme,
        hasAuthority: hasAuthority,
        userInfo: userInfo,
        hostname: hostname,
        port: port,
        path: path,
        hasQuery: hasQuery,
        query: query,
        hasFragment: hasFragment,
        fragment: fragment,
    });
}

/// Recomposes `url` into text (RFC 3986 section 5.3).
pub string Format(Url url) {
    mut string text = "";
    if String.Len(url.scheme) > 0 {
        text = url.scheme + ":";
    }
    if url.hasAuthority {
        text = text + "//";
        if String.Len(url.userInfo) > 0 {
            text = text + url.userInfo + "@";
        }
        text = String.Concat(text, url.hostname);
        if url.port >= 0 {
            text = text + ":" + Number.FormatI64(url.port);
        }
    }
    text = String.Concat(text, url.path);
    if url.hasQuery {
        text = text + "?" + url.query;
    }
    if url.hasFragment {
        text = text + "#" + url.fragment;
    }
    return text;
}

/// Decodes `%XX` escapes. When `plusIsSpace` is true (query strings in HTML forms), `+` decodes
/// to a space.
pub Result<string, UrlError> PercentDecode(string text, bool plusIsSpace) {
    i64 len = String.Len(text);
    mut u8[] bytes = Array.Empty<u8>();
    mut i64 i = 0;
    while i < len {
        u8 b = String.ByteAt(text, i);
        if b == 37 {
            if i + 2 >= len {
                return Result<string, UrlError>::Error(UrlError::InvalidPercentEncoding);
            }
            i64 high = Ascii.HexValue(String.ByteAt(text, i + 1));
            i64 low = Ascii.HexValue(String.ByteAt(text, i + 2));
            if high < 0 || low < 0 {
                return Result<string, UrlError>::Error(UrlError::InvalidPercentEncoding);
            }
            bytes = Array.Append<u8>(bytes, u8(high * 16 + low));
            i = i + 3;
        } else {
            if b == 43 && plusIsSpace {
                bytes = Array.Append<u8>(bytes, u8(32));
            } else {
                bytes = Array.Append<u8>(bytes, b);
            }
            i = i + 1;
        }
    }
    return Result<string, UrlError>::Ok(String.FromUtf8CodeUnits(bytes));
}

bool IsUnreserved(u8 b) {
    return Ascii.IsAlphanumeric(b) || b == 45 || b == 46 || b == 95 || b == 126;
}

/// Percent-encodes every byte except the unreserved set (`A-Z a-z 0-9 - . _ ~`) and the bytes of
/// `keep` (for example `"/"` to leave path separators readable).
pub string PercentEncode(string text, string keep) {
    i64 len = String.Len(text);
    string hex = "0123456789ABCDEF";
    mut string result = "";
    mut i64 runStart = 0;
    mut i64 i = 0;
    while i < len {
        u8 b = String.ByteAt(text, i);
        bool kept = IsUnreserved(b) || FindAny(keep, 0, String.FromAscii(b)) < String.Len(keep);
        if !kept {
            result = String.Concat(result, String.SubSlice(text, runStart, i - runStart));
            i64 value = i64(b);
            result = result + "%" + String.SubSlice(hex, value / 16, 1) + String.SubSlice(hex, value % 16, 1);
            runStart = i + 1;
        }
        i = i + 1;
    }
    return String.Concat(result, String.SubSlice(text, runStart, len - runStart));
}

/// Splits and decodes a query string (`a=1&b=two+words&flag`) into parameters, in order.
/// `+` decodes to a space; a parameter without `=` has an empty value; empty segments are
/// skipped.
pub Result<QueryParam[], UrlError> QueryParams(string query) {
    mut QueryParam[] params = Array.Empty<QueryParam>();
    string[] pairs = String.Split(query, "&");
    mut i64 i = 0;
    while i < Array.Len<string>(pairs) {
        string pair = Array.Get<string>(pairs, i);
        if String.Len(pair) > 0 {
            i64 eq = String.IndexOf(pair, "=");
            mut string rawKey = pair;
            mut string rawValue = "";
            if eq >= 0 {
                rawKey = String.SubSlice(pair, 0, eq);
                rawValue = String.SubSlice(pair, eq + 1, String.Len(pair) - eq - 1);
            }
            string key = PercentDecode(rawKey, true)?;
            string value = PercentDecode(rawValue, true)?;
            params = Array.Append<QueryParam>(params, QueryParam { key: key, value: value });
        }
        i = i + 1;
    }
    return Result<QueryParam[], UrlError>::Ok(params);
}

/// RFC 3986 section 5.2.4 dot-segment removal.
pub string RemoveDotSegments(string path) {
    mut string input = path;
    mut string output = "";
    while String.Len(input) > 0 {
        if String.StartsWith(input, "../") {
            input = String.SubSlice(input, 3, String.Len(input) - 3);
            continue;
        }
        if String.StartsWith(input, "./") {
            input = String.SubSlice(input, 2, String.Len(input) - 2);
            continue;
        }
        if String.StartsWith(input, "/./") {
            input = String.SubSlice(input, 2, String.Len(input) - 2);
            continue;
        }
        if input == "/." {
            input = "/";
            continue;
        }
        if String.StartsWith(input, "/../") || input == "/.." {
            if input == "/.." {
                input = "/";
            } else {
                input = String.SubSlice(input, 3, String.Len(input) - 3);
            }
            i64 slash = String.LastIndexOf(output, "/");
            if slash >= 0 {
                output = String.SubSlice(output, 0, slash);
            } else {
                output = "";
            }
            continue;
        }
        if input == "." || input == ".." {
            input = "";
            continue;
        }
        mut i64 next = String.IndexOfFrom(input, 1, "/");
        if String.StartsWith(input, "/") == false {
            next = String.IndexOf(input, "/");
        }
        if next < 0 {
            output = String.Concat(output, input);
            input = "";
        } else {
            output = String.Concat(output, String.SubSlice(input, 0, next));
            input = String.SubSlice(input, next, String.Len(input) - next);
        }
    }
    return output;
}

string MergePaths(Url base, string reference) {
    if base.hasAuthority && String.Len(base.path) == 0 {
        return "/" + reference;
    }
    i64 slash = String.LastIndexOf(base.path, "/");
    if slash < 0 {
        return reference;
    }
    return String.Concat(String.SubSlice(base.path, 0, slash + 1), reference);
}

/// Resolves `reference` against `base` (RFC 3986 section 5.2.2), such as `../b?x` against
/// `http://a/c/d` giving `http://a/b?x`.
pub Url Resolve(Url base, Url reference) {
    if String.Len(reference.scheme) > 0 {
        return Url {
            scheme: reference.scheme, hasAuthority: reference.hasAuthority, userInfo: reference.userInfo,
            hostname: reference.hostname, port: reference.port, path: RemoveDotSegments(reference.path),
            hasQuery: reference.hasQuery, query: reference.query,
            hasFragment: reference.hasFragment, fragment: reference.fragment,
        };
    }
    if reference.hasAuthority {
        return Url {
            scheme: base.scheme, hasAuthority: true, userInfo: reference.userInfo,
            hostname: reference.hostname, port: reference.port, path: RemoveDotSegments(reference.path),
            hasQuery: reference.hasQuery, query: reference.query,
            hasFragment: reference.hasFragment, fragment: reference.fragment,
        };
    }
    mut string path = base.path;
    mut bool hasQuery = base.hasQuery;
    mut string query = base.query;
    if String.Len(reference.path) > 0 {
        if String.StartsWith(reference.path, "/") {
            path = RemoveDotSegments(reference.path);
        } else {
            path = RemoveDotSegments(MergePaths(base, reference.path));
        }
        hasQuery = reference.hasQuery;
        query = reference.query;
    } else {
        if reference.hasQuery {
            hasQuery = true;
            query = reference.query;
        }
    }
    return Url {
        scheme: base.scheme, hasAuthority: base.hasAuthority, userInfo: base.userInfo,
        hostname: base.hostname, port: base.port, path: path,
        hasQuery: hasQuery, query: query,
        hasFragment: reference.hasFragment, fragment: reference.fragment,
    };
}
