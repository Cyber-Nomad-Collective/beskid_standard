//! `ConsoleSuite`: the console tests of corelib_tests, merged into one target so the matrix lowers
//! the console closure once. Each section keeps the tests of one former target unchanged.

use Testing.Assert;
use Console.Controls.ProgressBar;
use Core.String;
use Console.Controls.VerticalStack;
