//! Helpers and test-only certificates shared by the TLS test targets. The certificates were
//! generated with openssl (see tests/interop/certs); the keys are test-only.
use Codec.Hex;
use Core.Bytes.Slice;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Time.TimerError;
use Testing.Assert;
use Tls.PeerKeys;
use Tls.TlsConfig;
use Tls.TlsErrors;

pub bool Same(u8[] a, u8[] b)
{
    return Slice.Compare(a, b) == 0_i64;
}

pub string Dec(i64 v)
{
    if (v < 0_i64)
    {
        return "-" + Dec(0_i64 - v);
    }
    if (v < 10_i64)
    {
        return String.DigitChar(v);
    }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

pub unit ExpectEqual(i64 actual, i64 expected, string what)
{
    if (actual != expected)
    {
        Assert.Fail(what + ": got " + Dec(actual) + ", want " + Dec(expected));
    }
    return;
}

pub i64 TlsCode(Result<unit, TlsError> r)
{
    return match (r)
    {
        Result::Ok(_) => 0_i64,
        Result::Error(e) => TlsErrors.Code(e),
    };
}

pub Option<Deadline> Soon()
{
    Result<Deadline, TimerError> d = Deadline.After(Time.FromMilliseconds(30000_i64));
    return match (d)
    {
        Result::Ok(v) => Option.FromValue<Deadline>(v),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

pub TlsServerConfig ServerConfig()
{
    u8[] key = match (PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()))
    {
        Result::Ok(k) => k,
        Result::Error(_) => Slice.New(0_i64),
    };
    return TlsConfig.Server(TlsConfig.Chain1(ServerCertDer()), key);
}

