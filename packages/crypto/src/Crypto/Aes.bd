/// One AES block from `input[meta[0]]` to `output[meta[1]]` (run with `meta[2] = meta[0] + 1`).
i64 Block1(u8[] keys, u8[] tables, u8[] counterBlock, u8[] input, u8[] output, u8[] state, i64[] meta) {
    mut i64 last = 0_i64;
    while meta[0] < meta[2] {
        last = clif {
            %kp1 = payload %0
            %tp2 = payload %1
            %sp3 = payload %5
            %mp4 = payload %6
            %ip5 = payload %3
            %off6 = load.i64 %mp4
            %src7 = iadd %ip5, %off6
            %in8 = load.i8x16 %src7
