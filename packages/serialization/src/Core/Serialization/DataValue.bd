use Core.Serialization.Metadata;

/// Format-neutral collection identity. Formats choose their own wire syntax.
pub enum SequenceKind {
    Array(),
    List(),
}

/// No wire coercion is implicit: integer width and float bits remain explicit.
/// Owned adapters build fresh containers and validate this tree before output.
pub enum DataValue {
    Unit(),
    Boolean(bool value),
    Signed(i64 value, u8 width),
    Unsigned(u64 value, u8 width),
    Float(u64 bits, u8 width),
    Scalar(char value),
    String(string value),
    Bytes(u8[] value),
    Sequence(SequenceKind kind, DataValue[] values),
    Record(Metadata.ShapeId shape, RecordField[] fields),
    Map(MapEntry[] entries),
    Variant(Metadata.ShapeId shape, string name, DataValue[] payload),
    Optional(bool present, DataValue[] payload),
}

/// Ordered declared fields, independent of any format's assignment syntax.
pub type RecordField {
    pub string name,
    pub DataValue value,
}

/// String-key maps remain distinct from record fields and sequences.
pub type MapEntry {
    pub string key,
    pub DataValue value,
}
