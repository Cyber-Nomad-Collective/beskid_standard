 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8]; }

/// Largest buffer `Zeroed` allocates from a literal.
pub i64 MaxSmall() { return 4096_i64; }

/// The literal of the smallest class that holds `count` bytes (1 <= count <= MaxSmall()).
u8[] ClassFor(i64 count) {
    if count <= 64_i64 { return Class64(); }
    if count <= 1024_i64 { return Class1K(); }
    if count <= 2048_i64 { return Class2K(); }
    return Class4K();
}

u8[] TrimTo(mut u8[] result, i64 count) {
    mut i64 len = Slice.Len(result);
    while len > count {
        Array.RemoveLast<u8>(result);
        len = len - 1_i64;
    }
    return result;
}

/// A zero-filled buffer of `count` bytes (`count` <= 0 gives an empty buffer). Sizes up to
/// `MaxSmall()` come from literals; larger sizes fall back to `Slice.New`, because a larger
/// literal costs minutes of front-end time per build (COMPILER-GAPS PERF1).
pub u8[] Zeroed(i64 count) {
    if count <= 0_i64 || count > MaxSmall() { return Slice.New(count); }
    return TrimTo(ClassFor(count), count);
}

unit MoveRaw(u8[] destination, i64 destinationOffset, u8[] source, i64 sourceOffset, i64 count) {
    clif {
        %db = payload %0
        %dp = iadd %db, %1
        %sb = payload %2
        %sp = iadd %sb, %3
        %r = call @memmove(%dp, %sp, %4) -> i64
    };
    return;
}

unit ZeroRaw(u8[] buffer, i64 offset, i64 count) {
    clif {
        %b = payload %0
        %p = iadd %b, %1
        %z = iconst.i32 0
        %r = call @memset(%p, %z, %2) -> i64
    };
    return;
}

/// Copies `count` bytes like `Slice.Copy` (overlapping ranges allowed). An out-of-range
/// request falls back to `Slice.Copy`, which traps.
pub unit Copy(u8[] destination, i64 destinationOffset, u8[] source, i64 sourceOffset, i64 count) {
    if count <= 0_i64 { return; }
    if !Slice.IsValidRange(Slice.Len(destination), destinationOffset, count) || !Slice.IsValidRange(Slice.Len(source), sourceOffset, count) {
        Slice.Copy(destination, destinationOffset, source, sourceOffset, count);
        return;
    }
    MoveRaw(destination, destinationOffset, source, sourceOffset, count);
    return;
}

/// Zeroes `buffer[offset, offset + count)`. Out-of-range requests are ignored and return false.
pub bool Zero(u8[] buffer, i64 offset, i64 count) {
    if count <= 0_i64 { return true; }
    if !Slice.IsValidRange(Slice.Len(buffer), offset, count) { return false; }
    ZeroRaw(buffer, offset, count);
    return true;
}

/// A fresh copy of `source[offset, offset + count)` with the clamping of `Slice.SubSlice`
/// (negative offset or count count as 0; the range is cut at the end of `source`).
pub u8[] SubSlice(u8[] source, i64 offset, i64 count) {
    i64 total = Slice.Len(source);
    mut i64 from = offset;
    if from < 0_i64 { from = 0_i64; }
    mut i64 n = count;
    if n < 0_i64 { n = 0_i64; }
    if from > total { return Slice.New(0_i64); }
    if n > total - from { n = total - from; }
    u8[] out = Zeroed(n);
    if n > 0_i64 { MoveRaw(out, 0_i64, source, from, n); }
    return out;
}

/// `head` followed by `tail[offset, offset + count)` in a fresh buffer (bounds as in `Copy`).
pub u8[] Join(u8[] head, u8[] tail, i64 offset, i64 count) {
    i64 n = Slice.Len(head);
    u8[] out = Zeroed(n + count);
    Copy(out, 0_i64, head, 0_i64, n);
    Copy(out, n, tail, offset, count);
    return out;
}

