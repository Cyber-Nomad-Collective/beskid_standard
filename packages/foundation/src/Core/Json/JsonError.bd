/// Typed JSON parse failures. Every variant carries the zero-based UTF-8 byte offset where
/// parsing stopped.
/// @tier(supported)
/// @variant(UnexpectedEnd) The input ended inside a value.
/// @variant(UnexpectedCharacter) A byte is not valid at this position.
/// @variant(InvalidNumber) A number does not follow the JSON number grammar.
/// @variant(InvalidEscape) A backslash escape is unknown or malformed.
/// @variant(InvalidUnicode) A `\u` escape encodes a lone or mismatched surrogate.
/// @variant(ControlCharacter) A raw control character (below U+0020) appears inside a string.
/// @variant(TrailingCharacters) Non-whitespace follows the top-level value.
/// @variant(TooDeep) Arrays and objects nest deeper than the parser limit.
pub enum JsonError {
    UnexpectedEnd(i64 offset),
    UnexpectedCharacter(i64 offset),
    InvalidNumber(i64 offset),
    InvalidEscape(i64 offset),
    InvalidUnicode(i64 offset),
    ControlCharacter(i64 offset),
    TrailingCharacters(i64 offset),
    TooDeep(i64 offset),
}
