                if size == 0_i64 { return Result::Ok(cursor); }
            },
        };
    }
    // The walk ran past the buffer without a terminal chunk: more octets are required.
    return Result::Ok(0_i64);
}

/// Status code of a response start line for boundary detection; ResponseHead repeats the full start-line check.
Result<i64,HttpError> StartStatus(u8[] bytes, i64 lineEnd) {
    if lineEnd < 13_i64 || bytes[12_i64] != u8(32) { return Result::Error(HttpError::InvalidStatus()); }
    Result<string,HttpError> version = Ascii(bytes, 0_i64, 9_i64);
    return match version {
        Result::Error(_) => Result::Error(HttpError::InvalidStatus()),
        Result::Ok(text) => {
            if text != "HTTP/1.1 " { return Result::Error(HttpError::InvalidStatus()); }
            mut i64 status = 0_i64;
            mut i64 i = 9_i64;
            while i < 12_i64 {
                u8 b = bytes[i];
                if b < u8(48) || b > u8(57) { return Result::Error(HttpError::InvalidStatus()); }
                status = status * 10_i64 + i64(b - u8(48));
                i = i + 1_i64;
            }
            if status < 100_i64 || status > 599_i64 { return Result::Error(HttpError::InvalidStatus()); }
            return Result::Ok(status);
        },
    };
}
Result<i64,HttpError> RoleStatus(u8[] bytes, i64 lineEnd, MessageRole role) {
    return match role { MessageRole::Request => Result::Ok(0_i64), _ => StartStatus(bytes, lineEnd), };
}

/// Pure boundary detection for the shared transport reader; see Http.Wire.
