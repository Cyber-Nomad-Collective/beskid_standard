/// AES-GCM test cases of the GCM specification (McGrew and Viega): AES-128 cases 1 to 4,
/// AES-256 cases 13 to 16, and a 4000-byte message.
pub AeadVector[] AesGcmVectors()
{
    return [AeadVector
    {
        label: "AES-GCM test case 1",
        key: Hex("00000000000000000000000000000000"),
        nonce: Hex("000000000000000000000000"),
        aad: Hex(""),
        plaintext: Hex(""),
        sealed: "58e2fccefa7e3061367f1d57a4e7455a",
    }, AeadVector
    {
        label: "AES-GCM test case 2",
        key: Hex("00000000000000000000000000000000"),
        nonce: Hex("000000000000000000000000"),
        aad: Hex(""),
        plaintext: Hex("00000000000000000000000000000000"),
        sealed: "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf",
    }, AeadVector
    {
        label: "AES-GCM test case 3",
        key: Hex("feffe9928665731c6d6a8f9467308308"),
        nonce: Hex("cafebabefacedbaddecaf888"),
        aad: Hex(""),
        plaintext: Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"),
        sealed: "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4",
    }, AeadVector
    {
        label: "AES-GCM test case 4",
        key: Hex("feffe9928665731c6d6a8f9467308308"),
        nonce: Hex("cafebabefacedbaddecaf888"),
        aad: Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"),
        plaintext: Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"),
        sealed: "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47",
    }, AeadVector
    {
