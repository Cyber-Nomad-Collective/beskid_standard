/// Long-message AEAD known answers that cover the multi-block CLIF kernels (four-block
/// ChaCha20 groups, AES-CTR/GHASH batches) plus their tails. The vectors and their inputs are
/// in `Vectors.bd`.
use Testing.Assert;
use Core.Results;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Sha256;
use TestSupport;
use Vectors;

test ChaCha20Poly1305SealsLongMessagesToTheKnownDigests
{
    for v in LongChaCha20Poly1305Vectors()
    {
        u8[] key = LongKey(v.keyLength);
        u8[] message = LongMessage(v.length);
        u8[] sealed = Unwrap(ChaCha20Poly1305.Seal(key, LongNonce(), LongAad(), message));
        Assert.True(Same(Sha256.Hash(sealed), Hex(v.sealedDigest)), "sealed digest " + v.label);
        Assert.True(Same(Unwrap(ChaCha20Poly1305.Open(key, LongNonce(), LongAad(), sealed)), message), "round trip " + v.label);
    }
}

test AesGcmSealsLongMessagesToTheKnownDigests
{
    for v in LongAesGcmVectors()
    {
        match (AesGcm.New(LongKey(v.keyLength)))
        {
            Result::Error(_) => {
                Assert.Fail("key " + v.label);
            },
            Result::Ok(key) => {
                u8[] message = LongMessage(v.length);
                u8[] sealed = Unwrap(AesGcm.Seal(key, LongNonce(), LongAad(), message));
                Assert.True(Same(Sha256.Hash(sealed), Hex(v.sealedDigest)), "sealed digest " + v.label);
                Assert.True(Same(Unwrap(AesGcm.Open(key, LongNonce(), LongAad(), sealed)), message), "round trip " + v.label);
            },
        };
    }
}
