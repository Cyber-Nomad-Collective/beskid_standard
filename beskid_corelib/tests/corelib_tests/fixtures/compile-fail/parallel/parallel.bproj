parallel {
  name = "parallel"
  version = "0.1.0"
  root = "."
}

dependency "corelib" {
  source = path
  path = "../../../../.."
}

target "ScopeCaptured" {
  kind = Lib
  entry = "ScopeCaptured.bd"
}

target "UseAfterPortSend" {
  kind = Lib
  entry = "UseAfterPortSend.bd"
}

target "FrozenNonSharedCaptured" {
  kind = Lib
  entry = "FrozenNonSharedCaptured.bd"
}

target "PortOfChannel" {
  kind = Lib
  entry = "PortOfChannel.bd"
}

target "UnorderedWithoutCommutative" {
  kind = Lib
  entry = "UnorderedWithoutCommutative.bd"
}

target "CapturedMutableLocal" {
  kind = Lib
  entry = "CapturedMutableLocal.bd"
}

target "SequenceOfChannels" {
  kind = Lib
  entry = "SequenceOfChannels.bd"
}

target "MovedSeed" {
  kind = Lib
  entry = "MovedSeed.bd"
}
