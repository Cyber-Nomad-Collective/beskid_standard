/// Bordered panel control with optional title.
use Console;
use Console.Style;
use Console.Controls.Contracts;
use Console.Controls.Frame;
use Console.Controls.RenderContext;
use Core.String;

pub type Panel : Contracts.PaddingProvider, Contracts.MarginProvider, Contracts.FramedControl, Contracts.ConsoleControl {
    string title,
    TitleAlignment align,
    Style.Padding padding,
    Style.Margin margin,
    bool forceAscii,
    string body,

    pub Style.Padding Padding() {
        return this.padding;
    }

    pub Style.Margin Margin() {
        return this.margin;
    }

    pub bool UseUnicodeFrame() {
        if this.forceAscii {
            return false;
        }
        return Frame.PreferUnicodeFrame();
    }

    pub Console.ConsoleSize Measure(Console.ConsoleSize available) {
        i32 pad = Style.ResolvePadding(this.padding, available.columns);
        i32 margin = Style.ResolveMargin(this.margin, available.columns);
        i64 inner = ContentWidth(this) + i64(pad * 2);
        i32 width = Style.ClampWidth(i32(inner + 2), 4, available.columns - margin);
        mut i32 rows = 3;
        if this.title != "" {
            rows = rows + 1;
        }
        return Console.ConsoleSize { columns: width, rows: rows };
    }

    pub string Render(Console.ConsoleSize size) {
        Frame.FrameChars frame = Frame.ForHost(UseUnicodeFrame());
        mut i32 innerWidth = size.columns - 2;
        if innerWidth < 1 {
            innerWidth = 1;
        }
        string top = TopBorder(this, frame, innerWidth);
        string mid = BodyLine(this, frame, innerWidth);
        string bottomFill = Frame.Repeat(frame.bottom, i64(innerWidth));
        string bottom = "${frame.bottomLeft}${bottomFill}${frame.bottomRight}";
        return "${top}
${mid}
${bottom}";
    }
}

pub Panel New(string body) {
    return Panel {
        title: "",
        align: TitleAlignment::Left,
        padding: Style.Padding::None,
        margin: Style.Margin::None,
        forceAscii: false,
        body: body,
    };
}

pub Panel WithTitle(Panel panel, string title) {
    return Panel {
        title: title,
        align: panel.align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Panel WithAlignment(Panel panel, TitleAlignment align) {
    return Panel {
        title: panel.title,
        align: align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Panel WithAsciiFrame(Panel panel) {
    return Panel {
        title: panel.title,
        align: panel.align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: true,
        body: panel.body,
    };
}

pub Panel WithPadding(Panel panel, Style.Padding padding) {
    return Panel {
        title: panel.title,
        align: panel.align,
        padding: padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Style.Padding Padding(Panel panel) {
    return panel.Padding();
}

pub Style.Margin Margin(Panel panel) {
    return panel.Margin();
}

pub bool UseUnicodeFrame(Panel panel) {
    return panel.UseUnicodeFrame();
}

pub i64 ContentWidth(Panel panel) {
    return Core.String.Len(panel.body);
}

pub Console.ConsoleSize Measure(Panel panel, Console.ConsoleSize available) {
    return panel.Measure(available);
}

pub string TopBorder(Panel panel, Frame.FrameChars frame, i32 innerWidth) {
    if panel.title == "" {
        return "${frame.topLeft}${Frame.Repeat(frame.top, i64(innerWidth))}${frame.topRight}";
    }
    i32 titleLen = i32(Core.String.Len(panel.title));
    mut i32 titleWidth = innerWidth - 2;
    if titleWidth < 1 {
        titleWidth = 1;
    }
    mut i32 leftFill = match panel.align {
        TitleAlignment::Left => 1,
        TitleAlignment::Center => (titleWidth - titleLen) / 2,
        TitleAlignment::Right => titleWidth - titleLen - 1,
    };
    mut i32 rightFill = match panel.align {
        TitleAlignment::Left => titleWidth - titleLen - leftFill,
        TitleAlignment::Center => titleWidth - titleLen - leftFill,
        TitleAlignment::Right => 1,
    };
    if leftFill < 0 {
        leftFill = 0;
    }
    if rightFill < 0 {
        rightFill = 0;
    }
    return "${frame.topLeft}${Frame.Repeat(frame.top, i64(leftFill))} ${panel.title} ${Frame.Repeat(frame.top, i64(rightFill))}${frame.topRight}";
}

pub string BodyLine(Panel panel, Frame.FrameChars frame, i32 innerWidth) {
    i32 pad = Style.ResolvePadding(panel.padding, innerWidth + 2);
    i32 bodyLen = i32(Core.String.Len(panel.body));
    mut i32 padRight = innerWidth - bodyLen - pad;
    if padRight < 0 {
        padRight = 0;
    }
    return "${frame.side}${Frame.Repeat(" ", i64(pad))}${panel.body}${Frame.Repeat(" ", i64(padRight))}${frame.side}";
}

pub string Render(Panel panel, Console.ConsoleSize size) {
    return panel.Render(size);
}

pub string RenderWithContext(Panel panel, Console.ConsoleSize size, RenderContext.RenderContext ctx) {
    string block = Render(panel, size);
    return RenderContext.RenderAt(ctx, block);
}
