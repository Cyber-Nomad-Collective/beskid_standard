/// Homogeneous multichannel wait (round-robin fairness in runtime).
use Concurrency.Channel;
use Concurrency.HubError;
use Concurrency.HubReceiveResult;
use Concurrency.Status;
use Core.Results;

/// Multiplexes `Channel<T>` members with `WaitReceive`.
[NeverTransferable]
pub type Hub<T> {
    i64 handle,
}

pub Hub<T> Create<T>() {
    i64 handle = __hub_create();
    return Hub<T> { handle: handle };
}

/// Test and setup helper: create an i64 member channel without importing `Concurrency.Channel` at call sites.
pub Channel<i64> CreateMemberChannel() {
    return Channel<i64>.Create();
}

/// Registers `channel` at `index` (max 256 members in v1).
pub Core.Results.Result<SendOk, HubError> Register<T>(
    Hub<T> self,
    i64 index,
    Channel<T> channel
) {
    i64 raw = __hub_register(self.handle, index, Channel.Handle<T>(channel));
    Status status = Status.FromCode(raw);
    return match status {
        Status::Ok => Core.Results.Result<Concurrency.Channel.SendOk, Concurrency.HubError>::Ok(SendOk { }),
        _ => Core.Results.Result<Concurrency.Channel.SendOk, Concurrency.HubError>::Error(MapRegisterError(status, index)),
    };
}

/// Maps a failed `Register` status. The member `index` is the id a `Limit` or `Closed` names
/// (the hub or the channel was not found); any other status is `Unexpected` with its raw code.
pub HubError MapRegisterError(Status status, i64 index) {
    return match status {
        Status::HubLimit(cap) => HubError::Limit(cap, index),
        Status::HubNotFound(_) => HubError::Closed(index),
        _ => HubError::Unexpected(Status.Discriminant(status)),
    };
}

pub unit Unregister<T>(Hub<T> self, i64 index) {
    __hub_unregister(self.handle, index);
    return;
}

/// Blocks until a member can satisfy `Receive` (round-robin among ready channels).
pub Core.Results.Result<HubReceiveResult<T>, HubError> WaitReceive<T>(Hub<T> self) {
    i64 raw = __hub_wait_receive_status(self.handle);
    Status status = Status.FromCode(raw);
    return match status {
        Status::Ok => Results.Success<HubReceiveResult<T>, HubError>(HubReceiveResult<T> { index: __hub_wait_receive_index(self.handle), value: __hub_wait_receive_value<T>(self.handle) }),
        _ => Results.Failure<HubReceiveResult<T>, HubError>(MapWaitReceiveError(status)),
    };
}

/// Maps a failed `WaitReceive` status. An empty or unknown hub names no member, so its
/// `Closed` carries -1; any status outside the contract is `Unexpected` with its raw code.
pub HubError MapWaitReceiveError(Status status) {
    return match status {
        Status::Cancelled(reason) => HubError::Cancelled(reason),
        Status::HubEmpty => HubError::Closed(-1_i64),
        Status::HubNotFound(_) => HubError::Closed(-1_i64),
        _ => HubError::Unexpected(Status.Discriminant(status)),
    };
}
