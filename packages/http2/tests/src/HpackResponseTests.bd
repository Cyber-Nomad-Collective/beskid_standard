use Testing.Assert;
use Core.Results;
use Http2.Hpack;
use Http2.HpackDecoder;
use Http2.HpackEncoder;
use HpackSupport;

mod ResponsesTests
{
    // RFC 7541 Appendix C.5 and C.6 response sequences with a 256-octet table (generated from the RFC text).
    test C5ResponsesWithoutHuffmanDecode
    {
        mut Decoder decoder = NewTestDecoder(256_i64);
        HeaderField[] block1 = DecodeOk(decoder, "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d", "C.5.1");
        ExpectFields(block1, [":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.5.1 header list");
        ExpectTable(decoder, ["location", "https://www.example.com", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "cache-control", "private", ":status", "302"], 222_i64, "C.5.1");
        HeaderField[] block2 = DecodeOk(decoder, "4803333037c1c0bf", "C.5.2");
        ExpectFields(block2, [":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.5.2 header list");
        ExpectTable(decoder, [":status", "307", "location", "https://www.example.com", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "cache-control", "private"], 222_i64, "C.5.2");
        HeaderField[] block3 = DecodeOk(decoder, "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31", "C.5.3");
        ExpectFields(block3, [":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"], "C.5.3 header list");
        ExpectTable(decoder, ["set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1", "content-encoding", "gzip", "date", "Mon, 21 Oct 2013 20:13:22 GMT"], 215_i64, "C.5.3");
    }

    test C5ResponsesWithoutHuffmanEncode
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(256_i64, false));
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"])), "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d", "C.5.1");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 222_i64, "C.5.1 encoder table size");
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"])), "4803333037c1c0bf", "C.5.2");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 222_i64, "C.5.2 encoder table size");
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"])), "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31", "C.5.3");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 215_i64, "C.5.3 encoder table size");
    }

    test C5ResponsesWithoutHuffmanRoundTrip
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(256_i64, false));
        mut Decoder decoder = NewTestDecoder(256_i64);
        u8[] wire1 = HpackEncoder.Encode(encoder, Fields([":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"]));
        Result<HeaderField[], HpackError> decoded1 = HpackDecoder.Decode(decoder, wire1);
        match (decoded1)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.5.1 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.5.1 round trip decode");
            },
        };
        u8[] wire2 = HpackEncoder.Encode(encoder, Fields([":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"]));
        Result<HeaderField[], HpackError> decoded2 = HpackDecoder.Decode(decoder, wire2);
        match (decoded2)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.5.2 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.5.2 round trip decode");
            },
        };
        u8[] wire3 = HpackEncoder.Encode(encoder, Fields([":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"]));
        Result<HeaderField[], HpackError> decoded3 = HpackDecoder.Decode(decoder, wire3);
        match (decoded3)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"], "C.5.3 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.5.3 round trip decode");
            },
        };
    }

    test C6ResponsesWithHuffmanDecode
    {
        mut Decoder decoder = NewTestDecoder(256_i64);
        HeaderField[] block1 = DecodeOk(decoder, "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3", "C.6.1");
        ExpectFields(block1, [":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.6.1 header list");
        ExpectTable(decoder, ["location", "https://www.example.com", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "cache-control", "private", ":status", "302"], 222_i64, "C.6.1");
        HeaderField[] block2 = DecodeOk(decoder, "4883640effc1c0bf", "C.6.2");
        ExpectFields(block2, [":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.6.2 header list");
        ExpectTable(decoder, [":status", "307", "location", "https://www.example.com", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "cache-control", "private"], 222_i64, "C.6.2");
        HeaderField[] block3 = DecodeOk(decoder, "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007", "C.6.3");
        ExpectFields(block3, [":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"], "C.6.3 header list");
        ExpectTable(decoder, ["set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1", "content-encoding", "gzip", "date", "Mon, 21 Oct 2013 20:13:22 GMT"], 215_i64, "C.6.3");
    }

    test C6ResponsesWithHuffmanEncode
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(256_i64, true));
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"])), "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3", "C.6.1");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 222_i64, "C.6.1 encoder table size");
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"])), "4883640effc1c0bf", "C.6.2");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 222_i64, "C.6.2 encoder table size");
        ExpectBytes(HpackEncoder.Encode(encoder, Fields([":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"])), "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007", "C.6.3");
        Assert.Equal<i64>(HpackEncoder.EncoderTableSize(encoder), 215_i64, "C.6.3 encoder table size");
    }

    test C6ResponsesWithHuffmanRoundTrip
    {
        mut Encoder encoder = NewTestEncoder(RfcPolicy(256_i64, true));
        mut Decoder decoder = NewTestDecoder(256_i64);
        u8[] wire1 = HpackEncoder.Encode(encoder, Fields([":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"]));
        Result<HeaderField[], HpackError> decoded1 = HpackDecoder.Decode(decoder, wire1);
        match (decoded1)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "302", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.6.1 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.6.1 round trip decode");
            },
        };
        u8[] wire2 = HpackEncoder.Encode(encoder, Fields([":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"]));
        Result<HeaderField[], HpackError> decoded2 = HpackDecoder.Decode(decoder, wire2);
        match (decoded2)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "307", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:21 GMT", "location", "https://www.example.com"], "C.6.2 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.6.2 round trip decode");
            },
        };
        u8[] wire3 = HpackEncoder.Encode(encoder, Fields([":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"]));
        Result<HeaderField[], HpackError> decoded3 = HpackDecoder.Decode(decoder, wire3);
        match (decoded3)
        {
            Result::Ok(fields) => {
                ExpectFields(fields, [":status", "200", "cache-control", "private", "date", "Mon, 21 Oct 2013 20:13:22 GMT", "location", "https://www.example.com", "content-encoding", "gzip", "set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"], "C.6.3 round trip");
            },
            Result::Error(_) => {
                Assert.Fail("C.6.3 round trip decode");
            },
        };
    }
}
