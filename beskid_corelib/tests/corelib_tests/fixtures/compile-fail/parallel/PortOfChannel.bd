// EXPECT: E1610
// A port element must be Transferable; `Channel<i64>` is `[NeverTransferable]`.
use Core.Results;
use Concurrency.Channel;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Parallel.Port;

test port_of_a_channel_is_rejected {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Channel<i64>> p = s.Port<Channel<i64>>();
        return Result::Ok(0_i64);
    });
}
