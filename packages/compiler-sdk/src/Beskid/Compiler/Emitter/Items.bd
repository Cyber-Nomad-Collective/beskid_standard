// CHECKED IN: hand-maintained Mod SDK emit helpers (contribution item wrappers).
use Beskid.Compiler.Collect;
use Beskid.Syntax.Nodes.SpannedContractDefinition;
use Beskid.Syntax.Nodes.SpannedFunctionDefinition;
use Beskid.Syntax.Nodes.SpannedImplBlock;
use Beskid.Syntax.Nodes.SpannedTypeDefinition;

/// Wrap a contract definition as a syntax contribution item.
pub SyntaxContributionItem ContractItem(SpannedContractDefinition definition) {
    return SyntaxContributionItem::ContractDefinition(definition);
}

/// Wrap a type definition as a syntax contribution item.
pub SyntaxContributionItem TypeItem(SpannedTypeDefinition definition) {
    return SyntaxContributionItem::TypeDefinition(definition);
}

/// Wrap a function definition as a syntax contribution item.
pub SyntaxContributionItem FunctionItem(SpannedFunctionDefinition definition) {
    return SyntaxContributionItem::FunctionDefinition(definition);
}

/// Wrap a complete implementation block as a syntax contribution item.
pub SyntaxContributionItem ImplItem(SpannedImplBlock definition) {
    return SyntaxContributionItem::ImplBlock(definition);
}
