use Core.Bytes.Slice;
use Core.Results;
use Crypto.ChaCha20Poly1305;
use Crypto.Errors;
use Crypto.Scratch;
use CryptoOpenSsl.Native;

/// AEAD_CHACHA20_POLY1305 (RFC 8439 section 2.8) through OpenSSL EVP; drop-in for
/// `Crypto.ChaCha20Poly1305` (32-byte key, 12-byte nonce, 16-byte tag). Inputs above
/// `Native.MaxEvpLength()` take the pure path.

pub i64 TagLength() { return 16_i64; }

bool Small(u8[] aad, i64 count) { return count < Native.MaxEvpLength() && Slice.Len(aad) < Native.MaxEvpLength(); }

bool Shape(u8[] key, u8[] nonce) { return Slice.Len(key) == 32_i64 && Slice.Len(nonce) == 12_i64; }

/// Same contract as `Crypto.ChaCha20Poly1305.SealInto`. Input and output must be the same
/// range or disjoint.
pub Result<unit, CryptoError> SealInto(u8[] key, u8[] nonce, u8[] aad, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    if !Shape(key, nonce) || count < 0_i64 || !Small(aad, count) {
        return ChaCha20Poly1305.SealInto(key, nonce, aad, input, inputOffset, count, output, outputOffset);
    }
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, count) { return Result::Error(CryptoError::InvalidLength()); }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count + 16_i64) { return Result::Error(CryptoError::InvalidLength()); }
    if !Native.AeadSeal(Native.ChaChaCipher(), key, nonce, aad, input, inputOffset, count, output, outputOffset) {
        return ChaCha20Poly1305.SealInto(key, nonce, aad, input, inputOffset, count, output, outputOffset);
    }
    return Result::Ok(());
}

/// Same contract as `Crypto.ChaCha20Poly1305.OpenInto`, except that a wrong tag zeroes the
/// output range (OpenSSL decrypts before it verifies; no unverified plaintext is left behind).
pub Result<i64, CryptoError> OpenInto(u8[] key, u8[] nonce, u8[] aad, u8[] sealed, i64 sealedOffset, i64 sealedCount, u8[] output, i64 outputOffset) {
    if !Slice.IsValidRange(Slice.Len(sealed), sealedOffset, sealedCount) { return Result::Error(CryptoError::InvalidLength()); }
    if sealedCount < 16_i64 { return Result::Error(CryptoError::AuthenticationFailed()); }
    i64 count = sealedCount - 16_i64;
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count) { return Result::Error(CryptoError::InvalidLength()); }
    if !Shape(key, nonce) || !Small(aad, count) {
        return ChaCha20Poly1305.OpenInto(key, nonce, aad, sealed, sealedOffset, sealedCount, output, outputOffset);
    }
    i64 result = Native.AeadOpen(Native.ChaChaCipher(), key, nonce, aad, sealed, sealedOffset, count, output, outputOffset);
    if result == 1_i64 { return Result::Ok(count); }
    return Result::Error(CryptoError::AuthenticationFailed());
}

/// Same contract as `Crypto.ChaCha20Poly1305.Seal`.
pub Result<u8[], CryptoError> Seal(u8[] key, u8[] nonce, u8[] aad, u8[] plaintext) {
    i64 count = Slice.Len(plaintext);
    u8[] out = Scratch.Bytes(count + 16_i64);
    return match SealInto(key, nonce, aad, plaintext, 0_i64, count, out, 0_i64) {
        Result::Ok(_) => Result::Ok(out),
        Result::Error(error) => Result::Error(error),
    };
}

/// Same contract as `Crypto.ChaCha20Poly1305.Open`: a wrong tag returns AuthenticationFailed
/// and no plaintext.
pub Result<u8[], CryptoError> Open(u8[] key, u8[] nonce, u8[] aad, u8[] sealed) {
    i64 total = Slice.Len(sealed);
    if total < 16_i64 { return Result::Error(CryptoError::AuthenticationFailed()); }
    u8[] out = Scratch.Bytes(total - 16_i64);
    return match OpenInto(key, nonce, aad, sealed, 0_i64, total, out, 0_i64) {
        Result::Ok(_) => Result::Ok(out),
        Result::Error(error) => Result::Error(error),
    };
}
