//! `TextSuite`: the text tests of corelib_tests, merged into one target so the matrix lowers
//! the text closure once. Each section keeps the tests of one former target unchanged.

use Core.Text.Cursor;
use Testing.Assert;
use Core.Text.Parser;
use Core.Text.Regex;
use Core.Text.Regex.Engine;
use Core.Text.Casing;
use Core.Results;
use Core.Text.Number;
use Core.Text.NumberError;
use Core.Text.Regex.Generated;

// ---- TextCursorTests.bd (formerly target `TextCursorTests`) ----

// Core.Text.Cursor combinator substrate tests.

test FromStartsAtZero {
    Cursor.TextCursor c = Cursor.From("abc");
    Assert.Equal(Cursor.Position(c), 0, "initial position");
}

test AdvanceMovesPosition {
    Cursor.TextCursor c = Cursor.Advance(Cursor.From("abc"), 2);
    Assert.Equal(Cursor.Position(c), 2, "advanced position");
}

test StartsWithPrefix {
    Assert.True(Cursor.StartsWith(Cursor.From("hello"), "hel"), "prefix match");
}

test RemainingAfterAdvance {
    Cursor.TextCursor c = Cursor.Advance(Cursor.From("abcdef"), 2);
    string rest = Cursor.Remaining(c);
    Assert.Equal(rest, "cdef", "remaining slice");
}

// ---- TextParserTests.bd (formerly target `TextParserTests`) ----

// Core.Text.Parser combinator tests.

test ParserModuleImports {
    Assert.True(true, "parser modules resolve");
}

test LiteralMatchesUsingCursor {
    Cursor.TextCursor c = Cursor.From("abc");
    Assert.True(Cursor.StartsWith(c, "ab"), "cursor prefix");
    Assert.True(Parser.IsOk(Parser.Literal(Cursor.From("abc"), "ab", "test")), "literal parse");
}

test ChoiceSecondBranch {
    Cursor.TextCursor c = Cursor.From("z");
    Parser.Result.TextParseResult<string> a = Parser.Literal(Cursor.From("z"), "a", "a");
    Parser.Result.TextParseResult<string> z = Parser.Literal(Cursor.From("z"), "z", "z");
    Assert.True(!Parser.IsOk(a), "wrong branch fails");
    Assert.True(Parser.IsOk(z), "z branch ok");
    Assert.True(Parser.IsOk(Parser.Choice2(Cursor.From("z"), "choice", a, z)), "choice ok");
}

// ---- TextRegexTests.bd (formerly target `TextRegexTests`) ----

// Core.Text.Regex combinator-backed match tests.

test LowerClassQuantifierMatchesPrefix {
    Assert.True(Regex.Matches("[a-z]+", "abc123"), "expected lower-class run");
}

test DigitClassFindsDigits {
    Assert.True(Regex.Finds("[0-9]+", "x99y"), "expected digit run via find");
}

test NestedBranchSearchStopsAtEnclosingGroup {
    Assert.Equal(Engine.NextPatBranch("(x|y)|z", 3), -1, "inner branch must not escape its group");
}

test AlternationGroupMatchesSecondBranch {
    Assert.True(Regex.Matches("(foo|bar)", "bar"), "expected alternation group");
}

test AnchorStartEndFullString {
    Assert.True(Regex.Matches("^abc$", "abc"), "expected anchored full match");
}

test WordEscapeMatchesIdentifier {
    Assert.True(Regex.Matches("\\w+", "Z9_"), "expected word escape");
}

test InvalidPatternRejected {
    Assert.False(Regex.Matches("[unterminated", "abc"), "invalid pattern");
}

test FindAllCollectsNonOverlappingRuns {
    Assert.True(!Regex.IsFindAllEmpty(Regex.FindAll("[a-z]+", "a1bb2ccc")), "expected find-all matches");
}

// ---- TextCasingTests.bd (formerly target `TextCasingTests`) ----

// Core.Text.Casing conversion tests.

test SnakeToPascalMapsRuleNames {
    Assert.Equal(Casing.SnakeToPascal("lower_run"), "LowerRun", "snake to pascal");
    Assert.Equal(Casing.SnakeToPascal("digit"), "Digit", "single segment");
}

test PascalToSnakeRoundTrip {
    string snake = Casing.PascalToSnake("ParseLowerRun");
    Assert.Equal(snake, "parse_lower_run", "pascal to snake");
}

test CallableFromSnakeAddsPrefix {
    Assert.Equal(Casing.CallableFromSnake("pat_branch", "Parse"), "ParsePatBranch", "callable prefix");
}

test CamelSnakeConversions {
    Assert.Equal(Casing.SnakeToCamel("word_tail"), "wordTail", "snake to camel");
    Assert.Equal(Casing.CamelToSnake("wordTail"), "word_tail", "camel to snake");
}

// ---- TextParserCombinatorTests.bd (formerly target `TextParserCombinatorTests`) ----

// Combinator smoke over Core.Text.Parser (PascalCase surface).

test LiteralMatchesPrefix {
    Cursor.TextCursor c = Cursor.From("hello");
    Parser.Result.TextParseResult<string> parsed = Parser.Literal(c, "hel", "literal");
    Assert.True(Parser.IsOk(parsed), "literal prefix should succeed");
    Cursor.TextCursor rest = Parser.RestOnOk(parsed, c);
    Assert.Equal(Cursor.Position(rest), 3, "literal advances cursor");
}

test Choice2TriesSecondBranch {
    Cursor.TextCursor c = Cursor.From("b");
    Parser.Result.TextParseResult<string> branchA = Parser.Literal(c, "a", "pick");
    Parser.Result.TextParseResult<string> branchB = Parser.Literal(c, "b", "pick");
    Parser.Result.TextParseResult<string> picked = Parser.Choice2(c, "pick", branchA, branchB);
    Assert.True(Parser.IsOk(picked), "Choice2 should take second branch");
}

test SatisfyReadsOneCodeUnit {
    Cursor.TextCursor c = Cursor.From("x");
    Parser.Result.TextParseResult<string> parsed = Parser.Satisfy(c, "any");
    Assert.True(Parser.IsOk(parsed), "Satisfy should read one unit");
}

// ---- PestGrammarParseTests.bd (formerly target `PestGrammarParseTests`) ----

// Smoke for checked-in regex.pest materialization (grammar roots + generated rules).

test ParseGrammarRulesReadsDigitRule {
    Cursor.TextCursor c = Cursor.From("5");
    Assert.True(Parser.IsOk(Generated.ParseDigit(c)), "ParseDigit should match subject digit");
}

test ParseGrammarRulesReadsLowerRunRule {
    Cursor.TextCursor c = Cursor.From("abc");
    Assert.True(Parser.IsOk(Generated.ParseLowerRun(c)), "ParseLowerRun should match lowercase run");
}

// ---- PestEmitGoldenTests.bd (formerly target `PestEmitGoldenTests`) ----

// Golden naming gate: generated callables are PascalCase (no Parse_snake_case).

test EmitIncludesParsePatCallable {
    Cursor.TextCursor c = Cursor.From("a|b");
    Assert.True(Parser.IsOk(Generated.ParsePat(c)), "ParsePat callable should parse pattern branch");
}

test EmitIncludesParseDigitCallable {
    Cursor.TextCursor c = Cursor.From("9");
    Assert.True(Parser.IsOk(Generated.ParseDigit(c)), "ParseDigit callable should parse digit atom");
}

// ---- TextRegexIntegrationTests.bd (formerly target `TextRegexIntegrationTests`) ----

// Integration tests for Core.Text.Regex over generated combinator parsers.

test GeneratedParseDigitCompilesViaRegexFacade {
    bool valid = Regex.IsValidPattern("a");
    Assert.True(valid, "simple alpha pattern should validate");
}

test RegexMatchLiteral {
    Assert.True(Regex.Matches("abc", "abc"), "literal match");
    Assert.False(Regex.Matches("abc", "xyz"), "literal mismatch");
}

test RegexFindDigitRun {
    Assert.True(Regex.Finds("[0-9]+", "x42y"), "find digit run");
}

test RegexMatchAlternation {
    Assert.True(Regex.Matches("(foo|bar)", "bar"), "alternation match");
}
