/// Key/value map backed by a typed `MapEntry[]` linear scan.
/// @tier(supported)
/// `Insert`, `Remove` and `Clear` change the map in place.
pub mod Core.Collections.Map.MapEntry;

use Core.Collections.Array;
use Core.Collections.Map.MapEntry;
use Core.Optional.Option;
use Core.Results;

[Isolated]
pub type Map<TKey, TValue> {
    MapEntry<TKey, TValue>[] entries,
    i64 count,

    pub i64 Count() {
        return this.count;
    }

    pub bool IsEmpty() {
        return this.count == 0;
    }

    /// Inserts `value` for `key`, replacing the value of an existing entry.
    pub unit Insert(mut this, TKey key, TValue value) {
        mut i64 index = 0;
        while index < this.count {
            MapEntry<TKey, TValue> entry = Array.Get<MapEntry<TKey, TValue>>(this.entries, index);
            if entry.key == key {
                MapEntry<TKey, TValue> updated = MapEntry<TKey, TValue> { key: key, value: value };
                Array.Set<MapEntry<TKey, TValue>>(this.entries, index, updated);
                return;
            }
            index = index + 1;
        }
        MapEntry<TKey, TValue> fresh = MapEntry<TKey, TValue> { key: key, value: value };
        Array.Append<MapEntry<TKey, TValue>>(this.entries, fresh);
        this.count = this.count + 1;
        return;
    }

    pub Result<TValue, string> Get(TKey key) {
        mut i64 index = 0;
        while index < this.count {
            MapEntry<TKey, TValue> entry = Array.Get<MapEntry<TKey, TValue>>(this.entries, index);
            if entry.key == key {
                return Result::Ok(entry.value);
            }
            index = index + 1;
        }
        return Result::Error("key not found");
    }

    pub bool ContainsKey(TKey key) {
        mut i64 index = 0;
        while index < this.count {
            if Array.Get<MapEntry<TKey, TValue>>(this.entries, index).key == key {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /// Returns the keys in current entry order as a new array.
    /// Entry order is an edit history (insertion order, shifted by `Remove`), not a sort order;
    /// callers that need deterministic output sort the result. Later map mutation does not change
    /// the returned array.
    pub TKey[] Keys() {
        mut TKey[] keys = Array.Empty<TKey>();
        mut i64 index = 0;
        while index < this.count {
            Array.Append<TKey>(keys, Array.Get<MapEntry<TKey, TValue>>(this.entries, index).key);
            index = index + 1;
        }
        return keys;
    }

    /// Removes the entry for `key`; returns false when it is absent.
    pub bool Remove(mut this, TKey key) {
        mut i64 index = 0;
        while index < this.count {
            if Array.Get<MapEntry<TKey, TValue>>(this.entries, index).key == key {
                mut i64 shift = index;
                while shift + 1 < this.count {
                    Array.Set<MapEntry<TKey, TValue>>(this.entries, shift, Array.Get<MapEntry<TKey, TValue>>(this.entries, shift + 1));
                    shift = shift + 1;
                }
                Array.RemoveLast<MapEntry<TKey, TValue>>(this.entries);
                this.count = this.count - 1;
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /// Returns the value for `key`, or `None` when absent.
    pub Option<TValue> TryGet(TKey key) {
        mut i64 index = 0;
        while index < this.count {
            MapEntry<TKey, TValue> entry = Array.Get<MapEntry<TKey, TValue>>(this.entries, index);
            if entry.key == key {
                return Option::Some(entry.value);
            }
            index = index + 1;
        }
        return Option::None;
    }

    /// Returns the value for `key`, or `fallback` when absent.
    pub TValue GetOr(TKey key, TValue fallback) {
        mut i64 index = 0;
        while index < this.count {
            MapEntry<TKey, TValue> entry = Array.Get<MapEntry<TKey, TValue>>(this.entries, index);
            if entry.key == key {
                return entry.value;
            }
            index = index + 1;
        }
        return fallback;
    }

    /// Returns the values in the same order as `Keys()`.
    pub TValue[] Values() {
        mut TValue[] values = Array.Empty<TValue>();
        mut i64 index = 0;
        while index < this.count {
            Array.Append<TValue>(values, Array.Get<MapEntry<TKey, TValue>>(this.entries, index).value);
            index = index + 1;
        }
        return values;
    }

    /// Returns a copy of the entries in the same order as `Keys()`.
    pub MapEntry<TKey, TValue>[] Entries() {
        mut MapEntry<TKey, TValue>[] copy = Array.Empty<MapEntry<TKey, TValue>>();
        mut i64 index = 0;
        while index < this.count {
            Array.Append<MapEntry<TKey, TValue>>(copy, Array.Get<MapEntry<TKey, TValue>>(this.entries, index));
            index = index + 1;
        }
        return copy;
    }

    /// Removes every entry.
    pub unit Clear(mut this) {
        this.entries = Array.Empty<MapEntry<TKey, TValue>>();
        this.count = 0;
        return;
    }
}

pub Map<TKey, TValue> New<TKey, TValue>() {
    return Map<TKey, TValue> { entries: Array.Empty<MapEntry<TKey, TValue>>(), count: 0 };
}
