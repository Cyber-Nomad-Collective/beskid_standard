// EXPECT: E1236
// Every chunk body captures the `Reduce` seed, so the seed is used more than once: a Moved seed
// is rejected at the argument. Build a Moved accumulator inside the combiner instead.
use Core.Collections.List;
use Core.Parallel.Combiners;

[Isolated]
pub type Buffer {
    pub i64 size
}

[Immutable]
pub type Merge : Associative<Buffer> {
    pub Buffer Combine(Buffer a, Buffer b) {
        return Buffer { size: a.size + b.size };
    }
}

test moved_seed_is_rejected {
    List<Buffer> chunks = List.New<Buffer>();
    Buffer total = chunks.Parallel().Reduce(Buffer { size: 0_i64 }, Merge { });
}
