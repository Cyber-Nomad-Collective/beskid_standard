test aes_gcm_tc15 {
    match AesGcm.New(Hex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("cafebabefacedbaddecaf888"), Hex(""), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")));
            Assert.True(Same(sealed, Hex("522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015adb094dac5d93471bdec1a502270e3cc6c")), "sealed");
            Assert.True(Same(Unwrap(AesGcm.Open(key, Hex("cafebabefacedbaddecaf888"), Hex(""), sealed)), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")), "opened");
        },
    };
}
test aes_gcm_tc16 {
    match AesGcm.New(Hex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")));
            Assert.True(Same(sealed, Hex("522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b")), "sealed");
            Assert.True(Same(Unwrap(AesGcm.Open(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), sealed)), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")), "opened");
        },
    };
}
test aes_gcm_rejects_tampering {
    match AesGcm.New(Hex("feffe9928665731c6d6a8f9467308308")) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")));
            mut i64 position = 0_i64;
            while position < Slice.Len(sealed) {
                u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
                copy[position] = (copy[position] | 0x80_u8) - (copy[position] & 0x80_u8);
                bool failed = match AesGcm.Open(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), copy) {
                    Result::Ok(_) => false,
                    Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, },
                };
                Assert.True(failed, "tampered byte rejected");
                position = position + 7_i64;
            }
            bool wrongNonce = match AesGcm.Open(key, Hex("cafebabefacedbaddecaf889"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), sealed) { Result::Ok(_) => false, Result::Error(_) => true, };
            Assert.True(wrongNonce, "nonce bound");
            bool badNonce = match AesGcm.Seal(key, Hex("cafebabe"), Hex(""), Hex("")) { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::InvalidNonceLength => true, _ => false, }, };
            Assert.True(badNonce, "nonce length");
        },
    };
}
test aes_gcm_4000_bytes {
    match AesGcm.New(Range(16_i64)) {
        Result::Error(_) => { Assert.Fail("key"); },
        Result::Ok(key) => {
            u8[] pt = Slice.New(4000_i64);
            mut i64 i = 0_i64;
            while i < 4000_i64 { pt[i] = u8((i * 31_i64 + 7_i64) & 255_i64); i = i + 1_i64; }
            u8[] sealed = Unwrap(AesGcm.Seal(key, Range(12_i64), Range(37_i64), pt));
            Assert.True(Same(sealed, Hex("")), "sealed");
        },
    };
}
