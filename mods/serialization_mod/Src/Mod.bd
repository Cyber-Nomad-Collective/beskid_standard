use Beskid.Compiler.Collect;
use SerializationMod.Attributes;
use SerializationMod.Collect as Selection;
use SerializationMod.Driver;

pub type SerializeAttributes : AttributeGenerator {
    pub AttributeDeclarationSet Attributes(AttributeGenerationRequest request) {
        return Attributes.Declarations();
    }
}

pub type SerializeCollector : Collector {
    pub CollectTargetSet Collect(CollectRequest request) {
        return Selection.Targets(request);
    }
}

pub type AttributeFactory : ModFactory<SerializeAttributes> {
    pub SerializeAttributes Create(CollectRequest context) { return SerializeAttributes {}; }
}

pub type CollectorFactory : ModFactory<SerializeCollector> {
    pub SerializeCollector Create(CollectRequest context) { return SerializeCollector {}; }
}

pub type SerializeGenerator : Generator {
    pub GeneratedSyntaxContribution Generate(GenerationRequest request) { return Driver.Generate(request); }
}

pub type SerializeAnalyzer : Analyzer {
    pub AnalysisResult Analyze(AnalysisRequest request) { return Driver.Analyze(request); }
}

pub type GeneratorFactory : ModFactory<SerializeGenerator> {
    pub SerializeGenerator Create(CollectRequest context) { return SerializeGenerator {}; }
}

pub type AnalyzerFactory : ModFactory<SerializeAnalyzer> {
    pub SerializeAnalyzer Create(CollectRequest context) { return SerializeAnalyzer {}; }
}
