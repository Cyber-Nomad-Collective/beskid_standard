            %v69 = swizzle %k50, %v57
            %v70 = swizzle %k50, %v58
            %v71 = bxor %v67, %v46
            %v72 = bxor %v68, %v47
            %v73 = bxor %v69, %v48
            %v74 = bxor %v70, %v49
            %v75 = swizzle %k50, %v63
            %v76 = swizzle %k50, %v64
            %v77 = swizzle %k50, %v65
            %v78 = swizzle %k50, %v66
