/// LIFO stack backed by typed `T[]` storage.
/// @tier(supported)
/// `Push` and `Pop` change the stack in place.
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;

[Isolated]
pub type Stack<T> {
    T[] storage;
    i64 count;

    pub i64 Count() {
        return this.count;
    }

    pub bool IsEmpty() {
        return this.count == 0;
    }

    /// Puts `value` on top of the stack.
    pub unit Push(mut this, T value) {
        Array.Append<T>(this.storage, value);
        this.count = this.count + 1;
        return;
    }

    /// Removes and returns the top value, or `None` when empty.
    pub Option<T> Pop(mut this) {
        if this.count == 0 {
            return Option::None;
        }
        Option<T> top = Option::Some(Array.Get<T>(this.storage, this.count - 1));
        Array.RemoveLast<T>(this.storage);
        this.count = this.count - 1;
        return top;
    }

    pub Result<T, string> Peek() {
        if this.count == 0 {
            return Result::Error("stack is empty");
        }
        return Result::Ok(Array.Get<T>(this.storage, this.count - 1));
    }
}

pub Stack<T> New<T>() {
    return Stack<T> { storage: Array.Empty<T>(), count: 0 };
}

/// Bulk constructor: packs call-site scalars into a stack.
/// Iterates the bulk array and pushes each value with `Stack.Push`.
pub Stack<T> Of<T>(bulk T[] values) {
    Stack<T> result = New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result.Push(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}
