/// Canonical compiler facts required by the native BSOL schema consumer.
use Core.Bsol.Schema;

use Core.Collections.Array;

use Core.Output;

use Core.String;

use Testing.Assert;

type InnerOwner
{
    i64[] values,
}

type OuterOwner
{
    InnerOwner inner,
}

type EnumHolder
{
    Schema.DiagnosticStage stage,
}

test bsol_prerequisite_direct_local_array_owner_control
{
    mut i64[] values = [];

    Array.Append<i64>(values, 7_i64);

    Assert.Equal(Array.Len<i64>(values), 1_i64, "direct local owner append control");

    Assert.Equal(values[0], 7_i64, "direct local typed element retained");
}

test bsol_prerequisite_nested_aggregate_array_owner
{
    mut OuterOwner outer = OuterOwner
    {
        inner: InnerOwner
        {
            values: Array.Empty<i64>(),
        },
    };

    Array.Append<i64>(outer.inner.values, 7_i64);

    i64 count = Array.Len<i64>(outer.inner.values);

    Output.WriteLine("BSOL nested owner count " + count);

    Assert.Equal(count, 1_i64, "nested aggregate collection owner publication");

    Assert.Equal(outer.inner.values[0], 7_i64, "nested typed owner store retained");
}

test bsol_prerequisite_direct_enum_match_call_argument_control
{
    Schema.DiagnosticStage stage = Schema.DiagnosticStage::Profile;

    Assert.True(match stage
    {
        Schema.DiagnosticStage::Profile => true,

        _ => false,
    }, "direct enum match expression feeds assertion call");
}

test bsol_prerequisite_indexed_aggregate_enum_match_call_argument
{
    EnumHolder[] values = [EnumHolder
    {
        stage: Schema.DiagnosticStage::Profile,
    }];

    Assert.True(match values[0].stage
    {
        Schema.DiagnosticStage::Profile => true,

        _ => false,
    }, "indexed aggregate enum match expression feeds assertion call");
}

type GrowthProfile
{
    i64[] roots,

    string[] labels,
}

type GrowthLoader
{
    GrowthProfile profile,
}

test bsol_prerequisite_repeated_nested_owner_growth_keeps_managed_elements
{
    mut GrowthLoader loader = GrowthLoader
    {
        profile: GrowthProfile
        {
            roots: Array.Empty<i64>(),

            labels: Array.Empty<string>(),
        },
    };

    mut i64 index = 0_i64;

    while (index < 128_i64)
    {
        Array.Append<i64>(loader.profile.roots, index);
        string label = String.SubSlice("owned managed label", 0_i64, 19_i64);
        Array.Append<string>(loader.profile.labels, label);
        index = index + 1_i64;
    }

    Assert.CollectGarbage();

    Assert.Equal(Array.Len<i64>(loader.profile.roots), 128_i64, "repeated Loader/Profile numeric owner growth");

    Assert.Equal(Array.Len<string>(loader.profile.labels), 128_i64, "repeated Loader/Profile managed owner growth");

    index = 0_i64;

    while (index < 128_i64)
    {
        Assert.Equal(loader.profile.roots[index], index, "all grown numeric values survive publication");
        Assert.Equal(loader.profile.labels[index], "owned managed label", "all grown managed values survive collection");
        index = index + 1_i64;
    }
}
