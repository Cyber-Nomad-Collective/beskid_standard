/// Version-one Glue value adapter over the shared format-neutral DataValue.
/// This module is a wire adapter, never an owner/descriptor capability issuer.
use Core.Results;
use Core.Collections.Array;
use Core.String;
use Core.String.Utf8;
use Core.Numeric.UnicodeScalar;
use Core.Serialization.DataValue;
use Core.Serialization.Metadata;

pub enum CodecError { Invalid(), Truncated(), Limit(), Trailing(), }
type State { pub u8[] bytes, pub i64 offset, pub i64 nodes, pub bool failed, }

bool Width(u8 width) { return width == 8_u8 || width == 16_u8 || width == 32_u8 || width == 64_u8; }
bool SignedRange(i64 value, u8 width) {
    if !Width(width) { return false; }
    if width == 64_u8 { return true; }
    if width == 32_u8 { return value >= -2147483648_i64 && value <= 2147483647_i64; }
    if width == 16_u8 { return value >= -32768_i64 && value <= 32767_i64; }
    return width == 8_u8 && value >= -128_i64 && value <= 127_i64;
}
bool UnsignedRange(u64 value, u8 width) {
    if !Width(width) { return false; }
    if width == 64_u8 { return true; }
    if width == 32_u8 { return value <= 4294967295_u64; }
    if width == 16_u8 { return value <= 65535_u64; }
    return width == 8_u8 && value <= 255_u64;
}
unit Byte(State state, u8 value) {
    if state.failed { return; }
    if Array.Len(state.bytes) >= 16777216 { state.failed = true; return; }
    Array.Append(state.bytes, value);
}
unit Number(State state, mut u64 value, i64 count) {
    mut i64 index = 0;
    while index < count { Byte(state, u8(value % 256_u64)); value = value / 256_u64; index = index + 1; }
}
unit Count(State state, i64 count) {
    if count < 0 || count > 1048576 { state.failed = true; return; }
    Number(state, u64(count), 4);
}
unit Text(State state, string value) {
    i64 length = String.Len(value);
    if length > 1048576 { state.failed = true; return; }
    Number(state, u64(length), 4);
    mut i64 index = 0;
    while index < length { Byte(state, String.ByteAt(value,index)); index = index + 1; }
}
unit Shape(State state, Metadata.ShapeId value) {
    string text = Metadata.FormatShapeId(value);
    if String.Len(text) != 64 { state.failed = true; return; }
    mut i64 index = 0;
    while index < 64 {
        i64 a = Hex(String.ByteAt(text,index)); i64 b = Hex(String.ByteAt(text,index+1));
        if a < 0 || b < 0 { state.failed = true; return; }
        Byte(state,u8(a*16_i64+b)); index = index + 2;
    }
}
i64 Hex(u8 value) {
    if value >= 48_u8 && value <= 57_u8 { return i64(value)-48; }
    if value >= 97_u8 && value <= 102_u8 { return i64(value)-87; }
    return -1;
}
unit Values(State state, DataValue[] values, i64 depth) {
    Count(state,Array.Len(values)); mut i64 index = 0;
    while index < Array.Len(values) { Value(state,values[index],depth+1); index = index + 1; }
}
unit Value(State state, DataValue value, i64 depth) {
    if state.failed { return; }
    state.nodes = state.nodes + 1;
    if depth > 64 || state.nodes > 1048576 { state.failed = true; return; }
    match value {
        DataValue::Unit => { Byte(state,0_u8); },
        DataValue::Boolean(v) => { Byte(state,1_u8); if v { Byte(state,1_u8); } else { Byte(state,0_u8); } },
        DataValue::Signed(v,w) => { if !SignedRange(v,w) { state.failed=true; return; } Byte(state,2_u8);Byte(state,w);Number(state,u64(v),8); },
        DataValue::Unsigned(v,w) => { if !UnsignedRange(v,w) { state.failed=true; return; } Byte(state,3_u8);Byte(state,w);Number(state,v,8); },
        DataValue::Float(v,w) => { if (w != 32_u8 && w != 64_u8) || (w == 32_u8 && v > 4294967295_u64) { state.failed=true; return; } Byte(state,4_u8);Byte(state,w);Number(state,v,8); },
        DataValue::Scalar(v) => { Byte(state,5_u8);Number(state,u64(UnicodeScalar.ToCodePoint(v)),4); },
        DataValue::String(v) => { Byte(state,6_u8);Text(state,v); },
        DataValue::Bytes(v) => { Byte(state,7_u8);i64 len=Array.Len(v);if len>1048576 {state.failed=true;return;}Number(state,u64(len),4);mut i64 i=0;while i<len {Byte(state,v[i]);i=i+1;} },
        DataValue::Sequence(kind,values) => { match kind { SequenceKind::Array => {Byte(state,8_u8);},SequenceKind::List => {Byte(state,9_u8);}, };Values(state,values,depth); },
        DataValue::Record(shape,fields) => { Byte(state,10_u8);Shape(state,shape);Count(state,Array.Len(fields));mut i64 i=0;while i<Array.Len(fields) {mut i64 j=0;while j<i {if fields[j].name==fields[i].name {state.failed=true;return;}j=j+1;}Text(state,fields[i].name);Value(state,fields[i].value,depth+1);i=i+1;} },
        DataValue::Map(entries) => { Byte(state,11_u8);Count(state,Array.Len(entries));mut i64 i=0;while i<Array.Len(entries) {mut i64 j=0;while j<i {if entries[j].key==entries[i].key {state.failed=true;return;}j=j+1;}Text(state,entries[i].key);Value(state,entries[i].value,depth+1);i=i+1;} },
        DataValue::Variant(shape,name,payload) => {Byte(state,12_u8);Shape(state,shape);Text(state,name);Values(state,payload,depth);},
        DataValue::Optional(present,payload) => {if (present && Array.Len(payload)!=1)||(!present&&Array.Len(payload)!=0){state.failed=true;return;}Byte(state,13_u8);if present {Byte(state,1_u8);}else{Byte(state,0_u8);}Values(state,payload,depth);},
    };
}
pub Result<u8[],CodecError> Encode(DataValue value) {
    State state=State {bytes:Array.Empty<u8>(),offset:0,nodes:0,failed:false};
    Value(state,value,0);
    if state.failed {return Result::Error(CodecError::Invalid);}
    return Result::Ok(state.bytes);
}
u64 ReadNumber(State state, i64 count) {
    if state.failed || count > Array.Len(state.bytes)-state.offset {state.failed=true;return 0_u64;}
    mut u64 value=0_u64;mut u64 factor=1_u64;mut i64 index=0;
    while index<count {value=value+u64(state.bytes[state.offset])*factor;state.offset=state.offset+1;index=index+1;if index<count {factor=factor*256_u64;}}
    return value;
}
i64 ReadCount(State state) {
    u64 count=ReadNumber(state,4);
    if count>1048576_u64 || count>u64(Array.Len(state.bytes)-state.offset) {state.failed=true;return 0;}
    return i64(count);
}
pub bool ValidUtf8(u8[] bytes) {
    mut i64 index=0;i64 length=Array.Len(bytes);
    while index<length {
        u8 lead=bytes[index];mut i64 count=0;mut u32 scalar=0_u32;mut u32 minimum=0_u32;
        if lead<128_u8 {count=1;scalar=u32(lead);}
        else if lead>=194_u8&&lead<=223_u8 {count=2;scalar=u32(lead)-192_u32;minimum=128_u32;}
        else if lead>=224_u8&&lead<=239_u8 {count=3;scalar=u32(lead)-224_u32;minimum=2048_u32;}
        else if lead>=240_u8&&lead<=244_u8 {count=4;scalar=u32(lead)-240_u32;minimum=65536_u32;}
        else {return false;}
        if count>length-index {return false;}
        mut i64 part=1;while part<count {u8 next=bytes[index+part];if next<128_u8||next>191_u8 {return false;}scalar=scalar*64_u32+u32(next)-128_u32;part=part+1;}
        if scalar<minimum||scalar>1114111_u32||(scalar>=55296_u32&&scalar<=57343_u32){return false;}
        index=index+count;
    }
    return true;
}
u8[] ReadBytes(State state) {
    i64 count=ReadCount(state);u8[] bytes=Array.Empty<u8>();
    if state.failed{return bytes;}
    mut i64 index=0;while index<count {Array.Append(bytes,state.bytes[state.offset]);state.offset=state.offset+1;index=index+1;}
    return bytes;
}
string ReadText(State state) {
    u8[] bytes=ReadBytes(state);
    if state.failed||!ValidUtf8(bytes){state.failed=true;return "";}
    return Utf8.FromUtf8CodeUnits(bytes);
}
Result<Metadata.ShapeId,CodecError> ReadShape(State state) {
    mut string hex="";mut i64 index=0;
    while index<32 {u64 value=ReadNumber(state,1);u8 high=u8(value/16_u64);u8 low=u8(value%16_u64);if high<10_u8{hex=hex+String.CodeUnitChar(high+48_u8);}else{hex=hex+String.CodeUnitChar(high+87_u8);}if low<10_u8{hex=hex+String.CodeUnitChar(low+48_u8);}else{hex=hex+String.CodeUnitChar(low+87_u8);}index=index+1;}
    if state.failed{return Result::Error(CodecError::Truncated);}
    return match Metadata.ParseShapeId(hex) {Result::Ok(shape)=>Result::Ok(shape),Result::Error(error)=>Result::Error(CodecError::Invalid),};
}
DataValue[] ReadValues(State state,i64 depth) {
    i64 count=ReadCount(state);DataValue[] values=Array.Empty<DataValue>();
    if count>1048576-state.nodes {state.failed=true;return values;}
    mut i64 index=0;while index<count&&!state.failed {Array.Append(values,ReadValue(state,depth+1));index=index+1;}
    return values;
}
DataValue ReadValue(State state,i64 depth) {
    state.nodes=state.nodes+1;
    if state.failed||state.nodes>1048576||depth>64 {state.failed=true;return DataValue::Unit;}
    u64 tag=ReadNumber(state,1);
    if tag==0_u64 {return DataValue::Unit;}
    if tag==1_u64 {u64 value=ReadNumber(state,1);if value>1_u64{state.failed=true;}return DataValue::Boolean(value==1_u64);}
    if tag==2_u64 {u8 width=u8(ReadNumber(state,1));i64 value=i64(ReadNumber(state,8));if !SignedRange(value,width){state.failed=true;}return DataValue::Signed(value,width);}
    if tag==3_u64 {u8 width=u8(ReadNumber(state,1));u64 value=ReadNumber(state,8);if !UnsignedRange(value,width){state.failed=true;}return DataValue::Unsigned(value,width);}
    if tag==4_u64 {u8 width=u8(ReadNumber(state,1));u64 bits=ReadNumber(state,8);if (width!=32_u8&&width!=64_u8)||(width==32_u8&&bits>4294967295_u64){state.failed=true;}return DataValue::Float(bits,width);}
    if tag==5_u64 {
        u32 scalar=u32(ReadNumber(state,4));
        match UnicodeScalar.FromCodePoint(scalar) {
            Result::Ok(value)=>{return DataValue::Scalar(value);},
            Result::Error(error)=>{state.failed=true;return DataValue::Unit;},
        };
    }
    if tag==6_u64 {return DataValue::String(ReadText(state));}
    if tag==7_u64 {return DataValue::Bytes(ReadBytes(state));}
    if tag==8_u64 {return DataValue::Sequence(SequenceKind::Array,ReadValues(state,depth));}
    if tag==9_u64 {return DataValue::Sequence(SequenceKind::List,ReadValues(state,depth));}
    if tag==10_u64 {
        match ReadShape(state) {
            Result::Ok(shape)=>{return ReadRecord(state,shape,depth);},
            Result::Error(error)=>{state.failed=true;return DataValue::Unit;},
        };
    }
    if tag==11_u64 {
        i64 count=ReadCount(state);MapEntry[] entries=Array.Empty<MapEntry>();if count>1048576-state.nodes{state.failed=true;return DataValue::Unit;}
        mut i64 index=0;while index<count&&!state.failed {string key=ReadText(state);mut i64 previous=0;while previous<index {if entries[previous].key==key{state.failed=true;}previous=previous+1;}DataValue value=ReadValue(state,depth+1);Array.Append(entries,MapEntry{key:key,value:value});index=index+1;}
        return DataValue::Map(entries);
    }
    if tag==12_u64 {
        match ReadShape(state) {
            Result::Ok(shape)=>{return ReadVariant(state,shape,depth);},
            Result::Error(error)=>{state.failed=true;return DataValue::Unit;},
        };
    }
    if tag==13_u64 {u64 flag=ReadNumber(state,1);DataValue[] payload=ReadValues(state,depth);if flag>1_u64||(flag==1_u64&&Array.Len(payload)!=1)||(flag==0_u64&&Array.Len(payload)!=0){state.failed=true;}return DataValue::Optional(flag==1_u64,payload);}
    state.failed=true;return DataValue::Unit;
}
DataValue ReadRecord(State state,Metadata.ShapeId shape,i64 depth) {
    i64 count=ReadCount(state);RecordField[] fields=Array.Empty<RecordField>();
    if count>1048576-state.nodes{state.failed=true;return DataValue::Unit;}
    mut i64 index=0;while index<count&&!state.failed {string name=ReadText(state);mut i64 previous=0;while previous<index {if fields[previous].name==name{state.failed=true;}previous=previous+1;}DataValue value=ReadValue(state,depth+1);Array.Append(fields,RecordField{name:name,value:value});index=index+1;}
    return DataValue::Record(shape,fields);
}
DataValue ReadVariant(State state,Metadata.ShapeId shape,i64 depth) {
    string name=ReadText(state);
    return DataValue::Variant(shape,name,ReadValues(state,depth));
}
pub Result<DataValue,CodecError> Decode(u8[] bytes) {
    if Array.Len(bytes)>16777216{return Result::Error(CodecError::Limit);}
    State state=State{bytes:bytes,offset:0,nodes:0,failed:false};DataValue value=ReadValue(state,0);
    if state.failed{return Result::Error(CodecError::Invalid);}
    if state.offset!=Array.Len(bytes){return Result::Error(CodecError::Trailing);}
    return Result::Ok(value);
}
