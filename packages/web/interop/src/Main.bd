use Concurrency.Fiber;
use Core.Bytes.Convert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Environment;
use Core.Optional.Option;
use Core.Output;
use Core.Results;
use Core.String;
use Codec.Hex;
use Http.Types;
use Http2.Server;
use Network.Errors as NetErrors;
use Network.Types as NetTypes;
use Network.Tcp.TcpListener;
use Tls.PeerKeys;
use Tls.TlsConfig;
use X509.X509Errors;
use Web;
use Web.WebClient;
use Web.WebConfig;
use Web.WebErrors;

// Interop driver for curl-interop.sh (not a Beskid test).
// WEB_INTEROP_MODE=server: TLS on 127.0.0.1:18443 (h2 and http/1.1) and plain
//   HTTP on 127.0.0.1:18080 (HTTP/1.1 and h2c); prints "ready" once both listen.
//   WEB_INTEROP_TLS_CONNECTIONS / WEB_INTEROP_PLAIN_CONNECTIONS bound each loop.
// WEB_INTEROP_MODE=client: one request to WEB_INTEROP_URL (WEB_INTEROP_METHOD,
//   WEB_INTEROP_BODY_BYTES, WEB_INTEROP_ALPN "h2,http/1.1" or "http/1.1"),
//   trusting only the test root; prints "<protocol> <status> <body>".

type Hello: RequestHandler {
    i64 tag,
    pub Response Handle(Request request) { return Answer(request); }
}

Response Answer(Request request) {
    mut Header[] headers = Array.Empty<Header>();
    Array.Append<Header>(headers, Header { name: "content-type", value: "text/plain" });
    if request.method == "POST" {
        return Response { status: 200_i64, reason: "OK", headers: headers, body: Convert.StringToBytes("received " + Dec(Slice.Len(request.body))) };
    }
    return Response { status: 200_i64, reason: "OK", headers: headers, body: Convert.StringToBytes("hello " + request.target) };
}

string Dec(i64 v) {
    if v < 0_i64 { return "-" + Dec(0_i64 - v); }
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

i64 EnvNumber(string name, i64 fallback) {
    string text = Option.UnwrapOr<string>(Environment.TryGet(name), "");
    i64 n = String.Len(text);
    if n == 0_i64 { return fallback; }
    mut i64 value = 0_i64;
    mut i64 i = 0_i64;
    while i < n {
        u8 b = String.ByteAt(text, i);
        value = value * 10_i64 + i64(b) - 48_i64;
        i = i + 1_i64;
    }
    return value;
}

SocketAddress Local(i64 port) {
    Port value = match NetTypes.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => NetTypes.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

TlsServerConfig ServerConfig() {
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    return WebConfig.ServerTls(TlsConfig.Chain1(ServerCertDer()), key);
}

WebServerConfig ServerPolicy(i64 connections) {
    mut WebServerConfig c = WebConfig.DefaultServer();
    c.maxConnections = connections;
    c.acceptTimeoutMillis = 600000_i64;
    return c;
}

unit TlsLoop(TcpListener l, i64 connections) {
    Hello handler = Hello { tag: 0_i64 };
    Result<i64, WebError> r = Web.ServeTls(l, ServerConfig(), handler, ServerPolicy(connections));
    match r {
        Result::Ok(n) => { Output.WriteLine("tls connections " + Dec(n)); },
        Result::Error(e) => { Output.WriteLine("tls loop failed " + WebErrors.KindOf(e)); },
    };
    return;
}

unit PlainLoop(TcpListener l, i64 connections) {
    Hello handler = Hello { tag: 0_i64 };
    Result<i64, WebError> r = Web.ServePlain(l, handler, ServerPolicy(connections));
    match r {
        Result::Ok(n) => { Output.WriteLine("plain connections " + Dec(n)); },
        Result::Error(e) => { Output.WriteLine("plain loop failed " + WebErrors.KindOf(e)); },
    };
    return;
}

i64 RunServer() {
    i64 tlsCount = EnvNumber("WEB_INTEROP_TLS_CONNECTIONS", 4_i64);
    i64 plainCount = EnvNumber("WEB_INTEROP_PLAIN_CONNECTIONS", 2_i64);
    Result<TcpListener, NetworkError> tlsBound = TcpListener.Bind(Local(18443_i64), 8_i64);
    Result<TcpListener, NetworkError> plainBound = TcpListener.Bind(Local(18080_i64), 8_i64);
    match tlsBound {
        Result::Error(_) => { Output.WriteLine("bind 18443 failed"); return 2_i64; },
        Result::Ok(tlsListener) => {
            match plainBound {
                Result::Error(_) => { Output.WriteLine("bind 18080 failed"); return 2_i64; },
                Result::Ok(plainListener) => { ServeBoth(tlsListener, plainListener, tlsCount, plainCount); },
            };
        },
    };
    return 0_i64;
}

unit ServeBoth(TcpListener tlsListener, TcpListener plainListener, i64 tlsCount, i64 plainCount) {
    TcpListener t = tlsListener;
    TcpListener p = plainListener;
    Output.WriteLine("ready");
    Fiber<unit> plain = spawn (() => PlainLoop(p, plainCount));
    TlsLoop(t, tlsCount);
    plain.Join();
    t.Close();
    p.Close();
    return;
}

string[] AlpnList(string text) {
    mut string[] out = Array.Empty<string>();
    if text == "http/1.1" {
        Array.Append<string>(out, "http/1.1");
        return out;
    }
    if text == "h2" {
        Array.Append<string>(out, "h2");
        return out;
    }
    return WebConfig.DefaultAlpn();
}

i64 RunClient() {
    string url = Option.UnwrapOr<string>(Environment.TryGet("WEB_INTEROP_URL"), "");
    string method = Option.UnwrapOr<string>(Environment.TryGet("WEB_INTEROP_METHOD"), "GET");
    string alpn = Option.UnwrapOr<string>(Environment.TryGet("WEB_INTEROP_ALPN"), "");
    i64 size = EnvNumber("WEB_INTEROP_BODY_BYTES", 0_i64);
    mut WebClientConfig config = WebConfig.DefaultClient();
    Result<CertificateVerification, X509Error> v = TlsConfig.Anchors(TlsConfig.Chain1(RootCertDer()));
    match v {
        Result::Ok(verification) => { config.trust = Option.FromValue<CertificateVerification>(verification); },
        Result::Error(_) => {},
    };
    config.alpn = AlpnList(alpn);
    Request request = Request { method: method, target: url, headers: Array.Empty<Header>(), body: Slice.New(size) };
    Result<WebResponse, WebError> r = Web.Exchange(request, config);
    match r {
        Result::Ok(w) => { Report(w); },
        Result::Error(e) => { Output.WriteLine("error " + WebErrors.KindOf(e) + " " + Dec(WebErrors.Detail(e))); return 1_i64; },
    };
    return 0_i64;
}

unit Report(WebResponse w) {
    Response response = w.response;
    string body = match Convert.BytesToString(response.body) { Result::Ok(t) => t, Result::Error(_) => "<binary>", };
    Output.WriteLine(w.protocol + " " + Dec(response.status) + " " + body);
    return;
}

i64 Run() {
    string mode = Option.UnwrapOr<string>(Environment.TryGet("WEB_INTEROP_MODE"), "server");
    if mode == "client" { return RunClient(); }
    return RunServer();
}

// Network waits need a fiber context, so the work runs in a spawned fiber.
pub i32 Main() {
    Fiber<i64> worker = spawn Run();
    i64 code = match worker.Join() { Result::Ok(c) => c, Result::Error(_) => 3_i64, };
    return i32(code);
}

