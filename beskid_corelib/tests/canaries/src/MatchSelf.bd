/// Canary: A `match` arm can yield `self` inside a method.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Optional.Option;

pub type Holder {
    i64 n,

    pub Holder OrSelf(Option<Holder> other) {
        return match other {
            Option::Some(h) => h,
            Option::None => self,
        };
    }
}

test match_yields_self_in_method {
    Holder h = Holder { n: 1 };
    Holder back = h.OrSelf(Option::None);
    Assert.True(back.n == 1, "match arm yielding self");
}
