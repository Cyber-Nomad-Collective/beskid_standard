use Concurrency;
use Concurrency.Fiber;
use Core.Collections.Array;
use Core.Time;
use Core.Results;
use Network.Errors;
use Network.Tcp.TcpStream;
use Connect;
use Connect.Failures;
use Connect.Policy;
use Testing.Assert;
use TestSupport;

pub i64 AttemptCount(ConnectError error)
{
    return Array.Len<AttemptFailure>(Failures.Attempts(error));
}

pub i64 AttemptKind(ConnectError error, i64 index)
{
    AttemptFailure[] attempts = Failures.Attempts(error);
    AttemptFailure failure = attempts[index];
    return NetworkKind(failure.error);
}

pub i64 AttemptPort(ConnectError error, i64 index)
{
    AttemptFailure[] attempts = Failures.Attempts(error);
    AttemptFailure failure = attempts[index];
    return failure.address.port.Value();
}

// Every address hangs: the overall deadline ends the race with a typed error
// that keeps both attempts as TimedOut.
Result<unit, NetworkError> DeadlineResult()
{
    Blackhole first = OpenBlackhole()?;
    Blackhole second = OpenBlackhole()?;
    ConnectPolicy policy = Policy.WithAttemptDelay(Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(400_i64)), Time.FromMilliseconds(100_i64));
    i64 before = Concurrency.NowMillis();
    match (Connect.ConnectAddresses(List2(first.address, second.address), policy))
    {
        Result::Ok(stream) => {
            stream.Close();
            Assert.Fail("a full accept queue cannot win");
        },
        Result::Error(error) => {
            i64 elapsed = Concurrency.NowMillis() - before;
            Assert.Equal<i64>(ErrorKind(error), 5_i64, "DeadlineExceeded");
            Assert.True(elapsed >= 350_i64, "the deadline is not cut short");
            Assert.Equal<i64>(AttemptCount(error), 2_i64, "both attempts are kept");
            Assert.Equal<i64>(AttemptKind(error, 0_i64), 2_i64, "first attempt timed out");
            Assert.Equal<i64>(AttemptKind(error, 1_i64), 2_i64, "second attempt timed out");
        },
    };
    CloseBlackhole(first);
    CloseBlackhole(second);
    return Result::Ok(());
}

unit DeadlineScenario()
{
    match (DeadlineResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("deadline scenario has no NetworkError"),
    };
}

test DeadlineExceededKeepsTimedOutAttempts
{
    Fiber<unit> scenario = spawn DeadlineScenario();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "deadline scenario joins");
}

// A deadline shorter than the attempt delay ends the race before a second attempt starts.
Result<unit, NetworkError> ShortDeadlineResult()
{
    Blackhole first = OpenBlackhole()?;
    Blackhole second = OpenBlackhole()?;
    ConnectPolicy policy = Policy.WithAttemptDelay(Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(150_i64)), Time.FromMilliseconds(2000_i64));
    match (Connect.ConnectAddresses(List2(first.address, second.address), policy))
    {
        Result::Ok(stream) => {
            stream.Close();
            Assert.Fail("a full accept queue cannot win");
        },
        Result::Error(error) => {
            Assert.Equal<i64>(ErrorKind(error), 5_i64, "DeadlineExceeded");
            Assert.Equal<i64>(AttemptCount(error), 1_i64, "only the first attempt started");
            Assert.Equal<i64>(AttemptPort(error, 0_i64), first.address.port.Value(), "attempt keeps its address");
        },
    };
    CloseBlackhole(first);
    CloseBlackhole(second);
    return Result::Ok(());
}

unit ShortDeadline()
{
    match (ShortDeadlineResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("short deadline scenario has no NetworkError"),
    };
}

test DeadlineShorterThanAttemptDelay
{
    Fiber<unit> scenario = spawn ShortDeadline();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "short deadline scenario joins");
}
