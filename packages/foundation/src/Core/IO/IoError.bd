use Core.IO.TransferFailure;

/// Typed transfer and close failures, independent of any transport.
/// Read and write failures carry one portable TransferFailure cause.
/// @tier(standard)
pub enum IoError {
    InvalidRange(),
    UnexpectedEof(i64 completed),
    NoProgress(),
    ReadFailed(TransferFailure cause),
    WriteFailed(TransferFailure cause),
    CloseFailed(),
}
