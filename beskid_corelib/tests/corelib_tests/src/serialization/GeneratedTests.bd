//! `SerializationGeneratedSuite`: adapters generated by the Serialization Mod for `[Serialize]` declarations
//! execute in an installed program (SER-01) and drive two formats through one descriptor and one typed
//! decoder (SER-03). Values are decoded at top level with `Bsol.Serialization.Read<T>` and
//! `Decoding.DecoderFor<T, R>`: the compiler issues the field decoder of each target, including the nested
//! `Pair<Point>` and `Signal` fields, through the typed field decoder factory correspondence. The second
//! format is a JSON test adapter defined here; its reader replays the typed calls its encoder recorded.

use Core.Bsol.Serialization;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Collections.List;
use Core.Collections.Map;
use Core.Numeric.FloatBits;
use Core.Optional.Option;
use Core.Results;
use Core.Serialization.Contracts;
use Core.Serialization.Decimal;
use Core.Serialization.Decoding;
use Core.Serialization.Descriptors;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Metadata;
use Core.Serialization.Reader as ReaderApi;
use Core.Serialization.Registry;
use Core.String;
use Testing.Assert;

[Serialize]
pub type Point {
    pub i32 x;
    pub i32 y;
}

[Serialize]
pub type Pair<T> {
    pub T left;
    pub T right;
}

[Serialize]
pub enum Signal {
    Idle,
    Level(i64 amount),
    Named(string label, u8 code),
}

[Serialize]
pub type Sample {
    pub f32 narrow;
    pub f64 wide;
}

[Serialize]
pub type Boxed<T> {
    pub T item;
    pub List<T> history;
}

[Serialize]
pub type FullShape {
    pub bool flag;
    pub i8 tiny;
    pub i16 small;
    pub i32 medium;
    pub i64 large;
    pub u8 octet;
    pub u16 port;
    pub u32 unsignedWord;
    pub u64 huge;
    pub f32 narrow;
    pub f64 wide;
    pub char letter;
    pub string text;
    [SerializeField(Bytes: true)] pub u8[] payload;
    pub unit nothing;
    pub Pair<Point> corners;
    pub i64[] samples;
    pub List<string> tags;
    pub Map<string, i64> counts;
    pub Signal signal;
    pub Option<i32[]> window;
    [SerializeField(WordWidth: 32)] pub word span;
}

/// Generated encoder into BSOL text, with the compiler-issued descriptor closure of T.
string EncodeBsol<T>(T value) where T: Contracts.Serializable<Serialization.WireEncoder> {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<T>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure registers");
    match Serialization.WriteTyped<T>(value, Descriptors.CompiledShape<T>().id, table, Limits.DefaultLimits()) {
        Result::Error(error) => { Assert.Fail("generated adapter writes BSOL: " + Errors.Code(error)); },
        Result::Ok(text) => { return text; },
    };
    return "";
}

/// Top-level typed decode of a `[Serialize]` target from BSOL text. A failure traps the test process,
/// so `original` is never returned in place of a decoded value.
T DecodeBsol<T>(string text, T original, string what) {
    match Serialization.Read<T>(text, Limits.DefaultLimits()) {
        Result::Error(error) => { Assert.Fail(what + " decodes from BSOL: " + Errors.Code(error)); },
        Result::Ok(value) => { return value; },
    };
    return original;
}

unit ExpectPoint(Point actual, i32 x, i32 y, string field) {
    Assert.Equal(actual.x, x, field + ".x keeps its exact value");
    Assert.Equal(actual.y, y, field + ".y keeps its exact value");
}

unit ExpectSignal(Signal actual, Signal expected, string what) {
    match expected {
        Signal::Idle => match actual {
            Signal::Idle => Assert.True(true, what + " is Idle"),
            _ => Assert.Fail(what + " keeps the Idle variant"),
        },
        Signal::Level(amount) => match actual {
            Signal::Level(decoded) => Assert.Equal(decoded, amount, what + " keeps its Level payload"),
            _ => Assert.Fail(what + " keeps the Level variant"),
        },
        Signal::Named(label, code) => match actual {
            Signal::Named(decodedLabel, decodedCode) => {
                Assert.Equal(decodedLabel, label, what + " keeps its Named label");
                Assert.Equal(decodedCode, code, what + " keeps its Named code");
            },
            _ => Assert.Fail(what + " keeps the Named variant"),
        },
    };
}

FullShape FullFixture() {
    return FullShape {
        flag: true,
        tiny: (-127_i8 - 1_i8),
        small: (-32767_i16 - 1_i16),
        medium: (-2147483647_i32 - 1_i32),
        large: -9223372036854775807_i64 - 1_i64,
        octet: 255_u8,
        port: 65535_u16,
        unsignedWord: 4294967295_u32,
        huge: 18446744073709551615_u64,
        narrow: FloatBits.FromBits32(0x80000000_u32),
        wide: FloatBits.FromBits64(0x3fb999999999999a_u64),
        letter: '😀',
        text: "zażółć 🙂",
        payload: [0_u8, 255_u8, 16_u8],
        nothing: (),
        corners: Pair<Point> { left: Point { x: 1_i32, y: -2_i32 }, right: Point { x: 2147483647_i32, y: (-2147483647_i32 - 1_i32) } },
        samples: [9007199254740993_i64, -9007199254740993_i64],
        tags: List.FromArray<string>(["first", "second"]),
        counts: SampleCounts(),
        signal: Signal::Named("probe", 7_u8),
        window: Option::Some([3_i32, -4_i32]),
        span: word(4294967295_u64),
    };
}

unit ExpectFullShape(FullShape decoded) {
    Assert.True(decoded.flag, "bool value");
    Assert.Equal(i64(decoded.tiny), -128_i64, "i8 minimum");
    Assert.Equal(i64(decoded.small), -32768_i64, "i16 minimum");
    Assert.Equal(i64(decoded.medium), -2147483648_i64, "i32 minimum");
    Assert.Equal(decoded.large, -9223372036854775807_i64 - 1_i64, "i64 minimum");
    Assert.Equal(decoded.octet, 255_u8, "u8 maximum");
    Assert.Equal(decoded.port, 65535_u16, "u16 maximum");
    Assert.Equal(decoded.unsignedWord, 4294967295_u32, "u32 maximum");
    Assert.Equal(decoded.huge, 18446744073709551615_u64, "u64 maximum");
    Assert.Equal(FloatBits.ToBits32(decoded.narrow), 0x80000000_u32, "f32 negative zero bits");
    Assert.Equal(FloatBits.ToBits64(decoded.wide), 0x3fb999999999999a_u64, "f64 one tenth bits");
    Assert.Equal(u32(decoded.letter), 128512_u32, "non-BMP char");
    Assert.Equal(decoded.text, "zażółć 🙂", "string");
    Assert.Equal(Array.Len<u8>(decoded.payload), 3_i64, "explicit bytes length");
    Assert.Equal(decoded.payload[1], 255_u8, "explicit bytes content");
    ExpectPoint(decoded.corners.left, 1_i32, -2_i32, "corners.left");
    ExpectPoint(decoded.corners.right, 2147483647_i32, (-2147483647_i32 - 1_i32), "corners.right");
    Assert.Equal(Array.Len<i64>(decoded.samples), 2_i64, "array length");
    Assert.Equal(decoded.samples[0], 9007199254740993_i64, "array item beyond 2^53");
    Assert.Equal(decoded.samples[1], -9007199254740993_i64, "negative array item beyond 2^53");
    Assert.Equal(decoded.tags.Count(), 2_i64, "list length");
    Assert.Equal(decoded.tags.ToArray()[0], "first", "first list item");
    Assert.Equal(decoded.tags.ToArray()[1], "second", "second list item");
    Assert.Equal(decoded.counts.Count(), 2_i64, "map entry count");
    Assert.Equal(decoded.counts.GetOr("alpha", 0_i64), 1_i64, "map value alpha");
    Assert.Equal(decoded.counts.GetOr("beta", 0_i64), 2_i64, "map value beta");
    ExpectSignal(decoded.signal, Signal::Named("probe", 7_u8), "signal");
    match decoded.window {
        Option::Some(window) => {
            Assert.Equal(Array.Len<i32>(window), 2_i64, "optional nested array length");
            Assert.Equal(window[1], -4_i32, "optional nested array item");
        },
        Option::None => Assert.Fail("present optional stays present"),
    };
    Assert.Equal(u64(decoded.span), 4294967295_u64, "word at its declared width");
}

test SerializationGeneratedFullShapeRecordRoundtripsThroughBsol {
    FullShape decoded = DecodeBsol<FullShape>(EncodeBsol<FullShape>(FullFixture()), FullFixture(), "FullShape");
    ExpectFullShape(decoded);
}

test SerializationGeneratedNestedGenericRecordDecodesAtTopLevel {
    Pair<Point> value = Pair<Point> { left: Point { x: 1_i32, y: -2_i32 }, right: Point { x: 2147483647_i32, y: (-2147483647_i32 - 1_i32) } };
    Pair<Point> decoded = DecodeBsol<Pair<Point>>(EncodeBsol<Pair<Point>>(value), value, "Pair<Point>");
    ExpectPoint(decoded.left, 1_i32, -2_i32, "left");
    ExpectPoint(decoded.right, 2147483647_i32, (-2147483647_i32 - 1_i32), "right");
    Point point = DecodeBsol<Point>(EncodeBsol<Point>(Point { x: -7_i32, y: 9_i32 }), Point { x: -7_i32, y: 9_i32 }, "Point");
    ExpectPoint(point, -7_i32, 9_i32, "top-level Point");
}

/// One recorded call of a hand-built JSON test tape.
TapeToken Call(string kind, string text, i64 signed, u8 width) {
    mut TapeToken token = TapeCall(kind);
    token.text = text;
    token.signed = signed;
    token.width = width;
    return token;
}

// Abstract fields bound to a scalar or a canonical container are written and read through the
// canonical writes and reads the field codec correspondence issues: a BSOL round trip, and
// hand-built typed call tapes of the JSON test format that pin the exact read calls.
test SerializationGeneratedScalarAndContainerApplicationsDecodeThroughOneCorrespondence {
    Boxed<i32> numbers = Boxed<i32> { item: -5_i32, history: List.FromArray<i32>([1_i32, -2_i32]) };
    Boxed<i32> roundNumbers = DecodeBsol<Boxed<i32>>(EncodeBsol<Boxed<i32>>(numbers), numbers, "Boxed<i32>");
    Assert.Equal(roundNumbers.item, -5_i32, "abstract field bound to i32 round-trips at its exact width");
    Assert.Equal(roundNumbers.history.Count(), 2_i64, "List<i32> round-trips its length");
    Assert.Equal(roundNumbers.history.ToArray()[1], -2_i32, "List<i32> round-trips its elements");
    Boxed<string> texts = Boxed<string> { item: "only", history: List.FromArray<string>(["first"]) };
    Boxed<string> roundTexts = DecodeBsol<Boxed<string>>(EncodeBsol<Boxed<string>>(texts), texts, "Boxed<string>");
    Assert.Equal(roundTexts.item, "only", "abstract field bound to string round-trips");
    Assert.Equal(roundTexts.history.ToArray()[0], "first", "List<string> round-trips its elements");
    JsonTraceEncoder traced = NewJsonTrace();
    Assert.True(Results.IsOk(Contracts.Encode<Boxed<i32>, JsonTraceEncoder>(numbers, traced, Limits.DefaultLimits())), "Boxed<i32> drives the JSON test format");
    Assert.Equal(traced.text, "{\"item\":-5,\"history\":[1,-2]}", "the issued i32 and List writes make the declared calls");
    string numbersShape = Metadata.FormatShapeId(Descriptors.CompiledShape<Boxed<i32>>().id);
    TapeToken[] numbersTape = [
        Call("record", numbersShape, 2_i64, 0_u8),
        Call("field", "item", 0_i64, 0_u8), Call("signed", "", -5_i64, 32_u8),
        Call("field", "history", 0_i64, 0_u8), Call("sequence", "", 2_i64, 0_u8),
        Call("signed", "", 1_i64, 32_u8), Call("signed", "", -2_i64, 32_u8),
    ];
    JsonTapeReader numbersReader = JsonTapeReader { tape: numbersTape, position: 0_i64 };
    match Contracts.Decode<Boxed<i32>, Decoding.IssuedDecoder<Boxed<i32>, JsonTapeReader>>(Decoding.DecoderFor<Boxed<i32>, JsonTapeReader>(numbersReader), Limits.DefaultLimits()) {
        Result::Error(error) => Assert.Fail("Boxed<i32> decodes: " + Errors.Code(error)),
        Result::Ok(decoded) => {
            Assert.Equal(decoded.item, -5_i32, "abstract field bound to i32 reads its exact width");
            Assert.Equal(decoded.history.Count(), 2_i64, "List<T> bound to List<i32> keeps its length");
            Assert.Equal(decoded.history.ToArray()[1], -2_i32, "List<i32> element");
        },
    };
    TapeToken[] wideTape = [
        Call("record", numbersShape, 2_i64, 0_u8),
        Call("field", "item", 0_i64, 0_u8), Call("signed", "", 5_i64, 64_u8),
        Call("field", "history", 0_i64, 0_u8), Call("sequence", "", 0_i64, 0_u8),
    ];
    JsonTapeReader wideReader = JsonTapeReader { tape: wideTape, position: 0_i64 };
    Assert.True(Results.IsError(Contracts.Decode<Boxed<i32>, Decoding.IssuedDecoder<Boxed<i32>, JsonTapeReader>>(Decoding.DecoderFor<Boxed<i32>, JsonTapeReader>(wideReader), Limits.DefaultLimits())), "the issued i32 read never accepts a 64-bit call");
    string textsShape = Metadata.FormatShapeId(Descriptors.CompiledShape<Boxed<string>>().id);
    TapeToken[] textsTape = [
        Call("record", textsShape, 2_i64, 0_u8),
        Call("field", "item", 0_i64, 0_u8), Call("string", "only", 0_i64, 0_u8),
        Call("field", "history", 0_i64, 0_u8), Call("sequence", "", 0_i64, 0_u8),
    ];
    JsonTapeReader textsReader = JsonTapeReader { tape: textsTape, position: 0_i64 };
    match Contracts.Decode<Boxed<string>, Decoding.IssuedDecoder<Boxed<string>, JsonTapeReader>>(Decoding.DecoderFor<Boxed<string>, JsonTapeReader>(textsReader), Limits.DefaultLimits()) {
        Result::Error(error) => Assert.Fail("Boxed<string> decodes: " + Errors.Code(error)),
        Result::Ok(decoded) => {
            Assert.Equal(decoded.item, "only", "abstract field bound to string");
            Assert.Equal(decoded.history.Count(), 0_i64, "empty List<string>");
        },
    };
    Boxed<Point> points = Boxed<Point> { item: Point { x: 3_i32, y: 4_i32 }, history: List.FromArray<Point>([Point { x: 5_i32, y: 6_i32 }]) };
    Boxed<Point> decodedPoints = DecodeBsol<Boxed<Point>>(EncodeBsol<Boxed<Point>>(points), points, "Boxed<Point>");
    ExpectPoint(decodedPoints.item, 3_i32, 4_i32, "abstract field bound to Point");
    ExpectPoint(decodedPoints.history.ToArray()[0], 5_i32, 6_i32, "List<Point> element");
}

/// Whether `declared` occurs in `observed` in the same order (nested field names may interleave).
bool InDeclaredOrder(string[] observed, string[] declared) {
    mut i64 next = 0_i64;
    mut i64 index = 0_i64;
    while (index < Array.Len<string>(observed) && next < Array.Len<string>(declared)) {
        if (observed[index] == declared[next]) { next = next + 1_i64; }
        index = index + 1_i64;
    }
    return next == Array.Len<string>(declared);
}

test SerializationGeneratedVariantIdentityAndFieldOrderSurviveTypedDecode {
    Signal[] values = [Signal::Idle, Signal::Level(-9007199254740993_i64), Signal::Named("", 0_u8), Signal::Named("probe", 255_u8)];
    mut i64 index = 0_i64;
    while (index < Array.Len<Signal>(values)) {
        ExpectSignal(DecodeBsol<Signal>(EncodeBsol<Signal>(values[index]), values[index], "Signal"), values[index], "Signal");
        index = index + 1_i64;
    }
    // Declared field order reaches the format and the compiled descriptor, and the typed decode of
    // that same call sequence reconstructs every field.
    JsonTraceEncoder json = NewJsonTrace();
    Assert.True(Results.IsOk(Contracts.Encode<FullShape, JsonTraceEncoder>(FullFixture(), json, Limits.DefaultLimits())), "FullShape drives the JSON test format");
    string[] declared = ["flag", "tiny", "small", "medium", "large", "octet", "port", "unsignedWord", "huge", "narrow", "wide", "letter", "text", "payload", "nothing", "corners", "samples", "tags", "counts", "signal", "window", "span"];
    Assert.Equal(json.fields[0], "flag", "the first written field is the first declared field");
    Assert.True(InDeclaredOrder(json.fields, declared), "record output follows declaration order");
    ShapeDescriptor full = Descriptors.CompiledShape<FullShape>();
    Assert.Equal(Array.Len<FieldDescriptor>(full.fields), Array.Len<string>(declared), "every declared field is in the descriptor");
    index = 0_i64;
    while (index < Array.Len<string>(declared)) {
        Assert.Equal(full.fields[index].name, declared[index], "descriptor field order is declaration order");
        index = index + 1_i64;
    }
    ExpectFullShape(DecodeJson<FullShape>(json, FullFixture(), "FullShape"));
}

test SerializationGeneratedF32AndF64BitsSurviveTypedDecode {
    Pair<Sample> value = Pair<Sample> {
        left: Sample { narrow: FloatBits.FromBits32(0x80000000_u32), wide: FloatBits.FromBits64(0x3fb999999999999a_u64) },
        right: Sample { narrow: FloatBits.FromBits32(0x3dcccccd_u32), wide: FloatBits.FromBits64(0x8000000000000000_u64) },
    };
    Pair<Sample> decoded = DecodeBsol<Pair<Sample>>(EncodeBsol<Pair<Sample>>(value), value, "Pair<Sample>");
    Assert.Equal(FloatBits.ToBits32(decoded.left.narrow), 0x80000000_u32, "BSOL f32 negative zero");
    Assert.Equal(FloatBits.ToBits64(decoded.left.wide), 0x3fb999999999999a_u64, "BSOL f64 one tenth");
    Assert.Equal(FloatBits.ToBits32(decoded.right.narrow), 0x3dcccccd_u32, "BSOL f32 one tenth without widening");
    Assert.Equal(FloatBits.ToBits64(decoded.right.wide), 0x8000000000000000_u64, "BSOL f64 negative zero");
}

test SerializationGeneratedWordUsesDeclaredWidthAndRangeChecks {
    mut FullShape fixture = FullFixture();
    fixture.span = word(4294967295_u64);
    Assert.Equal(u64(DecodeBsol<FullShape>(EncodeBsol<FullShape>(fixture), fixture, "FullShape").span), 4294967295_u64, "word maximum at its declared 32-bit width");
    fixture.span = word(4294967296_u64);
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<FullShape>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of FullShape registers");
    Assert.True(Results.IsError(Serialization.WriteTyped<FullShape>(fixture, Descriptors.CompiledShape<FullShape>().id, table, Limits.DefaultLimits())), "word value above its declared width rejects instead of truncating");
}

test SerializationGeneratedDecoderRejectsTrailingInputWithoutPublishing {
    string text = EncodeBsol<Point>(Point { x: 1_i32, y: 2_i32 });
    Assert.True(Results.IsError(Serialization.Read<Point>(text + " trailing", Limits.DefaultLimits())), "trailing input fails Reader.Finish and publishes no Point");
    Assert.True(Results.IsError(Serialization.Read<Pair<Point>>(text, Limits.DefaultLimits())), "a Point document is not a Pair<Point>");
}

/// One recorded typed call of the JSON test format.
pub type TapeToken {
    pub string kind;
    pub string text;
    pub i64 signed;
    pub u64 unsigned;
    pub u8 width;
    pub bool flag;
    pub u8[] bytes;
}

TapeToken TapeCall(string kind) {
    return TapeToken { kind: kind, text: "", signed: 0_i64, unsigned: 0_u64, width: 0_u8, flag: false, bytes: [] };
}

/// JSON test format. It owns its representation: records and maps are objects, sequences are arrays,
/// variants are `{"$variant":name,"payload":[...]}`, absent optionals are `null`, and floats are written
/// as their exact bits with their width (`{"f32":bits}`), never as a coerced decimal. Besides its text it
/// records each typed call, which its reader replays.
pub type JsonTraceEncoder : Contracts.Encoder {
    pub string text;
    pub string[] shapes;
    pub string[] fields;
    pub i64[] floatWidths;
    pub TapeToken[] tape;

    pub Result<unit, SerializationError> Begin(SerializationLimits limits) {
        this.text = "";
        this.tape = [];
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> Commit() {
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        return Result::Ok(());
    }
    pub unit Abort() { this.text = ""; }
    pub Result<unit, SerializationError> WriteUnit() {
        this.text = this.text + "null,";
        return this.Push(TapeCall("unit"));
    }
    pub Result<unit, SerializationError> WriteBoolean(bool value) {
        if (value) { this.text = this.text + "true,"; } else { this.text = this.text + "false,"; }
        mut TapeToken token = TapeCall("bool");
        token.flag = value;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteSigned(i64 value, u8 width) {
        this.text = this.text + Decimal.Signed(value) + ",";
        mut TapeToken token = TapeCall("signed");
        token.signed = value;
        token.width = width;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteUnsigned(u64 value, u8 width) {
        this.text = this.text + Decimal.Unsigned(value) + ",";
        mut TapeToken token = TapeCall("unsigned");
        token.unsigned = value;
        token.width = width;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteFloat(u64 bits, u8 width) {
        this.floatWidths = Array.Append<i64>(this.floatWidths, i64(width));
        this.text = this.text + "{\"f" + Decimal.Unsigned(u64(width)) + "\":" + Decimal.Unsigned(bits) + "},";
        mut TapeToken token = TapeCall("float");
        token.unsigned = bits;
        token.width = width;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteScalar(char value) {
        this.text = this.text + "\"" + Decimal.Unsigned(u64(u32(value))) + "\",";
        mut TapeToken token = TapeCall("scalar");
        token.unsigned = u64(u32(value));
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteString(string value) {
        this.text = this.text + "\"" + value + "\",";
        mut TapeToken token = TapeCall("string");
        token.text = value;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> WriteBytes(u8[] value) {
        this.text = this.text + "\"bytes:" + Decimal.Signed(Array.Len<u8>(value)) + "\",";
        mut TapeToken token = TapeCall("bytes");
        // The encoder borrows `value`; the tape records its own copy.
        token.bytes = Slice.SubSlice(value, 0_i64, Array.Len<u8>(value));
        return this.Push(token);
    }
    pub Result<unit, SerializationError> BeginRecord(Metadata.ShapeId shape, i64 fieldCount) {
        this.shapes = Array.Append<string>(this.shapes, Metadata.FormatShapeId(shape));
        this.text = this.text + "{";
        mut TapeToken token = TapeCall("record");
        token.text = Metadata.FormatShapeId(shape);
        token.signed = fieldCount;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> BeginField(string name) {
        this.fields = Array.Append<string>(this.fields, name);
        this.text = this.text + "\"" + name + "\":";
        mut TapeToken token = TapeCall("field");
        token.text = name;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> EndField() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndRecord() { return this.Close("}"); }
    pub Result<unit, SerializationError> BeginSequence(i64 count) {
        this.text = this.text + "[";
        mut TapeToken token = TapeCall("sequence");
        token.signed = count;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> EndSequence() { return this.Close("]"); }
    pub Result<unit, SerializationError> BeginMap(i64 count) {
        this.text = this.text + "{";
        mut TapeToken token = TapeCall("map");
        token.signed = count;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> BeginMapEntry(string key) {
        this.text = this.text + "\"" + key + "\":";
        mut TapeToken token = TapeCall("entry");
        token.text = key;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> EndMapEntry() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndMap() { return this.Close("}"); }
    pub Result<unit, SerializationError> BeginVariant(Metadata.ShapeId shape, string name, i64 payloadCount) {
        this.shapes = Array.Append<string>(this.shapes, Metadata.FormatShapeId(shape));
        this.text = this.text + "{\"$variant\":\"" + name + "\",\"payload\":[";
        mut TapeToken token = TapeCall("variant");
        token.text = name;
        token.signed = payloadCount;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> EndVariant() {
        this.Close("]");
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        this.text = this.text + "},";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> BeginOptional(bool present) {
        if (!present) { this.text = this.text + "null,"; }
        mut TapeToken token = TapeCall("optional");
        token.flag = present;
        return this.Push(token);
    }
    pub Result<unit, SerializationError> EndOptional() { return Result::Ok(()); }

    Result<unit, SerializationError> Close(string closer) {
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        this.text = this.text + closer + ",";
        return Result::Ok(());
    }

    Result<unit, SerializationError> Push(TapeToken token) {
        this.tape = Array.Append<TapeToken>(this.tape, token);
        return Result::Ok(());
    }
}

JsonTraceEncoder NewJsonTrace() {
    return JsonTraceEncoder { text: "", shapes: Array.Empty<string>(), fields: Array.Empty<string>(), floatWidths: Array.Empty<i64>(), tape: [] };
}

/// The JSON test format reader. It owns its own policy: each typed read must meet the exact recorded call,
/// including declared integer and float widths, and every recorded call must be consumed.
pub type JsonTapeReader : ReaderApi.Reader {
    pub TapeToken[] tape;
    pub i64 position;

    pub ReaderApi.SourceLocation Location() { return ReaderApi.SourceLocation { path: "json-test", start: this.position, end: this.position }; }
    pub Result<unit, SerializationError> Begin(SerializationLimits limits) {
        this.position = 0_i64;
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> Finish() {
        if (this.position != Array.Len<TapeToken>(this.tape)) { return Result::Error(Errors.NumericError("TrailingInput")); }
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> ReadUnit() {
        this.Next("unit")?;
        return Result::Ok(());
    }
    pub Result<bool, SerializationError> ReadBoolean() {
        TapeToken token = this.Next("bool")?;
        return Result::Ok(token.flag);
    }
    pub Result<i64, SerializationError> ReadSigned(u8 width) {
        TapeToken token = this.Next("signed")?;
        if (token.width != width) { return Result::Error(Errors.NumericError("WidthMismatch")); }
        return Result::Ok(token.signed);
    }
    pub Result<u64, SerializationError> ReadUnsigned(u8 width) {
        TapeToken token = this.Next("unsigned")?;
        if (token.width != width) { return Result::Error(Errors.NumericError("WidthMismatch")); }
        return Result::Ok(token.unsigned);
    }
    pub Result<u64, SerializationError> ReadFloat(u8 width) {
        TapeToken token = this.Next("float")?;
        if (token.width != width) { return Result::Error(Errors.NumericError("WidthMismatch")); }
        return Result::Ok(token.unsigned);
    }
    pub Result<char, SerializationError> ReadScalar() {
        TapeToken token = this.Next("scalar")?;
        return Result::Ok(char(u32(token.unsigned)));
    }
    pub Result<string, SerializationError> ReadString() {
        TapeToken token = this.Next("string")?;
        return Result::Ok(token.text);
    }
    pub Result<u8[], SerializationError> ReadBytes() {
        TapeToken token = this.Next("bytes")?;
        return Result::Ok(token.bytes);
    }
    pub Result<i64, SerializationError> BeginRecord(Metadata.ShapeId shape) {
        TapeToken token = this.Next("record")?;
        if (token.text != Metadata.FormatShapeId(shape)) { return Result::Error(Errors.NumericError("ShapeMismatch")); }
        return Result::Ok(token.signed);
    }
    pub Result<string, SerializationError> BeginField() {
        TapeToken token = this.Next("field")?;
        return Result::Ok(token.text);
    }
    pub Result<unit, SerializationError> EndField() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndRecord() { return Result::Ok(()); }
    pub Result<i64, SerializationError> BeginSequence() {
        TapeToken token = this.Next("sequence")?;
        return Result::Ok(token.signed);
    }
    pub Result<unit, SerializationError> EndSequence() { return Result::Ok(()); }
    pub Result<i64, SerializationError> BeginMap() {
        TapeToken token = this.Next("map")?;
        return Result::Ok(token.signed);
    }
    pub Result<string, SerializationError> BeginMapEntry() {
        TapeToken token = this.Next("entry")?;
        return Result::Ok(token.text);
    }
    pub Result<unit, SerializationError> EndMapEntry() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndMap() { return Result::Ok(()); }
    pub Result<string, SerializationError> BeginVariant(Metadata.ShapeId shape) {
        TapeToken token = this.Next("variant")?;
        return Result::Ok(token.text);
    }
    pub Result<i64, SerializationError> VariantCount() {
        if (this.position < 1_i64) { return Result::Error(Errors.NumericError("NoVariant")); }
        return Result::Ok(this.tape[this.position - 1_i64].signed);
    }
    pub Result<unit, SerializationError> EndVariant() { return Result::Ok(()); }
    pub Result<bool, SerializationError> BeginOptional() {
        TapeToken token = this.Next("optional")?;
        return Result::Ok(token.flag);
    }
    pub Result<unit, SerializationError> EndOptional() { return Result::Ok(()); }

    Result<TapeToken, SerializationError> Next(string kind) {
        if (this.position >= Array.Len<TapeToken>(this.tape)) { return Result::Error(Errors.NumericError("IncompleteInput")); }
        TapeToken token = this.tape[this.position];
        if (token.kind != kind) { return Result::Error(Errors.NumericError("UnexpectedCall")); }
        this.position = this.position + 1_i64;
        return Result::Ok(token);
    }
}

/// Top-level typed decode through the JSON test format, with the same issued Decoder<T> as BSOL.
T DecodeJson<T>(JsonTraceEncoder encoded, T original, string what) {
    JsonTapeReader reader = JsonTapeReader { tape: encoded.tape, position: 0_i64 };
    match Contracts.Decode<T, Decoding.IssuedDecoder<T, JsonTapeReader>>(Decoding.DecoderFor<T, JsonTapeReader>(reader), Limits.DefaultLimits()) {
        Result::Error(error) => { Assert.Fail(what + " decodes from the JSON test format: " + Errors.Code(error)); },
        Result::Ok(value) => { return value; },
    };
    return original;
}

test SerializationGeneratedRecordUsesOneDescriptorAndDecoderForBsolAndJson {
    ShapeDescriptor pair = Descriptors.CompiledShape<Pair<Point>>();
    string point = Metadata.FormatShapeId(Descriptors.CompiledShape<Point>().id);
    Pair<Point> value = Pair<Point> { left: Point { x: 1_i32, y: -2_i32 }, right: Point { x: 2147483647_i32, y: (-2147483647_i32 - 1_i32) } };
    JsonTraceEncoder json = NewJsonTrace();
    match Contracts.Encode<Pair<Point>, JsonTraceEncoder>(value, json, Limits.DefaultLimits()) {
        Result::Error(error) => Assert.Fail("generated adapter drives the JSON test format: " + Errors.Code(error)),
        Result::Ok(_) => { },
    };
    Assert.Equal(json.text, "{\"left\":{\"x\":1,\"y\":-2},\"right\":{\"x\":2147483647,\"y\":-2147483648}}", "JSON test format owns its representation of the same calls");
    Assert.Equal(Array.Len<string>(json.shapes), 3_i64, "one record shape per record value");
    Assert.Equal(json.shapes[0], Metadata.FormatShapeId(pair.id), "JSON adapter receives the compiled generic record descriptor identity");
    Assert.Equal(json.shapes[1], point, "JSON adapter receives the compiled nested record identity");
    Assert.Equal(Array.Len<FieldDescriptor>(pair.fields), 2_i64, "the descriptor declares both generic fields");
    Assert.Equal(pair.fields[0].name, json.fields[0], "descriptor field order is the adapter field order");
    Pair<Point> fromJson = DecodeJson<Pair<Point>>(json, value, "Pair<Point>");
    Pair<Point> fromBsol = DecodeBsol<Pair<Point>>(EncodeBsol<Pair<Point>>(value), value, "Pair<Point>");
    ExpectPoint(fromJson.left, 1_i32, -2_i32, "JSON left");
    ExpectPoint(fromJson.right, 2147483647_i32, (-2147483647_i32 - 1_i32), "JSON right");
    ExpectPoint(fromBsol.left, fromJson.left.x, fromJson.left.y, "BSOL and JSON decode the same left");
    ExpectPoint(fromBsol.right, fromJson.right.x, fromJson.right.y, "BSOL and JSON decode the same right");
}

test SerializationGeneratedF32AndF64BitsSurviveBothFormatsWithoutCoercion {
    Pair<Sample> value = Pair<Sample> {
        left: Sample { narrow: FloatBits.FromBits32(0x80000000_u32), wide: FloatBits.FromBits64(0x3fb999999999999a_u64) },
        right: Sample { narrow: FloatBits.FromBits32(0x3dcccccd_u32), wide: FloatBits.FromBits64(0x8000000000000000_u64) },
    };
    JsonTraceEncoder json = NewJsonTrace();
    Assert.True(Results.IsOk(Contracts.Encode<Pair<Sample>, JsonTraceEncoder>(value, json, Limits.DefaultLimits())), "generated adapter drives the JSON test format");
    Assert.Equal(Array.Len<i64>(json.floatWidths), 4_i64, "four float calls");
    Assert.Equal(json.floatWidths[0], 32_i64, "f32 field reaches the format at width 32");
    Assert.Equal(json.floatWidths[1], 64_i64, "f64 field reaches the format at width 64");
    Assert.True(String.Contains(json.text, "{\"f32\":2147483648}"), "JSON keeps f32 negative zero bits");
    Assert.True(String.Contains(json.text, "{\"f64\":4591870180066957722}"), "JSON keeps f64 one tenth bits");
    Pair<Sample> decoded = DecodeJson<Pair<Sample>>(json, value, "Pair<Sample>");
    Assert.Equal(FloatBits.ToBits32(decoded.left.narrow), 0x80000000_u32, "JSON f32 negative zero survives typed decode");
    Assert.Equal(FloatBits.ToBits64(decoded.left.wide), 0x3fb999999999999a_u64, "JSON f64 one tenth survives typed decode");
    Assert.Equal(FloatBits.ToBits32(decoded.right.narrow), 0x3dcccccd_u32, "JSON f32 one tenth survives without widening");
    Assert.Equal(FloatBits.ToBits64(decoded.right.wide), 0x8000000000000000_u64, "JSON f64 negative zero survives typed decode");
}

test SerializationGeneratedEnumDecodesThroughTheJsonTestFormat {
    Signal[] values = [Signal::Idle, Signal::Level(-9007199254740993_i64), Signal::Named("probe", 7_u8)];
    mut i64 index = 0_i64;
    while (index < Array.Len<Signal>(values)) {
        JsonTraceEncoder json = NewJsonTrace();
        Assert.True(Results.IsOk(Contracts.Encode<Signal, JsonTraceEncoder>(values[index], json, Limits.DefaultLimits())), "generated enum adapter drives the JSON test format");
        ExpectSignal(DecodeJson<Signal>(json, values[index], "Signal"), values[index], "JSON Signal");
        index = index + 1_i64;
    }
}

test SerializationGeneratedJsonReaderRejectsADifferentWidth {
    JsonTraceEncoder json = NewJsonTrace();
    Assert.True(Results.IsOk(Contracts.Encode<Point, JsonTraceEncoder>(Point { x: 1_i32, y: 2_i32 }, json, Limits.DefaultLimits())), "Point encodes");
    mut TapeToken[] tape = json.tape;
    mut TapeToken widened = tape[2];
    Assert.Equal(widened.kind, "signed", "the third call is the x field value");
    widened.width = 64_u8;
    tape[2] = widened;
    JsonTapeReader reader = JsonTapeReader { tape: tape, position: 0_i64 };
    Assert.True(Results.IsError(Contracts.Decode<Point, Decoding.IssuedDecoder<Point, JsonTapeReader>>(Decoding.DecoderFor<Point, JsonTapeReader>(reader), Limits.DefaultLimits())), "an i32 field never accepts a 64-bit integer call");
}

Map<string, i64> SampleCounts() {
    Map<string, i64> counts = Map.New<string, i64>();
    counts.Insert("beta", 2_i64);
    counts.Insert("alpha", 1_i64);
    return counts;
}
