pub type SerializationLimits {
    pub i64 maxInputBytes,
    pub i64 maxOutputBytes,
    pub i64 maxDepth,
    pub i64 maxNodes,
    pub i64 maxScalarBytes,
}

pub SerializationLimits DefaultLimits() {
    return SerializationLimits {
        maxInputBytes: 8388608_i64,
        maxOutputBytes: 8388608_i64,
        maxDepth: 128_i64,
        maxNodes: 100000_i64,
        maxScalarBytes: 1048576_i64,
    };
}
