// EXPECT: E1234
// A port send of a Moved value is an isolate crossing: `move bytes` hands the array over, so the
// later read of `bytes` is rejected.
use Core.Results;
use Core.Collections.Array;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Parallel.Port;

test sent_array_binding_is_consumed {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        Port<u8[]> p = s.Port<u8[]>();
        u8[] bytes = Array.Empty<u8>();
        p.Send(move bytes);
        i64 n = Array.Len<u8>(bytes);
        return Result::Ok(n);
    });
}
