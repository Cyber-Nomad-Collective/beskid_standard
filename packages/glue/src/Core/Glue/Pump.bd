/// Cooperative framed transport over canonical child pipes. The process API
/// owns cancellation, deadlines, and OS resources; this module owns no scheduler.
use Core.Results;
use Core.Optional.Option;
use Core.Process;
use Core.Collections.Array;
use Core.Bytes.Slice;
use Core.Time.Deadline;

pub enum PumpError { Io(), Truncated(), InvalidFrame(), Limit(), Closed(), }

/// A complete frame owns its length prefix and body, bounded before allocation.
pub Result<u8[], PumpError> ReadFrame(ProcessReader input, ProcessReader stderr, Deadline deadline) {
    u8[] prefix = Slice.New(4);
    u8[] scratch = Slice.New(4096);
    mut i64 offset = 0;
    while offset < 4 {
        match stderr.TryRead(scratch, 0, 4096) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(value) => { },
        };
        match input.TryRead(prefix, offset, 4 - offset) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(ready) => {
                match ready {
                    Option::None => {
                        match Process.WaitReady(deadline) {
                            Result::Error(error) => { return Result::Error(PumpError::Io); },
                            Result::Ok(value) => { },
                        };
                    },
                    Option::Some(count) => {
                        if count == 0 { return Result::Error(PumpError::Truncated); }
                        if count < 0 || count > 4 - offset { return Result::Error(PumpError::InvalidFrame); }
                        offset = offset + count;
                    },
                };
            },
        };
    }
    i64 length = i64(prefix[0]) + i64(prefix[1]) * 256 + i64(prefix[2]) * 65536 + i64(prefix[3]) * 16777216;
    if length < 64 || length > 16777216 { return Result::Error(PumpError::Limit); }
    u8[] frame = Slice.New(length + 4);
    mut i64 index = 0;
    while index < 4 { frame[index] = prefix[index]; index = index + 1; }
    offset = 4;
    while offset < length + 4 {
        match stderr.TryRead(scratch, 0, 4096) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(value) => { },
        };
        match input.TryRead(frame, offset, length + 4 - offset) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(ready) => {
                match ready {
                    Option::None => {
                        match Process.WaitReady(deadline) {
                            Result::Error(error) => { return Result::Error(PumpError::Io); },
                            Result::Ok(value) => { },
                        };
                    },
                    Option::Some(count) => {
                        if count == 0 { return Result::Error(PumpError::Truncated); }
                        if count < 0 || count > length + 4 - offset { return Result::Error(PumpError::InvalidFrame); }
                        offset = offset + count;
                    },
                };
            },
        };
    }
    return Result::Ok(frame);
}

pub Result<unit, PumpError> WriteFrame(ProcessWriter output, ProcessReader stderr, u8[] frame, Deadline deadline) {
    i64 length = Array.Len(frame);
    if length < 68 || length > 16777220 { return Result::Error(PumpError::Limit); }
    i64 declared = i64(frame[0]) + i64(frame[1]) * 256 + i64(frame[2]) * 65536 + i64(frame[3]) * 16777216;
    if declared != length - 4 { return Result::Error(PumpError::InvalidFrame); }
    u8[] scratch = Slice.New(4096);
    mut i64 offset = 0;
    while offset < length {
        match stderr.TryRead(scratch, 0, 4096) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(value) => { },
        };
        match output.TryWrite(frame, offset, length - offset) {
            Result::Error(error) => { return Result::Error(PumpError::Io); },
            Result::Ok(ready) => {
                match ready {
                    Option::None => {
                        match Process.WaitReady(deadline) {
                            Result::Error(error) => { return Result::Error(PumpError::Io); },
                            Result::Ok(value) => { },
                        };
                    },
                    Option::Some(count) => {
                        if count <= 0 || count > length - offset { return Result::Error(PumpError::InvalidFrame); }
                        offset = offset + count;
                    },
                };
            },
        };
    }
    return Result::Ok(());
}

/// Incremental owner-loop reader. A pending probe never parks, allowing the
/// existing bridge fiber to process cancellation and shutdown commands first.
pub type FrameReader {
    u8[] buffer,
    u8[] scratch,
    i64 offset,
    i64 expected,
    bool failed,

    pub Result<Option<u8[]>,PumpError> Poll(ProcessReader input, ProcessReader stderr) {
        if this.failed { return Result::Error(PumpError::Closed); }
        match stderr.TryRead(this.scratch, 0, 4096) {
            Result::Ok(value) => { },
            Result::Error(error) => { this.failed = true; return Result::Error(PumpError::Io); },
        };
        return match input.TryRead(this.buffer, this.offset, this.expected - this.offset) {
            Result::Ok(readiness) => AdvanceReader(this, readiness),
            Result::Error(error) => FailReader(this, PumpError::Io),
        };
    }
}

Result<Option<u8[]>,PumpError> FailReader(FrameReader reader, PumpError error) {
    reader.failed = true;
    return Result::Error(error);
}

Result<Option<u8[]>,PumpError> AdvanceReader(FrameReader reader, Option<i64> readiness) {
    match readiness {
        Option::None => { return Result::Ok(Option::None); },
        Option::Some(count) => {
            if count == 0 { return FailReader(reader, PumpError::Truncated); }
            if count < 0 || count > reader.expected - reader.offset { return FailReader(reader, PumpError::InvalidFrame); }
            reader.offset = reader.offset + count;
        },
    };
    if reader.offset < reader.expected { return Result::Ok(Option::None); }
    if reader.expected == 4 {
        i64 length = i64(reader.buffer[0]) + i64(reader.buffer[1]) * 256 + i64(reader.buffer[2]) * 65536 + i64(reader.buffer[3]) * 16777216;
        if length < 64 || length > 16777216 { return FailReader(reader, PumpError::Limit); }
        u8[] next = Slice.New(length + 4);
        mut i64 index = 0;
        while index < 4 { next[index] = reader.buffer[index]; index = index + 1; }
        reader.buffer = next;
        reader.expected = length + 4;
        return Result::Ok(Option::None);
    }
    u8[] complete = reader.buffer;
    reader.buffer = Slice.New(4);
    reader.expected = 4;
    reader.offset = 0;
    return Result::Ok(Option::Some(complete));
}

pub FrameReader NewFrameReader() {
    return FrameReader { buffer: Slice.New(4), scratch: Slice.New(4096), offset: 0, expected: 4, failed: false };
}

/// One bounded outgoing frame; ownership stays with the loop until the exact
/// committed prefix has been acknowledged by the canonical pipe probe.
pub type FrameWriter {
    u8[] buffer,
    u8[] scratch,
    i64 offset,
    bool failed,

    pub bool IsIdle() { return Array.Len(this.buffer) == 0; }

    pub Result<unit,PumpError> Enqueue(u8[] frame) {
        if this.failed { return Result::Error(PumpError::Closed); }
        if Array.Len(this.buffer) != 0 { return Result::Error(PumpError::InvalidFrame); }
        i64 length = Array.Len(frame);
        if length < 68 || length > 16777220 { return Result::Error(PumpError::Limit); }
        i64 declared = i64(frame[0]) + i64(frame[1]) * 256 + i64(frame[2]) * 65536 + i64(frame[3]) * 16777216;
        if declared != length - 4 { return Result::Error(PumpError::InvalidFrame); }
        this.buffer = frame;
        this.offset = 0;
        return Result::Ok(());
    }

    pub Result<bool,PumpError> Poll(ProcessWriter output, ProcessReader stderr) {
        if this.failed { return Result::Error(PumpError::Closed); }
        if Array.Len(this.buffer) == 0 { return Result::Ok(true); }
        match stderr.TryRead(this.scratch, 0, 4096) {
            Result::Ok(value) => { },
            Result::Error(error) => { this.failed = true; return Result::Error(PumpError::Io); },
        };
        return match output.TryWrite(this.buffer, this.offset, Array.Len(this.buffer) - this.offset) {
            Result::Ok(ready) => AdvanceWriter(this, ready),
            Result::Error(error) => FailWriter(this, PumpError::Io),
        };
    }
}

Result<bool,PumpError> FailWriter(FrameWriter writer, PumpError error) {
    writer.failed = true;
    return Result::Error(error);
}

Result<bool,PumpError> AdvanceWriter(FrameWriter writer, Option<i64> ready) {
    match ready {
        Option::None => { return Result::Ok(false); },
        Option::Some(count) => {
            if count < 0 || count > Array.Len(writer.buffer) - writer.offset { return FailWriter(writer, PumpError::InvalidFrame); }
            if count == 0 { return Result::Ok(false); }
            writer.offset = writer.offset + count;
        },
    };
    if writer.offset == Array.Len(writer.buffer) {
        writer.buffer = Array.Empty<u8>();
        writer.offset = 0;
        return Result::Ok(true);
    }
    return Result::Ok(false);
}

pub FrameWriter NewFrameWriter() {
    return FrameWriter { buffer: Array.Empty<u8>(), scratch: Slice.New(4096), offset: 0, failed: false };
}
