use Core.Bytes.Slice;
use Core.Results;
use Crypto.Errors;
use Crypto.Scratch;

/// ChaCha20 (RFC 8439 section 2.3/2.4): 32-byte key, 12-byte nonce, 32-bit block counter.
/// Pure ARX; no table lookups, so the computation is constant time. Whole 256-byte groups
/// run four blocks at a time in i32x4 lanes (CLIF kernels from tools/clifgen.py).


u32 Le32(u8[] data, i64 offset) {
    return u32(data[offset]) | (u32(data[offset + 1_i64]) << 8_u32) | (u32(data[offset + 2_i64]) << 16_u32) | (u32(data[offset + 3_i64]) << 24_u32);
}

u32[] Words20() { return [0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32]; }

/// Initial state: constants, key, counter slot (index 12), nonce; words 16..20 hold the
/// lane offsets 0, 1, 2, 3 used by the four-block kernel.
u32[] InitialState(u8[] key, u8[] nonce) {
    u32[] s = Words20();
    s[0] = 0x61707865_u32; s[1] = 0x3320646e_u32; s[2] = 0x79622d32_u32; s[3] = 0x6b206574_u32;
    mut i64 i = 0_i64;
    while i < 8_i64 { s[4_i64 + i] = Le32(key, i * 4_i64); i = i + 1_i64; }
    s[13] = Le32(nonce, 0_i64); s[14] = Le32(nonce, 4_i64); s[15] = Le32(nonce, 8_i64);
    s[17] = 1_u32; s[18] = 2_u32; s[19] = 3_u32;
    return s;
}

