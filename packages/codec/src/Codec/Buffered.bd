use Core.Bytes.Slice;
use Core.IO;
use Core.IO.IoError;
use Core.IO.Reader;
use Core.Results;
use Codec.Errors;
use Codec.Line;

/// Incremental read buffer over a `Core.IO.Reader` with a fixed capacity. The source is passed to
/// each call because 0.5.2 cannot store a contract value in a struct field (see COMPILER-GAPS.md).
/// Peek and delimiter scans never buffer more than `capacity` bytes, so a hostile
/// peer cannot grow memory. `ReadExact` may exceed the capacity by reading the
/// remainder straight from the source, bounded by the caller's `maxLength`.
pub type BufferedReader {
    u8[] buf,
    i64 start,
    i64 stop,
    bool eof,
    pub i64 Buffered() { return DoBuffered(this); }
    pub i64 Capacity() { return DoCapacity(this); }
    // True once the source reported end of stream (buffered bytes may remain).
    pub bool AtEof() { return DoAtEof(this); }
    // Moves buffered bytes to the front of the buffer.
    pub unit Compact() { return DoCompact(this); }
}

// Operations that take a `Reader` are module functions, not methods: a method forwarding `this`
// together with a contract argument fails to lower in 0.5.2 (see COMPILER-GAPS.md).
i64 DoBuffered(BufferedReader self) {
    return self.stop - self.start;
}

i64 DoCapacity(BufferedReader self) {
    return Slice.Len(self.buf);
}

bool DoAtEof(BufferedReader self) {
    return self.eof;
}

unit DoCompact(BufferedReader self) {
        if self.start == 0_i64 { return; }
        i64 count = self.stop - self.start;
        if count > 0_i64 { Slice.Copy(self.buf, 0_i64, self.buf, self.start, count); }
        self.start = 0_i64;
        self.stop = count;
    }

pub Result<i64, CodecError> Fill(BufferedReader self, Reader source) {
        if self.eof { return Result::Ok(0_i64); }
        DoCompact(self);
        i64 free = Slice.Len(self.buf) - self.stop;
        if free <= 0_i64 { return Result::Error(CodecError::BufferFull()); }
        Result<i64, IoError> got = IO.Read(source, self.buf, self.stop, free);
        match got {
            Result::Error(error) => { return Result::Error(Errors.FromIoError(error)); },
            Result::Ok(count) => {
                if count == 0_i64 { self.eof = true; }
                self.stop = self.stop + count;
                return Result::Ok(count);
            },
        };
    }

pub Result<unit, CodecError> Ensure(BufferedReader self, Reader source, i64 count) {
        if count < 0_i64 { return Result::Error(CodecError::InvalidValue()); }
        if count > Slice.Len(self.buf) { return Result::Error(CodecError::BufferFull()); }
        while self.stop - self.start < count {
            Result<i64, CodecError> got = Fill(self, source);
            match got {
                Result::Error(error) => { return Result::Error(error); },
                Result::Ok(n) => { if n == 0_i64 { return Result::Error(CodecError::Truncated()); } },
            };
        }
        return Result::Ok(());
    }

pub Result<u8[], CodecError> Peek(BufferedReader self, Reader source, i64 count) {
        Result<unit, CodecError> ok = Ensure(self, source, count);
        match ok {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        return Result::Ok(Slice.SubSlice(self.buf, self.start, count));
    }

pub Result<i64, CodecError> Peek8(BufferedReader self, Reader source) {
        Result<unit, CodecError> ok = Ensure(self, source, 1_i64);
        match ok {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        return Result::Ok(i64(self.buf[self.start]));
    }

pub Result<unit, CodecError> Skip(BufferedReader self, Reader source, i64 count) {
        Result<unit, CodecError> ok = Ensure(self, source, count);
        match ok {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        self.start = self.start + count;
        return Result::Ok(());
    }

pub Result<u8[], CodecError> ReadExact(BufferedReader self, Reader source, i64 count, i64 maxLength) {
        if count < 0_i64 { return Result::Error(CodecError::InvalidValue()); }
        if count > maxLength { return Result::Error(CodecError::LimitExceeded()); }
        if count <= Slice.Len(self.buf) {
            Result<unit, CodecError> ok = Ensure(self, source, count);
            match ok {
                Result::Error(error) => { return Result::Error(error); },
                Result::Ok(_) => {},
            };
            u8[] out = Slice.SubSlice(self.buf, self.start, count);
            self.start = self.start + count;
            return Result::Ok(out);
        }
        u8[] out = Slice.New(count);
        i64 have = self.stop - self.start;
        Slice.Copy(out, 0_i64, self.buf, self.start, have);
        self.start = self.stop;
        Result<unit, IoError> rest = IO.ReadExact(source, out, have, count - have);
        return match rest {
            Result::Error(error) => Result::Error(Errors.FromIoError(error)),
            Result::Ok(_) => Result::Ok(out),
        };
    }

pub Result<u8[], CodecError> ReadUntil(BufferedReader self, Reader source, u8 delimiter, i64 maxLength) {
        if maxLength < 0_i64 { return Result::Error(CodecError::InvalidValue()); }
        mut i64 scanned = 0_i64;
        while true {
            while self.start + scanned < self.stop {
                if self.buf[self.start + scanned] == delimiter {
                    u8[] out = Slice.SubSlice(self.buf, self.start, scanned);
                    self.start = self.start + scanned + 1_i64;
                    return Result::Ok(out);
                }
                scanned = scanned + 1_i64;
                if scanned > maxLength { return Result::Error(CodecError::LimitExceeded()); }
            }
            Result<i64, CodecError> got = Fill(self, source);
            match got {
                Result::Error(error) => {
                    if scanned >= Slice.Len(self.buf) { return Result::Error(CodecError::LimitExceeded()); }
                    return Result::Error(error);
                },
                Result::Ok(n) => { if n == 0_i64 { return Result::Error(CodecError::Truncated()); } },
            };
        }
        return Result::Error(CodecError::Truncated());
    }

pub Result<u8[], CodecError> ReadLine(BufferedReader self, Reader source, i64 maxLength) {
        while true {
            Result<i64, CodecError> found = Line.FindLineEnd(self.buf, self.start, self.stop, maxLength);
            match found {
                Result::Error(error) => { return Result::Error(error); },
                Result::Ok(cr) => {
                    if cr >= 0_i64 {
                        u8[] out = Slice.SubSlice(self.buf, self.start, cr - self.start);
                        self.start = cr + 2_i64;
                        return Result::Ok(out);
                    }
                },
            };
            Result<i64, CodecError> got = Fill(self, source);
            match got {
                Result::Error(error) => { return Result::Error(error); },
                Result::Ok(n) => { if n == 0_i64 { return Result::Error(CodecError::Truncated()); } },
            };
        }
        return Result::Error(CodecError::Truncated());
    }

pub Result<i64, IoError> ReadSome(BufferedReader self, Reader source, u8[] destination, i64 offset, i64 count) {
        i64 have = self.stop - self.start;
        if have > 0_i64 {
            mut i64 n = count;
            if have < n { n = have; }
            Slice.Copy(destination, offset, self.buf, self.start, n);
            self.start = self.start + n;
            return Result::Ok(n);
        }
        if self.eof { return Result::Ok(0_i64); }
        return IO.Read(source, destination, offset, count);
    }


/// A buffered reader with a `capacity` byte buffer (at least 1).
pub BufferedReader New(i64 capacity) {
    mut i64 size = capacity;
    if size < 1_i64 { size = 1_i64; }
    return BufferedReader { buf: Slice.New(size), start: 0_i64, stop: 0_i64, eof: false };
}
