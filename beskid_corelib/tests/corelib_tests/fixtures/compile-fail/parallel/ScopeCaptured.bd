// EXPECT: E1236
// A task body cannot capture its `Scope` (`[NeverTransferable]`); the report names `s` and `Scope`.
use Core.Results;
use Core.Parallel;
use Core.Parallel.Scopes;

test ScopeCannotBeCaptured
{
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        Task<i64> outer = s.Spawn(() => {
            Task<i64> inner = s.Spawn(() => 1_i64);
            return 1_i64;
        });
        return Result::Ok(0_i64);
    });
}
