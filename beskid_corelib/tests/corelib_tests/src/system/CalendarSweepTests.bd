/// Exhaustive and differential calendar checks: Core.Time.Calendar against itself over a wide
/// day range and against reference dates generated with Python.

use Testing.Expect;
use Core.Collections.Array;
use Core.Time.Calendar;
use Core.Time.Date;
use Core.Time.Instant;

test calendar_round_trips_every_day_for_four_centuries {
    // 146097 days is one full Gregorian cycle; walk it starting 1900-03-01 so century and
    // 400-year leap rules are all crossed.
    i64 start = Calendar.DaysFromCivil(1900, 3, 1);
    mut Date previous = Calendar.CivilFromDays(start - 1);
    mut i64 previousWeekday = Calendar.IsoWeekday(previous);
    mut i64 offset = 0;
    while offset < 146097 {
        i64 days = start + offset;
        Date date = Calendar.CivilFromDays(days);
        Expect.EqualI64(Calendar.DaysFromCivil(date.year, date.month, date.day), days, "round trip");
        Expect.EqualBool(Calendar.IsValidDate(date.year, date.month, date.day), true, "valid civil date");
        Date following = Calendar.AddDays(previous, 1);
        Expect.EqualI64(following.day, date.day, "consecutive days");
        i64 weekday = Calendar.IsoWeekday(date);
        Expect.EqualI64(weekday, previousWeekday % 7 + 1, "weekday advances by one");
        previous = date;
        previousWeekday = weekday;
        offset = offset + 1;
    }
}

