http3_tests {
  name = "http3_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_codec" { source = path path = "../../codec" }
dependency "corelib_http2" { source = path path = "../../http2" }
dependency "corelib_http3" { source = path path = ".." }
target "Http3SmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "QpackExampleTests" { kind = Lib entry = "QpackExampleTests.bd" }
target "QpackMalformedTests" { kind = Lib entry = "QpackMalformedTests.bd" }
