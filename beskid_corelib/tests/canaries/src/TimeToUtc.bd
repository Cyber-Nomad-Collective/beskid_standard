/// Canary: `Core.Time.ToUtcDateTime` passes analysis (corelib fix: declare `nanos`, `seconds`, `days`, `daySeconds`, `remaining`, `year`, `month` as `mut` in `Time.bd`).
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Time;
use Core.Time.Date;
use Core.Time.DateTime;
use Core.Time.Instant;

test time_to_utc_date_time_compiles {
    DateTime value = Time.ToUtcDateTime(Instant { nanos: 0 });
    Date date = value.date;
    Assert.True(date.year == 1970, "epoch year");
}
