/// Core.String hub — string helpers, character tables, and UTF-8 rune decoding.
/// Core helpers in Core.String.Core; char tables in Core.String.Chars;
/// UTF-8 decoding in Core.String.Utf8; search and ordinal comparison in Core.String.Search;
/// splitting, replacement, padding, and case mapping in Core.String.Transform; incremental
/// construction in Core.String.Builder.
pub mod Core.String.Core;
pub mod Core.String.Chars;
pub mod Core.String.Utf8;
pub mod Core.String.Search;
pub mod Core.String.Transform;
pub mod Core.String.Builder;

use Core.String.Core;
use Core.String.Chars;
use Core.String.Utf8;
use Core.String.Search;
use Core.String.Transform;

pub i64 Len(string text) {
    return Core.Len(text);
}

pub bool IsEmpty(string text) {
    return Core.IsEmpty(text);
}

pub i64 IndexOfFrom(string haystack, i64 start, string needle) {
    return Core.IndexOfFrom(haystack, start, needle);
}

pub bool Contains(string text, string needle) {
    return Core.Contains(text, needle);
}

pub string SubSlice(string text, i64 start, i64 count) {
    return Core.SubSlice(text, start, count);
}

pub string Trim(string text) {
    return Core.Trim(text);
}

pub u8 ByteAt(string text, i64 index) {
    return Core.ByteAt(text, index);
}

pub i64 CompareOrdinal(string left, string right) {
    return Core.CompareOrdinal(left, right);
}

pub string[] SortOrdinal(string[] values) {
    return Core.SortOrdinal(values);
}

pub string Latin1Block() {
    return Utf8.Latin1Block();
}

pub string DigitChar(i64 digit) {
    return Chars.DigitChar(digit);
}

pub string LowerChar(i64 offset) {
    return Chars.LowerChar(offset);
}

pub string UpperChar(i64 offset) {
    return Chars.UpperChar(offset);
}

pub string CodeUnitChar(u8 b) {
    return Chars.CodeUnitChar(b);
}

pub i64 Utf8RuneByteLen(u8 lead) {
    return Utf8.Utf8RuneByteLen(lead);
}

pub string Latin1Rune(u8 lead, u8 trail) {
    return Utf8.Latin1Rune(lead, trail);
}

pub string FromUtf8CodeUnits(u8[] data) {
    return Utf8.FromUtf8CodeUnits(data);
}

pub bool StartsWith(string text, string prefix) {
    return Search.StartsWith(text, prefix);
}

pub bool EndsWith(string text, string suffix) {
    return Search.EndsWith(text, suffix);
}

pub i64 IndexOf(string text, string needle) {
    return Search.IndexOf(text, needle);
}

pub i64 LastIndexOf(string text, string needle) {
    return Search.LastIndexOf(text, needle);
}

pub i64 Count(string text, string needle) {
    return Search.Count(text, needle);
}

pub i64 Compare(string a, string b) {
    return Search.Compare(a, b);
}

pub bool Less(string a, string b) {
    return Search.Less(a, b);
}

pub bool IsBlank(string text) {
    return Search.IsBlank(text);
}

pub string FromAscii(u8 code) {
    return Transform.FromAscii(code);
}

pub string Newline() {
    return Transform.Newline();
}

pub string Tab() {
    return Transform.Tab();
}

pub string[] Split(string text, string separator) {
    return Transform.Split(text, separator);
}

pub string[] Lines(string text) {
    return Transform.Lines(text);
}

pub string Join(string[] parts, string separator) {
    return Transform.Join(parts, separator);
}

pub string Replace(string text, string old, string replacement) {
    return Transform.Replace(text, old, replacement);
}

pub string Repeat(string text, i64 count) {
    return Transform.Repeat(text, count);
}

pub string PadLeft(string text, i64 width, string fill) {
    return Transform.PadLeft(text, width, fill);
}

pub string PadRight(string text, i64 width, string fill) {
    return Transform.PadRight(text, width, fill);
}

pub string ToUpperAscii(string text) {
    return Transform.ToUpperAscii(text);
}

pub string ToLowerAscii(string text) {
    return Transform.ToLowerAscii(text);
}

pub string TrimStart(string text) {
    return Transform.TrimStart(text);
}

pub string TrimEnd(string text) {
    return Transform.TrimEnd(text);
}

pub string RemovePrefix(string text, string prefix) {
    return Transform.RemovePrefix(text, prefix);
}

pub string RemoveSuffix(string text, string suffix) {
    return Transform.RemoveSuffix(text, suffix);
}

pub string Concat(string a, string b) {
    return Transform.Concat(a, b);
}
