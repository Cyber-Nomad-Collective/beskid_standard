/// FIFO queue backed by typed `T[]` storage.
/// @tier(supported)
/// `Enqueue` and `Dequeue` change the queue in place.
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;

[Isolated]
pub type Queue<T> {
    T[] storage,
    i64 head,
    i64 count,

    pub i64 Count() {
        return this.count;
    }

    pub bool IsEmpty() {
        return this.count == 0;
    }

    /// Adds `value` at the back of the queue.
    pub unit Enqueue(mut this, T value) {
        Array.Append<T>(this.storage, value);
        this.count = this.count + 1;
        return;
    }

    /// Removes and returns the front value, or `None` when empty.
    pub Option<T> Dequeue(mut this) {
        if this.count == 0 {
            return Option::None;
        }
        Option<T> front = Option::Some(Array.Get<T>(this.storage, this.head));
        if this.count == 1 {
            this.storage = Array.Empty<T>();
            this.head = 0;
            this.count = 0;
            return front;
        }
        Array.Clear<T>(this.storage, this.head);
        this.head = this.head + 1;
        this.count = this.count - 1;
        return front;
    }

    pub Result<T, string> Peek() {
        if this.count == 0 {
            return Result::Error("queue is empty");
        }
        return Result::Ok(Array.Get<T>(this.storage, this.head));
    }
}

pub Queue<T> New<T>() {
    return Queue<T> { storage: Array.Empty<T>(), head: 0, count: 0 };
}

/// Bulk constructor: packs call-site scalars into a queue.
/// Iterates the bulk array and enqueues each value with `Queue.Enqueue`.
pub Queue<T> Of<T>(bulk T[] values) {
    Queue<T> result = New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result.Enqueue(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}
