// Expected failure: a datagram socket does not implement Foundation Stream.
use Core.IO.Stream;
use Core.IO.IoError;
use Core.Results;
use Network.Udp.UdpSocket;

Result<unit, IoError> CloseStream(Stream stream) { return stream.Close(); }

pub Result<unit, IoError> EraseDatagramBoundary(UdpSocket socket) {
    return CloseStream(socket);
}
