// NATIVE-ONLY: run under the bounded-allocation/overflow fixture harness.
// EXPECT-TRAP: arithmetic_overflow.
// This uses only the public array API; the harness supplies a bounded native runtime kit
// so the final append reaches logical-length overflow without fabricating a local result.
use Core.Collections.Array;

pub unit ArrayAppendOverflow() {
    mut i64[] values = Array.Empty<i64>();
    mut bool append = true;
    while append {
        Array.Append<i64>(values, 1);
    }
    return;
}
