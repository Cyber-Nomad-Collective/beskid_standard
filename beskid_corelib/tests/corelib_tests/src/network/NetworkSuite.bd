Result<unit, NetworkError> UdpConnectedResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    UdpSocket left = UdpSocket.Bind(bindAddress)?;
    UdpSocket right = UdpSocket.Bind(bindAddress)?;
    left.Connect(right.LocalAddress()?)?;
    right.Connect(left.LocalAddress()?)?;
    left.Send([99_u8], Option.Empty<Deadline>())?;
    Datagram received = right.Receive(1_i64, Option.Empty<Deadline>())?;
    Assert.Equal(received.payload[0], 99_u8, "connected receive preserves payload");
    right.Close()?;
    Assert.True(match (right.Receive(1_i64, Option.Empty<Deadline>()))
    {
        Result::Error(NetworkError::Closed) => true,
        _ => false,
    }, "closed generation fails before native I/O");
    left.Close()?;
    return Result::Ok(());
}

