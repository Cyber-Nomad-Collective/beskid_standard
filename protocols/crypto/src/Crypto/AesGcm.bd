/// Fills the bit-reversed and Karatsuba middle hash-key words of `g`.
i64 GhashPrepare(i64[] g) {
    return clif {
        %gp1 = payload %0
        %v2 = load.i64 %gp1+16
        %v3 = load.i64 %gp1+24
        %v4 = bitrev %v2
        %v5 = bitrev %v3
        store %v4, %gp1+32
        store %v5, %gp1+40
        %v6 = bxor %v3, %v2
        store %v6, %gp1+48
        %v7 = bxor %v5, %v4
        store %v7, %gp1+56
        %c8 = iconst.i64 0
        return %c8
    };
}
