use Core.Bytes.Slice;
use Core.Results;
use Codec.Hex;
use Testing.Assert;
use Tls.Handshake;
use Tls.Suites;
use Tls.TlsConfig;
use Tls.TlsErrors;
use Tls.TlsPk;
use Tls.Wire;

bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }

TlsClientConfig TraceConfig() {
    TlsClientConfig c = TlsConfig.Client("server", TlsConfig.AcceptAnyCertificateForTestsOnly());
    c.cipherSuites = [Suites.Aes128(), Suites.ChaCha(), Suites.Aes256()];
    c.minRsaBits = 1024_i64;
    return c;
}

// Drains events; returns the concatenated Send payloads and records the last secrets in `out`
// ([0] read handshake, [1] write handshake, [2] read app, [3] write app, [4] connected flag).
u8[] Drain(HandshakeEngine e, Blob[] out) {
    mut u8[] sent = Slice.New(0_i64);
    while Handshake.HasEvent(e) {
        TlsEvent ev = Handshake.TakeEvent(e);
        match ev {
            TlsEvent::Send(_, data) => { sent = data; },
            TlsEvent::ReadSecret(level, secret) => { if level == 2_i64 { out[0] = Blob { data: secret }; } else { out[2] = Blob { data: secret }; } },
            TlsEvent::WriteSecret(level, secret) => { if level == 2_i64 { out[1] = Blob { data: secret }; } else { out[3] = Blob { data: secret }; } },
            TlsEvent::Connected => { out[4] = Blob { data: [1_u8] }; },
        };
    }
    return sent;
}

i64 Code(Result<unit, TlsError> r) { return match r { Result::Ok(_) => 0_i64, Result::Error(e) => TlsErrors.Code(e), }; }

u8[] BlobData(Blob[] list, i64 i) { Blob b = list[i]; return b.data; }

unit FullReplay() {
    Result<KeyShare, TlsError> share = TlsPk.FromPrivate(Wire.GroupX25519(), ClientPrivate());
    match share {
        Result::Error(_) => { Assert.Fail("x25519 key"); },
        Result::Ok(ks) => {
            Assert.True(Same(ks.publicKey, ClientPublic()), "x25519 public key matches the trace");
            match Handshake.NewClientAfterHello(TraceConfig(), ks, VClientHello()) {
                Result::Error(_) => { Assert.Fail("engine"); },
                Result::Ok(e) => {
                    Blob[] out = [Blob { data: Slice.New(0_i64) }, Blob { data: Slice.New(0_i64) }, Blob { data: Slice.New(0_i64) }, Blob { data: Slice.New(0_i64) }, Blob { data: Slice.New(0_i64) }];
                    u8[] sh = VServerHello();
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 0_i64, sh, 0_i64, Slice.Len(sh))), 0_i64, "ServerHello accepted");
                    Drain(e, out);
                    Assert.True(Same(BlobData(out, 0), ServerHsTraffic()), "server handshake secret event");
                    Assert.True(Same(BlobData(out, 1), ClientHsTraffic()), "client handshake secret event");
                    u8[] flight = ServerFlight();
                    // Feed in two pieces to exercise reassembly.
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 0_i64, 100_i64)), 0_i64, "first fragment");
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 100_i64, Slice.Len(flight) - 100_i64)), 0_i64, "rest of flight");
                    u8[] fin = Drain(e, out);
                    Assert.True(Same(fin, VClientFinished()), "client Finished matches RFC 8448");
                    Assert.True(Same(BlobData(out, 2), ServerApTraffic()), "server app secret");
                    Assert.True(Same(BlobData(out, 3), ClientApTraffic()), "client app secret");
                    Assert.True(Handshake.IsConnected(e), "connected");
                    Assert.True(Same(Handshake.ResumptionMasterSecret(e), ResumptionMaster()), "resumption master");
                    u8[] nst = VNewSessionTicket();
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 3_i64, nst, 0_i64, Slice.Len(nst))), 0_i64, "ticket accepted and ignored");
                },
            };
        },
    };
    return;
}

unit Rfc8448TamperedServerFinishedIsDecryptError() {
    Result<KeyShare, TlsError> share = TlsPk.FromPrivate(Wire.GroupX25519(), ClientPrivate());
    match share {
        Result::Error(_) => { Assert.Fail("x25519 key"); },
        Result::Ok(ks) => {
            match Handshake.NewClientAfterHello(TraceConfig(), ks, VClientHello()) {
                Result::Error(_) => { Assert.Fail("engine"); },
                Result::Ok(e) => {
                    u8[] sh = VServerHello();
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 0_i64, sh, 0_i64, Slice.Len(sh))), 0_i64, "ServerHello");
                    u8[] flight = ServerFlight();
                    i64 n = Slice.Len(flight);
                    flight[n - 1_i64] = flight[n - 1_i64] + 1_u8;
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 0_i64, n)), 1051_i64, "decrypt_error");
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 0_i64, 1_i64)), 4000_i64, "engine is closed after failure");
                },
            };
        },
    };
    return;
}

unit Rfc8448TamperedCertificateVerifyIsDecryptError() {
    Result<KeyShare, TlsError> share = TlsPk.FromPrivate(Wire.GroupX25519(), ClientPrivate());
    match share {
        Result::Error(_) => { Assert.Fail("x25519 key"); },
        Result::Ok(ks) => {
            match Handshake.NewClientAfterHello(TraceConfig(), ks, VClientHello()) {
                Result::Error(_) => { Assert.Fail("engine"); },
                Result::Ok(e) => {
                    u8[] sh = VServerHello();
                    Handshake.Feed(e, 0_i64, sh, 0_i64, Slice.Len(sh));
                    u8[] flight = ServerFlight();
                    // Inside the CertificateVerify signature (EE 40 + Certificate 445 + 8 header bytes).
                    flight[500] = flight[500] + 1_u8;
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 0_i64, Slice.Len(flight))), 1051_i64, "decrypt_error");
                },
            };
        },
    };
    return;
}

unit Rfc8448Rsa1024RejectedByDefaultPolicy() {
    Result<KeyShare, TlsError> share = TlsPk.FromPrivate(Wire.GroupX25519(), ClientPrivate());
    match share {
        Result::Error(_) => { Assert.Fail("x25519 key"); },
        Result::Ok(ks) => {
            TlsClientConfig c = TraceConfig();
            c.minRsaBits = 2048_i64;
            match Handshake.NewClientAfterHello(c, ks, VClientHello()) {
                Result::Error(_) => { Assert.Fail("engine"); },
                Result::Ok(e) => {
                    u8[] sh = VServerHello();
                    Handshake.Feed(e, 0_i64, sh, 0_i64, Slice.Len(sh));
                    u8[] flight = ServerFlight();
                    Assert.Equal<i64>(Code(Handshake.Feed(e, 2_i64, flight, 0_i64, Slice.Len(flight))), 1071_i64, "insufficient_security");
                },
            };
        },
    };
    return;
}

// One test function: every test recompiles the whole engine (minutes under the 0.5.2 JIT).
test rfc8448_client_engine_replay_and_rejections {
    FullReplay();
    Rfc8448TamperedServerFinishedIsDecryptError();
    Rfc8448TamperedCertificateVerifyIsDecryptError();
    Rfc8448Rsa1024RejectedByDefaultPolicy();
}

// RFC 8448 section 3 values.
pub u8[] ClientPrivate() { return Hex.Of("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"); }
pub u8[] ClientPublic() { return Hex.Of("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"); }
pub u8[] VClientHello() {
    string s = "010000c00303cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7000006130113031302010000910000000b0009000006"
        + "736572766572ff01000100000a00140012001d0017001800190100010101020103010400230000003300260024001d002099381de560e4bd43d23d8e"
        + "435a7dbafeb3c06e51c13cae4d5413691e529aaf2c002b0003020304000d0020001e0403050306030203080408050806040105010601020104020502"
        + "06020202002d00020101001c00024001";
    return Hex.Of(s);
}
pub u8[] VServerHello() {
    string s = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe"
        + "66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";
    return Hex.Of(s);
}
