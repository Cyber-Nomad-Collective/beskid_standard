corelib_http3 {
  name = "corelib_http3"
  version = "0.1.0"
  root = "src"
  readme = "README.md"
}

dependency "corelib_foundation" { source = path path = "../foundation" }
dependency "corelib_concurrency" { source = path path = "../concurrency" }
dependency "corelib_network" { source = path path = "../network" }
dependency "corelib_http" { source = path path = "../http" }
dependency "corelib_uri" { source = path path = "../uri" }
dependency "corelib_codec" { source = path path = "../codec" }
dependency "corelib_tls" { source = path path = "../tls" }
dependency "corelib_http2" { source = path path = "../http2" }
dependency "corelib_quic" { source = path path = "../quic" }
target "Http3Lib" { kind = Lib }
