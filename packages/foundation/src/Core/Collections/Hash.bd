/// Core.Collections.Hash — 64-bit hash functions for strings and integers.
/// @tier(supported)
/// Hashes are deterministic across runs and platforms and are suitable for hash tables, not for
/// cryptographic or adversarial-input use. Arithmetic wraps modulo 2^64.
use Core.String.Core;

/// Bitwise exclusive or. The language has no `^` operator; `(a | b) - (a & b)` is exact in
/// two's-complement arithmetic.
pub i64 Xor(i64 a, i64 b) {
    return (a | b) - (a & b);
}

/// Logical (zero-filling) right shift by `bits` in `0..=63`.
pub i64 ShiftRightLogical(i64 value, i64 bits) {
    if bits <= 0 {
        return value;
    }
    if bits >= 64 {
        return 0;
    }
    i64 mask = (1_i64 << (64 - bits)) - 1;
    return (value >> bits) & mask;
}

/// FNV-1a over the UTF-8 bytes of `text`.
pub i64 String(string text) {
    mut i64 hash = -3750763034362895579_i64;
    i64 len = Core.Len(text);
    mut i64 i = 0;
    while i < len {
        hash = Xor(hash, i64(Core.ByteAt(text, i)));
        hash = hash * 1099511628211_i64;
        i = i + 1;
    }
    return hash;
}

/// SplitMix64 finalizer: a fast bijective mix of all 64 input bits.
pub i64 I64(i64 value) {
    mut i64 z = value + -7046029254386353131_i64;
    z = Xor(z, ShiftRightLogical(z, 30)) * -4658895280553007687_i64;
    z = Xor(z, ShiftRightLogical(z, 27)) * -7723592293110705685_i64;
    return Xor(z, ShiftRightLogical(z, 31));
}

/// Mixes `value` into an accumulated hash, for hashing composite keys field by field.
pub i64 Combine(i64 seed, i64 value) {
    return I64(Xor(seed, value) + seed * 31);
}
