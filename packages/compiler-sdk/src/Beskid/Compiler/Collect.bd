// CHECKED IN: hand-maintained Mod SDK surface (not generated)
// Mod packages import these contracts — do not redeclare locally.

use Beskid.Compiler.Compilation;
use Beskid.Compiler.ModCatalog;
use Beskid.Compiler.Workspace;
use Core.Results;
use Beskid.Syntax.Nodes.SpannedContractDefinition;
use Beskid.Syntax.Nodes.SpannedFunctionDefinition;
use Beskid.Syntax.Nodes.SpannedImplBlock;
use Beskid.Syntax.Nodes.SpannedTypeDefinition;

pub type CollectRequest {
    pub Beskid.Compiler.Compilation compilation,
    pub Beskid.Compiler.Workspace workspace,
    pub Beskid.Compiler.ModCatalog mods,
}

pub type CollectTargetSet {
    pub string[] targetIds,
}

pub type GenerationRequest {
    pub CollectRequest context,
    pub CollectTargetSet targets,
}

pub type AnalysisRequest {
    pub CollectRequest context,
}

/// One diagnostic emitted by an `Analyzer` contract. `spanStart`/`spanEnd` are inclusive
/// byte offsets into the entry source; `(0, 0)` means "no span" (host falls back to a
/// whole-file span). `severity` mirrors `Beskid.Compiler.Diagnostics.Severity`.
pub type Diagnostic {
    pub string code,
    pub string message,
    pub Beskid.Compiler.Diagnostics.Severity severity,
    pub u64 spanStart,
    pub u64 spanEnd,
}

/// One text edit in a [`QuickFix`]. `kind` mirrors `ModEdit`: 0 = Insert, 1 = Replace,
/// 2 = Delete. For `Insert`, `start == end`. For `Delete`, `text` is empty.
pub type Edit {
    pub u32 kind,
    pub u64 start,
    pub u64 end,
    pub string text,
}

/// One quick-fix produced by an `Analyzer`. `diagnosticIndex` links the fix to an entry
/// in the `AnalysisResult.diagnostics` array returned alongside.
pub type QuickFix {
    pub u32 diagnosticIndex,
    pub string title,
    pub Edit[] edits,
}

/// Result from `Analyzer.Analyze` — diagnostics + a flat list of quick-fixes.
pub type AnalysisResult {
    pub Diagnostic[] diagnostics,
    pub QuickFix[] fixes,
}
pub type AttributeGenerationRequest {
    pub CollectRequest context,
}
pub type AttributeDeclarationSet {
    pub Beskid.Syntax.Nodes.SpannedAttributeDeclaration[] declarations,
}
pub type FixError {}

/// Opaque fenced source payload (`code ```lang ... ``` ` with optional `@{}` holes).
pub type CodeString {
    pub string language,
    pub string body,
}

/// One generated module file returned from `Generator.Generate`.
pub type CodeContribution {
    pub string modulePath,
    pub string fileName,
    pub CodeString body,
}

/// One top-level syntax item contributed by a Generator (typed AST, not source text).
pub enum SyntaxContributionItem {
    ContractDefinition(SpannedContractDefinition definition),
    TypeDefinition(SpannedTypeDefinition definition),
    FunctionDefinition(SpannedFunctionDefinition definition),
    ImplBlock(SpannedImplBlock definition),
}

/// Typed AST payload returned from `Generator.Generate`.
pub type SerializationTargetBinding {
    pub u32 contributionIndex,
    pub Beskid.Compiler.Semantic.SemanticHandle target,
}

pub type SerializationTemplateBinding {
    pub u32 contributionIndex,
    pub Beskid.Compiler.Semantic.TypeTemplate template,
}

pub type GeneratedSyntaxContribution {
    pub SyntaxContributionItem[] items,
    pub CodeContribution[] codeOutputs,
    pub SerializationTargetBinding[] targetBindings,
    pub SerializationTemplateBinding[] templateBindings,
}

/// Typed construction of a managed Mod instance. Native adapters select the exact
/// applied witness and root the result before invoking a receiver method.
pub contract ModFactory<T> {
    T Create(CollectRequest context);
}

/// Declarative target collection and scope narrowing for a Mod instance.
pub contract Collector {
    CollectTargetSet Collect(CollectRequest request);
}

/// Incremental typed AST contribution entrypoint.
pub contract Generator {
    GeneratedSyntaxContribution Generate(GenerationRequest request);
}

/// Pest grammar combinator emit entrypoint (scheduling alias of [`Generator`] until dedicated host wiring lands).
pub contract GrammarGenerator {
    GeneratedSyntaxContribution Generate(GenerationRequest request);
}

/// Post-semantic diagnostic and rewrite-registration entrypoint.
pub contract Analyzer {
    AnalysisResult Analyze(AnalysisRequest request);
}

/// Typed replacement contract, parameterized over the source and target node types.
pub contract Rewriter<TSourceNode, TTargetNode> {
    Result<TTargetNode, FixError> Rewrite(TSourceNode sourceNode);
}

/// Attribute declarations exported by Mod packages.
pub contract AttributeGenerator {
    AttributeDeclarationSet Attributes(AttributeGenerationRequest request);
}

pub string CollectFacadeVersion() {
    return "0.6.0";
}
