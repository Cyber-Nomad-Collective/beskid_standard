/// The Happy Eyeballs coordinator. One calling fiber owns every child fiber:
/// resolvers, attempts and timers report through one channel, and every child
/// is cancelled and joined before Run returns. Streams that lose the race are
/// closed, including streams still queued in the channel.
use Concurrency;
use Concurrency.Fiber;
use Concurrency.Channel;
use Concurrency.TryResult;
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;
use Core.Time;
use Core.Time.Deadline;
use Network.Types;
use Network.Errors;
use Network.Dns;
use Network.Tcp.TcpStream;
use Connect.Errors;
use Connect.Policy;
use Connect.Order;

/// One report from a child fiber.
pub enum Event {
    Outcome(i64 index, Result<TcpStream, NetworkError> result),
    Timer(i64 seq),
    Resolved(AddressFamily family, Result<SocketAddress[], NetworkError> result),
}

// Timer sequence numbers below zero are reserved for fixed timers.
i64 DeadlineTimer() { return -1_i64; }
i64 ResolutionTimer() { return -2_i64; }

// Verdicts of the coordinator loop.
i64 Running() { return 0_i64; }
i64 Won() { return 1_i64; }
i64 AllFailed() { return 2_i64; }
i64 Expired() { return 3_i64; }
i64 CancelledVerdict() { return 4_i64; }
i64 Unresolved() { return 5_i64; }
i64 Empty() { return 6_i64; }

unit CloseIfOpen(Result<TcpStream, NetworkError> result) {
    match result {
        Result::Ok(stream) => { stream.Close(); },
        Result::Error(_) => (),
    };
    return;
}

unit AttemptBody(Channel<Event> events, i64 index, SocketAddress address, SocketOptions options, Option<Deadline> deadline) {
    Result<TcpStream, NetworkError> result = TcpStream.Connect(address, options, deadline);
    match Channel<Event>.Send(events, Event::Outcome(index, result)) {
        Result::Ok(_) => (),
        Result::Error(_) => CloseIfOpen(result),
    };
    return;
}

unit TimerBody(Channel<Event> events, i64 seq, i64 millis) {
    match Time.Sleep(Time.FromMilliseconds(millis)) {
        Result::Ok(_) => { Channel<Event>.Send(events, Event::Timer(seq)); },
        Result::Error(_) => (),
    };
    return;
}

unit ResolveBody(Channel<Event> events, string hostName, Port port, AddressFamily family, Option<Deadline> deadline) {
    Result<SocketAddress[], NetworkError> result = Dns.Resolve(hostName, port, Option.FromValue<AddressFamily>(family), deadline);
    Channel<Event>.Send(events, Event::Resolved(family, result));
    return;
}

Fiber<unit> SpawnAttempt(Channel<Event> events, i64 index, SocketAddress address, SocketOptions options, Option<Deadline> deadline) {
    return spawn (() => AttemptBody(events, index, address, options, deadline));
}

Fiber<unit> SpawnTimer(Channel<Event> events, i64 seq, i64 millis) {
    return spawn (() => TimerBody(events, seq, millis));
}

Fiber<unit> SpawnResolve(Channel<Event> events, string hostName, Port port, AddressFamily family, Option<Deadline> deadline) {
    return spawn (() => ResolveBody(events, hostName, port, family, deadline));
}

bool IsOk(Result<TcpStream, NetworkError> result) {
    return match result { Result::Ok(_) => true, Result::Error(_) => false, };
}

Option<TcpStream> StreamOf(Result<TcpStream, NetworkError> result) {
    return match result {
        Result::Ok(stream) => Option.FromValue<TcpStream>(stream),
        Result::Error(_) => Option.Empty<TcpStream>(),
    };
}

NetworkError ErrorOf(Result<TcpStream, NetworkError> result) {
    return match result {
        Result::Ok(_) => NetworkError::Closed(),
        Result::Error(error) => error,
    };
}

SocketAddress[] AddressesOf(Result<SocketAddress[], NetworkError> result) {
    return match result {
        Result::Ok(addresses) => addresses,
        Result::Error(_) => Array.Empty<SocketAddress>(),
    };
}

Option<NetworkError> ResolveErrorOf(Result<SocketAddress[], NetworkError> result) {
    return match result {
        Result::Ok(_) => Option.Empty<NetworkError>(),
        Result::Error(error) => Option.FromValue<NetworkError>(error),
    };
}

Option<Deadline> OverallDeadline(i64 timeoutMillis) {
    if timeoutMillis < 0_i64 { return Option.Empty<Deadline>(); }
    return match Deadline.After(Time.FromMilliseconds(timeoutMillis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

AttemptFailure Failure(SocketAddress address, NetworkError error) {
    return AttemptFailure { address: address, error: error };
}

// Closes a stream left in the channel by an attempt that lost the race.
// Returns the attempt index of an unreported failure, or -1.
i64 DrainIndex(Event event) {
    return match event {
        Event::Outcome(index, result) => DrainOutcome(index, result),
        _ => -1_i64,
    };
}

i64 DrainOutcome(i64 index, Result<TcpStream, NetworkError> result) {
    if IsOk(result) {
        CloseIfOpen(result);
        return -1_i64;
    }
    return index;
}

NetworkError DrainError(Event event) {
    return match event {
        Event::Outcome(_, result) => ErrorOf(result),
        _ => NetworkError::Cancelled(),
    };
}

Result<TcpStream, ConnectError> Finish(i64 verdict, Option<TcpStream> winner, AttemptFailure[] failures, Option<NetworkError> resolveError) {
    if verdict == Won() {
        return match winner {
            Option::Some(stream) => Result::Ok(stream),
            Option::None => Result::Error(ConnectError::AllAttemptsFailed(failures)),
        };
    }
    if verdict == Expired() { return Result::Error(ConnectError::DeadlineExceeded(failures)); }
    if verdict == CancelledVerdict() { return Result::Error(ConnectError::Cancelled(failures)); }
    if verdict == Unresolved() {
        return match resolveError {
            Option::Some(error) => Result::Error(ConnectError::ResolutionFailed(error)),
            Option::None => Result::Error(ConnectError::NoAddresses()),
        };
    }
    if verdict == Empty() { return Result::Error(ConnectError::NoAddresses()); }
    return Result::Error(ConnectError::AllAttemptsFailed(failures));
}

/// Runs one Happy Eyeballs race. With `resolve` the addresses come from
/// Network.Dns for `hostName`/`port`; otherwise `given` is used as-is.
pub Result<TcpStream, ConnectError> Run(string hostName, Port port, SocketAddress[] given, bool resolve, ConnectPolicy policy) {
    if !Policy.IsValid(policy) { return Result::Error(ConnectError::InvalidPolicy()); }
    i64 attemptDelay = Policy.AttemptDelayMillis(policy);
    i64 resolutionDelay = Policy.ResolutionDelayMillis(policy);
    i64 maxAttempts = Policy.MaxAttemptCount(policy);
    i64 timeoutMillis = Policy.TimeoutMillis(policy);
    i64 startedAt = Concurrency.NowMillis();
    Option<Deadline> deadline = OverallDeadline(timeoutMillis);
    AddressFamily preferred = policy.preferredFamily;

    Channel<Event> events = Channel<Event>.Create();
    mut Fiber<unit>[] fibers = Array.Empty<Fiber<unit>>();
    if timeoutMillis >= 0_i64 {
        Array.Append<Fiber<unit>>(fibers, SpawnTimer(events, DeadlineTimer(), timeoutMillis));
    }

    mut SocketAddress[] pending = Array.Empty<SocketAddress>();
    mut SocketAddress[] attempted = Array.Empty<SocketAddress>();
    mut bool[] reported = Array.Empty<bool>();
    mut AttemptFailure[] failures = Array.Empty<AttemptFailure>();
    mut SocketAddress[] resolved = Array.Empty<SocketAddress>();
    mut Option<NetworkError> resolveError = Option.Empty<NetworkError>();
    mut Option<TcpStream> winner = Option.Empty<TcpStream>();
    mut i64 outstanding = 0_i64;
    mut i64 started = 0_i64;
    mut i64 seq = 0_i64;
    mut i64 resolving = 0_i64;
    mut bool preferredPending = false;
    mut bool connecting = false;
    mut bool kick = false;
    mut i64 verdict = Running();

    if resolve {
        Option<AddressFamily> filter = policy.familyFilter;
        match filter {
            Option::Some(family) => {
                AddressFamily only = family;
                Array.Append<Fiber<unit>>(fibers, SpawnResolve(events, hostName, port, only, deadline));
                resolving = 1_i64;
                preferredPending = SameFamily(only, preferred);
            },
            Option::None => {
                Array.Append<Fiber<unit>>(fibers, SpawnResolve(events, hostName, port, preferred, deadline));
                Array.Append<Fiber<unit>>(fibers, SpawnResolve(events, hostName, port, Order.OtherFamily(preferred), deadline));
                resolving = 2_i64;
                preferredPending = true;
            },
        };
    } else {
        pending = Order.Interleave(given, preferred, policy.firstAddressFamilyCount, policy.familyFilter);
        connecting = true;
        if Array.Len<SocketAddress>(pending) == 0_i64 { verdict = Empty(); }
    }

    while verdict == Running() {
        // Start the next attempt on a stagger tick, after a failure, or when idle.
        if connecting && (kick || outstanding == 0_i64) && Array.Len<SocketAddress>(pending) > 0_i64 && started < maxAttempts {
            SocketAddress next = pending[0];
            pending = Order.Tail(pending);
            Array.Append<SocketAddress>(attempted, next);
            Array.Append<bool>(reported, false);
            Array.Append<Fiber<unit>>(fibers, SpawnAttempt(events, started, next, policy.socketOptions, deadline));
            started = started + 1_i64;
            outstanding = outstanding + 1_i64;
            seq = seq + 1_i64;
            Array.Append<Fiber<unit>>(fibers, SpawnTimer(events, seq, attemptDelay));
        }
        kick = false;
        bool exhausted = Array.Len<SocketAddress>(pending) == 0_i64 || started >= maxAttempts;
        if connecting && outstanding == 0_i64 && exhausted && (resolving == 0_i64 || started >= maxAttempts) {
            if started == 0_i64 { verdict = Empty(); } else { verdict = AllFailed(); }
        }
        if !connecting && resolving == 0_i64 { verdict = Unresolved(); }
        if verdict == Running() {
            match Channel<Event>.Receive(events) {
                Result::Error(_) => { verdict = CancelledVerdict(); },
                Result::Ok(event) => {
                    match event {
                        Event::Outcome(index, result) => {
                            outstanding = outstanding - 1_i64;
                            reported[index] = true;
                            if IsOk(result) {
                                winner = StreamOf(result);
                                verdict = Won();
                            } else {
                                Array.Append<AttemptFailure>(failures, Failure(attempted[index], ErrorOf(result)));
                                kick = true;
                            }
                        },
                        Event::Timer(tick) => {
                            if tick == DeadlineTimer() {
                                verdict = Expired();
                            } else {
                                if tick == ResolutionTimer() {
                                    if !connecting && Array.Len<SocketAddress>(resolved) > 0_i64 {
                                        connecting = true;
                                        pending = Order.Interleave(resolved, preferred, policy.firstAddressFamilyCount, policy.familyFilter);
                                    }
                                } else {
                                    if tick == seq { kick = true; }
                                }
                            }
                        },
                        Event::Resolved(family, result) => {
                            resolving = resolving - 1_i64;
                            bool isPreferred = SameFamily(family, preferred);
                            if isPreferred { preferredPending = false; }
                            SocketAddress[] answers = AddressesOf(result);
                            if Option.HasValue<NetworkError>(ResolveErrorOf(result)) {
                                if isPreferred || !Option.HasValue<NetworkError>(resolveError) { resolveError = ResolveErrorOf(result); }
                            }
                            if connecting {
                                pending = Order.Interleave(Order.Concat(pending, answers), preferred, policy.firstAddressFamilyCount, policy.familyFilter);
                            } else {
                                resolved = Order.Concat(resolved, answers);
                                if Array.Len<SocketAddress>(resolved) > 0_i64 {
                                    if preferredPending {
                                        // RFC 8305 section 3: give the preferred family the Resolution Delay.
                                        Array.Append<Fiber<unit>>(fibers, SpawnTimer(events, ResolutionTimer(), resolutionDelay));
                                    } else {
                                        connecting = true;
                                        pending = Order.Interleave(resolved, preferred, policy.firstAddressFamilyCount, policy.familyFilter);
                                    }
                                }
                            }
                        },
                    };
                },
            };
        }
    }

    // An outcome observed after the budget ran out is a deadline failure.
    if verdict != Won() && verdict != CancelledVerdict() && timeoutMillis >= 0_i64 && Concurrency.NowMillis() - startedAt >= timeoutMillis {
        verdict = Expired();
    }

    // Cancel and join every child, then close any stream still queued.
    mut i64 k = 0_i64;
    while k < Array.Len<Fiber<unit>>(fibers) {
        Fiber<unit> child = fibers[k];
        child.Cancel();
        child.Join();
        k = k + 1_i64;
    }
    mut bool draining = true;
    while draining {
        match Channel<Event>.TryReceive(events) {
            TryResult::Ok(event) => {
                i64 index = DrainIndex(event);
                if index >= 0_i64 && verdict != Won() {
                    reported[index] = true;
                    Array.Append<AttemptFailure>(failures, Failure(attempted[index], DrainError(event)));
                }
            },
            _ => { draining = false; },
        };
    }
    Channel<Event>.Close(events);

    // Attempts cut short by the coordinator carry the reason they stopped.
    if verdict != Won() {
        mut i64 a = 0_i64;
        while a < Array.Len<bool>(reported) {
            if !reported[a] {
                if verdict == Expired() {
                    Array.Append<AttemptFailure>(failures, Failure(attempted[a], NetworkError::TimedOut()));
                } else {
                    Array.Append<AttemptFailure>(failures, Failure(attempted[a], NetworkError::Cancelled()));
                }
            }
            a = a + 1_i64;
        }
    }
    return Finish(verdict, winner, failures, resolveError);
}
