/// Canary: A fully qualified generic call such as `Core.Collections.Queue.New<i64>()` lowers.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

test fully_qualified_generic_call {
    Core.Collections.Queue.Queue<i64> queue = Core.Collections.Queue.New<i64>();
    Assert.True(queue.IsEmpty(), "qualified generic constructor");
}
