/// Core.Text.Csv — RFC 4180 comma-separated values.
/// @tier(supported)
/// Fields may be quoted with `"`; inside quotes, `""` is a literal quote and line breaks are kept.
/// Records end at LF or CRLF; a final line break is optional. `ParseWith` and `FormatWith` take a
/// custom single-byte delimiter (for example `;` or a tab). Formatting quotes a field only when it
/// contains the delimiter, a quote, CR, or LF.
use Core.Collections.Array;
use Core.Results;
use Core.String;

/// One record.
pub type CsvRow {
    string[] fields,
}

/// Parse failures with the byte offset where parsing stopped.
/// @variant(UnterminatedQuote) A quoted field is not closed before the end of input.
/// @variant(UnexpectedQuote) A quote appears inside an unquoted field, or a closing quote is
/// followed by something other than a delimiter or line break.
pub enum CsvError {
    UnterminatedQuote(i64 offset),
    UnexpectedQuote(i64 offset),
}

/// Parses comma-separated `text` into records.
pub Result<CsvRow[], CsvError> Parse(string text) {
    return ParseWith(text, 44);
}

/// Parses `text` with `delimiter` (a single ASCII byte) between fields. Empty input has no
/// records; every other line, including an empty one in the middle, is a record.
pub Result<CsvRow[], CsvError> ParseWith(string text, u8 delimiter) {
    i64 len = String.Len(text);
    mut CsvRow[] rows = Array.Empty<CsvRow>();
    if len == 0 {
        return Result<CsvRow[], CsvError>::Ok(rows);
    }
    mut string[] fields = Array.Empty<string>();
    mut string field = "";
    mut i64 i = 0;
    mut bool atFieldStart = true;
    while i < len {
        u8 b = String.ByteAt(text, i);
        if atFieldStart && b == 34 {
            // Quoted field.
            mut i64 j = i + 1;
            mut bool closed = false;
            mut i64 runStart = j;
            while j < len {
                u8 q = String.ByteAt(text, j);
                if q == 34 {
                    field = String.Concat(field, String.SubSlice(text, runStart, j - runStart));
                    if j + 1 < len && String.ByteAt(text, j + 1) == 34 {
                        field = String.Concat(field, "\"");
                        j = j + 2;
                        runStart = j;
                        continue;
                    }
                    closed = true;
                    j = j + 1;
                    break;
                }
                j = j + 1;
            }
            if !closed {
                return Result<CsvRow[], CsvError>::Error(CsvError::UnterminatedQuote(i));
            }
            if j < len {
                u8 after = String.ByteAt(text, j);
                if after != delimiter && after != 10 && after != 13 {
                    return Result<CsvRow[], CsvError>::Error(CsvError::UnexpectedQuote(j));
                }
            }
            i = j;
            atFieldStart = false;
            continue;
        }
        if b == delimiter {
            fields = Array.Append<string>(fields, field);
            field = "";
            atFieldStart = true;
            i = i + 1;
            continue;
        }
        if b == 10 || b == 13 {
            fields = Array.Append<string>(fields, field);
            rows = Array.Append<CsvRow>(rows, CsvRow { fields: fields });
            fields = Array.Empty<string>();
            field = "";
            atFieldStart = true;
            if b == 13 && i + 1 < len && String.ByteAt(text, i + 1) == 10 {
                i = i + 2;
            } else {
                i = i + 1;
            }
            continue;
        }
        if b == 34 {
            return Result<CsvRow[], CsvError>::Error(CsvError::UnexpectedQuote(i));
        }
        // Unquoted run up to the next special byte.
        mut i64 end = i;
        while end < len {
            u8 c = String.ByteAt(text, end);
            if c == delimiter || c == 10 || c == 13 || c == 34 {
                break;
            }
            end = end + 1;
        }
        field = String.Concat(field, String.SubSlice(text, i, end - i));
        atFieldStart = false;
        i = end;
    }
    u8 last = String.ByteAt(text, len - 1);
    if last != 10 && last != 13 {
        fields = Array.Append<string>(fields, field);
        rows = Array.Append<CsvRow>(rows, CsvRow { fields: fields });
    }
    return Result<CsvRow[], CsvError>::Ok(rows);
}

bool NeedsQuotes(string field, u8 delimiter) {
    i64 len = String.Len(field);
    mut i64 i = 0;
    while i < len {
        u8 b = String.ByteAt(field, i);
        if b == delimiter || b == 34 || b == 10 || b == 13 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// One field, quoted when needed.
pub string FormatField(string field, u8 delimiter) {
    if !NeedsQuotes(field, delimiter) {
        return field;
    }
    return "\"" + String.Replace(field, "\"", "\"\"") + "\"";
}

/// Formats `rows` with commas and CRLF line endings, as RFC 4180 specifies.
pub string Format(CsvRow[] rows) {
    return FormatWith(rows, 44, String.FromAscii(13) + String.Newline());
}

/// Formats `rows` with `delimiter` between fields and `lineEnding` after every record.
pub string FormatWith(CsvRow[] rows, u8 delimiter, string lineEnding) {
    string separator = String.FromAscii(delimiter);
    mut string text = "";
    mut i64 r = 0;
    while r < Array.Len<CsvRow>(rows) {
        CsvRow row = Array.Get<CsvRow>(rows, r);
        string[] fields = row.fields;
        mut string[] formatted = Array.Empty<string>();
        mut i64 f = 0;
        while f < Array.Len<string>(fields) {
            formatted = Array.Append<string>(formatted, FormatField(Array.Get<string>(fields, f), delimiter));
            f = f + 1;
        }
        text = String.Concat(text, String.Concat(String.Join(formatted, separator), lineEnding));
        r = r + 1;
    }
    return text;
}

/// A record from `fields`.
pub CsvRow Row(string[] fields) {
    return CsvRow { fields: fields };
}
