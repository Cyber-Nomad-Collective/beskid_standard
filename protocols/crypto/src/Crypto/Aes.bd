u32 Xor(u32 a, u32 b) { return (a | b) - (a & b); }
u32 Rotr(u32 x, u32 n) { return (x >> n) | (x << (32_u32 - n)); }

u32 SubWord(u8[] sbox, u32 w) {
    return (u32(sbox[i64(w >> 24_u32)]) << 24_u32)
        | (u32(sbox[i64((w >> 16_u32) & 0xFF_u32)]) << 16_u32)
        | (u32(sbox[i64((w >> 8_u32) & 0xFF_u32)]) << 8_u32)
        | u32(sbox[i64(w & 0xFF_u32)]);
}

u32 Be32(u8[] data, i64 offset) {
    return (u32(data[offset]) << 24_u32) | (u32(data[offset + 1_i64]) << 16_u32) | (u32(data[offset + 2_i64]) << 8_u32) | u32(data[offset + 3_i64]);
}

unit PutBe32(u8[] out, i64 offset, u32 value) {
    out[offset] = u8(value >> 24_u32);
    out[offset + 1_i64] = u8((value >> 16_u32) & 0xFF_u32);
    out[offset + 2_i64] = u8((value >> 8_u32) & 0xFF_u32);
    out[offset + 3_i64] = u8(value & 0xFF_u32);
    return;
}

/// Expands a 16-, 24-, or 32-byte key. Other lengths fail with InvalidKeyLength.
pub Result<AesKey, CryptoError> NewKey(u8[] key) {
    i64 keyLength = Slice.Len(key);
    if keyLength != 16_i64 && keyLength != 24_i64 && keyLength != 32_i64 {
        return Result::Error(CryptoError::InvalidKeyLength());
    }
    i64 nk = keyLength / 4_i64;
    i64 rounds = nk + 6_i64;
    i64 total = 4_i64 * (rounds + 1_i64);
    u8[] sbox = SboxTable();
    u32[] te0 = Te0Table();
    mut u32[] t1 = Array.Empty<u32>();
    mut u32[] t2 = Array.Empty<u32>();
    mut u32[] t3 = Array.Empty<u32>();
    mut i64 i = 0_i64;
    while i < 256_i64 {
        Array.Append<u32>(t1, Rotr(te0[i], 8_u32));
        Array.Append<u32>(t2, Rotr(te0[i], 16_u32));
        Array.Append<u32>(t3, Rotr(te0[i], 24_u32));
        i = i + 1_i64;
    }
    mut u32[] w = Array.Empty<u32>();
    i = 0_i64;
    while i < nk { Array.Append<u32>(w, Be32(key, i * 4_i64)); i = i + 1_i64; }
    mut u32 rcon = 0x01_u32;
    while i < total {
        mut u32 temp = w[i - 1_i64];
        if i % nk == 0_i64 {
            temp = Xor(SubWord(sbox, (temp << 8_u32) | (temp >> 24_u32)), rcon << 24_u32);
            rcon = rcon << 1_u32;
            if rcon > 0xFF_u32 { rcon = Xor(rcon, 0x11b_u32); }
        } else {
            if nk > 6_i64 && i % nk == 4_i64 { temp = SubWord(sbox, temp); }
        }
        Array.Append<u32>(w, Xor(w[i - nk], temp));
        i = i + 1_i64;
    }
    return Result::Ok(AesKey { roundKeys: w, rounds: rounds, t0: te0, t1: t1, t2: t2, t3: t3, sbox: sbox });
}

/// Encrypts one 16-byte block from `input[inputOffset..]` into `output[outputOffset..]`.
/// Returns false for out-of-range offsets. Input and output may alias.
pub bool EncryptBlock(AesKey key, u8[] input, i64 inputOffset, u8[] output, i64 outputOffset) {
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, 16_i64) { return false; }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, 16_i64) { return false; }
    u32[] rk = key.roundKeys;
    u32[] t0 = key.t0; u32[] t1 = key.t1; u32[] t2 = key.t2; u32[] t3 = key.t3;
    mut u32 s0 = Xor(Be32(input, inputOffset), rk[0]);
    mut u32 s1 = Xor(Be32(input, inputOffset + 4_i64), rk[1]);
    mut u32 s2 = Xor(Be32(input, inputOffset + 8_i64), rk[2]);
    mut u32 s3 = Xor(Be32(input, inputOffset + 12_i64), rk[3]);
    mut i64 round = 1_i64;
    while round < key.rounds {
        i64 k = round * 4_i64;
        u32 n0 = Xor(Xor(Xor(t0[i64(s0 >> 24_u32)], t1[i64((s1 >> 16_u32) & 0xFF_u32)]), Xor(t2[i64((s2 >> 8_u32) & 0xFF_u32)], t3[i64(s3 & 0xFF_u32)])), rk[k]);
        u32 n1 = Xor(Xor(Xor(t0[i64(s1 >> 24_u32)], t1[i64((s2 >> 16_u32) & 0xFF_u32)]), Xor(t2[i64((s3 >> 8_u32) & 0xFF_u32)], t3[i64(s0 & 0xFF_u32)])), rk[k + 1_i64]);
        u32 n2 = Xor(Xor(Xor(t0[i64(s2 >> 24_u32)], t1[i64((s3 >> 16_u32) & 0xFF_u32)]), Xor(t2[i64((s0 >> 8_u32) & 0xFF_u32)], t3[i64(s1 & 0xFF_u32)])), rk[k + 2_i64]);
        u32 n3 = Xor(Xor(Xor(t0[i64(s3 >> 24_u32)], t1[i64((s0 >> 16_u32) & 0xFF_u32)]), Xor(t2[i64((s1 >> 8_u32) & 0xFF_u32)], t3[i64(s2 & 0xFF_u32)])), rk[k + 3_i64]);
        s0 = n0; s1 = n1; s2 = n2; s3 = n3;
        round = round + 1_i64;
    }
    i64 k = key.rounds * 4_i64;
    u8[] sb = key.sbox;
    u32 f0 = (u32(sb[i64(s0 >> 24_u32)]) << 24_u32) | (u32(sb[i64((s1 >> 16_u32) & 0xFF_u32)]) << 16_u32) | (u32(sb[i64((s2 >> 8_u32) & 0xFF_u32)]) << 8_u32) | u32(sb[i64(s3 & 0xFF_u32)]);
    u32 f1 = (u32(sb[i64(s1 >> 24_u32)]) << 24_u32) | (u32(sb[i64((s2 >> 16_u32) & 0xFF_u32)]) << 16_u32) | (u32(sb[i64((s3 >> 8_u32) & 0xFF_u32)]) << 8_u32) | u32(sb[i64(s0 & 0xFF_u32)]);
    u32 f2 = (u32(sb[i64(s2 >> 24_u32)]) << 24_u32) | (u32(sb[i64((s3 >> 16_u32) & 0xFF_u32)]) << 16_u32) | (u32(sb[i64((s0 >> 8_u32) & 0xFF_u32)]) << 8_u32) | u32(sb[i64(s1 & 0xFF_u32)]);
    u32 f3 = (u32(sb[i64(s3 >> 24_u32)]) << 24_u32) | (u32(sb[i64((s0 >> 16_u32) & 0xFF_u32)]) << 16_u32) | (u32(sb[i64((s1 >> 8_u32) & 0xFF_u32)]) << 8_u32) | u32(sb[i64(s2 & 0xFF_u32)]);
    PutBe32(output, outputOffset, Xor(f0, rk[k]));
    PutBe32(output, outputOffset + 4_i64, Xor(f1, rk[k + 1_i64]));
    PutBe32(output, outputOffset + 8_i64, Xor(f2, rk[k + 2_i64]));
    PutBe32(output, outputOffset + 12_i64, Xor(f3, rk[k + 3_i64]));
    return true;
}

/// One-shot encryption of a single 16-byte block (also the QUIC AES header-protection sample cipher).
pub Result<u8[], CryptoError> Encrypt(u8[] key, u8[] block) {
    if Slice.Len(block) != 16_i64 { return Result::Error(CryptoError::InvalidLength()); }
    return match NewKey(key) {
        Result::Error(error) => Result::Error(error),
        Result::Ok(expanded) => {
            u8[] out = Slice.New(16_i64);
            EncryptBlock(expanded, block, 0_i64, out, 0_i64);
            return Result::Ok(out);
        },
    };
}
