/// Real tests for Core.Optional.Option helpers.

use Core.Optional.Option;
use Testing.Assert;


test option_some_has_value {
    Option<i64> opt = Option.FromValue<i64>(42_i64);
    Assert.True(Option.HasValue<i64>(opt), "Some(42) should have a value");
}

test option_none_has_no_value {
    Option<i64> opt = Option.Empty<i64>();
    Assert.False(Option.HasValue<i64>(opt), "None should not have a value");
}

test option_unwrap_or_returns_value_on_some {
    Option<i64> opt = Option.FromValue<i64>(99_i64);
    i64 val = Option.UnwrapOr<i64>(opt, 0_i64);
    Assert.Equal(val, 99, "UnwrapOr on Some should return the inner value");
}

test option_unwrap_or_returns_default_on_none {
    Option<i64> opt = Option.Empty<i64>();
    i64 val = Option.UnwrapOr<i64>(opt, 77_i64);
    Assert.Equal(val, 77, "UnwrapOr on None should return the default");
}
