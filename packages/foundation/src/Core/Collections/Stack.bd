/// LIFO stack backed by typed `T[]` storage.
/// @tier(supported)
use Core.Collections.Array;
use Core.Results;

pub type Stack<T> {
    T[] storage,
    i64 count,

    pub i64 Count() {
        return this.count;
    }

    pub bool IsEmpty() {
        return this.count == 0;
    }

    pub Stack<T> Push(T value) {
        mut T[] nextStorage = this.storage;
        Array.Append<T>(nextStorage, value);
        return Stack<T> { storage: nextStorage, count: this.count + 1 };
    }

    pub Stack<T> Pop() {
        if this.count == 0 {
            return this;
        }
        return Stack<T> { storage: Array.RemoveLast<T>(this.storage), count: this.count - 1 };
    }

    pub Result<T, string> Peek() {
        if this.count == 0 {
            return Result::Error("stack is empty");
        }
        return Result::Ok(Array.Get<T>(this.storage, this.count - 1));
    }
}

pub Stack<T> New<T>() {
    return Stack<T> { storage: Array.Empty<T>(), count: 0 };
}

/// Bulk constructor: packs call-site scalars into a stack.
/// Iterates the bulk array and pushes each value via `Stack.Push`.
pub Stack<T> Of<T>(bulk T[] values) {
    mut Stack<T> result = New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result = result.Push(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}
