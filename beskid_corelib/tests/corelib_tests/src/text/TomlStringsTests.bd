/// Core.Text.Toml tests.

use Testing.Expect;
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Core.Text.Toml;

// ---------------------------------------------------------------------------------------------
// TOML
// ---------------------------------------------------------------------------------------------

Toml.TomlValue Doc(string text) {
    return match Toml.Parse(text) {
        Result::Ok(v) => v,
        Result::Error(_) => Toml.TomlValue::Text("<parse error>"),
    };
}

string TextAt(Toml.TomlValue doc, string path) {
    return match Toml.GetPath(doc, path) {
        Option::Some(v) => match Toml.AsText(v) {
            Option::Some(t) => t,
            Option::None => "<not text>",
        },
        Option::None => "<missing>",
    };
}

Toml.TomlValue ValueAt(Toml.TomlValue doc, string path) {
    return match Toml.GetPath(doc, path) {
        Option::Some(v) => v,
        Option::None => Toml.TomlValue::Text("<missing>"),
    };
}

string TomlFailure(string text) {
    return match Toml.Parse(text) {
        Result::Ok(_) => "ok",
        Result::Error(error) => match error {
            Toml.TomlError::UnexpectedCharacter(_) => "unexpected",
            Toml.TomlError::UnexpectedEnd(_) => "end",
            Toml.TomlError::UnterminatedString(_) => "unterminated",
            Toml.TomlError::InvalidEscape(_) => "escape",
            Toml.TomlError::InvalidNumber(_) => "number",
            Toml.TomlError::DuplicateKey(_) => "duplicate",
            Toml.TomlError::InvalidTable(_) => "table",
        },
    };
}

string Q(string text) {
    return String.Replace(text, "'", "\"");
}

string N() {
    return String.Newline();
}

u8[] EAcute() {
    mut u8[] bytes = Array.Empty<u8>();
    bytes = Array.Append<u8>(bytes, u8(195));
    bytes = Array.Append<u8>(bytes, u8(169));
    return bytes;
}

test toml_strings {
    string source = Q("basic = 'tab\\tquote\\'u\\u00e9'") + N() + "literal = 'C:\\path'" + N() + Q("multi = '''") + N() + "line one" + N() + Q("line two'''") + N() + "raw = '''" + N() + "keep \\n" + N() + "'''" + N() + Q("folded = '''one \\") + N() + Q("    two'''") + N();
    Toml.TomlValue doc = Doc(source);
    Expect.EqualString(TextAt(doc, "basic"), "tab" + String.Tab() + "quote\"u" + String.FromUtf8CodeUnits(EAcute()), "basic escapes");
    Expect.EqualString(TextAt(doc, "literal"), "C:\\path", "literal string");
    Expect.EqualString(TextAt(doc, "multi"), "line one" + N() + "line two", "multi-line basic trims the first newline");
    Expect.EqualString(TextAt(doc, "raw"), "keep \\n" + N(), "multi-line literal keeps backslashes");
    Expect.EqualString(TextAt(doc, "folded"), "one two", "line-ending backslash folds");
    Expect.EqualString(TomlFailure(Q("x = 'open")), "unterminated", "unterminated string");
    Expect.EqualString(TomlFailure(Q("x = '\\q'")), "escape", "invalid escape");
}

test toml_arrays_inline_tables_and_dates {
    string source = "ports = [ 8000, 8001," + N() + "  8002, # comment" + N() + "]" + N() + Q("owner = { name = 'Tom', dob = 1979-05-27T07:32:00-08:00 }") + N() + "when = 1979-05-27 07:32:00Z" + N() + "day = 1979-05-27" + N();
    Toml.TomlValue doc = Doc(source);
    Toml.TomlValue ports = ValueAt(doc, "ports");
    Expect.EqualI64(Toml.Length(ports), 3, "multi-line array with trailing comma and comment");
    Expect.EqualString(TextAt(doc, "owner.name"), "Tom", "inline table");
    string dob = match Toml.AsDateTime(ValueAt(doc, "owner.dob")) {
        Option::Some(t) => t,
        Option::None => "",
    };
    Expect.EqualString(dob, "1979-05-27T07:32:00-08:00", "offset date-time kept as text");
    string whenText = match Toml.AsDateTime(ValueAt(doc, "when")) {
        Option::Some(t) => t,
        Option::None => "",
    };
    Expect.EqualString(whenText, "1979-05-27 07:32:00Z", "space-separated date-time");
}
