// EXPECT: E1236
// `ReadOnlyArray<u8[]>` is not Shared (its element is Moved), so a task body cannot capture it.
use Core.Results;
use Core.Collections.Array;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Parallel.ReadOnlyArray;

test FrozenRowsOfBytesAreNotShared {
    u8[][] rows = Array.Empty<u8[]>();
    ReadOnlyArray<u8[]> frozen = ReadOnlyArray.Freeze<u8[]>(move rows);
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        Task<i64> t = s.Spawn(() => frozen.Count());
        return Result::Ok(0_i64);
    });
}
