// Expected failure: public TCP lifecycle deadlines accept only
// Option<Core.Time.Deadline>, never a raw monotonic integer.
use Core.Results;
use Network.Errors;
use Network.Types;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;

pub Result<unit, NetworkError> PassRawDeadline(SocketAddress address, SocketOptions options, TcpListener listener) {
    Result<TcpStream, NetworkError> connected = TcpStream.Connect(address, options, 0_i64);
    Result<TcpStream, NetworkError> accepted = listener.Accept(0_i64);
    match connected { Result::Ok(stream) => { stream.Close(); }, Result::Error(_) => (), };
    match accepted { Result::Ok(stream) => { stream.Close(); }, Result::Error(_) => (), };
    return Result::Ok(());
}
