/// Console.Hosting: the base host for console programs.
///
/// An application host extends it to run as a console program:
///
/// ```beskid
/// use Console.Hosting;
///
/// host AppHost() : ConsoleHost
/// {
///     startup(Hosting.CommandLine commandLine)
///     {
///         ...
///     }
/// }
/// ```
///
/// `ConsoleHost` registers `CommandLine`, the program's arguments and exit status, as a global
/// `single`. The extending host's `startup` runs after `launch` builds the container; the host
/// declares its own services and scopes beside it.
use Core.Args;
use Core.Collections.Array;

/// The command line of the running console program: its arguments and its exit status.
pub type CommandLine
{
    /// All arguments, the program name first.
    pub string[] All()
    {
        return Args.All();
    }

    /// The arguments after the program name.
    pub string[] Arguments()
    {
        string[] all = Args.All();
        mut string[] arguments = Array.Empty<string>();
        mut i64 index = 1;
        while index < Array.Len<string>(all)
        {
            Array.Append<string>(arguments, all[index]);
            index = index + 1;
        }
        return arguments;
    }

    /// The number of arguments after the program name.
    pub i64 Count()
    {
        i64 count = Args.Count();
        if count == 0
        {
            return 0;
        }
        return count - 1;
    }

    /// Ends the program through the host with `code` as its exit status. Every open scope is
    /// left innermost first and runs its `dispose` hooks; then the global `dispose` hooks run.
    /// `Process.Exit` is the immediate exit that runs no hooks.
    pub unit Exit(i32 code)
    {
        __composition_exit(code);
        return;
    }
}

// The base host for console programs. Extend it with `host AppHost() : ConsoleHost { ... }`.
// A host has no visibility: the composition finds it by name in any unit of the assembly.
host ConsoleHost()
{
    registry
    {
        single CommandLine;
    }
}
