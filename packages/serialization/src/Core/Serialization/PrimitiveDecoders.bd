use Core.Results;
use Core.Numeric.FloatBits;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Reader;

// Each concrete binding retains an exact scalar output application. These
// factories are ordinary typed source, not metadata or catchall issuers.

pub type Unit<R> {}
impl<R> Unit<R> : FieldDecoder<unit, R> where R: Reader {
    pub Result<unit, SerializationError> Read(R reader, SerializationLimits limits) {
        unit value = reader.ReadUnit()?;
        
        return Result::Ok(value);
    }
}
pub Unit<R> CreateUnit<R>() { return Unit<R> {}; }

pub type Boolean<R> {}
impl<R> Boolean<R> : FieldDecoder<bool, R> where R: Reader {
    pub Result<bool, SerializationError> Read(R reader, SerializationLimits limits) {
        bool value = reader.ReadBoolean()?;
        
        return Result::Ok(value);
    }
}
pub Boolean<R> CreateBoolean<R>() { return Boolean<R> {}; }

pub type Signed8<R> {}
impl<R> Signed8<R> : FieldDecoder<i8, R> where R: Reader {
    pub Result<i8, SerializationError> Read(R reader, SerializationLimits limits) {
        i64 value = reader.ReadSigned(8_u8)?;
        if (value < -128_i64 || value > 127_i64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(i8(value));
    }
}
pub Signed8<R> CreateSigned8<R>() { return Signed8<R> {}; }

pub type Signed16<R> {}
impl<R> Signed16<R> : FieldDecoder<i16, R> where R: Reader {
    pub Result<i16, SerializationError> Read(R reader, SerializationLimits limits) {
        i64 value = reader.ReadSigned(16_u8)?;
        if (value < -32768_i64 || value > 32767_i64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(i16(value));
    }
}
pub Signed16<R> CreateSigned16<R>() { return Signed16<R> {}; }

pub type Signed32<R> {}
impl<R> Signed32<R> : FieldDecoder<i32, R> where R: Reader {
    pub Result<i32, SerializationError> Read(R reader, SerializationLimits limits) {
        i64 value = reader.ReadSigned(32_u8)?;
        if (value < -2147483648_i64 || value > 2147483647_i64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(i32(value));
    }
}
pub Signed32<R> CreateSigned32<R>() { return Signed32<R> {}; }

