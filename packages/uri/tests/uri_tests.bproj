uri_tests {
  name = "uri_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "UriSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "UriResolveNormalTests" { kind = Lib entry = "ResolveNormalTests.bd" }
target "UriResolveAbnormalTests" { kind = Lib entry = "ResolveAbnormalTests.bd" }
target "UriParseTests" { kind = Lib entry = "ParseTests.bd" }
target "UriRejectTests" { kind = Lib entry = "RejectTests.bd" }
target "UriHostTests" { kind = Lib entry = "HostTests.bd" }
target "UriPctTests" { kind = Lib entry = "PctTests.bd" }
target "UriNormalizeTests" { kind = Lib entry = "NormalizeTests.bd" }
target "UriSchemeTests" { kind = Lib entry = "SchemeTests.bd" }
