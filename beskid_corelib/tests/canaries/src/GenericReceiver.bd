/// Canary: A generic function can call a method on a local whose type mentions its own type
/// parameter (`List<T> list = List.New<T>(); list.Push(value)`).
/// Fails on 0.5.3; passes once the gap is fixed.

use Testing.Assert;
use Core.Collections.List;

List<T> Single<T>(T value) {
    List<T> list = List.New<T>();
    return list.Push(value);
}

test generic_receiver_in_generic_function {
    List<i64> values = Single<i64>(7_i64);
    Assert.True(values.Count() == 1, "method on a List<T> local inside a generic function");
}
