//! `SerializationGeneratedSuite`: adapters generated by the Serialization Mod for `[Serialize]` declarations
//! execute in an installed program (SER-01) and drive two formats through one descriptor (SER-03).
//! The encoded BSOL text is checked through the format's own DataValue reader; the second format is a
//! JSON test adapter defined here that records exactly the calls the generated adapter makes.

use Core.Bsol.Serialization;
use Core.Collections.Array;
use Core.Collections.List;
use Core.Collections.Map;
use Core.Numeric.FloatBits;
use Core.Optional.Option;
use Core.Results;
use Core.Serialization.Contracts;
use Core.Serialization.DataValue;
use Core.Serialization.Decimal;
use Core.Serialization.Descriptors;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Metadata;
use Core.Serialization.Registry;
use Core.String;
use Testing.Assert;

[Serialize]
pub type Point {
    pub i32 x,
    pub i32 y,
}

[Serialize]
pub type Pair<T> {
    pub T left,
    pub T right,
}

[Serialize]
pub enum Signal {
    Idle,
    Level(i64 amount),
    Named(string label, u8 code),
}

[Serialize]
pub type Sample {
    pub f32 narrow,
    pub f64 wide,
}

[Serialize]
pub type FullShape {
    pub bool flag,
    pub i8 tiny,
    pub i16 small,
    pub i32 medium,
    pub i64 large,
    pub u8 octet,
    pub u16 port,
    pub u32 unsignedWord,
    pub u64 huge,
    pub f32 narrow,
    pub f64 wide,
    pub char letter,
    pub string text,
    [SerializeField(Bytes: true)] pub u8[] payload,
    pub unit nothing,
    pub Pair<Point> corners,
    pub i64[] samples,
    pub List<string> tags,
    pub Map<string, i64> counts,
    pub Signal signal,
    pub Option<i32[]> window,
    [SerializeField(WordWidth: 32)] pub word span,
}

/// Generated encoder into BSOL, then the format's own reader back to a DataValue tree.
DataValue EncodeThroughBsol<T>(T value, ShapeId shape, Registry.ShapeRegistry table) where T: Contracts.Serializable<Serialization.WireEncoder> {
    match Serialization.WriteTyped<T>(value, shape, table, Limits.DefaultLimits()) {
        Result::Error(error) => { Assert.Fail("generated adapter writes BSOL: " + Errors.Code(error)); },
        Result::Ok(text) => match Serialization.ReadValue(text, shape, table, Limits.DefaultLimits()) {
            Result::Error(error) => { Assert.Fail("generated BSOL output is valid serialization.v1: " + Errors.Code(error)); },
            Result::Ok(decoded) => { return decoded; },
        },
    };
    return DataValue::Unit;
}

/// The value of the declared field `name`, failing when the record lacks it.
DataValue FieldOf(DataValue record, string name) {
    match record {
        DataValue::Record(shape, fields) => {
            mut i64 index = 0_i64;
            while (index < Array.Len<RecordField>(fields)) {
                if (fields[index].name == name) { return fields[index].value; }
                index = index + 1_i64;
            }
            Assert.Fail("record carries field " + name);
        },
        _ => Assert.Fail("value is a record"),
    };
    return DataValue::Unit;
}

string RecordShape(DataValue record) {
    return match record {
        DataValue::Record(shape, fields) => Metadata.FormatShapeId(shape),
        _ => "",
    };
}

string[] FieldNames(DataValue record) {
    mut string[] names = Array.Empty<string>();
    match record {
        DataValue::Record(shape, fields) => {
            mut i64 index = 0_i64;
            while (index < Array.Len<RecordField>(fields)) {
                Array.Append<string>(names, fields[index].name);
                index = index + 1_i64;
            }
        },
        _ => Assert.Fail("value is a record"),
    };
    return names;
}

unit ExpectSigned(DataValue value, i64 expected, u8 width, string field) {
    match value {
        DataValue::Signed(actual, actualWidth) => {
            Assert.Equal(actual, expected, field + " keeps its exact signed value");
            Assert.Equal(actualWidth, width, field + " keeps its declared signed width");
        },
        _ => Assert.Fail(field + " is a signed integer"),
    };
}

unit ExpectUnsigned(DataValue value, u64 expected, u8 width, string field) {
    match value {
        DataValue::Unsigned(actual, actualWidth) => {
            Assert.Equal(actual, expected, field + " keeps its exact unsigned value");
            Assert.Equal(actualWidth, width, field + " keeps its declared unsigned width");
        },
        _ => Assert.Fail(field + " is an unsigned integer"),
    };
}

unit ExpectFloat(DataValue value, u64 bits, u8 width, string field) {
    match value {
        DataValue::Float(actual, actualWidth) => {
            Assert.Equal(actual, bits, field + " keeps its exact float bits");
            Assert.Equal(actualWidth, width, field + " keeps its float width");
        },
        _ => Assert.Fail(field + " is a float"),
    };
}

unit ExpectString(DataValue value, string expected, string field) {
    match value {
        DataValue::String(actual) => Assert.Equal(actual, expected, field + " keeps its text"),
        _ => Assert.Fail(field + " is a string"),
    };
}

unit ExpectPoint(DataValue value, string shape, i64 x, i64 y, string field) {
    Assert.Equal(RecordShape(value), shape, field + " is the nested Point record");
    ExpectSigned(FieldOf(value, "x"), x, 32_u8, field + ".x");
    ExpectSigned(FieldOf(value, "y"), y, 32_u8, field + ".y");
}

FullShape FullFixture() {
    return FullShape {
        flag: true,
        tiny: (-127_i8 - 1_i8),
        small: (-32767_i16 - 1_i16),
        medium: (-2147483647_i32 - 1_i32),
        large: -9223372036854775807_i64 - 1_i64,
        octet: 255_u8,
        port: 65535_u16,
        unsignedWord: 4294967295_u32,
        huge: 18446744073709551615_u64,
        narrow: FloatBits.FromBits32(0x80000000_u32),
        wide: FloatBits.FromBits64(0x3fb999999999999a_u64),
        letter: '😀',
        text: "zażółć 🙂",
        payload: [0_u8, 255_u8, 16_u8],
        nothing: (),
        corners: Pair<Point> { left: Point { x: 1_i32, y: -2_i32 }, right: Point { x: 2147483647_i32, y: (-2147483647_i32 - 1_i32) } },
        samples: [9007199254740993_i64, -9007199254740993_i64],
        tags: List.New<string>().Push("first").Push("second"),
        counts: Map.New<string, i64>().Insert("beta", 2_i64).Insert("alpha", 1_i64),
        signal: Signal::Named("probe", 7_u8),
        window: Option::Some([3_i32, -4_i32]),
        span: word(4294967295_u64),
    };
}

test serialization_generated_full_shape_record_roundtrips_through_bsol {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<FullShape>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of FullShape registers");
    ShapeDescriptor root = Descriptors.CompiledShape<FullShape>();
    string point = Metadata.FormatShapeId(Descriptors.CompiledShape<Point>().id);
    string signal = Metadata.FormatShapeId(Descriptors.CompiledShape<Signal>().id);
    DataValue record = EncodeThroughBsol<FullShape>(FullFixture(), root.id, table);
    Assert.Equal(RecordShape(record), Metadata.FormatShapeId(root.id), "root record carries the compiled shape identity");
    match FieldOf(record, "flag") { DataValue::Boolean(value) => Assert.True(value, "bool value"), _ => Assert.Fail("bool field is a boolean"), };
    ExpectSigned(FieldOf(record, "tiny"), -128_i64, 8_u8, "i8 minimum");
    ExpectSigned(FieldOf(record, "small"), -32768_i64, 16_u8, "i16 minimum");
    ExpectSigned(FieldOf(record, "medium"), -2147483648_i64, 32_u8, "i32 minimum");
    ExpectSigned(FieldOf(record, "large"), -9223372036854775807_i64 - 1_i64, 64_u8, "i64 minimum");
    ExpectUnsigned(FieldOf(record, "octet"), 255_u64, 8_u8, "u8 maximum");
    ExpectUnsigned(FieldOf(record, "port"), 65535_u64, 16_u8, "u16 maximum");
    ExpectUnsigned(FieldOf(record, "unsignedWord"), 4294967295_u64, 32_u8, "u32 maximum");
    ExpectUnsigned(FieldOf(record, "huge"), 18446744073709551615_u64, 64_u8, "u64 maximum");
    ExpectFloat(FieldOf(record, "narrow"), 0x80000000_u64, 32_u8, "f32 negative zero");
    ExpectFloat(FieldOf(record, "wide"), 0x3fb999999999999a_u64, 64_u8, "f64 one tenth");
    match FieldOf(record, "letter") { DataValue::Scalar(value) => Assert.Equal(u32(value), 128512_u32, "non-BMP char"), _ => Assert.Fail("char field is a scalar"), };
    ExpectString(FieldOf(record, "text"), "zażółć 🙂", "string");
    match FieldOf(record, "payload") {
        DataValue::Bytes(bytes) => {
            Assert.Equal(Array.Len<u8>(bytes), 3_i64, "explicit bytes length");
            Assert.Equal(bytes[1], 255_u8, "explicit bytes content");
        },
        _ => Assert.Fail("bytes field uses the bytes representation"),
    };
    match FieldOf(record, "nothing") { DataValue::Unit() => Assert.True(true, "unit has no payload"), _ => Assert.Fail("unit field is unit"), };
    DataValue corners = FieldOf(record, "corners");
    ExpectPoint(FieldOf(corners, "left"), point, 1_i64, -2_i64, "corners.left");
    ExpectPoint(FieldOf(corners, "right"), point, 2147483647_i64, -2147483648_i64, "corners.right");
    match FieldOf(record, "samples") {
        DataValue::Sequence(kind, values) => {
            Assert.True(kind == SequenceKind::Array, "array field keeps the array kind");
            Assert.Equal(Array.Len<DataValue>(values), 2_i64, "array length");
            ExpectSigned(values[0], 9007199254740993_i64, 64_u8, "array item beyond 2^53");
            ExpectSigned(values[1], -9007199254740993_i64, 64_u8, "negative array item beyond 2^53");
        },
        _ => Assert.Fail("array field is a sequence"),
    };
    match FieldOf(record, "tags") {
        DataValue::Sequence(kind, values) => {
            Assert.True(kind == SequenceKind::List, "list field keeps the list kind");
            Assert.Equal(Array.Len<DataValue>(values), 2_i64, "list length");
            ExpectString(values[0], "first", "first list item");
            ExpectString(values[1], "second", "second list item");
        },
        _ => Assert.Fail("list field is a sequence"),
    };
    match FieldOf(record, "counts") {
        DataValue::Map(entries) => {
            Assert.Equal(Array.Len<MapEntry>(entries), 2_i64, "map entry count");
            Assert.Equal(entries[0].key, "alpha", "map keys use ordinal UTF-8 order");
            ExpectSigned(entries[0].value, 1_i64, 64_u8, "map value");
            Assert.Equal(entries[1].key, "beta", "second map key");
        },
        _ => Assert.Fail("string-key map field is a map"),
    };
    match FieldOf(record, "signal") {
        DataValue::Variant(shape, name, payload) => {
            Assert.Equal(Metadata.FormatShapeId(shape), signal, "variant carries the enum shape identity");
            Assert.Equal(name, "Named", "variant identity survives");
            Assert.Equal(Array.Len<DataValue>(payload), 2_i64, "payload arity");
            ExpectString(payload[0], "probe", "first payload field");
            ExpectUnsigned(payload[1], 7_u64, 8_u8, "second payload field");
        },
        _ => Assert.Fail("enum field is a variant"),
    };
    match FieldOf(record, "window") {
        DataValue::Optional(present, payload) => {
            Assert.True(present, "present optional");
            match payload[0] {
                DataValue::Sequence(kind, values) => {
                    Assert.Equal(Array.Len<DataValue>(values), 2_i64, "optional nested array length");
                    ExpectSigned(values[1], -4_i64, 32_u8, "optional nested array item");
                },
                _ => Assert.Fail("optional payload is the nested array"),
            };
        },
        _ => Assert.Fail("optional field is optional"),
    };
    ExpectUnsigned(FieldOf(record, "span"), 4294967295_u64, 32_u8, "word at its declared width");
}

test serialization_generated_variant_identity_and_field_order_survive_roundtrip {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<FullShape>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of FullShape registers");
    ShapeDescriptor full = Descriptors.CompiledShape<FullShape>();
    string[] order = FieldNames(EncodeThroughBsol<FullShape>(FullFixture(), full.id, table));
    string[] declared = ["flag", "tiny", "small", "medium", "large", "octet", "port", "unsignedWord", "huge", "narrow", "wide", "letter", "text", "payload", "nothing", "corners", "samples", "tags", "counts", "signal", "window", "span"];
    Assert.Equal(Array.Len<string>(order), Array.Len<string>(declared), "every declared field is written");
    mut i64 index = 0_i64;
    while (index < Array.Len<string>(declared)) {
        Assert.Equal(order[index], declared[index], "record output follows declaration order");
        index = index + 1_i64;
    }
    Assert.True(Results.IsOk(Registry.RegisterCompiled<Signal>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of Signal registers");
    ShapeDescriptor signal = Descriptors.CompiledShape<Signal>();
    Signal[] values = [Signal::Idle, Signal::Level(-9007199254740993_i64), Signal::Named("", 0_u8)];
    string[] names = ["Idle", "Level", "Named"];
    i64[] arity = [0_i64, 1_i64, 2_i64];
    index = 0_i64;
    while (index < 3_i64) {
        match EncodeThroughBsol<Signal>(values[index], signal.id, table) {
            DataValue::Variant(shape, name, payload) => {
                Assert.Equal(Metadata.FormatShapeId(shape), Metadata.FormatShapeId(signal.id), "root variant carries the compiled enum identity");
                Assert.Equal(name, names[index], "variant discriminant survives");
                Assert.Equal(Array.Len<DataValue>(payload), arity[index], "variant payload arity survives");
            },
            _ => Assert.Fail("enum value encodes as a variant"),
        };
        index = index + 1_i64;
    }
    match EncodeThroughBsol<Signal>(Signal::Level(-9007199254740993_i64), signal.id, table) {
        DataValue::Variant(shape, name, payload) => ExpectSigned(payload[0], -9007199254740993_i64, 64_u8, "variant payload"),
        _ => Assert.Fail("payload variant encodes as a variant"),
    };
}

test serialization_generated_word_uses_declared_width_and_range_checks {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<FullShape>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of FullShape registers");
    ShapeDescriptor root = Descriptors.CompiledShape<FullShape>();
    mut FullShape fixture = FullFixture();
    fixture.span = word(4294967295_u64);
    ExpectUnsigned(FieldOf(EncodeThroughBsol<FullShape>(fixture, root.id, table), "span"), 4294967295_u64, 32_u8, "word maximum at its declared 32-bit width");
    fixture.span = word(4294967296_u64);
    Assert.True(Results.IsError(Serialization.WriteTyped<FullShape>(fixture, root.id, table, Limits.DefaultLimits())), "word value above its declared width rejects instead of truncating");
}

/// JSON test format. It owns its representation: records and maps are objects, sequences are arrays,
/// variants are `{"$variant":name,"payload":[...]}`, absent optionals are `null`, and floats are written
/// as their exact bits with their width (`{"f32":bits}`), never as a coerced decimal.
pub type JsonTraceEncoder : Contracts.Encoder {
    pub string text,
    pub string[] shapes,
    pub string[] fields,
    pub i64[] floatWidths,

    pub Result<unit, SerializationError> Begin(SerializationLimits limits) {
        this.text = "";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> Commit() {
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        return Result::Ok(());
    }
    pub unit Abort() { this.text = ""; }
    pub Result<unit, SerializationError> WriteUnit() { this.text = this.text + "null,"; return Result::Ok(()); }
    pub Result<unit, SerializationError> WriteBoolean(bool value) {
        if (value) { this.text = this.text + "true,"; } else { this.text = this.text + "false,"; }
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> WriteSigned(i64 value, u8 width) { this.text = this.text + Decimal.Signed(value) + ","; return Result::Ok(()); }
    pub Result<unit, SerializationError> WriteUnsigned(u64 value, u8 width) { this.text = this.text + Decimal.Unsigned(value) + ","; return Result::Ok(()); }
    pub Result<unit, SerializationError> WriteFloat(u64 bits, u8 width) {
        Array.Append<i64>(this.floatWidths, i64(width));
        this.text = this.text + "{\"f" + Decimal.Unsigned(u64(width)) + "\":" + Decimal.Unsigned(bits) + "},";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> WriteScalar(char value) { this.text = this.text + "\"" + Decimal.Unsigned(u64(u32(value))) + "\","; return Result::Ok(()); }
    pub Result<unit, SerializationError> WriteString(string value) { this.text = this.text + "\"" + value + "\","; return Result::Ok(()); }
    pub Result<unit, SerializationError> WriteBytes(u8[] value) { this.text = this.text + "\"bytes:" + Array.Len<u8>(value) + "\","; return Result::Ok(()); }
    pub Result<unit, SerializationError> BeginRecord(Metadata.ShapeId shape, i64 fieldCount) {
        Array.Append<string>(this.shapes, Metadata.FormatShapeId(shape));
        this.text = this.text + "{";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> BeginField(string name) {
        Array.Append<string>(this.fields, name);
        this.text = this.text + "\"" + name + "\":";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> EndField() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndRecord() { return Close("}"); }
    pub Result<unit, SerializationError> BeginSequence(i64 count) { this.text = this.text + "["; return Result::Ok(()); }
    pub Result<unit, SerializationError> EndSequence() { return Close("]"); }
    pub Result<unit, SerializationError> BeginMap(i64 count) { this.text = this.text + "{"; return Result::Ok(()); }
    pub Result<unit, SerializationError> BeginMapEntry(string key) { this.text = this.text + "\"" + key + "\":"; return Result::Ok(()); }
    pub Result<unit, SerializationError> EndMapEntry() { return Result::Ok(()); }
    pub Result<unit, SerializationError> EndMap() { return Close("}"); }
    pub Result<unit, SerializationError> BeginVariant(Metadata.ShapeId shape, string name, i64 payloadCount) {
        Array.Append<string>(this.shapes, Metadata.FormatShapeId(shape));
        this.text = this.text + "{\"$variant\":\"" + name + "\",\"payload\":[";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> EndVariant() {
        Close("]");
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        this.text = this.text + "},";
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> BeginOptional(bool present) {
        if (!present) { this.text = this.text + "null,"; }
        return Result::Ok(());
    }
    pub Result<unit, SerializationError> EndOptional() { return Result::Ok(()); }

    Result<unit, SerializationError> Close(string closer) {
        if (String.EndsWith(this.text, ",")) { this.text = String.SubSlice(this.text, 0_i64, String.Len(this.text) - 1_i64); }
        this.text = this.text + closer + ",";
        return Result::Ok(());
    }
}

JsonTraceEncoder NewJsonTrace() {
    return JsonTraceEncoder { text: "", shapes: Array.Empty<string>(), fields: Array.Empty<string>(), floatWidths: Array.Empty<i64>() };
}

test serialization_generated_record_uses_one_descriptor_for_bsol_and_json {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<Pair<Point>>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of Pair<Point> registers");
    ShapeDescriptor pair = Descriptors.CompiledShape<Pair<Point>>();
    string point = Metadata.FormatShapeId(Descriptors.CompiledShape<Point>().id);
    Pair<Point> value = Pair<Point> { left: Point { x: 1_i32, y: -2_i32 }, right: Point { x: 2147483647_i32, y: (-2147483647_i32 - 1_i32) } };
    JsonTraceEncoder json = NewJsonTrace();
    match Contracts.Encode<Pair<Point>, JsonTraceEncoder>(value, json, Limits.DefaultLimits()) {
        Result::Error(error) => Assert.Fail("generated adapter drives the JSON test format: " + Errors.Code(error)),
        Result::Ok(_) => { },
    };
    Assert.Equal(json.text, "{\"left\":{\"x\":1,\"y\":-2},\"right\":{\"x\":2147483647,\"y\":-2147483648}}", "JSON test format owns its representation of the same calls");
    Assert.Equal(Array.Len<string>(json.shapes), 3_i64, "one record shape per record value");
    Assert.Equal(json.shapes[0], Metadata.FormatShapeId(pair.id), "JSON adapter receives the compiled generic record descriptor identity");
    Assert.Equal(json.shapes[1], point, "JSON adapter receives the compiled nested record identity");
    DataValue bsol = EncodeThroughBsol<Pair<Point>>(value, pair.id, table);
    Assert.Equal(RecordShape(bsol), json.shapes[0], "BSOL and JSON use the same root descriptor");
    Assert.Equal(RecordShape(FieldOf(bsol, "left")), json.shapes[1], "BSOL and JSON use the same nested descriptor");
    string[] order = FieldNames(bsol);
    Assert.Equal(order[0], json.fields[0], "both formats receive the same first declared field");
    Assert.Equal(order[1], json.fields[3], "both formats receive the same second declared field");
    Assert.Equal(Array.Len<FieldDescriptor>(pair.fields), 2_i64, "the descriptor declares both generic fields");
    Assert.Equal(pair.fields[0].name, json.fields[0], "descriptor field order is the adapter field order");
}

test serialization_generated_f32_and_f64_bits_survive_both_formats_without_coercion {
    Registry.ShapeRegistry table = Registry.Create();
    Assert.True(Results.IsOk(Registry.RegisterCompiled<Pair<Sample>>(table, 1048576_i64, 8388608_i64, 100000_i64)), "compiler-issued descriptor closure of Pair<Sample> registers");
    ShapeDescriptor pair = Descriptors.CompiledShape<Pair<Sample>>();
    Pair<Sample> value = Pair<Sample> {
        left: Sample { narrow: FloatBits.FromBits32(0x80000000_u32), wide: FloatBits.FromBits64(0x3fb999999999999a_u64) },
        right: Sample { narrow: FloatBits.FromBits32(0x3dcccccd_u32), wide: FloatBits.FromBits64(0x8000000000000000_u64) },
    };
    JsonTraceEncoder json = NewJsonTrace();
    Assert.True(Results.IsOk(Contracts.Encode<Pair<Sample>, JsonTraceEncoder>(value, json, Limits.DefaultLimits())), "generated adapter drives the JSON test format");
    Assert.Equal(Array.Len<i64>(json.floatWidths), 4_i64, "four float calls");
    Assert.Equal(json.floatWidths[0], 32_i64, "f32 field reaches the format at width 32");
    Assert.Equal(json.floatWidths[1], 64_i64, "f64 field reaches the format at width 64");
    Assert.True(String.Contains(json.text, "{\"f32\":2147483648}"), "JSON keeps f32 negative zero bits");
    Assert.True(String.Contains(json.text, "{\"f64\":4591870180066957722}"), "JSON keeps f64 one tenth bits");
    Assert.True(String.Contains(json.text, "{\"f32\":1036831949}"), "JSON keeps f32 one tenth bits without widening");
    Assert.True(String.Contains(json.text, "{\"f64\":9223372036854775808}"), "JSON keeps f64 negative zero bits");
    DataValue bsol = EncodeThroughBsol<Pair<Sample>>(value, pair.id, table);
    ExpectFloat(FieldOf(FieldOf(bsol, "left"), "narrow"), 0x80000000_u64, 32_u8, "BSOL f32 negative zero");
    ExpectFloat(FieldOf(FieldOf(bsol, "left"), "wide"), 0x3fb999999999999a_u64, 64_u8, "BSOL f64 one tenth");
    ExpectFloat(FieldOf(FieldOf(bsol, "right"), "narrow"), 0x3dcccccd_u64, 32_u8, "BSOL f32 one tenth");
    ExpectFloat(FieldOf(FieldOf(bsol, "right"), "wide"), 0x8000000000000000_u64, 64_u8, "BSOL f64 negative zero");
}
