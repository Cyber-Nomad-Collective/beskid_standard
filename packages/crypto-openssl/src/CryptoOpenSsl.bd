/// Optional OpenSSL libcrypto 3 acceleration provider for `corelib_crypto` (ruling R20).
/// Linux only: every module here imports `libcrypto.so.3`, so a program that depends on
/// this package does not load on a host without that library. The default
/// `corelib_crypto` package stays pure Beskid and loads everywhere.
pub i64 PackageVersion() { return 1_i64; }
pub mod CryptoOpenSsl.Native;
pub mod CryptoOpenSsl.NativeSha256;
pub mod CryptoOpenSsl.NativeSha512;
pub mod CryptoOpenSsl.NativeHmac;
pub mod CryptoOpenSsl.NativeAesGcm;
pub mod CryptoOpenSsl.NativeChaCha20Poly1305;
pub mod CryptoOpenSsl.Provider;
