use Core.IO.IoError;
use Core.IO.TransferFailure;

/// Typed HTTP failures. Transport carries the Foundation cause unchanged; HTTP adds no transport cause of its own.
pub enum HttpError {
    InvalidFraming(), InvalidStartLine(), InvalidHeader(), InvalidMethod(),
    InvalidTarget(), InvalidStatus(), InvalidContentLength(), AmbiguousFraming(),
    UnsupportedTransferCoding(), InvalidChunk(), HeaderTooLarge(), TooManyHeaders(),
    BodyTooLarge(), UnexpectedEof(), TrailingBytes(), Transport(TransferFailure cause), Network(), Closed(),
    MissingHost(), InvalidHost(), CloseDelimitedBody(), InterimResponse(),
}

/// The one Core.IO to HTTP mapping used by Wire, Client, and Server.
pub HttpError FromIoError(IoError error) {
    return match error {
        IoError::ReadFailed(cause) => HttpError::Transport(cause),
        IoError::WriteFailed(cause) => HttpError::Transport(cause),
        IoError::UnexpectedEof(_) => HttpError::UnexpectedEof(),
        IoError::InvalidRange => HttpError::Transport(TransferFailure::Unspecified()),
        IoError::NoProgress => HttpError::Transport(TransferFailure::Unspecified()),
        IoError::CloseFailed => HttpError::Transport(TransferFailure::Unspecified()),
    };
}
