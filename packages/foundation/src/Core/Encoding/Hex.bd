/// Hexadecimal encoding (lowercase encode).
/// @tier(standard)
use Core.Bytes.Convert;
use Core.Bytes.Slice;
use Core.Encoding.EncodingError;
use Core.Results;

pub u8 NibbleToHex(u8 nibble) {
    if nibble < 10_u8 {
        return 48 + nibble;
    }
    return 87 + nibble;
}

pub u8 HexToNibble(u8 digit) {
    if digit >= 48_u8 && digit <= 57_u8 {
        return digit - 48;
    }
    if digit >= 65_u8 && digit <= 70_u8 {
        return digit - 55;
    }
    if digit >= 97_u8 && digit <= 102_u8 {
        return digit - 87;
    }
    return 255;
}

pub Core.Results.Result<u8[], EncodingError> EncodeBytes(u8[] data) {
    i64 len = Slice.Len(data);
    u8[] buf = Slice.New(len * 2);
    mut i64 i = 0;
    while i < len {
        u8 b = Slice.Get(data, i);
        u8 hi = b / 16;
        u8 lo = b % 16;
        Slice.Set(buf, i * 2, NibbleToHex(hi));
        Slice.Set(buf, i * 2 + 1, NibbleToHex(lo));
        i = i + 1;
    }
    return Result::Ok(buf);
}

pub Core.Results.Result<u8[], EncodingError> DecodeBytes(u8[] data) {
    i64 len = Slice.Len(data);
    if len % 2 != 0 {
        return Result::Error(EncodingError::OddLength(len));
    }
    i64 outLen = len / 2;
    u8[] buf = Slice.New(outLen);
    mut i64 i = 0;
    while i < outLen {
        u8 hi = HexToNibble(Slice.Get(data, i * 2));
        u8 lo = HexToNibble(Slice.Get(data, i * 2 + 1));
        if hi > 15_u8 || lo > 15_u8 {
            return Result::Error(EncodingError::InvalidSequence(EncodingErrorDetail { position: i * 2, value: 0 }));
        }
        Slice.Set(buf, i, hi * 16 + lo);
        i = i + 1;
    }
    return Result::Ok(buf);
}

pub Core.Results.Result<u8[], EncodingError> EncodeToBytes(string text) {
    return EncodeBytes(Convert.StringToBytes(text));
}

pub Core.Results.Result<string, EncodingError> DecodeFromBytes(u8[] data) {
    return match DecodeBytes(data) {
        Result::Ok(bytes) => Core.Encoding.Utf8.DecodeFromBytes(bytes),
        Result::Error(err) => Result::Error(err),
    };
}
