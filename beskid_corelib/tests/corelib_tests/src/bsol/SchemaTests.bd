//! `BsolSchemaTests`: profile self-validation (BSOL-06-03). Each section keeps the tests of one former
//! target unchanged.

use Core.Bsol.Parser;
use Core.Output;
use Core.Bsol.Schema;
use Core.Bsol.Limits;
use Core.Collections.Array;
use Core.Results;
use Testing.Assert;
use Core.Bsol.Syntax;
use Core.Environment;
use Core.FS;

// ---- SchemaTests.bd (target `BsolSchemaTests`) ----

string FixtureProfile()
{
    return "profile \"fixture.v2\" {
  version = 2
  rule \"config\" {
    scope = top
    match = keyword
    keyword = config
    label = forbidden
    cardinality = one
    extras = false
    field \"name\" { type = quoted required = true }
    field \"count\" { type = u32 required = false }
    field \"enabled\" { type = bool required = false }
  }
}";
}

Result<Schema.ValidatedDocument, Schema.Diagnostic[]> ValidateFixture(string source)
{
    match (Schema.ParseProfile(FixtureProfile(), Limits.DefaultLimits()))
    {
        Result::Error(_) => {
            Assert.Fail("valid declared profile compiles natively");
            return Result::Error(Array.Empty<Schema.Diagnostic>());
        },

        Result::Ok(profile) => match (Parser.Parse(source, Limits.DefaultLimits()))
        {
            Result::Error(_) => {
                Assert.Fail("validation fixture is syntactically valid");
                return Result::Error(Array.Empty<Schema.Diagnostic>());
            },

            Result::Ok(document) => {
                Output.WriteLine("schema diagnostic source " + source);
                mut i64 ruleIndex = 0_i64;
                while (ruleIndex < Array.Len<Schema.Rule>(profile.rules))
                {
                    Schema.Rule rule = profile.rules[ruleIndex];
                    Output.WriteLine("schema rule " + rule.name + " fields " + Array.Len<Schema.Field>(rule.fields));
                    mut i64 fieldIndex = 0_i64;
                    while (fieldIndex < Array.Len<Schema.Field>(rule.fields))
                    {
                        Schema.Field field = rule.fields[fieldIndex];
                        Output.WriteLine("schema field " + field.name + " type " + field.typeIndex + " default " + field.defaultNode);
                        if (field.required)
                        {
                            Output.WriteLine("schema field required true");
                        }
                        else
                        {
                            Output.WriteLine("schema field required false");
                        }
                        fieldIndex = fieldIndex + 1_i64;
                    }
                    ruleIndex = ruleIndex + 1_i64;
                }
                match (Schema.Validate(document, profile, Limits.DefaultLimits()))
                {
                    Result::Ok(validated) => {
                        Output.WriteLine("schema validation OK");
                        return Result::Ok(validated);
                    },

                    Result::Error(diagnostics) => {
                        Output.WriteLine("schema diagnostics " + Array.Len<Schema.Diagnostic>(diagnostics));
                        mut i64 diagnosticIndex = 0_i64;
                        while (diagnosticIndex < Array.Len<Schema.Diagnostic>(diagnostics))
                        {
                            Schema.Diagnostic diagnostic = diagnostics[diagnosticIndex];
                            Output.WriteLine("schema error " + diagnostic.code + " field " + diagnostic.field + " rule " + diagnostic.rule);
                            diagnosticIndex = diagnosticIndex + 1_i64;
                        }
                        return Result::Error(diagnostics);
                    },
                };
            },
        },
    };
}

unit RequireDiagnostic(string source, string code, string field)
{
    match (ValidateFixture(source))
    {
        Result::Ok(_) => Assert.Fail("invalid profile input must reject"),

        Result::Error(diagnostics) => {
            mut bool found = false;
            mut i64 i = 0_i64;
            while (i < Array.Len<Schema.Diagnostic>(diagnostics))
            {
                Schema.Diagnostic diagnostic = diagnostics[i];
                if (diagnostic.code == code && diagnostic.field == field)
                {
                    found = true;
                    Assert.True(match (diagnostic.stage)
                    {
                        Schema.DiagnosticStage::Validation => true,

                        _ => false,
                    }, "profile violation owns validation stage");
                    Assert.Equal(diagnostic.profile, "fixture.v2", "profile identity retained on diagnostic");
                    Assert.True(diagnostic.span.start >= 0_i64 && diagnostic.span.end >= diagnostic.span.start, "ordered source byte span");
                    if (code == "DuplicateField")
                    {
                        Assert.True(diagnostic.hasRelated, "duplicate exposes previous definition span");
                        Assert.True(diagnostic.relatedSpan.start < diagnostic.span.start, "both duplicate assignment spans ordered");
                    }
                    if (code == "TypeMismatch" || code == "UnknownField")
                    {
                        Assert.True(diagnostic.span.end > diagnostic.span.start, "offending existing syntax has nonempty source span");
                    }
                }
                i = i + 1_i64;
            }
            Assert.True(found, "required stable diagnostic code and field found");
        },
    };
}

test BsolNativeProfileV1AndV2DeclaredRuleLoad
{
    match (Schema.ParseProfile(FixtureProfile(), Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("v2 fixture profile loads"),

        Result::Ok(profile) => {
            Assert.Equal(profile.name, "fixture.v2", "declared profile name");
            Assert.Equal(profile.version, 2_i64, "declared v2 version");
        },
    };

    string v1 = "profile \"fixture.v1\" { version = 1 rule \"config\" { scope = top match = keyword keyword = config label = forbidden cardinality = one field \"name\" { type = quoted required = true } } }";

    match (Schema.ParseProfile(v1, Limits.DefaultLimits()))
    {
        Result::Error(_) => Assert.Fail("v1 fixture profile loads using real rule grammar"),

        Result::Ok(profile) => Assert.Equal(profile.version, 1_i64, "v1 identity stays explicit"),
    };
}

test BsolNativeSchemaValidPrimitivesReturnCheckedDocument
{
    match (ValidateFixture("config { name = \"native\" count = 4294967295 enabled = true }"))
    {
        Result::Error(_) => Assert.Fail("declared quoted u32 and bool validate"),

        Result::Ok(validated) => Assert.Equal(validated.profile, "fixture.v2", "checked result retains profile identity"),
    };
}

test BsolNativeSchemaMissingRequiredField
{
    RequireDiagnostic("config { count = 1 }", "MissingField", "name");
}

test BsolNativeSchemaDuplicateFieldKeepsBothSpans
{
    RequireDiagnostic("config { name = \"first\" name = \"second\" }", "DuplicateField", "name");
}

test BsolNativeSchemaUnknownFieldRejectsWithoutExtras
{
    RequireDiagnostic("config { name = \"ok\" unexpected = true }", "UnknownField", "unexpected");
}

test BsolNativeSchemaWrongPrimitiveKindAndIntegerRange
{
    RequireDiagnostic("config { name = native }", "TypeMismatch", "name");

    RequireDiagnostic("config { name = \"ok\" count = -1 }", "TypeMismatch", "count");

    RequireDiagnostic("config { name = \"ok\" count = 4294967296 }", "TypeMismatch", "count");

    RequireDiagnostic("config { name = \"ok\" enabled = \"true\" }", "TypeMismatch", "enabled");
}

test BsolNativeSchemaInvalidProfileFailsAtProfileBoundary
{
    string invalid = "profile \"broken.v2\" { version = 2 rule \"config\" { scope = top match = keyword keyword = config label = forbidden cardinality = one field \"name\" { type = made_up_type required = true } } }";

    match (Schema.ParseProfile(invalid, Limits.DefaultLimits()))
    {
        Result::Ok(_) => Assert.Fail("unknown declared field type rejects profile"),

        Result::Error(diagnostics) => {
            Assert.True(Array.Len<Schema.Diagnostic>(diagnostics) > 0_i64, "profile diagnostic returned");
            Assert.True(match (diagnostics[0].stage)
            {
                Schema.DiagnosticStage::Profile => true,

                _ => false,
            }, "invalid schema owns profile stage");
        },
    };
}

// ---- BuiltinProfilesTests.bd (formerly target `BsolBuiltinProfilesTests`) ----

/// Native profile loading uses the exact standalone bootstrap schema files.
/// This verifies profile parsing/composition, not host materialization authority
/// or generated typed adapter eligibility.
unit CheckProfile(string directory, string name)
{
    match (FS.ReadAllText(directory + "/../schemas/" + name + ".bsol"))
    {
        Result::Error(_) => {
            Assert.Fail("canonical embedded profile must be readable");
        },
        Result::Ok(source) => {
            match (Parser.Parse(source, Limits.DefaultLimits()))
            {
                Result::Error(_) => {
                    Assert.Fail("canonical profile BSOL syntax must parse");
                },
                Result::Ok(document) => {
                    match (Schema.ParseProfile(source, Limits.DefaultLimits()))
                    {
                        Result::Error(_) => {
                            Assert.Fail("canonical profile definitions must parse natively");
                        },
                        Result::Ok(profile) => {
                            Assert.Equal(name, profile.name, "canonical profile identity preserved");
                            match (Schema.Compose(profile, Limits.DefaultLimits()))
                            {
                                Result::Error(_) => {
                                    Assert.Fail("canonical profile composition must validate");
                                },
                                Result::Ok(composed) => {
                                    Assert.True(Array.Len<Schema.Rule>(composed.rules) > 0_i64, "canonical profile retains rules");
                                },
                            };
                        },
                    };
                },
            };
        },
    };
}

/// @native-only
test BsolAllFourteenCanonicalProfilesParseAndCompose
{
    match (Environment.Get("BESKID_BSOL_CORPUS"))
    {
        Result::Error(_) => {
            Assert.Fail("BESKID_BSOL_CORPUS must name the shared conformance root");
        },
        Result::Ok(directory) => {
            CheckProfile(directory, "schema.v1");
            CheckProfile(directory, "schema.v2");
            CheckProfile(directory, "project.v1");
            CheckProfile(directory, "project.v2");
            CheckProfile(directory, "workspace.v1");
            CheckProfile(directory, "runtime.v1");
            CheckProfile(directory, "runtime.v2");
            CheckProfile(directory, "board.v1");
            CheckProfile(directory, "board.v2");
            CheckProfile(directory, "board.v3");
            CheckProfile(directory, "shell.pages.v1");
            CheckProfile(directory, "tools.config.v1");
            CheckProfile(directory, "configuration.v1");
            CheckProfile(directory, "configuration.v2");
        },
    };
}

unit CheckNumericBinding(Schema.ValidatedDocument document, string name, string expected, bool defaulted)
{
    mut bool found = false;
    mut i64 i = 0_i64;
    while (i < Array.Len<Schema.FieldBinding>(document.fields))
    {
        Schema.FieldBinding binding = document.fields[i];
        Schema.Field field = document.schema.rules[binding.rule].fields[binding.field];
        if (field.name == name)
        {
            found = true;
            Assert.Equal(binding.fromDefault, defaulted, "default provenance retained");
            Assert.Equal(binding.value.raw, expected, "exact numeric value retained");
            Assert.True(match (binding.value.kind)
            {
                Syntax.NodeKind::Number => true,
                _ => false,
            }, "numeric binding remains typed");
        }
        i = i + 1_i64;
    }
    Assert.True(found, "declared numeric binding available for typed mapping");
}

unit CheckProfileDocument(string directory, string name, bool accepted)
{
    mut string suffix = "invalid";
    if (accepted)
    {
        suffix = "valid";
    }
    match (FS.ReadAllText(directory + "/cases/builtin-profiles/" + name + "." + suffix + ".bsol"))
    {
        Result::Error(_) => Assert.Fail("shared builtin document must be readable"),
        Result::Ok(source) => match (Parser.Parse(source, Limits.DefaultLimits()))
        {
            Result::Error(_) => Assert.Fail("builtin positive and negative documents have valid syntax"),
            Result::Ok(document) => match (FS.ReadAllText(directory + "/../schemas/" + name + ".bsol"))
            {
                Result::Error(_) => Assert.Fail("canonical profile must be readable"),
                Result::Ok(profileSource) => match (Schema.ParseProfile(profileSource, Limits.DefaultLimits()))
                {
                    Result::Error(_) => Assert.Fail("canonical profile must parse"),
                    Result::Ok(profile) => match (Schema.Validate(document, profile, Limits.DefaultLimits()))
                    {
                        Result::Ok(checked) => {
                            Assert.True(accepted, "missing required root must reject");
                            Assert.Equal(checked.schema.name, name, "validated document retains exact profile");
                            if (name == "schema.v2")
                            {
                                CheckNumericBinding(checked, "version", "2", false);
                            }
                            if (name == "board.v3")
                            {
                                CheckNumericBinding(checked, "version", "3", true);
                            }
                            if (name == "runtime.v1" || name == "runtime.v2")
                            {
                                CheckNumericBinding(checked, "abi_version", "5", false);
                            }
                        },
                        Result::Error(errors) => {
                            Assert.True(!accepted, "ordinary builtin document must validate");
                            mut bool cardinality = false;
                            mut i64 i = 0_i64;
                            while (i < Array.Len<Schema.Diagnostic>(errors))
                            {
                                if (errors[i].code == "Cardinality")
                                {
                                    cardinality = true;
                                }
                                i = i + 1_i64;
                            }
                            Assert.True(cardinality, "missing required root reports cardinality");
                        },
                    },
                },
            },
        },
    };
}

/// @native-only
test BsolAllFourteenBuiltinProfilesValidateRealDocuments
{
    match (Environment.Get("BESKID_BSOL_CORPUS"))
    {
        Result::Error(_) => Assert.Fail("shared conformance root required"),
        Result::Ok(directory) => {
            CheckProfileDocument(directory, "schema.v1", true);
            CheckProfileDocument(directory, "schema.v1", false);
            CheckProfileDocument(directory, "schema.v2", true);
            CheckProfileDocument(directory, "schema.v2", false);
            CheckProfileDocument(directory, "project.v1", true);
            CheckProfileDocument(directory, "project.v1", false);
            CheckProfileDocument(directory, "project.v2", true);
            CheckProfileDocument(directory, "project.v2", false);
            CheckProfileDocument(directory, "workspace.v1", true);
            CheckProfileDocument(directory, "workspace.v1", false);
            CheckProfileDocument(directory, "runtime.v1", true);
            CheckProfileDocument(directory, "runtime.v1", false);
            CheckProfileDocument(directory, "runtime.v2", true);
            CheckProfileDocument(directory, "runtime.v2", false);
            CheckProfileDocument(directory, "board.v1", true);
            CheckProfileDocument(directory, "board.v1", false);
            CheckProfileDocument(directory, "board.v2", true);
            CheckProfileDocument(directory, "board.v2", false);
            CheckProfileDocument(directory, "board.v3", true);
            CheckProfileDocument(directory, "board.v3", false);
            CheckProfileDocument(directory, "shell.pages.v1", true);
            CheckProfileDocument(directory, "shell.pages.v1", false);
            CheckProfileDocument(directory, "tools.config.v1", true);
            CheckProfileDocument(directory, "tools.config.v1", false);
            CheckProfileDocument(directory, "configuration.v1", true);
            CheckProfileDocument(directory, "configuration.v1", false);
            CheckProfileDocument(directory, "configuration.v2", true);
            CheckProfileDocument(directory, "configuration.v2", false);
        },
    };
}
