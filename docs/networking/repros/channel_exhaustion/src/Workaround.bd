// WORKAROUND: create one channel and reuse it; never create a channel per call.
use Concurrency.Channel;
use Core.Output;
use Core.Results;
use Testing.Assert;

test one_channel_reused_70_times {
    Channel<i64> ch = Channel<i64>.Create();
    mut i64 failures = 0_i64;
    mut i64 i = 0_i64;
    while i < 70_i64 {
        Channel<i64>.Send(ch, i);
        match Channel<i64>.Receive(ch) {
            Result::Ok(_) => (),
            Result::Error(_) => { failures = failures + 1_i64; },
        };
        i = i + 1_i64;
    }
    Output.WriteLine("workaround: one channel, 70 send/receive rounds, failures counted");
    Assert.Equal<i64>(failures, 0_i64, "no Receive failed");
}
