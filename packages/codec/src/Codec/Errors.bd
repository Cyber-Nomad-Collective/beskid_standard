use Core.IO.IoError;

/// Typed failures of every Codec primitive. No primitive panics or reads out of bounds.
pub enum CodecError {
    // The input ended before the requested bytes were available.
    Truncated(),
    // A value does not fit the requested wire width, or arithmetic would overflow.
    Overflow(),
    // A configured size, count or line limit was exceeded.
    LimitExceeded(),
    // A length prefix is outside its declared min..max bounds.
    InvalidLength(),
    // A line is not terminated by CRLF (bare LF or bare CR).
    InvalidLine(),
    // An argument is outside its documented domain (for example a width of 9).
    InvalidValue(),
    // A fixed-capacity buffer is full and cannot accept more bytes.
    BufferFull(),
    // The underlying Core.IO reader failed; the cause is kept unchanged.
    Io(IoError cause),
}

/// The one Core.IO to Codec mapping. A clean EOF mid-read is Truncated.
pub CodecError FromIoError(IoError error) {
    return match error {
        IoError::UnexpectedEof(_) => CodecError::Truncated(),
        IoError::InvalidRange => CodecError::InvalidValue(),
        IoError::NoProgress => CodecError::Io(IoError::NoProgress()),
        IoError::CloseFailed => CodecError::Io(IoError::CloseFailed()),
        IoError::ReadFailed(cause) => CodecError::Io(IoError::ReadFailed(cause)),
        IoError::WriteFailed(cause) => CodecError::Io(IoError::WriteFailed(cause)),
    };
}

/// Stable small integer per variant (Truncated 1, Overflow 2, LimitExceeded 3,
/// InvalidLength 4, InvalidLine 5, InvalidValue 6, BufferFull 7, Io 8). For tests and logs.
pub i64 Code(CodecError error) {
    return match error {
        CodecError::Truncated => 1_i64,
        CodecError::Overflow => 2_i64,
        CodecError::LimitExceeded => 3_i64,
        CodecError::InvalidLength => 4_i64,
        CodecError::InvalidLine => 5_i64,
        CodecError::InvalidValue => 6_i64,
        CodecError::BufferFull => 7_i64,
        CodecError::Io(_) => 8_i64,
    };
}
