impl<R> Signed64<R> : FieldDecoder<i64, R> where R: Reader {
    pub Result<i64, SerializationError> Read(R reader, SerializationLimits limits) {
        i64 value = reader.ReadSigned(64_u8)?;
        
        return Result::Ok(value);
    }
}
pub Signed64<R> CreateSigned64<R>() { return Signed64<R> {}; }

pub type Unsigned8<R> {}
impl<R> Unsigned8<R> : FieldDecoder<u8, R> where R: Reader {
    pub Result<u8, SerializationError> Read(R reader, SerializationLimits limits) {
        u64 value = reader.ReadUnsigned(8_u8)?;
        if (value > 255_u64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(u8(value));
    }
}
pub Unsigned8<R> CreateUnsigned8<R>() { return Unsigned8<R> {}; }

pub type Unsigned16<R> {}
impl<R> Unsigned16<R> : FieldDecoder<u16, R> where R: Reader {
    pub Result<u16, SerializationError> Read(R reader, SerializationLimits limits) {
        u64 value = reader.ReadUnsigned(16_u8)?;
        if (value > 65535_u64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(u16(value));
    }
}
pub Unsigned16<R> CreateUnsigned16<R>() { return Unsigned16<R> {}; }

pub type Unsigned32<R> {}
impl<R> Unsigned32<R> : FieldDecoder<u32, R> where R: Reader {
    pub Result<u32, SerializationError> Read(R reader, SerializationLimits limits) {
        u64 value = reader.ReadUnsigned(32_u8)?;
        if (value > 4294967295_u64) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(u32(value));
    }
}
pub Unsigned32<R> CreateUnsigned32<R>() { return Unsigned32<R> {}; }

pub type Unsigned64<R> {}
impl<R> Unsigned64<R> : FieldDecoder<u64, R> where R: Reader {
    pub Result<u64, SerializationError> Read(R reader, SerializationLimits limits) {
