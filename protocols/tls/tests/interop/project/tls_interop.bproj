tls_interop {
  name = "tls_interop"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_tls" { source = path path = "../../.." }
dependency "corelib_x509" { source = path path = "../../../../x509" }
dependency "corelib_codec" { source = path path = "../../../../codec" }
target "InteropClient" { kind = Lib entry = "ClientTests.bd" }
target "InteropServer" { kind = Lib entry = "ServerTests.bd" }
