/// Canary: Contract methods can be called on a `where T: Contract` generic.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

pub contract Sized {
    i64 Size();
}

pub type Box : Sized {
    i64 n,

    pub i64 Size() {
        return this.n;
    }
}

i64 SizeOf<T>(T value) where T: Sized {
    return value.Size();
}

test contract_dispatch_on_bounded_generic {
    Assert.True(SizeOf<Box>(Box { n: 3 }) == 3, "contract method on bounded generic");
}
