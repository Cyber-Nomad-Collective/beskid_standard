/// `ArrayIterator<T>` conformance to the generic `Query.Iterator<T>` contract (`type Item`,
/// `This MoveNext()`), called with method syntax (`it.Current()`, `it.MoveNext()`). The
/// module-function form (`ArrayIterator.Current<T>(it)`) is covered by `QueryTests.bd`.

use Core.Collections.Array;
use Core.Optional.Option;
use Query.ArrayIterator;
use Testing.Assert;

test array_iterator_conforms_to_iterator_current_returns_first_element {
    mut i64[] arr = Array.Empty<i64>();
    Array.Append<i64>(arr, 42);
    Array.Append<i64>(arr, 99);
    ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
    Option<i64> first = it.Current();
    Assert.True(Option.HasValue(first), "Iterator<T> conformance: Current() returns Some for the first element");
    match first {
        Option::Some(v) => { Assert.Equal(v, 42, "first element via method dispatch is 42"); },
        Option::None => { },
    };
}

test array_iterator_conforms_to_iterator_movenext_advances_and_returns_this {
    mut i64[] arr = Array.Empty<i64>();
    Array.Append<i64>(arr, 1);
    Array.Append<i64>(arr, 2);
    ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
    ArrayIterator<i64> advanced = it.MoveNext();
    Option<i64> second = advanced.Current();
    Assert.True(Option.HasValue(second), "Iterator<T> conformance: MoveNext() advances (This-returning)");
    match second {
        Option::Some(v) => { Assert.Equal(v, 2, "second element after MoveNext is 2"); },
        Option::None => { },
    };
}

test array_iterator_conforms_to_iterator_current_returns_none_past_the_end {
    mut i64[] arr = Array.Empty<i64>();
    Array.Append<i64>(arr, 7);
    ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
    ArrayIterator<i64> past = it.MoveNext();
    Option<i64> none = past.Current();
    Assert.False(Option.HasValue(none), "Iterator<T> conformance: Current() past the end is None");
}
