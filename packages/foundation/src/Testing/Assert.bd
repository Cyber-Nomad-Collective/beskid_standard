/// Shouldly-style assertion helpers for Beskid `test` blocks and user tests.
/// Prefer actual-first argument order: `Testing.Assert.Equal(len, 3, "because")`.
///
/// A failed assertion ends the test through a dedicated failure file, not through free text.
/// The runner of `beskid test` names the file in the environment variable `BESKID_TEST_FAILURE_FILE`;
/// the failure writes one framed `FailureRecord` there and then aborts the process with the headline
/// as its message. `beskid test` reads only that file, prints `assertion failed: expected 3, found 4`
/// with the because text and the call site under the test name, and reports a runtime trap without a
/// record as `test crashed`. Outside `beskid test` the variable is absent and only the abort message remains.
///
/// `Equal` and `NotEqual` take any `T` that conforms to `Core.Text.Formatting` (every integer and
/// float type, `bool`, `char` and `string`) and put the text form of both values into the record.
///
/// Every public helper ends with the optional caller-information parameters `file`, `line` and
/// `column`. A call omits them and the compiler passes the position of the call; a helper that
/// forwards a failure passes its own caller information on explicitly. `because` is optional too:
/// `Assert.Equal(1, 1)` is a complete call.

use Core.String;
use Core.Environment;
use Core.FS;
use Core.FS.FsError;
use Core.Optional.Option;
use Core.Results;
use Core.Text.Formatting;

/// Name of the environment variable that carries the failure file path.
pub string FailureFileVariable() {
    return "BESKID_TEST_FAILURE_FILE";
}

/// Emits a message and ends the test process through the runtime abort path.
unit TriggerFailure(string message) {
    __panic_str(message);
}

/// Forces a complete garbage-collection cycle for runtime-sensitive tests.
/// The runtime live-byte result stays internal because tests only require the collection side effect.
pub unit CollectGarbage() {
    __gc_collect();
    return;
}

/// One failed assertion. `Frame` is the file format that `beskid test` reads: the line
/// `BESKID-TEST-FAILURE/2`, then each field as `<byte length>:<bytes>` and a newline, in the order
/// headline, because, expected, actual, file, line, column. An empty text is absent.
pub type FailureRecord {
    pub string headline;
    pub string because;
    pub string expected;
    pub string actual;
    pub string file;
    pub i64 line;
    pub i64 column;

    string Field(string text) {
        return "${String.Len(text)}:" + text + "
";
    }

    pub string Frame() {
        return "BESKID-TEST-FAILURE/2
" + Field(this.headline) + Field(this.because) + Field(this.expected) + Field(this.actual)
            + Field(this.file) + Field("${this.line}") + Field("${this.column}");
    }
}

/// Writes the record to the failure file named by the environment, then aborts with the headline.
unit Raise(FailureRecord record) {
    Option<string> path = Environment.TryGet(FailureFileVariable());
    match path {
        Option::Some(target) => {
            Result<unit, FsError> written = FS.WriteAllText(target, record.Frame());
            match written {
                Result::Ok(_) => {},
                Result::Error(_) => {},
            };
        },
        Option::None => {},
    };
    TriggerFailure("assertion failed: " + record.headline);
}

string Quoted(string text) {
    return "\"" + text + "\"";
}

/// Unconditionally fails the current test.
/// @arg(message) Failure reason surfaced to the user.
pub unit Fail(string message, [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    Raise(FailureRecord { headline: message, because: "", expected: "", actual: "", file: file, line: line, column: column });
}

unit FailWithValues(string headline, string because, string expected, string actual, string file, i64 line, i64 column) {
    Raise(FailureRecord { headline: headline, because: because, expected: expected, actual: actual, file: file, line: line, column: column });
}

/// Fails the current test with an expected and an observed value that are already rendered as text.
/// `Equal`, `NotEqual` and `Testing.Expect.Equal` use it with the `Formatting` text of both values.
/// @arg(expected) Rendered expected value.
/// @arg(actual) Rendered observed value.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit FailEqual(string expected, string actual, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    FailWithValues("expected " + expected + ", found " + actual, because, expected, actual, file, line, column);
}

/// Fails when actual and expected values differ. The failure shows both values as text.
/// @par(T) Type of values being compared; its `Format` gives the text of each value.
/// @arg(actual) Observed value.
/// @arg(expected) Expected value.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit Equal<T>(T actual, T expected, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) where T: Formatting {
    if actual == expected {
        return;
    }
    string expectedText = expected.Format();
    string actualText = actual.Format();
    FailWithValues("expected " + expectedText + ", found " + actualText, because, expectedText, actualText, file, line, column);
}

/// Fails when actual and expected values are equal. The failure shows the shared value as text.
/// @par(T) Type of values being compared; its `Format` gives the text of each value.
/// @arg(actual) Observed value.
/// @arg(expected) Value that must differ from `actual`.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit NotEqual<T>(T actual, T expected, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) where T: Formatting {
    if actual != expected {
        return;
    }
    string expectedText = expected.Format();
    string actualText = actual.Format();
    FailWithValues("expected a value other than " + expectedText + ", found " + actualText, because, expectedText, actualText, file, line, column);
}

/// Fails when condition is not true.
/// @arg(condition) Predicate that must hold.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit True(bool condition, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    if condition {
        return;
    }
    FailWithValues("expected true, found false", because, "true", "false", file, line, column);
}

/// Fails when condition is true.
/// @arg(condition) Predicate that must be false.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit False(bool condition, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    if !condition {
        return;
    }
    FailWithValues("expected false, found true", because, "false", "true", file, line, column);
}

/// Fails when needle is not found in text.
/// @arg(text) Haystack UTF-8 string.
/// @arg(needle) Needle UTF-8 string.
/// @arg(because) Optional diagnostic context; without it the failure shows no because line.
pub unit Contains(string text, string needle, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    if String.Contains(text, needle) {
        return;
    }
    FailWithValues("expected text containing " + Quoted(needle) + ", found " + Quoted(text), because, needle, text, file, line, column);
}
