pub Unsigned64<R> CreateUnsigned64<R>() { return Unsigned64<R> {}; }

pub type Float32<R> {}
impl<R> Float32<R> : FieldDecoder<f32, R> where R: Reader {
    pub Result<f32, SerializationError> Read(R reader, SerializationLimits limits) {
        u64 value = reader.ReadFloat(32_u8)?;
        if (value > 4294967295_u64) { return Result::Error(Errors.NumericError("FloatBitsOutOfRange")); }
        return Result::Ok(FloatBits.FromBits32(u32(value)));
    }
}
pub Float32<R> CreateFloat32<R>() { return Float32<R> {}; }

pub type Float64<R> {}
impl<R> Float64<R> : FieldDecoder<f64, R> where R: Reader {
    pub Result<f64, SerializationError> Read(R reader, SerializationLimits limits) {
        u64 value = reader.ReadFloat(64_u8)?;
        
        return Result::Ok(FloatBits.FromBits64(value));
    }
}
pub Float64<R> CreateFloat64<R>() { return Float64<R> {}; }

pub type Scalar<R> {}
impl<R> Scalar<R> : FieldDecoder<char, R> where R: Reader {
    pub Result<char, SerializationError> Read(R reader, SerializationLimits limits) {
        char value = reader.ReadScalar()?;
        
        return Result::Ok(value);
    }
}
pub Scalar<R> CreateScalar<R>() { return Scalar<R> {}; }

pub type String<R> {}
impl<R> String<R> : FieldDecoder<string, R> where R: Reader {
    pub Result<string, SerializationError> Read(R reader, SerializationLimits limits) {
        string value = reader.ReadString()?;
        
        return Result::Ok(value);
    }
}
pub String<R> CreateString<R>() { return String<R> {}; }

pub type Word<R> { u8 width, }
impl<R> Word<R> : FieldDecoder<word, R> where R: Reader {
    pub Result<word, SerializationError> Read(R reader, SerializationLimits limits) {
        if (this.width != 8_u8 && this.width != 16_u8 && this.width != 32_u8 && this.width != 64_u8) { return Result::Error(Errors.NumericError("UnsupportedWireWidth")); }
        u64 value = reader.ReadUnsigned(this.width)?;
        if ((this.width == 8_u8 && value > 255_u64) || (this.width == 16_u8 && value > 65535_u64) || (this.width == 32_u8 && value > 4294967295_u64)) { return Result::Error(Errors.NumericError("IntegerOutOfRange")); }
        return Result::Ok(word(value));
    }
}
pub Word<R> CreateWord<R>(u8 width) { return Word<R> { width: width }; }

pub type Bytes<R> {}
impl<R> Bytes<R> : FieldDecoder<u8[], R> where R: Reader {
    pub Result<u8[], SerializationError> Read(R reader, SerializationLimits limits) {
        return reader.ReadBytes();
    }
}
pub Bytes<R> CreateBytes<R>() { return Bytes<R> {}; }
