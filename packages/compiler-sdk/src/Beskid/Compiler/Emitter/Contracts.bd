// CHECKED IN: hand-maintained Mod SDK emit helpers (contract AST builders).
use Beskid.Compiler.Emitter.Nodes;
use Beskid.Syntax.Nodes.ContractDefinition;
use Beskid.Syntax.Nodes.ContractMethodSignature;
use Beskid.Syntax.Nodes.OptionalLeadingDocCommentList;
use Beskid.Syntax.Nodes.OptionalSpannedType;
use Beskid.Syntax.Nodes.SpannedContractNode;
use Beskid.Syntax.Nodes.SpannedContractNodeList;
use Beskid.Syntax.Nodes.SpannedIdentifier;
use Beskid.Syntax.Nodes.SpannedIdentifierList;
use Beskid.Syntax.Nodes.SpannedParameterList;
use Beskid.Syntax.Nodes.SpannedVisibility;

/// Build a contract preserving source wrappers, generic parameters and member documentation.
pub ContractDefinition PubContract(SpannedIdentifier name, SpannedVisibility visibility, SpannedIdentifierList generics, SpannedContractNodeList items, OptionalLeadingDocCommentList itemDocs) {
    return ContractDefinition {
        attributes: EmptyAttributes(),
        visibility: visibility,
        name: name,
        generics: generics,
        items: items,
        itemDocs: itemDocs,
    };
}

/// Preserve an ordered array of complete source-wrapped contract members.
pub SpannedContractNodeList ContractMethods(SpannedContractNode[] items) {
    return SpannedContractNodeList { items: items };
}

/// Build a signature preserving typed return absence and parameter documentation.
pub ContractMethodSignature ContractMethod(OptionalSpannedType returnType, SpannedIdentifier name, SpannedParameterList parameters, OptionalLeadingDocCommentList parameterDocs) {
    return ContractMethodSignature {
        attributes: EmptyAttributes(),
        name: name,
        parameters: parameters,
        parameterDocs: parameterDocs,
        returnType: returnType,
    };
}
