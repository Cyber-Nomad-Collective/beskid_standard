                %v92 = bxor %v88, %rk13
                %v93 = bxor %v89, %rk13
                %v94 = bxor %v90, %rk13
                %v95 = bxor %v91, %rk13
                %k96 = load.i8x16 %tp2+96
                %v97 = swizzle %k96, %v83
                %v98 = swizzle %k96, %v84
                %v99 = swizzle %k96, %v85
                %v100 = swizzle %k96, %v86
                %v101 = bxor %v92, %v97
                %v102 = bxor %v93, %v98
                %v103 = bxor %v94, %v99
                %v104 = bxor %v95, %v100
                %k105 = load.i8x16 %tp2+112
                %v106 = swizzle %k105, %v75
                %v107 = swizzle %k105, %v76
                %v108 = swizzle %k105, %v77
                %v109 = swizzle %k105, %v78
                %k110 = load.i8x16 %tp2+128
                %v111 = swizzle %k110, %v83
                %v112 = swizzle %k110, %v84
                %v113 = swizzle %k110, %v85
                %v114 = swizzle %k110, %v86
                %v115 = bxor %v106, %v111
                %v116 = bxor %v107, %v112
                %v117 = bxor %v108, %v113
                %v118 = bxor %v109, %v114
                %v119 = swizzle %v101, %k18
                %v120 = swizzle %v102, %k18
                %v121 = swizzle %v103, %k18
                %v122 = swizzle %v104, %k18
                %v123 = bxor %v115, %v119
                %v124 = bxor %v116, %v120
                %v125 = bxor %v117, %v121
                %v126 = bxor %v118, %v122
                %v127 = swizzle %v101, %k22
                %v128 = swizzle %v102, %k22
                %v129 = swizzle %v103, %k22
                %v130 = swizzle %v104, %k22
                %v131 = swizzle %v123, %k18
                %v132 = swizzle %v124, %k18
                %v133 = swizzle %v125, %k18
                %v134 = swizzle %v126, %k18
                %v135 = bxor %v123, %v127
                %v136 = bxor %v124, %v128
                %v137 = bxor %v125, %v129
                %v138 = bxor %v126, %v130
                %v139 = bxor %v131, %v135
                %v140 = bxor %v132, %v136
                %v141 = bxor %v133, %v137
                %v142 = bxor %v134, %v138
