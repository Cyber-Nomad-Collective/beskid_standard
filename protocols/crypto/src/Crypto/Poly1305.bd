use Core.Bytes.Slice;
use Core.Results;
use Crypto.Errors;
use Crypto.Scratch;

/// Poly1305 (RFC 8439 section 2.5) in radix 2^64 as in OpenSSL `poly1305.c`: the
/// accumulator is h0 + 2^64 h1 + 2^128 h2, products are 64x64->128 from `imul`/`umulhi`
/// inside a CLIF kernel (tools/clifgen.py). No data-dependent branches or lookups.
/// `r` holds r0, r1, r1 + (r1 >> 2); `h` the accumulator; `pad` the two s words;
/// `meta[0]` buffered bytes, `meta[1]` 1 after `Finish`, `meta[2..5)` the kernel cursor
/// (offset, end, pad bit).
pub type Poly1305State {
    i64[] r,
    i64[] h,
    i64[] pad,
    u8[] buffer,
    i64[] meta,
}

i64 Le64(u8[] data, i64 offset) {
    mut i64 v = 0_i64;
    mut i64 i = 7_i64;
    while i >= 0_i64 { v = (v << 8_i64) | i64(data[offset + i]); i = i - 1_i64; }
    return v;
}

/// Starts a one-time authenticator from a 32-byte key (r || s).
pub Result<Poly1305State, CryptoError> New(u8[] key) {
    if Slice.Len(key) != 32_i64 { return Result::Error(CryptoError::InvalidKeyLength()); }
    // Clamp r (RFC 8439 2.5.1).
    i64 r0 = Le64(key, 0_i64) & 0x0ffffffc0fffffff_i64;
    i64 r1 = Le64(key, 8_i64) & 0x0ffffffc0ffffffc_i64;
    return Result::Ok(Poly1305State {
        r: [r0, r1, r1 + (r1 >> 2_i64)],
        h: [0_i64, 0_i64, 0_i64],
        pad: [Le64(key, 16_i64), Le64(key, 24_i64)],
        buffer: Scratch.Bytes(16_i64),
        meta: [0_i64, 0_i64, 0_i64, 0_i64, 0_i64],
    });
}

/// Pad bit (2^128 at h2 scale) for a full 16-byte block.
i64 FullBlockBit() { return 1_i64; }

/// Absorbs the whole blocks of `m[offset, offset + length)`; `length` is a multiple of 16.
unit Absorb(Poly1305State state, u8[] m, i64 offset, i64 length, i64 hibit) {
    state.meta[2] = offset;
    state.meta[3] = offset + length;
    state.meta[4] = hibit;
    Blocks(state.r, state.h, m, state.meta);
    return;
}

// BEGIN GENERATED Poly1305Blocks (tools/clifgen.py)
/// Absorbs the 16-byte blocks of `data` from offset `meta[2]` up to `meta[3]` with pad
/// bit `meta[4]` (radix 2^64). Precondition: the range is in bounds.
i64 Blocks(i64[] r, i64[] h, u8[] data, i64[] meta) {
    mut i64 last = 0_i64;
    while meta[2] < meta[3] {
        last = clif {
            %rp1 = payload %0
            %hp2 = payload %1
            %dp3 = payload %2
            %mp4 = payload %3
            %pos5 = load.i64 %mp4+16
            %pad6 = load.i64 %mp4+32
            %src7 = iadd %dp3, %pos5
            %r8 = load.i64 %rp1+0
            %r9 = load.i64 %rp1+8
            %r10 = load.i64 %rp1+16
            %h11 = load.i64 %hp2+0
            %h12 = load.i64 %hp2+8
            %h13 = load.i64 %hp2+16
            %c14 = iconst.i64 0
            %m15 = load.i64 %src7
            %m16 = load.i64 %src7+8
            %s17, %c18 = uadd_overflow %h11, %m15
            %s19, %c20 = uadd_overflow %h12, %m16
            %v21 = uextend.i64 %c18
            %s22, %c23 = uadd_overflow %s19, %v21
            %v24 = bor %c20, %c23
            %v25 = uextend.i64 %v24
            %v26 = iadd %h13, %v25
            %v27 = iadd %v26, %pad6
            %v28 = imul %s17, %r8
            %v29 = umulhi %s17, %r8
            %v30 = imul %s22, %r10
            %v31 = umulhi %s22, %r10
            %s32, %c33 = uadd_overflow %v28, %v30
            %v34 = iadd %v29, %v31
            %v35 = uextend.i64 %c33
            %v36 = iadd %v34, %v35
            %v37 = imul %s17, %r9
            %v38 = umulhi %s17, %r9
            %v39 = imul %s22, %r8
            %v40 = umulhi %s22, %r8
            %s41, %c42 = uadd_overflow %v37, %v39
            %v43 = iadd %v38, %v40
            %v44 = uextend.i64 %c42
            %v45 = iadd %v43, %v44
            %v46 = imul %v27, %r10
            %s47, %c48 = uadd_overflow %s41, %v46
            %v49 = uextend.i64 %c48
            %v50 = iadd %v45, %v49
            %s51, %c52 = uadd_overflow %s47, %v36
            %v53 = uextend.i64 %c52
            %v54 = iadd %v50, %v53
            %v55 = imul %v27, %r8
            %v56 = iadd %v55, %v54
            %c57 = iconst.i64 -4
            %v58 = band %v56, %c57
            %c59 = iconst.i64 2
            %v60 = ushr %v56, %c59
            %v61 = iadd %v58, %v60
            %c62 = iconst.i64 3
            %v63 = band %v56, %c62
            %s64, %c65 = uadd_overflow %s32, %v61
            %s66, %c67 = uadd_overflow %s51, %c14
            %v68 = uextend.i64 %c65
            %s69, %c70 = uadd_overflow %s66, %v68
            %v71 = bor %c67, %c70
            %v72 = uextend.i64 %v71
            %v73 = iadd %v63, %v72
            store %s64, %hp2+0
            store %s69, %hp2+8
            store %v73, %hp2+16
            %c74 = iconst.i64 16
            %next75 = iadd %pos5, %c74
            store %next75, %mp4+16
            return %next75
        };
    }
    return last;
}
// END GENERATED Poly1305Blocks

/// Absorbs `count` bytes of `data` at `offset`. Returns false for an invalid range or a finished state.
pub bool UpdateRange(Poly1305State state, u8[] data, i64 offset, i64 count) {
    if state.meta[1] != 0_i64 { return false; }
    if !Slice.IsValidRange(Slice.Len(data), offset, count) { return false; }
    mut i64 pos = offset;
    i64 end = offset + count;
    mut i64 buffered = state.meta[0];
    if buffered > 0_i64 {
        while buffered < 16_i64 && pos < end { state.buffer[buffered] = data[pos]; buffered = buffered + 1_i64; pos = pos + 1_i64; }
        if buffered < 16_i64 { state.meta[0] = buffered; return true; }
        Absorb(state, state.buffer, 0_i64, 16_i64, FullBlockBit());
        buffered = 0_i64;
    }
    i64 whole = ((end - pos) / 16_i64) * 16_i64;
    if whole > 0_i64 {
        Absorb(state, data, pos, whole, FullBlockBit());
        pos = pos + whole;
    }
    while pos < end { state.buffer[buffered] = data[pos]; buffered = buffered + 1_i64; pos = pos + 1_i64; }
    state.meta[0] = buffered;
    return true;
}

pub bool Update(Poly1305State state, u8[] data) {
    return UpdateRange(state, data, 0_i64, Slice.Len(data));
}

/// Zero-pads the buffered input to a 16-byte boundary (the AEAD pad16 construction).
pub unit PadToBlock(Poly1305State state) {
    mut i64 buffered = state.meta[0];
    if buffered == 0_i64 || state.meta[1] != 0_i64 { return; }
    while buffered < 16_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
    Absorb(state, state.buffer, 0_i64, 16_i64, FullBlockBit());
    state.meta[0] = 0_i64;
    return;
}

/// Carry of the unsigned 64-bit sum `a + b = sum`, as 0 or 1.
i64 CarryOut(i64 a, i64 b, i64 sum) {
    return (((a & b) | ((a | b) & (-1_i64 - sum))) >> 63_i64) & 1_i64;
}

/// Returns the 16-byte tag.
pub u8[] Finish(Poly1305State state) {
    u8[] tag = Scratch.Bytes(16_i64);
    if state.meta[1] != 0_i64 { return tag; }
    mut i64 buffered = state.meta[0];
    if buffered > 0_i64 {
        state.buffer[buffered] = 1_u8;
        buffered = buffered + 1_i64;
        while buffered < 16_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
        Absorb(state, state.buffer, 0_i64, 16_i64, 0_i64);
    }
    state.meta[1] = 1_i64;
    i64[] h = state.h;
    mut i64 h0 = h[0]; mut i64 h1 = h[1]; i64 h2 = h[2];
    // g = h + 5; when g reaches 2^130 (bit 2 of g2), h >= p and g - 2^130 is h mod p.
    i64 g0 = h0 + 5_i64;
    i64 c0 = CarryOut(h0, 5_i64, g0);
    i64 g1 = h1 + c0;
    i64 c1 = CarryOut(h1, c0, g1);
    i64 g2 = h2 + c1;
    i64 select = 0_i64 - (g2 >> 2_i64);
    i64 keep = -1_i64 - select;
    h0 = (h0 & keep) | (g0 & select);
    h1 = (h1 & keep) | (g1 & select);
    // (h + s) mod 2^128.
    i64 sumLo = h0 + state.pad[0];
    i64 sumHi = h1 + state.pad[1] + CarryOut(h0, state.pad[0], sumLo);
    WriteLe64(tag, 0_i64, sumLo);
    WriteLe64(tag, 8_i64, sumHi);
    return tag;
}

unit WriteLe64(u8[] out, i64 offset, i64 value) {
    mut i64 i = 0_i64;
    while i < 8_i64 {
        out[offset + i] = u8((value >> (i * 8_i64)) & 0xFF_i64);
        i = i + 1_i64;
    }
    return;
}

/// One-shot Poly1305 tag of `message` under a 32-byte one-time key.
pub Result<u8[], CryptoError> Mac(u8[] key, u8[] message) {
    return match New(key) {
        Result::Error(error) => Result::Error(error),
        Result::Ok(state) => {
            Update(state, message);
            return Result::Ok(Finish(state));
        },
    };
}
