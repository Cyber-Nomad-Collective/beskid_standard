//! `CompilerSdkSuite`: the compiler-sdk tests of corelib_tests, merged into one target so the matrix lowers
//! the compiler-sdk closure once. Each section keeps the tests of one former target unchanged.

use Beskid.Compiler.ModCatalog;
use Beskid.Compiler.ModPackage;
use Beskid.Compiler.Workspace;
use Core.Collections.Array;
use Testing.Assert;
use Beskid.Compiler.Collect;
use Beskid.Compiler.Emitter;
use Beskid.Compiler.Emitter.Contribution;
use Beskid.Compiler.Emitter.Nodes;

// ---- CompilerSdkSurfaceTests.bd (formerly target `CompilerSdkSurfaceTests`) ----

// Parse/analyze smoke for Mod SDK workspace/catalog surfaces via aggregate corelib.

test WorkspaceFacadeVersionIsStable
{
    Assert.Equal(WorkspaceFacadeVersion(), "0.1.0", "Workspace SDK facade version");
}

test CatalogFacadeVersionIsStable
{
    Assert.Equal(ModCatalogFacadeVersion(), "0.1.0", "ModCatalog SDK facade version");
}

test PackageFacadeVersionIsStable
{
    Assert.Equal(ModPackageFacadeVersion(), "0.1.0", "ModPackage SDK facade version");
}

test WorkspaceMemberFieldsAreConstructible
{
    WorkspaceMember member = WorkspaceMember
    {
        memberId: "member-a",
        projectName: "demo",
        projectRoot: "/tmp/demo",
        sourceRoot: "/tmp/demo/src",
    };
    Assert.Equal(member.projectName, "demo", "WorkspaceMember project name");
}

test CatalogPackagesArrayIsConstructible
{
    ModPackage[] packages = Array.Empty<ModPackage>();
    ModCatalog catalog = ModCatalog
    {
        packages: packages,
    };
    Assert.Equal(Array.Len<ModPackage>(catalog.packages), 0, "empty ModCatalog packages");
}

test WorkspaceSummaryFieldsAreConstructible
{
    Workspace workspace = Workspace
    {
        rootPath: "/tmp/ws",
        members: Array.Empty<WorkspaceMember>(),
        lockHash: "lock-1",
    };
    Assert.Equal(workspace.lockHash, "lock-1", "Workspace lock hash");
}

// ---- CompilerSdkEmitterTests.bd (formerly target `CompilerSdkEmitterTests`) ----

// Parse/analyze smoke for `Beskid.Compiler.Emitter` contribution helpers.

test CollectFacadeVersionIsStable
{
    Assert.Equal(CollectFacadeVersion(), "0.6.0", "Collect SDK facade version");
}

test EmitterFacadeVersionIsStable
{
    Assert.Equal(EmitterFacadeVersion(), "0.6.0", "Emitter SDK facade version");
}

test EmitterNodesBuildIdentifier
{
    Beskid.Syntax.Nodes.NodeSpan span = Beskid.Syntax.Nodes.NodeSpan
    {
        start: 0_u64,
        end: 4_u64,
        lineStart: 1_u64,
        columnStart: 1_u64,
        lineEnd: 1_u64,
        columnEnd: 5_u64,
    };
    Assert.Equal<u32>(Nodes.PubIdentifier("name", span, 7_u32).id, 7_u32, "Emitter.Nodes builds an identifier with its id");
}

test EmitterContributionHelpersResolveInTestHarness
{
    Assert.Equal<i64>(Array.Len(Contribution.Empty().items), 0_i64, "Emitter.Contribution builds an empty contribution");
}

test CollectTargetSetFieldsAreConstructible
{
    bool constructible = true;
    Assert.True(constructible, "CollectTargetSet import smoke");
}
