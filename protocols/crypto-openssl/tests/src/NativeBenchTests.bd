/// Pure vs native (OpenSSL) throughput. Each test prints a "BENCH pure ..." and a
/// "BENCH native ..." line; see protocols/crypto/BENCHMARKS.md. One-shot APIs over 16 KiB
/// inputs (the runtime caps live arrays near 160 KiB, ruling R9).
use Testing.Assert;
use Core.Bytes.Slice;
use Core.Output;
use Core.Results;
use Core.String;
use Core.Time;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Hmac;
use Crypto.Sha256;
use Crypto.Sha512;
use CryptoOpenSsl.NativeAesGcm;
use CryptoOpenSsl.NativeChaCha20Poly1305;
use CryptoOpenSsl.NativeHmac;
use CryptoOpenSsl.NativeSha256;
use CryptoOpenSsl.NativeSha512;

i64 NowNanos() { Core.Time.Instant now = Time.MonotonicNow(); return now.nanos; }

string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

/// Prints MB/s (10^6 bytes per second) for `bytes` processed in `nanos`.
unit Throughput(string name, i64 bytes, i64 nanos) {
    i64 safe = nanos + 1_i64;
    Output.WriteLine("BENCH " + name + ": " + Dec(bytes * 1000_i64 / safe) + " MB/s (" + Dec(safe / 1000_i64) + " us total)");
    return;
}

/// Prints microseconds and operations per second for `ops` operations in `nanos`.
unit PerOp(string name, i64 ops, i64 nanos) {
    i64 safe = nanos + 1_i64;
    Output.WriteLine("BENCH " + name + ": " + Dec(safe / ops / 1000_i64) + " us/op (" + Dec(ops * 1000000000_i64 / safe) + " op/s)");
    return;
}

i64 Chunk() { return 16384_i64; }

u8[] Buffer() {
    u8[] d = Slice.New(Chunk() + 16_i64);
    mut i64 i = 0_i64;
    while i < Chunk() { d[i] = u8(i & 255_i64); i = i + 1_i64; }
    return d;
}

/// 16 KiB inputs per pure run (1 MiB) and per native run (8 MiB).
i64 PureRuns() { return 64_i64; }
i64 NativeRuns() { return 512_i64; }

test bench_sha256_16k_one_shot {
    u8[] data = Slice.SubSlice(Buffer(), 0_i64, Chunk());
    mut i64 start = NowNanos();
    mut i64 i = 0_i64;
    while i < PureRuns() { u8[] d = Sha256.Hash(data); data[0] = d[0]; i = i + 1_i64; }
    Throughput("pure sha256", PureRuns() * Chunk(), NowNanos() - start);
    start = NowNanos();
    i = 0_i64;
    while i < NativeRuns() { u8[] d = NativeSha256.Hash(data); data[0] = d[0]; i = i + 1_i64; }
    Throughput("native sha256", NativeRuns() * Chunk(), NowNanos() - start);
    Assert.True(true, "printed");
}

test bench_sha512_16k_one_shot {
    u8[] data = Slice.SubSlice(Buffer(), 0_i64, Chunk());
    mut i64 start = NowNanos();
    mut i64 i = 0_i64;
    while i < PureRuns() { u8[] d = Sha512.Hash512(data); data[0] = d[0]; i = i + 1_i64; }
    Throughput("pure sha512", PureRuns() * Chunk(), NowNanos() - start);
    start = NowNanos();
    i = 0_i64;
    while i < NativeRuns() { u8[] d = NativeSha512.Hash512(data); data[0] = d[0]; i = i + 1_i64; }
    Throughput("native sha512", NativeRuns() * Chunk(), NowNanos() - start);
    Assert.True(true, "printed");
}

test bench_hmac_sha256_64b {
    u8[] key = Slice.New(32_i64);
    u8[] message = Slice.New(64_i64);
    i64 ops = 2000_i64;
    mut i64 start = NowNanos();
    mut i64 i = 0_i64;
    while i < ops { u8[] tag = Hmac.Compute(HashAlgorithm::Sha256(), key, message); message[0] = tag[0]; i = i + 1_i64; }
    PerOp("pure hmac-sha256 64B", ops, NowNanos() - start);
    start = NowNanos();
    i = 0_i64;
    while i < ops { u8[] tag = NativeHmac.Compute(HashAlgorithm::Sha256(), key, message); message[0] = tag[0]; i = i + 1_i64; }
    PerOp("native hmac-sha256 64B", ops, NowNanos() - start);
    Assert.True(true, "printed");
}

test bench_hmac_sha256_16k {
    u8[] key = Slice.New(32_i64);
    u8[] data = Slice.SubSlice(Buffer(), 0_i64, Chunk());
    mut i64 start = NowNanos();
    mut i64 i = 0_i64;
    while i < PureRuns() / 2_i64 { u8[] tag = Hmac.Compute(HashAlgorithm::Sha256(), key, data); i = i + 1_i64; }
    Throughput("pure hmac-sha256 16KiB", PureRuns() / 2_i64 * Chunk(), NowNanos() - start);
    start = NowNanos();
    i = 0_i64;
    while i < NativeRuns() { u8[] tag = NativeHmac.Compute(HashAlgorithm::Sha256(), key, data); i = i + 1_i64; }
    Throughput("native hmac-sha256 16KiB", NativeRuns() * Chunk(), NowNanos() - start);
    Assert.True(true, "printed");
}

test bench_chacha20poly1305_seal_16k {
    u8[] key = Slice.New(32_i64);
    u8[] nonce = Slice.New(12_i64);
    u8[] aad = Slice.New(13_i64);
    u8[] record = Buffer();
    mut i64 start = NowNanos();
    mut i64 i = 0_i64;
    while i < PureRuns() / 2_i64 {
        nonce[11] = u8(i & 255_i64);
        ChaCha20Poly1305.SealInto(key, nonce, aad, record, 0_i64, Chunk(), record, 0_i64);
        i = i + 1_i64;
    }
    Throughput("pure chacha20-poly1305 seal 16KiB", PureRuns() / 2_i64 * Chunk(), NowNanos() - start);
    start = NowNanos();
    i = 0_i64;
    while i < NativeRuns() {
        nonce[11] = u8(i & 255_i64);
        NativeChaCha20Poly1305.SealInto(key, nonce, aad, record, 0_i64, Chunk(), record, 0_i64);
        i = i + 1_i64;
    }
    Throughput("native chacha20-poly1305 seal 16KiB", NativeRuns() * Chunk(), NowNanos() - start);
    Assert.True(true, "printed");
}

unit BenchAes(i64 keyLength) {
    match AesGcm.New(Slice.New(keyLength)) {
        Result::Error(_) => { Assert.Fail("pure key"); },
        Result::Ok(pure) => {
            match NativeAesGcm.New(Slice.New(keyLength)) {
                Result::Error(_) => { Assert.Fail("native key"); },
                Result::Ok(native) => {
                    u8[] nonce = Slice.New(12_i64);
                    u8[] aad = Slice.New(13_i64);
                    u8[] record = Buffer();
                    string name = "aes-" + Dec(keyLength * 8_i64) + "-gcm seal 16KiB";
                    mut i64 start = NowNanos();
                    mut i64 i = 0_i64;
                    while i < PureRuns() / 4_i64 {
                        nonce[11] = u8(i & 255_i64);
                        AesGcm.SealInto(pure, nonce, aad, record, 0_i64, Chunk(), record, 0_i64);
                        i = i + 1_i64;
                    }
                    Throughput("pure " + name, PureRuns() / 4_i64 * Chunk(), NowNanos() - start);
                    start = NowNanos();
                    i = 0_i64;
                    while i < NativeRuns() {
                        nonce[11] = u8(i & 255_i64);
                        NativeAesGcm.SealInto(native, nonce, aad, record, 0_i64, Chunk(), record, 0_i64);
                        i = i + 1_i64;
                    }
                    Throughput("native " + name, NativeRuns() * Chunk(), NowNanos() - start);
                    i = 0_i64;
                    start = NowNanos();
                    while i < NativeRuns() {
                        NativeAesGcm.SealInto(native, nonce, aad, record, 0_i64, Chunk(), record, 0_i64);
                        NativeAesGcm.OpenInto(native, nonce, aad, record, 0_i64, Chunk() + 16_i64, record, 0_i64);
                        i = i + 1_i64;
                    }
                    Throughput("native " + name + " + open", NativeRuns() * Chunk() * 2_i64, NowNanos() - start);
                },
            };
        },
    };
    return;
}

test bench_aes128gcm_seal_16k { BenchAes(16_i64); Assert.True(true, "printed"); }
test bench_aes256gcm_seal_16k { BenchAes(32_i64); Assert.True(true, "printed"); }
