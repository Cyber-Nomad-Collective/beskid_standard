//! `CollectionsSuite`: the collections tests of corelib_tests, merged into one target so the matrix lowers
//! the collections closure once. Each section keeps the tests of one former target unchanged.

use Core.Collections.Array;
use Core.Collections.Array.ArrayIter;
use Core.Time;
use Core.Time.Instant;
use Testing.Assert;
use Core.Collections.List;
use Core.Collections.Stack;
use Core.Collections.Queue;
use Core.Collections.Set;
use Core.Collections.Map;
use Core.String;

// ---- ArrayTests.bd (formerly target `CollectionsArrayTests`) ----

// Public API coverage for typed `Core.Collections.Array` operations.

test array_append_preserves_typed_values {
    mut i64[] values = Array.Empty<i64>();
    Array.Append<i64>(values, 10);
    Array.Append<i64>(values, 20);
    Array.Append<i64>(values, 30);
    Assert.Equal(Array.Len<i64>(values), 3, "append grows logical length");
    Assert.Equal(Array.Get<i64>(values, 0), 10, "growth preserves first value");
    Assert.Equal(Array.Get<i64>(values, 2), 30, "append stores tail value");
}

test array_set_uses_direct_index_semantics {
    mut i64[] values = Array.Empty<i64>();
    Array.Append<i64>(values, 1);
    values = Array.Set<i64>(values, 0, 9);
    Assert.Equal(Array.Get<i64>(values, 0), 9, "set replaces indexed value");
}

test array_pointer_values_survive_forced_gc_during_growth {
    mut string[] values = Array.Empty<string>();
    Array.Append<string>(values, "first");
    Assert.CollectGarbage();
    Array.Append<string>(values, "second");
    Assert.CollectGarbage();
    Assert.Equal(Array.Get<string>(values, 0), "first", "rooted growth retains the first pointer value");
    Assert.Equal(Array.Get<string>(values, 1), "second", "publication retains the appended pointer value");
}

test array_capacity_is_not_logical_length {
    mut i64[] values = Array.Empty<i64>();
    Array.Append<i64>(values, 1);
    Assert.Equal(Array.Len<i64>(values), 1, "append exposes exactly one initialized value");
    Assert.True(Array.Capacity<i64>(values) >= Array.Len<i64>(values), "capacity may exceed logical length");
}

test array_iterator_stops_at_logical_length {
    mut i64[] values = Array.Empty<i64>();
    Array.Append<i64>(values, 4);
    Array.Append<i64>(values, 5);
    mut ArrayIter<i64> iterator = Array.Iterate<i64>(values);
    Assert.True(Array.HasNext<i64>(iterator), "iterator starts in bounds");
    Assert.Equal(Array.Current<i64>(values, iterator), 4, "iterator reads first value");
    iterator = Array.Advance<i64>(iterator);
    Assert.Equal(Array.Current<i64>(values, iterator), 5, "iterator reads second value");
    iterator = Array.Advance<i64>(iterator);
    Assert.False(Array.HasNext<i64>(iterator), "iterator stops at logical length");
}

// PERF1: Append grows geometrically, so n appends cost O(n) copies in total.
test array_append_growth_is_geometric {
    mut u8[] values = Array.Empty<u8>();
    Instant start = Time.MonotonicNow();
    mut i64 i = 0;
    while i < 262144 {
        i64 value = i % 256;
        Array.Append<u8>(values, u8(value));
        i = i + 1;
    }
    Instant finish = Time.MonotonicNow();
    i64 elapsed = finish.nanos - start.nanos;
    Assert.Equal(Array.Len<u8>(values), 262144, "every append is visible");
    Assert.True(Array.Capacity<u8>(values) >= 262144, "capacity covers the length");
    Assert.True(Array.Capacity<u8>(values) <= 524288, "capacity at most doubles past the length");
    u8 first = values[0];
    u8 middle = values[255];
    u8 last = values[262143];
    i64 sum = i64(first) + i64(middle) + i64(last);
    Assert.Equal(sum, 510, "appended values are stored in order");
    Assert.True(elapsed < 500000000, "256 Ki appends take less than 500 ms");
}

test array_zeroed_allocates_exact_zero_filled_length {
    i64[] values = Array.Zeroed<i64>(1000);
    Assert.Equal(Array.Len<i64>(values), 1000, "zeroed length");
    Assert.Equal(Array.Capacity<i64>(values), 1000, "zeroed capacity");
    i64 sum = values[0] + values[999];
    Assert.Equal(sum, 0, "zeroed elements");
}

// Reference elements survive geometric growth and forced collections (pointer map, barriers).
test array_append_of_managed_references_survives_collection {
    mut string[] values = Array.Empty<string>();
    mut i64 i = 0;
    while i < 3000 {
        Array.Append<string>(values, "item");
        if i % 500 == 0 { Assert.CollectGarbage(); }
        i = i + 1;
    }
    Assert.CollectGarbage();
    Assert.Equal(Array.Len<string>(values), 3000, "every reference element is present");
    Assert.Equal(values[0], "item", "first reference survives growth");
    Assert.Equal(values[2999], "item", "last reference survives growth");
    mut i64[] nested = Array.Zeroed<i64>(16);
    mut i64 round = 0;
    while round < 200 {
        i64[] inner = Array.Zeroed<i64>(4096);
        nested[round % 16] = Array.Len<i64>(inner);
        round = round + 1;
    }
    Assert.Equal(nested[15], 4096, "zeroed arrays allocated in a loop have their length");
}

// ---- CollectionsTier1Tests.bd (formerly target `CollectionsTier1Tests`) ----

// Tier 1 public `Core.Collections.Array` API regression.

test typed_array_length_and_empty_semantics {
    mut i64[] populated = Array.Empty<i64>();
    Assert.True(Array.IsEmpty<i64>(populated), "new typed array is empty");
    Array.Append<i64>(populated, 5);
    Assert.Equal(Array.Len<i64>(populated), 1, "append advances logical length");
    Assert.False(Array.IsEmpty<i64>(populated), "populated typed array is not empty");
}

// ---- CollectionsTests.bd (formerly target `CollectionsTests`) ----

// Cross-collection public API integration coverage.

test collection_receiver_methods_are_the_public_surface {
    mut List<i64> list = List.New<i64>();
    list = list.Push(42);
    mut Stack<i64> stack = Stack.New<i64>();
    stack = stack.Push(42);
    Assert.Equal(list.Count(), 1, "list receiver method updates count");
    Assert.Equal(stack.Count(), 1, "stack receiver method updates count");
}

// ---- ListTests.bd (formerly target `CollectionsListTests`) ----

// Public API coverage for `Core.Collections.List`.

test list_retains_values_across_growth {
    mut List<i64> values = List.New<i64>();
    values = values.Push(10);
    values = values.Push(20);
    values = values.Push(30);
    Assert.Equal(values.Count(), 3, "list count after growth");
    i64 first = match values.Get(0) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    i64 last = match values.Get(2) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(first, 10, "list preserves first value");
    Assert.Equal(last, 30, "list appends at tail");
}

test list_pop_removes_only_the_tail {
    mut List<i64> values = List.New<i64>();
    values = values.Push(7);
    values = values.Push(8);
    values = values.Pop();
    Assert.Equal(values.Count(), 1, "pop decrements count");
    i64 retained = match values.Get(0) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(retained, 7, "pop retains preceding values");
}

test list_pop_clears_pointer_tail_before_collection {
    mut List<string> values = List.New<string>();
    values = values.Push("retained");
    values = values.Push("removed");
    values = values.Pop();
    Assert.CollectGarbage();
    string retained = match values.Get(0) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => "error" };
    Assert.Equal(retained, "retained", "pop clears the removed tail without losing retained pointers");
}

test list_get_rejects_direct_bounds {
    List<i64> values = List.New<i64>();
    bool negative = match values.Get(-1) { Core.Results.Result::Ok(_) => false, Core.Results.Result::Error(_) => true };
    bool atEnd = match values.Get(0) { Core.Results.Result::Ok(_) => false, Core.Results.Result::Error(_) => true };
    Assert.True(negative, "negative index is out of bounds");
    Assert.True(atEnd, "index at count is out of bounds");
}

// ---- PersistenceTests.bd (formerly target `CollectionsPersistenceTests`) ----

// Persistent collections keep every version intact when two versions grow from one base.
// `Array.Append` grows storage in place when capacity allows, so branching must copy.

test list_branches_keep_their_own_tail {
    mut List<i64> base = List.New<i64>();
    base = base.Push(1);
    List<i64> left = base.Push(2);
    List<i64> right = base.Push(3);
    i64 leftTail = match left.Get(1) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    i64 rightTail = match right.Get(1) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(leftTail, 2, "left branch keeps its element");
    Assert.Equal(rightTail, 3, "right branch keeps its element");
    Assert.Equal(base.Count(), 1, "base version is unchanged");
}

test list_linear_growth_stays_correct {
    mut List<i64> values = List.New<i64>();
    mut i64 index = 0;
    while index < 100 {
        values = values.Push(index);
        index = index + 1;
    }
    i64 last = match values.Get(99) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(values.Count(), 100, "linear pushes count");
    Assert.Equal(last, 99, "linear pushes keep order");
}

test stack_branches_keep_their_own_top {
    mut Stack<i64> base = Stack.New<i64>();
    base = base.Push(1);
    Stack<i64> left = base.Push(2);
    Stack<i64> right = base.Push(3);
    i64 leftTop = match left.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    i64 rightTop = match right.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(leftTop, 2, "left stack top");
    Assert.Equal(rightTop, 3, "right stack top");
}

test queue_branches_keep_their_own_back {
    mut Queue<i64> base = Queue.New<i64>();
    base = base.Enqueue(1);
    Queue<i64> left = base.Enqueue(2).Dequeue();
    Queue<i64> right = base.Enqueue(3).Dequeue();
    i64 leftFront = match left.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    i64 rightFront = match right.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(leftFront, 2, "left queue element");
    Assert.Equal(rightFront, 3, "right queue element");
}

test set_and_map_branches_do_not_share_members {
    mut Set<i64> setBase = Set.New<i64>();
    setBase = setBase.Add(1);
    Set<i64> setLeft = setBase.Add(2);
    Set<i64> setRight = setBase.Add(3);
    Assert.False(setLeft.Contains(3), "left set has no right member");
    Assert.False(setRight.Contains(2), "right set has no left member");
    mut Map<i64, i64> mapBase = Map.New<i64, i64>();
    mapBase = mapBase.Insert(1, 10);
    Map<i64, i64> mapLeft = mapBase.Insert(2, 20);
    Map<i64, i64> mapRight = mapBase.Insert(3, 30);
    Assert.False(mapLeft.ContainsKey(3), "left map has no right key");
    Assert.False(mapRight.ContainsKey(2), "right map has no left key");
}

// ---- MapTests.bd (formerly target `CollectionsMapTests`) ----

// Public API coverage for `Core.Collections.Map`.

test map_insert_get_and_update_own_real_entries {
    mut Map<i64, i64> values = Map.New<i64, i64>();
    values = values.Insert(1, 10);
    values = values.Insert(2, 20);
    values = values.Insert(1, 11);
    Assert.Equal(values.Count(), 2, "updating a key preserves count");
    i64 updated = match values.Get(1) { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(updated, 11, "updated value replaces prior value");
    Assert.True(values.ContainsKey(2), "second key is retained");
}

test map_pointer_aggregate_survives_forced_gc_growth {
    mut Map<string, string> values = Map.New<string, string>();
    values = values.Insert("first", "one");
    Assert.CollectGarbage();
    values = values.Insert("second", "two");
    Assert.CollectGarbage();
    string first = match values.Get("first") { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => "error" };
    Assert.Equal(first, "one", "MapEntry pointer fields survive rooted growth and publication");
}

test map_remove_preserves_remaining_entries {
    mut Map<i64, i64> values = Map.New<i64, i64>();
    values = values.Insert(1, 10);
    values = values.Insert(2, 20);
    values = values.Insert(3, 30);
    values = values.Remove(2);
    Assert.Equal(values.Count(), 2, "remove decrements count");
    Assert.True(values.ContainsKey(1), "remove preserves earlier entry");
    Assert.True(values.ContainsKey(3), "remove preserves later entry");
    Assert.False(values.ContainsKey(2), "removed key is absent");
}

test map_keys_of_empty_map_is_empty {
    Map<string, i64> values = Map.New<string, i64>();
    string[] keys = values.Keys();
    Assert.Equal(Array.Len<string>(keys), 0, "empty map has no keys");
    Assert.Equal(Array.Len<string>(String.SortOrdinal(keys)), 0, "sorting no keys yields no keys");
}

test map_keys_follow_entry_order_after_update_and_remove {
    mut Map<string, i64> values = Map.New<string, i64>();
    values = values.Insert("b", 1);
    values = values.Insert("a", 2);
    values = values.Insert("c", 3);
    values = values.Insert("b", 4);
    values = values.Remove("a");
    string[] keys = values.Keys();
    Assert.Equal(Array.Len<string>(keys), 2, "keys match count after update and remove");
    Assert.Equal(Array.Get<string>(keys, 0), "b", "update keeps the entry position");
    Assert.Equal(Array.Get<string>(keys, 1), "c", "remove shifts later entries");
}

test map_keys_sort_in_ordinal_utf8_order {
    mut Map<string, i64> values = Map.New<string, i64>();
    values = values.Insert("é", 1);
    values = values.Insert("abc", 2);
    values = values.Insert("Z", 3);
    values = values.Insert("ab", 4);
    values = values.Insert("z", 5);
    values = values.Insert("", 6);
    string[] keys = values.Keys();
    string[] sorted = String.SortOrdinal(keys);
    Assert.Equal(Array.Len<string>(sorted), 6, "sorting keeps every key");
    Assert.Equal(Array.Get<string>(sorted, 0), "", "empty string orders first");
    Assert.Equal(Array.Get<string>(sorted, 1), "Z", "uppercase ASCII orders before lowercase");
    Assert.Equal(Array.Get<string>(sorted, 2), "ab", "a proper prefix orders first");
    Assert.Equal(Array.Get<string>(sorted, 3), "abc", "the longer string follows its prefix");
    Assert.Equal(Array.Get<string>(sorted, 4), "z", "ASCII orders before multi-byte UTF-8");
    Assert.Equal(Array.Get<string>(sorted, 5), "é", "U+00E9 (C3 A9) orders after z (7A)");
    Assert.Equal(Array.Get<string>(keys, 0), "é", "sorting does not modify the input array");
    Assert.Equal(String.CompareOrdinal("ab", "ab"), 0, "equal strings compare equal");
    Assert.Equal(String.CompareOrdinal("ab", "abc"), -1, "prefix compares lower");
    Assert.Equal(String.CompareOrdinal("b", "abc"), 1, "first differing byte decides");
}

test map_keys_snapshot_is_independent_of_later_mutation {
    mut Map<string, i64> values = Map.New<string, i64>();
    values = values.Insert("first", 1);
    values = values.Insert("second", 2);
    string[] keys = values.Keys();
    values = values.Remove("first");
    values = values.Insert("third", 3);
    values = values.Insert("second", 20);
    Assert.CollectGarbage();
    Assert.Equal(Array.Len<string>(keys), 2, "later insert and remove do not resize the snapshot");
    Assert.Equal(Array.Get<string>(keys, 0), "first", "removed key stays in the snapshot");
    Assert.Equal(Array.Get<string>(keys, 1), "second", "snapshot keeps its order");
    Assert.Equal(Array.Len<string>(values.Keys()), 2, "a new snapshot reflects the mutation");
}

// ---- SetTests.bd (formerly target `CollectionsSetTests`) ----

// Public API coverage for `Core.Collections.Set`.

test set_add_is_unique_and_searchable {
    mut Set<i64> values = Set.New<i64>();
    values = values.Add(42);
    values = values.Add(42);
    Assert.Equal(values.Count(), 1, "duplicate add does not change count");
    Assert.True(values.Contains(42), "added value is retained");
    Assert.False(values.Contains(9), "missing value is absent");
}

test set_remove_preserves_other_values {
    mut Set<i64> values = Set.New<i64>();
    values = values.Add(1);
    values = values.Add(2);
    values = values.Add(3);
    values = values.Remove(2);
    Assert.Equal(values.Count(), 2, "remove decrements count");
    Assert.True(values.Contains(1), "remove preserves earlier value");
    Assert.True(values.Contains(3), "remove preserves later value");
    Assert.False(values.Contains(2), "removed value is absent");
}

// ---- QueueTests.bd (formerly target `CollectionsQueueTests`) ----

// Public API coverage for `Core.Collections.Queue`.

test queue_is_fifo_and_retains_values {
    mut Queue<i64> queue = Queue.New<i64>();
    queue = queue.Enqueue(10);
    queue = queue.Enqueue(20);
    queue = queue.Enqueue(30);
    i64 first = match queue.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(first, 10, "peek returns oldest value");
    queue = queue.Dequeue();
    i64 second = match queue.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(second, 20, "dequeue advances in FIFO order");
    Assert.Equal(queue.Count(), 2, "dequeue decrements count");
}

test queue_head_advances_and_cleared_pointer_slots_survive_gc {
    mut Queue<string> queue = Queue.New<string>();
    queue = queue.Enqueue("first");
    queue = queue.Enqueue("second");
    queue = queue.Dequeue();
    Assert.CollectGarbage();
    string head = match queue.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => "error" };
    Assert.Equal(head, "second", "dequeue advances head without shifting retained pointer values");
    queue = queue.Enqueue("third");
    Assert.CollectGarbage();
    Assert.Equal(queue.Count(), 2, "enqueue appends after an advanced head");
}

test queue_empty_peek_is_error {
    Queue<i64> queue = Queue.New<i64>();
    bool isError = match queue.Peek() { Core.Results.Result::Ok(_) => false, Core.Results.Result::Error(_) => true };
    Assert.True(isError, "empty queue has no head value");
}

// ---- StackTests.bd (formerly target `CollectionsStackTests`) ----

// Public API coverage for `Core.Collections.Stack`.

test stack_is_lifo_and_retains_values {
    mut Stack<i64> stack = Stack.New<i64>();
    stack = stack.Push(10);
    stack = stack.Push(20);
    i64 top = match stack.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(top, 20, "peek returns latest value");
    stack = stack.Pop();
    i64 next = match stack.Peek() { Core.Results.Result::Ok(value) => value, Core.Results.Result::Error(_) => -1 };
    Assert.Equal(next, 10, "pop reveals preceding value");
    Assert.Equal(stack.Count(), 1, "pop decrements count");
}

test stack_empty_peek_is_error {
    Stack<i64> stack = Stack.New<i64>();
    bool isError = match stack.Peek() { Core.Results.Result::Ok(_) => false, Core.Results.Result::Error(_) => true };
    Assert.True(isError, "empty stack has no top value");
}
