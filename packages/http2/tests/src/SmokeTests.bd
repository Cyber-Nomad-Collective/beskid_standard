use Testing.Assert;
use Http2;
use Http2.Connection;

test Http2PackageLinks
{
    Assert.Equal<i64>(Http2.PackageVersion(), 1_i64, "package links");
}

test Http2ConfigDefaults
{
    Config config = Connection.DefaultConfig();
    Assert.Equal<i64>(config.initialWindowSize, 65535_i64, "window");
}
