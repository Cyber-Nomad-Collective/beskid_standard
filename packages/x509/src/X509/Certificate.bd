/// RFC 5280 certificate parsing.
///
/// `Parse` checks the complete DER tree first (bounded size and depth), then decodes the
/// TBSCertificate. Recognized extensions are decoded; an unrecognized extension marked
/// critical, or any extension that appears twice, fails the parse.
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Core.String;
use X509.Der;
use X509.Names;
use X509.Pem;
use X509.X509Errors;

/// Public key algorithms recognized in SubjectPublicKeyInfo.
pub enum KeyAlgorithm {
    Rsa,
    EcP256,
    /// An EC key on a curve other than P-256 (for example P-384); not verifiable here.
    EcOther,
    Ed25519,
    Unknown,
}

/// Signature schemes recognized in AlgorithmIdentifier.
pub enum SignatureScheme {
    RsaPkcs1Sha256,
    RsaPkcs1Sha384,
    RsaPkcs1Sha512,
    /// RSASSA-PSS; hash and salt length are in `SignatureAlgorithm`.
    RsaPss,
    EcdsaSha256,
    EcdsaSha384,
    EcdsaSha512,
    Ed25519,
    /// Recognized syntax, unsupported scheme (for example sha1WithRSAEncryption).
    Unknown,
}

pub type SignatureAlgorithm {
    pub SignatureScheme scheme,
    /// Dotted OID of the algorithm.
    pub string oid,
    /// For PSS: digest size in bits (256, 384, 512); 0 otherwise.
    pub i64 pssHashBits,
    /// For PSS: salt length in bytes; 0 otherwise.
    pub i64 pssSaltLength,
    /// The complete AlgorithmIdentifier encoding.
    pub u8[] der,
}

pub type PublicKeyInfo {
    pub KeyAlgorithm algorithm,
    /// The complete SubjectPublicKeyInfo encoding.
    pub u8[] der,
    /// RSA modulus and exponent, big-endian without sign octet; empty for other keys.
    pub u8[] rsaModulus,
    pub u8[] rsaExponent,
    /// The subjectPublicKey octets: SEC1 point for EC, 32 bytes for Ed25519.
    pub u8[] keyBytes,
    /// For EC keys, the named curve OID.
    pub string curveOid,
}

/// An IP address (4 or 16 bytes) or, in name constraints, address followed by mask.
pub type IpBytes { pub u8[] bytes, }

pub type NameConstraints {
    pub bool present,
    /// dNSName subtrees as lower-case text.
    pub string[] permittedDns,
    pub string[] excludedDns,
    /// iPAddress subtrees: address followed by mask (8 or 32 bytes).
    pub IpBytes[] permittedIp,
    pub IpBytes[] excludedIp,
    /// A subtree uses a name form other than dNSName and iPAddress.
    pub bool hasUnsupportedForm,
}

/// keyUsage bits (RFC 5280 section 4.2.1.3).
pub i64 KeyUsageDigitalSignature() { return 1_i64; }
pub i64 KeyUsageKeyEncipherment() { return 4_i64; }
pub i64 KeyUsageKeyAgreement() { return 16_i64; }
pub i64 KeyUsageKeyCertSign() { return 32_i64; }
pub i64 KeyUsageCrlSign() { return 64_i64; }

pub type Extensions {
    pub bool hasBasicConstraints,
    pub bool isCa,
    /// pathLenConstraint, or -1 when absent.
    pub i64 pathLen,
    pub bool hasKeyUsage,
    pub i64 keyUsage,
    pub bool hasExtKeyUsage,
    pub bool ekuServerAuth,
    pub bool ekuClientAuth,
    pub bool ekuAny,
    pub bool hasSubjectAltName,
    /// dNSName entries as they appear in the certificate.
    pub string[] dnsNames,
    pub IpBytes[] ipAddresses,
    pub u8[] subjectKeyId,
    pub u8[] authorityKeyId,
    pub NameConstraints nameConstraints,
}

pub type Certificate {
    /// The complete certificate encoding.
    pub u8[] der,
    /// TBSCertificate range in `der` (tag included); this is what the signature covers.
    pub i64 tbsStart,
    pub i64 tbsLength,
    /// 1, 2 or 3.
    pub i64 version,
    pub u8[] serial,
    pub SignatureAlgorithm signatureAlgorithm,
    pub DistinguishedName issuer,
    pub DistinguishedName subject,
    /// Validity bounds in seconds since the Unix epoch, both inclusive.
    pub i64 notBefore,
    pub i64 notAfter,
    pub PublicKeyInfo publicKey,
    pub Extensions extensions,
    /// The signature value octets.
    pub u8[] signature,
}

pub bool IsKeyAlgorithm(KeyAlgorithm a, KeyAlgorithm b) {
    return KeyIndexOf(a) == KeyIndexOf(b);
}

pub i64 KeyIndexOf(KeyAlgorithm a) {
    return match a { KeyAlgorithm::Rsa => 0_i64, KeyAlgorithm::EcP256 => 1_i64, KeyAlgorithm::EcOther => 2_i64, KeyAlgorithm::Ed25519 => 3_i64, KeyAlgorithm::Unknown => 4_i64, };
}

pub string SchemeName(SignatureScheme s) {
    return match s {
        SignatureScheme::RsaPkcs1Sha256 => "sha256WithRSAEncryption",
        SignatureScheme::RsaPkcs1Sha384 => "sha384WithRSAEncryption",
        SignatureScheme::RsaPkcs1Sha512 => "sha512WithRSAEncryption",
        SignatureScheme::RsaPss => "RSASSA-PSS",
        SignatureScheme::EcdsaSha256 => "ecdsa-with-SHA256",
        SignatureScheme::EcdsaSha384 => "ecdsa-with-SHA384",
        SignatureScheme::EcdsaSha512 => "ecdsa-with-SHA512",
        SignatureScheme::Ed25519 => "Ed25519",
        SignatureScheme::Unknown => "unknown",
    };
}

SignatureAlgorithm UnknownAlgorithm() {
    return SignatureAlgorithm { scheme: SignatureScheme::Unknown, oid: "", pssHashBits: 0_i64, pssSaltLength: 0_i64, der: Slice.New(0_i64) };
}

/// Optional NULL or absent parameters; anything else fails.
unit NullOrAbsent(DerParser p, i64 at, i64 end) {
    if at == end { return; }
    DerElement n = Der.Read(p, at, end);
    Der.CheckNull(p, n);
    Der.ExpectEnd(p, n.end, end);
    return;
}

unit Absent(DerParser p, i64 at, i64 end) {
    if Der.Ok(p) && at != end { Der.Fail(p, 19_i64); }
    return;
}

/// Hash AlgorithmIdentifier used in PSS parameters: returns 256, 384, 512, or 0.
i64 HashBits(DerParser p, i64 at, i64 end) {
    DerElement seq = Der.ExpectSequence(p, at, end);
    string oid = Der.ReadOid(p, seq.content, seq.end);
    DerElement oidEl = Der.Read(p, seq.content, seq.end);
    NullOrAbsent(p, oidEl.end, seq.end);
    Der.ExpectEnd(p, seq.end, end);
    if !Der.Ok(p) { return 0_i64; }
    if oid == "2.16.840.1.101.3.4.2.1" { return 256_i64; }
    if oid == "2.16.840.1.101.3.4.2.2" { return 384_i64; }
    if oid == "2.16.840.1.101.3.4.2.3" { return 512_i64; }
    return 0_i64;
}

/// PSS parameters: digest bits and salt length.
type PssParams { i64 hashBits, i64 saltLength, }

/// The [1] maskGenAlgorithm: must be MGF1; returns its hash bits.
i64 MgfHashBits(DerParser p, DerElement m) {
    DerElement mseq = Der.ExpectSequence(p, m.content, m.end);
    Der.ExpectEnd(p, mseq.end, m.end);
    DerElement mgfOidEl = Der.Read(p, mseq.content, mseq.end);
    string mgfOid = Der.OidString(p, mgfOidEl);
    if Der.Ok(p) && mgfOid != "1.2.840.113549.1.1.8" { Der.Fail(p, 20_i64); }
    return HashBits(p, mgfOidEl.end, mseq.end);
}

/// An explicitly tagged small INTEGER ([2] saltLength, [3] trailerField).
i64 TaggedInteger(DerParser p, DerElement t) {
    DerElement inner = Der.Read(p, t.content, t.end);
    Der.ExpectEnd(p, inner.end, t.end);
    return Der.ReadSmallInteger(p, t.content, t.end);
}

/// RSASSA-PSS-params (RFC 4055 section 3.1). The SHA-1 defaults are not supported, so
/// hashAlgorithm and maskGenAlgorithm are required and must name the same hash.
PssParams ParsePssParams(DerParser p, i64 at, i64 end) {
    DerElement params = Der.ExpectSequence(p, at, end);
    Der.ExpectEnd(p, params.end, end);
    mut i64 q = params.content;
    mut i64 hashBits = 0_i64;
    mut i64 mgfBits = 0_i64;
    mut i64 salt = 20_i64;
    if Der.PeekIs(p, q, params.end, 2_i64, 0_i64) {
        DerElement h = Der.Expect(p, q, params.end, 2_i64, true, 0_i64);
        hashBits = HashBits(p, h.content, h.end);
        q = h.end;
    }
    if Der.PeekIs(p, q, params.end, 2_i64, 1_i64) {
        DerElement m = Der.Expect(p, q, params.end, 2_i64, true, 1_i64);
        mgfBits = MgfHashBits(p, m);
        q = m.end;
    }
    if Der.PeekIs(p, q, params.end, 2_i64, 2_i64) {
        DerElement s = Der.Expect(p, q, params.end, 2_i64, true, 2_i64);
        salt = TaggedInteger(p, s);
        q = s.end;
    }
    if Der.PeekIs(p, q, params.end, 2_i64, 3_i64) {
        DerElement t = Der.Expect(p, q, params.end, 2_i64, true, 3_i64);
        if TaggedInteger(p, t) != 1_i64 { Der.Fail(p, 19_i64); }
        q = t.end;
    }
    Der.ExpectEnd(p, q, params.end);
    if hashBits == 0_i64 || mgfBits != hashBits { Der.Fail(p, 20_i64); }
    if salt > 512_i64 { Der.Fail(p, 19_i64); }
    return PssParams { hashBits: hashBits, saltLength: salt };
}

/// Maps a signature OID to its scheme; parameters are checked by the caller.
/// Returns 0 for PKCS#1 (NULL or absent parameters), 1 for absent parameters, 2 for PSS.
i64 ParamKind(string oid) {
    if oid == "1.2.840.113549.1.1.11" || oid == "1.2.840.113549.1.1.12" || oid == "1.2.840.113549.1.1.13" || oid == "1.2.840.113549.1.1.5" { return 0_i64; }
    if oid == "1.2.840.113549.1.1.10" { return 2_i64; }
    return 1_i64;
}

SignatureScheme SchemeOf(string oid) {
    if oid == "1.2.840.113549.1.1.11" { return SignatureScheme::RsaPkcs1Sha256; }
    if oid == "1.2.840.113549.1.1.12" { return SignatureScheme::RsaPkcs1Sha384; }
    if oid == "1.2.840.113549.1.1.13" { return SignatureScheme::RsaPkcs1Sha512; }
    if oid == "1.2.840.113549.1.1.10" { return SignatureScheme::RsaPss; }
    if oid == "1.2.840.10045.4.3.2" { return SignatureScheme::EcdsaSha256; }
    if oid == "1.2.840.10045.4.3.3" { return SignatureScheme::EcdsaSha384; }
    if oid == "1.2.840.10045.4.3.4" { return SignatureScheme::EcdsaSha512; }
    if oid == "1.3.101.112" { return SignatureScheme::Ed25519; }
    return SignatureScheme::Unknown;
}

/// Parses an AlgorithmIdentifier for a signature (RFC 4055, RFC 5758, RFC 8410).
/// Unrecognized algorithms parse as `Unknown` with their parameters unchecked.
pub SignatureAlgorithm ParseSignatureAlgorithm(DerParser p, DerElement e) {
    if !Der.Ok(p) { return UnknownAlgorithm(); }
    if !Der.Is(e, 0_i64, true, 16_i64) { Der.Fail(p, 4_i64); return UnknownAlgorithm(); }
    DerElement oidEl = Der.Read(p, e.content, e.end);
    string oid = Der.OidString(p, oidEl);
    SignatureScheme scheme = SchemeOf(oid);
    i64 kind = ParamKind(oid);
    mut PssParams pss = PssParams { hashBits: 0_i64, saltLength: 0_i64 };
    if kind == 0_i64 { NullOrAbsent(p, oidEl.end, e.end); }
    else if kind == 2_i64 { pss = ParsePssParams(p, oidEl.end, e.end); }
    else if SchemeIndex(scheme) != 8_i64 { Absent(p, oidEl.end, e.end); }
    if !Der.Ok(p) { return UnknownAlgorithm(); }
    return SignatureAlgorithm { scheme: scheme, oid: oid, pssHashBits: pss.hashBits, pssSaltLength: pss.saltLength, der: Der.Encoded(p, e) };
}

/// A stable index per scheme (declaration order); Unknown is 8.
pub i64 SchemeIndex(SignatureScheme s) {
    return match s {
        SignatureScheme::RsaPkcs1Sha256 => 0_i64,
        SignatureScheme::RsaPkcs1Sha384 => 1_i64,
        SignatureScheme::RsaPkcs1Sha512 => 2_i64,
        SignatureScheme::RsaPss => 3_i64,
        SignatureScheme::EcdsaSha256 => 4_i64,
        SignatureScheme::EcdsaSha384 => 5_i64,
        SignatureScheme::EcdsaSha512 => 6_i64,
        SignatureScheme::Ed25519 => 7_i64,
        SignatureScheme::Unknown => 8_i64,
    };
}

pub PublicKeyInfo EmptyKey() {
    return PublicKeyInfo { algorithm: KeyAlgorithm::Unknown, der: Slice.New(0_i64), rsaModulus: Slice.New(0_i64), rsaExponent: Slice.New(0_i64), keyBytes: Slice.New(0_i64), curveOid: "" };
}

/// Parses SubjectPublicKeyInfo (RFC 5280 4.1.2.7, RFC 3279, RFC 5480, RFC 8410).
pub PublicKeyInfo ParsePublicKeyInfo(DerParser p, DerElement e) {
    if !Der.Ok(p) { return EmptyKey(); }
    if !Der.Is(e, 0_i64, true, 16_i64) { Der.Fail(p, 4_i64); return EmptyKey(); }
    DerElement alg = Der.ExpectSequence(p, e.content, e.end);
    DerElement bits = Der.ExpectUniversal(p, alg.end, e.end, 3_i64);
    Der.ExpectEnd(p, bits.end, e.end);
    string oid = Der.ReadOid(p, alg.content, alg.end);
    DerElement oidEl = Der.Read(p, alg.content, alg.end);
    u8[] keyBytes = Der.BitStringOctets(p, bits);
    if !Der.Ok(p) { return EmptyKey(); }
    mut KeyAlgorithm algorithm = KeyAlgorithm::Unknown;
    mut u8[] n = Slice.New(0_i64);
    mut u8[] exp = Slice.New(0_i64);
    mut string curve = "";
    if oid == "1.2.840.113549.1.1.1" {
        NullOrAbsent(p, oidEl.end, alg.end);
        // RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }
        DerParser kp = Der.New(keyBytes);
        DerElement seq = Der.ExpectSequence(kp, 0_i64, Slice.Len(keyBytes));
        Der.ExpectEnd(kp, seq.end, Slice.Len(keyBytes));
        DerElement ne = Der.ExpectUniversal(kp, seq.content, seq.end, 2_i64);
        DerElement ee = Der.ExpectUniversal(kp, ne.end, seq.end, 2_i64);
        Der.ExpectEnd(kp, ee.end, seq.end);
        n = Der.UnsignedIntegerBytes(kp, ne);
        exp = Der.UnsignedIntegerBytes(kp, ee);
        if !Der.Ok(kp) { Der.Fail(p, 22_i64); return EmptyKey(); }
        algorithm = KeyAlgorithm::Rsa;
    } else if oid == "1.2.840.10045.2.1" {
        curve = Der.ReadOid(p, oidEl.end, alg.end);
        DerElement curveEl = Der.Read(p, oidEl.end, alg.end);
        Der.ExpectEnd(p, curveEl.end, alg.end);
        if curve == "1.2.840.10045.3.1.7" {
            if Slice.Len(keyBytes) != 65_i64 || keyBytes[0] != 4_u8 { Der.Fail(p, 22_i64); return EmptyKey(); }
            algorithm = KeyAlgorithm::EcP256;
        } else {
            algorithm = KeyAlgorithm::EcOther;
        }
    } else if oid == "1.3.101.112" {
        Absent(p, oidEl.end, alg.end);
        if Slice.Len(keyBytes) != 32_i64 { Der.Fail(p, 22_i64); return EmptyKey(); }
        algorithm = KeyAlgorithm::Ed25519;
    }
    if !Der.Ok(p) { return EmptyKey(); }
    return PublicKeyInfo { algorithm: algorithm, der: Der.Encoded(p, e), rsaModulus: n, rsaExponent: exp, keyBytes: keyBytes, curveOid: curve };
}

NameConstraints NoConstraints() {
    return NameConstraints { present: false, permittedDns: Array.Empty<string>(), excludedDns: Array.Empty<string>(), permittedIp: Array.Empty<IpBytes>(), excludedIp: Array.Empty<IpBytes>(), hasUnsupportedForm: false };
}

pub Extensions NoExtensions() {
    return Extensions {
        hasBasicConstraints: false, isCa: false, pathLen: -1_i64,
        hasKeyUsage: false, keyUsage: 0_i64,
        hasExtKeyUsage: false, ekuServerAuth: false, ekuClientAuth: false, ekuAny: false,
        hasSubjectAltName: false, dnsNames: Array.Empty<string>(), ipAddresses: Array.Empty<IpBytes>(),
        subjectKeyId: Slice.New(0_i64), authorityKeyId: Slice.New(0_i64),
        nameConstraints: NoConstraints(),
    };
}

/// ASCII lower-casing; other bytes are kept.
pub string Lower(string s) {
    i64 n = String.Len(s);
    mut bool needs = false;
    mut i64 i = 0_i64;
    while i < n {
        u8 c = String.ByteAt(s, i);
        if c >= 65_u8 && c <= 90_u8 { needs = true; }
        i = i + 1_i64;
    }
    if !needs { return s; }
    u8[] out = Slice.New(n);
    i = 0_i64;
    while i < n {
        u8 c = String.ByteAt(s, i);
        if c >= 65_u8 && c <= 90_u8 { out[i] = c + 32_u8; } else { out[i] = c; }
        i = i + 1_i64;
    }
    return String.FromUtf8CodeUnits(out);
}

type Subtrees { string[] dns, IpBytes[] ips, bool unsupported, }

/// Reads GeneralSubtrees.
Subtrees ParseSubtrees(DerParser p, DerElement trees) {
    mut string[] dns = Array.Empty<string>();
    mut IpBytes[] ips = Array.Empty<IpBytes>();
    mut bool unsupported = false;
    if trees.length == 0_i64 { Der.Fail(p, 23_i64); }
    mut i64 pos = trees.content;
    while Der.Ok(p) && pos < trees.end {
        DerElement sub = Der.ExpectSequence(p, pos, trees.end);
        DerElement base = Der.Read(p, sub.content, sub.end);
        // minimum must be 0 (absent in DER) and maximum must be absent (RFC 5280 4.2.1.10).
        Der.ExpectEnd(p, base.end, sub.end);
        if Der.Ok(p) {
            if Der.Is(base, 2_i64, false, 2_i64) {
                Array.Append<string>(dns, Lower(Der.ReadIa5(p, base)));
            } else if Der.Is(base, 2_i64, false, 7_i64) {
                if base.length != 8_i64 && base.length != 32_i64 { Der.Fail(p, 23_i64); }
                else { Array.Append<IpBytes>(ips, IpBytes { bytes: Der.Content(p, base) }); }
            } else {
                unsupported = true;
            }
        }
        pos = sub.end;
    }
    return Subtrees { dns: dns, ips: ips, unsupported: unsupported };
}

pub NameConstraints ParseNameConstraints(DerParser p, i64 at, i64 end) {
    DerElement seq = Der.ExpectSequence(p, at, end);
    Der.ExpectEnd(p, seq.end, end);
    mut Subtrees permitted = Subtrees { dns: Array.Empty<string>(), ips: Array.Empty<IpBytes>(), unsupported: false };
    mut Subtrees excluded = Subtrees { dns: Array.Empty<string>(), ips: Array.Empty<IpBytes>(), unsupported: false };
    mut i64 q = seq.content;
    if Der.Ok(p) && seq.length == 0_i64 { Der.Fail(p, 23_i64); }
    if Der.PeekIs(p, q, seq.end, 2_i64, 0_i64) {
        DerElement pe = Der.Expect(p, q, seq.end, 2_i64, true, 0_i64);
        permitted = ParseSubtrees(p, pe);
        q = pe.end;
    }
    if Der.PeekIs(p, q, seq.end, 2_i64, 1_i64) {
        DerElement ee = Der.Expect(p, q, seq.end, 2_i64, true, 1_i64);
        excluded = ParseSubtrees(p, ee);
        q = ee.end;
    }
    Der.ExpectEnd(p, q, seq.end);
    return NameConstraints { present: true, permittedDns: permitted.dns, excludedDns: excluded.dns, permittedIp: permitted.ips, excludedIp: excluded.ips, hasUnsupportedForm: permitted.unsupported || excluded.unsupported };
}

bool Contains(string[] list, string value) {
    mut i64 i = 0_i64;
    while i < Array.Len<string>(list) {
        if list[i] == value { return true; }
        i = i + 1_i64;
    }
    return false;
}

// Scalar extension state, indexed by the constants below.
i64 SBc() { return 0_i64; }
i64 SCa() { return 1_i64; }
i64 SPathLen() { return 2_i64; }
i64 SKu() { return 3_i64; }
i64 SKuBits() { return 4_i64; }
i64 SEku() { return 5_i64; }
i64 SServer() { return 6_i64; }
i64 SClient() { return 7_i64; }
i64 SAny() { return 8_i64; }
i64 SSan() { return 9_i64; }

/// basicConstraints (RFC 5280 4.2.1.9).
pub unit ParseBasicConstraints(DerParser p, i64 vs, i64 ve, i64[] st) {
    st[SBc()] = 1_i64;
    DerElement bc = Der.ExpectSequence(p, vs, ve);
    Der.ExpectEnd(p, bc.end, ve);
    mut i64 b = bc.content;
    if Der.PeekIs(p, b, bc.end, 0_i64, 1_i64) {
        DerElement caEl = Der.Read(p, b, bc.end);
        if Der.ReadBoolean(p, caEl) { st[SCa()] = 1_i64; }
        b = caEl.end;
    }
    if Der.PeekIs(p, b, bc.end, 0_i64, 2_i64) {
        DerElement plEl = Der.Read(p, b, bc.end);
        st[SPathLen()] = Der.ReadSmallInteger(p, b, bc.end);
        b = plEl.end;
        // pathLenConstraint is meaningful only when cA is TRUE.
        if st[SCa()] == 0_i64 { Der.Fail(p, 23_i64); }
    }
    Der.ExpectEnd(p, b, bc.end);
    return;
}

/// keyUsage (RFC 5280 4.2.1.3).
unit ParseKeyUsage(DerParser p, i64 vs, i64 ve, i64[] st) {
    st[SKu()] = 1_i64;
    DerElement kuEl = Der.ExpectUniversal(p, vs, ve, 3_i64);
    Der.ExpectEnd(p, kuEl.end, ve);
    i64 bits = Der.NamedBits(p, kuEl);
    if bits == 0_i64 { Der.Fail(p, 23_i64); }
    st[SKuBits()] = bits;
    return;
}

/// extKeyUsage (RFC 5280 4.2.1.12).
unit ParseExtKeyUsage(DerParser p, i64 vs, i64 ve, i64[] st) {
    st[SEku()] = 1_i64;
    DerElement ekuEl = Der.ExpectSequence(p, vs, ve);
    Der.ExpectEnd(p, ekuEl.end, ve);
    if Der.Ok(p) && ekuEl.length == 0_i64 { Der.Fail(p, 23_i64); }
    mut i64 k = ekuEl.content;
    while Der.Ok(p) && k < ekuEl.end {
        DerElement purposeEl = Der.Read(p, k, ekuEl.end);
        string purpose = Der.OidString(p, purposeEl);
        if purpose == "1.3.6.1.5.5.7.3.1" { st[SServer()] = 1_i64; }
        if purpose == "1.3.6.1.5.5.7.3.2" { st[SClient()] = 1_i64; }
        if purpose == "2.5.29.37.0" { st[SAny()] = 1_i64; }
        k = purposeEl.end;
    }
    return;
}

pub type AltNames { string[] dns, IpBytes[] ips, }

/// subjectAltName (RFC 5280 4.2.1.6): dNSName and iPAddress are kept, other forms skipped.
pub AltNames ParseSubjectAltName(DerParser p, i64 vs, i64 ve) {
    mut string[] dns = Array.Empty<string>();
    mut IpBytes[] ips = Array.Empty<IpBytes>();
    DerElement sanEl = Der.ExpectSequence(p, vs, ve);
    Der.ExpectEnd(p, sanEl.end, ve);
    if Der.Ok(p) && sanEl.length == 0_i64 { Der.Fail(p, 23_i64); }
    mut i64 k = sanEl.content;
    while Der.Ok(p) && k < sanEl.end {
        DerElement gn = Der.Read(p, k, sanEl.end);
        if Der.Ok(p) && gn.tagClass != 2_i64 { Der.Fail(p, 23_i64); }
        if Der.Is(gn, 2_i64, false, 2_i64) {
            Array.Append<string>(dns, Der.ReadIa5(p, gn));
        } else if Der.Is(gn, 2_i64, false, 7_i64) {
            if gn.length != 4_i64 && gn.length != 16_i64 { Der.Fail(p, 23_i64); }
            else { Array.Append<IpBytes>(ips, IpBytes { bytes: Der.Content(p, gn) }); }
        }
        k = gn.end;
    }
    return AltNames { dns: dns, ips: ips };
}

u8[] ParseSubjectKeyId(DerParser p, i64 vs, i64 ve) {
    DerElement skiEl = Der.ExpectUniversal(p, vs, ve, 4_i64);
    Der.ExpectEnd(p, skiEl.end, ve);
    return Der.Content(p, skiEl);
}

u8[] ParseAuthorityKeyId(DerParser p, i64 vs, i64 ve) {
    DerElement akiEl = Der.ExpectSequence(p, vs, ve);
    Der.ExpectEnd(p, akiEl.end, ve);
    if Der.PeekIs(p, akiEl.content, akiEl.end, 2_i64, 0_i64) {
        DerElement kid = Der.Expect(p, akiEl.content, akiEl.end, 2_i64, false, 0_i64);
        return Der.Content(p, kid);
    }
    return Slice.New(0_i64);
}

/// One Extension SEQUENCE header: OID, critical flag, and the OCTET STRING value.
pub type ExtHeader { string oid, bool critical, i64 valueStart, i64 valueEnd, i64 end, }

pub ExtHeader ReadExtHeader(DerParser p, i64 pos, i64 limit) {
    DerElement ext = Der.ExpectSequence(p, pos, limit);
    DerElement oidEl = Der.Read(p, ext.content, ext.end);
    string oid = Der.OidString(p, oidEl);
    mut i64 q = oidEl.end;
    mut bool critical = false;
    if Der.PeekIs(p, q, ext.end, 0_i64, 1_i64) {
        // DER omits a DEFAULT FALSE value; an explicit FALSE is tolerated because
        // deployed certificates carry it, and it changes nothing.
        DerElement flag = Der.Read(p, q, ext.end);
        critical = Der.ReadBoolean(p, flag);
        q = flag.end;
    }
    DerElement value = Der.ExpectUniversal(p, q, ext.end, 4_i64);
    Der.ExpectEnd(p, value.end, ext.end);
    if !Der.Ok(p) { return ExtHeader { oid: "", critical: false, valueStart: limit, valueEnd: limit, end: limit }; }
    return ExtHeader { oid: oid, critical: critical, valueStart: value.content, valueEnd: value.end, end: ext.end };
}

/// Parses the [3] Extensions wrapper content.
pub Extensions ParseExtensions(DerParser p, DerElement wrapper) {
    DerElement list = Der.ExpectSequence(p, wrapper.content, wrapper.end);
    Der.ExpectEnd(p, list.end, wrapper.end);
    if Der.Ok(p) && list.length == 0_i64 { Der.Fail(p, 23_i64); }
    mut string[] seen = Array.Empty<string>();
    i64[] st = [0_i64, 0_i64, -1_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64];
    mut AltNames san = AltNames { dns: Array.Empty<string>(), ips: Array.Empty<IpBytes>() };
    mut u8[] ski = Slice.New(0_i64);
    mut u8[] aki = Slice.New(0_i64);
    mut NameConstraints nc = NoConstraints();
    mut i64 pos = list.content;
    while Der.Ok(p) && pos < list.end {
        ExtHeader h = ReadExtHeader(p, pos, list.end);
        string oid = h.oid;
        if Der.Ok(p) && Contains(seen, oid) { Der.Fail(p, 23_i64); }
        Array.Append<string>(seen, oid);
        if !Der.Ok(p) { pos = list.end; }
        else if oid == "2.5.29.19" { ParseBasicConstraints(p, h.valueStart, h.valueEnd, st); }
        else if oid == "2.5.29.15" { ParseKeyUsage(p, h.valueStart, h.valueEnd, st); }
        else if oid == "2.5.29.37" { ParseExtKeyUsage(p, h.valueStart, h.valueEnd, st); }
        else if oid == "2.5.29.17" { st[SSan()] = 1_i64; san = ParseSubjectAltName(p, h.valueStart, h.valueEnd); }
        else if oid == "2.5.29.14" { ski = ParseSubjectKeyId(p, h.valueStart, h.valueEnd); }
        else if oid == "2.5.29.35" { aki = ParseAuthorityKeyId(p, h.valueStart, h.valueEnd); }
        else if oid == "2.5.29.30" { nc = ParseNameConstraints(p, h.valueStart, h.valueEnd); }
        // certificatePolicies: accepted without policy processing (initial-any-policy).
        else if oid == "2.5.29.32" { Der.ExpectSequence(p, h.valueStart, h.valueEnd); }
        else if h.critical { Der.Fail(p, 24_i64); }
        pos = h.end;
    }
    return Extensions {
        hasBasicConstraints: st[0] == 1_i64, isCa: st[1] == 1_i64, pathLen: st[2],
        hasKeyUsage: st[3] == 1_i64, keyUsage: st[4],
        hasExtKeyUsage: st[5] == 1_i64, ekuServerAuth: st[6] == 1_i64, ekuClientAuth: st[7] == 1_i64, ekuAny: st[8] == 1_i64,
        hasSubjectAltName: st[9] == 1_i64, dnsNames: san.dns, ipAddresses: san.ips,
        subjectKeyId: ski, authorityKeyId: aki,
        nameConstraints: nc,
    };
}

/// Parses one DER certificate.
pub Result<Certificate, X509Error> Parse(u8[] der) {
    i64 size = Slice.Len(der);
    if size > Der.MaxObjectSize() { return Result::Error(X509Error::TooLarge); }
    DerParser p = Der.New(der);
    Der.CheckTree(p, 0_i64, size);
    DerElement cert = Der.ExpectSequence(p, 0_i64, size);
    DerElement tbs = Der.ExpectSequence(p, cert.content, cert.end);
    DerElement outerAlg = Der.ExpectSequence(p, tbs.end, cert.end);
    DerElement sigBits = Der.ExpectUniversal(p, outerAlg.end, cert.end, 3_i64);
    Der.ExpectEnd(p, sigBits.end, cert.end);
    u8[] signature = Der.BitStringOctets(p, sigBits);
    // TBSCertificate
    mut i64 q = tbs.content;
    mut i64 version = 1_i64;
    if Der.PeekIs(p, q, tbs.end, 2_i64, 0_i64) {
        DerElement v = Der.Expect(p, q, tbs.end, 2_i64, true, 0_i64);
        DerElement vi = Der.Read(p, v.content, v.end);
        Der.ExpectEnd(p, vi.end, v.end);
        i64 raw = Der.ReadSmallInteger(p, v.content, v.end);
        // v1 is the DEFAULT and must not be encoded in DER.
        if Der.Ok(p) && (raw < 1_i64 || raw > 2_i64) { Der.Fail(p, 17_i64); }
        version = raw + 1_i64;
        q = v.end;
    }
    DerElement serialEl = Der.ExpectUniversal(p, q, tbs.end, 2_i64);
    Der.CheckInteger(p, serialEl);
    if Der.Ok(p) && (Der.IntegerIsNegative(p, serialEl) || serialEl.length > 21_i64) { Der.Fail(p, 18_i64); }
    u8[] serial = Der.Content(p, serialEl);
    DerElement innerAlg = Der.ExpectSequence(p, serialEl.end, tbs.end);
    if Der.Ok(p) && !Der.RangeEquals(der, innerAlg.start, der, outerAlg.start, innerAlg.end - innerAlg.start) { Der.Fail(p, 19_i64); }
    if Der.Ok(p) && innerAlg.end - innerAlg.start != outerAlg.end - outerAlg.start { Der.Fail(p, 19_i64); }
    SignatureAlgorithm sigAlg = ParseSignatureAlgorithm(p, outerAlg);
    DerElement issuerEl = Der.ExpectSequence(p, innerAlg.end, tbs.end);
    DistinguishedName issuer = Names.Parse(p, issuerEl);
    DerElement validity = Der.ExpectSequence(p, issuerEl.end, tbs.end);
    i64 notBefore = Der.ReadTime(p, validity.content, validity.end);
    DerElement nbEl = Der.Read(p, validity.content, validity.end);
    i64 notAfter = Der.ReadTime(p, nbEl.end, validity.end);
    DerElement naEl = Der.Read(p, nbEl.end, validity.end);
    Der.ExpectEnd(p, naEl.end, validity.end);
    DerElement subjectEl = Der.ExpectSequence(p, validity.end, tbs.end);
    DistinguishedName subject = Names.Parse(p, subjectEl);
    DerElement spkiEl = Der.ExpectSequence(p, subjectEl.end, tbs.end);
    PublicKeyInfo key = ParsePublicKeyInfo(p, spkiEl);
    q = spkiEl.end;
    if Der.PeekIs(p, q, tbs.end, 2_i64, 1_i64) {
        if Der.Ok(p) && version < 2_i64 { Der.Fail(p, 17_i64); }
        DerElement uid = Der.Read(p, q, tbs.end);
        q = uid.end;
    }
    if Der.PeekIs(p, q, tbs.end, 2_i64, 2_i64) {
        if Der.Ok(p) && version < 2_i64 { Der.Fail(p, 17_i64); }
        DerElement uid2 = Der.Read(p, q, tbs.end);
        q = uid2.end;
    }
    mut Extensions ext = NoExtensions();
    if Der.PeekIs(p, q, tbs.end, 2_i64, 3_i64) {
        if Der.Ok(p) && version != 3_i64 { Der.Fail(p, 17_i64); }
        DerElement wrapper = Der.Expect(p, q, tbs.end, 2_i64, true, 3_i64);
        ext = ParseExtensions(p, wrapper);
        q = wrapper.end;
    }
    Der.ExpectEnd(p, q, tbs.end);
    if !Der.Ok(p) { return Result::Error(Der.Error(p)); }
    return Result::Ok(Certificate {
        der: der, tbsStart: tbs.start, tbsLength: tbs.end - tbs.start,
        version: version, serial: serial, signatureAlgorithm: sigAlg,
        issuer: issuer, subject: subject, notBefore: notBefore, notAfter: notAfter,
        publicKey: key, extensions: ext, signature: signature,
    });
}

/// Parses the first CERTIFICATE block of PEM text.
pub Result<Certificate, X509Error> ParsePem(string text) {
    PemStep step = Pem.Next(text, 0_i64);
    if !step.found {
        X509Error error = step.error;
        bool clean = match error { X509Error::None => true, _ => false, };
        if clean { return Result::Error(X509Error::BadPem); }
        return Result::Error(error);
    }
    return Parse(step.der);
}

/// Parses every CERTIFICATE block of PEM text, in order.
pub Result<Certificate[], X509Error> ParsePemAll(string text) {
    Result<DerBlob[], X509Error> blobs = Pem.DecodeAll(text);
    return match blobs {
        Result::Error(error) => Result::Error(error),
        Result::Ok(list) => ParseBlobs(list),
    };
}

Result<Certificate[], X509Error> ParseBlobs(DerBlob[] list) {
    mut Certificate[] certs = Array.Empty<Certificate>();
    mut i64 i = 0_i64;
    while i < Array.Len<DerBlob>(list) {
        DerBlob blob = list[i];
        Result<Certificate, X509Error> parsed = Parse(blob.der);
        X509Error error = ErrorOf(parsed);
        bool failed = match error { X509Error::None => false, _ => true, };
        if failed { return Result::Error(error); }
        Array.Append<Certificate>(certs, Unwrap(parsed));
        i = i + 1_i64;
    }
    return Result::Ok(certs);
}

/// The certificate of a successful parse; callers check `Succeeded` first.
pub Certificate Unwrap(Result<Certificate, X509Error> parsed) {
    return match parsed { Result::Ok(c) => c, Result::Error(_) => Placeholder(), };
}

pub Certificate Placeholder() {
    return Certificate {
        der: Slice.New(0_i64), tbsStart: 0_i64, tbsLength: 0_i64, version: 0_i64, serial: Slice.New(0_i64),
        signatureAlgorithm: UnknownAlgorithm(), issuer: Names.EmptyName(), subject: Names.EmptyName(),
        notBefore: 0_i64, notAfter: -1_i64, publicKey: EmptyKey(), extensions: NoExtensions(), signature: Slice.New(0_i64),
    };
}

/// The error of a failed parse, or None.
pub X509Error ErrorOf(Result<Certificate, X509Error> parsed) {
    return match parsed { Result::Ok(_) => X509Error::None, Result::Error(e) => e, };
}

pub bool Succeeded(Result<Certificate, X509Error> parsed) {
    return match parsed { Result::Ok(_) => true, Result::Error(_) => false, };
}

/// True when the certificate is a self-issued (issuer equals subject) certificate.
pub bool IsSelfIssued(Certificate c) {
    return Names.Equal(c.issuer, c.subject);
}
