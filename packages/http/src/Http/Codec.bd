/// Validated framing fields: -2 chunked, -1 neither field, otherwise the declared length. Body limits are applied by Framing.
Result<i64,HttpError> FieldFraming(Header[] headers) { mut bool lengthSeen=false; mut bool chunked=false; mut i64 length=-1_i64; mut i64 i=0_i64; while i<Array.Len<Header>(headers) { Header h=Array.Get<Header>(headers,i); if h.name=="content-length" { if lengthSeen {return Result::Error(HttpError::AmbiguousFraming());} Result<i64,HttpError> parsed=Decimal(h.value); match parsed { Result::Ok(value)=>{length=value;lengthSeen=true;},Result::Error(error)=>{return Result::Error(error);},}; } if h.name=="transfer-encoding" { if chunked || LowerAscii(h.value)!="chunked" {return Result::Error(HttpError::UnsupportedTransferCoding());} chunked=true; } i=i+1_i64; } if chunked && lengthSeen{return Result::Error(HttpError::AmbiguousFraming());} if chunked{return Result::Ok(-2_i64);} return Result::Ok(length); }
bool IsRequest(MessageRole role) { return match role { MessageRole::Request => true, _ => false, }; }
bool Interim(i64 status) { return status >= 100_i64 && status <= 199_i64; }
/// RFC 9112 section 6.3 item 1: a HEAD response and any 1xx, 204, or 304 response end at the head.
bool Bodiless(MessageRole role, i64 status) {
    return match role {
        MessageRole::Request => false,
        MessageRole::HeadResponse => true,
        MessageRole::Response => Interim(status) || status == 204_i64 || status == 304_i64,
    };
}
/// Body framing for one message role; -1 means the message ends at its head.
/// Framing fields are validated first, so AmbiguousFraming wins over the no-body rule;
/// a bodiless response validates but does not apply them. A request with neither field
/// has an empty body; a response with neither field would be close-delimited, which the
/// bounded v0.5 reader rejects.
Result<i64,HttpError> Framing(Header[] headers, Limits limits, MessageRole role, i64 status) {
    Result<i64,HttpError> declared = FieldFraming(headers);
    return match declared {
        Result::Error(error) => Result::Error(error),
        Result::Ok(length) => {
            if Bodiless(role, status) { return Result::Ok(-1_i64); }
            if length == -1_i64 && !IsRequest(role) { return Result::Error(HttpError::CloseDelimitedBody()); }
            if length > limits.maxBodyBytes { return Result::Error(HttpError::BodyTooLarge()); }
            return Result::Ok(length);
        },
    };
}
bool HexByte(u8 value) { return (value >= u8(48) && value <= u8(57)) || (value >= u8(65) && value <= u8(70)) || (value >= u8(97) && value <= u8(102)); }
/// An RFC 3986 unreserved or sub-delims octet: ALPHA DIGIT - . _ ~ ! $ & ' ( ) * + , ; =
bool HostByte(u8 value) {
    if value >= u8(48) && value <= u8(57) { return true; }
    if value >= u8(65) && value <= u8(90) { return true; }
    if value >= u8(97) && value <= u8(122) { return true; }
    return value == u8(45) || value == u8(46) || value == u8(95) || value == u8(126) || value == u8(33) || value == u8(36) || value == u8(38) || value == u8(39) || value == u8(40) || value == u8(41) || value == u8(42) || value == u8(43) || value == u8(44) || value == u8(59) || value == u8(61);
}
/// One to five decimal digits with a value in 0..65535.
bool HostPort(string value, i64 start) {
    i64 count = String.Len(value) - start;
    if count <= 0_i64 || count > 5_i64 { return false; }
    mut i64 port = 0_i64;
    mut i64 i = start;
    while i < String.Len(value) {
        u8 b = String.ByteAt(value, i);
        if b < u8(48) || b > u8(57) { return false; }
        port = port * 10_i64 + i64(b - u8(48));
        i = i + 1_i64;
    }
    return port <= 65535_i64;
}
/// Empty, or uri-host [ ":" port ]: a bracketed IPv6 literal or a run of unreserved,
/// sub-delims, and pct-encoded octets. No whitespace, controls, or second colon outside brackets.
bool HostValue(string value) {
    i64 count = String.Len(value);
    if count == 0_i64 { return true; }
    mut i64 i = 0_i64;
    if String.ByteAt(value, 0_i64) == u8(91) {
        mut bool colon = false;
        i = 1_i64;
        while i < count && String.ByteAt(value, i) != u8(93) {
            u8 b = String.ByteAt(value, i);
            if b == u8(58) { colon = true; } else if !(HexByte(b) || b == u8(46)) { return false; }
            i = i + 1_i64;
        }
        if i >= count || !colon { return false; }
        i = i + 1_i64;
    } else {
        while i < count && String.ByteAt(value, i) != u8(58) {
            u8 b = String.ByteAt(value, i);
            if b == u8(37) {
