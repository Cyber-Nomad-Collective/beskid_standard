// Generic bodies are judged against their own type parameters (beskid-lings milestone 3):
// `Second` declares `A` and returns the `B` field, and `Pick` declares `B` and returns its `A`
// parameter.
pub type Pair<A, B>
{
    A first;
    B second;

    pub A Second()
    {
        return this.second;
    }
}

B Pick<A, B>(A first, B second)
{
    return first;
}

pub unit Trigger()
{
    Pair<string, string> pair = Pair<string, string>
    {
        first: "one",
        second: "two",
    };
    pair.Second();
    Pick<string, string>("one", "two");
    return;
}
