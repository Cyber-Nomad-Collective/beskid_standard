// EXPECT: E1610
// A port element must be Transferable. A contract value takes its transfer class from the
// markers its contract embeds; `Scored` embeds none, so its values may hold any implementing
// type and never cross a heap boundary.
use Core.Results;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Parallel.Port;

contract Scored { i64 Score(); }

test PortOfAnUnmarkedContractIsRejected {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        Port<Scored> p = s.Port<Scored>();
        return Result::Ok(0_i64);
    });
}
