connect_tests {
  name = "connect_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_connect" { source = path path = ".." }
target "ConnectSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "ConnectOrderTests" { kind = Lib entry = "OrderTests.bd" }
target "ConnectLoopbackTests" { kind = Lib entry = "LoopbackTests.bd" }
target "ConnectFallbackTests" { kind = Lib entry = "FallbackTests.bd" }
target "ConnectDeadlineTests" { kind = Lib entry = "DeadlineTests.bd" }
target "ConnectErrorTests" { kind = Lib entry = "ErrorTests.bd" }
target "ConnectCancelTests" { kind = Lib entry = "CancelTests.bd" }
target "ConnectLeakTests" { kind = Lib entry = "LeakTests.bd" }
