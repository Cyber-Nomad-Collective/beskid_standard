/// Typed failures for `Core.Text.Number` parsing and conversion.
/// @tier(supported)
/// @variant(Empty) The input contained no digits.
/// @variant(InvalidCharacter) A byte at `offset` is not valid at that position.
/// @variant(Overflow) The value does not fit the target type.
/// @variant(NotFinite) A NaN or infinite `f64` cannot be converted to an integer.
pub enum NumberError {
    Empty,
    InvalidCharacter(i64 offset),
    Overflow,
    NotFinite,
}
