pub u8[] ClientApTraffic() { return Hex.Of("9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5"); }
pub u8[] ServerApTraffic() { return Hex.Of("a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643"); }
