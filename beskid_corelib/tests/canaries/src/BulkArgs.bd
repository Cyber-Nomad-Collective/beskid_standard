/// Canary: `bulk` parameters accept several call arguments (`List.Of<i64>(1, 2, 3)`).
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Collections.List;

test bulk_constructor_with_several_arguments {
    List<i64> values = List.Of<i64>(1, 2, 3);
    Assert.True(values.Count() == 3, "bulk parameter takes several arguments");
}
