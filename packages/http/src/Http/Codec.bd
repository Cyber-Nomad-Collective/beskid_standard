bool TokenByte(u8 value) {
    if value >= u8(48) && value <= u8(57) { return true; }
    if value >= u8(65) && value <= u8(90) { return true; }
    if value >= u8(97) && value <= u8(122) { return true; }
    return value == u8(33) || value == u8(35) || value == u8(36) || value == u8(37) || value == u8(38) || value == u8(39) || value == u8(42) || value == u8(43) || value == u8(45) || value == u8(46) || value == u8(94) || value == u8(95) || value == u8(96) || value == u8(124) || value == u8(126);
}
bool Token(string value) { if String.Len(value) == 0_i64 { return false; } mut i64 i = 0_i64; while i < String.Len(value) { if !TokenByte(String.ByteAt(value, i)) { return false; } i = i + 1_i64; } return true; }
bool FieldValue(string value) { mut i64 i = 0_i64; while i < String.Len(value) { u8 b = String.ByteAt(value, i); if !(b == u8(9) || (b >= u8(32) && b <= u8(126))) { return false; } i = i + 1_i64; } return true; }
