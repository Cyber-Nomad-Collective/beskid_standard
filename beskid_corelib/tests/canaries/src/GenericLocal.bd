/// Canary: Locals whose type is a type parameter lower.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Collections.Array;

T FirstOf<T>(T[] values) {
    T first = Array.Get<T>(values, 0);
    return first;
}

test generic_typed_local {
    Assert.True(FirstOf<i64>([4_i64, 5_i64]) == 4, "local of type-parameter type");
}
