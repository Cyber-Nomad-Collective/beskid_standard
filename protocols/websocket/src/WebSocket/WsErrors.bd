// Typed WebSocket failures. Every failure that ends an open connection maps to the
// close status code this side sent (RFC 6455 section 7.4.1).

/// Closed set of WebSocket failures.
pub enum WsError {
    // An argument is outside its documented domain (for example an oversized control payload).
    InvalidArgument(),
    // The URL does not parse, has no host, or carries a fragment (RFC 6455 section 3).
    InvalidUrl(),
    // The URL scheme is not ws (wss waits for the TLS transport).
    UnsupportedScheme(),
    // No TCP connection could be established.
    ConnectFailed(),
    // The transport failed (reset, closed, short write).
    Io(),
    // A read or write deadline passed.
    TimedOut(),
    // The opening handshake is malformed or does not validate; the reason is a WsHandshake code.
    HandshakeFailed(i64 reason),
    // The server answered the opening handshake with a status other than 101.
    Rejected(i64 status),
    // Frame decoding needs more bytes than the window holds.
    Incomplete(),
    // The peer violated the framing rules; this side sent close 1002. The reason is a WsFrame code.
    ProtocolError(i64 reason),
    // A text message or close reason is not valid UTF-8; this side sent close 1007.
    InvalidUtf8(),
    // A message exceeds the configured limit; this side sent close 1009.
    MessageTooBig(),
    // The connection is closed or closing for this operation.
    Closed(),
    // The OS entropy source failed (masking key or Sec-WebSocket-Key).
    EntropyUnavailable(),
}

/// Stable small integer per variant, for tests and logs.
pub i64 Code(WsError error) {
    return match error {
        WsError::InvalidArgument => 1_i64,
        WsError::InvalidUrl => 2_i64,
        WsError::UnsupportedScheme => 3_i64,
        WsError::ConnectFailed => 4_i64,
        WsError::Io => 5_i64,
        WsError::TimedOut => 6_i64,
        WsError::HandshakeFailed(_) => 7_i64,
        WsError::Rejected(_) => 8_i64,
        WsError::Incomplete => 9_i64,
        WsError::ProtocolError(_) => 10_i64,
        WsError::InvalidUtf8 => 11_i64,
        WsError::MessageTooBig => 12_i64,
        WsError::Closed => 13_i64,
        WsError::EntropyUnavailable => 14_i64,
    };
}

/// Detail of HandshakeFailed, ProtocolError and Rejected; 0 for other variants.
pub i64 Detail(WsError error) {
    return match error {
        WsError::HandshakeFailed(reason) => reason,
        WsError::Rejected(status) => status,
        WsError::ProtocolError(reason) => reason,
        _ => 0_i64,
    };
}

/// Close status code this side sends for a failure of an open connection (1002, 1007,
/// 1009), or 1011 for an internal failure, or 1006 (none sent) for transport failures.
pub i64 CloseCodeFor(WsError error) {
    return match error {
        WsError::ProtocolError(_) => 1002_i64,
        WsError::InvalidUtf8 => 1007_i64,
        WsError::MessageTooBig => 1009_i64,
        WsError::EntropyUnavailable => 1011_i64,
        _ => 1006_i64,
    };
}
