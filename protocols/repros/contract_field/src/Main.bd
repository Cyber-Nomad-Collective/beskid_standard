// GAP: a struct field of contract type. The struct literal ICEs (StructLiteralExpression); later use gives "semantic fact abi_type is unavailable".
use Core.Bytes.Slice;
use Core.IO;
use Core.IO.IoError;
use Core.IO.Reader;
use Core.Results;
use Testing.Assert;

pub type ZeroReader: Reader {
    i64 unused,
    pub Result<i64, IoError> Read(u8[] destination, i64 offset, i64 count) { return Result::Ok(0_i64); }
}

i64 ReadVia(Reader r, u8[] buf) {
    Result<i64, IoError> got = IO.Read(r, buf, 0_i64, 1_i64);
    match got {
        Result::Ok(n) => { return n; },
        Result::Error(_) => { return -1_i64; },
    };
}

pub type Holder {
    Reader source,
    i64 tag,
}

test contract_in_struct_field {
    ZeroReader r = ZeroReader { unused: 0_i64 };
    Holder h = Holder { source: r, tag: 7_i64 };
    Assert.Equal<i64>(h.tag, 7_i64, "tag");
    Assert.Equal<i64>(ReadVia(h.source, Slice.New(4_i64)), 0_i64, "read through field");
}
