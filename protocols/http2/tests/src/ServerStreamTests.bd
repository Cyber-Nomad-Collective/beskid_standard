use Testing.Assert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Http.Types;
use Http2.Connection;
use Http2.Frame;
use Http2.FrameErrors;
use Http2.Hpack;
use Http2.HpackEncoder;
use Http2.MemoryTransport;
use Http2.Server;

// Server-side stream and header errors over an in-memory transport: the client bytes
// are scripted, and the frames the server wrote are inspected.

type Fixed: RequestHandler {
    i64 tag,
    pub Response Handle(Request request) { return Hello(); }
}

Response Hello() {
    return Response { status: 200_i64, reason: "OK", headers: Array.Empty<Header>(), body: [104_u8, 105_u8] };
}

u8[] Start() {
    return MemoryTransport.Join(Connection.Preface(), Frame.SettingsFrame(Array.Empty<i64>(), Array.Empty<i64>()));
}

Encoder NewEnc() {
    return match HpackEncoder.NewEncoder(HpackEncoder.DefaultEncoderPolicy()) {
        Result::Ok(e) => e,
        Result::Error(_) => NewEnc(),
    };
}

HeaderField[] GetFields(string path) {
    mut HeaderField[] f = Array.Empty<HeaderField>();
    Array.Append<HeaderField>(f, Hpack.Field(":method", "GET"));
    Array.Append<HeaderField>(f, Hpack.Field(":scheme", "http"));
    Array.Append<HeaderField>(f, Hpack.Field(":path", path));
    Array.Append<HeaderField>(f, Hpack.Field(":authority", "a.test"));
    return f;
}

HeaderField[] PostFields(string length) {
    mut HeaderField[] f = Array.Empty<HeaderField>();
    Array.Append<HeaderField>(f, Hpack.Field(":method", "POST"));
    Array.Append<HeaderField>(f, Hpack.Field(":scheme", "http"));
    Array.Append<HeaderField>(f, Hpack.Field(":path", "/p"));
    Array.Append<HeaderField>(f, Hpack.Field(":authority", "a.test"));
    Array.Append<HeaderField>(f, Hpack.Field("content-length", length));
    return f;
}

u8[] Headers(Encoder enc, i64 id, HeaderField[] fields, bool endStream) {
    return Frame.HeadersFrame(id, HpackEncoder.Encode(enc, fields), endStream, true);
}

Config Cfg() {
    Config c = Connection.DefaultConfig();
    c.timeoutMillis = 2000_i64;
    return c;
}

u8[] Serve(u8[] input, Config config) {
    // Targets share one process under --all-targets; keep the heap small.
    Assert.CollectGarbage();
    MemoryTransport t = MemoryTransport.New(input);
    Fixed handler = Fixed { tag: 0_i64 };
    Server.ServeConnection(t, handler, config);
    return MemoryTransport.Written(t);
}

// ---- output inspection ----

// Payload u32 at `at` of the first frame of `kind` (and stream `id` when id >= 0); -1 if absent.
i64 Field32(u8[] out, i64 kind, i64 id, i64 at) {
    mut i64 pos = 0_i64;
    while pos + 9_i64 <= Slice.Len(out) {
        FrameHeader h = Frame.ParseHeader(out, pos);
        if h.kind == kind && (id < 0_i64 || h.streamId == id) { return Frame.GetU32(out, pos + 9_i64 + at); }
        pos = pos + 9_i64 + h.length;
    }
    return -1_i64;
}

i64 Count(u8[] out, i64 kind, i64 flags) {
    mut i64 n = 0_i64;
    mut i64 pos = 0_i64;
    while pos + 9_i64 <= Slice.Len(out) {
        FrameHeader h = Frame.ParseHeader(out, pos);
        if h.kind == kind && (h.flags & flags) == flags { n = n + 1_i64; }
        pos = pos + 9_i64 + h.length;
    }
    return n;
}

i64 GoAwayCode(u8[] out) { return Field32(out, Frame.TypeGoAway(), -1_i64, 4_i64); }
i64 GoAwayLast(u8[] out) { return Field32(out, Frame.TypeGoAway(), -1_i64, 0_i64); }
i64 RstCode(u8[] out, i64 id) { return Field32(out, Frame.TypeRstStream(), id, 0_i64); }

// ---- tests ----

test oversized_frame_is_frame_size_error {
    u8[] header = Slice.New(9_i64);
    Frame.PutHeader(header, 0_i64, 20000_i64, Frame.TypeData(), 0_i64, 1_i64);
    u8[] input = MemoryTransport.Join(Start(), header);
    Assert.Equal<i64>(GoAwayCode(Serve(input, Cfg())), FrameErrors.FrameSizeError(), "FRAME_SIZE_ERROR");
}

test missing_path_is_stream_protocol_error {
    Encoder enc = NewEnc();
    mut HeaderField[] f = Array.Empty<HeaderField>();
    Array.Append<HeaderField>(f, Hpack.Field(":method", "GET"));
    Array.Append<HeaderField>(f, Hpack.Field(":scheme", "http"));
    u8[] out = Serve(MemoryTransport.Join(Start(), Headers(enc, 1_i64, f, true)), Cfg());
    Assert.Equal<i64>(RstCode(out, 1_i64), FrameErrors.ProtocolError(), "RST_STREAM PROTOCOL_ERROR");
}

test pseudo_after_regular_is_stream_protocol_error {
    Encoder enc = NewEnc();
    mut HeaderField[] f = Array.Empty<HeaderField>();
    Array.Append<HeaderField>(f, Hpack.Field(":method", "GET"));
    Array.Append<HeaderField>(f, Hpack.Field("accept", "*/*"));
    Array.Append<HeaderField>(f, Hpack.Field(":scheme", "http"));
    Array.Append<HeaderField>(f, Hpack.Field(":path", "/"));
    u8[] out = Serve(MemoryTransport.Join(Start(), Headers(enc, 1_i64, f, true)), Cfg());
    Assert.Equal<i64>(RstCode(out, 1_i64), FrameErrors.ProtocolError(), "order");
}

test uppercase_and_connection_fields_rejected {
    Encoder enc = NewEnc();
    mut HeaderField[] upper = GetFields("/");
    Array.Append<HeaderField>(upper, Hpack.Field("Accept", "*/*"));
    mut HeaderField[] conn = GetFields("/");
    Array.Append<HeaderField>(conn, Hpack.Field("connection", "close"));
    u8[] a = MemoryTransport.Join(Start(), Headers(enc, 1_i64, upper, true));
    u8[] out = Serve(MemoryTransport.Join(a, Headers(enc, 3_i64, conn, true)), Cfg());
    Assert.Equal<i64>(RstCode(out, 1_i64), FrameErrors.ProtocolError(), "uppercase name");
    Assert.Equal<i64>(RstCode(out, 3_i64), FrameErrors.ProtocolError(), "connection header");
}

test te_other_than_trailers_rejected {
    Encoder enc = NewEnc();
    mut HeaderField[] f = GetFields("/");
    Array.Append<HeaderField>(f, Hpack.Field("te", "gzip"));
    u8[] out = Serve(MemoryTransport.Join(Start(), Headers(enc, 1_i64, f, true)), Cfg());
    Assert.Equal<i64>(RstCode(out, 1_i64), FrameErrors.ProtocolError(), "te: gzip");
}

test content_length_mismatch_rejected {
    Encoder enc = NewEnc();
    u8[] a = MemoryTransport.Join(Start(), Headers(enc, 1_i64, PostFields("5"), false));
    u8[] out = Serve(MemoryTransport.Join(a, Frame.DataFrame(1_i64, [1_u8, 2_u8], true)), Cfg());
    Assert.Equal<i64>(RstCode(out, 1_i64), FrameErrors.ProtocolError(), "2 != 5");
}

test continuation_interleaving_is_protocol_error {
    Encoder enc = NewEnc();
    u8[] block = HpackEncoder.Encode(enc, GetFields("/"));
    u8[] a = MemoryTransport.Join(Start(), Frame.HeadersFrame(1_i64, block, true, false));
    u8[] out = Serve(MemoryTransport.Join(a, Frame.PingFrame(Slice.New(8_i64), false)), Cfg());
    Assert.Equal<i64>(GoAwayCode(out), FrameErrors.ProtocolError(), "PING inside a header block");
}

test continuation_assembles_header_block {
    Encoder enc = NewEnc();
    u8[] block = HpackEncoder.Encode(enc, GetFields("/split"));
    i64 half = Slice.Len(block) / 2_i64;
    u8[] a = MemoryTransport.Join(Start(), Frame.HeadersFrame(1_i64, Slice.SubSlice(block, 0_i64, half), true, false));
    u8[] out = Serve(MemoryTransport.Join(a, Frame.ContinuationFrame(1_i64, Slice.SubSlice(block, half, Slice.Len(block) - half), true)), Cfg());
    Assert.Equal<i64>(Count(out, Frame.TypeData(), Frame.FlagEndStream()), 1_i64, "request served");
}

test window_update_overflow_is_flow_control_error {
    u8[] a = MemoryTransport.Join(Start(), Frame.WindowUpdateFrame(0_i64, 2147483647_i64));
    Assert.Equal<i64>(GoAwayCode(Serve(a, Cfg())), FrameErrors.FlowControlError(), "connection window overflow");
}

test concurrency_limit_refuses_stream {
    Encoder enc = NewEnc();
    Config c = Cfg();
    c.maxConcurrentStreams = 1_i64;
    u8[] a = MemoryTransport.Join(Start(), Headers(enc, 1_i64, PostFields("1"), false));
    u8[] out = Serve(MemoryTransport.Join(a, Headers(enc, 3_i64, PostFields("1"), false)), c);
    Assert.Equal<i64>(RstCode(out, 3_i64), FrameErrors.RefusedStream(), "REFUSED_STREAM");
    Assert.Equal<i64>(RstCode(out, 1_i64), -1_i64, "first stream stays");
}

test graceful_goaway_after_max_requests {
    Encoder enc = NewEnc();
    Config c = Cfg();
    c.maxRequests = 1_i64;
    u8[] out = Serve(MemoryTransport.Join(Start(), Headers(enc, 1_i64, GetFields("/"), true)), c);
    Assert.Equal<i64>(GoAwayCode(out), FrameErrors.NoError(), "NO_ERROR");
    Assert.Equal<i64>(GoAwayLast(out), 1_i64, "last stream id");
}

test data_on_idle_stream_is_protocol_error {
    u8[] input = MemoryTransport.Join(Start(), Frame.DataFrame(7_i64, [1_u8], false));
    Assert.Equal<i64>(GoAwayCode(Serve(input, Cfg())), FrameErrors.ProtocolError(), "idle stream");
}
