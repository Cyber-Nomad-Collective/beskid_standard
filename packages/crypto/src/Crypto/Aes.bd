                %k18 = load.i8x16 %ta17+176
                %v19 = band %r5, %c14
                %v20 = ishl %v19, %c10
                %ta21 = iadd %tp2, %v20
                %k22 = load.i8x16 %ta21+240
                %k23 = load.i8x16 %tp2+32
                %v24 = band %x6, %k23
                %v25 = band %x7, %k23
                %v26 = band %x8, %k23
                %v27 = band %x9, %k23
                %v28 = bxor %x6, %v24
                %v29 = bxor %x7, %v25
                %v30 = bxor %x8, %v26
                %v31 = bxor %x9, %v27
                %c32 = iconst.i32 4
