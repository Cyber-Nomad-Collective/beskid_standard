use Uri.Host;

/// A parsed URI reference (RFC 3986 section 4.1). Components keep their raw, still
/// percent-encoded text. Presence is explicit because "empty" and "absent" differ
/// (`http://h/p?` has an empty query, `http://h/p` has none).
/// `hostName` is stored as written; IP literals keep their brackets. `port` is -1 for an
/// empty port (`http://h:/`); `hasPort` tells whether a `:` was present.
pub type UriRef {
    pub bool hasScheme,
    pub string scheme,
    pub bool hasAuthority,
    pub bool hasUserinfo,
    pub string userinfo,
    pub string hostName,
    pub bool hasPort,
    pub i64 port,
    pub string path,
    pub bool hasQuery,
    pub string query,
    pub bool hasFragment,
    pub string fragment,
}

/// The network endpoint of a URI, ready for HTTP and connect code.
/// `hostName` has no brackets and is lowercase for registered names; `port` is always
/// the effective port (explicit or the scheme default).
pub type Authority {
    pub string hostName,
    pub HostKind kind,
    pub i64 port,
    pub bool secure,
}

/// A reference with every component absent: the empty reference.
pub UriRef Empty() {
    return UriRef {
        hasScheme: false, scheme: "", hasAuthority: false, hasUserinfo: false, userinfo: "",
        hostName: "", hasPort: false, port: -1_i64, path: "", hasQuery: false, query: "",
        hasFragment: false, fragment: "",
    };
}
