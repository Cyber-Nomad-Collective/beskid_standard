test calendar_agrees_with_reference_dates {
    i64[] days = ReferenceDays();
    string[] dates = ReferenceDates();
    mut i64 i = 0;
    while i < Array.Len<i64>(days) {
        i64 day = Array.Get<i64>(days, i);
        Expect.EqualString(Calendar.FormatDate(Calendar.CivilFromDays(day)), Array.Get<string>(dates, i), "civil date matches reference");
        Date parsed = match Calendar.ParseDate(Array.Get<string>(dates, i)) {
            Core.Results.Result::Ok(date) => date,
            Core.Results.Result::Error(_) => Date { year: 0, month: 0, day: 0 },
        };
        Expect.EqualI64(Calendar.ToDays(parsed), day, "reference date parses to its day number");
        i = i + 1;
    }
}

test calendar_instant_format_parse_round_trip {
    mut i64 seconds = -2000000000;
    while seconds < 4000000000 {
        Instant instant = Instant { nanos: seconds * 1000000000_i64 + 250000000_i64 };
        string text = Calendar.FormatInstant(instant);
        i64 back = match Calendar.ParseInstant(text) {
            Core.Results.Result::Ok(parsed) => parsed.nanos,
            Core.Results.Result::Error(_) => -1_i64,
        };
        Expect.EqualI64(back, instant.nanos, "RFC 3339 round trip");
        seconds = seconds + 86399999;
    }
}
