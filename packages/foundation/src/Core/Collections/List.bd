/// Growable list backed by typed `T[]` storage.
/// @tier(supported)
/// A list is a value: assigning it to a binding or a field, passing it to a parameter that is not
/// `mut`, returning it, capturing it or binding it in a `for` loop gives the new name its own list
/// (`[CopyOnAssign]` calls `Copy`). The copy is copy-on-write: both lists share the backing array
/// until one of them changes, and that one first copies the array. Read-only use copies nothing.
/// Mutating methods (`Push`, `Pop`, `Set`, `Insert`, `RemoveAt`, `Remove`, `Clear`) change the
/// list in place, so `items.Push("milk");` needs no rebinding. A `mut List<T>` parameter shares the
/// caller's list. Element equality (`Contains`, `IndexOf`, `Remove`) uses `==`, which compares
/// primitives and strings by value and other types by identity.
use Core.Collections.Array;
use Core.Collections.CollectionError;
use Core.Optional.Option;
use Core.Results;

/// The sharing state of one backing array: how many lists have held it. `List.Copy` raises it;
/// it never falls, so a list that held a shared array copies it on its next write even when the
/// other holders are gone.
[Isolated]
type ListShare {
    i64 holders,
}

ListShare Unshared() {
    return ListShare { holders: 1 };
}

[Isolated]
[CopyOnAssign]
pub type List<T> {
    T[] storage,
    i64 count,
    ListShare share,

    pub i64 Count() {
        return this.count;
    }

    pub bool IsEmpty() {
        return this.count == 0;
    }

    /// The backing array without a copy. Only the first `Count()` elements are valid, and the
    /// caller never writes through it: the array stays owned by this list.
    pub T[] BorrowStorage() {
        return this.storage;
    }

    /// A list holding the same elements. It shares the backing array, which is marked shared, so
    /// the first write through either list copies the array (copy-on-write). The compiler calls
    /// this method wherever a list gets a new name (`[CopyOnAssign]`).
    pub List<T> Copy() {
        this.share.holders = this.share.holders + 1;
        return List<T> { storage: this.storage, count: this.count, share: this.share };
    }

    /// Before a write in place: a shared backing array is copied, so the write is not visible
    /// through another list.
    unit Own(mut this) {
        if this.share.holders > 1 {
            this.storage = CopyPrefix<T>(this.storage, this.count);
            this.share = Unshared();
        }
        return;
    }

    /// Before the backing array is replaced by a new one: the list stops holding the shared one.
    unit Release(mut this) {
        if this.share.holders > 1 {
            this.share = Unshared();
        }
        return;
    }

    /// Appends `value`.
    pub unit Push(mut this, T value) {
        this.Own();
        Array.Append<T>(this.storage, value);
        this.count = this.count + 1;
        return;
    }

    /// Removes and returns the last element, or `None` when empty.
    pub Option<T> Pop(mut this) {
        if this.count == 0 {
            return Option::None;
        }
        this.Own();
        Option<T> last = Option::Some(Array.Get<T>(this.storage, this.count - 1));
        Array.RemoveLast<T>(this.storage);
        this.count = this.count - 1;
        return last;
    }

    pub Result<T, string> Get(i64 index) {
        if index < 0 || index >= this.count {
            return Result::Error("index out of range");
        }
        return Result::Ok(Array.Get<T>(this.storage, index));
    }

    /// Returns the element at `index`, or `None` when out of range.
    pub Option<T> TryGet(i64 index) {
        if index < 0 || index >= this.count {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, index));
    }

    /// Returns the first element, or `None` when empty.
    pub Option<T> First() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, 0));
    }

    /// Returns the last element, or `None` when empty.
    pub Option<T> Last() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.storage, this.count - 1));
    }

    /// Returns the index of the first element equal to `value`, or `-1`.
    pub i64 IndexOf(T value) {
        return IndexOfIn<T>(this.storage, this.count, value);
    }

    /// Returns true when an element equal to `value` is present.
    pub bool Contains(T value) {
        return IndexOfIn<T>(this.storage, this.count, value) >= 0;
    }

    /// Replaces the element at `index`.
    pub Result<unit, CollectionError> Set(mut this, i64 index, T value) {
        if index < 0 || index >= this.count {
            return Result::Error(CollectionError::IndexOutOfRange(index, this.count));
        }
        this.Own();
        Array.Set<T>(this.storage, index, value);
        return Result::Ok(());
    }

    /// Inserts `value` before `index`; `index == Count()` appends.
    pub Result<unit, CollectionError> Insert(mut this, i64 index, T value) {
        if index < 0 || index > this.count {
            return Result::Error(CollectionError::IndexOutOfRange(index, this.count));
        }
        this.Release();
        this.storage = InsertIn<T>(this.storage, this.count, index, value);
        this.count = this.count + 1;
        return Result::Ok(());
    }

    /// Removes and returns the element at `index`, shifting later elements left.
    pub Result<T, CollectionError> RemoveAt(mut this, i64 index) {
        if index < 0 || index >= this.count {
            return Result::Error(CollectionError::IndexOutOfRange(index, this.count));
        }
        Result<T, CollectionError> removed = Result::Ok(Array.Get<T>(this.storage, index));
        this.Release();
        this.storage = WithoutIndex<T>(this.storage, this.count, index);
        this.count = this.count - 1;
        return removed;
    }

    /// Removes the first element equal to `value`; returns false when it is absent.
    pub bool Remove(mut this, T value) {
        i64 index = IndexOfIn<T>(this.storage, this.count, value);
        if index < 0 {
            return false;
        }
        this.Release();
        this.storage = WithoutIndex<T>(this.storage, this.count, index);
        this.count = this.count - 1;
        return true;
    }

    /// Removes every element.
    pub unit Clear(mut this) {
        this.Release();
        this.storage = Array.Empty<T>();
        this.count = 0;
        return;
    }

    /// Returns a new list with the elements in reverse order.
    pub List<T> Reverse() {
        return ReverseIn<T>(this.storage, this.count);
    }

    /// Returns up to `length` elements starting at `start`, clamped to the list bounds.
    pub List<T> Slice(i64 start, i64 length) {
        return SliceIn<T>(this.storage, this.count, start, length);
    }

    /// Returns a new list with every element of `other` appended after this list's elements.
    pub List<T> Concat(List<T> other) {
        return ConcatIn<T>(this.storage, this.count, other.storage, other.count);
    }

    /// Copies the elements into a new array of exactly `Count()` elements.
    pub T[] ToArray() {
        return CopyPrefix<T>(this.storage, this.count);
    }
}

pub List<T> New<T>() {
    return List<T> { storage: Array.Empty<T>(), count: 0, share: Unshared() };
}

/// Bulk constructor: packs call-site scalars into a list.
/// Iterates the bulk array and appends each value with `List.Push`.
pub List<T> Of<T>(bulk T[] values) {
    List<T> result = New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result.Push(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}

/// Builds a list holding a copy of every element of `values`.
pub List<T> FromArray<T>(T[] values) {
    i64 count = Array.Len<T>(values);
    return List<T> { storage: CopyPrefix<T>(values, count), count: count, share: Unshared() };
}

T[] CopyPrefix<T>(T[] source, i64 count) {
    mut T[] copy = Array.Empty<T>();
    mut i64 i = 0;
    while i < count {
        Array.Append<T>(copy, Array.Get<T>(source, i));
        i = i + 1;
    }
    return copy;
}

i64 IndexOfIn<T>(T[] storage, i64 count, T value) {
    mut i64 i = 0;
    while i < count {
        if Array.Get<T>(storage, i) == value {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Storage holding the first `count` elements of `storage` with `value` inserted before `index`.
T[] InsertIn<T>(T[] storage, i64 count, i64 index, T value) {
    mut T[] next = Array.Empty<T>();
    mut i64 i = 0;
    while i < count {
        if i == index {
            Array.Append<T>(next, value);
        }
        Array.Append<T>(next, Array.Get<T>(storage, i));
        i = i + 1;
    }
    if index == count {
        Array.Append<T>(next, value);
    }
    return next;
}

/// Storage holding the first `count` elements of `storage` without the one at `index`.
T[] WithoutIndex<T>(T[] storage, i64 count, i64 index) {
    mut T[] next = Array.Empty<T>();
    mut i64 i = 0;
    while i < count {
        if i != index {
            Array.Append<T>(next, Array.Get<T>(storage, i));
        }
        i = i + 1;
    }
    return next;
}

List<T> ReverseIn<T>(T[] storage, i64 count) {
    mut T[] next = Array.Empty<T>();
    mut i64 i = count - 1;
    while i >= 0 {
        Array.Append<T>(next, Array.Get<T>(storage, i));
        i = i - 1;
    }
    return List<T> { storage: next, count: count, share: Unshared() };
}

List<T> SliceIn<T>(T[] storage, i64 count, i64 start, i64 length) {
    mut i64 from = start;
    if from < 0 {
        from = 0;
    }
    mut i64 to = from + length;
    if length < 0 {
        to = from;
    }
    if to > count {
        to = count;
    }
    mut T[] next = Array.Empty<T>();
    mut i64 i = from;
    while i < to {
        Array.Append<T>(next, Array.Get<T>(storage, i));
        i = i + 1;
    }
    mut i64 taken = to - from;
    if taken < 0 {
        taken = 0;
    }
    return List<T> { storage: next, count: taken, share: Unshared() };
}

List<T> ConcatIn<T>(T[] left, i64 leftCount, T[] right, i64 rightCount) {
    mut T[] next = CopyPrefix<T>(left, leftCount);
    mut i64 i = 0;
    while i < rightCount {
        Array.Append<T>(next, Array.Get<T>(right, i));
        i = i + 1;
    }
    return List<T> { storage: next, count: leftCount + rightCount, share: Unshared() };
}
