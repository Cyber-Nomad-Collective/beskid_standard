/// Progress bar clamping, render, and incremental cursor output.

use Console.Controls.LiveTick;
use Console.Controls.ProgressBar;
use Testing.Assert;



test progress_bar_clamps_percent {
    ProgressBar.ProgressBar bar = ProgressBar.ProgressBar.WithPercent(
        ProgressBar.ProgressBar.New(),
        150
    );
    Assert.Equal(bar.percent, 100_i64, "expected percent clamped to 100");
    ProgressBar.ProgressBar low = ProgressBar.ProgressBar.WithPercent(
        ProgressBar.ProgressBar.New(),
        -5_i64
    );
    Assert.Equal(low.percent, 0_i64, "expected percent clamped to 0");
}

test progress_bar_renders_body_with_exact_fill {
    ProgressBar.ProgressBar bar = ProgressBar.ProgressBar.WithPercent(
        ProgressBar.ProgressBar.New(),
        50_i64
    );
    string rendered = ProgressBar.BarBody(bar, 10);
    Assert.True(
        rendered == "[====    ] 50%",
        "expected progress bar fill to match the requested width"
    );
}
