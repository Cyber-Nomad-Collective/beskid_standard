use Core.Collections.Array;
use Core.Optional.Option;
use Http.Types;
use Http2.Connection;
use Tls.TlsConfig;

// Client and server policy of the Web facade. Fields are plain values: build a
// default and assign the fields that differ (`config.alpn = ...`).

// HTTP/3 use for https:// requests (RFC 9114 over QUIC, ALPN "h3", same trust
// policy as TCP). `Prefer` tries QUIC first, within `http3HandshakeMillis`, and
// falls back to TLS over TCP (ALPN `alpn`) when name resolution, the QUIC
// handshake or the "h3" negotiation fails. Once the QUIC handshake succeeded the
// request is not retried over TCP (it may have reached the server). `Only` never
// uses TCP and fails with WebError::Http3Failed. http:// URLs ignore the mode.
pub enum Http3Mode {
    Off(),
    Prefer(),
    Only(),
}

pub bool UsesHttp3(Http3Mode mode) {
    return match mode { Http3Mode::Off => false, _ => true, };
}

pub bool Http3Only(Http3Mode mode) {
    return match mode { Http3Mode::Only => true, _ => false, };
}

pub type WebClientConfig {
    // ALPN protocols offered over TLS, in preference order ("h2", "http/1.1").
    pub string[] alpn,
    // Certificate trust; empty means the system bundle (loaded per request,
    // fail closed when it is missing or empty).
    pub Option<CertificateVerification> trust,
    // http:// URLs speak HTTP/2 with prior knowledge (RFC 9113 section 3.3).
    pub bool h2cPriorKnowledge,
    // Deadline for Happy Eyeballs plus the TLS handshake.
    pub i64 connectTimeoutMillis,
    // Read and write deadline for the exchange after the handshake; 0 = none.
    pub i64 requestTimeoutMillis,
    // HTTP/1.1 message limits (corelib Http.Types).
    pub Limits limits,
    // HTTP/2 settings and limits (scheme is set per request).
    pub Config h2,
    pub Http3Mode http3,
    // Budget for the QUIC handshakes of one request (all resolved addresses
    // together); after it `Prefer` falls back to TCP.
    pub i64 http3HandshakeMillis,
}

pub type WebServerConfig {
    // HTTP/2 settings and limits.
    pub Config h2,
    // HTTP/1.1 message limits.
    pub Limits limits,
    // ServePlain: detect the HTTP/2 connection preface and serve h2c.
    pub bool h2cPriorKnowledge,
    // Deadline for the TLS handshake.
    pub i64 handshakeTimeoutMillis,
    // Deadline for each accept; 0 waits without a deadline.
    pub i64 acceptTimeoutMillis,
    // HTTP/1.1: deadline for the next request on a kept-alive connection.
    pub i64 idleTimeoutMillis,
    // Connections to serve before returning; 0 = until accept fails.
    pub i64 maxConnections,
    // HTTP/1.1 requests per connection; 0 = unlimited.
    pub i64 maxRequestsPerConnection,
}

// Body limit shared by the HTTP/1.1 and HTTP/2 defaults: the 0.5.2 runtime
// holds about 160 KiB of live arrays per process (COMPILER-GAPS W5).
pub i64 DefaultMaxBodyBytes() { return 131072_i64; }

pub Limits DefaultLimits() {
    return Limits { maxStartLine: 8192_i64, maxHeaderBytes: 16384_i64, maxHeaders: 128_i64, maxBodyBytes: DefaultMaxBodyBytes() };
}

pub string[] DefaultAlpn() {
    mut string[] out = Array.Empty<string>();
    Array.Append<string>(out, "h2");
    Array.Append<string>(out, "http/1.1");
    return out;
}

// Short enough that an origin without HTTP/3 costs at most about a second.
pub i64 DefaultHttp3HandshakeMillis() { return 1000_i64; }

pub WebClientConfig DefaultClient() {
    Config h2 = Connection.DefaultConfig();
    h2.maxBodyBytes = DefaultMaxBodyBytes();
    return WebClientConfig {
        alpn: DefaultAlpn(),
        trust: Option.Empty<CertificateVerification>(),
        h2cPriorKnowledge: false,
        connectTimeoutMillis: 10000_i64,
        requestTimeoutMillis: 30000_i64,
        limits: DefaultLimits(),
        h2: h2,
        http3: Http3Mode::Off(),
        http3HandshakeMillis: DefaultHttp3HandshakeMillis(),
    };
}

pub WebServerConfig DefaultServer() {
    Config h2 = Connection.DefaultConfig();
    h2.maxBodyBytes = DefaultMaxBodyBytes();
    h2.timeoutMillis = 10000_i64;
    return WebServerConfig {
        h2: h2,
        limits: DefaultLimits(),
        h2cPriorKnowledge: true,
        handshakeTimeoutMillis: 10000_i64,
        acceptTimeoutMillis: 0_i64,
        idleTimeoutMillis: 15000_i64,
        maxConnections: 0_i64,
        maxRequestsPerConnection: 0_i64,
    };
}

// A TLS server configuration offering "h2" and "http/1.1" (server preference order).
pub TlsServerConfig ServerTls(Blob[] certificateChain, u8[] privateKey) {
    mut TlsServerConfig config = TlsConfig.Server(certificateChain, privateKey);
    config.alpn = DefaultAlpn();
    return config;
}
