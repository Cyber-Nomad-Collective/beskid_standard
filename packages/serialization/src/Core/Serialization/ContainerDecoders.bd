use Core.Collections.Array;
use Core.Collections.List;
use Core.Collections.Map;
use Core.Optional.Option;
use Core.Results;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Reader as ReaderApi;

// Canonical container field reads. The field decoder correspondence issues these
// exact functions for an abstract field whose current application is an array or a
// canonical Foundation List, string-key Map or Option. Each element is read through
// the same compiler-issued correspondence for its own exact application.

Result<unit, SerializationError> Count<R>(R reader, i64 count, SerializationLimits limits) where R: ReaderApi.Reader {
    if (count < 0_i64 || count > limits.maxNodes) {
        ReaderApi.SourceLocation location = reader.Location();
        return Result::Error(Errors.Diagnostic("CollectionLimit", location.path, location.start, location.end, false, -1_i64, -1_i64));
    }
    return Result::Ok(());
}

pub Result<T[], SerializationError> ReadArray<T, R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader {
    i64 count = reader.BeginSequence()?;
    Count<R>(reader, count, limits)?;
    mut T[] values = [];
    mut i64 index = 0_i64;
    while (index < count) {
        T value = ReaderApi.ReadField<T, R>(reader, limits)?;
        values = Array.Append<T>(values, value);
        index = index + 1_i64;
    }
    reader.EndSequence()?;
    return Result::Ok(values);
}

pub Result<List<T>, SerializationError> ReadList<T, R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader {
    i64 count = reader.BeginSequence()?;
    Count<R>(reader, count, limits)?;
    List<T> values = List.New<T>();
    mut i64 index = 0_i64;
    while (index < count) {
        values.Push(ReaderApi.ReadField<T, R>(reader, limits)?);
        index = index + 1_i64;
    }
    reader.EndSequence()?;
    return Result::Ok(values);
}

pub Result<Map<string, T>, SerializationError> ReadMap<T, R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader {
    i64 count = reader.BeginMap()?;
    Count<R>(reader, count, limits)?;
    Map<string, T> values = Map.New<string, T>();
    mut i64 index = 0_i64;
    while (index < count) {
        string key = reader.BeginMapEntry()?;
        if (values.ContainsKey(key)) {
            ReaderApi.SourceLocation location = reader.Location();
            return Result::Error(Errors.Diagnostic("DuplicateKey", location.path, location.start, location.end, false, -1_i64, -1_i64));
        }
        T value = ReaderApi.ReadField<T, R>(reader, limits)?;
        reader.EndMapEntry()?;
        values.Insert(key, value);
        index = index + 1_i64;
    }
    reader.EndMap()?;
    return Result::Ok(values);
}

pub Result<Option<T>, SerializationError> ReadOptional<T, R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader {
    bool present = reader.BeginOptional()?;
    mut Option<T> value = Option::None;
    if (present) { value = Option::Some(ReaderApi.ReadField<T, R>(reader, limits)?); }
    reader.EndOptional()?;
    return Result::Ok(value);
}
