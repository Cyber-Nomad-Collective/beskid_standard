use Core.Bytes.Convert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Time;
use Core.Time.Instant;
use Testing.Assert;


test bytes_new_has_length {
    u8[] buf = Slice.New(4);
    i64 len = Slice.Len(buf);
    Assert.Equal(len, 4, "bytes New length mismatch");
}

test bytes_from_string_matches_utf8_length {
    u8[] buf = Convert.StringToBytes("abc");
    Assert.Equal(Slice.Len(buf), 3, "StringToBytes byte length");
    Assert.Equal(Slice.Get(buf, 0), 97, "first byte");
}

test bytes_fill_sets_range {
    u8[] buf = Slice.New(4);
    Slice.Fill(buf, 0, 4, 42);
    Assert.Equal(Slice.Get(buf, 0), 42, "Fill first byte");
    Assert.Equal(Slice.Get(buf, 3), 42, "Fill last byte");
}

test bytes_subslice_copies_window {
    u8[] buf = Convert.StringToBytes("hello");
    u8[] sub = Slice.SubSlice(buf, 1, 3);
    Assert.Equal(Slice.Len(sub), 3, "SubSlice length");
    Assert.Equal(Slice.Get(sub, 0), 101, "SubSlice first byte is e");
}

test bytes_compare_lexicographic {
    u8[] left = Convert.StringToBytes("abc");
    u8[] right = Convert.StringToBytes("abd");
    Assert.Equal(Slice.Compare(left, right), -1, "Compare less");
}

test bytes_copy_range {
    u8[] dst = Slice.New(3);
    u8[] src = Convert.StringToBytes("xyz");
    Slice.Copy(dst, 0, src, 0, 3);
    Assert.Equal(Slice.Get(dst, 2), 122, "Copy third byte");
}

i64 ElapsedNanos(Instant start) {
    Instant now = Time.MonotonicNow();
    return now.nanos - start.nanos;
}

// PERF1 / C53-5: Slice.New is one zeroed allocation, not one append per byte.
test bytes_new_one_mebibyte_is_one_zeroed_allocation {
    Instant start = Time.MonotonicNow();
    u8[] buf = Slice.New(1048576);
    i64 elapsed = ElapsedNanos(start);
    Assert.Equal(Slice.Len(buf), 1048576, "1 MiB length");
    Assert.Equal(Array.Capacity<u8>(buf), 1048576, "sized allocation has exact capacity");
    Assert.Equal(Slice.Get(buf, 0), 0, "first byte is zero");
    Assert.Equal(Slice.Get(buf, 524288), 0, "middle byte is zero");
    Assert.Equal(Slice.Get(buf, 1048575), 0, "last byte is zero");
    Assert.True(elapsed < 50000000, "Slice.New(1 MiB) takes less than 50 ms");
}

test bytes_new_non_positive_length_is_empty {
    Assert.Equal(Slice.Len(Slice.New(0)), 0, "zero length");
    Assert.Equal(Slice.Len(Slice.New(-5)), 0, "negative length");
}

// A 4 MiB buffer stays live and intact through 16 KiB churn and forced collections.
test bytes_four_mebibyte_live_buffer_survives_churn {
    u8[] big = Slice.New(4194304);
    mut i64 i = 0;
    while i < 4194304 {
        i64 value = i % 251;
        big[i] = u8(value);
        i = i + 4099;
    }
    mut i64 round = 0;
    while round < 1000 {
        u8[] scratch = Slice.New(16384);
        i64 marker = round % 256;
        scratch[16383] = u8(marker);
        Assert.Equal(Slice.Get(scratch, 0), 0, "fresh scratch is zeroed");
        round = round + 1;
    }
    Assert.CollectGarbage();
    i = 0;
    while i < 4194304 {
        u8 stored = big[i];
        i64 expected = i % 251;
        i64 storedWide = i64(stored);
        Assert.Equal(storedWide, expected, "live 4 MiB buffer keeps its contents");
        i = i + 4099;
    }
}

// HQ3 / W5: three live 64 KiB buffers plus repeated 16-20 KiB garbage stay far below the cap.
test bytes_three_live_64k_buffers_with_garbage_do_not_exhaust_heap {
    u8[] a = Slice.New(65536);
    u8[] b = Slice.New(65536);
    u8[] c = Slice.New(65536);
    a[65535] = 1_u8;
    b[65535] = 2_u8;
    c[65535] = 3_u8;
    mut i64 round = 0;
    while round < 1000 {
        u8[] x = Slice.New(16384);
        u8[] y = Slice.New(20000);
        u8[] z = Slice.New(18432);
        x[0] = 1_u8;
        y[0] = 1_u8;
        z[0] = 1_u8;
        if round % 250 == 0 { Assert.CollectGarbage(); }
        round = round + 1;
    }
    Assert.CollectGarbage();
    u8 lastA = a[65535];
    u8 lastB = b[65535];
    u8 lastC = c[65535];
    i64 sum = i64(lastA) + i64(lastB) + i64(lastC);
    Assert.Equal(sum, 6, "live 64 KiB buffers keep their contents");
}
