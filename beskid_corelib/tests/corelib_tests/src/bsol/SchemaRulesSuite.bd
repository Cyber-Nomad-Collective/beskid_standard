// ---- SchemaConstraintTests.bd (formerly target `BsolSchemaConstraintTests`) ----

/// Shared native/Rust constraint cases. Runner supplies the common corpus root.









string ReadCase(string name)
{
    match Environment.Get("BESKID_BSOL_CORPUS")
    {
        Result::Error(_) => {
            Assert.Fail("shared corpus root required");
            return "";
        },

        Result::Ok(directory) => match FS.ReadAllText(directory + "/cases/schema-constraints/" + name + ".bsol")
        {
            Result::Error(_) => {
                Assert.Fail("shared constraint case must be readable");
                return "";
            },

            Result::Ok(source) => {
                return source;
            },
        },
    };
}

Result<Schema.ValidatedDocument, Schema.Diagnostic[]> CheckCase(string name)
{
    match Schema.ParseProfile(ReadCase("profile"), Limits.DefaultLimits())
    {
        Result::Error(errors) => {
            return Result::Error(errors);
        },

        Result::Ok(profile) => match Parser.Parse(ReadCase(name), Limits.DefaultLimits())
        {
            Result::Error(_) => {
                Assert.Fail("shared constraint input syntax valid");
                return Result::Error(Array.Empty<Schema.Diagnostic>());
            },

            Result::Ok(document) => {
                return Schema.Validate(document, profile, Limits.DefaultLimits());
            },
        },
    };
}

unit CheckBoundValue(Schema.ValidatedDocument document, string name, string expected, bool defaulted, bool numeric)
{
    mut bool found = false;
    mut i64 i = 0_i64;
    while (i < Array.Len<Schema.FieldBinding>(document.fields))
    {
        Schema.FieldBinding binding = document.fields[i];
        Schema.Field field = document.schema.rules[binding.rule].fields[binding.field];
        if (field.name == name)
        {
            found = true;
            Assert.Equal(binding.fromDefault, defaulted, "default applies only to absent fields");
            if (numeric)
            {
                Assert.True(match binding.value.kind
                {
                    Syntax.NodeKind::Number => true,

                    _ => false,
                }, "default remains a typed number");
                Assert.Equal(binding.value.raw, expected, "exact numeric raw value retained");
            }
            else
            {
                Assert.True(match binding.value.kind
                {
                    Syntax.NodeKind::String => true,

                    _ => false,
                }, "default remains a typed quoted value");
                Assert.Equal(binding.value.text, expected, "checked string value retained");
            }
        }
        i = i + 1_i64;
    }
    Assert.True(found, "checked declared field binding available to typed mapping");
}

unit RejectCase(string name, string code, string field)
{
    match CheckCase(name)
    {
        Result::Ok(_) => Assert.Fail("invalid constraint input rejects"),

        Result::Error(errors) => {
            mut bool found = false;
            mut i64 i = 0_i64;
            while (i < Array.Len<Schema.Diagnostic>(errors))
            {
                Schema.Diagnostic error = errors[i];
                if (error.code == code && error.field == field)
                {
                    found = true;
                    Assert.True(match error.stage
                    {
                        Schema.DiagnosticStage::Validation => true,

                        _ => false,
                    }, "constraint rejection owns validation stage");
                    Assert.Equal(error.profile, "constraints.v2", "active profile identity retained");
                }
                i = i + 1_i64;
            }
            Assert.True(found, "exact shared rejection category and field retained");
        },
    };
}

/// @native-only
test BsolSchemaMissingOnlyDefaultsRemainTyped
{
    match CheckCase("defaults")
    {
        Result::Error(_) => Assert.Fail("valid defaults satisfy declared required field and variant payload"),

        Result::Ok(document) => {
            CheckBoundValue(document, "count", "3", true, true);
            CheckBoundValue(document, "name", "default-name", true, false);
            CheckBoundValue(document, "rev", "head", true, false);
        },
    };
}

/// @native-only
test BsolSchemaSuppliedValuesOverrideDefaultsAtNumericBoundary
{
    match CheckCase("override")
    {
        Result::Error(_) => Assert.Fail("declared max boundary and explicit values validate"),

        Result::Ok(document) => {
            CheckBoundValue(document, "count", "5", false, true);
            CheckBoundValue(document, "name", "explicit", false, false);
            CheckBoundValue(document, "rev", "exact", false, false);
        },
    };
}

