use Core.Bytes.Slice;
use Core.Disposable;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Internal;
use Network.Internal.Resources;

use Network.Tcp.TcpStream;

/// Owns a generation-tagged runtime handle; there is no public handle constructor.
/// One Accept may wait at a time. A competing Accept returns Busy.
pub type TcpListener: Disposable {
    word handle,

    pub Result<TcpStream, NetworkError> Accept() {
        return Resources.AcceptTcpStream(handle);
    }

    pub Result<SocketAddress, NetworkError> LocalAddress() {
        return Internal.Address(handle, false);
    }

    pub Result<unit, NetworkError> Close() {
        return Internal.Status(i64(Internal.Close(handle)));
    }

    pub Result<unit, DisposeError> Dispose() { return Internal.Dispose(handle); }
}

pub Result<TcpListener, NetworkError> Bind(SocketAddress address, i64 backlog) {
    return Resources.BindTcpListener(address, backlog);
}
