/// Certification path building and validation (RFC 5280 section 6, server profile).
///
/// `Verify` searches depth first from the leaf through the supplied intermediates to a
/// trust anchor. An issuer candidate must have a subject equal (DER) to the child's
/// issuer, a matching key identifier when both are present, and a public key that
/// verifies the child's signature. A complete candidate path is then checked:
/// - validity of every certificate at `VerifyOptions.time` (anchors have no validity),
/// - every intermediate is a CA (basicConstraints cA) with keyCertSign when keyUsage is
///   present, and pathLenConstraint holds for intermediates and the anchor,
/// - extended key usage: the leaf, and intermediates that carry the extension, allow
///   serverAuth (or anyExtendedKeyUsage); the leaf keyUsage, when present, allows
///   digitalSignature,
/// - dNSName and iPAddress nameConstraints of the anchor and intermediates; other name
///   forms in a constraint fail closed with UnsupportedNameConstraint,
/// - the host name (RFC 9525) when `serverName` is not empty.
/// If no path validates, the most specific error seen is returned (UnknownIssuer when no
/// issuer candidate was found at all). No revocation checking is done.
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Core.String;
use X509.Certificate;
use X509.Der;
use X509.Hostname;
use X509.Names;
use X509.Signature;
use X509.TrustStore;
use X509.X509Errors;

pub type VerifyOptions {
    /// Validation time in seconds since the Unix epoch.
    pub i64 time,
    /// DNS name or IP literal to match against the leaf; empty skips the check.
    pub string serverName,
    /// Maximum number of intermediates between the leaf and the anchor.
    pub i64 maxIntermediates,
    /// Require serverAuth EKU and digitalSignature key usage on the leaf.
    pub bool requireServerAuth,
}

/// Server-certificate defaults: at most 6 intermediates, serverAuth required.
pub VerifyOptions ServerOptions(i64 time, string serverName) {
    return VerifyOptions { time: time, serverName: serverName, maxIntermediates: 6_i64, requireServerAuth: true };
}

pub VerifyOptions WithMaxIntermediates(VerifyOptions o, i64 value) {
    return VerifyOptions { time: o.time, serverName: o.serverName, maxIntermediates: value, requireServerAuth: o.requireServerAuth };
}

/// A validated path: the leaf followed by the intermediates used, and the anchor.
pub type VerifiedChain {
    pub Certificate[] certificates,
    pub TrustAnchor anchor,
}

type Search {
    Certificate leaf,
    Certificate[] intermediates,
    TrustStore store,
    VerifyOptions options,
    /// Indexes into `intermediates` of the current path, leaf side first.
    i64[] path,
    /// 1 for intermediates on the current path.
    i64[] used,
    /// [0] depth of the found path, [1] anchor index, [2] 1 when a path was found.
    i64[] found,
    /// [0] the most specific error so far.
    X509Error[] best,
}

i64 Rank(X509Error e) {
    return match e {
        X509Error::None => 0_i64,
        X509Error::UnknownIssuer => 1_i64,
        X509Error::ChainTooLong => 2_i64,
        _ => 3_i64,
    };
}

unit Record(Search s, X509Error e) {
    X509Error current = s.best[0];
    if Rank(e) > Rank(current) { s.best[0] = e; }
    return;
}

bool IsNone(X509Error e) {
    return match e { X509Error::None => true, _ => false, };
}

/// Certificate `k` of the current path: 0 is the leaf.
Certificate At(Search s, i64 k) {
    if k == 0_i64 { return s.leaf; }
    return s.intermediates[s.path[k - 1_i64]];
}

/// True unless both key identifiers are present and differ.
bool KeyIdsAgree(u8[] authorityKeyId, u8[] subjectKeyId) {
    if Slice.Len(authorityKeyId) == 0_i64 || Slice.Len(subjectKeyId) == 0_i64 { return true; }
    return Der.BytesEqual(authorityKeyId, subjectKeyId);
}

/// Number of non-self-issued certificates among path positions 1..k-1.
i64 IntermediatesBelow(Search s, i64 k) {
    mut i64 count = 0_i64;
    mut i64 j = 1_i64;
    while j < k {
        if !Certificate.IsSelfIssued(At(s, j)) { count = count + 1_i64; }
        j = j + 1_i64;
    }
    return count;
}

bool DnsWithin(string name, string constraint) {
    if constraint == "" { return true; }
    if String.ByteAt(constraint, 0_i64) == 46_u8 {
        i64 n = String.Len(name);
        i64 c = String.Len(constraint);
        return n > c && String.SubSlice(name, n - c, c) == constraint;
    }
    if name == constraint { return true; }
    i64 n2 = String.Len(name);
    i64 c2 = String.Len(constraint);
    return n2 > c2 + 1_i64 && String.SubSlice(name, n2 - c2 - 1_i64, c2 + 1_i64) == "." + constraint;
}

bool DnsAllowed(NameConstraints nc, string rawName) {
    string name = Hostname.Normalize(rawName);
    mut i64 i = 0_i64;
    while i < Array.Len<string>(nc.excludedDns) {
        if DnsWithin(name, nc.excludedDns[i]) { return false; }
        i = i + 1_i64;
    }
    if Array.Len<string>(nc.permittedDns) == 0_i64 { return true; }
    i = 0_i64;
    while i < Array.Len<string>(nc.permittedDns) {
        if DnsWithin(name, nc.permittedDns[i]) { return true; }
        i = i + 1_i64;
    }
    return false;
}

bool IpWithin(u8[] ip, u8[] range) {
    i64 n = Slice.Len(ip);
    if Slice.Len(range) != n * 2_i64 { return false; }
    mut i64 i = 0_i64;
    while i < n {
        u8 mask = range[n + i];
        if (ip[i] & mask) != (range[i] & mask) { return false; }
        i = i + 1_i64;
    }
    return true;
}

bool IpAllowed(NameConstraints nc, u8[] ip) {
    mut i64 i = 0_i64;
    while i < Array.Len<IpBytes>(nc.excludedIp) {
        IpBytes r = nc.excludedIp[i];
        if IpWithin(ip, r.bytes) { return false; }
        i = i + 1_i64;
    }
    mut bool sameFamily = false;
    i = 0_i64;
    while i < Array.Len<IpBytes>(nc.permittedIp) {
        IpBytes p = nc.permittedIp[i];
        if Slice.Len(p.bytes) == Slice.Len(ip) * 2_i64 {
            sameFamily = true;
            if IpWithin(ip, p.bytes) { return true; }
        }
        i = i + 1_i64;
    }
    return !sameFamily;
}

/// Applies one nameConstraints extension to one certificate's names.
pub X509Error CheckNameConstraints(NameConstraints nc, Certificate cert, bool isLeaf) {
    if !nc.present { return X509Error::None; }
    if nc.hasUnsupportedForm { return X509Error::UnsupportedNameConstraint; }
    Extensions ext = cert.extensions;
    mut i64 i = 0_i64;
    while i < Array.Len<string>(ext.dnsNames) {
        if !DnsAllowed(nc, ext.dnsNames[i]) { return X509Error::NameConstraintViolation; }
        i = i + 1_i64;
    }
    i = 0_i64;
    while i < Array.Len<IpBytes>(ext.ipAddresses) {
        IpBytes ip = ext.ipAddresses[i];
        if !IpAllowed(nc, ip.bytes) { return X509Error::NameConstraintViolation; }
        i = i + 1_i64;
    }
    // A leaf without subjectAltName may be matched by its common name, so constrain it too.
    DistinguishedName subject = cert.subject;
    string cn = subject.commonName;
    if isLeaf && !ext.hasSubjectAltName && Hostname.IsValidDnsName(Hostname.Normalize(cn)) {
        if !DnsAllowed(nc, cn) { return X509Error::NameConstraintViolation; }
    }
    return X509Error::None;
}

/// Name constraints of the certificate at `issuerPos` (or the anchor when it is
/// `depth + 1`) applied to every certificate below it.
X509Error ConstraintsBelow(Search s, NameConstraints nc, i64 issuerPos) {
    if !nc.present { return X509Error::None; }
    mut i64 j = 0_i64;
    while j < issuerPos {
        Certificate c = At(s, j);
        if j == 0_i64 || !Certificate.IsSelfIssued(c) {
            X509Error e = CheckNameConstraints(nc, c, j == 0_i64);
            if !IsNone(e) { return e; }
        }
        j = j + 1_i64;
    }
    return X509Error::None;
}

bool AllowsServerAuth(Extensions ext) {
    return !ext.hasExtKeyUsage || ext.ekuServerAuth || ext.ekuAny;
}

/// Validates the path leaf, intermediates path[0..depth), anchor `anchorIndex`.
X509Error ValidatePath(Search s, i64 depth, i64 anchorIndex) {
    VerifyOptions o = s.options;
    i64 t = o.time;
    mut i64 k = 0_i64;
    while k <= depth {
        Certificate c = At(s, k);
        if t < c.notBefore || t > c.notAfter { return X509Error::Expired; }
        k = k + 1_i64;
    }
    k = 1_i64;
    while k <= depth {
        Certificate ca = At(s, k);
        Extensions ext = ca.extensions;
        if !ext.hasBasicConstraints || !ext.isCa { return X509Error::NotCa; }
        if ext.hasKeyUsage && (ext.keyUsage & Certificate.KeyUsageKeyCertSign()) == 0_i64 { return X509Error::BadKeyUsage; }
        if ext.pathLen >= 0_i64 && IntermediatesBelow(s, k) > ext.pathLen { return X509Error::PathLengthExceeded; }
        if o.requireServerAuth && !AllowsServerAuth(ext) { return X509Error::BadExtendedKeyUsage; }
        X509Error ncError = ConstraintsBelow(s, ext.nameConstraints, k);
        if !IsNone(ncError) { return ncError; }
        k = k + 1_i64;
    }
    TrustStore store = s.store;
    TrustAnchor anchor = store.anchors[anchorIndex];
    if anchor.pathLen >= 0_i64 && IntermediatesBelow(s, depth + 1_i64) > anchor.pathLen { return X509Error::PathLengthExceeded; }
    X509Error anchorNc = ConstraintsBelow(s, anchor.nameConstraints, depth + 1_i64);
    if !IsNone(anchorNc) { return anchorNc; }
    Certificate leaf = s.leaf;
    Extensions leafExt = leaf.extensions;
    if o.requireServerAuth {
        if !AllowsServerAuth(leafExt) { return X509Error::BadExtendedKeyUsage; }
        if leafExt.hasKeyUsage && (leafExt.keyUsage & Certificate.KeyUsageDigitalSignature()) == 0_i64 { return X509Error::BadKeyUsage; }
    }
    if o.serverName != "" { return Hostname.VerifyHostname(leaf, o.serverName); }
    return X509Error::None;
}

/// Depth-first search for an issuer of `current`, which sits at path position `depth`.
bool Extend(Search s, Certificate current, i64 depth) {
    DistinguishedName issuer = current.issuer;
    Extensions ext = current.extensions;
    TrustStore store = s.store;
    i64 anchors = TrustStore.Count(store);
    mut i64 i = 0_i64;
    while i < anchors {
        TrustAnchor a = store.anchors[i];
        if Names.Equal(a.subject, issuer) && KeyIdsAgree(ext.authorityKeyId, a.subjectKeyId) {
            X509Error sig = Signature.VerifySignature(current, a.publicKey);
            if IsNone(sig) {
                X509Error v = ValidatePath(s, depth, i);
                if IsNone(v) {
                    s.found[0] = depth;
                    s.found[1] = i;
                    s.found[2] = 1_i64;
                    return true;
                }
                Record(s, v);
            } else {
                Record(s, sig);
            }
        }
        i = i + 1_i64;
    }
    VerifyOptions o = s.options;
    i64 count = Array.Len<Certificate>(s.intermediates);
    mut i64 j = 0_i64;
    while j < count {
        Certificate candidate = s.intermediates[j];
        Extensions cext = candidate.extensions;
        if s.used[j] == 0_i64 && Names.Equal(candidate.subject, issuer) && KeyIdsAgree(ext.authorityKeyId, cext.subjectKeyId) {
            if depth >= o.maxIntermediates {
                Record(s, X509Error::ChainTooLong);
            } else {
                X509Error sig2 = Signature.VerifySignature(current, candidate.publicKey);
                if IsNone(sig2) {
                    s.used[j] = 1_i64;
                    s.path[depth] = j;
                    if Extend(s, candidate, depth + 1_i64) { return true; }
                    s.used[j] = 0_i64;
                } else {
                    Record(s, sig2);
                }
            }
        }
        j = j + 1_i64;
    }
    return false;
}

i64[] Zeros(i64 n) {
    mut i64[] out = Array.Empty<i64>();
    mut i64 i = 0_i64;
    while i < n { Array.Append<i64>(out, 0_i64); i = i + 1_i64; }
    return out;
}

Search NewSearch(Certificate leaf, Certificate[] intermediates, TrustStore store, VerifyOptions options) {
    i64 n = Array.Len<Certificate>(intermediates);
    mut X509Error[] best = Array.Empty<X509Error>();
    Array.Append<X509Error>(best, X509Error::UnknownIssuer);
    return Search { leaf: leaf, intermediates: intermediates, store: store, options: options, path: Zeros(n + 1_i64), used: Zeros(n + 1_i64), found: [0_i64, 0_i64, 0_i64], best: best };
}

/// Validates `leaf` and returns X509Error::None, or the most specific failure.
pub X509Error Check(Certificate leaf, Certificate[] intermediates, TrustStore store, VerifyOptions options) {
    Search s = NewSearch(leaf, intermediates, store, options);
    if Extend(s, leaf, 0_i64) { return X509Error::None; }
    return s.best[0];
}

/// Validates `leaf` and returns the path that was accepted.
pub Result<VerifiedChain, X509Error> Verify(Certificate leaf, Certificate[] intermediates, TrustStore store, VerifyOptions options) {
    Search s = NewSearch(leaf, intermediates, store, options);
    if !Extend(s, leaf, 0_i64) { return Result::Error(s.best[0]); }
    mut Certificate[] chain = Array.Empty<Certificate>();
    mut i64 k = 0_i64;
    while k <= s.found[0] {
        Array.Append<Certificate>(chain, At(s, k));
        k = k + 1_i64;
    }
    return Result::Ok(VerifiedChain { certificates: chain, anchor: store.anchors[s.found[1]] });
}
