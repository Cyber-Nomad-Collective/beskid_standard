// WORKAROUND: method bodies live in module-level functions; methods are thin wrappers that pass `this`.
use Testing.Assert;

pub type D {
    i64 n,
    pub i64 A() { return DoA(this); }
    pub i64 B() { return DoA(this); }
}
i64 DoA(D self) { return self.n; }

test module_function_wrappers {
    D d = D { n: 5_i64 };
    Assert.Equal<i64>(d.B(), 5_i64, "B via DoA");
}
