//! Certificate parsing, chain verification (RSA and EC), rejection reasons and the system bundle.

use Testing.Assert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use X509.Certificate;
use X509.Names;
use TestSupport;
use X509.Verify;
use X509.X509Errors;
use Core.Results;
use X509.Pem;
use Core.Output;
use X509.Der;
use X509.TrustStore;

unit CheckRsaLeaf()
{
    Certificate c = TestSupport.Cert("rsa-leaf.pem");
    Assert.Equal<i64>(c.version, 3_i64, "v3");
    Assert.True(c.subject.commonName == "www.example.test", "subject CN");
    Assert.True(c.issuer.commonName == "Beskid Test RSA Intermediate", "issuer CN");
    Assert.True(c.issuer.organization == "Beskid Test", "issuer O");
    Assert.True(c.issuer.country == "PL", "issuer C");
    Assert.Equal<i64>(c.notBefore, 1735689600_i64, "notBefore 2025-01-01");
    Assert.Equal<i64>(c.notAfter, 1893456000_i64, "notAfter 2030-01-01");
    PublicKeyInfo key = c.publicKey;
    Assert.True(Certificate.IsKeyAlgorithm(key.algorithm, KeyAlgorithm::Rsa), "rsa key");
    Assert.Equal<i64>(Slice.Len(key.rsaModulus), 256_i64, "2048-bit modulus");
    Assert.Equal<i64>(Slice.Len(key.rsaExponent), 3_i64, "e = 65537");
    SignatureAlgorithm alg = c.signatureAlgorithm;
    Assert.True(Certificate.SchemeName(alg.scheme) == "sha256WithRSAEncryption", "alg");
    Extensions ext = c.extensions;
    Assert.True(ext.hasBasicConstraints && !ext.isCa, "not CA");
    Assert.True(ext.hasKeyUsage, "ku");
    Assert.Equal<i64>(ext.keyUsage, Certificate.KeyUsageDigitalSignature() | Certificate.KeyUsageKeyEncipherment(), "ku bits");
    Assert.True(ext.hasExtKeyUsage && ext.ekuServerAuth && !ext.ekuClientAuth, "eku");
    Assert.Equal<i64>(Array.Len<string>(ext.dnsNames), 2_i64, "two dns");
    Assert.True(ext.dnsNames[1] == "*.api.example.test", "wildcard san");
    Assert.Equal<i64>(Array.Len<IpBytes>(ext.ipAddresses), 2_i64, "two ips");
    IpBytes v4 = ext.ipAddresses[0];
    Assert.Equal<i64>(Slice.Len(v4.bytes), 4_i64, "v4");
    Assert.True(v4.bytes[3] == 10_u8, "192.0.2.10");
    Assert.Equal<i64>(Slice.Len(ext.subjectKeyId), 20_i64, "ski");
    Assert.Equal<i64>(Slice.Len(ext.authorityKeyId), 20_i64, "aki");
    Assert.Equal<i64>(Slice.Len(c.signature), 256_i64, "rsa signature");
    return;
}

unit CheckCaAndEc()
{
    Certificate root = TestSupport.Cert("ec-root.pem");
    Assert.True(Certificate.IsSelfIssued(root), "self issued");
    Assert.True(root.extensions.isCa, "CA");
    Assert.Equal<i64>(root.extensions.pathLen, -1_i64, "no pathlen");
    Assert.True(Certificate.IsKeyAlgorithm(root.publicKey.algorithm, KeyAlgorithm::EcP256), "P-256");
    Assert.Equal<i64>(Slice.Len(root.publicKey.keyBytes), 65_i64, "point");
    Certificate inter = TestSupport.Cert("ec-int.pem");
    Assert.True(Certificate.SchemeName(inter.signatureAlgorithm.scheme) == "ecdsa-with-SHA384", "sha384");
    Assert.True(Names.Equal(inter.issuer, root.subject), "issuer links");
    Certificate rint = TestSupport.Cert("rsa-int.pem");
    Assert.Equal<i64>(rint.extensions.pathLen, 0_i64, "pathlen 0");
    Assert.Equal<i64>(rint.extensions.keyUsage, Certificate.KeyUsageKeyCertSign() | Certificate.KeyUsageCrlSign(), "ca ku");
    return;
}

unit CheckPssAndSha512()
{
    Certificate pss = TestSupport.Cert("rsa-leafpss.pem");
    SignatureAlgorithm alg = pss.signatureAlgorithm;
    Assert.True(Certificate.SchemeName(alg.scheme) == "RSASSA-PSS", "pss");
    Assert.Equal<i64>(alg.pssHashBits, 256_i64, "sha256");
    Assert.Equal<i64>(alg.pssSaltLength, 32_i64, "salt");
    Certificate s512 = TestSupport.Cert("rsa-leaf512.pem");
    Assert.True(Certificate.SchemeName(s512.signatureAlgorithm.scheme) == "sha512WithRSAEncryption", "sha512");
    return;
}

unit CheckNameConstraints()
{
    Certificate nc = TestSupport.Cert("ec-nc.pem");
    NameConstraints c = nc.extensions.nameConstraints;
    Assert.True(c.present, "present");
    Assert.Equal<i64>(Array.Len<string>(c.permittedDns), 1_i64, "one permitted");
    Assert.True(c.permittedDns[0] == "allowed.test", "permitted");
    Assert.True(c.excludedDns[0] == "bad.allowed.test", "excluded");
    Assert.False(c.hasUnsupportedForm, "dns only");
    return;
}

string Run(string leafName, Certificate[] intermediates, string serverName)
{
    Certificate leaf = TestSupport.Cert(leafName);
    X509Error e = Verify.Check(leaf, intermediates, TestSupport.TestRoots(), Verify.ServerOptions(TestSupport.Now(), serverName));
    return X509Errors.Name(e);
}

string ParseError(u8[] der)
{
    Result<Certificate, X509Error> r = Certificate.Parse(der);
    return match (r)
    {
        Result::Ok(_) => "None",
        Result::Error(e) => X509Errors.Name(e),
    };
}

u8[] DerOf(string name)
{
    PemStep step = Pem.Next(TestSupport.Fixture(name), 0_i64);
    Assert.True(step.found, "pem block");
    return step.der;
}

unit CheckCriticalExtension()
{
    Assert.True(ParseError(DerOf("ec-crit.pem")) == "UnknownCriticalExtension", "critical private extension");
    return;
}

unit CheckCorruptedEncodings()
{
    u8[] der = DerOf("ec-leaf.pem");
    i64 n = Slice.Len(der);
    Assert.True(ParseError(der) == "None", "original parses");
    // Trailing byte after the certificate.
    u8[] longer = Slice.New(n + 1_i64);
    Slice.Copy(longer, 0_i64, der, 0_i64, n);
    Assert.True(ParseError(longer) == "TrailingData", "trailing data");
    // Truncated certificate.
    Assert.True(ParseError(Slice.SubSlice(der, 0_i64, n - 1_i64)) == "Truncated", "truncated");
    // Outer SEQUENCE length rewritten in a non-minimal form is caught.
    u8[] copy = Slice.SubSlice(der, 0_i64, n);
    copy[0] = 0x31_u8;
    Assert.True(ParseError(copy) == "UnexpectedTag", "outer SET");
    return;
}

mod CertificatesTests
{
    test ParsePemReadsTheFieldsOfTheFixtureCertificates
    {
        CheckRsaLeaf();
        CheckCaAndEc();
        CheckPssAndSha512();
        CheckNameConstraints();
    }

    test RsaChainsVerifyHostnamesSignaturesAndPathLength
    {
        Certificate[] ints = TestSupport.One(TestSupport.Cert("rsa-int.pem"));
        Assert.True(Run("rsa-leaf.pem", ints, "www.example.test") == "None", "valid RSA chain");
        Assert.True(Run("rsa-leaf.pem", ints, "foo.api.example.test") == "None", "wildcard SAN");
        Assert.True(Run("rsa-leaf.pem", ints, "192.0.2.10") == "None", "IP SAN");
        Assert.True(Run("rsa-leaf.pem", ints, "wrong.example.test") == "HostnameMismatch", "wrong host");
        Assert.True(Run("rsa-leaf.pem", ints, "192.0.2.11") == "HostnameMismatch", "wrong IP");
        Assert.True(Run("rsa-leafpss.pem", ints, "leaf.example.test") == "None", "PSS signature");
        Assert.True(Run("rsa-leaf512.pem", ints, "leaf.example.test") == "None", "sha512 signature");
        Assert.True(Run("rsa-leaf.pem", TestSupport.One(TestSupport.Cert("ec-int.pem")), "") == "UnknownIssuer", "missing intermediate");
        Certificate[] deep = TestSupport.Two(TestSupport.Cert("rsa-sub.pem"), TestSupport.Cert("rsa-int.pem"));
        Assert.True(Run("rsa-subleaf.pem", deep, "leaf.example.test") == "PathLengthExceeded", "pathLen 0 below sub CA");
    }

    test EcChainsCheckExpiryKeyUsageCaAndNameConstraints
    {
        Certificate[] ints = TestSupport.One(TestSupport.Cert("ec-int.pem"));
        Assert.True(Run("ec-leaf.pem", ints, "www.example.test") == "None", "valid P-256 chain, SHA-384 intermediate");
        Assert.True(Run("ec-leaf.pem", ints, "2001:db8::1") == "None", "IPv6 SAN");
        Assert.True(Run("ec-expired.pem", ints, "leaf.example.test") == "Expired", "expired leaf");
        Assert.True(Run("ec-client.pem", ints, "client.example.test") == "BadExtendedKeyUsage", "clientAuth only");
        Certificate[] noca = TestSupport.Two(TestSupport.Cert("ec-noca.pem"), TestSupport.Cert("ec-int.pem"));
        Assert.True(Run("ec-nocaleaf.pem", noca, "leaf.example.test") == "NotCa", "non-CA intermediate");
        Certificate[] nc = TestSupport.One(TestSupport.Cert("ec-nc.pem"));
        Assert.True(Run("ec-ncok.pem", nc, "www.allowed.test") == "None", "permitted subtree");
        Assert.True(Run("ec-ncbad.pem", nc, "www.evil.test") == "NameConstraintViolation", "outside permitted");
        Assert.True(Run("ec-ncexcl.pem", nc, "x.bad.allowed.test") == "NameConstraintViolation", "excluded subtree");
        Assert.True(Run("ec-leaf.pem", Array.Empty<Certificate>(), "") == "UnknownIssuer", "no intermediate");
        Certificate leaf = TestSupport.Cert("ec-leaf.pem");
        VerifyOptions none = Verify.WithMaxIntermediates(Verify.ServerOptions(TestSupport.Now(), ""), 0_i64);
        Assert.True(X509Errors.Name(Verify.Check(leaf, ints, TestSupport.TestRoots(), none)) == "ChainTooLong", "depth bound");
        // After 2030-01-01 the leaf has expired.
        VerifyOptions later = Verify.ServerOptions(1900000000_i64, "www.example.test");
        Assert.True(X509Errors.Name(Verify.Check(leaf, ints, TestSupport.TestRoots(), later)) == "Expired", "time is a parameter");
    }

    test ParsePemRejectsMalformedCertificates
    {
        CheckCriticalExtension();
        CheckCorruptedEncodings();
    }

    test SystemTrustBundleLoadsMoreThanOneHundredRoots
    {
        Result<TrustStore, X509Error> r = TrustStore.FromFile(TrustStore.SystemBundlePath());
        bool ok = match (r)
        {
            Result::Ok(_) => true,
            Result::Error(_) => false,
        };
        Assert.True(ok, "bundle loads");
        TrustStore store = match (r)
        {
            Result::Ok(s) => s,
            Result::Error(_) => TrustStore.Empty(),
        };
        Output.WriteLine("anchors=" + Der.Decimal(TrustStore.Count(store)) + " skipped=" + Der.Decimal(store.skipped));
        Assert.True(store.skipped <= 2_i64, "few unparsable roots");
        Assert.True(TrustStore.Count(store) > 100_i64, "more than 100 anchors");
        Assert.True(TrustStore.FindByCommonName(store, "ISRG Root X1") >= 0_i64, "ISRG Root X1 present");
        Assert.True(TrustStore.FindByCommonName(store, "DigiCert Global Root G2") >= 0_i64, "DigiCert Global Root G2 present");
        Assert.True(TrustStore.FindByCommonName(store, "No Such Root") < 0_i64, "absent root");
    }
}
