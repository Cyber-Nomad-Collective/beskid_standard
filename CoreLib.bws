workspace {
  name = "corelib"
  resolver = v1
  schema = "beskid.workspace.v1"
  defaultTestMember = "corelib_tests"
}

member "corelib" {
  path = "beskid_corelib"
  package = "corelib"
  description = "Beskid standard library aggregate: path dependencies on foundation, runtime, console, concurrency, and compiler SDK packages."
  category = "Library"
  tags = ["corelib", "stdlib", "beskid", "standard-library"]
}

member "foundation" {
  path = "packages/foundation"
  package = "corelib_foundation"
  description = "Low-level primitives shared by Beskid corelib workspace packages (collections, results, strings, testing helpers)."
  category = "Library"
  tags = ["corelib", "foundation", "beskid", "stdlib"]
}

member "runtime" {
  path = "packages/runtime"
  package = "corelib_runtime"
  description = "Runtime ABI surfaces for Beskid (process init and host linkage helpers)."
  category = "Library"
  tags = ["corelib", "runtime", "beskid", "stdlib", "syscall"]
}

member "compiler_sdk" {
  path = "packages/compiler-sdk"
  package = "corelib_compiler_sdk"
  description = "Typed compiler Mod SDK facades (Beskid.Compiler.*, Beskid.Syntax) for type: Mod projects."
  category = "Library"
  tags = ["corelib", "compiler", "mod-sdk", "beskid"]
}

member "console" {
  path = "packages/console"
  package = "corelib_console"
  description = "Terminal and ANSI helpers (Console, Ansi) built on corelib runtime I/O."
  category = "Library"
  tags = ["corelib", "console", "beskid", "stdlib"]
}

member "concurrency" {
  path = "packages/concurrency"
  package = "corelib_concurrency"
  description = "Cooperative concurrency primitives (Fiber, channels)."
  category = "Library"
  tags = ["corelib", "concurrency", "beskid", "stdlib"]
}

member "interop" {
  path = "packages/interop"
  package = "corelib_interop"
  description = "Interop view types (CStringView, CBuffer, CArrayView) for the C ABI boundary."
  category = "Library"
  tags = ["corelib", "interop", "ffi", "beskid", "stdlib"]
}

member "network" {
  path = "packages/network"
  package = "corelib_network"
  description = "Portable Internet DNS, TCP, and UDP resources using Foundation I/O and disposal."
  category = "Library"
  tags = ["corelib", "network", "beskid", "stdlib"]
}

member "http" {
  path = "packages/http"
  package = "corelib_http"
  description = "Strict bounded HTTP/1.1 protocol framing over corelib network TCP."
  category = "Library"
  tags = ["corelib", "http", "network", "beskid", "stdlib"]
}

member "glue" {
  path = "packages/glue"
  package = "corelib_glue"
  description = "Glue session, envelope and binary codec types for the provisional stdio bridge; not used by the 0.6.0 Rust Glue path."
  category = "Library"
  tags = ["corelib", "glue", "interop", "beskid", "stdlib"]
}

member "pest_gen_schema" {
  path = "packages/pest-gen-schema"
  package = "pest_gen_schema"
  description = "BSOL schema for corelib_pest_gen tunables (pestGenConfig)."
  category = "Library"
  tags = ["corelib", "bsol", "pest", "dev"]
}

member "corelib_pest_gen" {
  path = "mods/corelib_pest_gen"
  package = "corelib_pest_gen"
  description = "Compiler mod that materializes Pest grammar combinator parsers."
  category = "Library"
  tags = ["corelib", "mod", "pest", "dev"]
}

member "serialization_mod" {
  path = "mods/serialization_mod"
  package = "serialization_mod"
  description = "Compiler mod that generates typed serialization code for annotated types."
  category = "Library"
  tags = ["corelib", "mod", "serialization"]
}

member "corelib_tests" {
  path = "beskid_corelib/tests/corelib_tests"
  package = "corelib_tests"
  description = "Integration tests for the Beskid standard library."
  category = "Test"
  tags = ["corelib", "tests", "beskid"]
}

member "bsol" {
  path = "packages/bsol"
  package = "corelib_bsol"
  description = "Native ordered BSOL syntax, schema validation, and typed structural codecs."
  category = "Library"
  tags = ["corelib", "bsol", "serialization", "beskid"]
}

member "serialization" {
  path = "packages/serialization"
  package = "corelib_serialization"
  description = "Format-independent values, checked policies, and shared typed serialization metadata."
  category = "Library"
  tags = ["corelib", "serialization", "beskid"]
}

member "uri" {
  path = "packages/uri"
  package = "corelib_uri"
  description = "URI reference parsing, formatting, normalization, and resolution (RFC 3986)."
  category = "Library"
  tags = ["corelib", "uri", "network", "beskid", "stdlib"]
}

member "codec" {
  path = "packages/codec"
  package = "corelib_codec"
  description = "Bounded byte primitives for TLS, HTTP/2, and QUIC."
  category = "Library"
  tags = ["corelib", "codec", "network", "beskid", "stdlib"]
}

member "connect" {
  path = "packages/connect"
  package = "corelib_connect"
  description = "TCP connection establishment with Happy Eyeballs version 2 (RFC 8305)."
  category = "Library"
  tags = ["corelib", "network", "network", "beskid", "stdlib"]
}

member "crypto" {
  path = "packages/crypto"
  package = "corelib_crypto"
  description = "Pure Beskid cryptography for TLS 1.3, QUIC, and X.509."
  category = "Library"
  tags = ["corelib", "crypto", "network", "beskid", "stdlib"]
}

member "x509" {
  path = "packages/x509"
  package = "corelib_x509"
  description = "X.509 certificate parsing and validation (RFC 5280)."
  category = "Library"
  tags = ["corelib", "x509", "network", "beskid", "stdlib"]
}

member "tls" {
  path = "packages/tls"
  package = "corelib_tls"
  description = "TLS 1.3 (RFC 8446) client and server."
  category = "Library"
  tags = ["corelib", "tls", "network", "beskid", "stdlib"]
}

member "http2" {
  path = "packages/http2"
  package = "corelib_http2"
  description = "HTTP/2 (RFC 9113) client and server with HPACK (RFC 7541)."
  category = "Library"
  tags = ["corelib", "http", "network", "beskid", "stdlib"]
}

member "websocket" {
  path = "packages/websocket"
  package = "corelib_websocket"
  description = "WebSocket (RFC 6455) client and server over TCP or TLS."
  category = "Library"
  tags = ["corelib", "websocket", "network", "beskid", "stdlib"]
}

member "quic" {
  path = "packages/quic"
  package = "corelib_quic"
  description = "QUIC version 1 (RFC 9000, 9001, 9002) over UDP."
  category = "Library"
  tags = ["corelib", "quic", "network", "beskid", "stdlib"]
}

member "http3" {
  path = "packages/http3"
  package = "corelib_http3"
  description = "HTTP/3 (RFC 9114) with QPACK (RFC 9204) over QUIC."
  category = "Library"
  tags = ["corelib", "http", "network", "beskid", "stdlib"]
}

member "web" {
  path = "packages/web"
  package = "corelib_web"
  description = "HTTP client and server facade over HTTP/1.1, HTTP/2, and TLS 1.3 with ALPN."
  category = "Library"
  tags = ["corelib", "web", "network", "beskid", "stdlib"]
}
