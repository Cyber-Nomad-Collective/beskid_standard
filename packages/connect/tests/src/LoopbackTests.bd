//! Connect over loopback: address ordering on the wire, fallback between families, deadlines,
//! cancellation and release of every losing attempt.

use Concurrency.Fiber;
use Core.Time;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Connect;
use Connect.Policy;
use Testing.Assert;
use TestSupport;
use Concurrency;
use Core.Collections.Array;
use Connect.Failures;

ConnectPolicy Fast()
{
    return Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(5000_i64));
}

Result<unit, NetworkError> AddressesV4Result()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    SocketAddress[] candidates = List1(address);
    match (Connect.ConnectAddresses(candidates, Fast()))
    {
        Result::Ok(stream) => {
            Assert.Equal<i64>(PeerPort(stream), address.port.Value(), "winner is the listener");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("loopback IPv4 connect succeeds"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit AddressesV4()
{
    match (AddressesV4Result())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("IPv4 scenario has no NetworkError"),
    };
}

test ConnectAddressesIpv4Loopback
{
    Fiber<unit> scenario = spawn AddressesV4();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "IPv4 scenario joins");
}

bool HasOptions(TcpStream stream, bool noDelay, bool keepAlive)
{
    return match (stream.SocketOptions())
    {
        Result::Ok(options) => options.noDelay == noDelay && options.keepAlive == keepAlive,
        Result::Error(_) => false,
    };
}

Result<unit, NetworkError> SocketOptionsResult()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    SocketOptions both = SocketOptions
    {
        noDelay: true,
        keepAlive: true,
    };
    ConnectPolicy policy = Policy.WithSocketOptions(Fast(), both);
    match (Connect.ConnectAddresses(List1(address), policy))
    {
        Result::Ok(stream) => {
            Assert.True(HasOptions(stream, true, true), "the winning stream has the policy's socket options");
            stream.SetSocketOptions(Network.Types.DefaultSocketOptions())?;
            Assert.True(HasOptions(stream, false, false), "SetSocketOptions clears both options");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("loopback IPv4 connect with socket options succeeds"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit SocketOptionsScenario()
{
    match (SocketOptionsResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("socket options scenario has no NetworkError"),
    };
}

test ConnectAppliesThePolicySocketOptionsToTheWinningStream
{
    Fiber<unit> scenario = spawn SocketOptionsScenario();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "socket options scenario joins");
}

