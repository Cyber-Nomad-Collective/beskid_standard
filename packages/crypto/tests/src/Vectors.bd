/// ChaCha20-Poly1305: the RFC 8439 section 2.8.2 example and a 1500-byte message without AAD.
pub AeadVector[] ChaCha20Poly1305Vectors()
{
    return [AeadVector
    {
        label: "ChaCha20-Poly1305 RFC 8439 section 2.8.2",
        key: Pattern(32, 1, 128),
        nonce: Hex("070000004041424344454647"),
        aad: Hex("50515253c0c1c2c3c4c5c6c7"),
        plaintext: Ascii(Sunscreen()),
        sealed: "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691",
    }, AeadVector
    {
        label: "ChaCha20-Poly1305 1500-byte message without AAD",
        key: Pattern(32, 1, 128),
        nonce: Hex("070000004041424344454647"),
        aad: Hex(""),
        plaintext: Pattern(1500, 13, 5),
        sealed: "",
    }];
}

/// Long-message ChaCha20-Poly1305 cases (32-byte key) that cover the four-block kernels and their tails.
pub LongAeadVector[] LongChaCha20Poly1305Vectors()
{
    return [LongAeadVector
    {
        label: "ChaCha20-Poly1305 1000 bytes",
        keyLength: 32,
        length: 1000,
        sealedDigest: "6fd7dbdd4ed19f5c49bcc8101f937a571b23dd77e0a5508a1f1c210c6c99e6c0",
    }, LongAeadVector
    {
        label: "ChaCha20-Poly1305 4109 bytes",
        keyLength: 32,
        length: 4109,
        sealedDigest: "7af36d463a1fa9e9023062cf632cbf25930a378edccd8fb448d0155ed763e479",
    }];
}

/// Long-message AES-GCM cases that cover the AES-CTR and GHASH batches and their tails.
pub LongAeadVector[] LongAesGcmVectors()
{
    return [LongAeadVector
    {
        label: "AES-128-GCM 1000 bytes",
        keyLength: 16,
        length: 1000,
        sealedDigest: "fa4a80f1f6af61dcaada5747a1783d44f5fc4a1ff9265d940a69dc295fc848a7",
    }, LongAeadVector
    {
        label: "AES-128-GCM 4109 bytes",
        keyLength: 16,
        length: 4109,
        sealedDigest: "5fb9b60f8dfcf08ea27e712dc74ec131cb0f220dee9a1ecdd21ba0db015259df",
    }, LongAeadVector
    {
        label: "AES-256-GCM 1000 bytes",
        keyLength: 32,
        length: 1000,
        sealedDigest: "688bd10e4d7c68fee1194e385c1c743fd3dcb1728a724e92ae6617b916093a97",
    }, LongAeadVector
    {
        label: "AES-256-GCM 4109 bytes",
        keyLength: 32,
        length: 4109,
        sealedDigest: "e60f2974413eb4551722ad646ff090c9fdf59beaf2084ebf133e93beb2bec7a1",
    }];
}

/// Long-case inputs. Expected values come from Python cryptography 49 (OpenSSL 3).
pub u8[] LongKey(i64 length)
{
    return Pattern(length, 1, 0);
}

pub u8[] LongNonce()
{
    return Hex("000000090000004a00000000");
}

pub u8[] LongAad()
{
    return Pattern(13, 1, 0);
}

/// Byte i is (7 i + 3) mod 256.
pub u8[] LongMessage(i64 length)
{
    return Pattern(length, 7, 3);
}
