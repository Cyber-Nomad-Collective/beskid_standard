tls_tests {
  name = "tls_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "TlsSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "Rfc8448Keys" { kind = Lib entry = "Rfc8448KeysTests.bd" }
target "Rfc8448Records" { kind = Lib entry = "Rfc8448RecordsTests.bd" }
target "Messages" { kind = Lib entry = "MessagesTests.bd" }
target "Rfc8448Client" { kind = Lib entry = "Rfc8448ClientTests.bd" }
target "Loopback" { kind = Lib entry = "LoopbackTests.bd" }
target "LoopbackPolicy" { kind = Lib entry = "LoopbackPolicyTests.bd" }
target "Engine" { kind = Lib entry = "EngineTests.bd" }
