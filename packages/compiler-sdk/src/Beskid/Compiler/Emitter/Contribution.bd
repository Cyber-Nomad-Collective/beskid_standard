// CHECKED IN: hand-maintained Mod SDK emit helpers (generator contribution assembly).
use Beskid.Compiler.Collect;
use Core.Collections.Array;

/// Assemble a generator contribution from typed top-level items.
pub GeneratedSyntaxContribution From(SyntaxContributionItem[] items) {
    return GeneratedSyntaxContribution { items: items, codeOutputs: [], targetBindings: [], templateBindings: [] };
}

pub GeneratedSyntaxContribution FromCodeOutputs(CodeContribution[] codeOutputs) {
    return GeneratedSyntaxContribution { items: [], codeOutputs: codeOutputs, targetBindings: [], templateBindings: [] };
}

pub GeneratedSyntaxContribution Combine(
    SyntaxContributionItem[] items,
    CodeContribution[] codeOutputs
) {
    return GeneratedSyntaxContribution { items: items, codeOutputs: codeOutputs, targetBindings: [], templateBindings: [] };
}

pub GeneratedSyntaxContribution Empty() {
    return GeneratedSyntaxContribution { items: [], codeOutputs: [], targetBindings: [], templateBindings: [] };
}

pub GeneratedSyntaxContribution AppendItem(
    GeneratedSyntaxContribution contribution,
    SyntaxContributionItem item
) {
    return GeneratedSyntaxContribution {
        items: Array.Append<SyntaxContributionItem>(contribution.items, item),
        codeOutputs: contribution.codeOutputs,
        targetBindings: contribution.targetBindings,
        templateBindings: contribution.templateBindings,
    };
}

pub GeneratedSyntaxContribution AppendCode(
    GeneratedSyntaxContribution contribution,
    CodeContribution output
) {
    return GeneratedSyntaxContribution {
        items: contribution.items,
        codeOutputs: Array.Append<CodeContribution>(contribution.codeOutputs, output),
        targetBindings: contribution.targetBindings,
        templateBindings: contribution.templateBindings,
    };
}

pub CodeContribution CodeOutput(string modulePath, string fileName, CodeString body) {
    return CodeContribution { modulePath: modulePath, fileName: fileName, body: body };
}

pub CodeString CodeBody(string language, string body) {
    return CodeString { language: language, body: body };
}

/// Bind a decoded implementation contribution to an issuer-checked semantic target.
pub GeneratedSyntaxContribution BindTarget(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.SemanticHandle target) {
    return GeneratedSyntaxContribution { items: contribution.items, codeOutputs: contribution.codeOutputs, targetBindings: Array.Append<SerializationTargetBinding>(contribution.targetBindings, SerializationTargetBinding { contributionIndex: index, target: target }), templateBindings: contribution.templateBindings };
}

/// Bind a typed generic implementation to a current issuer-checked template.
pub GeneratedSyntaxContribution BindTemplate(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.TypeTemplate template) {
    return GeneratedSyntaxContribution { items: contribution.items, codeOutputs: contribution.codeOutputs,
        targetBindings: contribution.targetBindings,
        templateBindings: Array.Append<SerializationTemplateBinding>(contribution.templateBindings,
            SerializationTemplateBinding { contributionIndex: index, template: template }) };
}
