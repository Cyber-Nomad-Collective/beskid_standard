/// A JSON document value (RFC 8259).
/// @tier(supported)
/// @variant(Null) The `null` literal.
/// @variant(Bool) `true` or `false`.
/// @variant(Number) A number, held as an f64.
/// @variant(Text) A string; escapes are already decoded to UTF-8.
/// @variant(List) An array of values.
/// @variant(Object) Members as parallel `keys` and `values` arrays in document order. Parsing
/// keeps duplicate keys; lookups return the first match.
pub enum JsonValue {
    Null,
    Bool(bool value),
    Number(f64 value),
    Text(string value),
    List(JsonValue[] items),
    Object(string[] keys, JsonValue[] values),
}
