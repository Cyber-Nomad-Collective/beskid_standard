use Core.Bytes.Slice;
use Core.String;

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}

/// Hex text to bytes; spaces are skipped.
pub u8[] Hex(string text) {
    i64 len = String.Len(text);
    mut i64 count = 0_i64;
    mut i64 i = 0_i64;
    while i < len { if String.ByteAt(text, i) != 32_u8 { count = count + 1_i64; } i = i + 1_i64; }
    u8[] out = Slice.New(count / 2_i64);
    mut i64 o = 0_i64;
    mut bool high = true;
    mut u8 acc = 0_u8;
    i = 0_i64;
    while i < len {
        u8 c = String.ByteAt(text, i);
        if c != 32_u8 {
            if high { acc = Nibble(c) * 16_u8; high = false; }
            else { out[o] = acc + Nibble(c); o = o + 1_i64; high = true; }
        }
        i = i + 1_i64;
    }
    return out;
}

use Core.FS;
use Core.FS.FsError;
use Core.Results;

pub string ReadOr2(string path) { return ReadOr(path); }

string ReadOr(string path) {
    Result<string, FsError> r = FS.ReadAllText(path);
    return match r { Result::Ok(t) => t, Result::Error(_) => "", };
}

/// Reads a fixture file. Tests run from the repository root or the package directory.
pub string Fixture(string name) {
    string a = ReadOr("packages/x509/tests/fixtures/" + name);
    if a != "" { return a; }
    string b = ReadOr("tests/fixtures/" + name);
    if b != "" { return b; }
    return ReadOr("fixtures/" + name);
}

use Core.Collections.Array;
use Testing.Assert;
use X509.Certificate;
use X509.TrustStore;
use X509.X509Errors;

/// Parses a fixture certificate; a parse failure fails the test.
pub Certificate Cert(string name) {
    Result<Certificate, X509Error> r = Certificate.ParsePem(Fixture(name));
    if !Certificate.Succeeded(r) { Assert.Fail("cannot parse " + name); }
    return Certificate.Unwrap(r);
}

/// A trust store with the two test roots.
pub TrustStore TestRoots() {
    return TrustStore.AddPem(TrustStore.Empty(), Fixture("roots.pem"));
}

pub Certificate[] One(Certificate a) {
    mut Certificate[] list = Array.Empty<Certificate>();
    Array.Append<Certificate>(list, a);
    return list;
}

pub Certificate[] Two(Certificate a, Certificate b) {
    mut Certificate[] list = Array.Empty<Certificate>();
    Array.Append<Certificate>(list, a);
    Array.Append<Certificate>(list, b);
    return list;
}

/// 2026-06-01T00:00:00Z, inside every fixture validity window except the expired leaf.
pub i64 Now() { return 1780272000_i64; }
