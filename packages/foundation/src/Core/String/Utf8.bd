/// UTF-8 rune decoding and code-unit-to-string materialization.
use Core.Bytes.Slice;
use Core.String.Chars;

/// Latin-1 supplement U+0080-U+00FF, built imperatively.
pub string Latin1Block() {
    mut string out = "";
    mut i64 c = 128;
    while c <= 255 {
        u8 lead = u8(194 + c / 64);
        u8 trail = u8(128 + c % 64);
        u8[] pair = Slice.New(2);
        pair[0] = lead;
        pair[1] = trail;
        string rune = __str_from_bytes_utf8(pair);
        out = out + rune;
        c = c + 1;
    }
    return out;
}

pub i64 Utf8RuneByteLen(u8 lead) {
    if lead < 128 {
        return 1;
    }
    if lead < 192 {
        return 0;
    }
    if lead < 224 {
        return 2;
    }
    if lead < 240 {
        return 3;
    }
    if lead < 248 {
        return 4;
    }
    return 0;
}

pub string Latin1Rune(u8 lead, u8 trail) {
    i64 cp = (i64(lead) - 192) * 64 + (i64(trail) - 128);
    i64 offset = (cp - 128) * 2;
    return __str_slice(Latin1Block(), offset, 2);
}

pub string AppendUtf8Rune(string out, u8[] data, i64 start, i64 runeLen) {
    if runeLen == 1 {
        u8 b = Slice.Get(data, start);
        if b >= 48 && b <= 57 {
            return out + Chars.DigitChar(i64(b) - 48);
        }
        if b >= 65 && b <= 90 {
            return out + Chars.UpperChar(i64(b) - 65);
        }
        if b >= 97 && b <= 122 {
            return out + Chars.LowerChar(i64(b) - 97);
        }
        return out;
    }
    if runeLen == 2 {
        u8 lead = Slice.Get(data, start);
        u8 trail = Slice.Get(data, start + 1);
        return out + Latin1Rune(lead, trail);
    }
    u8[] rune = Slice.SubSlice(data, start, runeLen);
    string decoded = __str_from_bytes_utf8(rune);
    return out + decoded;
}

/// Materializes validated UTF-8 code units into a `string` without `__bytes_from_str`.
pub string FromUtf8CodeUnits(u8[] data) {
    return __str_from_bytes_utf8(data);
}
