mod KeyScheduleTests
{
    test EarlyHandshakeMasterSecrets
    {
        u8[] early = KeySchedule.EarlySecret(H());
        Assert.True(Same(early, EarlySecret()), "early secret");
        u8[] hs = KeySchedule.HandshakeSecret(H(), early, SharedSecret());
        Assert.True(Same(hs, HandshakeSecret()), "handshake secret");
        u8[] th = Hmac.Digest(H(), Slice.SubSlice(ServerFlight(), 0_i64, 0_i64));
        Assert.True(Same(KeySchedule.ClientHandshakeTraffic(H(), hs, TranscriptAfterSh()), ClientHsTraffic()), "c hs traffic");
        Assert.True(Same(KeySchedule.ServerHandshakeTraffic(H(), hs, TranscriptAfterSh()), ServerHsTraffic()), "s hs traffic");
        Assert.True(Same(KeySchedule.MasterSecret(H(), hs), MasterSecret()), "master secret");
        Assert.Equal<i64>(Slice.Len(th), 32_i64, "empty hash length");
    }

    test TranscriptHashesFromMessages
    {
        HashState t = Hmac.HashNew(H());
        Hmac.HashUpdate(t, ClientHello());
        Hmac.HashUpdate(t, ServerHello());
        Assert.True(Same(Hmac.HashFinish(Hmac.HashClone(t)), TranscriptAfterSh()), "hash(CH..SH)");
        Hmac.HashUpdate(t, ServerFlight());
        Assert.True(Same(Hmac.HashFinish(Hmac.HashClone(t)), TranscriptAfterServerFinished()), "hash(CH..server Finished)");
        Hmac.HashUpdate(t, ClientFinished());
        Assert.True(Same(Hmac.HashFinish(t), TranscriptAfterClientFinished()), "hash(CH..client Finished)");
    }

    test ApplicationAndDerivedSecrets
    {
        u8[] ms = MasterSecret();
        u8[] th = TranscriptAfterServerFinished();
        Assert.True(Same(KeySchedule.ClientApplicationTraffic(H(), ms, th), ClientApTraffic()), "c ap traffic");
        Assert.True(Same(KeySchedule.ServerApplicationTraffic(H(), ms, th), ServerApTraffic()), "s ap traffic");
        Assert.True(Same(KeySchedule.ExporterMaster(H(), ms, th), ExporterMaster()), "exp master");
        Assert.True(Same(KeySchedule.ResumptionMaster(H(), ms, TranscriptAfterClientFinished()), TraceResumptionMaster()), "res master");
    }

    test TrafficKeysAndIvs
    {
        CipherSuite s = Suites.Aes128();
        Assert.True(Same(KeySchedule.TrafficKey(s, ServerHsTraffic()), ServerHsKey()), "server hs key");
        Assert.True(Same(KeySchedule.TrafficIv(s, ServerHsTraffic()), ServerHsIv()), "server hs iv");
        Assert.True(Same(KeySchedule.TrafficKey(s, ClientHsTraffic()), ClientHsKey()), "client hs key");
        Assert.True(Same(KeySchedule.TrafficIv(s, ClientHsTraffic()), ClientHsIv()), "client hs iv");
        Assert.True(Same(KeySchedule.TrafficKey(s, ServerApTraffic()), ServerApKey()), "server ap key");
        Assert.True(Same(KeySchedule.TrafficIv(s, ServerApTraffic()), ServerApIv()), "server ap iv");
        Assert.True(Same(KeySchedule.TrafficKey(s, ClientApTraffic()), ClientApKey()), "client ap key");
        Assert.True(Same(KeySchedule.TrafficIv(s, ClientApTraffic()), ClientApIv()), "client ap iv");
    }

    test FinishedVerifyData
    {
        HashState t = Hmac.HashNew(H());
        Hmac.HashUpdate(t, ClientHello());
        Hmac.HashUpdate(t, ServerHello());
        Hmac.HashUpdate(t, EncryptedExtensions());
        Hmac.HashUpdate(t, Certificate());
        Hmac.HashUpdate(t, CertificateVerify());
        u8[] serverTh = Hmac.HashFinish(Hmac.HashClone(t));
        Assert.True(Same(KeySchedule.FinishedKey(H(), ServerHsTraffic()), ServerFinishedKey()), "server finished key");
        Assert.True(Same(KeySchedule.FinishedVerifyData(H(), ServerHsTraffic(), serverTh), ServerVerifyData()), "server verify_data");
        Hmac.HashUpdate(t, ServerFinished());
        u8[] clientTh = Hmac.HashFinish(t);
        Assert.True(Same(KeySchedule.FinishedVerifyData(H(), ClientHsTraffic(), clientTh), ClientVerifyData()), "client verify_data");
    }
}
