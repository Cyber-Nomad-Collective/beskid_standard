x509_tests {
  name = "x509_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_x509" { source = path path = ".." }
target "X509SmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "Der" { kind = Lib entry = "DerTests.bd" }
