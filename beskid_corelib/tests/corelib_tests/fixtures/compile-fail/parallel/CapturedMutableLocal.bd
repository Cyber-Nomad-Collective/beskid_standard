// EXPECT: E1235
// An operator lambda cannot assign a captured local; the help names a reduction.
use Core.Collections.List;
use Core.Parallel;
use Core.Parallel.ParallelSeq;

test CapturedMutableLocalIsRejected {
    List<string> lines = List.New<string>();
    string needle = "x";
    mut i64 count = 0_i64;
    lines.Parallel().ForEach((l) => {
        if l == needle {
            count = count + 1_i64;
        }
        return;
    });
}
