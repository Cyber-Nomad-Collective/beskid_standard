// EXPECT: E1610
// `List<T>.Parallel()` requires `T: Transferable`; `Channel<i64>` is not.
use Core.Collections.List;
use Concurrency.Channel;
use Core.Parallel;
use Core.Parallel.ParallelSeq;

test SequenceOfChannelsIsRejected {
    List<Channel<i64>> channels = List.New<Channel<i64>>();
    ParallelSeq<Channel<i64>> seq = channels.Parallel();
}
