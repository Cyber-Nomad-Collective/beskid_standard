/// Typed failures for index- and key-based collection operations.
/// @tier(supported)
/// @variant(IndexOutOfRange) `index` was outside `0..count` (or `0..=count` for insertion).
/// @variant(KeyNotFound) The requested key is not present.
/// @variant(Empty) The operation needs at least one element.
pub enum CollectionError {
    IndexOutOfRange(i64 index, i64 count),
    KeyNotFound,
    Empty,
}
