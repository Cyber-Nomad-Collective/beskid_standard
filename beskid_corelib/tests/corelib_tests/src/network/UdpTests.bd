use Core.Bytes.Slice;
use Concurrency.Fiber;
use Core.Results;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Network.Types;
use Network.Errors;
use Network.Udp.UdpSocket;
use Core.Collections.List;
use Concurrency.Channel;
use Testing.Assert;

unit PendingUdpReceive(UdpSocket receiver, Channel<i64> ready) {
    Assert.True(match Channel<i64>.Send(ready, 1_i64) { Result::Ok(_) => true, _ => false, }, "receiver announces immediately before parking");
    Assert.True(match receiver.ReceiveFrom(1_i64, Option.Empty<Deadline>()) {
        Result::Ok(_) => true,
        _ => false,
    }, "opposite-direction send wakes the pending receive");
}

Result<unit, NetworkError> UdpContentionResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    Channel<i64> ready = Channel<i64>.Create();
    Fiber<unit> pending = spawn (() => PendingUdpReceive(receiver, ready));
    match Channel<i64>.Receive(ready) {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("pending UDP receive announces readiness"),
    };

    // An expired deadline bounds an incorrectly admitted second wait without
    // timing or sleeping: admission must reject it as Busy before timer setup.
    bool sameDirectionBusy = match Deadline.After(Time.FromMilliseconds(0_i64)) {
        Result::Error(_) => false,
        Result::Ok(expired) => match receiver.ReceiveFrom(1_i64, Option.FromValue<Deadline>(expired)) {
            Result::Error(NetworkError::Busy) => true,
            _ => false,
        },
    };

    u8[] payload = [81_u8, 82_u8];
    bool oppositeDirectionSendSucceeded = match sender.SendTo(payload, target, Option.Empty<Deadline>()) {
        Result::Ok(_) => true,
        _ => false,
    };
    bool pendingReceiveSucceeded = match pending.Join() {
        Result::Ok(_) => true,
        _ => false,
    };
    Assert.Equal(payload[0], 81_u8, "send leaves the caller payload owned by its caller");
    Assert.Equal(payload[1], 82_u8, "send retains the complete caller payload");
    Channel<i64>.Close(ready);
    sender.Close()?;
    receiver.Close()?;
    Assert.True(sameDirectionBusy, "a second receive is rejected as Busy while the first is pending");
    Assert.True(oppositeDirectionSendSucceeded, "send proceeds while receive is pending");
    Assert.True(pendingReceiveSucceeded, "the original pending receive completes exactly once");
    return Result::Ok(());
}

unit UdpContention() {
    match UdpContentionResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP contention scenario completes without a NetworkError"),
    };
}

test network_udp_same_direction_busy_and_opposite_direction_send_receive {
    Fiber<unit> scenario = spawn UdpContention();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP contention scenario joins"),
    };
}

Result<unit, NetworkError> UdpBoundariesResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    SocketAddress source = sender.LocalAddress()?;
    u8[] payload = [1_u8, 2_u8, 3_u8, 4_u8];
    sender.SendTo(payload, target, Option.Empty<Deadline>())?;
    Datagram datagram = receiver.ReceiveFrom(2_i64, Option.Empty<Deadline>())?;
    Assert.Equal(Slice.Len(datagram.payload), 2_i64, "receive returns only available payload");
    Assert.True(datagram.truncated, "oversized datagram sets truncation");
    Assert.Equal(datagram.source.port.Value(), source.port.Value(), "source address is retained");
    Assert.Equal(Slice.Len(payload), 4_i64, "send retains caller payload ownership");
    sender.SendTo(Slice.New(0_i64), target, Option.Empty<Deadline>())?;
    Datagram empty = receiver.ReceiveFrom(2_i64, Option.Empty<Deadline>())?;
    Assert.Equal(Slice.Len(empty.payload), 0_i64, "empty datagram is not EOF");
    Assert.False(empty.truncated, "empty datagram fits");
    sender.Close()?;
    receiver.Close()?;
    receiver.Close()?;
    return Result::Ok(());
}

unit UdpBoundaries() {
    match UdpBoundariesResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP boundaries complete without a NetworkError"),
    };
}

test network_udp_preserves_datagrams_sources_and_truncation {
    Fiber<unit> scenario = spawn UdpBoundaries();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP boundaries scenario completes"),
    };
}

Result<unit, NetworkError> UdpConnectedResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket left = UdpSocket.Bind(bindAddress)?;
    UdpSocket right = UdpSocket.Bind(bindAddress)?;
    left.Connect(right.LocalAddress()?)?;
    right.Connect(left.LocalAddress()?)?;
    left.Send([99_u8], Option.Empty<Deadline>())?;
    Datagram received = right.Receive(1_i64, Option.Empty<Deadline>())?;
    Assert.Equal(received.payload[0], 99_u8, "connected receive preserves payload");
    right.Close()?;
    Assert.True(match right.Receive(1_i64, Option.Empty<Deadline>()) { Result::Error(NetworkError::Closed) => true, _ => false, }, "closed generation fails before native I/O");
    left.Close()?;
    return Result::Ok(());
}

unit UdpConnected() {
    match UdpConnectedResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("connected UDP completes without a NetworkError"),
    };
}

test network_udp_connected_operations_and_closed_error {
    Fiber<unit> scenario = spawn UdpConnected();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("connected UDP scenario completes"),
    };
}

Result<unit, NetworkError> SlotReuseResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket previous = UdpSocket.Bind(bindAddress)?;
    previous.Close()?;
    UdpSocket current = UdpSocket.Bind(bindAddress)?;
    Assert.True(match previous.LocalAddress() { Result::Error(NetworkError::Closed) => true, _ => false, }, "stale generation cannot address replacement socket");
    previous.Close()?;
    SocketAddress address = current.LocalAddress()?;
    Assert.True(address.port.Value() > 0_i64, "stale close cannot release replacement socket");
    current.Close()?;
    return Result::Ok(());
}

test network_closed_resource_cannot_reach_a_reused_slot {
    match SlotReuseResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("slot reuse completes without a NetworkError"),
    };
}

// Binds until the runtime reports exhaustion. state[0] records the live count,
// state[1] the successful rebind after one close, state[2] the stop reason.
Result<unit, NetworkError> ExhaustionResult(SocketAddress address, i64[] state) {
    mut List<UdpSocket> held = List.New<UdpSocket>();
    mut i64 stop = 0_i64;
    while stop == 0_i64 && held.Count() <= 256_i64 {
        match UdpSocket.Bind(address) {
            Result::Ok(socket) => { held = held.Push(socket); },
            Result::Error(NetworkError::ResourceExhausted) => { stop = 1_i64; },
            Result::Error(_) => { stop = 2_i64; },
        };
    }
    state[0] = held.Count();
    state[2] = stop;
    if stop == 1_i64 && held.Count() > 0_i64 {
        match held.Get(held.Count() - 1_i64) {
            Result::Ok(last) => { last.Close()?; },
            Result::Error(_) => Assert.Fail("the last live socket is held"),
        };
        held = held.Pop();
        UdpSocket replacement = UdpSocket.Bind(address)?;
        held = held.Push(replacement);
        state[1] = 1_i64;
    }
    mut i64 index = 0_i64;
    while index < held.Count() {
        match held.Get(index) {
            Result::Ok(socket) => { socket.Close()?; },
            Result::Error(_) => Assert.Fail("every live socket is held"),
        };
        index = index + 1_i64;
    }
    return Result::Ok(());
}

Result<unit, NetworkError> BindAndClose(SocketAddress address) {
    UdpSocket socket = UdpSocket.Bind(address)?;
    socket.Close()?;
    return Result::Ok(());
}

test network_udp_exhaustion_is_typed {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    i64[] state = [0_i64, 0_i64, 0_i64];
    match ExhaustionResult(bindAddress, state) {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("exhaustion fixture releases every socket"),
    };
    Assert.Equal(state[2], 1_i64, "exhaustion is reported as ResourceExhausted");
    Assert.True(state[0] > 0_i64 && state[0] <= 256_i64, "exhaustion occurs at or before the slot count");
    Assert.Equal(state[1], 1_i64, "closing one live socket admits the next bind");
    match BindAndClose(bindAddress) {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("every exhausted socket was released"),
    };
}

Result<unit, NetworkError> UdpExpiredReceiveRecoversResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    match Deadline.After(Time.FromMilliseconds(0_i64)) {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(expired) => match receiver.ReceiveFrom(1_i64, Option.FromValue<Deadline>(expired)) {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an empty UDP receive times out at its expired deadline"),
        },
    };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    u8[] payload = [73_u8];
    sender.SendTo(payload, target, Option.Empty<Deadline>())?;
    Datagram datagram = receiver.ReceiveFrom(1_i64, Option.Empty<Deadline>())?;
    Assert.Equal(datagram.payload[0], 73_u8, "socket accepts a datagram after its receive timeout");
    Assert.Equal(payload[0], 73_u8, "timed operations retain caller-owned payloads");
    sender.Close()?;
    receiver.Close()?;
    return Result::Ok(());
}

unit UdpExpiredReceiveRecovers() {
    match UdpExpiredReceiveRecoversResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP timeout recovery completes without a NetworkError"),
    };
}

test network_udp_expired_receive_deadline_times_out_and_socket_recovers {
    Fiber<unit> scenario = spawn UdpExpiredReceiveRecovers();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "UDP timeout recovery scenario completes");
}

Result<unit, NetworkError> UdpExpiredSendKeepsPayloadResult() {
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    u8[] payload = [41_u8, 42_u8];
    match Deadline.After(Time.FromMilliseconds(0_i64)) {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(expired) => match sender.SendTo(payload, target, Option.FromValue<Deadline>(expired)) {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an expired UDP send returns TimedOut before submission"),
        },
    };
    Assert.Equal(payload[0], 41_u8, "timed-out send leaves caller payload intact");
    Assert.Equal(payload[1], 42_u8, "timed-out send retains the full caller payload");
    match Deadline.After(Time.FromMilliseconds(100_i64)) {
        Result::Error(_) => Assert.Fail("short duration creates a typed receive deadline"),
        Result::Ok(receiveDeadline) => match receiver.ReceiveFrom(2_i64, Option.FromValue<Deadline>(receiveDeadline)) {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an expired send does not deliver a datagram"),
        },
    };
    sender.SendTo(payload, target, Option.Empty<Deadline>())?;
    Datagram delivered = receiver.ReceiveFrom(2_i64, Option.Empty<Deadline>())?;
    Assert.Equal(delivered.payload[0], 41_u8, "the caller can resend its payload after timeout");
    Assert.Equal(delivered.payload[1], 42_u8, "the resent payload is complete");
    sender.Close()?;
    receiver.Close()?;
    return Result::Ok(());
}

unit UdpExpiredSendKeepsPayload() {
    match UdpExpiredSendKeepsPayloadResult() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP send timeout scenario completes without another NetworkError"),
    };
}

test network_udp_expired_send_keeps_unsent_payload_and_socket {
    Fiber<unit> scenario = spawn UdpExpiredSendKeepsPayload();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "UDP send timeout scenario completes");
}
