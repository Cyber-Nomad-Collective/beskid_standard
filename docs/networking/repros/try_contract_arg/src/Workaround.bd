// WORKAROUND: bind the Result and match instead of using `?`.
use Core.Bytes.Slice;
use Core.IO;
use Core.IO.IoError;
use Core.IO.Writer;
use Core.Results;
use Testing.Assert;

pub type SinkWriter: Writer {
    i64 unused,
    pub Result<i64, IoError> Write(u8[] source, i64 offset, i64 count) { return Result::Ok(count); }
}

Result<i64, IoError> WriteVia(Writer w, u8[] buf) {
    return IO.Write(w, buf, 0_i64, Slice.Len(buf));
}

Result<i64, IoError> OuterMatch(Writer w, u8[] buf) {
    Result<i64, IoError> r = WriteVia(w, buf);
    match r {
        Result::Error(e) => { return Result::Error(e); },
        Result::Ok(_) => {},
    };
    return Result::Ok(3_i64);
}

test match_instead_of_try {
    SinkWriter w = SinkWriter { unused: 0_i64 };
    u8[] buf = Slice.New(3_i64);
    Assert.Equal<i64>(match OuterMatch(w, buf) { Result::Ok(v) => v, Result::Error(_) => -1_i64, }, 3_i64, "match form");
}
