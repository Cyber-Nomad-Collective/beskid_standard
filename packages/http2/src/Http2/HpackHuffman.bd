/// Decoding tables built once and shared by a decoder.
pub type HuffmanTables { pub i64[] first, pub i64[] counts, pub i64[] offsets, pub i64[] symbols, pub u32[] codes, pub u8[] lengths, }

pub HuffmanTables NewHuffmanTables() {
    return HuffmanTables { first: FirstCodes(), counts: LengthCounts(), offsets: LengthOffsets(), symbols: SortedSymbols(), codes: Codes(), lengths: Lengths() };
}

/// Decodes `count` octets at `offset`. Output longer than `maxOutput` is
/// StringTooLong; EOS is HuffmanEos; padding longer than 7 bits or not all
/// ones is rejected (RFC 7541 section 5.2).
pub Result<u8[],HpackError> HuffmanDecode(HuffmanTables tables, u8[] src, i64 offset, i64 count, i64 maxOutput) {
    mut u8[] out = [];
    mut i64 produced = 0_i64;
    mut i64 code = 0_i64;
    mut i64 bits = 0_i64;
    mut i64 i = 0_i64;
    while i < count {
        i64 octet = i64(src[offset + i]);
        mut i64 bit = 7_i64;
        while bit >= 0_i64 {
            code = code * 2_i64 + ((octet >> bit) & 1_i64);
            bits = bits + 1_i64;
            i64 window = tables.counts[bits];
            if window > 0_i64 {
                i64 position = code - tables.first[bits];
                if position >= 0_i64 && position < window {
                    i64 symbol = tables.symbols[tables.offsets[bits] + position];
                    if symbol == 256_i64 { return Result::Error(HpackError::HuffmanEos); }
                    if produced >= maxOutput { return Result::Error(HpackError::StringTooLong(produced + 1_i64)); }
                    Array.Append<u8>(out, u8(symbol));
                    produced = produced + 1_i64;
                    code = 0_i64;
                    bits = 0_i64;
                }
            }
            // The code is complete, so no prefix exceeds the 30-bit EOS code.
            if bits >= 30_i64 { return Result::Error(HpackError::HuffmanEos); }
            bit = bit - 1_i64;
        }
        i = i + 1_i64;
    }
    if bits > 7_i64 { return Result::Error(HpackError::HuffmanPaddingTooLong); }
    if code != (1_i64 << bits) - 1_i64 { return Result::Error(HpackError::HuffmanInvalidPadding); }
    return Result::Ok(out);
}

/// Octets needed to Huffman-encode `data`.
pub i64 HuffmanEncodedLength(HuffmanTables tables, u8[] data) {
    mut i64 total = 0_i64;
    mut i64 i = 0_i64;
    while i < Slice.Len(data) { total = total + i64(tables.lengths[i64(data[i])]); i = i + 1_i64; }
    return (total + 7_i64) / 8_i64;
}

/// Appends the Huffman encoding of `data`, padded with the EOS prefix (all ones).
/// Returns the grown buffer.
pub u8[] HuffmanEncode(HuffmanTables tables, mut u8[] out, u8[] data) {
    mut i64 acc = 0_i64;
    mut i64 pending = 0_i64;
    mut i64 i = 0_i64;
    while i < Slice.Len(data) {
        i64 symbol = i64(data[i]);
        i64 length = i64(tables.lengths[symbol]);
        acc = (acc << length) | i64(tables.codes[symbol]);
        pending = pending + length;
        while pending >= 8_i64 {
            pending = pending - 8_i64;
            Array.Append<u8>(out, u8((acc >> pending) & 255_i64));
        }
        acc = acc & ((1_i64 << pending) - 1_i64);
        i = i + 1_i64;
    }
    if pending > 0_i64 {
        i64 padBits = 8_i64 - pending;
        Array.Append<u8>(out, u8(((acc << padBits) | ((1_i64 << padBits) - 1_i64)) & 255_i64));
    }
    return out;
}
