use Core.Bytes.Slice;
use Core.Collections.Array;

/// Incremental SHA-512 and SHA-384 (FIPS 180-4) on i64 words.
/// i64 add wraps and `>>` is logical in Beskid 0.5.2, so i64 acts as a 64-bit unsigned word.
/// `meta[0]` buffered bytes, `meta[1]` total length in bytes, `meta[2]` 1 after `Finish`,
/// `meta[3]` digest length (48 or 64).
pub type Sha512State {
    i64[] h,
    i64[] k,
    i64[] w,
    u8[] buffer,
    i64[] meta,
}

pub i64 BlockLength() { return 128_i64; }

i64[] RoundConstants() {
    return [
        0x428a2f98d728ae22_i64, 0x7137449123ef65cd_i64, 0xb5c0fbcfec4d3b2f_i64, 0xe9b5dba58189dbbc_i64,
        0x3956c25bf348b538_i64, 0x59f111f1b605d019_i64, 0x923f82a4af194f9b_i64, 0xab1c5ed5da6d8118_i64,
        0xd807aa98a3030242_i64, 0x12835b0145706fbe_i64, 0x243185be4ee4b28c_i64, 0x550c7dc3d5ffb4e2_i64,
        0x72be5d74f27b896f_i64, 0x80deb1fe3b1696b1_i64, 0x9bdc06a725c71235_i64, 0xc19bf174cf692694_i64,
        0xe49b69c19ef14ad2_i64, 0xefbe4786384f25e3_i64, 0x0fc19dc68b8cd5b5_i64, 0x240ca1cc77ac9c65_i64,
        0x2de92c6f592b0275_i64, 0x4a7484aa6ea6e483_i64, 0x5cb0a9dcbd41fbd4_i64, 0x76f988da831153b5_i64,
        0x983e5152ee66dfab_i64, 0xa831c66d2db43210_i64, 0xb00327c898fb213f_i64, 0xbf597fc7beef0ee4_i64,
        0xc6e00bf33da88fc2_i64, 0xd5a79147930aa725_i64, 0x06ca6351e003826f_i64, 0x142929670a0e6e70_i64,
        0x27b70a8546d22ffc_i64, 0x2e1b21385c26c926_i64, 0x4d2c6dfc5ac42aed_i64, 0x53380d139d95b3df_i64,
        0x650a73548baf63de_i64, 0x766a0abb3c77b2a8_i64, 0x81c2c92e47edaee6_i64, 0x92722c851482353b_i64,
        0xa2bfe8a14cf10364_i64, 0xa81a664bbc423001_i64, 0xc24b8b70d0f89791_i64, 0xc76c51a30654be30_i64,
        0xd192e819d6ef5218_i64, 0xd69906245565a910_i64, 0xf40e35855771202a_i64, 0x106aa07032bbd1b8_i64,
        0x19a4c116b8d2d0c8_i64, 0x1e376c085141ab53_i64, 0x2748774cdf8eeb99_i64, 0x34b0bcb5e19b48a8_i64,
        0x391c0cb3c5c95a63_i64, 0x4ed8aa4ae3418acb_i64, 0x5b9cca4f7763e373_i64, 0x682e6ff3d6b2b8a3_i64,
        0x748f82ee5defb2fc_i64, 0x78a5636f43172f60_i64, 0x84c87814a1f0ab72_i64, 0x8cc702081a6439ec_i64,
        0x90befffa23631e28_i64, 0xa4506cebde82bde9_i64, 0xbef9a3f7b2c67915_i64, 0xc67178f2e372532b_i64,
        0xca273eceea26619c_i64, 0xd186b8c721c0c207_i64, 0xeada7dd6cde0eb1e_i64, 0xf57d4f7fee6ed178_i64,
        0x06f067aa72176fba_i64, 0x0a637dc5a2c898a6_i64, 0x113f9804bef90dae_i64, 0x1b710b35131c471b_i64,
        0x28db77f523047d84_i64, 0x32caab7b40c72493_i64, 0x3c9ebe0a15c9bebc_i64, 0x431d67c49c100d4c_i64,
        0x4cc5d4becb3e42b6_i64, 0x597f299cfc657e2a_i64, 0x5fcb6fab3ad6faec_i64, 0x6c44198c4a475817_i64
    ];
}

Sha512State NewWith(i64[] iv, i64 digestLength) {
    mut i64[] w = Array.Empty<i64>();
    mut i64 i = 0_i64;
    while i < 80_i64 { Array.Append<i64>(w, 0_i64); i = i + 1_i64; }
    return Sha512State { h: iv, k: RoundConstants(), w: w, buffer: Slice.New(128_i64), meta: [0_i64, 0_i64, 0_i64, digestLength] };
}

/// Starts a new SHA-512 computation.
pub Sha512State New512() {
    return NewWith([
        0x6a09e667f3bcc908_i64, 0xbb67ae8584caa73b_i64, 0x3c6ef372fe94f82b_i64, 0xa54ff53a5f1d36f1_i64,
        0x510e527fade682d1_i64, 0x9b05688c2b3e6c1f_i64, 0x1f83d9abfb41bd6b_i64, 0x5be0cd19137e2179_i64
    ], 64_i64);
}

/// Starts a new SHA-384 computation.
pub Sha512State New384() {
    return NewWith([
        0xcbbb9d5dc1059ed8_i64, 0x629a292a367cd507_i64, 0x9159015a3070dd17_i64, 0x152fecd8f70e5939_i64,
        0x67332667ffc00b31_i64, 0x8eb44a8768581511_i64, 0xdb0c2e0d64f98fa7_i64, 0x47b5481dbefa4fa4_i64
    ], 48_i64);
}

/// Digest length in bytes of this state: 48 for SHA-384, 64 for SHA-512.
pub i64 DigestLength(Sha512State state) { return state.meta[3]; }

/// Returns an independent copy of a running computation.
pub Sha512State Clone(Sha512State state) {
    Sha512State copy = NewWith([0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64], state.meta[3]);
    mut i64 i = 0_i64;
    while i < 8_i64 { copy.h[i] = state.h[i]; i = i + 1_i64; }
    Slice.Copy(copy.buffer, 0_i64, state.buffer, 0_i64, 128_i64);
    copy.meta[0] = state.meta[0];
    copy.meta[1] = state.meta[1];
    copy.meta[2] = state.meta[2];
    return copy;
}

i64 Rotr(i64 x, i64 n) { return (x >> n) | (x << (64_i64 - n)); }
i64 Xor(i64 a, i64 b) { return (a | b) - (a & b); }

unit Compress(Sha512State state, u8[] data, i64 offset) {
    i64[] w = state.w;
    i64[] k = state.k;
    mut i64 t = 0_i64;
    while t < 16_i64 {
        i64 p = offset + t * 8_i64;
        mut i64 v = 0_i64;
        mut i64 j = 0_i64;
        while j < 8_i64 { v = (v << 8_i64) | i64(data[p + j]); j = j + 1_i64; }
        w[t] = v;
        t = t + 1_i64;
    }
    while t < 80_i64 {
        i64 w15 = w[t - 15_i64];
        i64 w2 = w[t - 2_i64];
        i64 s0 = Xor(Xor(Rotr(w15, 1_i64), Rotr(w15, 8_i64)), w15 >> 7_i64);
        i64 s1 = Xor(Xor(Rotr(w2, 19_i64), Rotr(w2, 61_i64)), w2 >> 6_i64);
        w[t] = w[t - 16_i64] + s0 + w[t - 7_i64] + s1;
        t = t + 1_i64;
    }
    i64[] h = state.h;
    mut i64 a = h[0]; mut i64 b = h[1]; mut i64 c = h[2]; mut i64 d = h[3];
    mut i64 e = h[4]; mut i64 f = h[5]; mut i64 g = h[6]; mut i64 hh = h[7];
    t = 0_i64;
    while t < 80_i64 {
        i64 bigS1 = Xor(Xor(Rotr(e, 14_i64), Rotr(e, 18_i64)), Rotr(e, 41_i64));
        i64 ch = (e & f) | ((-1_i64 - e) & g);
        i64 t1 = hh + bigS1 + ch + k[t] + w[t];
        i64 bigS0 = Xor(Xor(Rotr(a, 28_i64), Rotr(a, 34_i64)), Rotr(a, 39_i64));
        i64 maj = (a & b) | (c & (a | b));
        i64 t2 = bigS0 + maj;
        hh = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
        t = t + 1_i64;
    }
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
    h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
    return;
}

/// Absorbs `count` bytes of `data` from `offset`. Returns false for an invalid range or a finished state.
pub bool UpdateRange(Sha512State state, u8[] data, i64 offset, i64 count) {
    if state.meta[2] != 0_i64 { return false; }
    if !Slice.IsValidRange(Slice.Len(data), offset, count) { return false; }
    mut i64 pos = offset;
    i64 end = offset + count;
    mut i64 buffered = state.meta[0];
    state.meta[1] = state.meta[1] + count;
    if buffered > 0_i64 {
        while buffered < 128_i64 && pos < end {
            state.buffer[buffered] = data[pos];
            buffered = buffered + 1_i64;
            pos = pos + 1_i64;
        }
        if buffered < 128_i64 { state.meta[0] = buffered; return true; }
        Compress(state, state.buffer, 0_i64);
        buffered = 0_i64;
    }
    while end - pos >= 128_i64 {
        Compress(state, data, pos);
        pos = pos + 128_i64;
    }
    while pos < end {
        state.buffer[buffered] = data[pos];
        buffered = buffered + 1_i64;
        pos = pos + 1_i64;
    }
    state.meta[0] = buffered;
    return true;
}

pub bool Update(Sha512State state, u8[] data) {
    return UpdateRange(state, data, 0_i64, Slice.Len(data));
}

/// Pads and returns the digest (48 or 64 bytes). The state cannot be updated afterwards.
/// Message length is tracked in bytes as i64, so the high 64 bits of the 128-bit length field are zero.
pub u8[] Finish(Sha512State state) {
    u8[] out = Slice.New(state.meta[3]);
    if state.meta[2] == 0_i64 {
        i64 byteLength = state.meta[1];
        mut i64 buffered = state.meta[0];
        state.buffer[buffered] = 0x80_u8;
        buffered = buffered + 1_i64;
        if buffered > 112_i64 {
            while buffered < 128_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
            Compress(state, state.buffer, 0_i64);
            buffered = 0_i64;
        }
        while buffered < 128_i64 { state.buffer[buffered] = 0_u8; buffered = buffered + 1_i64; }
        // 128-bit big-endian bit length: high word carries the top 3 bits of the byte count.
        state.buffer[119] = u8((byteLength >> 61_i64) & 0xFF_i64);
        i64 bitLength = byteLength << 3_i64;
        mut i64 i = 0_i64;
        while i < 8_i64 {
            state.buffer[120_i64 + i] = u8((bitLength >> ((7_i64 - i) * 8_i64)) & 0xFF_i64);
            i = i + 1_i64;
        }
        Compress(state, state.buffer, 0_i64);
        state.meta[0] = 0_i64;
        state.meta[2] = 1_i64;
    }
    mut i64 i = 0_i64;
    while i < state.meta[3] {
        i64 word = state.h[i / 8_i64];
        out[i] = u8((word >> ((7_i64 - (i % 8_i64)) * 8_i64)) & 0xFF_i64);
        i = i + 1_i64;
    }
    return out;
}

/// One-shot SHA-512.
pub u8[] Hash512(u8[] data) {
    Sha512State state = New512();
    Update(state, data);
    return Finish(state);
}

/// One-shot SHA-384.
pub u8[] Hash384(u8[] data) {
    Sha512State state = New384();
    Update(state, data);
    return Finish(state);
}
