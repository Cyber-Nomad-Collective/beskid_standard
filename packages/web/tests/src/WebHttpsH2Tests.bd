use Concurrency;
use Concurrency.Fiber;
use Core.Bytes.Convert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Codec.Hex;
use Http.Types;
use Http2.Server;
use Network.Types as NetTypes;
use Network.Tcp.TcpListener;
use Testing.Assert;
use Tls.PeerKeys;
use Tls.TlsConfig;
use X509.X509Errors;
use Web;
use Web.WebClient;
use Web.WebConfig;
use Web.WebErrors;

// GET answers "hello <target>"; POST answers "received <length>".
type Hello: RequestHandler {
    i64 tag,
    pub Response Handle(Request request) { return Answer(request); }
}

Response Answer(Request request) {
    mut Header[] headers = Array.Empty<Header>();
    Array.Append<Header>(headers, Header { name: "content-type", value: "text/plain" });
    if request.method == "POST" {
        return Response { status: 200_i64, reason: "OK", headers: headers, body: Convert.StringToBytes("received " + Dec(Slice.Len(request.body))) };
    }
    return Response { status: 200_i64, reason: "OK", headers: headers, body: Convert.StringToBytes("hello " + request.target) };
}

string Dec(i64 v) {
    if v < 0_i64 { return "-" + Dec(0_i64 - v); }
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

SocketAddress Loopback4() {
    Port value = match NetTypes.PortNumber(0_i64) { Result::Ok(p) => p, Result::Error(_) => NetTypes.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

string BaseUrl(TcpListener listener, string scheme, string hostName) {
    return match listener.LocalAddress() {
        Result::Ok(address) => scheme + "://" + hostName + ":" + Dec(address.port.Value()),
        Result::Error(_) => "",
    };
}

// Records [kind, detail] of a failure, or [0, 0], at codes[at], codes[at + 1].
unit Record(i64[] codes, i64 at, Result<WebResponse, WebError> r) {
    match r {
        Result::Ok(_) => { codes[at] = 0_i64; codes[at + 1_i64] = 0_i64; },
        Result::Error(e) => { codes[at] = WebErrors.Code(e); codes[at + 1_i64] = WebErrors.Detail(e); },
    };
    return;
}

string TextOf(u8[] body) {
    return match Convert.BytesToString(body) { Result::Ok(t) => t, Result::Error(_) => "<binary>", };
}

string BodyOf(WebResponse w) { Response r = w.response; return TextOf(r.body); }
i64 StatusIn(WebResponse w) { Response r = w.response; return r.status; }

string BodyText(Result<WebResponse, WebError> r) {
    return match r {
        Result::Ok(w) => BodyOf(w),
        Result::Error(e) => "<error " + WebErrors.KindOf(e) + ">",
    };
}

string ProtocolOf(Result<WebResponse, WebError> r) {
    return match r { Result::Ok(w) => w.protocol, Result::Error(_) => "<error>", };
}

i64 StatusOf(Result<WebResponse, WebError> r) {
    return match r { Result::Ok(w) => StatusIn(w), Result::Error(_) => -1_i64, };
}

unit Expect(i64 actual, i64 expected, string what) {
    if actual != expected { Assert.Fail(what + ": got " + Dec(actual) + ", expected " + Dec(expected)); }
    return;
}

unit ExpectText(string actual, string expected, string what) {
    if actual != expected { Assert.Fail(what + ": got [" + actual + "], expected [" + expected + "]"); }
    return;
}

TlsServerConfig ServerConfig() {
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    return WebConfig.ServerTls(TlsConfig.Chain1(ServerCertDer()), key);
}

// Trusts only the test root (explicit trust, no system bundle).
WebClientConfig ClientConfig(string[] alpn) {
    mut WebClientConfig c = WebConfig.DefaultClient();
    Result<CertificateVerification, X509Error> v = TlsConfig.Anchors(TlsConfig.Chain1(RootCertDer()));
    match v {
        Result::Ok(verification) => { c.trust = Option.FromValue<CertificateVerification>(verification); },
        Result::Error(_) => {},
    };
    c.alpn = alpn;
    return c;
}

unit ServeTlsN(TcpListener l, i64 connections, i64[] served) {
    Hello handler = Hello { tag: 0_i64 };
    mut WebServerConfig c = WebConfig.DefaultServer();
    c.maxConnections = connections;
    c.acceptTimeoutMillis = 120000_i64;
    Result<i64, WebError> r = Web.ServeTls(l, ServerConfig(), handler, c);
    match r {
        Result::Ok(n) => { served[0] = n; },
        Result::Error(e) => { served[0] = 100_i64 + WebErrors.Code(e); },
    };
    return;
}

Request Get(string url) {
    return Request { method: "GET", target: url, headers: Array.Empty<Header>(), body: Slice.New(0_i64) };
}

Request Post(string url, i64 size) {
    return Request { method: "POST", target: url, headers: Array.Empty<Header>(), body: Slice.New(size) };
}

// codes: [0] server result, [1..2] GET error, [3] GET status, [4..5] POST error, [6] POST status.
// texts: [0] GET body, [1] GET protocol, [2] POST body, [3] POST protocol.
unit TlsScenario(string[] alpn, i64[] codes, string[] texts) {
    match TcpListener.Bind(Loopback4(), 4_i64) {
        Result::Error(_) => { codes[0] = -1_i64; },
        Result::Ok(listener) => {
            TcpListener l = listener;
            i64[] served = [0_i64];
            Fiber<unit> server = spawn (() => ServeTlsN(l, 2_i64, served));
            string base = BaseUrl(l, "https", "localhost");
            WebClientConfig config = ClientConfig(alpn);
            Result<WebResponse, WebError> got = Web.Exchange(Get(base + "/hello?a=1"), config);
            Record(codes, 1_i64, got);
            codes[3] = StatusOf(got);
            texts[0] = BodyText(got);
            texts[1] = ProtocolOf(got);
            Result<WebResponse, WebError> posted = Web.Exchange(Post(base + "/upload", 3000_i64), config);
            Record(codes, 4_i64, posted);
            codes[6] = StatusOf(posted);
            texts[2] = BodyText(posted);
            texts[3] = ProtocolOf(posted);
            server.Join();
            codes[0] = served[0];
            l.Close();
        },
    };
    return;
}

unit CheckTls(i64[] codes, string[] texts, string protocol) {
    Expect(codes[1] * 1000_i64 + codes[2], 0_i64, "GET error kind*1000+detail");
    Expect(codes[3], 200_i64, "GET status");
    ExpectText(texts[0], "hello /hello?a=1", "GET body");
    ExpectText(texts[1], protocol, "GET protocol");
    Expect(codes[4] * 1000_i64 + codes[5], 0_i64, "POST error kind*1000+detail");
    Expect(codes[6], 200_i64, "POST status");
    ExpectText(texts[2], "received 3000", "POST body");
    ExpectText(texts[3], protocol, "POST protocol");
    Expect(codes[0], 2_i64, "server connections served");
    return;
}

// https:// with ALPN ["h2", "http/1.1"]: the server prefers h2.
test web_https_h2 {
    i64[] codes = [0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64];
    string[] texts = ["", "", "", ""];
    string[] alpn = WebConfig.DefaultAlpn();
    Fiber<unit> scenario = spawn (() => TlsScenario(alpn, codes, texts));
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
    CheckTls(codes, texts, "h2");
}

