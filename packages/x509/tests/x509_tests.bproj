x509_tests {
  name = "x509_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "Encoding" { kind = Lib entry = "EncodingTests.bd" }
target "Certificates" { kind = Lib entry = "CertificateTests.bd" }
target "Hostname" { kind = Lib entry = "HostnameTests.bd" }
