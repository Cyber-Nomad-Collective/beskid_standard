use Core.String;
use Uri.Chars;
use Uri.Types;

/// "[userinfo@]host[:port]" of the authority component (no leading "//").
pub string FormatAuthority(UriRef u) {
    mut string out = "";
    if u.hasUserinfo { out = out + u.userinfo + "@"; }
    out = Chars.Cat(out, u.hostName);
    if u.hasPort {
        out = out + ":";
        if u.port >= 0_i64 { out = out + Chars.DecimalText(u.port); }
    }
    return out;
}

/// RFC 3986 section 5.3 component recomposition. A path that would be mistaken for an
/// authority ("//..." without authority) is protected with a leading "/." segment.
pub string Format(UriRef u) {
    mut string out = "";
    if u.hasScheme { out = out + u.scheme + ":"; }
    if u.hasAuthority { out = out + "//" + FormatAuthority(u); }
    if !u.hasAuthority && Chars.StartsAt(u.path, 0_i64, "//") { out = out + "/."; }
    out = Chars.Cat(out, u.path);
    if u.hasQuery { out = out + "?" + u.query; }
    if u.hasFragment { out = out + "#" + u.fragment; }
    return out;
}
