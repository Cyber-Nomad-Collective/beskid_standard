use Core.Results;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Metadata;

pub type SourceLocation {
    pub string path,
    pub i64 start,
    pub i64 end,
}

/// A format reader owns representation, cursor/container bounds and source
/// locations. Generated Decoder<T> performs typed construction over this API.
/// Each successful read consumes exactly one value; container reads are nested.
pub contract Reader {
    SourceLocation Location();
    Result<unit, SerializationError> Begin(SerializationLimits limits);
    Result<unit, SerializationError> Finish();
    Result<unit, SerializationError> ReadUnit();
    Result<bool, SerializationError> ReadBoolean();
    Result<i64, SerializationError> ReadSigned(u8 width);
    Result<u64, SerializationError> ReadUnsigned(u8 width);
    Result<u64, SerializationError> ReadFloat(u8 width);
    Result<char, SerializationError> ReadScalar();
    Result<string, SerializationError> ReadString();
    Result<u8[], SerializationError> ReadBytes();

    /// Count is checked before traversal or allocation, against aggregate limits.
    Result<i64, SerializationError> BeginRecord(Metadata.ShapeId shape);
    Result<string, SerializationError> BeginField();
    Result<unit, SerializationError> EndField();
    Result<unit, SerializationError> EndRecord();
    Result<i64, SerializationError> BeginSequence();
    Result<unit, SerializationError> EndSequence();
    Result<i64, SerializationError> BeginMap();
    Result<string, SerializationError> BeginMapEntry();
    Result<unit, SerializationError> EndMapEntry();
    Result<unit, SerializationError> EndMap();
    Result<string, SerializationError> BeginVariant(Metadata.ShapeId shape);
    Result<i64, SerializationError> VariantCount();
    Result<unit, SerializationError> EndVariant();
    Result<bool, SerializationError> BeginOptional();
    Result<unit, SerializationError> EndOptional();
}

/// A typed field factory binds the exact source T to one format reader R.
/// Generated adapters retain this application instead of guessing a function
/// name from T or boxing unknown fields into a universal value.
pub contract FieldDecoder<T, R> {
    Result<T, SerializationError> Read(R reader, SerializationLimits limits);
}
