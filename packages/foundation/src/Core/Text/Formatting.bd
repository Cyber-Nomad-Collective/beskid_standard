/// The text form of a value.
/// @tier(standard)
/// A type that conforms to `Formatting` gives its value as text. `Testing.Assert.Equal` and
/// `Testing.Expect.Equal` use it to show the expected and the actual value of a failed comparison.
///
/// Every integer type, both float types, `bool`, `char` and `string` conform. Their
/// implementations are in this file, because an implementation for a primitive type is allowed
/// only in the file that declares its contract.
use Core.String;

/// A value that has a text form.
pub contract Formatting
{
    /// The text form of the value: decimal digits for an integer, the shortest text that reads
    /// back as the same value for a float, `true` or `false`, the character itself, and the text
    /// of a string unchanged.
    string Format();
}

impl i8 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl i16 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl i32 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl i64 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl u8 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl u16 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl u32 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl u64 : Formatting
{
    pub string Format()
    {
        return Unsigned(this);
    }
}

impl word : Formatting
{
    pub string Format()
    {
        return Unsigned(u64(this));
    }
}

impl f32 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl f64 : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl bool : Formatting
{
    pub string Format()
    {
        return "${this}";
    }
}

impl char : Formatting
{
    pub string Format()
    {
        return Scalar(u32(this));
    }
}

impl string : Formatting
{
    pub string Format()
    {
        return this;
    }
}

/// Decimal digits of an unsigned value. String interpolation covers the signed range only.
string Unsigned(u64 value)
{
    if (value < 10_u64)
    {
        return "${i64(value)}";
    }
    return Unsigned(value / 10_u64) + "${i64(value % 10_u64)}";
}

/// The UTF-8 text of one Unicode scalar value.
string Scalar(u32 code)
{
    if (code < 128_u32)
    {
        u8[] one = [u8(code)];
        return Utf8Text(one);
    }
    if (code < 2048_u32)
    {
        u8[] two = [u8(192_u32 + code / 64_u32), u8(128_u32 + code % 64_u32)];
        return Utf8Text(two);
    }
    if (code < 65536_u32)
    {
        u8[] three = [u8(224_u32 + code / 4096_u32), u8(128_u32 + code / 64_u32 % 64_u32), u8(128_u32 + code % 64_u32)];
        return Utf8Text(three);
    }
    u8[] four = [u8(240_u32 + code / 262144_u32), u8(128_u32 + code / 4096_u32 % 64_u32), u8(128_u32 + code / 64_u32 % 64_u32), u8(128_u32 + code % 64_u32)];
    return Utf8Text(four);
}

/// Text of validated UTF-8 code units.
string Utf8Text(u8[] bytes)
{
    return String.FromUtf8CodeUnits(bytes);
}
