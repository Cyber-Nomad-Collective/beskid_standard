/// Runs the shared known-answer vectors (`Vectors.bd`) through both providers: `P*` helpers force
/// the pure kernels with `BESKID_CRYPTO_PROVIDER=pure`, `N*` helpers clear the switch so the
/// native OpenSSL provider serves the call. The other targets run the same vectors only through
/// the provider that the host selects. Also checks tag rejection, the no-plaintext-on-failure
/// rule, offsets, and provider selection. Needs a host with OpenSSL 3 (`libcrypto.so.3`).
use Testing.Assert;
use Core.Bytes.Slice;
use Core.Results;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Errors;
use Crypto.Hmac;
use Crypto.Sha256;
use Crypto.Sha512;
use Crypto.Provider;
use TestSupport;
use Vectors;

unit UsePure()
{
    Provider.ForcePure(true);
    return;
}

unit UseNative()
{
    Provider.ForcePure(false);
    return;
}

u8[] PSha256(u8[] m)
{
    UsePure();
    u8[] r = Sha256.Hash(m);
    UseNative();
    return r;
}

u8[] NSha256(u8[] m)
{
    UseNative();
    return Sha256.Hash(m);
}

u8[] PSha512(u8[] m)
{
    UsePure();
    u8[] r = Sha512.Hash512(m);
    UseNative();
    return r;
}

u8[] NSha512(u8[] m)
{
    UseNative();
    return Sha512.Hash512(m);
}

u8[] PSha384(u8[] m)
{
    UsePure();
    u8[] r = Sha512.Hash384(m);
    UseNative();
    return r;
}

u8[] NSha384(u8[] m)
{
    UseNative();
    return Sha512.Hash384(m);
}

u8[] PHmac(HashAlgorithm a, u8[] k, u8[] m)
{
    UsePure();
    u8[] r = Hmac.Compute(a, k, m);
    UseNative();
    return r;
}

u8[] NHmac(HashAlgorithm a, u8[] k, u8[] m)
{
    UseNative();
    return Hmac.Compute(a, k, m);
}

u8[] PDigest(HashAlgorithm a, u8[] m)
{
    UsePure();
    u8[] r = Hmac.Digest(a, m);
    UseNative();
    return r;
}

u8[] NDigest(HashAlgorithm a, u8[] m)
{
    UseNative();
    return Hmac.Digest(a, m);
}

Result<AesGcmKey, CryptoError> PAesKey(u8[] k)
{
    UsePure();
    Result<AesGcmKey, CryptoError> r = AesGcm.New(k);
    UseNative();
    return r;
}

Result<AesGcmKey, CryptoError> NAesKey(u8[] k)
{
    UseNative();
    return AesGcm.New(k);
}

Result<u8[], CryptoError> PChaSeal(u8[] k, u8[] n, u8[] a, u8[] m)
{
    UsePure();
    Result<u8[], CryptoError> r = ChaCha20Poly1305.Seal(k, n, a, m);
    UseNative();
    return r;
}

Result<u8[], CryptoError> NChaSeal(u8[] k, u8[] n, u8[] a, u8[] m)
{
    UseNative();
    return ChaCha20Poly1305.Seal(k, n, a, m);
}

Result<u8[], CryptoError> PChaOpen(u8[] k, u8[] n, u8[] a, u8[] m)
{
    UsePure();
    Result<u8[], CryptoError> r = ChaCha20Poly1305.Open(k, n, a, m);
    UseNative();
    return r;
}

Result<u8[], CryptoError> NChaOpen(u8[] k, u8[] n, u8[] a, u8[] m)
{
    UseNative();
    return ChaCha20Poly1305.Open(k, n, a, m);
}

Result<unit, CryptoError> PChaSealInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo)
{
    UsePure();
    Result<unit, CryptoError> r = ChaCha20Poly1305.SealInto(k, n, a, i, io, c, o, oo);
    UseNative();
    return r;
}

Result<unit, CryptoError> NChaSealInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo)
{
    UseNative();
    return ChaCha20Poly1305.SealInto(k, n, a, i, io, c, o, oo);
}

Result<i64, CryptoError> NChaOpenInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo)
{
    UseNative();
    return ChaCha20Poly1305.OpenInto(k, n, a, i, io, c, o, oo);
}

bool AuthFailLen(Result<i64, CryptoError> r)
{
    return match (r)
    {
        Result::Ok(_) => false,
        Result::Error(e) => match (e)
        {
            CryptoError::AuthenticationFailed => true,
            _ => false,
        },
    };
}

u8 Flip(u8 b)
{
    return (b | 1_u8) - (b & 1_u8);
}

unit CheckDigests(DigestVector[] vectors, i64 bits)
{
    for v in vectors
    {
        u8[] expected = Hex(v.digest);
        if (bits == 256)
        {
            Assert.True(Same(PSha256(v.message), expected), "pure " + v.label);
            Assert.True(Same(NSha256(v.message), expected), "native " + v.label);
        }
        if (bits == 384)
        {
            Assert.True(Same(PSha384(v.message), expected), "pure " + v.label);
            Assert.True(Same(NSha384(v.message), expected), "native " + v.label);
        }
        if (bits == 512)
        {
            Assert.True(Same(PSha512(v.message), expected), "pure " + v.label);
            Assert.True(Same(NSha512(v.message), expected), "native " + v.label);
        }
    }
}

unit CheckAes(AeadVector v)
{
    match (PAesKey(v.key))
    {
        Result::Error(_) => {
            Assert.Fail("pure key " + v.label);
        },
        Result::Ok(pure) => {
            match (NAesKey(v.key))
            {
                Result::Error(_) => {
                    Assert.Fail("native key " + v.label);
                },
                Result::Ok(native) => {
                    u8[] a = Unwrap(AesGcm.Seal(pure, v.nonce, v.aad, v.plaintext));
                    u8[] b = Unwrap(AesGcm.Seal(native, v.nonce, v.aad, v.plaintext));
                    Assert.True(Same(a, Hex(v.sealed)), "pure " + v.label);
                    Assert.True(Same(b, Hex(v.sealed)), "native " + v.label);
                    Assert.True(Same(Unwrap(AesGcm.Open(native, v.nonce, v.aad, a)), v.plaintext), "native opens pure " + v.label);
                    Assert.True(Same(Unwrap(AesGcm.Open(pure, v.nonce, v.aad, b)), v.plaintext), "pure opens native " + v.label);
                },
            };
        },
    };
    return;
}

unit CheckLongAes(LongAeadVector v)
{
    u8[] message = LongMessage(v.length);
    match (PAesKey(LongKey(v.keyLength)))
    {
        Result::Error(_) => {
            Assert.Fail("pure key " + v.label);
        },
        Result::Ok(pure) => {
            match (NAesKey(LongKey(v.keyLength)))
            {
                Result::Error(_) => {
                    Assert.Fail("native key " + v.label);
                },
                Result::Ok(native) => {
                    u8[] a = Unwrap(AesGcm.Seal(pure, LongNonce(), LongAad(), message));
                    u8[] b = Unwrap(AesGcm.Seal(native, LongNonce(), LongAad(), message));
                    Assert.True(Same(PSha256(a), Hex(v.sealedDigest)), "pure " + v.label);
                    Assert.True(Same(a, b), "native equals pure " + v.label);
                    Assert.True(Same(Unwrap(AesGcm.Open(native, LongNonce(), LongAad(), b)), message), "native open " + v.label);
                },
            };
        },
    };
    return;
}

mod PureAndNativeTests
{
    test Sha256MatchFips180Examples
    {
        CheckDigests(Sha256Vectors(), 256);
    }

    test Sha384MatchFips180Examples
    {
        CheckDigests(Sha384Vectors(), 384);
    }

    test Sha512MatchFips180Examples
    {
        CheckDigests(Sha512Vectors(), 512);
    }

    test HmacMatchRfc4231
    {
        for v in HmacVectors()
        {
            u8[] pure = PHmac(v.algorithm, Hex(v.key), Hex(v.message));
            u8[] native = NHmac(v.algorithm, Hex(v.key), Hex(v.message));
            Assert.True(Same(Prefix(pure, v.length), Hex(v.tag)), "pure " + v.label);
            Assert.True(Same(pure, native), "native equals pure " + v.label);
        }
    }

    test AesGcmMatchTheGcmSpecification
    {
        for v in AesGcmVectors()
        {
            CheckAes(v);
        }
    }

    test ChaCha20Poly1305MatchRfc8439
    {
        for v in ChaCha20Poly1305Vectors()
        {
            u8[] a = Unwrap(PChaSeal(v.key, v.nonce, v.aad, v.plaintext));
            u8[] b = Unwrap(NChaSeal(v.key, v.nonce, v.aad, v.plaintext));
            Assert.True(Same(a, Hex(v.sealed)), "pure " + v.label);
            Assert.True(Same(b, Hex(v.sealed)), "native " + v.label);
            Assert.True(Same(Unwrap(NChaOpen(v.key, v.nonce, v.aad, a)), v.plaintext), "native opens pure " + v.label);
            Assert.True(Same(Unwrap(PChaOpen(v.key, v.nonce, v.aad, b)), v.plaintext), "pure opens native " + v.label);
        }
    }

    test AgreeOnLongChaCha20Poly1305Messages
    {
        for v in LongChaCha20Poly1305Vectors()
        {
            u8[] message = LongMessage(v.length);
            u8[] a = Unwrap(PChaSeal(LongKey(v.keyLength), LongNonce(), LongAad(), message));
            u8[] b = Unwrap(NChaSeal(LongKey(v.keyLength), LongNonce(), LongAad(), message));
            Assert.True(Same(PSha256(a), Hex(v.sealedDigest)), "pure " + v.label);
            Assert.True(Same(a, b), "native equals pure " + v.label);
            Assert.True(Same(Unwrap(NChaOpen(LongKey(v.keyLength), LongNonce(), LongAad(), b)), message), "native open " + v.label);
        }
    }

    test AgreeOnLongAesGcmMessages
    {
        for v in LongAesGcmVectors()
        {
            CheckLongAes(v);
        }
    }
}

mod ProviderTests
{
    test ShaLengthSweep
    {
        mut i64 n = 0_i64;
        while (n <= 300_i64)
        {
            u8[] m = Pattern(n, 11_i64, 5_i64);
            Assert.True(Same(PSha256(m), NSha256(m)), "sha256 sweep");
            Assert.True(Same(PSha384(m), NSha384(m)), "sha384 sweep");
            Assert.True(Same(PSha512(m), NSha512(m)), "sha512 sweep");
            n = n + 13_i64;
        }
    }

    test HmacLongKeySweep
    {
        u8[] data = Pattern(1000_i64, 3_i64, 1_i64);
        mut i64 k = 0_i64;
        while (k <= 200_i64)
        {
            u8[] key = Pattern(k, 5_i64, 7_i64);
            Assert.True(Same(PHmac(HashAlgorithm::Sha256, key, data), NHmac(HashAlgorithm::Sha256, key, data)), "hmac-sha256 key sweep");
            Assert.True(Same(PHmac(HashAlgorithm::Sha512, key, data), NHmac(HashAlgorithm::Sha512, key, data)), "hmac-sha512 key sweep");
            Assert.True(Same(PDigest(HashAlgorithm::Sha384, key), NDigest(HashAlgorithm::Sha384, key)), "digest sweep");
            k = k + 25_i64;
        }
    }

    test AeadOffsetsInPlace
    {
        u8[] key = Pattern(32_i64, 1_i64, 0_i64);
        u8[] nonce = Pattern(12_i64, 2_i64, 1_i64);
        u8[] aad = Pattern(5_i64, 1_i64, 9_i64);
        u8[] pureBuf = Pattern(300_i64, 7_i64, 1_i64);
        u8[] nativeBuf = Pattern(300_i64, 7_i64, 1_i64);
        u8[] original = Pattern(300_i64, 7_i64, 1_i64);
        // ChaCha20-Poly1305 in place at offset 9, 200 bytes.
        Assert.True(match (PChaSealInto(key, nonce, aad, pureBuf, 9_i64, 200_i64, pureBuf, 9_i64))
        {
            Result::Ok(_) => true,
            Result::Error(_) => false,
        }, "pure seal into");
        Assert.True(match (NChaSealInto(key, nonce, aad, nativeBuf, 9_i64, 200_i64, nativeBuf, 9_i64))
        {
            Result::Ok(_) => true,
            Result::Error(_) => false,
        }, "native seal into");
        Assert.True(Same(pureBuf, nativeBuf), "chacha in place equal");
        i64 opened = match (NChaOpenInto(key, nonce, aad, nativeBuf, 9_i64, 216_i64, nativeBuf, 9_i64))
        {
            Result::Ok(n) => n,
            Result::Error(_) => -1_i64,
        };
        Assert.Equal<i64>(opened, 200_i64, "native open into length");
        Assert.True(Same(Prefix(nativeBuf, 209_i64), Prefix(original, 209_i64)), "native open into restores plaintext");
        match (PAesKey(Pattern(16_i64, 1_i64, 0_i64)))
        {
            Result::Error(_) => {
                Assert.Fail("pure key");
            },
            Result::Ok(pure) => {
                match (NAesKey(Pattern(16_i64, 1_i64, 0_i64)))
                {
                    Result::Error(_) => {
                        Assert.Fail("native key");
                    },
                    Result::Ok(native) => {
                        u8[] p = Pattern(300_i64, 7_i64, 1_i64);
                        u8[] q = Pattern(300_i64, 7_i64, 1_i64);
                        Assert.True(match (AesGcm.SealInto(pure, nonce, aad, p, 31_i64, 150_i64, p, 31_i64))
                        {
                            Result::Ok(_) => true,
                            Result::Error(_) => false,
                        }, "pure aes seal into");
                        Assert.True(match (AesGcm.SealInto(native, nonce, aad, q, 31_i64, 150_i64, q, 31_i64))
                        {
                            Result::Ok(_) => true,
                            Result::Error(_) => false,
                        }, "native aes seal into");
                        Assert.True(Same(p, q), "aes in place equal");
                        i64 n = match (AesGcm.OpenInto(native, nonce, aad, q, 31_i64, 166_i64, q, 31_i64))
                        {
                            Result::Ok(v) => v,
                            Result::Error(_) => -1_i64,
                        };
                        Assert.Equal<i64>(n, 150_i64, "native aes open into length");
                        Assert.True(Same(Prefix(q, 181_i64), Prefix(original, 181_i64)), "native aes open into restores plaintext");
                    },
                };
            },
        };
    }

    test AeadLengthSweep
    {
        u8[] key = Pattern(32_i64, 3_i64, 2_i64);
        u8[] nonce = Pattern(12_i64, 5_i64, 4_i64);
        match (PAesKey(key))
        {
            Result::Error(_) => {
                Assert.Fail("pure key");
            },
            Result::Ok(pure) => {
                match (NAesKey(key))
                {
                    Result::Error(_) => {
                        Assert.Fail("native key");
                    },
                    Result::Ok(native) => {
                        mut i64 n = 0_i64;
                        while (n <= 130_i64)
                        {
                            u8[] m = Pattern(n, 9_i64, 1_i64);
                            u8[] aad = Pattern(n % 37_i64, 1_i64, 3_i64);
                            Assert.True(Same(Unwrap(AesGcm.Seal(pure, nonce, aad, m)), Unwrap(AesGcm.Seal(native, nonce, aad, m))), "aes sweep");
                            Assert.True(Same(Unwrap(PChaSeal(key, nonce, aad, m)), Unwrap(NChaSeal(key, nonce, aad, m))), "chacha sweep");
                            n = n + 7_i64;
                        }
                    },
                };
            },
        };
    }

    test NativeAesGcmRejectsTampering
    {
        meta
        {
            tags = "native-crypto";
        }

        u8[] nonce = Hex("cafebabefacedbaddecaf888");
        u8[] aad = Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2");
        match (NAesKey(Hex("feffe9928665731c6d6a8f9467308308")))
        {
            Result::Error(_) => {
                Assert.Fail("key");
            },
            Result::Ok(key) => {
                u8[] sealed = Unwrap(AesGcm.Seal(key, nonce, aad, Pattern(60_i64, 1_i64, 0_i64)));
                mut i64 position = 0_i64;
                while (position < Slice.Len(sealed))
                {
                    u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
                    copy[position] = Flip(copy[position]);
                    Assert.True(AuthenticationFailed(AesGcm.Open(key, nonce, aad, copy)), "tampered byte rejected");
                    position = position + 7_i64;
                }
                Assert.True(AuthenticationFailed(AesGcm.Open(key, Hex("cafebabefacedbaddecaf889"), aad, sealed)), "nonce bound");
                Assert.True(AuthenticationFailed(AesGcm.Open(key, nonce, Hex("feedface"), sealed)), "aad bound");
                Assert.True(AuthenticationFailed(AesGcm.Open(key, nonce, aad, Slice.New(15_i64))), "short input");
                bool badNonce = match (AesGcm.Seal(key, Hex("cafebabe"), aad, sealed))
                {
                    Result::Ok(_) => false,
                    Result::Error(e) => match (e)
                    {
                        CryptoError::InvalidNonceLength => true,
                        _ => false,
                    },
                };
                Assert.True(badNonce, "nonce length");
                // A failed OpenInto leaves no plaintext in the output range.
                u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
                copy[70] = Flip(copy[70]);
                u8[] output = Pattern(64_i64, 0_i64, 170_i64);
                Assert.True(AuthFailLen(AesGcm.OpenInto(key, nonce, aad, copy, 0_i64, 76_i64, output, 2_i64)), "open into rejected");
                Assert.True(Same(Prefix(output, 2_i64), Pattern(2_i64, 0_i64, 170_i64)), "bytes before the range untouched");
                Assert.True(Same(Slice.SubSlice(output, 2_i64, 60_i64), Slice.New(60_i64)), "output range zeroed");
                Assert.True(Same(Slice.SubSlice(output, 62_i64, 2_i64), Pattern(2_i64, 0_i64, 170_i64)), "bytes after the range untouched");
            },
        };
        bool badKey = match (NAesKey(Slice.New(20_i64)))
        {
            Result::Ok(_) => false,
            Result::Error(e) => match (e)
            {
                CryptoError::InvalidKeyLength => true,
                _ => false,
            },
        };
        Assert.True(badKey, "key length");
    }

    test NativeChacha20poly1305RejectsTampering
    {
        meta
        {
            tags = "native-crypto";
        }

        u8[] key = Pattern(32_i64, 1_i64, 128_i64);
        u8[] nonce = Hex("070000004041424344454647");
        u8[] aad = Hex("50515253c0c1c2c3c4c5c6c7");
        u8[] sealed = Unwrap(NChaSeal(key, nonce, aad, Ascii(Sunscreen())));
        mut i64 position = 0_i64;
        while (position < Slice.Len(sealed))
        {
            u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
            copy[position] = Flip(copy[position]);
            Assert.True(AuthenticationFailed(NChaOpen(key, nonce, aad, copy)), "tampered byte rejected");
            position = position + 17_i64;
        }
        Assert.True(AuthenticationFailed(NChaOpen(key, nonce, Hex("50515253c0c1c2c3c4c5c6c8"), sealed)), "aad bound");
        Assert.True(AuthenticationFailed(NChaOpen(key, Hex("070000004041424344454648"), aad, sealed)), "nonce bound");
        Assert.True(AuthenticationFailed(NChaOpen(key, nonce, aad, Slice.New(15_i64))), "short input");
        u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
        copy[0] = Flip(copy[0]);
        i64 total = Slice.Len(copy);
        Assert.True(AuthFailLen(NChaOpenInto(key, nonce, aad, copy, 0_i64, total, copy, 0_i64)), "in-place open rejected");
        Assert.True(Same(Prefix(copy, total - 16_i64), Slice.New(total - 16_i64)), "in-place range zeroed");
        bool badKey = match (NChaSeal(Slice.New(31_i64), nonce, aad, sealed))
        {
            Result::Ok(_) => false,
            Result::Error(e) => match (e)
            {
                CryptoError::InvalidKeyLength => true,
                _ => false,
            },
        };
        Assert.True(badKey, "key length");
    }

    test NativeIsSelectedOnThisHost
    {
        meta
        {
            tags = "native-crypto";
        }

        Assert.True(Provider.NativeAvailable(), "libcrypto.so.3 resolved");
        Assert.True(Provider.SelfTest(), "native self-test");
        UseNative();
        Assert.True(Provider.IsNative(), "native provider selected");
        match (NAesKey(Pattern(16_i64, 1_i64, 0_i64)))
        {
            Result::Error(_) => {
                Assert.Fail("native key");
            },
            Result::Ok(k) => {
                Assert.True(AesGcm.UsesNative(k), "key bound to the native provider");
            },
        };
    }

    test Selection
    {
        meta
        {
            tags = "native-crypto";
        }

        Assert.True(Provider.SelfTest(), "native self-test");
        UsePure();
        bool forced = match (Provider.Current())
        {
            ProviderKind::Pure => true,
            ProviderKind::Native => false,
        };
        Assert.True(forced, "BESKID_CRYPTO_PROVIDER=pure forces Pure");
        match (AesGcm.New(Pattern(16_i64, 1_i64, 0_i64)))
        {
            Result::Error(_) => {
                Assert.Fail("pure key");
            },
            Result::Ok(k) => {
                Assert.False(AesGcm.UsesNative(k), "key created under the switch stays pure");
            },
        };
        UseNative();
        bool native = match (Provider.Current())
        {
            ProviderKind::Pure => false,
            ProviderKind::Native => true,
        };
        Assert.True(native, "Native when the self-test passes");
    }
}
