use Core.Collections.Array;
use Core.Results;
use Tls.Alert;
use Tls.PeerKeys;
use Tls.TlsConfig;
use Tls.TlsErrors;

// Server certificate chain policy for the client. Returns the key that must have signed
// CertificateVerify.

pub Result<PeerKey, TlsError> VerifyServerChain(TlsClientConfig config, Blob[] chain) {
    if Array.Len<Blob>(chain) == 0_i64 { return Result::Error(TlsErrors.Fatal(Alert.DecodeError())); }
    Blob leaf = chain[0];
    CertificateVerification mode = config.verification;
    return match mode {
        CertificateVerification::DangerousAcceptAnyCertificate => PeerKeys.FromCertificate(leaf.data),
        // Chain building and RFC 6125 name checks need the X509 package; until it is wired
        // in, anchor-based verification fails closed.
        CertificateVerification::Anchors(_) => Result::Error(TlsErrors.Fatal(Alert.UnknownCa())),
    };
}
