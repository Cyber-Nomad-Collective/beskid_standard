Result<unit, NetworkError> PendingReadCloseResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Channel<i64> release = Channel<i64>.Create();
    Fiber<unit> server = spawn (() => CloseServerOnRelease(listener, release));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Fiber<i64> pending = spawn (() => ReadOne(client));
    Concurrency.Yield();
    Concurrency.Yield();
    Assert.Equal(ReadOne(client), -1_i64, "second read proves the first read is pending");
    match (Deadline.After(Time.FromMilliseconds(30000_i64)))
    {
        Result::Ok(future) => {
            TransferDeadlines policy = TransferDeadlines
            {
                read: Option.FromValue<Deadline>(future),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(policy))
            {
                Result::Ok(_) => true,
                _ => false,
            }, "pending read has an armed typed deadline");
        },
        Result::Error(_) => Assert.Fail("future duration creates a typed read deadline"),
    };
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "client closes while read is pending");
    i64 closedCode = match (pending.Join())
    {
        Result::Ok(code) => code,
        Result::Error(_) => -5_i64,
    };
    Assert.Equal(closedCode, -7_i64, "close wins the pending read before its deadline");
    Assert.True(match (Channel<i64>.Send(release, 1_i64))
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server is released after close");
    Assert.True(match (server.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server exits after close");
    Channel<i64>.Close(release);
    return Result::Ok(());
}

unit PendingReadClose()
{
    match (PendingReadCloseResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("pending read close scenario completes"),
    };
}

