// END GENERATED ChaCha20Kernels

bool ValidParameters(u8[] key, u8[] nonce) {
    return Slice.Len(key) == 32_i64 && Slice.Len(nonce) == 12_i64;
}

/// The 64-byte block function output for `counter` (RFC 8439 section 2.3).
/// Also the QUIC ChaCha20 header-protection mask source (RFC 9001 section 5.4.4).
pub Result<u8[], CryptoError> Block(u8[] key, u32 counter, u8[] nonce) {
    if Slice.Len(key) != 32_i64 { return Result::Error(CryptoError::InvalidKeyLength()); }
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    u32[] s = InitialState(key, nonce);
    s[12] = counter;
    u8[] out = Scratch.Bytes(64_i64);
    KeystreamBlock(s, out);
    return Result::Ok(out);
}

/// XORs `count` bytes of `input` at `inputOffset` with the keystream starting at block
/// `counter`, writing to `output` at `outputOffset`. Encryption and decryption are the same.
/// Keys and nonces must already be validated; returns false for invalid ranges or when the
/// 32-bit block counter would wrap.
pub bool XorInto(u8[] key, u32 counter, u8[] nonce, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    if !ValidParameters(key, nonce) { return false; }
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, count) { return false; }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count) { return false; }
    i64 blocks = (count + 63_i64) / 64_i64;
    if i64(counter) + blocks > 4294967296_i64 { return false; }
    u32[] s = InitialState(key, nonce);
    s[12] = counter;
    // Whole 256-byte groups go through the four-block SIMD kernel, the rest block by block.
    i64 grouped = (count / 256_i64) * 256_i64;
    if grouped > 0_i64 {
        i64[] meta = [inputOffset, outputOffset - inputOffset, inputOffset + grouped];
        XorBlocks4(s, input, output, meta);
    }
    u8[] stream = Scratch.Bytes(64_i64);
    mut i64 done = grouped;
    while done < count {
        KeystreamBlock(s, stream);
        s[12] = s[12] + 1_u32;
        mut i64 take = 64_i64;
        if count - done < take { take = count - done; }
        mut i64 j = 0_i64;
        while j < take {
            u8 a = input[inputOffset + done + j];
            u8 b = stream[j];
            output[outputOffset + done + j] = (a | b) - (a & b);
            j = j + 1_i64;
        }
        done = done + take;
    }
    return true;
}

/// One-shot ChaCha20 encryption or decryption of `data`.
pub Result<u8[], CryptoError> Apply(u8[] key, u32 counter, u8[] nonce, u8[] data) {
    if Slice.Len(key) != 32_i64 { return Result::Error(CryptoError::InvalidKeyLength()); }
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    u8[] out = Scratch.Bytes(Slice.Len(data));
    if !XorInto(key, counter, nonce, data, 0_i64, Slice.Len(data), out, 0_i64) {
        return Result::Error(CryptoError::InvalidLength());
    }
    return Result::Ok(out);
}
