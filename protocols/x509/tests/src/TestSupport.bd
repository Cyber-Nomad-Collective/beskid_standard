use Core.Bytes.Slice;
use Core.String;

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}

/// Hex text to bytes; spaces are skipped.
pub u8[] Hex(string text) {
    i64 len = String.Len(text);
    mut i64 count = 0_i64;
    mut i64 i = 0_i64;
    while i < len { if String.ByteAt(text, i) != 32_u8 { count = count + 1_i64; } i = i + 1_i64; }
    u8[] out = Slice.New(count / 2_i64);
    mut i64 o = 0_i64;
    mut bool high = true;
    mut u8 acc = 0_u8;
    i = 0_i64;
    while i < len {
        u8 c = String.ByteAt(text, i);
        if c != 32_u8 {
            if high { acc = Nibble(c) * 16_u8; high = false; }
            else { out[o] = acc + Nibble(c); o = o + 1_i64; high = true; }
        }
        i = i + 1_i64;
    }
    return out;
}
