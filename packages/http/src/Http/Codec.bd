    i64 headEnd = end + 2_i64;
    mut i64 lineEnd = 0_i64;
    while lineEnd + 1_i64 < headEnd && !(bytes[lineEnd] == u8(13) && bytes[lineEnd + 1_i64] == u8(10)) { lineEnd = lineEnd + 1_i64; }
    if lineEnd > limits.maxStartLine { return Result::Error(HttpError::InvalidStartLine()); }
    Result<i64,HttpError> status = RoleStatus(bytes, lineEnd, role);
    return match status {
        Result::Error(error) => Result::Error(error),
        Result::Ok(code) => {
