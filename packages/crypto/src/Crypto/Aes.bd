            %v11 = band %in8, %k10
            %v12 = bxor %in8, %v11
            %c13 = iconst.i32 4
            %v14 = bitcast.i32x4 little %v12
            %v15 = ushr %v14, %c13
            %v16 = bitcast.i8x16 little %v15
            %k17 = load.i8x16 %tp2+48
            %v18 = swizzle %k17, %v11
            %k19 = load.i8x16 %tp2+64
            %v20 = swizzle %k19, %v16
            %v21 = bxor %v18, %v20
            %v22 = bxor %v21, %rk9
            store %v22, %sp3+0
            %c23 = iconst.i64 1
            store %c23, %mp4+32
            return %c23
        };
        while meta[4] < meta[5] {
            last = clif {
                %kp1 = payload %0
                %tp2 = payload %1
                %sp3 = payload %5
                %mp4 = payload %6
                %r5 = load.i64 %mp4+32
                %x6 = load.i8x16 %sp3+0
                %c7 = iconst.i64 4
                %v8 = ishl %r5, %c7
                %ka9 = iadd %kp1, %v8
                %rk10 = load.i8x16 %ka9
                %c11 = iconst.i64 3
                %v12 = band %r5, %c11
                %v13 = ishl %v12, %c7
                %ta14 = iadd %tp2, %v13
                %k15 = load.i8x16 %ta14+176
                %v16 = band %r5, %c11
                %v17 = ishl %v16, %c7
                %ta18 = iadd %tp2, %v17
                %k19 = load.i8x16 %ta18+240
                %k20 = load.i8x16 %tp2+32
                %v21 = band %x6, %k20
                %v22 = bxor %x6, %v21
                %c23 = iconst.i32 4
                %v24 = bitcast.i32x4 little %v22
                %v25 = ushr %v24, %c23
                %v26 = bitcast.i8x16 little %v25
                %k27 = load.i8x16 %tp2+16
