use Concurrency;
use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Codec.Hex;
use Network.Types;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Testing.Assert;
use Tls.PeerKeys;
use Tls.TlsConfig;
use X509.X509Errors;
use WebSocket.WsErrors;
use WebSocket.WsConnection;

// wss loopback: Beskid TLS 1.3 server <-> Beskid client, test root trusted explicitly.

SocketAddress Loopback4(i64 port) {
    Port value = match Network.Types.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

Option<Deadline> Within(i64 millis) {
    return match Deadline.After(Time.FromMilliseconds(millis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

TlsServerConfig ServerConfig() {
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    return TlsConfig.Server(TlsConfig.Chain1(ServerCertDer()), key);
}

WsOptions TrustOf(u8[] rootDer) {
    Result<CertificateVerification, X509Error> v = TlsConfig.Anchors(TlsConfig.Chain1(rootDer));
    return match v {
        Result::Ok(verification) => WsConnection.WithTls(WsConnection.DefaultOptions(), verification),
        Result::Error(_) => WsConnection.DefaultOptions(),
    };
}

// i64[] result: [0] 0 untouched, 1 served ok, else 100 + WsErrors.Code of the server failure.
unit EchoOnce(TcpListener listener, i64[] result) {
    match listener.Accept(Within(20000_i64)) {
        Result::Error(_) => { result[0] = 99_i64; },
        Result::Ok(stream) => { ServeEcho(stream, result); },
    };
    return;
}

unit ServeEcho(TcpStream stream, i64[] result) {
    match WsConnection.AcceptTls(stream, ServerConfig(), WsConnection.DefaultOptions()) {
        Result::Error(e) => { result[0] = 100_i64 + WsErrors.Code(e); },
        Result::Ok(conn) => { EchoLoop(conn); result[0] = 1_i64; },
    };
    return;
}

unit EchoLoop(WsConnection conn) {
    mut bool running = true;
    while running {
        match conn.Receive() {
            Result::Error(_) => { running = false; },
            Result::Ok(message) => { running = Echo(conn, message); },
        };
    }
    return;
}

bool Echo(WsConnection conn, WsMessage message) {
    return match message {
        WsMessage::Text(text) => Sent(conn.SendText(text)),
        WsMessage::Binary(data) => Sent(conn.SendBinary(data)),
        WsMessage::Close(_, _) => false,
    };
}

bool Sent(Result<unit, WsError> r) { return match r { Result::Ok(_) => true, Result::Error(_) => false, }; }

string Url(TcpListener listener, string hostName) {
    return match listener.LocalAddress() {
        Result::Ok(address) => "wss://" + hostName + ":" + Dec(address.port.Value()) + "/echo",
        Result::Error(_) => "",
    };
}

string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

string TextOf(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => match m { WsMessage::Text(t) => t, _ => "<not text>", },
        Result::Error(_) => "<error>",
    };
}

i64 BinaryLen(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => match m { WsMessage::Binary(b) => Slice.Len(b), _ => -1_i64, },
        Result::Error(_) => -2_i64,
    };
}

unit EchoScenario() {
    match TcpListener.Bind(Loopback4(0_i64), 4_i64) {
        Result::Error(_) => { Assert.Fail("bind"); },
        Result::Ok(listener) => {
            TcpListener l = listener;
            i64[] result = [0_i64];
            Fiber<unit> server = spawn (() => EchoOnce(l, result));
            match WsConnection.Open(Url(l, "localhost"), TrustOf(RootCertDer())) {
                Result::Error(e) => { Assert.Equal<i64>(WsErrors.Code(e) * 1000_i64 + WsErrors.Detail(e), 0_i64, "client open"); },
                Result::Ok(conn) => {
                    Assert.True(Sent(conn.SendText("hello wss")), "send text");
                    Assert.True(TextOf(conn.Receive()) == "hello wss", "text echo");
                    Assert.True(Sent(conn.SendBinary(Slice.New(3000_i64))), "send binary");
                    Assert.Equal<i64>(BinaryLen(conn.Receive()), 3000_i64, "binary echo");
                    Assert.True(Sent(conn.Close(1000_i64, "bye")), "close");
                    Assert.Equal<i64>(conn.CloseCodeReceived(), 1000_i64, "server echoed 1000");
                },
            };
            server.Join();
            Assert.Equal<i64>(result[0], 1_i64, "server finished cleanly");
            l.Close();
        },
    };
    return;
}

test wss_echo_text_binary_close {
    Fiber<unit> scenario = spawn EchoScenario();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
}

// A client that trusts only the other root must fail with a typed Tls error and the
// server must see a failed handshake.
unit UntrustedScenario() {
    match TcpListener.Bind(Loopback4(0_i64), 4_i64) {
        Result::Error(_) => { Assert.Fail("bind"); },
        Result::Ok(listener) => {
            TcpListener l = listener;
            i64[] result = [0_i64];
            Fiber<unit> server = spawn (() => EchoOnce(l, result));
            match WsConnection.Open(Url(l, "localhost"), TrustOf(OtherRootDer())) {
                Result::Ok(_) => { Assert.Fail("untrusted root must not connect"); },
                Result::Error(e) => { Assert.Equal<i64>(WsErrors.Code(e), 15_i64, "typed Tls error"); },
            };
            server.Join();
            Assert.True(result[0] >= 100_i64, "server handshake failed");
            l.Close();
        },
    };
    return;
}

test wss_untrusted_root_fails {
    Fiber<unit> scenario = spawn UntrustedScenario();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
}

