use Core.Bytes.Slice;
use Codec.Mem;

// Alert descriptions (RFC 8446 section 6, RFC 7301 section 3.2).
pub i64 CloseNotify() { return 0_i64; }
pub i64 UnexpectedMessage() { return 10_i64; }
pub i64 BadRecordMac() { return 20_i64; }
pub i64 RecordOverflow() { return 22_i64; }
pub i64 HandshakeFailure() { return 40_i64; }
pub i64 BadCertificate() { return 42_i64; }
pub i64 UnsupportedCertificate() { return 43_i64; }
pub i64 CertificateRevoked() { return 44_i64; }
pub i64 CertificateExpired() { return 45_i64; }
pub i64 CertificateUnknown() { return 46_i64; }
pub i64 IllegalParameter() { return 47_i64; }
pub i64 UnknownCa() { return 48_i64; }
pub i64 AccessDenied() { return 49_i64; }
pub i64 DecodeError() { return 50_i64; }
pub i64 DecryptError() { return 51_i64; }
pub i64 ProtocolVersion() { return 70_i64; }
pub i64 InsufficientSecurity() { return 71_i64; }
pub i64 InternalError() { return 80_i64; }
pub i64 InappropriateFallback() { return 86_i64; }
pub i64 UserCanceled() { return 90_i64; }
pub i64 MissingExtension() { return 109_i64; }
pub i64 UnsupportedExtension() { return 110_i64; }
pub i64 UnrecognizedName() { return 112_i64; }
pub i64 BadCertificateStatusResponse() { return 113_i64; }
pub i64 UnknownPskIdentity() { return 115_i64; }
pub i64 CertificateRequired() { return 116_i64; }
pub i64 NoApplicationProtocol() { return 120_i64; }

/// Alert level byte: close_notify and user_canceled are warnings, everything else is fatal.
pub i64 LevelFor(i64 description) {
    if description == 0_i64 || description == 90_i64 { return 1_i64; }
    return 2_i64;
}

/// The two-byte alert body (level, description).
pub u8[] Encode(i64 description) {
    u8[] body = Mem.Zeroed(2_i64);
    body[0] = u8(LevelFor(description));
    body[1] = u8(description & 255_i64);
    return body;
}

/// Stable name for logs and test messages.
pub string Name(i64 description) {
    if description == 0_i64 { return "close_notify"; }
    if description == 10_i64 { return "unexpected_message"; }
    if description == 20_i64 { return "bad_record_mac"; }
    if description == 22_i64 { return "record_overflow"; }
    if description == 40_i64 { return "handshake_failure"; }
    if description == 42_i64 { return "bad_certificate"; }
    if description == 43_i64 { return "unsupported_certificate"; }
    if description == 44_i64 { return "certificate_revoked"; }
    if description == 45_i64 { return "certificate_expired"; }
    if description == 46_i64 { return "certificate_unknown"; }
    if description == 47_i64 { return "illegal_parameter"; }
    if description == 48_i64 { return "unknown_ca"; }
    if description == 49_i64 { return "access_denied"; }
    if description == 50_i64 { return "decode_error"; }
    if description == 51_i64 { return "decrypt_error"; }
    if description == 70_i64 { return "protocol_version"; }
    if description == 71_i64 { return "insufficient_security"; }
    if description == 80_i64 { return "internal_error"; }
    if description == 86_i64 { return "inappropriate_fallback"; }
    if description == 90_i64 { return "user_canceled"; }
    if description == 109_i64 { return "missing_extension"; }
    if description == 110_i64 { return "unsupported_extension"; }
    if description == 112_i64 { return "unrecognized_name"; }
    if description == 113_i64 { return "bad_certificate_status_response"; }
    if description == 115_i64 { return "unknown_psk_identity"; }
    if description == 116_i64 { return "certificate_required"; }
    if description == 120_i64 { return "no_application_protocol"; }
    return "unknown_alert";
}
