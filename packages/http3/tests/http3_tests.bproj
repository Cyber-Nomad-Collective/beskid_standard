http3_tests {
  name = "http3_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "Http3SmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "QpackExampleTests" { kind = Lib entry = "QpackExampleTests.bd" }
target "QpackMalformedTests" { kind = Lib entry = "QpackMalformedTests.bd" }
target "H3FrameTests" { kind = Lib entry = "H3FrameTests.bd" }
target "H3MappingTests" { kind = Lib entry = "H3MappingTests.bd" }
target "H3ExchangeTests" { kind = Lib entry = "H3ExchangeTests.bd" }
target "H3ProtocolErrorTests" { kind = Lib entry = "H3ProtocolErrorTests.bd" }
target "H3PeerTests" { kind = Lib entry = "H3PeerTests.bd" }
target "H3QuicLoopback" { kind = Lib entry = "H3QuicLoopbackTests.bd" }
