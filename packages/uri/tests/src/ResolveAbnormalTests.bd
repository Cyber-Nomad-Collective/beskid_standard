use Testing.Assert;
use Core.Results;
use Uri.Errors;
use Uri.Resolve;

// RFC 3986 section 5.4.2, abnormal examples, base http://a/b/c/d;p?q
string R(string ref) {
    Result<string, UriError> r = Resolve.ResolveText("http://a/b/c/d;p?q", ref);
    return match r { Result::Ok(s) => s, Result::Error(e) => "ERR" + Errors.Code(e), };
}

test excess_parent_segments {
    Assert.Equal<string>(R("../../../g"), "http://a/g", "../../../g");
    Assert.Equal<string>(R("../../../../g"), "http://a/g", "../../../../g");
    Assert.Equal<string>(R("/./g"), "http://a/g", "/./g");
    Assert.Equal<string>(R("/../g"), "http://a/g", "/../g");
}

test dots_as_part_of_a_name {
    Assert.Equal<string>(R("g."), "http://a/b/c/g.", "g.");
    Assert.Equal<string>(R(".g"), "http://a/b/c/.g", ".g");
    Assert.Equal<string>(R("g.."), "http://a/b/c/g..", "g..");
    Assert.Equal<string>(R("..g"), "http://a/b/c/..g", "..g");
}

test nonsensical_dot_segments {
    Assert.Equal<string>(R("./../g"), "http://a/b/g", "./../g");
    Assert.Equal<string>(R("./g/."), "http://a/b/c/g/", "./g/.");
    Assert.Equal<string>(R("g/./h"), "http://a/b/c/g/h", "g/./h");
    Assert.Equal<string>(R("g/../h"), "http://a/b/c/h", "g/../h");
    Assert.Equal<string>(R("g;x=1/./y"), "http://a/b/c/g;x=1/y", "g;x=1/./y");
    Assert.Equal<string>(R("g;x=1/../y"), "http://a/b/c/y", "g;x=1/../y");
}

test dots_in_query_and_fragment_are_data {
    Assert.Equal<string>(R("g?y/./x"), "http://a/b/c/g?y/./x", "g?y/./x");
    Assert.Equal<string>(R("g?y/../x"), "http://a/b/c/g?y/../x", "g?y/../x");
    Assert.Equal<string>(R("g#s/./x"), "http://a/b/c/g#s/./x", "g#s/./x");
    Assert.Equal<string>(R("g#s/../x"), "http://a/b/c/g#s/../x", "g#s/../x");
}

test strict_scheme_handling {
    Assert.Equal<string>(R("http:g"), "http:g", "http:g stays absolute in strict mode");
}
