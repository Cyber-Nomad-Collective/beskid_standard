// CHECKED IN: hand-maintained Mod SDK emit helpers (generator contribution assembly).
// A Generator contributes typed top-level syntax only; the host never accepts source text.
use Beskid.Compiler.Collect;
use Core.Collections.Array;

/// Assemble a generator contribution from typed top-level items.
pub GeneratedSyntaxContribution From(SyntaxContributionItem[] items)
{
    return GeneratedSyntaxContribution
    {
        items: items,
        targetBindings: [],
        templateBindings: [],
    };
}

pub GeneratedSyntaxContribution Empty()
{
    return GeneratedSyntaxContribution
    {
        items: [],
        targetBindings: [],
        templateBindings: [],
    };
}

pub GeneratedSyntaxContribution AppendItem(GeneratedSyntaxContribution contribution, SyntaxContributionItem item)
{
    return GeneratedSyntaxContribution
    {
        items: Array.Append<SyntaxContributionItem>(contribution.items, item),
        targetBindings: contribution.targetBindings,
        templateBindings: contribution.templateBindings,
    };
}

/// Bind a decoded implementation contribution to an issuer-checked semantic target.
pub GeneratedSyntaxContribution BindTarget(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.SemanticHandle target)
{
    return BindTargetGroup(contribution, index, target, []);
}

/// Bind a typed impl together with the unbound items of its generated group (`members`).
pub GeneratedSyntaxContribution BindTargetGroup(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.SemanticHandle target, u32[] members)
{
    return GeneratedSyntaxContribution
    {
        items: contribution.items,
        targetBindings: Array.Append<SerializationTargetBinding>(contribution.targetBindings, SerializationTargetBinding
        {
            contributionIndex: index,
            target: target,
            members: members,
        }),
        templateBindings: contribution.templateBindings,
    };
}

/// Bind a typed generic implementation to a current issuer-checked template.
pub GeneratedSyntaxContribution BindTemplate(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.TypeTemplate template)
{
    return BindTemplateGroup(contribution, index, template, []);
}

/// Bind a typed generic impl together with the unbound items of its generated group (`members`).
pub GeneratedSyntaxContribution BindTemplateGroup(GeneratedSyntaxContribution contribution, u32 index, Beskid.Compiler.Semantic.TypeTemplate template, u32[] members)
{
    return GeneratedSyntaxContribution
    {
        items: contribution.items,
        targetBindings: contribution.targetBindings,
        templateBindings: Array.Append<SerializationTemplateBinding>(contribution.templateBindings, SerializationTemplateBinding
        {
            contributionIndex: index,
            template: template,
            members: members,
        }),
    };
}
