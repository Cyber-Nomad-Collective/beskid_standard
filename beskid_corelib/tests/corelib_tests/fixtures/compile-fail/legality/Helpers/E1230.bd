enum E1230Error { Failed(i64 code) }
enum E1230Outcome<T, E> { Ok(T value), Error(E error) }
contract E1230Disposable { E1230Outcome<unit, E1230Error> Dispose(); }
type E1230Resource: E1230Disposable {
    pub E1230Outcome<unit, E1230Error> Dispose() { return E1230Outcome::Ok(unit); }
}
E1230Resource E1230Open() { return E1230Resource {}; }

pub E1230Outcome<unit, E1230Error> Trigger() {
    use E1230Resource resource = E1230Open();
    resource.Dispose();
    return E1230Outcome::Ok(unit);
}
