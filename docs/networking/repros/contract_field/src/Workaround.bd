// WORKAROUND: do not store the contract; pass it as an argument to every operation.
use Core.Bytes.Slice;
use Core.IO;
use Core.IO.IoError;
use Core.IO.Reader;
use Core.Results;
use Testing.Assert;

pub type ZeroReader: Reader {
    i64 unused,
    pub Result<i64, IoError> Read(u8[] destination, i64 offset, i64 count) { return Result::Ok(0_i64); }
}

i64 ReadVia(Reader r, u8[] buf) {
    Result<i64, IoError> got = IO.Read(r, buf, 0_i64, 1_i64);
    match got {
        Result::Ok(n) => { return n; },
        Result::Error(_) => { return -1_i64; },
    };
}

test contract_as_argument {
    ZeroReader r = ZeroReader { unused: 0_i64 };
    Assert.Equal<i64>(ReadVia(r, Slice.New(4_i64)), 0_i64, "argument form");
}
