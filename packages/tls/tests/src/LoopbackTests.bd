use Concurrency.Fiber;
use Core.Collections.Array;
use Core.Bytes.Slice;
use Core.IO;
use Core.IO.IoError;
use Core.Results;
use Codec.Hex;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Network.Types;
use Tls;
use Tls.Suites;
use Tls.TlsConfig;
use Tls.TlsErrors;
use Tls.TlsStream;
use TestSupport;

// Loopback Beskid client <-> Beskid server over TcpStream. Each scenario runs the server in
// a fiber; `result[0]` receives the server outcome (0 ok, else TlsErrors.Code).

TlsClientConfig ClientConfig()
{
    return TlsConfig.Client("localhost", TlsConfig.AcceptAnyCertificateForTestsOnly());
}

// Server: handshake, read up to 64 bytes, echo them, close.
unit Serve(TcpListener listener, TlsServerConfig config, i64[] result)
{
    Result<TcpStream, NetworkError> accepted = listener.Accept(Soon());
    match (accepted)
    {
        Result::Error(_) => {
            result[0] = 1_i64;
        },
        Result::Ok(tcp) => {
            Result<TlsStream, TlsError> tls = Tls.Accept(tcp, config, Soon());
            match (tls)
            {
                Result::Error(e) => {
                    result[0] = TlsErrors.Code(e);
                },
                Result::Ok(s) => {
                    result[0] = Echo(s);
                },
            };
        },
    };
    listener.Close();
    return;
}

// Echoes every chunk until the client's close_notify, then closes.
i64 Echo(TlsStream s)
{
    u8[] buf = Slice.New(64_i64);
    mut i64 rounds = 0_i64;
    while (true)
    {
        Result<i64, IoError> n = s.Read(buf, 0_i64, 64_i64);
        i64 got = match (n)
        {
            Result::Ok(v) => v,
            Result::Error(_) => -1_i64,
        };
        if (got < 0_i64)
        {
            s.Close();
            return 2_i64;
        }
        if (got == 0_i64)
        {
            s.Close();
            if (rounds == 0_i64)
            {
                return 3_i64;
            }
            return 0_i64;
        }
        Result<unit, IoError> w = IO.WriteAll(s, buf, 0_i64, got);
        match (w)
        {
            Result::Error(_) => {
                s.Close();
                return 4_i64;
            },
            Result::Ok(_) => { },
        };
        rounds = rounds + 1_i64;
    }
    return 5_i64;
}

i64 RoundTrip(TlsStream s, u8[] msg)
{
    Result<unit, IoError> w = IO.WriteAll(s, msg, 0_i64, Slice.Len(msg));
    match (w)
    {
        Result::Error(_) => {
            return 4_i64;
        },
        Result::Ok(_) => { },
    };
    u8[] back = Slice.New(Slice.Len(msg));
    Result<unit, IoError> r = IO.ReadExact(s, back, 0_i64, Slice.Len(msg));
    match (r)
    {
        Result::Error(_) => {
            return 5_i64;
        },
        Result::Ok(_) => { },
    };
    if (Slice.Compare(back, msg) != 0_i64)
    {
        return 6_i64;
    }
    return 0_i64;
}

// Runs one scenario; returns client code * 10000 + server code (0 = both fine).
// `alpnOut[0]` receives the negotiated ALPN on success.
i64 Scenario(TlsClientConfig client, TlsServerConfig server, string[] alpnOut, i64[] info)
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    Result<TcpListener, NetworkError> bound = TcpListener.Bind(bindAddress, 4_i64);
    match (bound)
    {
        Result::Error(_) => {
            return 99_i64;
        },
        Result::Ok(listener) => {
            Result<SocketAddress, NetworkError> local = listener.LocalAddress();
            match (local)
            {
                Result::Error(_) => {
                    return 98_i64;
                },
                Result::Ok(address) => {
                    SocketAddress target = address;
                    i64[] result = [-1_i64];
                    TcpListener l = listener;
                    TlsServerConfig cfg = server;
                    Fiber<unit> worker = spawn (() => Serve(l, cfg, result));
                    i64 clientCode = RunClient(target, client, alpnOut, info);
                    worker.Join();
                    return clientCode * 10000_i64 + result[0];
                },
            };
        },
    };
}

i64 RunClient(SocketAddress target, TlsClientConfig client, string[] alpnOut, i64[] info)
{
    Result<TcpStream, NetworkError> connected = TcpStream.Connect(target, Network.Types.DefaultSocketOptions(), Soon());
    match (connected)
    {
        Result::Error(_) => {
            return 97_i64;
        },
        Result::Ok(tcp) => {
            Result<TlsStream, TlsError> tls = Tls.Connect(tcp, client, Soon());
            match (tls)
            {
                Result::Error(e) => {
                    return TlsErrors.Code(e);
                },
                Result::Ok(s) => {
                    alpnOut[0] = TlsStream.NegotiatedAlpn(s);
                    info[1] = Suites.Code(TlsStream.NegotiatedSuite(s));
                    info[2] = TlsStream.NegotiatedGroup(s);
                    if (TlsStream.UsedHelloRetry(s))
                    {
                        info[3] = 1_i64;
                    }
                    i64 first = RoundTrip(s, Hex.Of("68656c6c6f20746c73"));
                    if (first != 0_i64)
                    {
                        s.Close();
                        return first;
                    }
                    // KeyUpdate with update_requested: both directions switch keys.
                    Result<unit, TlsError> updated = TlsStream.UpdateKeys(s, true);
                    match (updated)
                    {
                        Result::Error(e) => {
                            s.Close();
                            return TlsErrors.Code(e);
                        },
                        Result::Ok(_) => { },
                    };
                    i64 second = RoundTrip(s, Hex.Of("6166746572206b6579207570646174652c206c6f6e676572207061796c6f6164"));
                    if (second != 0_i64)
                    {
                        s.Close();
                        return 10_i64 + second;
                    }
                    Result<unit, IoError> closed = s.Close();
                    match (closed)
                    {
                        Result::Error(_) => {
                            return 9_i64;
                        },
                        Result::Ok(_) => { },
                    };
                    return 0_i64;
                },
            };
        },
    };
}

i64 RunSuite(CipherSuite suite, i64[] info)
{
    TlsClientConfig c = ClientConfig();
    mut CipherSuite[] only = Array.Empty<CipherSuite>();
    Array.Append<CipherSuite>(only, suite);
    c.cipherSuites = only;
    c.alpn = ["h2", "http/1.1"];
    c.alpnRequired = true;
    TlsServerConfig s = ServerConfig();
    s.alpn = ["http/1.1", "h2"];
    string[] alpn = [""];
    i64 code = Scenario(c, s, alpn, info);
    if (code == 0_i64 && alpn[0] != "http/1.1")
    {
        return 8_i64;
    }
    return code;
}

unit AllSuites(i64[] codes)
{
    i64[] info = [0_i64, 0_i64, 0_i64, 0_i64];
    codes[0] = RunSuite(Suites.Aes128(), info);
    codes[1] = info[1];
    codes[2] = info[2];
    codes[3] = RunSuite(Suites.Aes256(), info);
    codes[4] = info[1];
    codes[5] = RunSuite(Suites.ChaCha(), info);
    codes[7] = info[1];
    return;
}

test LoopbackEachCipherSuiteAlpnAndKeyUpdate
{
    i64[] codes = [-1_i64, 0_i64, 0_i64, -1_i64, 0_i64, -1_i64, 0_i64, 0_i64];
    Fiber<unit> scenario = spawn (() => AllSuites(codes));
    scenario.Join();
    ExpectEqual(codes[0], 0_i64, "TLS_AES_128_GCM_SHA256 round trip");
    ExpectEqual(codes[1], 0x1301_i64, "suite 1301");
    ExpectEqual(codes[2], 0x1d_i64, "x25519");
    ExpectEqual(codes[3], 0_i64, "TLS_AES_256_GCM_SHA384 round trip");
    ExpectEqual(codes[4], 0x1302_i64, "suite 1302");
    ExpectEqual(codes[5], 0_i64, "TLS_CHACHA20_POLY1305_SHA256 round trip");
    ExpectEqual(codes[7], 0x1303_i64, "suite 1303");
}
