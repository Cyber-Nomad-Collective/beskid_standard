// EXPECT: E1206
// `Scored` embeds `Transferable`, so every value boxed into it must be transferable. `Plain`
// carries no marker attribute: boxing it into `Scored` would launder it across a port.
use Core.Parallel;

contract Scored
{
    Transferable;
    i64 Score();
}

type Plain : Scored
{
    pub i64 Score()
    {
        return 1_i64;
    }
}

test ANonTransferableValueIsNotBoxedIntoAMarkedContract
{
    Scored value = Plain { };
}
