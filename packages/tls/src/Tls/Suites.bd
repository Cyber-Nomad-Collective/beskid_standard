use Crypto.Hmac;

/// TLS 1.3 cipher suites (RFC 8446 appendix B.4). AES-128-GCM is mandatory to implement.
pub enum CipherSuite { Aes128GcmSha256, Aes256GcmSha384, ChaCha20Poly1305Sha256, }

pub i64 Code(CipherSuite suite) {
    return match suite {
        CipherSuite::Aes128GcmSha256 => 0x1301_i64,
        CipherSuite::Aes256GcmSha384 => 0x1302_i64,
        CipherSuite::ChaCha20Poly1305Sha256 => 0x1303_i64,
    };
}

/// The suite with this code, or -1 index semantics through `IsKnown`.
pub bool IsKnown(i64 code) { return code == 0x1301_i64 || code == 0x1302_i64 || code == 0x1303_i64; }

/// Only valid for a known code (see `IsKnown`); unknown codes map to AES-128-GCM.
pub CipherSuite FromCode(i64 code) {
    if code == 0x1302_i64 { return CipherSuite::Aes256GcmSha384; }
    if code == 0x1303_i64 { return CipherSuite::ChaCha20Poly1305Sha256; }
    return CipherSuite::Aes128GcmSha256;
}

pub HashAlgorithm Hash(CipherSuite suite) {
    return match suite {
        CipherSuite::Aes256GcmSha384 => HashAlgorithm::Sha384,
        _ => HashAlgorithm::Sha256,
    };
}

pub i64 HashLength(CipherSuite suite) {
    return match suite {
        CipherSuite::Aes256GcmSha384 => 48_i64,
        _ => 32_i64,
    };
}

pub i64 KeyLength(CipherSuite suite) {
    return match suite {
        CipherSuite::Aes128GcmSha256 => 16_i64,
        _ => 32_i64,
    };
}

pub i64 IvLength() { return 12_i64; }
pub i64 TagLength() { return 16_i64; }

pub string Name(CipherSuite suite) {
    return match suite {
        CipherSuite::Aes128GcmSha256 => "TLS_AES_128_GCM_SHA256",
        CipherSuite::Aes256GcmSha384 => "TLS_AES_256_GCM_SHA384",
        CipherSuite::ChaCha20Poly1305Sha256 => "TLS_CHACHA20_POLY1305_SHA256",
    };
}

/// All suites in default client preference order.
pub CipherSuite[] All() {
    return [Aes128(), Aes256(), ChaCha()];
}

pub CipherSuite Aes128() { return CipherSuite::Aes128GcmSha256; }
pub CipherSuite Aes256() { return CipherSuite::Aes256GcmSha384; }
pub CipherSuite ChaCha() { return CipherSuite::ChaCha20Poly1305Sha256; }
