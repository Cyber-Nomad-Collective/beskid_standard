use Testing.Assert;
use Core.Results;
use Core.String;
use Uri.Errors;
use Uri.Parse;
use Uri.Types;

// Error code of ParseReference, or 0 when it succeeds.
i64 C(string text) {
    Result<UriRef, UriError> r = Parse.ParseReference(text);
    return match r { Result::Ok(_) => 0_i64, Result::Error(e) => Errors.Code(e), };
}
// UriError codes: 2 InvalidCharacter, 3 InvalidPercentEncoding, 4 InvalidScheme, 5 InvalidAuthority,
// 6 InvalidUserinfo, 7 InvalidHost, 8 InvalidIpv4, 9 InvalidIpv6, 10 IpvFutureNotAllowed,
// 11 InvalidPort, 12 PortOutOfRange, 13 InvalidPath, 14 InvalidQuery, 15 InvalidFragment.

test illegal_bytes_space { Assert.Equal<i64>(C("http://h/a b"), 2_i64, "space"); }
test illegal_bytes_double_quote { Assert.Equal<i64>(C("http://h/a\"b"), 2_i64, "double quote"); }
test illegal_bytes_angle_brackets { Assert.Equal<i64>(C("http://h/<a>"), 2_i64, "angle brackets"); }
test illegal_bytes_pipe { Assert.Equal<i64>(C("http://h/a|b"), 2_i64, "pipe"); }
test illegal_bytes_backslash { Assert.Equal<i64>(C("http://h/a\\b"), 2_i64, "backslash"); }
test illegal_bytes_caret { Assert.Equal<i64>(C("http://h/a^b"), 2_i64, "caret"); }
test illegal_bytes_backtick { Assert.Equal<i64>(C("http://h/a`b"), 2_i64, "backtick"); }
test illegal_bytes_braces { Assert.Equal<i64>(C("http://h/{a}"), 2_i64, "braces"); }
test illegal_bytes_newline { Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 10_u8])), 2_i64, "newline"); }
test illegal_bytes_nul { Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 0_u8])), 2_i64, "NUL"); }
test illegal_bytes_non_ascii { Assert.Equal<i64>(C(String.FromUtf8CodeUnits([104_u8, 195_u8, 169_u8])), 2_i64, "non-ASCII"); }
test percent_encoding_is_strict_lone_percent { Assert.Equal<i64>(C("http://h/%"), 3_i64, "lone percent"); }
test percent_encoding_is_strict_one_digit { Assert.Equal<i64>(C("http://h/%4"), 3_i64, "one digit"); }
test percent_encoding_is_strict_non_hex { Assert.Equal<i64>(C("http://h/%zz"), 3_i64, "non hex"); }
test percent_encoding_is_strict_cut_escape_at_end { Assert.Equal<i64>(C("http://h/a%2"), 3_i64, "cut escape at end"); }
test percent_encoding_is_strict_in_query { Assert.Equal<i64>(C("http://h/?q=%g1"), 3_i64, "in query"); }
test percent_encoding_is_strict_in_fragment { Assert.Equal<i64>(C("http://h/#%1"), 3_i64, "in fragment"); }
test percent_encoding_is_strict_in_userinfo { Assert.Equal<i64>(C("http://%zz@h/"), 3_i64, "in userinfo"); }
test percent_encoding_is_strict_in_host { Assert.Equal<i64>(C("http://h%/"), 3_i64, "in host"); }
test percent_encoding_is_strict_valid_escapes { Assert.Equal<i64>(C("http://h/%41%7e"), 0_i64, "valid escapes"); }
test scheme_rules_digit_first { Assert.Equal<i64>(C("1http://h/"), 4_i64, "digit first"); }
test scheme_rules_empty_scheme { Assert.Equal<i64>(C("://h/"), 4_i64, "empty scheme"); }
test scheme_rules_underscore { Assert.Equal<i64>(C("ht_tp://h/"), 4_i64, "underscore"); }
test scheme_rules_space_is_rejected_earlier_or_as_scheme { Assert.Equal<i64>(C("ht tp://h/"), 2_i64, "space is an illegal byte first"); }
test scheme_rules_allowed_scheme_characters { Assert.Equal<i64>(C("a+b-c.d://h/"), 0_i64, "allowed scheme characters"); }
test scheme_rules_uppercase_scheme { Assert.Equal<i64>(C("HTTP://h/"), 0_i64, "uppercase scheme"); }
test authority_rules_space_in_userinfo { Assert.Equal<i64>(C("http://us er@h/"), 2_i64, "space in userinfo"); }
test authority_rules_two_at_signs { Assert.Equal<i64>(C("http://a@b@c/"), 7_i64, "two at signs"); }
test authority_rules_two_colons_in_host { Assert.Equal<i64>(C("http://h:1:2/"), 7_i64, "two colons in host"); }
test authority_rules_unclosed_bracket { Assert.Equal<i64>(C("http://[::1/"), 7_i64, "unclosed bracket"); }
test authority_rules_junk_after_bracket { Assert.Equal<i64>(C("http://[::1]x/"), 5_i64, "junk after bracket"); }
test authority_rules_brackets_inside_reg_name { Assert.Equal<i64>(C("http://h[1]/"), 7_i64, "brackets inside reg-name"); }
test authority_rules_bracket_in_userinfo { Assert.Equal<i64>(C("http://a[b@h/"), 6_i64, "bracket in userinfo"); }
test port_rules_65536 { Assert.Equal<i64>(C("http://h:65536/"), 12_i64, "65536"); }
test port_rules_huge { Assert.Equal<i64>(C("http://h:99999999999999999999/"), 12_i64, "huge"); }
test port_rules_negative { Assert.Equal<i64>(C("http://h:-1/"), 11_i64, "negative"); }
test port_rules_letters { Assert.Equal<i64>(C("http://h:8a/"), 11_i64, "letters"); }
test port_rules_ipv6_letters { Assert.Equal<i64>(C("http://[::1]:x/"), 11_i64, "ipv6 letters"); }
test port_rules_ipv6_out_of_range { Assert.Equal<i64>(C("http://[::1]:65536/"), 12_i64, "ipv6 out of range"); }
test component_character_sets_brackets_in_path { Assert.Equal<i64>(C("http://h/a[b]"), 13_i64, "brackets in path"); }
test component_character_sets_brackets_in_query { Assert.Equal<i64>(C("http://h/?a[b]"), 14_i64, "brackets in query"); }
test component_character_sets_brackets_in_fragment { Assert.Equal<i64>(C("http://h/#a[b]"), 15_i64, "brackets in fragment"); }
test component_character_sets_second_hash { Assert.Equal<i64>(C("http://h/#a#b"), 15_i64, "second hash"); }
test component_character_sets_question_mark_after_hash_is_data { Assert.Equal<i64>(C("http://h/p?a#b?c"), 0_i64, "question mark after hash is data"); }
test length_limit0 { Result<UriRef, UriError> r = Parse.ParseWith("http://h/aaaaaaaaaa", 10_i64, false, false); }
i64 Lim(string text, i64 max) {
    Result<UriRef, UriError> r = Parse.ParseWith(text, max, false, false);
    return match r { Result::Ok(_) => 0_i64, Result::Error(e) => Errors.Code(e), };
}
test length_limit_toolong { Assert.Equal<i64>(Lim("http://h/aaaaaaaaaa", 10_i64), 1_i64, "TooLong"); }
test length_limit_at_limit { Assert.Equal<i64>(Lim("http://h/", 9_i64), 0_i64, "at limit"); }
