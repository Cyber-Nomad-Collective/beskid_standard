// GAP: roughly 160-180 KiB of live arrays per process. Variant A keeps 64 KiB u8[] arrays live (Slice.New) until
// the runtime traps with out_of_memory; a progress line is printed before each allocation, so the last line
// printed before the trap names the allocation that failed. Capped at 64 arrays (4 MiB).
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Output;
use Core.String;
use Testing.Assert;

pub type Blob { pub u8[] data, }

string Num(i64 n) {
    if n < 10_i64 { return String.DigitChar(n); }
    return Num(n / 10_i64) + String.DigitChar(n % 10_i64);
}

test variant_a_live_64k_arrays {
    mut Blob[] keep = Array.Empty<Blob>();
    mut i64 i = 0_i64;
    while i < 64_i64 {
        Output.WriteLine("variant A: allocating live 64 KiB array #" + Num(i + 1_i64));
        Array.Append<Blob>(keep, Blob { data: Slice.New(65536_i64) });
        i = i + 1_i64;
    }
    Output.WriteLine("variant A: kept " + Num(Array.Len<Blob>(keep)) + " live 64 KiB arrays without a trap");
    Assert.Equal<i64>(Array.Len<Blob>(keep), 64_i64, "kept 64 arrays");
}
