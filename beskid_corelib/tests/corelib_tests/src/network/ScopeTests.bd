use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Tcp.TcpListener;
use Testing.Assert;

Result<unit, NetworkError> ScopedListener(SocketAddress address) {
    use TcpListener listener = TcpListener.Bind(address, 1_i64)?;
    return Result::Ok(());
}

test network_tcp_disposable_uses_foundation_cleanup_conversion {
    SocketAddress address = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
    Assert.True(match ScopedListener(address) { Result::Ok(_) => true, _ => false, }, "scoped listener uses the explicit cleanup conversion");
}
