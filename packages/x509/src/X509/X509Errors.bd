/// Typed failures of the X509 package. Every parser and validator entry point fails
/// closed with one of these values.
pub enum X509Error {
    /// No error was recorded (the initial parser state).
    None,
    /// An element or a length runs past the end of its enclosing element.
    Truncated,
    /// A tag uses a non-minimal high-tag-number form or is too large.
    BadTag,
    /// A length uses the indefinite form, a non-minimal form, or more than 4 octets.
    BadLength,
    /// An element does not have the expected tag.
    UnexpectedTag,
    /// Bytes remain after the last expected element.
    TrailingData,
    /// Nesting is deeper than `Der.MaxDepth`.
    TooDeep,
    /// The input is larger than the configured bound.
    TooLarge,
    /// An INTEGER is empty or not minimally encoded, or does not fit.
    BadInteger,
    /// A BOOLEAN is not one octet of 0x00 or 0xFF.
    BadBoolean,
    /// A BIT STRING has a bad unused-bits octet or non-zero padding bits.
    BadBitString,
    /// A NULL has content.
    BadNull,
    /// An OBJECT IDENTIFIER is empty or has a non-minimal or unterminated arc.
    BadOid,
    /// A UTCTime or GeneralizedTime is not in the RFC 5280 form.
    BadTime,
    /// A string has characters outside its type, or invalid UTF-8.
    BadString,
    /// A primitive type was encoded constructed, or the reverse.
    BadConstruction,
    /// PEM text has no CERTIFICATE block, a broken armor line, or bad Base64.
    BadPem,
    /// The certificate version is not v1, v2, or v3, or v3 data is in an older version.
    BadVersion,
    /// The serial number is negative, zero-length, or longer than 20 octets.
    BadSerial,
    /// The outer and TBS signature algorithms differ, or the parameters are malformed.
    BadAlgorithm,
    /// The signature algorithm is not supported.
    UnsupportedAlgorithm,
    /// The public key type or curve is not supported for this operation.
    UnsupportedKey,
    /// A public key is malformed or below the policy minimum size.
    BadKey,
    /// An extension is malformed or appears twice.
    BadExtension,
    /// A critical extension is not recognized.
    UnknownCriticalExtension,
    /// A name is malformed.
    BadName,
    /// The signature does not verify.
    BadSignature,
    /// The certificate is not yet valid or has expired at the given time.
    Expired,
    /// No chain to a trust anchor could be built.
    UnknownIssuer,
    /// An issuing certificate is not a CA (basicConstraints).
    NotCa,
    /// An issuing certificate lacks keyCertSign, or the leaf lacks digitalSignature.
    BadKeyUsage,
    /// The leaf extended key usage does not allow serverAuth.
    BadExtendedKeyUsage,
    /// A pathLenConstraint is exceeded.
    PathLengthExceeded,
    /// The chain is longer than the maximum depth.
    ChainTooLong,
    /// A name in the chain violates a nameConstraints extension.
    NameConstraintViolation,
    /// A nameConstraints extension uses a name form that this package does not enforce.
    UnsupportedNameConstraint,
    /// The certificate does not match the requested host name or IP address.
    HostnameMismatch,
    /// The requested host name or IP address is malformed.
    BadHostname,
    /// A file could not be read.
    Io,
}

/// A short stable name for an error, for logs and tests.
pub string Name(X509Error error) {
    return match error {
        X509Error::None => "None",
        X509Error::Truncated => "Truncated",
        X509Error::BadTag => "BadTag",
        X509Error::BadLength => "BadLength",
        X509Error::UnexpectedTag => "UnexpectedTag",
        X509Error::TrailingData => "TrailingData",
        X509Error::TooDeep => "TooDeep",
        X509Error::TooLarge => "TooLarge",
        X509Error::BadInteger => "BadInteger",
        X509Error::BadBoolean => "BadBoolean",
        X509Error::BadBitString => "BadBitString",
        X509Error::BadNull => "BadNull",
        X509Error::BadOid => "BadOid",
        X509Error::BadTime => "BadTime",
        X509Error::BadString => "BadString",
        X509Error::BadConstruction => "BadConstruction",
        X509Error::BadPem => "BadPem",
        X509Error::BadVersion => "BadVersion",
        X509Error::BadSerial => "BadSerial",
        X509Error::BadAlgorithm => "BadAlgorithm",
        X509Error::UnsupportedAlgorithm => "UnsupportedAlgorithm",
        X509Error::UnsupportedKey => "UnsupportedKey",
        X509Error::BadKey => "BadKey",
        X509Error::BadExtension => "BadExtension",
        X509Error::UnknownCriticalExtension => "UnknownCriticalExtension",
        X509Error::BadName => "BadName",
        X509Error::BadSignature => "BadSignature",
        X509Error::Expired => "Expired",
        X509Error::UnknownIssuer => "UnknownIssuer",
        X509Error::NotCa => "NotCa",
        X509Error::BadKeyUsage => "BadKeyUsage",
        X509Error::BadExtendedKeyUsage => "BadExtendedKeyUsage",
        X509Error::PathLengthExceeded => "PathLengthExceeded",
        X509Error::ChainTooLong => "ChainTooLong",
        X509Error::NameConstraintViolation => "NameConstraintViolation",
        X509Error::UnsupportedNameConstraint => "UnsupportedNameConstraint",
        X509Error::HostnameMismatch => "HostnameMismatch",
        X509Error::BadHostname => "BadHostname",
        X509Error::Io => "Io",
    };
}

/// Stable numeric codes; the DER reader records these instead of enum values because
/// enum construction is costly to compile with beskid 0.5.2 (see COMPILER-GAPS.md).
pub i64 ENone() { return 0_i64; }
pub i64 ETruncated() { return 1_i64; }
pub i64 EBadTag() { return 2_i64; }
pub i64 EBadLength() { return 3_i64; }
pub i64 EUnexpectedTag() { return 4_i64; }
pub i64 ETrailingData() { return 5_i64; }
pub i64 ETooDeep() { return 6_i64; }
pub i64 ETooLarge() { return 7_i64; }
pub i64 EBadInteger() { return 8_i64; }
pub i64 EBadBoolean() { return 9_i64; }
pub i64 EBadBitString() { return 10_i64; }
pub i64 EBadNull() { return 11_i64; }
pub i64 EBadOid() { return 12_i64; }
pub i64 EBadTime() { return 13_i64; }
pub i64 EBadString() { return 14_i64; }
pub i64 EBadConstruction() { return 15_i64; }
pub i64 EBadPem() { return 16_i64; }
pub i64 EBadVersion() { return 17_i64; }
pub i64 EBadSerial() { return 18_i64; }
pub i64 EBadAlgorithm() { return 19_i64; }
pub i64 EUnsupportedAlgorithm() { return 20_i64; }
pub i64 EUnsupportedKey() { return 21_i64; }
pub i64 EBadKey() { return 22_i64; }
pub i64 EBadExtension() { return 23_i64; }
pub i64 EUnknownCriticalExtension() { return 24_i64; }
pub i64 EBadName() { return 25_i64; }
pub i64 EBadSignature() { return 26_i64; }
pub i64 EExpired() { return 27_i64; }
pub i64 EUnknownIssuer() { return 28_i64; }
pub i64 ENotCa() { return 29_i64; }
pub i64 EBadKeyUsage() { return 30_i64; }
pub i64 EBadExtendedKeyUsage() { return 31_i64; }
pub i64 EPathLengthExceeded() { return 32_i64; }
pub i64 EChainTooLong() { return 33_i64; }
pub i64 ENameConstraintViolation() { return 34_i64; }
pub i64 EUnsupportedNameConstraint() { return 35_i64; }
pub i64 EHostnameMismatch() { return 36_i64; }
pub i64 EBadHostname() { return 37_i64; }
pub i64 EIo() { return 38_i64; }

/// The error for a numeric code; unknown codes map to Io.
pub X509Error FromCode(i64 code) {
    if code == 0_i64 { return X509Error::None; }
    if code == 1_i64 { return X509Error::Truncated; }
    if code == 2_i64 { return X509Error::BadTag; }
    if code == 3_i64 { return X509Error::BadLength; }
    if code == 4_i64 { return X509Error::UnexpectedTag; }
    if code == 5_i64 { return X509Error::TrailingData; }
    if code == 6_i64 { return X509Error::TooDeep; }
    if code == 7_i64 { return X509Error::TooLarge; }
    if code == 8_i64 { return X509Error::BadInteger; }
    if code == 9_i64 { return X509Error::BadBoolean; }
    if code == 10_i64 { return X509Error::BadBitString; }
    if code == 11_i64 { return X509Error::BadNull; }
    if code == 12_i64 { return X509Error::BadOid; }
    if code == 13_i64 { return X509Error::BadTime; }
    if code == 14_i64 { return X509Error::BadString; }
    if code == 15_i64 { return X509Error::BadConstruction; }
    if code == 16_i64 { return X509Error::BadPem; }
    if code == 17_i64 { return X509Error::BadVersion; }
    if code == 18_i64 { return X509Error::BadSerial; }
    if code == 19_i64 { return X509Error::BadAlgorithm; }
    if code == 20_i64 { return X509Error::UnsupportedAlgorithm; }
    if code == 21_i64 { return X509Error::UnsupportedKey; }
    if code == 22_i64 { return X509Error::BadKey; }
    if code == 23_i64 { return X509Error::BadExtension; }
    if code == 24_i64 { return X509Error::UnknownCriticalExtension; }
    if code == 25_i64 { return X509Error::BadName; }
    if code == 26_i64 { return X509Error::BadSignature; }
    if code == 27_i64 { return X509Error::Expired; }
    if code == 28_i64 { return X509Error::UnknownIssuer; }
    if code == 29_i64 { return X509Error::NotCa; }
    if code == 30_i64 { return X509Error::BadKeyUsage; }
    if code == 31_i64 { return X509Error::BadExtendedKeyUsage; }
    if code == 32_i64 { return X509Error::PathLengthExceeded; }
    if code == 33_i64 { return X509Error::ChainTooLong; }
    if code == 34_i64 { return X509Error::NameConstraintViolation; }
    if code == 35_i64 { return X509Error::UnsupportedNameConstraint; }
    if code == 36_i64 { return X509Error::HostnameMismatch; }
    if code == 37_i64 { return X509Error::BadHostname; }
    if code == 38_i64 { return X509Error::Io; }
    return X509Error::Io;
}
