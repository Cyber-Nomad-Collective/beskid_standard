use Core.Results;

/// Failure to construct a Unicode scalar value.
pub enum UnicodeScalarError {
    OutOfRange(u32 codePoint),
    Surrogate(u32 codePoint),
}

/// Construct a character only from a Unicode scalar value.
pub Result<char, UnicodeScalarError> FromCodePoint(u32 value) {
    if (value > 1114111_u32) { return Result::Error(UnicodeScalarError::OutOfRange(value)); }
    if (value >= 55296_u32 && value <= 57343_u32) { return Result::Error(UnicodeScalarError::Surrogate(value)); }
    return Result::Ok(char(value));
}

/// Return the exact Unicode scalar represented by a character.
pub u32 ToCodePoint(char value) { return u32(value); }
