/// Core.Json — RFC 8259 JSON parsing, serialization, and value access in plain Beskid.
/// @tier(supported)
/// `Parse` accepts exactly one value surrounded by optional whitespace and reports the first
/// failure as a typed `JsonError` with its byte offset. Numbers are held as f64 (see
/// `Core.Text.Number` for precision notes). `Stringify` writes compact JSON; `Pretty` indents
/// with two spaces. Non-finite numbers serialize as `null`, matching common encoders.
pub mod Core.Json.JsonValue;
pub mod Core.Json.JsonError;

use Core.Collections.Array;
use Core.Json.JsonError;
use Core.Json.JsonValue;
use Core.Optional.Option;
use Core.Results;
use Core.String.Builder;
use Core.String.Core;
use Core.String.Utf8;
use Core.Text.Number;

/// Arrays and objects may nest at most this deep.
pub i64 MaxDepth() {
    return 128;
}

/// One parsed value and the offset just past it.
pub type ParseStep {
    JsonValue value,
    i64 next,
}

/// A decoded string and the offset just past its closing quote.
pub type TextStep {
    string text,
    i64 next,
}

// ---------------------------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------------------------

/// Parses `text` as one JSON value.
pub Result<JsonValue, JsonError> Parse(string text) {
    i64 len = Core.Len(text);
    i64 start = SkipWhitespace(text, 0);
    ParseStep step = ParseValue(text, start, 0)?;
    i64 end = SkipWhitespace(text, step.next);
    if end < len {
        return Result<JsonValue, JsonError>::Error(JsonError::TrailingCharacters(end));
    }
    return Result<JsonValue, JsonError>::Ok(step.value);
}

i64 SkipWhitespace(string text, i64 at) {
    i64 len = Core.Len(text);
    mut i64 i = at;
    while i < len {
        u8 b = Core.ByteAt(text, i);
        if b != 32 && b != 9 && b != 10 && b != 13 {
            return i;
        }
        i = i + 1;
    }
    return i;
}

bool HasLiteral(string text, i64 at, string literal) {
    i64 n = Core.Len(literal);
    if at + n > Core.Len(text) {
        return false;
    }
    return Core.SubSlice(text, at, n) == literal;
}

Result<ParseStep, JsonError> Step(JsonValue value, i64 next) {
    return Result<ParseStep, JsonError>::Ok(ParseStep { value: value, next: next });
}

Result<ParseStep, JsonError> ParseValue(string text, i64 at, i64 depth) {
    if at >= Core.Len(text) {
        return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(at));
    }
    u8 b = Core.ByteAt(text, at);
    if b == 123 {
        return ParseObject(text, at, depth + 1);
    }
    if b == 91 {
        return ParseList(text, at, depth + 1);
    }
    if b == 34 {
        TextStep decoded = ParseText(text, at)?;
        return Step(JsonValue::Text(decoded.text), decoded.next);
    }
    if b == 45 || (b >= 48 && b <= 57) {
        return ParseNumber(text, at);
    }
    if HasLiteral(text, at, "true") {
        return Step(JsonValue::Bool(true), at + 4);
    }
    if HasLiteral(text, at, "false") {
        return Step(JsonValue::Bool(false), at + 5);
    }
    if HasLiteral(text, at, "null") {
        return Step(JsonValue::Null, at + 4);
    }
    return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedCharacter(at));
}

bool IsDigitByte(u8 b) {
    return b >= 48 && b <= 57;
}

/// Validates the JSON number grammar `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`
/// before converting the slice.
Result<ParseStep, JsonError> ParseNumber(string text, i64 at) {
    i64 len = Core.Len(text);
    mut i64 i = at;
    if Core.ByteAt(text, i) == 45 {
        i = i + 1;
    }
    if i >= len || !IsDigitByte(Core.ByteAt(text, i)) {
        return Result<ParseStep, JsonError>::Error(JsonError::InvalidNumber(i));
    }
    if Core.ByteAt(text, i) == 48 {
        i = i + 1;
    } else {
        while i < len && IsDigitByte(Core.ByteAt(text, i)) {
            i = i + 1;
        }
    }
    if i < len && Core.ByteAt(text, i) == 46 {
        i = i + 1;
        if i >= len || !IsDigitByte(Core.ByteAt(text, i)) {
            return Result<ParseStep, JsonError>::Error(JsonError::InvalidNumber(i));
        }
        while i < len && IsDigitByte(Core.ByteAt(text, i)) {
            i = i + 1;
        }
    }
    if i < len && (Core.ByteAt(text, i) == 101 || Core.ByteAt(text, i) == 69) {
        i = i + 1;
        if i < len && (Core.ByteAt(text, i) == 43 || Core.ByteAt(text, i) == 45) {
            i = i + 1;
        }
        if i >= len || !IsDigitByte(Core.ByteAt(text, i)) {
            return Result<ParseStep, JsonError>::Error(JsonError::InvalidNumber(i));
        }
        while i < len && IsDigitByte(Core.ByteAt(text, i)) {
            i = i + 1;
        }
    }
    string slice = Core.SubSlice(text, at, i - at);
    return match Number.ParseF64(slice) {
        Result::Ok(value) => Step(JsonValue::Number(value), i),
        Result::Error(_) => Result<ParseStep, JsonError>::Error(JsonError::InvalidNumber(at)),
    };
}

/// Value of four hex digits at `at`, or `-1` when any is not a hex digit.
i64 Hex4(string text, i64 at) {
    if at + 4 > Core.Len(text) {
        return -1;
    }
    mut i64 value = 0;
    mut i64 i = 0;
    while i < 4 {
        u8 b = Core.ByteAt(text, at + i);
        mut i64 digit = -1;
        if b >= 48 && b <= 57 {
            digit = i64(b) - 48;
        }
        if b >= 97 && b <= 102 {
            digit = i64(b) - 87;
        }
        if b >= 65 && b <= 70 {
            digit = i64(b) - 55;
        }
        if digit < 0 {
            return -1;
        }
        value = value * 16 + digit;
        i = i + 1;
    }
    return value;
}

/// Appends the UTF-8 encoding of scalar value `cp` (`0..=0x10FFFF`, not a surrogate).
u8[] AppendCodePoint(u8[] bytes, i64 cp) {
    mut u8[] out = bytes;
    if cp < 128 {
        out = Array.Append<u8>(out, u8(cp));
        return out;
    }
    if cp < 2048 {
        out = Array.Append<u8>(out, u8(192 + cp / 64));
        out = Array.Append<u8>(out, u8(128 + cp % 64));
        return out;
    }
    if cp < 65536 {
        out = Array.Append<u8>(out, u8(224 + cp / 4096));
        out = Array.Append<u8>(out, u8(128 + (cp / 64) % 64));
        out = Array.Append<u8>(out, u8(128 + cp % 64));
        return out;
    }
    out = Array.Append<u8>(out, u8(240 + cp / 262144));
    out = Array.Append<u8>(out, u8(128 + (cp / 4096) % 64));
    out = Array.Append<u8>(out, u8(128 + (cp / 64) % 64));
    out = Array.Append<u8>(out, u8(128 + cp % 64));
    return out;
}

/// Decodes the string starting at the opening quote at `at`.
Result<TextStep, JsonError> ParseText(string text, i64 at) {
    i64 len = Core.Len(text);
    mut u8[] bytes = Array.Empty<u8>();
    mut i64 i = at + 1;
    while i < len {
        u8 b = Core.ByteAt(text, i);
        if b == 34 {
            return Result<TextStep, JsonError>::Ok(TextStep { text: Utf8.FromUtf8CodeUnits(bytes), next: i + 1 });
        }
        if b < 32 {
            return Result<TextStep, JsonError>::Error(JsonError::ControlCharacter(i));
        }
        if b != 92 {
            bytes = Array.Append<u8>(bytes, b);
            i = i + 1;
            continue;
        }
        if i + 1 >= len {
            return Result<TextStep, JsonError>::Error(JsonError::UnexpectedEnd(len));
        }
        u8 e = Core.ByteAt(text, i + 1);
        mut i64 simple = -1;
        if e == 34 || e == 92 || e == 47 {
            simple = i64(e);
        }
        if e == 98 {
            simple = 8;
        }
        if e == 102 {
            simple = 12;
        }
        if e == 110 {
            simple = 10;
        }
        if e == 114 {
            simple = 13;
        }
        if e == 116 {
            simple = 9;
        }
        if simple >= 0 {
            bytes = Array.Append<u8>(bytes, u8(simple));
            i = i + 2;
            continue;
        }
        if e != 117 {
            return Result<TextStep, JsonError>::Error(JsonError::InvalidEscape(i));
        }
        i64 unit = Hex4(text, i + 2);
        if unit < 0 {
            return Result<TextStep, JsonError>::Error(JsonError::InvalidEscape(i));
        }
        if unit >= 56320 && unit <= 57343 {
            return Result<TextStep, JsonError>::Error(JsonError::InvalidUnicode(i));
        }
        if unit >= 55296 && unit <= 56319 {
            // High surrogate: a `\uDC00`-`\uDFFF` low surrogate must follow.
            if !HasLiteral(text, i + 6, "\\u") {
                return Result<TextStep, JsonError>::Error(JsonError::InvalidUnicode(i));
            }
            i64 low = Hex4(text, i + 8);
            if low < 56320 || low > 57343 {
                return Result<TextStep, JsonError>::Error(JsonError::InvalidUnicode(i));
            }
            i64 cp = 65536 + (unit - 55296) * 1024 + (low - 56320);
            bytes = AppendCodePoint(bytes, cp);
            i = i + 12;
            continue;
        }
        bytes = AppendCodePoint(bytes, unit);
        i = i + 6;
    }
    return Result<TextStep, JsonError>::Error(JsonError::UnexpectedEnd(len));
}

Result<ParseStep, JsonError> ParseList(string text, i64 at, i64 depth) {
    if depth > MaxDepth() {
        return Result<ParseStep, JsonError>::Error(JsonError::TooDeep(at));
    }
    i64 len = Core.Len(text);
    mut JsonValue[] items = Array.Empty<JsonValue>();
    mut i64 i = SkipWhitespace(text, at + 1);
    if i < len && Core.ByteAt(text, i) == 93 {
        return Step(JsonValue::List(items), i + 1);
    }
    while true {
        ParseStep item = ParseValue(text, i, depth)?;
        items = Array.Append<JsonValue>(items, item.value);
        i = SkipWhitespace(text, item.next);
        if i >= len {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
        }
        u8 b = Core.ByteAt(text, i);
        if b == 93 {
            return Step(JsonValue::List(items), i + 1);
        }
        if b != 44 {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedCharacter(i));
        }
        i = SkipWhitespace(text, i + 1);
    }
    return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
}

Result<ParseStep, JsonError> ParseObject(string text, i64 at, i64 depth) {
    if depth > MaxDepth() {
        return Result<ParseStep, JsonError>::Error(JsonError::TooDeep(at));
    }
    i64 len = Core.Len(text);
    mut string[] keys = Array.Empty<string>();
    mut JsonValue[] values = Array.Empty<JsonValue>();
    mut i64 i = SkipWhitespace(text, at + 1);
    if i < len && Core.ByteAt(text, i) == 125 {
        return Step(JsonValue::Object(keys, values), i + 1);
    }
    while true {
        if i >= len {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
        }
        if Core.ByteAt(text, i) != 34 {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedCharacter(i));
        }
        TextStep key = ParseText(text, i)?;
        i = SkipWhitespace(text, key.next);
        if i >= len {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
        }
        if Core.ByteAt(text, i) != 58 {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedCharacter(i));
        }
        i = SkipWhitespace(text, i + 1);
        ParseStep member = ParseValue(text, i, depth)?;
        keys = Array.Append<string>(keys, key.text);
        values = Array.Append<JsonValue>(values, member.value);
        i = SkipWhitespace(text, member.next);
        if i >= len {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
        }
        u8 b = Core.ByteAt(text, i);
        if b == 125 {
            return Step(JsonValue::Object(keys, values), i + 1);
        }
        if b != 44 {
            return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedCharacter(i));
        }
        i = SkipWhitespace(text, i + 1);
    }
    return Result<ParseStep, JsonError>::Error(JsonError::UnexpectedEnd(i));
}

// ---------------------------------------------------------------------------------------------
// Serialization
// ---------------------------------------------------------------------------------------------

/// Serializes `value` as compact JSON.
pub string Stringify(JsonValue value) {
    StringBuilder out = WriteValue(Builder.New(), value, -1, 0);
    return out.ToString();
}

/// Serializes `value` with two-space indentation and one member or element per line.
pub string Pretty(JsonValue value) {
    StringBuilder out = WriteValue(Builder.New(), value, 2, 0);
    return out.ToString();
}

/// Returns `text` as a quoted JSON string literal with the required escapes.
pub string Quote(string text) {
    StringBuilder out = WriteText(Builder.New(), text);
    return out.ToString();
}

StringBuilder WriteText(StringBuilder builder, string text) {
    mut StringBuilder out = builder.AppendAscii(34);
    i64 len = Core.Len(text);
    mut i64 start = 0;
    mut i64 i = 0;
    while i < len {
        u8 b = Core.ByteAt(text, i);
        if b == 34 || b == 92 || b < 32 {
            if i > start {
                out = out.Append(Core.SubSlice(text, start, i - start));
            }
            out = out.AppendAscii(92);
            if b == 34 || b == 92 {
                out = out.AppendAscii(b);
            } else {
                if b == 10 {
                    out = out.AppendAscii(110);
                } else {
                    if b == 13 {
                        out = out.AppendAscii(114);
                    } else {
                        if b == 9 {
                            out = out.AppendAscii(116);
                        } else {
                            if b == 8 {
                                out = out.AppendAscii(98);
                            } else {
                                if b == 12 {
                                    out = out.AppendAscii(102);
                                } else {
                                    string hex = Number.FormatHex(i64(b));
                                    out = out.Append("u00");
                                    if Core.Len(hex) < 2 {
                                        out = out.AppendAscii(48);
                                    }
                                    out = out.Append(hex);
                                }
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if len > start {
        out = out.Append(Core.SubSlice(text, start, len - start));
    }
    return out.AppendAscii(34);
}

StringBuilder WriteIndent(StringBuilder builder, i64 indent, i64 level) {
    if indent < 0 {
        return builder;
    }
    mut StringBuilder out = builder.AppendAscii(10);
    mut i64 i = 0;
    while i < indent * level {
        out = out.AppendAscii(32);
        i = i + 1;
    }
    return out;
}

/// `indent < 0` selects compact output.
StringBuilder WriteValue(StringBuilder builder, JsonValue value, i64 indent, i64 level) {
    match value {
        JsonValue::Null => {
            return builder.Append("null");
        },
        JsonValue::Bool(flag) => {
            return builder.AppendBool(flag);
        },
        JsonValue::Number(number) => {
            if !Number.IsFinite(number) {
                return builder.Append("null");
            }
            return builder.Append(Number.FormatGeneral(number));
        },
        JsonValue::Text(text) => {
            return WriteText(builder, text);
        },
        JsonValue::List(items) => {
            return WriteList(builder, items, indent, level);
        },
        JsonValue::Object(keys, values) => {
            return WriteObject(builder, keys, values, indent, level);
        },
    };
    return builder;
}

StringBuilder WriteList(StringBuilder builder, JsonValue[] items, i64 indent, i64 level) {
    i64 count = Array.Len<JsonValue>(items);
    mut StringBuilder out = builder.AppendAscii(91);
    if count == 0 {
        return out.AppendAscii(93);
    }
    mut i64 i = 0;
    while i < count {
        if i > 0 {
            out = out.AppendAscii(44);
        }
        out = WriteIndent(out, indent, level + 1);
        out = WriteValue(out, Array.Get<JsonValue>(items, i), indent, level + 1);
        i = i + 1;
    }
    out = WriteIndent(out, indent, level);
    return out.AppendAscii(93);
}

StringBuilder WriteObject(StringBuilder builder, string[] keys, JsonValue[] values, i64 indent, i64 level) {
    i64 count = Array.Len<string>(keys);
    mut StringBuilder out = builder.AppendAscii(123);
    if count == 0 {
        return out.AppendAscii(125);
    }
    mut i64 i = 0;
    while i < count {
        if i > 0 {
            out = out.AppendAscii(44);
        }
        out = WriteIndent(out, indent, level + 1);
        out = WriteText(out, Array.Get<string>(keys, i));
        out = out.AppendAscii(58);
        if indent >= 0 {
            out = out.AppendAscii(32);
        }
        out = WriteValue(out, Array.Get<JsonValue>(values, i), indent, level + 1);
        i = i + 1;
    }
    out = WriteIndent(out, indent, level);
    return out.AppendAscii(125);
}

// ---------------------------------------------------------------------------------------------
// Construction and access
// ---------------------------------------------------------------------------------------------

/// An empty object.
pub JsonValue EmptyObject() {
    return JsonValue::Object(Array.Empty<string>(), Array.Empty<JsonValue>());
}

/// An empty array.
pub JsonValue EmptyList() {
    return JsonValue::List(Array.Empty<JsonValue>());
}

/// Returns `target` with member `key` set to `member`: the first existing `key` is replaced,
/// otherwise the member is appended. Non-object targets are returned unchanged.
pub JsonValue With(JsonValue target, string key, JsonValue member) {
    match target {
        JsonValue::Object(keys, values) => {
            mut string[] nextKeys = Array.Empty<string>();
            mut JsonValue[] nextValues = Array.Empty<JsonValue>();
            mut bool replaced = false;
            mut i64 i = 0;
            while i < Array.Len<string>(keys) {
                nextKeys = Array.Append<string>(nextKeys, Array.Get<string>(keys, i));
                if !replaced && Array.Get<string>(keys, i) == key {
                    nextValues = Array.Append<JsonValue>(nextValues, member);
                    replaced = true;
                } else {
                    nextValues = Array.Append<JsonValue>(nextValues, Array.Get<JsonValue>(values, i));
                }
                i = i + 1;
            }
            if !replaced {
                nextKeys = Array.Append<string>(nextKeys, key);
                nextValues = Array.Append<JsonValue>(nextValues, member);
            }
            return JsonValue::Object(nextKeys, nextValues);
        },
        _ => {
            return target;
        },
    };
    return target;
}

/// Returns `target` with `item` appended. Non-array targets are returned unchanged.
pub JsonValue Push(JsonValue target, JsonValue item) {
    match target {
        JsonValue::List(items) => {
            mut JsonValue[] next = Array.Empty<JsonValue>();
            mut i64 i = 0;
            while i < Array.Len<JsonValue>(items) {
                next = Array.Append<JsonValue>(next, Array.Get<JsonValue>(items, i));
                i = i + 1;
            }
            next = Array.Append<JsonValue>(next, item);
            return JsonValue::List(next);
        },
        _ => {
            return target;
        },
    };
    return target;
}

/// Returns the first member named `key` of an object, or `None`.
pub Option<JsonValue> Get(JsonValue target, string key) {
    match target {
        JsonValue::Object(keys, values) => {
            mut i64 i = 0;
            while i < Array.Len<string>(keys) {
                if Array.Get<string>(keys, i) == key {
                    return Option::Some(Array.Get<JsonValue>(values, i));
                }
                i = i + 1;
            }
            return Option::None;
        },
        _ => {
            return Option::None;
        },
    };
    return Option::None;
}

/// Returns the array element at `index`, or `None` for non-arrays and out-of-range indexes.
pub Option<JsonValue> At(JsonValue target, i64 index) {
    match target {
        JsonValue::List(items) => {
            if index < 0 || index >= Array.Len<JsonValue>(items) {
                return Option::None;
            }
            return Option::Some(Array.Get<JsonValue>(items, index));
        },
        _ => {
            return Option::None;
        },
    };
    return Option::None;
}

/// Element count of an array or member count of an object; `0` for other values.
pub i64 Length(JsonValue target) {
    match target {
        JsonValue::List(items) => {
            return Array.Len<JsonValue>(items);
        },
        JsonValue::Object(keys, _) => {
            return Array.Len<string>(keys);
        },
        _ => {
            return 0;
        },
    };
    return 0;
}

/// Member names of an object in document order; empty for other values.
pub string[] Keys(JsonValue target) {
    match target {
        JsonValue::Object(keys, _) => {
            return keys;
        },
        _ => {
            return Array.Empty<string>();
        },
    };
    return Array.Empty<string>();
}

/// Returns true for `null`.
pub bool IsNull(JsonValue target) {
    match target {
        JsonValue::Null => {
            return true;
        },
        _ => {
            return false;
        },
    };
    return false;
}

/// The boolean payload, or `None` for other values.
pub Option<bool> AsBool(JsonValue target) {
    match target {
        JsonValue::Bool(flag) => {
            return Option::Some(flag);
        },
        _ => {
            return Option::None;
        },
    };
    return Option::None;
}

/// The numeric payload, or `None` for other values.
pub Option<f64> AsNumber(JsonValue target) {
    match target {
        JsonValue::Number(number) => {
            return Option::Some(number);
        },
        _ => {
            return Option::None;
        },
    };
    return Option::None;
}

/// The string payload, or `None` for other values.
pub Option<string> AsText(JsonValue target) {
    match target {
        JsonValue::Text(text) => {
            return Option::Some(text);
        },
        _ => {
            return Option::None;
        },
    };
    return Option::None;
}
