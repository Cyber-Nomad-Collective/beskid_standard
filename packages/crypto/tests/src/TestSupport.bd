//! Byte helpers shared by the crypto test targets.
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Crypto.Errors;

u8 Nibble(u8 c)
{
    if (c >= 48_u8 && c <= 57_u8)
    {
        return c - 48_u8;
    }
    if (c >= 97_u8 && c <= 102_u8)
    {
        return c - 87_u8;
    }
    if (c >= 65_u8 && c <= 70_u8)
    {
        return c - 55_u8;
    }
    return 0_u8;
}

/// Hex text to bytes. An odd-length text gets an implicit leading zero nibble.
pub u8[] Hex(string text)
{
    i64 length = String.Len(text);
    i64 odd = length % 2;
    u8[] out = Slice.New((length + 1) / 2);
    mut i64 i = 0;
    while (i < length)
    {
        i64 position = i + odd;
        u8 nibble = Nibble(String.ByteAt(text, i));
        i64 index = position / 2;
        if (position % 2 == 0)
        {
            out[index] = nibble << 4_u8;
        }
        else
        {
            out[index] = out[index] | nibble;
        }
        i = i + 1;
    }
    return out;
}

string HexDigit(u8 value)
{
    if (value < 10_u8)
    {
        return String.CodeUnitChar(value + 48_u8);
    }
    return String.CodeUnitChar(value + 87_u8);
}

/// Bytes to lower-case hex text.
pub string ToHex(u8[] bytes)
{
    mut string out = "";
    mut i64 i = 0;
    while (i < Slice.Len(bytes))
    {
        out = out + HexDigit(bytes[i] >> 4_u8) + HexDigit(bytes[i] & 15_u8);
        i = i + 1;
    }
    return out;
}

/// The bytes of an ASCII text.
pub u8[] Ascii(string text)
{
    i64 length = String.Len(text);
    u8[] out = Slice.New(length);
    mut i64 i = 0;
    while (i < length)
    {
        out[i] = String.ByteAt(text, i);
        i = i + 1;
    }
    return out;
}

pub bool Same(u8[] a, u8[] b)
{
    return Slice.Compare(a, b) == 0;
}

/// The first `length` bytes of `data`.
pub u8[] Prefix(u8[] data, i64 length)
{
    u8[] out = Slice.New(length);
    Slice.Copy(out, 0, data, 0, length);
    return out;
}

/// `length` bytes where byte i is (i * multiplier + offset) mod 256.
pub u8[] Pattern(i64 length, i64 multiplier, i64 offset)
{
    u8[] out = Slice.New(length);
    mut i64 i = 0;
    while (i < length)
    {
        out[i] = u8((i * multiplier + offset) & 255);
        i = i + 1;
    }
    return out;
}

/// The bytes of a successful result; an error gives no bytes.
pub u8[] Unwrap(Result<u8[], CryptoError> result)
{
    return match (result)
    {
        Result::Ok(value) => value,
        Result::Error(_) => Slice.New(0),
    };
}

/// True when the result is `CryptoError::AuthenticationFailed`.
pub bool AuthenticationFailed(Result<u8[], CryptoError> result)
{
    return match (result)
    {
        Result::Ok(_) => false,
        Result::Error(e) => match (e)
        {
            CryptoError::AuthenticationFailed => true,
            _ => false,
        },
    };
}
