/// BigNat and ModArith tests. Vectors from Python 3 big integers:
/// random.seed(7); a=getrandbits(1000); b=getrandbits(700); m=getrandbits(2048)|1|2^2047;
/// x=getrandbits(2040); y=getrandbits(2040).
use Testing.Assert;
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Core.Time;
use Crypto.BigNat;
use Crypto.ModArith;
use Crypto.PkErrors;

pub u8 PkNibble(u8 c) {
    if c >= u8(48) && c <= u8(57) { return c - u8(48); }
    if c >= u8(97) && c <= u8(102) { return c - u8(87); }
    if c >= u8(65) && c <= u8(70) { return c - u8(55); }
    return u8(0);
}

/// Test-only hex decoder; an odd-length string gets an implicit leading zero nibble.
pub u8[] Hex(string text) {
    i64 len = String.Len(text);
    i64 odd = len % 2_i64;
    u8[] out = Slice.New((len + 1_i64) / 2_i64);
    mut i64 i = 0_i64;
    while i < len {
        i64 pos = i + odd;
        u8 nib = PkNibble(String.ByteAt(text, i));
        i64 index = pos / 2_i64;
        if pos % 2_i64 == 0_i64 { out[index] = nib << u8(4); } else { out[index] = out[index] | nib; }
        i = i + 1_i64;
    }
    return out;
}

pub string HexDigit(u8 v) {
    if v < u8(10) { return String.CodeUnitChar(v + u8(48)); }
    return String.CodeUnitChar(v + u8(87));
}

pub string ToHex(u8[] bytes) {
    mut string out = "";
    mut i64 i = 0_i64;
    while i < Slice.Len(bytes) {
        out = out + HexDigit(bytes[i] >> u8(4)) + HexDigit(bytes[i] & u8(15));
        i = i + 1_i64;
    }
    return out;
}

pub string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

pub i64 NowNanos() { Core.Time.Instant now = Time.MonotonicNow(); return now.nanos; }

u32[] Nat(string hex) {
    Result<u32[], PkError> r = BigNat.FromBytes(Hex(hex));
    return match r { Result::Ok(v) => v, Result::Error(_) => BigNat.Zeros(1_i64), };
}

string NatHex(u32[] a) {
    Result<u8[], PkError> r = BigNat.ToBytes(a, (BigNat.BitLength(a) + 7_i64) / 8_i64);
    return match r { Result::Ok(v) => ToHex(v), Result::Error(_) => "error", };
}

test pk_bignat_roundtrip {
    Assert.Equal<string>(NatHex(Nat("a139263059f28c105d1fb17c2390c192cfd3ac94af0f21ddb66cad4a268d116ece1738f7d93d9c172411e20b8f6b0d549b6f03675a1600a35a099950d836f675cc81e74ef5e8e25d940ed904759531985d5d9dc9f81818e811892f902bd23f0824128b2f330c5c7fd0a6a3a4506513270e269e0d37f2a74de452e6b438")), "a139263059f28c105d1fb17c2390c192cfd3ac94af0f21ddb66cad4a268d116ece1738f7d93d9c172411e20b8f6b0d549b6f03675a1600a35a099950d836f675cc81e74ef5e8e25d940ed904759531985d5d9dc9f81818e811892f902bd23f0824128b2f330c5c7fd0a6a3a4506513270e269e0d37f2a74de452e6b438", "bytes roundtrip");
    Assert.Equal<string>(NatHex(Nat("0000ff")), "ff", "leading zeros dropped");
    Assert.Equal<i64>(BigNat.BitLength(Nat("0100")), 9_i64, "bit length");
    Assert.True(BigNat.IsZero(Nat("")), "empty is zero");
}

test pk_bignat_fixed_width {
    Result<u32[], PkError> ok = BigNat.FromBytesFixed(Hex("00000000ffffffff"), 1_i64);
    Assert.True(match ok { Result::Ok(_) => true, Result::Error(_) => false, }, "leading zeros fit");
    Result<u32[], PkError> big = BigNat.FromBytesFixed(Hex("01ffffffff"), 1_i64);
    Assert.True(match big { Result::Ok(_) => false, Result::Error(_) => true, }, "too wide rejected");
    Result<u8[], PkError> narrow = BigNat.ToBytes(Nat("0100"), 1_i64);
    Assert.True(match narrow { Result::Ok(_) => false, Result::Error(_) => true, }, "ToBytes too narrow");
}

test pk_bignat_arith {
    u32[] a = Nat("a139263059f28c105d1fb17c2390c192cfd3ac94af0f21ddb66cad4a268d116ece1738f7d93d9c172411e20b8f6b0d549b6f03675a1600a35a099950d836f675cc81e74ef5e8e25d940ed904759531985d5d9dc9f81818e811892f902bd23f0824128b2f330c5c7fd0a6a3a4506513270e269e0d37f2a74de452e6b438");
    u32[] b = Nat("08f6d0554ef8aa38922766581e27a1c08a6a63ec24ede6a46b4cb2424a23d5962217beaddbc496cb8e81973e0becd7b03898d190f9ebdacc0cb1e29c658cda1495e60af593bd04cf0fd630f1f29d0da9953f48f1a09f76b5");
    Assert.Equal<string>(NatHex(BigNat.Add(a, b)), "a139263059f28c105d1fb17c2390c192cfd3ac94af0f21ddb66cad4a268d116ece1738f7d94692e77960dab5c7fd34baf38d2b091aa06b07462e87377ca243280ecc0b248c0afa1c41ea9d9b4123b32f9b698aa1a850b1b9a2831b6af7def0eac078180947a2428ac63a60a91f74e95800193b1ae187e696d5f3862aed", "add");
    Result<u32[], PkError> d = BigNat.Sub(a, b);
    Assert.Equal<string>(match d { Result::Ok(v) => NatHex(v), Result::Error(_) => "error", }, "a139263059f28c105d1fb17c2390c192cfd3ac94af0f21ddb66cad4a268d116ece1738f7d934a546cec2e96156d8e5ee4350dbc5998b963f6de4ab6a33cba9c38a37c3795fc6ca9ee633146daa06b0011f51b0f247df8016808f43b55fc58d2587acfe551e767674db12e69f81553cf61c3400ff8e5d6804f2b2473d83", "sub");
    Result<u32[], PkError> neg = BigNat.Sub(b, a);
    Assert.True(match neg { Result::Ok(_) => false, Result::Error(_) => true, }, "sub underflow rejected");
    Assert.Equal<string>(NatHex(BigNat.Mul(a, b)), "", "mul");
    Result<u32[], PkError> r = BigNat.Mod(a, b);
    Assert.Equal<string>(match r { Result::Ok(v) => NatHex(v), Result::Error(_) => "error", }, "402276c3a3dd2051cc03e8bc18edf47cb0d5f4c37f2af0e7f2546c89c3f10526da3344f45a3c8b63cac55b9312dd2358efda538825c94472982b8506fd731b83a1c92f4161842d020b49e73068492b515b54c026046b4b", "mod");
    Assert.Equal<i64>(BigNat.Compare(a, b), 1_i64, "compare");
    Assert.Equal<i64>(BigNat.Compare(b, a), -1_i64, "compare reversed");
    Assert.Equal<i64>(BigNat.Compare(a, BigNat.Resize(a, 60_i64)), 0_i64, "compare ignores zero limbs");
}

test pk_modarith_montgomery {
    u32[] m = Nat("");
    Result<Mont, PkError> created = ModArith.New(m);
    match created {
        Result::Error(_) => { Assert.Fail("mont context"); },
        Result::Ok(c) => {
            u32[] x = BigNat.Resize(Nat(""), c.n);
            u32[] y = BigNat.Resize(Nat(""), c.n);
            u32[] xm = BigNat.Zeros(c.n);
            u32[] ym = BigNat.Zeros(c.n);
            ModArith.ToMont(c, xm, x);
            ModArith.ToMont(c, ym, y);
            u32[] p = BigNat.Zeros(c.n);
            ModArith.Mul(c, p, xm, ym);
            ModArith.FromMont(c, p, p);
            Assert.Equal<string>(NatHex(p), "", "modmul");
            u32[] e = BigNat.Zeros(c.n);
            ModArith.PowPublic(c, e, xm, Hex("010001"));
            ModArith.FromMont(c, e, e);
            Assert.Equal<string>(NatHex(e), "", "modexp");
            u32[] s = BigNat.Zeros(c.n);
            ModArith.Add(c, s, x, y);
            Assert.Equal<string>(NatHex(s), "", "modadd");
            ModArith.Sub(c, s, x, y);
            Assert.Equal<string>(NatHex(s), "", "modsub");
            ModArith.Sub(c, s, y, x);
            Assert.Equal<string>(NatHex(s), "", "modsub wrap");
        },
    };
    Result<Mont, PkError> even = ModArith.New(Nat("10"));
    Assert.True(match even { Result::Ok(_) => false, Result::Error(_) => true, }, "even modulus rejected");
}

test pk_modarith_constant_time_helpers {
    u32[] a = [1_u32, 2_u32];
    u32[] b = [3_u32, 4_u32];
    ModArith.CondSwap(a, b, 0_u32);
    Assert.Equal<u32>(a[0], 1_u32, "no swap");
    ModArith.CondSwap(a, b, 1_u32);
    Assert.Equal<u32>(a[1], 4_u32, "swap");
    Assert.Equal<u32>(b[0], 1_u32, "swap other");
    Assert.Equal<u32>(ModArith.IsZeroBit([0_u32, 0_u32]), 1_u32, "zero");
    Assert.Equal<u32>(ModArith.IsZeroBit([0_u32, 0x80000000_u32]), 0_u32, "nonzero");
    Assert.Equal<u32>(ModArith.LessBit([5_u32, 1_u32], [4_u32, 2_u32]), 1_u32, "less");
    Assert.Equal<u32>(ModArith.LessBit([5_u32, 2_u32], [4_u32, 2_u32]), 0_u32, "not less");
    Assert.Equal<u32>(ModArith.Xor(0xF0F0_u32, 0xFF00_u32), 0x0FF0_u32, "xor");
}
