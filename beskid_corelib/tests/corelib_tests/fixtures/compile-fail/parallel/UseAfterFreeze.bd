// EXPECT: E1234
// `ReadOnlyArray.Freeze` consumes the array binding; the second use of `words` is rejected.
use Core.Collections.Array;
use Core.Parallel.ReadOnlyArray;

test FrozenArrayBindingIsConsumed {
    string[] words = Array.Empty<string>();
    ReadOnlyArray<string> r = ReadOnlyArray.Freeze<string>(move words);
    i64 n = Array.Len<string>(words);
}
