use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Crypto.Errors;

/// ChaCha20 (RFC 8439 section 2.3/2.4): 32-byte key, 12-byte nonce, 32-bit block counter.
/// Pure ARX; no table lookups, so the computation is constant time.

u32 Rotl(u32 x, u32 n) { return (x << n) | (x >> (32_u32 - n)); }
u32 Xor(u32 a, u32 b) { return (a | b) - (a & b); }

u32 Le32(u8[] data, i64 offset) {
    return u32(data[offset]) | (u32(data[offset + 1_i64]) << 8_u32) | (u32(data[offset + 2_i64]) << 16_u32) | (u32(data[offset + 3_i64]) << 24_u32);
}

unit QuarterRound(u32[] x, i64 a, i64 b, i64 c, i64 d) {
    x[a] = x[a] + x[b]; x[d] = Rotl(Xor(x[d], x[a]), 16_u32);
    x[c] = x[c] + x[d]; x[b] = Rotl(Xor(x[b], x[c]), 12_u32);
    x[a] = x[a] + x[b]; x[d] = Rotl(Xor(x[d], x[a]), 8_u32);
    x[c] = x[c] + x[d]; x[b] = Rotl(Xor(x[b], x[c]), 7_u32);
    return;
}

u32[] Words(i64 count) {
    mut u32[] out = Array.Empty<u32>();
    mut i64 i = 0_i64;
    while i < count { Array.Append<u32>(out, 0_u32); i = i + 1_i64; }
    return out;
}

/// Initial state: constants, key, counter slot (index 12), nonce.
u32[] InitialState(u8[] key, u8[] nonce) {
    u32[] s = Words(16_i64);
    s[0] = 0x61707865_u32; s[1] = 0x3320646e_u32; s[2] = 0x79622d32_u32; s[3] = 0x6b206574_u32;
    mut i64 i = 0_i64;
    while i < 8_i64 { s[4_i64 + i] = Le32(key, i * 4_i64); i = i + 1_i64; }
    s[13] = Le32(nonce, 0_i64); s[14] = Le32(nonce, 4_i64); s[15] = Le32(nonce, 8_i64);
    return s;
}

/// Computes the keystream block for the counter in `s[12]` into `out` (64 bytes) using scratch `x`.
unit KeystreamBlock(u32[] s, u32[] x, u8[] out) {
    mut i64 i = 0_i64;
    while i < 16_i64 { x[i] = s[i]; i = i + 1_i64; }
    mut i64 round = 0_i64;
    while round < 10_i64 {
        QuarterRound(x, 0_i64, 4_i64, 8_i64, 12_i64);
        QuarterRound(x, 1_i64, 5_i64, 9_i64, 13_i64);
        QuarterRound(x, 2_i64, 6_i64, 10_i64, 14_i64);
        QuarterRound(x, 3_i64, 7_i64, 11_i64, 15_i64);
        QuarterRound(x, 0_i64, 5_i64, 10_i64, 15_i64);
        QuarterRound(x, 1_i64, 6_i64, 11_i64, 12_i64);
        QuarterRound(x, 2_i64, 7_i64, 8_i64, 13_i64);
        QuarterRound(x, 3_i64, 4_i64, 9_i64, 14_i64);
        round = round + 1_i64;
    }
    i = 0_i64;
    while i < 16_i64 {
        u32 v = x[i] + s[i];
        i64 p = i * 4_i64;
        out[p] = u8(v & 0xFF_u32);
        out[p + 1_i64] = u8((v >> 8_u32) & 0xFF_u32);
        out[p + 2_i64] = u8((v >> 16_u32) & 0xFF_u32);
        out[p + 3_i64] = u8(v >> 24_u32);
        i = i + 1_i64;
    }
    return;
}

bool ValidParameters(u8[] key, u8[] nonce) {
    return Slice.Len(key) == 32_i64 && Slice.Len(nonce) == 12_i64;
}

/// The 64-byte block function output for `counter` (RFC 8439 section 2.3).
/// Also the QUIC ChaCha20 header-protection mask source (RFC 9001 section 5.4.4).
pub Result<u8[], CryptoError> Block(u8[] key, u32 counter, u8[] nonce) {
    if Slice.Len(key) != 32_i64 { return Result::Error(CryptoError::InvalidKeyLength()); }
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    u32[] s = InitialState(key, nonce);
    s[12] = counter;
    u8[] out = Slice.New(64_i64);
    KeystreamBlock(s, Words(16_i64), out);
    return Result::Ok(out);
}

/// XORs `count` bytes of `input` at `inputOffset` with the keystream starting at block
/// `counter`, writing to `output` at `outputOffset`. Encryption and decryption are the same.
/// Keys and nonces must already be validated; returns false for invalid ranges or when the
/// 32-bit block counter would wrap.
pub bool XorInto(u8[] key, u32 counter, u8[] nonce, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset) {
    if !ValidParameters(key, nonce) { return false; }
    if !Slice.IsValidRange(Slice.Len(input), inputOffset, count) { return false; }
    if !Slice.IsValidRange(Slice.Len(output), outputOffset, count) { return false; }
    i64 blocks = (count + 63_i64) / 64_i64;
    if i64(counter) + blocks > 4294967296_i64 { return false; }
    u32[] s = InitialState(key, nonce);
    s[12] = counter;
    u32[] x = Words(16_i64);
    u8[] stream = Slice.New(64_i64);
    mut i64 done = 0_i64;
    while done < count {
        KeystreamBlock(s, x, stream);
        s[12] = s[12] + 1_u32;
        mut i64 take = 64_i64;
        if count - done < take { take = count - done; }
        mut i64 j = 0_i64;
        while j < take {
            u8 a = input[inputOffset + done + j];
            u8 b = stream[j];
            output[outputOffset + done + j] = (a | b) - (a & b);
            j = j + 1_i64;
        }
        done = done + take;
    }
    return true;
}

/// One-shot ChaCha20 encryption or decryption of `data`.
pub Result<u8[], CryptoError> Apply(u8[] key, u32 counter, u8[] nonce, u8[] data) {
    if Slice.Len(key) != 32_i64 { return Result::Error(CryptoError::InvalidKeyLength()); }
    if Slice.Len(nonce) != 12_i64 { return Result::Error(CryptoError::InvalidNonceLength()); }
    u8[] out = Slice.New(Slice.Len(data));
    if !XorInto(key, counter, nonce, data, 0_i64, Slice.Len(data), out, 0_i64) {
        return Result::Error(CryptoError::InvalidLength());
    }
    return Result::Ok(out);
}
