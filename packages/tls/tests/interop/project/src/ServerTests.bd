use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Environment;
use Core.FS;
use Core.IO;
use Core.IO.IoError;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Time.TimerError;
use Codec.Hex;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Network.Types;
use Testing.Assert;
use Tls;
use Tls.PeerKeys;
use Tls.Suites;
use Tls.TlsConfig;
use Tls.TlsErrors;
use Tls.TlsStream;

// Beskid TLS server for `openssl s_client` (driven by tests/interop/run.sh). Accepts one
// connection, reads one chunk, echoes it, then closes with close_notify.
// Environment: TLS_INTEROP_PORT, TLS_INTEROP_GROUPS ("29", "23", or "23" only to force HRR),
// TLS_INTEROP_ALPN (server-supported protocol, optional).

unit Expect(i64 actual, string what) {
    if actual != 0_i64 { Assert.Fail(what + ": code " + Dec2(actual)); }
    return;
}

string Dec2(i64 v) {
    if v < 0_i64 { return "-" + Dec2(0_i64 - v); }
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec2(v / 10_i64) + String.DigitChar(v % 10_i64);
}

i64 EnvInt(string name, i64 fallback) {
    Option<string> v = Environment.TryGet(name);
    string text = Option.UnwrapOr<string>(v, "");
    i64 n = String.Len(text);
    if n == 0_i64 { return fallback; }
    mut i64 value = 0_i64;
    mut i64 i = 0_i64;
    while i < n { value = value * 10_i64 + (i64(String.ByteAt(text, i)) - 48_i64); i = i + 1_i64; }
    return value;
}

Option<Deadline> Soon() {
    Result<Deadline, TimerError> d = Deadline.After(Time.FromMilliseconds(60000_i64));
    return match d { Result::Ok(v) => Option.FromValue<Deadline>(v), Result::Error(_) => Option.Empty<Deadline>(), };
}

i64 Run() {
    i64 port = EnvInt("TLS_INTEROP_PORT", 44331_i64);
    i64 group = EnvInt("TLS_INTEROP_GROUP", 29_i64);
    string alpn = Option.UnwrapOr<string>(Environment.TryGet("TLS_INTEROP_ALPN"), "");
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    TlsServerConfig s = TlsConfig.Server(TlsConfig.Chain1(ServerCertDer()), key);
    s.groups = [group];
    if String.Len(alpn) > 0_i64 {
        mut string[] supported = Array.Empty<string>();
        Array.Append<string>(supported, alpn);
        s.alpn = supported;
    }
    SocketAddress bindAddress = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(u8((port >> 8_i64) & 255_i64), u8(port & 255_i64)) };
    Result<TcpListener, NetworkError> bound = TcpListener.Bind(bindAddress, 4_i64);
    match bound {
        Result::Error(_) => { return 1_i64; },
        Result::Ok(listener) => {
            string ready = Option.UnwrapOr<string>(Environment.TryGet("TLS_INTEROP_READY"), "");
            if String.Len(ready) > 0_i64 { FS.WriteAllText(ready, "ready"); }
            Result<TcpStream, NetworkError> accepted = listener.Accept(Soon());
            listener.Close();
            match accepted {
                Result::Error(_) => { return 2_i64; },
                Result::Ok(tcp) => {
                    Result<TlsStream, TlsError> tls = Tls.Accept(tcp, s, Soon());
                    match tls {
                        Result::Error(e) => { return TlsErrors.Code(e); },
                        Result::Ok(stream) => {
                            u8[] buf = Slice.New(256_i64);
                            Result<i64, IoError> n = stream.Read(buf, 0_i64, 256_i64);
                            i64 got = match n { Result::Ok(v) => v, Result::Error(_) => -1_i64, };
                            if got <= 0_i64 { stream.Close(); return 3_i64; }
                            Result<unit, IoError> w = IO.WriteAll(stream, buf, 0_i64, got);
                            stream.Close();
                            return match w { Result::Ok(_) => 0_i64, Result::Error(_) => 4_i64, };
                        },
                    };
                },
            };
        },
    };
}

unit RunInto(i64[] code) { code[0] = Run(); return; }

// Network operations run inside a spawned fiber.
test interop_server_for_openssl_s_client {
    i64[] code = [-1_i64];
    Fiber<unit> f = spawn (() => RunInto(code));
    f.Join();
    Expect(code[0], "Beskid server serves one openssl s_client connection");
}
