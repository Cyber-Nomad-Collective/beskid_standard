// Combiner contracts for parallel reductions and the shipped combiners.
//
// `Associative<T>` and `Commutative<T>` are marker contracts that carry a combiner's algebraic
// claim; the compiler does not prove it. `ParallelSeq.Reduce` requires `Associative<T>`;
// `ParallelSeq.ReduceUnordered` requires both. A combiner is passed to the worker isolates, so
// it must be transferable: the shipped combiners are `[Immutable]` and stateless.

/// `Combine` is associative: `Combine(a, Combine(b, c)) == Combine(Combine(a, b), c)`.
pub contract Associative<T>
{
    T Combine(T left, T right);
}

/// Marker: the `Combine` of an `Associative<T>` is also commutative: `Combine(a, b) == Combine(b, a)`.
/// It declares no method, so `Combine` has one declaring bound.
pub contract Commutative<T> { }

/// Integer addition.
[Immutable]
pub type SumI64 : Associative<i64>, Commutative<i64>
{
    pub i64 Combine(i64 left, i64 right)
    {
        return left + right;
    }
}

/// Floating-point addition. Rounding makes it associative only up to rounding; `Reduce` keeps
/// the input order of the chunk results, `ReduceUnordered` does not.
[Immutable]
pub type SumF64 : Associative<f64>, Commutative<f64>
{
    pub f64 Combine(f64 left, f64 right)
    {
        return left + right;
    }
}

/// Integer maximum.
[Immutable]
pub type MaxI64 : Associative<i64>, Commutative<i64>
{
    pub i64 Combine(i64 left, i64 right)
    {
        if (right > left)
        {
            return right;
        }
        return left;
    }
}

/// Integer minimum.
[Immutable]
pub type MinI64 : Associative<i64>, Commutative<i64>
{
    pub i64 Combine(i64 left, i64 right)
    {
        if (right < left)
        {
            return right;
        }
        return left;
    }
}

/// String concatenation. Associative but not commutative.
[Immutable]
pub type Concat : Associative<string>
{
    pub string Combine(string left, string right)
    {
        return left + right;
    }
}

/// Count accumulation: adds partial counts.
[Immutable]
pub type Count : Associative<i64>, Commutative<i64>
{
    pub i64 Combine(i64 left, i64 right)
    {
        return left + right;
    }
}
