use Core.Results;
use Core.Numeric.FloatBits;
use Core.Serialization.Errors;
use Core.Serialization.Limits;
use Core.Serialization.Reader as ReaderApi;

// Canonical leaf field reads. The field decoder correspondence issues these exact
// functions for an abstract field whose current application is a scalar; each one
// retains its declared width and range. A target-width word has no declared wire
// width here and is never issued.

pub Result<unit, SerializationError> ReadUnit<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    unit value = reader.ReadUnit()?;
    return Result::Ok(value);
}

pub Result<bool, SerializationError> ReadBoolean<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    bool value = reader.ReadBoolean()?;
    return Result::Ok(value);
}

pub Result<i8, SerializationError> ReadSigned8<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    i64 value = reader.ReadSigned(8_u8)?;
    if (value < -128_i64 || value > 127_i64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(i8(value));
}

pub Result<i16, SerializationError> ReadSigned16<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    i64 value = reader.ReadSigned(16_u8)?;
    if (value < -32768_i64 || value > 32767_i64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(i16(value));
}

pub Result<i32, SerializationError> ReadSigned32<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    i64 value = reader.ReadSigned(32_u8)?;
    if (value < -2147483648_i64 || value > 2147483647_i64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(i32(value));
}

pub Result<i64, SerializationError> ReadSigned64<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    i64 value = reader.ReadSigned(64_u8)?;
    return Result::Ok(value);
}

pub Result<u8, SerializationError> ReadUnsigned8<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadUnsigned(8_u8)?;
    if (value > 255_u64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(u8(value));
}

pub Result<u16, SerializationError> ReadUnsigned16<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadUnsigned(16_u8)?;
    if (value > 65535_u64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(u16(value));
}

pub Result<u32, SerializationError> ReadUnsigned32<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadUnsigned(32_u8)?;
    if (value > 4294967295_u64)
    {
        return Result::Error(Errors.NumericError("IntegerOutOfRange"));
    }
    return Result::Ok(u32(value));
}

pub Result<u64, SerializationError> ReadUnsigned64<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadUnsigned(64_u8)?;
    return Result::Ok(value);
}

pub Result<f32, SerializationError> ReadFloat32<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadFloat(32_u8)?;
    if (value > 4294967295_u64)
    {
        return Result::Error(Errors.NumericError("FloatBitsOutOfRange"));
    }
    return Result::Ok(FloatBits.FromBits32(u32(value)));
}

pub Result<f64, SerializationError> ReadFloat64<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    u64 value = reader.ReadFloat(64_u8)?;
    return Result::Ok(FloatBits.FromBits64(value));
}

pub Result<char, SerializationError> ReadScalar<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    char value = reader.ReadScalar()?;
    return Result::Ok(value);
}

pub Result<string, SerializationError> ReadString<R>(R reader, SerializationLimits limits) where R: ReaderApi.Reader
{
    string value = reader.ReadString()?;
    return Result::Ok(value);
}
