/// Core.Collections.Sort — stable sorting, keyed ordering, and binary search for arrays.
/// @tier(supported)
/// Every sort is a stable bottom-up merge sort (`O(n log n)`) that returns a new array and leaves
/// its input unchanged. Arbitrary element types are ordered through a parallel key array
/// (`ByI64Key`, `ByF64Key`, `ByStringKey`), which needs no comparator callback. Strings compare
/// ordinally (byte-wise); f64 NaN keys sort after every other value.
use Core.Collections.Array;
use Core.String.Search;

i64[] Identity(i64 count) {
    mut i64[] order = Array.Empty<i64>();
    mut i64 i = 0;
    while i < count {
        order = Array.Append<i64>(order, i);
        i = i + 1;
    }
    return order;
}

/// Ascending i64 order with a stable tie-break on the original position.
bool I64Before(i64[] keys, i64 a, i64 b) {
    return Array.Get<i64>(keys, a) <= Array.Get<i64>(keys, b);
}

/// Ascending f64 order (NaN last) with a stable tie-break.
bool F64Before(f64[] keys, i64 a, i64 b) {
    f64 x = Array.Get<f64>(keys, a);
    f64 y = Array.Get<f64>(keys, b);
    if y != y {
        return true;
    }
    if x != x {
        return false;
    }
    return x <= y;
}

/// Ascending ordinal string order with a stable tie-break.
bool StringBefore(string[] keys, i64 a, i64 b) {
    return Search.Compare(Array.Get<string>(keys, a), Array.Get<string>(keys, b)) <= 0;
}

/// Returns the stable ascending permutation of positions for `keys`: `order[i]` is the index in
/// `keys` of the element that belongs at sorted position `i`.
pub i64[] OrderByI64(i64[] keys) {
    i64 count = Array.Len<i64>(keys);
    mut i64[] source = Identity(count);
    mut i64 width = 1;
    while width < count {
        mut i64[] target = Array.Empty<i64>();
        mut i64 left = 0;
        while left < count {
            mut i64 mid = left + width;
            if mid > count {
                mid = count;
            }
            mut i64 right = left + width * 2;
            if right > count {
                right = count;
            }
            mut i64 i = left;
            mut i64 j = mid;
            while i < mid && j < right {
                if I64Before(keys, Array.Get<i64>(source, i), Array.Get<i64>(source, j)) {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                    i = i + 1;
                } else {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                    j = j + 1;
                }
            }
            while i < mid {
                target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                i = i + 1;
            }
            while j < right {
                target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                j = j + 1;
            }
            left = right;
        }
        source = target;
        width = width * 2;
    }
    return source;
}

/// Stable ascending permutation of positions for f64 `keys` (NaN last).
pub i64[] OrderByF64(f64[] keys) {
    i64 count = Array.Len<f64>(keys);
    mut i64[] source = Identity(count);
    mut i64 width = 1;
    while width < count {
        mut i64[] target = Array.Empty<i64>();
        mut i64 left = 0;
        while left < count {
            mut i64 mid = left + width;
            if mid > count {
                mid = count;
            }
            mut i64 right = left + width * 2;
            if right > count {
                right = count;
            }
            mut i64 i = left;
            mut i64 j = mid;
            while i < mid && j < right {
                if F64Before(keys, Array.Get<i64>(source, i), Array.Get<i64>(source, j)) {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                    i = i + 1;
                } else {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                    j = j + 1;
                }
            }
            while i < mid {
                target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                i = i + 1;
            }
            while j < right {
                target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                j = j + 1;
            }
            left = right;
        }
        source = target;
        width = width * 2;
    }
    return source;
}

/// Stable ascending permutation of positions for ordinal string `keys`.
pub i64[] OrderByString(string[] keys) {
    i64 count = Array.Len<string>(keys);
    mut i64[] source = Identity(count);
    mut i64 width = 1;
    while width < count {
        mut i64[] target = Array.Empty<i64>();
        mut i64 left = 0;
        while left < count {
            mut i64 mid = left + width;
            if mid > count {
                mid = count;
            }
            mut i64 right = left + width * 2;
            if right > count {
                right = count;
            }
            mut i64 i = left;
            mut i64 j = mid;
            while i < mid && j < right {
                if StringBefore(keys, Array.Get<i64>(source, i), Array.Get<i64>(source, j)) {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                    i = i + 1;
                } else {
                    target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                    j = j + 1;
                }
            }
            while i < mid {
                target = Array.Append<i64>(target, Array.Get<i64>(source, i));
                i = i + 1;
            }
            while j < right {
                target = Array.Append<i64>(target, Array.Get<i64>(source, j));
                j = j + 1;
            }
            left = right;
        }
        source = target;
        width = width * 2;
    }
    return source;
}

/// Returns `items` rearranged so position `i` holds `items[order[i]]`.
/// `order` must contain valid indexes into `items`; it is usually produced by an `OrderBy*` call.
pub T[] Permute<T>(T[] items, i64[] order) {
    mut T[] result = Array.Empty<T>();
    mut i64 i = 0;
    while i < Array.Len<i64>(order) {
        result = Array.Append<T>(result, Array.Get<T>(items, Array.Get<i64>(order, i)));
        i = i + 1;
    }
    return result;
}

/// Sorts i64 values ascending.
pub i64[] I64(i64[] values) {
    return Permute<i64>(values, OrderByI64(values));
}

/// Sorts f64 values ascending, NaN last.
pub f64[] F64(f64[] values) {
    return Permute<f64>(values, OrderByF64(values));
}

/// Sorts strings in ascending ordinal (byte-wise) order.
pub string[] Strings(string[] values) {
    return Permute<string>(values, OrderByString(values));
}

/// Stable-sorts `items` by the parallel i64 `keys` (`keys[i]` belongs to `items[i]`).
/// Both arrays must have the same length.
pub T[] ByI64Key<T>(T[] items, i64[] keys) {
    return Permute<T>(items, OrderByI64(keys));
}

/// Stable-sorts `items` by the parallel f64 `keys`, NaN keys last.
pub T[] ByF64Key<T>(T[] items, f64[] keys) {
    return Permute<T>(items, OrderByF64(keys));
}

/// Stable-sorts `items` by the parallel ordinal string `keys`.
pub T[] ByStringKey<T>(T[] items, string[] keys) {
    return Permute<T>(items, OrderByString(keys));
}

/// Returns true when `values` is in ascending order.
pub bool IsSortedI64(i64[] values) {
    mut i64 i = 1;
    while i < Array.Len<i64>(values) {
        if Array.Get<i64>(values, i - 1) > Array.Get<i64>(values, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Returns true when `values` is in ascending ordinal order.
pub bool IsSortedStrings(string[] values) {
    mut i64 i = 1;
    while i < Array.Len<string>(values) {
        if Search.Compare(Array.Get<string>(values, i - 1), Array.Get<string>(values, i)) > 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Searches ascending `sorted` for `value`. Returns its index when found; otherwise returns
/// `-(insertionPoint) - 1`, where `insertionPoint` keeps the array sorted.
pub i64 BinarySearchI64(i64[] sorted, i64 value) {
    mut i64 low = 0;
    mut i64 high = Array.Len<i64>(sorted) - 1;
    while low <= high {
        i64 mid = low + (high - low) / 2;
        i64 probe = Array.Get<i64>(sorted, mid);
        if probe < value {
            low = mid + 1;
        } else {
            if probe > value {
                high = mid - 1;
            } else {
                return mid;
            }
        }
    }
    return 0 - low - 1;
}

/// Searches ordinally sorted `sorted` for `value`, with the same result convention as
/// `BinarySearchI64`.
pub i64 BinarySearchString(string[] sorted, string value) {
    mut i64 low = 0;
    mut i64 high = Array.Len<string>(sorted) - 1;
    while low <= high {
        i64 mid = low + (high - low) / 2;
        i64 order = Search.Compare(Array.Get<string>(sorted, mid), value);
        if order < 0 {
            low = mid + 1;
        } else {
            if order > 0 {
                high = mid - 1;
            } else {
                return mid;
            }
        }
    }
    return 0 - low - 1;
}
