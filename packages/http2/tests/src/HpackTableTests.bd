use Testing.Assert;
use Core.Bytes.Convert;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Core.String;
use Http2.Hpack;
use Http2.HpackDecoder;
use Http2.HpackEncoder;

// Shared test helpers (each target is compiled on its own).

i64 HexDigit(u8 b) {
    if b >= 48_u8 && b <= 57_u8 { return i64(b - 48_u8); }
    if b >= 97_u8 && b <= 102_u8 { return i64(b - 97_u8) + 10_i64; }
    if b >= 65_u8 && b <= 70_u8 { return i64(b - 65_u8) + 10_i64; }
    return -1_i64;
}

u8[] Hex(string text) {
    mut u8[] out = [];
    mut i64 high = -1_i64;
    mut i64 i = 0_i64;
    while i < String.Len(text) {
        i64 digit = HexDigit(String.ByteAt(text, i));
        if digit >= 0_i64 {
            if high < 0_i64 { high = digit; } else { Array.Append<u8>(out, u8(high * 16_i64 + digit)); high = -1_i64; }
        }
        i = i + 1_i64;
    }
    return out;
}

string HexText(u8[] data) {
    string digits = "0123456789abcdef";
    mut string out = "";
    mut i64 i = 0_i64;
    while i < Slice.Len(data) {
        i64 b = i64(data[i]);
        out = out + String.SubSlice(digits, b / 16_i64, 1_i64) + String.SubSlice(digits, b % 16_i64, 1_i64);
        i = i + 1_i64;
    }
    return out;
}

unit ExpectBytes(u8[] actual, string expectedHex, string because) {
    Assert.True(Hpack.BytesEqual(actual, Hex(expectedHex)), because + ": got " + HexText(actual) + " want " + HexText(Hex(expectedHex)));
    return;
}

string Text(u8[] data) {
    return match Convert.BytesToString(data) { Result::Ok(text) => text, Result::Error(_) => "<binary " + HexText(data) + ">", };
}

unit ExpectField(HeaderField field, string name, string value, string because) {
    Assert.True(Hpack.BytesEqual(field.name, Convert.StringToBytes(name)) && Hpack.BytesEqual(field.value, Convert.StringToBytes(value)),
        because + ": got " + Text(field.name) + ": " + Text(field.value) + " want " + name + ": " + value);
    return;
}

/// `expected` alternates names and values.
unit ExpectFields(HeaderField[] fields, string[] expected, string because) {
    Assert.Equal<i64>(Array.Len<HeaderField>(fields) * 2_i64, Array.Len<string>(expected), because + ": field count");
    mut i64 i = 0_i64;
    while i < Array.Len<HeaderField>(fields) {
        ExpectField(Array.Get<HeaderField>(fields, i), Array.Get<string>(expected, i * 2_i64), Array.Get<string>(expected, i * 2_i64 + 1_i64), because);
        i = i + 1_i64;
    }
    return;
}

HeaderField[] Fields(string[] pairs) {
    mut HeaderField[] out = Array.Empty<HeaderField>();
    mut i64 i = 0_i64;
    while i + 1_i64 < Array.Len<string>(pairs) {
        Array.Append<HeaderField>(out, Hpack.Field(Array.Get<string>(pairs, i), Array.Get<string>(pairs, i + 1_i64)));
        i = i + 2_i64;
    }
    return out;
}

Decoder NewTestDecoder(i64 tableSize) {
    mut DecoderLimits limits = HpackDecoder.DefaultDecoderLimits();
    limits.settingsTableSize = tableSize;
    Result<Decoder,HpackError> created = HpackDecoder.NewDecoder(limits);
    match created {
        Result::Ok(decoder) => { return decoder; },
        Result::Error(_) => { Assert.Fail("NewDecoder"); },
    };
    return NewTestDecoder(4096_i64);
}

Encoder NewTestEncoder(EncoderPolicy policy) {
    Result<Encoder,HpackError> created = HpackEncoder.NewEncoder(policy);
    match created {
        Result::Ok(encoder) => { return encoder; },
        Result::Error(_) => { Assert.Fail("NewEncoder"); },
    };
    return NewTestEncoder(HpackEncoder.DefaultEncoderPolicy());
}

HeaderField[] DecodeOk(mut Decoder decoder, string blockHex, string because) {
    Result<HeaderField[],HpackError> result = HpackDecoder.Decode(decoder, Hex(blockHex));
    match result {
        Result::Ok(fields) => { return fields; },
        Result::Error(_) => { Assert.Fail(because + ": decode failed"); },
    };
    return Array.Empty<HeaderField>();
}

HpackError DecodeErr(mut Decoder decoder, string blockHex, string because) {
    Result<HeaderField[],HpackError> result = HpackDecoder.Decode(decoder, Hex(blockHex));
    match result {
        Result::Ok(_) => { Assert.Fail(because + ": decode succeeded"); },
        Result::Error(error) => { return error; },
    };
    return HpackError::Truncated;
}

/// Dynamic table expectations: `expected` alternates names and values, newest first.
unit ExpectTable(Decoder decoder, string[] expected, i64 size, string because) {
    Assert.Equal<i64>(HpackDecoder.TableSize(decoder), size, because + ": table size");
    Assert.Equal<i64>(HpackDecoder.TableCount(decoder) * 2_i64, Array.Len<string>(expected), because + ": table count");
    mut i64 i = 0_i64;
    while i < HpackDecoder.TableCount(decoder) {
        ExpectField(HpackDecoder.TableEntry(decoder, i + 1_i64), Array.Get<string>(expected, i * 2_i64), Array.Get<string>(expected, i * 2_i64 + 1_i64), because + ": table entry");
        i = i + 1_i64;
    }
    return;
}

EncoderPolicy RfcPolicy(i64 tableSize, bool huffman) {
    mut EncoderPolicy policy = HpackEncoder.DefaultEncoderPolicy();
    policy.tableSize = tableSize;
    if huffman { policy.huffman = HuffmanMode::Always; } else { policy.huffman = HuffmanMode::Never; }
    return policy;
}

/// Stable numbers for HpackError variants, for compact assertions.
i64 ErrorCode(HpackError error) {
    return match error {
        HpackError::Truncated => 1_i64,
        HpackError::IntegerOverflow => 2_i64,
        HpackError::InvalidIndex(_) => 3_i64,
        HpackError::StringTooLong(_) => 4_i64,
        HpackError::HuffmanPaddingTooLong => 5_i64,
        HpackError::HuffmanInvalidPadding => 6_i64,
        HpackError::HuffmanEos => 7_i64,
        HpackError::SizeUpdateNotAtStart => 8_i64,
        HpackError::SizeUpdateExceedsLimit(_) => 9_i64,
        HpackError::SizeUpdateMissing => 10_i64,
        HpackError::HeaderListTooLarge(_) => 11_i64,
        HpackError::TooManyFields => 12_i64,
        HpackError::InvalidText => 13_i64,
        HpackError::DecoderFailed => 14_i64,
        HpackError::InvalidLimit(_) => 15_i64,
    };
}

unit ExpectDecodeError(mut Decoder decoder, string blockHex, i64 code, string because) {
    HpackError error = DecodeErr(decoder, blockHex, because);
    Assert.Equal<i64>(ErrorCode(error), code, because);
    return;
}
use Http2.HpackTable;

// RFC 7541 sections 2.3 and 4: static table, dynamic table size accounting and eviction.

HeaderField Sized(string name, i64 valueLength) {
    mut string value = "";
    mut i64 i = 0_i64;
    while i < valueLength { value = value + "v"; i = i + 1_i64; }
    return Hpack.Field(name, value);
}

HeaderField LookupOk(StaticTable statics, DynamicTable table, i64 index) {
    Result<HeaderField,HpackError> r = HpackTable.Lookup(statics, table, index);
    match r {
        Result::Ok(field) => { return field; },
        Result::Error(_) => { Assert.Fail("lookup failed"); },
    };
    return Hpack.Field("", "");
}

test static_table_matches_appendix_a {
    StaticTable statics = HpackTable.NewStaticTable();
    DynamicTable table = HpackTable.NewDynamicTable(4096_i64);
    Assert.Equal<i64>(Array.Len<HeaderField>(statics.entries), 61_i64, "61 entries");
    ExpectField(LookupOk(statics, table, 1_i64), ":authority", "", "1");
    ExpectField(LookupOk(statics, table, 2_i64), ":method", "GET", "2");
    ExpectField(LookupOk(statics, table, 8_i64), ":status", "200", "8");
    ExpectField(LookupOk(statics, table, 16_i64), "accept-encoding", "gzip, deflate", "16");
    ExpectField(LookupOk(statics, table, 32_i64), "cookie", "", "32");
    ExpectField(LookupOk(statics, table, 55_i64), "set-cookie", "", "55");
    ExpectField(LookupOk(statics, table, 61_i64), "www-authenticate", "", "61");
    Result<HeaderField,HpackError> past = HpackTable.Lookup(statics, table, 62_i64);
    match past { Result::Ok(_) => { Assert.Fail("62 on an empty table"); }, Result::Error(e) => { Assert.Equal<i64>(ErrorCode(e), 3_i64, "InvalidIndex"); }, };
}

test entry_size_counts_32_octets_overhead {
    Assert.Equal<i64>(Hpack.FieldSize(Hpack.Field("custom-key", "custom-header")), 55_i64, "10 + 13 + 32");
    Assert.Equal<i64>(Hpack.FieldSize(Hpack.Field("", "")), 32_i64, "empty field");
}

test insert_evicts_oldest_first {
    StaticTable statics = HpackTable.NewStaticTable();
    mut DynamicTable table = HpackTable.NewDynamicTable(100_i64);
    HpackTable.DynamicInsert(table, Sized("a", 9_i64));
    HpackTable.DynamicInsert(table, Sized("b", 9_i64));
    HpackTable.DynamicInsert(table, Sized("c", 9_i64));
    // 42 * 3 > 100, so "a" was evicted.
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 2_i64, "two entries");
    Assert.Equal<i64>(table.size, 84_i64, "size 84");
    ExpectField(LookupOk(statics, table, 62_i64), "c", "vvvvvvvvv", "newest is 62");
    ExpectField(LookupOk(statics, table, 63_i64), "b", "vvvvvvvvv", "older is 63");
}

test entry_exactly_filling_the_table_is_kept {
    mut DynamicTable table = HpackTable.NewDynamicTable(55_i64);
    HpackTable.DynamicInsert(table, Hpack.Field("custom-key", "custom-header"));
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 1_i64, "fits exactly");
    Assert.Equal<i64>(table.size, 55_i64, "size 55");
}

test entry_larger_than_table_empties_it {
    mut DynamicTable table = HpackTable.NewDynamicTable(100_i64);
    HpackTable.DynamicInsert(table, Sized("a", 9_i64));
    HpackTable.DynamicInsert(table, Sized("big", 70_i64));
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 0_i64, "emptied");
    Assert.Equal<i64>(table.size, 0_i64, "size 0");
}

test resize_evicts_until_it_fits {
    mut DynamicTable table = HpackTable.NewDynamicTable(4096_i64);
    mut i64 i = 0_i64;
    while i < 10_i64 { HpackTable.DynamicInsert(table, Sized("k", 9_i64)); i = i + 1_i64; }
    Assert.Equal<i64>(table.size, 420_i64, "ten entries of 42");
    HpackTable.DynamicResize(table, 100_i64);
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 2_i64, "two remain");
    Assert.Equal<i64>(table.size, 84_i64, "84");
    HpackTable.DynamicResize(table, 0_i64);
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 0_i64, "zero size empties");
}

test many_inserts_keep_order_across_compaction {
    StaticTable statics = HpackTable.NewStaticTable();
    mut DynamicTable table = HpackTable.NewDynamicTable(420_i64);
    string digits = "0123456789";
    mut i64 i = 0_i64;
    while i < 500_i64 {
        string name = "n" + String.SubSlice(digits, (i / 100_i64) % 10_i64, 1_i64) + String.SubSlice(digits, (i / 10_i64) % 10_i64, 1_i64) + String.SubSlice(digits, i % 10_i64, 1_i64);
        HpackTable.DynamicInsert(table, Hpack.Field(name, "vvvvvv"));
        i = i + 1_i64;
    }
    // Each entry is 4 + 6 + 32 = 42 octets, so ten fit.
    Assert.Equal<i64>(HpackTable.DynamicCount(table), 10_i64, "ten entries");
    Assert.Equal<i64>(table.size, 420_i64, "full");
    Assert.True(Array.Len<HeaderField>(table.entries) < 64_i64, "backing array compacted");
    ExpectField(LookupOk(statics, table, 62_i64), "n499", "vvvvvv", "newest");
    ExpectField(LookupOk(statics, table, 71_i64), "n490", "vvvvvv", "oldest");
}

test find_prefers_lowest_index {
    StaticTable statics = HpackTable.NewStaticTable();
    mut DynamicTable table = HpackTable.NewDynamicTable(4096_i64);
    HpackTable.DynamicInsert(table, Hpack.Field(":status", "302"));
    HpackTable.DynamicInsert(table, Hpack.Field("x-custom", "1"));
    Assert.Equal<i64>(HpackTable.FindField(statics, table, Hpack.Field(":method", "GET")), 2_i64, "static full match");
    Assert.Equal<i64>(HpackTable.FindField(statics, table, Hpack.Field(":status", "302")), 63_i64, "dynamic full match");
    Assert.Equal<i64>(HpackTable.FindField(statics, table, Hpack.Field(":status", "307")), 0_i64, "no full match");
    Assert.Equal<i64>(HpackTable.FindName(statics, table, Convert.StringToBytes(":status")), 8_i64, "static name first");
    Assert.Equal<i64>(HpackTable.FindName(statics, table, Convert.StringToBytes("x-custom")), 62_i64, "dynamic name");
    Assert.Equal<i64>(HpackTable.FindName(statics, table, Convert.StringToBytes("x-other")), 0_i64, "unknown name");
}
