/// Canary: Field access directly on a call result lowers.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

pub type Point {
    i64 x,
}

Point Make() {
    return Point { x: 9 };
}

test field_access_on_call_result {
    Assert.True(Make().x == 9, "field of a call result");
}
