use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Codec.Be;
use Codec.Errors;
use Codec.Varint;

/// Marks where a length prefix was reserved (see BeginVec / EndVec).
pub type VecMark { pub i64 position, pub i64 prefixBytes, }

/// A growable, optionally bounded byte writer. Every writer reports LimitExceeded
/// instead of growing past `limit`; a failed write leaves the content unchanged.
pub type ByteBuilder {
    u8[] data,
    i64 limit,
    pub i64 Length() { return DoLength(this); }
    // Copy of the bytes written so far.
    pub u8[] ToArray() { return DoToArray(this); }
    pub Result<unit, CodecError> Reserve(i64 count) { return DoReserve(this, count); }
    pub Result<unit, CodecError> Uint(i64 width, i64 value) { return DoUint(this, width, value); }
    pub Result<unit, CodecError> U8(i64 value) { return DoU8(this, value); }
    pub Result<unit, CodecError> U16(i64 value) { return DoU16(this, value); }
    pub Result<unit, CodecError> U24(i64 value) { return DoU24(this, value); }
    pub Result<unit, CodecError> U32(i64 value) { return DoU32(this, value); }
    pub Result<unit, CodecError> U48(i64 value) { return DoU48(this, value); }
    pub Result<unit, CodecError> U64(i64 value) { return DoU64(this, value); }
    // Appends a QUIC variable-length integer in its minimal encoding.
    pub Result<unit, CodecError> QuicVarint(i64 value) { return DoQuicVarint(this, value); }
    pub Result<unit, CodecError> BytesRange(u8[] source, i64 offset, i64 count) { return DoBytesRange(this, source, offset, count); }
    pub Result<unit, CodecError> Bytes(u8[] source) { return DoBytes(this, source); }
    // Overwrites `width` already-written bytes at `offset` (back-patching).
    pub Result<unit, CodecError> Patch(i64 offset, i64 width, i64 value) { return DoPatch(this, offset, width, value); }
    // Reserves a zeroed length prefix of `prefixBytes` (1..4) and returns its mark.
    pub Result<VecMark, CodecError> BeginVec(i64 prefixBytes) { return DoBeginVec(this, prefixBytes); }
    // Back-patches the prefix with the body length written since BeginVec.
    // InvalidLength when the body is outside min..max; Overflow when it does not
    // fit the prefix width. The prefix keeps its placeholder on failure.
    pub Result<unit, CodecError> EndVec(VecMark mark, i64 min, i64 max) { return DoEndVec(this, mark, min, max); }
    // Writes a complete vector in one call.
    pub Result<unit, CodecError> Vec(i64 prefixBytes, i64 min, i64 max, u8[] body) { return DoVec(this, prefixBytes, min, max, body); }
    // Appends a CRLF.
    pub Result<unit, CodecError> Crlf() { return DoCrlf(this); }
}

// Free-function bodies: methods may not call sibling methods in 0.5.2 (see COMPILER-GAPS.md).
i64 DoLength(ByteBuilder self) {
    return Slice.Len(self.data);
}

u8[] DoToArray(ByteBuilder self) {
    return Slice.SubSlice(self.data, 0_i64, Slice.Len(self.data));
}

Result<unit, CodecError> DoReserve(ByteBuilder self, i64 count) {
        if count < 0_i64 { return Result::Error(CodecError::InvalidValue()); }
        if self.limit >= 0_i64 && count > self.limit - Slice.Len(self.data) {
            return Result::Error(CodecError::LimitExceeded());
        }
        return Result::Ok(());
    }

Result<unit, CodecError> DoUint(ByteBuilder self, i64 width, i64 value) {
        if width < 1_i64 || width > 8_i64 { return Result::Error(CodecError::InvalidValue()); }
        Result<unit, CodecError> room = DoReserve(self, width);
        match room {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        Result<u8[], CodecError> encoded = Be.Encode(width, value);
        match encoded {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(bytes) => {
                mut i64 i = 0_i64;
                while i < width { Array.Append<u8>(self.data, bytes[i]); i = i + 1_i64; }
                return Result::Ok(());
            },
        };
    }

Result<unit, CodecError> DoU8(ByteBuilder self, i64 value) {
    return DoUint(self, 1_i64, value);
}

Result<unit, CodecError> DoU16(ByteBuilder self, i64 value) {
    return DoUint(self, 2_i64, value);
}

Result<unit, CodecError> DoU24(ByteBuilder self, i64 value) {
    return DoUint(self, 3_i64, value);
}

Result<unit, CodecError> DoU32(ByteBuilder self, i64 value) {
    return DoUint(self, 4_i64, value);
}

Result<unit, CodecError> DoU48(ByteBuilder self, i64 value) {
    return DoUint(self, 6_i64, value);
}

Result<unit, CodecError> DoU64(ByteBuilder self, i64 value) {
    return DoUint(self, 8_i64, value);
}

Result<unit, CodecError> DoQuicVarint(ByteBuilder self, i64 value) {
        Result<u8[], CodecError> encoded = Varint.Encode(value);
        match encoded {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(bytes) => { return DoBytes(self, bytes); },
        };
    }

Result<unit, CodecError> DoBytesRange(ByteBuilder self, u8[] source, i64 offset, i64 count) {
        if !Slice.IsValidRange(Slice.Len(source), offset, count) { return Result::Error(CodecError::InvalidValue()); }
        Result<unit, CodecError> room = DoReserve(self, count);
        match room {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        mut i64 i = 0_i64;
        while i < count { Array.Append<u8>(self.data, source[offset + i]); i = i + 1_i64; }
        return Result::Ok(());
    }

Result<unit, CodecError> DoBytes(ByteBuilder self, u8[] source) {
        return DoBytesRange(self, source, 0_i64, Slice.Len(source));
    }

Result<unit, CodecError> DoPatch(ByteBuilder self, i64 offset, i64 width, i64 value) {
        if !Slice.IsValidRange(Slice.Len(self.data), offset, width) { return Result::Error(CodecError::InvalidValue()); }
        return Be.WriteUint(self.data, offset, width, value);
    }

Result<VecMark, CodecError> DoBeginVec(ByteBuilder self, i64 prefixBytes) {
        if prefixBytes < 1_i64 || prefixBytes > 4_i64 { return Result::Error(CodecError::InvalidValue()); }
        i64 position = Slice.Len(self.data);
        Result<unit, CodecError> wrote = DoUint(self, prefixBytes, 0_i64);
        return match wrote {
            Result::Error(error) => Result::Error(error),
            Result::Ok(_) => Result::Ok(VecMark { position: position, prefixBytes: prefixBytes }),
        };
    }

Result<unit, CodecError> DoEndVec(ByteBuilder self, VecMark mark, i64 min, i64 max) {
        i64 bodyLength = Slice.Len(self.data) - mark.position - mark.prefixBytes;
        if bodyLength < min || bodyLength > max { return Result::Error(CodecError::InvalidLength()); }
        return DoPatch(self, mark.position, mark.prefixBytes, bodyLength);
    }

Result<unit, CodecError> DoVec(ByteBuilder self, i64 prefixBytes, i64 min, i64 max, u8[] body) {
        i64 length = Slice.Len(body);
        if length < min || length > max { return Result::Error(CodecError::InvalidLength()); }
        Result<unit, CodecError> room = DoReserve(self, prefixBytes + length);
        match room {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        Result<unit, CodecError> prefix = DoUint(self, prefixBytes, length);
        match prefix {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        return DoBytes(self, body);
    }

Result<unit, CodecError> DoCrlf(ByteBuilder self) {
        Result<unit, CodecError> room = DoReserve(self, 2_i64);
        match room {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(_) => {},
        };
        Array.Append<u8>(self.data, u8(13));
        Array.Append<u8>(self.data, u8(10));
        return Result::Ok(());
    }


/// An unbounded builder.
pub ByteBuilder New() { return ByteBuilder { data: Array.Empty<u8>(), limit: -1_i64 }; }

/// A builder that refuses to grow past `limit` bytes.
pub ByteBuilder WithLimit(i64 limit) { return ByteBuilder { data: Array.Empty<u8>(), limit: limit }; }
