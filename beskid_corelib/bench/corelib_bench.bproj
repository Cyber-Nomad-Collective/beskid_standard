corelib_bench {
  name = "corelib_bench"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" {
  source = "path"
  path = ".."
}

target "CryptoBench" {
  kind = Lib
  entry = "CryptoBench.bd"
}

target "CryptoProviderBench" {
  kind = Lib
  entry = "CryptoProviderBench.bd"
}

target "TlsBench" {
  kind = Lib
  entry = "TlsBench.bd"
}

target "TlsRecordBench" {
  kind = Lib
  entry = "TlsRecordBench.bd"
}

target "QuicBench" {
  kind = Lib
  entry = "QuicBench.bd"
}

target "Http2Bench" {
  kind = Lib
  entry = "Http2Bench.bd"
}
