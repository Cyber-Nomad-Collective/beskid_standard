/// Fiber join ABI status codes.
/// Carries its payload as variant arguments.
/// @tier(standard)
pub enum FiberJoinStatus {
    /// Child completed normally.
    Ok(i64 value),
    /// Child was cancelled.
    Cancelled(i64 reason, i64 cancelerId),
    /// Child terminated by panic.
    Panicked(i64 code, string message),
    /// Child exceeded stack growth policy.
    StackOverflow(i64 limitBytes, i64 requestedBytes),
    /// Join returned before child reached a terminal state.
    NotDone,
}

/// Constructs a FiberJoinStatus from an ABI discriminant code.
pub FiberJoinStatus FromCode(i64 code) {
    if code == 0 {
        return FiberJoinStatus::Ok(0);
    }
    if code == 1 {
        return FiberJoinStatus::Cancelled(0, 0);
    }
    if code == 2 {
        return FiberJoinStatus::Panicked(0, "");
    }
    if code == 3 {
        return FiberJoinStatus::StackOverflow(0, 0);
    }
    return FiberJoinStatus::NotDone;
}

/// Extracts the ABI discriminant (0-4) from a FiberJoinStatus.
pub i64 Discriminant(FiberJoinStatus status) {
    return match status {
        FiberJoinStatus::Ok(_) => 0,
        FiberJoinStatus::Cancelled(_, _) => 1,
        FiberJoinStatus::Panicked(_, _) => 2,
        FiberJoinStatus::StackOverflow(_, _) => 3,
        FiberJoinStatus::NotDone => 4,
    };
}
