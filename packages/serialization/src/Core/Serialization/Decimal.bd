use Core.Collections.Array;

use Core.Results;

use Core.Serialization.Errors;

use Core.Serialization.Numeric;

use Core.String;

/// Decimal formatting never converts an exact integer through float storage.
pub string Unsigned(u64 value)
{
    if (value == 0_u64)
    {
        return "0";
    }

    mut u8[] reversed = Array.Empty<u8>();
    mut u64 remaining = value;
    while (remaining != 0_u64)
    {
        Array.Append<u8>(reversed, 48_u8 + u8(remaining % 10_u64));
        remaining = remaining / 10_u64;
    }

    mut u8[] ordered = Array.Empty<u8>();
    mut i64 index = Array.Len<u8>(reversed);
    while (index > 0_i64)
    {
        index = index - 1_i64;
        Array.Append<u8>(ordered, reversed[index]);
    }
    return String.FromUtf8CodeUnits(ordered);
}

pub string Signed(i64 value)
{
    if (value >= 0_i64)
    {
        return Unsigned(u64(value));
    }

    u64 magnitude = u64(-(value + 1_i64)) + 1_u64;
    return "-" + Unsigned(magnitude);
}

pub Result<string, SerializationError> FormatUnsigned(u64 value, u8 width)
{
    string text = Unsigned(value);
    return match Numeric.ParseUnsigned(text, i64(width))
    {
        Result::Error(error) => Result::Error(error),

        Result::Ok(_) => Result::Ok(text),
    };
}

pub Result<string, SerializationError> FormatSigned(i64 value, u8 width)
{
    string text = Signed(value);
    return match Numeric.ParseSigned(text, i64(width))
    {
        Result::Error(error) => Result::Error(error),

        Result::Ok(_) => Result::Ok(text),
    };
}
