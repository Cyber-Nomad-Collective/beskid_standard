use Testing.Assert;
use Core.Bytes.Slice;
use Core.String;
use Crypto.Sha256;
use Crypto.Sha512;

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}
u8[] Hex(string text) {
    i64 n = String.Len(text) / 2_i64;
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = Nibble(String.ByteAt(text, 2_i64 * i)) * 16_u8 + Nibble(String.ByteAt(text, 2_i64 * i + 1_i64)); i = i + 1_i64; }
    return out;
}
bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }


test sha256_million_a {
    u8[] chunk = Slice.New(1000_i64);
    mut i64 i = 0_i64;
    while i < 1000_i64 { chunk[i] = 97_u8; i = i + 1_i64; }
    Sha256State s = Sha256.New();
    i = 0_i64;
    while i < 1000_i64 { Sha256.Update(s, chunk); i = i + 1_i64; }
    Assert.True(Same(Sha256.Finish(s), Hex("cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")), "million a");
}
test sha512_million_a {
    u8[] chunk = Slice.New(1000_i64);
    mut i64 i = 0_i64;
    while i < 1000_i64 { chunk[i] = 97_u8; i = i + 1_i64; }
    Sha512State s = Sha512.New512();
    i = 0_i64;
    while i < 1000_i64 { Sha512.Update(s, chunk); i = i + 1_i64; }
    Assert.True(Same(Sha512.Finish(s), Hex("e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")), "million a");
}
