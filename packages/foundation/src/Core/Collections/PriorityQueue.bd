/// Core.Collections.PriorityQueue — binary min-heap ordered by an `i64` priority.
/// @tier(supported)
/// The smallest priority is served first; equal priorities are served in insertion order.
/// `Push` and `Pop` are `O(log n)` and change the queue in place; `Peek` is `O(1)`. Use negated
/// priorities for max-first order.
use Core.Collections.Array;
use Core.Optional.Option;

[Isolated]
pub type PriorityQueue<T> {
    T[] items;
    i64[] priorities;
    i64[] sequence;
    i64 count;
    i64 nextSequence;

    /// Number of queued items.
    pub i64 Count() {
        return this.count;
    }

    /// Returns true when nothing is queued.
    pub bool IsEmpty() {
        return this.count == 0;
    }

    /// Returns the item with the smallest priority, or `None` when empty.
    pub Option<T> Peek() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<T>(this.items, 0));
    }

    /// Returns the smallest queued priority, or `None` when empty.
    pub Option<i64> PeekPriority() {
        if this.count == 0 {
            return Option::None;
        }
        return Option::Some(Array.Get<i64>(this.priorities, 0));
    }

    /// Queues `value` with `priority`.
    pub unit Push(mut this, T value, i64 priority) {
        Array.Append<T>(this.items, value);
        Array.Append<i64>(this.priorities, priority);
        Array.Append<i64>(this.sequence, this.nextSequence);
        mut i64 child = this.count;
        while child > 0 {
            i64 parent = (child - 1) / 2;
            if !Before(this.priorities, this.sequence, child, parent) {
                break;
            }
            Swap<T>(this.items, this.priorities, this.sequence, child, parent);
            child = parent;
        }
        this.count = this.count + 1;
        this.nextSequence = this.nextSequence + 1;
        return;
    }

    /// Removes and returns the item with the smallest priority, or `None` when empty.
    pub Option<T> Pop(mut this) {
        if this.count == 0 {
            return Option::None;
        }
        Option<T> top = Option::Some(Array.Get<T>(this.items, 0));
        i64 last = this.count - 1;
        Array.Set<T>(this.items, 0, Array.Get<T>(this.items, last));
        Array.Set<i64>(this.priorities, 0, Array.Get<i64>(this.priorities, last));
        Array.Set<i64>(this.sequence, 0, Array.Get<i64>(this.sequence, last));
        Array.RemoveLast<T>(this.items);
        Array.RemoveLast<i64>(this.priorities);
        Array.RemoveLast<i64>(this.sequence);
        this.count = last;
        mut i64 parent = 0;
        while true {
            i64 left = parent * 2 + 1;
            i64 right = left + 1;
            mut i64 smallest = parent;
            if left < last && Before(this.priorities, this.sequence, left, smallest) {
                smallest = left;
            }
            if right < last && Before(this.priorities, this.sequence, right, smallest) {
                smallest = right;
            }
            if smallest == parent {
                break;
            }
            Swap<T>(this.items, this.priorities, this.sequence, parent, smallest);
            parent = smallest;
        }
        return top;
    }
}

/// Creates an empty queue.
pub PriorityQueue<T> New<T>() {
    return PriorityQueue<T> {
        items: Array.Empty<T>(),
        priorities: Array.Empty<i64>(),
        sequence: Array.Empty<i64>(),
        count: 0,
        nextSequence: 0,
    };
}

/// Swaps the heap entries at `a` and `b` in all three parallel arrays.
unit Swap<T>(T[] items, i64[] priorities, i64[] sequence, i64 a, i64 b) {
    mut T[] held = Array.Empty<T>();
    Array.Append<T>(held, Array.Get<T>(items, a));
    Array.Set<T>(items, a, Array.Get<T>(items, b));
    Array.Set<T>(items, b, Array.Get<T>(held, 0));
    i64 priority = Array.Get<i64>(priorities, a);
    Array.Set<i64>(priorities, a, Array.Get<i64>(priorities, b));
    Array.Set<i64>(priorities, b, priority);
    i64 order = Array.Get<i64>(sequence, a);
    Array.Set<i64>(sequence, a, Array.Get<i64>(sequence, b));
    Array.Set<i64>(sequence, b, order);
    return;
}

/// Heap order: lower priority first, then earlier insertion.
bool Before(i64[] priorities, i64[] sequence, i64 a, i64 b) {
    i64 pa = Array.Get<i64>(priorities, a);
    i64 pb = Array.Get<i64>(priorities, b);
    if pa != pb {
        return pa < pb;
    }
    return Array.Get<i64>(sequence, a) < Array.Get<i64>(sequence, b);
}
