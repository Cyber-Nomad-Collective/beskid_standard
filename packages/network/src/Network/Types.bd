use Core.Results;
use Network.Errors;

/// Internet address families; these variants are independent of platform constants.
pub enum AddressFamily { V4(), V6(), }

/// IPv6 uses four network-order 32-bit words. IPv4 uses four octets.
pub enum IpAddress {
    V4(u8 a, u8 b, u8 c, u8 d),
    V6(u32 a, u32 b, u32 c, u32 d),
}

/// A port is always in 0..65535, including when constructed from its two octets.
/// Beskid has no u16 primitive; this value does not widen the portable port range.
pub type Port {
    u8 high,
    u8 low,
    pub i64 Value() { return i64(high) * 256_i64 + i64(low); }
}

pub Port PortBytes(u8 high, u8 low) { return Port { high: high, low: low }; }

pub Result<Port, NetworkError> PortNumber(i64 value) {
    if value < 0_i64 || value > 65535_i64 { return Result::Error(NetworkError::InvalidAddress); }
    return Result::Ok(PortBytes(u8(value >> 8_i64), u8(value & 255_i64)));
}

/// Port zero requests an OS-selected port only when binding.
pub type SocketAddress {
    pub IpAddress address,
    pub Port port,
}

/// Portable TCP policy. No native option numbers or readiness flags are accepted.
pub type SocketOptions {
    pub bool noDelay,
    pub bool keepAlive,
}

pub SocketOptions DefaultSocketOptions() {
    return SocketOptions { noDelay: false, keepAlive: false };
}

/// One received datagram; payload is an owned copy, including an empty datagram.
pub type Datagram {
    pub u8[] payload,
    pub SocketAddress source,
    pub bool truncated,
}
