corelib_http2 {
  name = "corelib_http2"
  version = "0.1.0"
  root = "src"
  readme = "README.md"
}

dependency "corelib_foundation" { source = path path = "../foundation" }
dependency "corelib_network" { source = path path = "../network" }
dependency "corelib_http" { source = path path = "../http" }
dependency "corelib_codec" { source = path path = "../codec" }
target "Http2Lib" { kind = Lib }
