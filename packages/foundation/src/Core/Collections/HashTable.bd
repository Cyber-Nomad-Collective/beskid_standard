/// Core.Collections.HashTable — open-addressing hash table with caller-supplied hashes.
/// @tier(supported)
/// The table stores entries densely (keys, values, and cached hashes in parallel arrays) and keeps
/// a power-of-two slot index probed linearly. Callers pass each key's 64-bit hash, so any key type
/// whose `==` is value equality (primitives, strings) works; composite keys can be hashed with
/// `Hash.Combine`. `StringMap` and `I64Map` wrap this table with built-in hashes.
///
/// Iteration order is insertion order until the first removal; removal moves the last entry into
/// the removed position. Tables are linear values: operations return the updated table.
use Core.Collections.Array;
use Core.Optional.Option;

/// Empty slot marker.
i64 EmptySlot() {
    return -1;
}

/// Deleted slot marker; probing continues past it.
i64 DeletedSlot() {
    return -2;
}

pub type HashTable<K, V> {
    K[] keys,
    V[] values,
    i64[] hashes,
    i64[] slots,
    i64 count,
    i64 deleted,

    /// Number of entries.
    pub i64 Count() {
        return this.count;
    }

    /// Returns true when the table has no entries.
    pub bool IsEmpty() {
        return this.count == 0;
    }
}

i64[] EmptySlots(i64 capacity) {
    mut i64[] slots = Array.Empty<i64>();
    mut i64 i = 0;
    while i < capacity {
        slots = Array.Append<i64>(slots, EmptySlot());
        i = i + 1;
    }
    return slots;
}

/// Creates an empty table with room for a few entries before growing.
pub HashTable<K, V> New<K, V>() {
    return HashTable<K, V> {
        keys: Array.Empty<K>(),
        values: Array.Empty<V>(),
        hashes: Array.Empty<i64>(),
        slots: EmptySlots(8),
        count: 0,
        deleted: 0,
    };
}

/// Returns the slot position holding `key`, or `-1` when absent.
i64 FindSlot<K, V>(HashTable<K, V> table, K key, i64 hash) {
    i64 capacity = Array.Len<i64>(table.slots);
    i64 mask = capacity - 1;
    mut i64 position = hash & mask;
    mut i64 probes = 0;
    while probes < capacity {
        i64 entry = Array.Get<i64>(table.slots, position);
        if entry == EmptySlot() {
            return -1;
        }
        if entry >= 0 && Array.Get<i64>(table.hashes, entry) == hash && Array.Get<K>(table.keys, entry) == key {
            return position;
        }
        position = (position + 1) & mask;
        probes = probes + 1;
    }
    return -1;
}

/// Returns the first empty or deleted slot on `hash`'s probe path.
i64 FreeSlot(i64[] slots, i64 hash) {
    i64 capacity = Array.Len<i64>(slots);
    i64 mask = capacity - 1;
    mut i64 position = hash & mask;
    while Array.Get<i64>(slots, position) >= 0 {
        position = (position + 1) & mask;
    }
    return position;
}

/// Rebuilds the slot index at `capacity` (a power of two larger than the entry count).
HashTable<K, V> Reindex<K, V>(HashTable<K, V> table, i64 capacity) {
    mut i64[] slots = EmptySlots(capacity);
    mut i64 entry = 0;
    while entry < table.count {
        i64 position = FreeSlot(slots, Array.Get<i64>(table.hashes, entry));
        slots = Array.Set<i64>(slots, position, entry);
        entry = entry + 1;
    }
    return HashTable<K, V> {
        keys: table.keys,
        values: table.values,
        hashes: table.hashes,
        slots: slots,
        count: table.count,
        deleted: 0,
    };
}

/// Returns true when `key` (with hash `hash`) is present.
pub bool Contains<K, V>(HashTable<K, V> table, K key, i64 hash) {
    return FindSlot<K, V>(table, key, hash) >= 0;
}

/// Returns the value for `key`, or `None` when absent.
pub Option<V> Get<K, V>(HashTable<K, V> table, K key, i64 hash) {
    i64 position = FindSlot<K, V>(table, key, hash);
    if position < 0 {
        return Option::None;
    }
    return Option::Some(Array.Get<V>(table.values, Array.Get<i64>(table.slots, position)));
}

/// Returns the value for `key`, or `fallback` when absent.
pub V GetOr<K, V>(HashTable<K, V> table, K key, i64 hash, V fallback) {
    i64 position = FindSlot<K, V>(table, key, hash);
    if position < 0 {
        return fallback;
    }
    return Array.Get<V>(table.values, Array.Get<i64>(table.slots, position));
}

/// Inserts or replaces the value for `key`.
pub HashTable<K, V> Insert<K, V>(HashTable<K, V> table, K key, i64 hash, V value) {
    i64 found = FindSlot<K, V>(table, key, hash);
    if found >= 0 {
        i64 entry = Array.Get<i64>(table.slots, found);
        mut V[] values = table.values;
        values = Array.Set<V>(values, entry, value);
        return HashTable<K, V> {
            keys: table.keys,
            values: values,
            hashes: table.hashes,
            slots: table.slots,
            count: table.count,
            deleted: table.deleted,
        };
    }
    mut HashTable<K, V> current = table;
    i64 capacity = Array.Len<i64>(table.slots);
    // Keep live plus deleted slots at or below a 3/4 load factor.
    if (table.count + table.deleted + 1) * 4 > capacity * 3 {
        mut i64 nextCapacity = capacity;
        if (table.count + 1) * 2 > capacity {
            nextCapacity = capacity * 2;
        }
        current = Reindex<K, V>(table, nextCapacity);
    }
    i64 position = FreeSlot(current.slots, hash);
    mut i64 deleted = current.deleted;
    if Array.Get<i64>(current.slots, position) == DeletedSlot() {
        deleted = deleted - 1;
    }
    mut K[] keys = current.keys;
    mut V[] values = current.values;
    mut i64[] hashes = current.hashes;
    mut i64[] slots = current.slots;
    keys = Array.Append<K>(keys, key);
    values = Array.Append<V>(values, value);
    hashes = Array.Append<i64>(hashes, hash);
    slots = Array.Set<i64>(slots, position, current.count);
    return HashTable<K, V> {
        keys: keys,
        values: values,
        hashes: hashes,
        slots: slots,
        count: current.count + 1,
        deleted: deleted,
    };
}

/// Removes `key` when present; returns the table unchanged otherwise.
pub HashTable<K, V> Remove<K, V>(HashTable<K, V> table, K key, i64 hash) {
    i64 position = FindSlot<K, V>(table, key, hash);
    if position < 0 {
        return table;
    }
    i64 entry = Array.Get<i64>(table.slots, position);
    i64 last = table.count - 1;
    mut i64[] slots = table.slots;
    slots = Array.Set<i64>(slots, position, DeletedSlot());
    mut K[] keys = table.keys;
    mut V[] values = table.values;
    mut i64[] hashes = table.hashes;
    if entry != last {
        // Move the last entry into the hole and repoint its slot.
        i64 lastHash = Array.Get<i64>(hashes, last);
        i64 mask = Array.Len<i64>(slots) - 1;
        mut i64 probe = lastHash & mask;
        while Array.Get<i64>(slots, probe) != last {
            probe = (probe + 1) & mask;
        }
        slots = Array.Set<i64>(slots, probe, entry);
        keys = Array.Set<K>(keys, entry, Array.Get<K>(keys, last));
        values = Array.Set<V>(values, entry, Array.Get<V>(values, last));
        hashes = Array.Set<i64>(hashes, entry, lastHash);
    }
    keys = Array.RemoveLast<K>(keys);
    values = Array.RemoveLast<V>(values);
    hashes = Array.RemoveLast<i64>(hashes);
    return HashTable<K, V> {
        keys: keys,
        values: values,
        hashes: hashes,
        slots: slots,
        count: last,
        deleted: table.deleted + 1,
    };
}

/// Number of entries in `table`.
pub i64 Size<K, V>(HashTable<K, V> table) {
    return table.count;
}

/// Copies the keys in iteration order.
pub K[] Keys<K, V>(HashTable<K, V> table) {
    mut K[] result = Array.Empty<K>();
    mut i64 i = 0;
    while i < table.count {
        result = Array.Append<K>(result, Array.Get<K>(table.keys, i));
        i = i + 1;
    }
    return result;
}

/// Copies the values in the same order as `Keys`.
pub V[] Values<K, V>(HashTable<K, V> table) {
    mut V[] result = Array.Empty<V>();
    mut i64 i = 0;
    while i < table.count {
        result = Array.Append<V>(result, Array.Get<V>(table.values, i));
        i = i + 1;
    }
    return result;
}
