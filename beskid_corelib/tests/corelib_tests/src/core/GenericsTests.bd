//! `CoreGenericsTests`: generic functions and generic types (beskid-lings milestone 3). Each test
//! pins one 0.6.6 defect: `T` inferred from an array literal of bare integers, equality on the
//! loop variable of a generic `for`, and a user `Stack.Push` next to Corelib's.

use Testing.Assert;
use Core.Collections.Stack;

i64 CountEqual<T>(T[] values, T target)
{
    mut i64 count = 0;
    for value in values
    {
        if value == target
        {
            count = count + 1;
        }
    }
    return count;
}

T FirstOr<T>(T[] values, T fallback)
{
    for value in values
    {
        return value;
    }
    return fallback;
}

mod Lesson
{
    pub type Stack<T>
    {
        T last;
        i64 count;

        pub unit Push(mut this, T value)
        {
            this.last = value;
            this.count = this.count + 1;
        }

        pub i64 Count()
        {
            return this.count;
        }
    }

    pub i64 PushTwice()
    {
        mut Stack<i64> stack = Stack<i64> { last: 0, count: 0 };
        stack.Push(1);
        stack.Push(2);
        return stack.Count();
    }
}

test generic_call_infers_t_from_an_array_literal_of_bare_integers
{
    Assert.Equal(FirstOr([7, 8], 0), 7, "T is i32 from the bare integers");
    Assert.Equal(FirstOr<i32>([7, 8], 0), 7, "explicit T agrees with the inferred one");
    Assert.Equal(FirstOr([9, 8], 5_i64), 9_i64, "a later exact argument selects T");
}

test generic_for_variable_compares_strings_by_content
{
    Assert.Equal(CountEqual<string>(["a", "b", "a"], "a"), 2, "two equal strings");
    Assert.Equal(CountEqual(["x", "y"], "z"), 0, "no equal string");
    Assert.Equal(CountEqual<i64>([3, 4, 3], 3), 2, "integers still compare by value");
}

test user_stack_push_does_not_collide_with_corelib_stack
{
    Assert.Equal(Lesson.PushTwice(), 2, "the user Stack.Push runs");
    Assert.Equal(Stack.New<i64>().Push(5).Count(), 1, "Corelib Stack.Push still resolves");
}
