//! `GlueWireTests`: the Glue wire format. `BinaryCodec` encodes `DataValue` with exact widths and
//! IEEE bits; `Envelope` frames requests, cancels and shutdowns at fixed offsets.

use Core.Glue.Envelope;
use Core.Glue.BinaryCodec;
use Core.Serialization.DataValue;
use Core.Collections.Array;
use Core.Results;
use Testing.Assert;

u8[] ControlZeroBinding()
{
    mut u8[] bytes = Array.Empty<u8>();
    mut i64 index = 0_i64;
    while (index < 32_i64)
    {
        Array.Append(bytes, 0_u8);
        index = index + 1_i64;
    }
    return bytes;
}

mod WireTests
{
    test SignedValueUsesSharedExactWidthAndTwosComplement
    {
        match (BinaryCodec.Encode(DataValue::Signed(-128_i64, 8_u8)))
        {
            Result::Error(_) => Assert.Fail("signed minimum encodes"),
            Result::Ok(bytes) => {
                Assert.Equal(Array.Len<u8>(bytes), 10_i64, "tag plus width plus exact 64-bit payload");
                Assert.Equal(bytes[0], 2_u8, "shared signed tag");
                Assert.Equal(bytes[1], 8_u8, "declared signed width");
                Assert.Equal(bytes[2], 128_u8, "little-endian low byte");
                mut i64 i = 3_i64;
                while (i < 10_i64)
                {
                    Assert.Equal(bytes[i], 255_u8, "sign extension preserved");
                    i = i + 1_i64;
                }
                match (BinaryCodec.Decode(bytes))
                {
                    Result::Error(_) => Assert.Fail("encoded signed value decodes"),
                    Result::Ok(value) => match (value)
                    {
                        DataValue::Signed(number, width) => {
                            Assert.Equal(number, -128_i64, "exact negative value");
                            Assert.Equal(width, 8_u8, "exact width");
                        },
                        _ => Assert.Fail("signed logical tag retained"),
                    },
                };
            },
        };
    }

    test CodecRejectsOutOfRangeValuesBeforeOutput
    {
        match (BinaryCodec.Encode(DataValue::Signed(128_i64, 8_u8)))
        {
            Result::Ok(_) => Assert.Fail("out of range signed value must reject"),
            Result::Error(_) => { },
        };
        match (BinaryCodec.Encode(DataValue::Unsigned(256_u64, 8_u8)))
        {
            Result::Ok(_) => Assert.Fail("out of range unsigned value must reject"),
            Result::Error(_) => { },
        };
    }

    test FloatNegativeZeroPreservesExactIeeeBits
    {
        match (BinaryCodec.Encode(DataValue::Float(9223372036854775808_u64, 64_u8)))
        {
            Result::Error(_) => Assert.Fail("negative zero encodes"),
            Result::Ok(bytes) => {
                Assert.Equal(bytes[0], 4_u8, "shared float tag");
                Assert.Equal(bytes[1], 64_u8, "float width retained");
                Assert.Equal(bytes[9], 128_u8, "sign bit retained");
                match (BinaryCodec.Decode(bytes))
                {
                    Result::Error(_) => Assert.Fail("negative zero decodes"),
                    Result::Ok(value) => match (value)
                    {
                        DataValue::Float(bits, width) => {
                            Assert.Equal(bits, 9223372036854775808_u64, "exact IEEE bits");
                            Assert.Equal(width, 64_u8, "exact float width");
                        },
                        _ => Assert.Fail("float logical tag retained"),
                    },
                };
            },
        };
    }

    test ShutdownHasEmptyPayloadAndExactCanonicalWireOffsets
    {
        Envelope shutdown = Envelope
        {
            kind: 5_u8,
            generation: 9_u64,
            request: 0_u64,
            library: "manual",
            binding: ControlZeroBinding(),
            shapes: Array.Empty<u8>(),
            payload: Array.Empty<u8>(),
        };
        match (Envelope.Encode(shutdown))
        {
            Result::Error(_) => Assert.Fail("canonical empty control must encode"),
            Result::Ok(frame) => {
                Assert.Equal(Array.Len(frame), 74_i64, "prefix plus fixed body and library bytes");
                Assert.Equal(frame[0], 70_u8, "exact little-endian body length");
                Assert.Equal(frame[4], 1_u8, "protocol version one");
                Assert.Equal(frame[6], 5_u8, "shutdown kind");
                Assert.Equal(frame[8], 9_u8, "issued generation");
                Assert.Equal(frame[16], 0_u8, "control request zero");
                Assert.Equal(frame[70], 0_u8, "payload length zero");
                match (Envelope.Decode(frame))
                {
                    Result::Error(_) => Assert.Fail("canonical control must decode"),
                    Result::Ok(value) => Assert.Equal(Array.Len(value.payload), 0_i64, "empty payload retained"),
                };
            },
        };
    }

    test CancelAndShutdownRejectBinaryUnitAsControlPayload
    {
        u8[] unitBytes = match (BinaryCodec.Encode(DataValue::Unit))
        {
            Result::Ok(bytes) => bytes,
            Result::Error(_) => {
                Assert.Fail("ordinary unit encoding exists");
                return;
            },
        };
        Assert.Equal(Array.Len(unitBytes), 1_i64, "unit is a value tag, not empty control");
        u8[] binding = ControlZeroBinding();
        binding[0] = 1_u8;
        Envelope cancel = Envelope
        {
            kind: 4_u8,
            generation: 9_u64,
            request: 1_u64,
            library: "manual",
            binding: binding,
            shapes: Array.Empty<u8>(),
            payload: unitBytes,
        };
        match (Envelope.Encode(cancel))
        {
            Result::Ok(_) => Assert.Fail("unit cancel payload must reject"),
            Result::Error(_) => { },
        };
        cancel.payload = Array.Empty<u8>();
        match (Envelope.Encode(cancel))
        {
            Result::Error(_) => Assert.Fail("empty cancel payload must encode"),
            Result::Ok(bytes) => {
                Assert.Equal(bytes[6], 4_u8, "cancel kind");
                Assert.Equal(bytes[16], 1_u8, "original request retained");
                Assert.Equal(bytes[34], 1_u8, "original binding retained");
                Assert.Equal(bytes[70], 0_u8, "cancel payload length zero");
            },
        };
        Envelope shutdown = Envelope
        {
            kind: 5_u8,
            generation: 9_u64,
            request: 0_u64,
            library: "manual",
            binding: ControlZeroBinding(),
            shapes: Array.Empty<u8>(),
            payload: unitBytes,
        };
        match (Envelope.Encode(shutdown))
        {
            Result::Ok(_) => Assert.Fail("unit shutdown payload must reject"),
            Result::Error(_) => { },
        };
    }
}
