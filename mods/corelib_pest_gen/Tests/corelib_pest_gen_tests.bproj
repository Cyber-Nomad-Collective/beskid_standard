corelib_pest_gen_tests {
  name = "corelib_pest_gen_tests"
  version = "0.0.1-dev"
  root = "."
}

dependency "corelib" {
  source = path
  path = "../../../beskid_corelib"
}

dependency "corelib_foundation" {
  source = path
  path = "../../../packages/foundation"
}

dependency "corelib_compiler_sdk" {
  source = path
  path = "../../../packages/compiler-sdk"
}

dependency "corelib_pest_gen" {
  source = path
  path = ".."
}

target "PestGenGenerationTests" {
  kind = Test
  entry = "GenerationTests.bd"
}
