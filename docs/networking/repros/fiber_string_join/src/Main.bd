// GAP: Fiber<string>.Join has no lowering rule (CallExpression at __fiber_join_value<T>).
use Concurrency.Fiber;
use Core.Results;
use Testing.Assert;

string Name() { return "beskid"; }

test fiber_string_join {
    Fiber<string> f = spawn (() => Name());
    Assert.Equal<string>(match f.Join() { Result::Ok(v) => v, Result::Error(_) => "err", }, "beskid", "string join");
}
