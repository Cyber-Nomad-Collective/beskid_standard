// CHECKED IN: hand-maintained Mod SDK emit helpers (syntax node primitives).
use Beskid.Syntax.Nodes.Identifier;
use Beskid.Syntax.Nodes.NodeSpan;
use Beskid.Syntax.Nodes.SpannedAttributeList;
use Beskid.Syntax.Nodes.SpannedIdentifier;
use Beskid.Syntax.Nodes.SpannedVisibility;
use Beskid.Syntax.Nodes.Visibility;

/// Build an identifier retaining caller-supplied source metadata.
pub SpannedIdentifier PubIdentifier(string name, NodeSpan span, u32 id) {
    return SpannedIdentifier { node: Identifier { name: name }, span: span, id: id };
}

/// Build a public visibility token retaining caller-supplied source metadata.
pub SpannedVisibility PubVisibility(NodeSpan span, u32 id) {
    return SpannedVisibility { node: Visibility::Public, span: span, id: id };
}

/// Empty typed attribute list for synthesized nodes.
pub SpannedAttributeList EmptyAttributes() {
    return SpannedAttributeList { items: [] };
}
