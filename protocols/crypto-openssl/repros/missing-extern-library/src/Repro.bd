/// Compiler gap NATIVE1 (protocols/COMPILER-GAPS.md, NATIVE1): an `[Extern]` symbol from a library
/// that the host does not have makes the whole program fail to load, although the call is
/// behind a branch that never runs. Expected: the test passes (the branch is not taken), or a
/// typed "library unavailable" result. Observed (0.5.3 JIT): `extern resolve: dlopen(...)`.
use Testing.Assert;

[Extern(Abi:"C", Library:"libbeskid-not-installed.so.1")]
contract Missing {
    i64 beskid_missing_symbol(i64 value);
}

i64 MaybeCall(bool enabled) {
    if enabled { return Missing.beskid_missing_symbol(1_i64); }
    return 0_i64;
}

test optional_native_library {
    Assert.Equal<i64>(MaybeCall(false), 0_i64, "the extern call never runs");
}
