use Concurrency.Fiber;
use Core.Time;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Connect;
use Connect.Policy;
use Testing.Assert;
use TestSupport;

ConnectPolicy Fast()
{
    return Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(5000_i64));
}

Result<unit, NetworkError> AddressesV4Result()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    SocketAddress[] candidates = List1(address);
    match (Connect.ConnectAddresses(candidates, Fast()))
    {
        Result::Ok(stream) => {
            Assert.Equal<i64>(PeerPort(stream), address.port.Value(), "winner is the listener");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("loopback IPv4 connect succeeds"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit AddressesV4()
{
    match (AddressesV4Result())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("IPv4 scenario has no NetworkError"),
    };
}

test ConnectAddressesIpv4Loopback
{
    Fiber<unit> scenario = spawn AddressesV4();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "IPv4 scenario joins");
}

bool HasOptions(TcpStream stream, bool noDelay, bool keepAlive)
{
    return match (stream.SocketOptions())
    {
        Result::Ok(options) => options.noDelay == noDelay && options.keepAlive == keepAlive,
        Result::Error(_) => false,
    };
}

Result<unit, NetworkError> SocketOptionsResult()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    SocketOptions both = SocketOptions
    {
        noDelay: true,
        keepAlive: true,
    };
    ConnectPolicy policy = Policy.WithSocketOptions(Fast(), both);
    match (Connect.ConnectAddresses(List1(address), policy))
    {
        Result::Ok(stream) => {
            Assert.True(HasOptions(stream, true, true), "the winning stream has the policy's socket options");
            stream.SetSocketOptions(Network.Types.DefaultSocketOptions())?;
            Assert.True(HasOptions(stream, false, false), "SetSocketOptions clears both options");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("loopback IPv4 connect with socket options succeeds"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit SocketOptionsScenario()
{
    match (SocketOptionsResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("socket options scenario has no NetworkError"),
    };
}

test ConnectAppliesThePolicySocketOptionsToTheWinningStream
{
    Fiber<unit> scenario = spawn SocketOptionsScenario();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "socket options scenario joins");
}

Result<unit, NetworkError> HostLiteralResult()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    match (Connect.ConnectHost("127.0.0.1", address.port, Fast()))
    {
        Result::Ok(stream) => {
            Assert.Equal<i64>(PeerPort(stream), address.port.Value(), "literal host reaches the listener");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("ConnectHost with an IPv4 literal succeeds"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit HostLiteral()
{
    match (HostLiteralResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("literal scenario has no NetworkError"),
    };
}

test ConnectHostIpv4LiteralResolvesBothFamilies
{
    Fiber<unit> scenario = spawn HostLiteral();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "literal scenario joins");
}

// localhost answers ::1 and 127.0.0.1; only IPv4 listens, so the IPv6 attempt is
// refused and the IPv4 attempt starts at once. The attempt delay is longer than the
// 5 s timeout, so a connection shows that the IPv4 attempt did not wait for it.
Result<unit, NetworkError> LocalhostFallbackResult()
{
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    ConnectPolicy slow = Policy.WithAttemptDelay(Fast(), Time.FromMilliseconds(60000_i64));
    match (Connect.ConnectHost("localhost", address.port, slow))
    {
        Result::Ok(stream) => {
            Assert.False(PeerIsV6(stream), "IPv4 listener wins");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("localhost connect falls back to IPv4"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit LocalhostFallback()
{
    match (LocalhostFallbackResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("localhost scenario has no NetworkError"),
    };
}

test ConnectHostLocalhostFallsBackToIpv4
{
    Fiber<unit> scenario = spawn LocalhostFallback();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "localhost scenario joins");
}

// The tests that need IPv6 loopback carry the tag `ipv6` and fail when ::1 cannot be bound, so a
// host without IPv6 excludes them explicitly (`--exclude-tag ipv6`) instead of passing silently.
Result<unit, NetworkError> DualStackResult(AddressFamily preferred, bool expectV6)
{
    Result<TcpListener, NetworkError> bound6 = TcpListener.Bind(Loopback6(0_i64), 8_i64);
    if (!(match (bound6)
    {
        Result::Ok(_) => true,
        Result::Error(_) => false,
    }))
    {
        Assert.Fail("IPv6 loopback is unavailable on this host: exclude these tests with --exclude-tag ipv6");
        return Result::Ok(());
    }
    TcpListener listener6 = bound6?;
    TcpListener listener4 = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress address6 = listener6.LocalAddress()?;
    SocketAddress address4 = listener4.LocalAddress()?;
    ConnectPolicy policy = Policy.WithPreferredFamily(Fast(), preferred);
    match (Connect.ConnectAddresses(List2(address4, address6), policy))
    {
        Result::Ok(stream) => {
            Assert.Equal<bool>(PeerIsV6(stream), expectV6, "preferred family wins when both answer");
            if (expectV6)
            {
                Exchange(listener6, stream)?;
            }
            else
            {
                Exchange(listener4, stream)?;
            }
        },
        Result::Error(_) => Assert.Fail("dual-stack loopback connect succeeds"),
    };
    listener6.Close()?;
    listener4.Close()?;
    return Result::Ok(());
}

unit DualStack(AddressFamily preferred, bool expectV6)
{
    match (DualStackResult(preferred, expectV6))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("dual-stack scenario has no NetworkError"),
    };
}

test ConnectAddressesDualStackPrefersIpv6
{
    meta
    {
        tags = "ipv6";
    }

    Fiber<unit> scenario = spawn (() => DualStack(AddressFamily::V6, true));
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "IPv6-preferred scenario joins");
}

test ConnectAddressesDualStackPrefersIpv4ByPolicy
{
    meta
    {
        tags = "ipv6";
    }

    Fiber<unit> scenario = spawn (() => DualStack(AddressFamily::V4, false));
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "IPv4-preferred scenario joins");
}

Result<unit, NetworkError> Ipv6OnlyResult()
{
    Result<TcpListener, NetworkError> bound6 = TcpListener.Bind(Loopback6(0_i64), 8_i64);
    if (!(match (bound6)
    {
        Result::Ok(_) => true,
        Result::Error(_) => false,
    }))
    {
        Assert.Fail("IPv6 loopback is unavailable on this host: exclude these tests with --exclude-tag ipv6");
        return Result::Ok(());
    }
    TcpListener listener6 = bound6?;
    SocketAddress address6 = listener6.LocalAddress()?;
    match (Connect.ConnectHost("::1", address6.port, Fast()))
    {
        Result::Ok(stream) => {
            Assert.True(PeerIsV6(stream), "IPv6 literal reaches ::1");
            Exchange(listener6, stream)?;
        },
        Result::Error(_) => Assert.Fail("ConnectHost with an IPv6 literal succeeds"),
    };
    listener6.Close()?;
    return Result::Ok(());
}

unit Ipv6Only()
{
    match (Ipv6OnlyResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("IPv6 literal scenario has no NetworkError"),
    };
}

test ConnectHostIpv6Literal
{
    meta
    {
        tags = "ipv6";
    }

    Fiber<unit> scenario = spawn Ipv6Only();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "IPv6 literal scenario joins");
}
