use Core.Bytes.Slice;
use Core.Results;
use Codec.Errors;

// Bounded CRLF line scanning over a byte window [start, stop).

/// Locates the first line terminator in the window. Returns the index of the CR of
/// the first CRLF, or -1 when the window holds no complete line yet. A line longer
/// than `maxLength` content bytes is LimitExceeded (also detected before the
/// terminator arrives); a bare LF or a CR not followed by LF is InvalidLine.
pub Result<i64, CodecError> FindLineEnd(u8[] buf, i64 start, i64 stop, i64 maxLength) {
    if maxLength < 0_i64 || !Slice.IsValidRange(Slice.Len(buf), start, stop - start) {
        return Result::Error(CodecError::InvalidValue());
    }
    mut i64 i = start;
    while i < stop {
        u8 b = buf[i];
        if b == u8(10) { return Result::Error(CodecError::InvalidLine()); }
        if b == u8(13) {
            if i + 1_i64 >= stop {
                if i - start > maxLength { return Result::Error(CodecError::LimitExceeded()); }
                return Result::Ok(-1_i64);
            }
            if buf[i + 1_i64] != u8(10) { return Result::Error(CodecError::InvalidLine()); }
            if i - start > maxLength { return Result::Error(CodecError::LimitExceeded()); }
            return Result::Ok(i);
        }
        if i - start >= maxLength {
            return Result::Error(CodecError::LimitExceeded());
        }
        i = i + 1_i64;
    }
    return Result::Ok(-1_i64);
}
