crypto_openssl_tests {
  name = "crypto_openssl_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_crypto" { source = path path = "../../crypto" }
dependency "corelib_crypto_openssl" { source = path path = ".." }
target "ProviderTests" { kind = Lib entry = "ProviderTests.bd" }
target "NativeBench" { kind = Lib entry = "NativeBenchTests.bd" }
