/// Native acceleration for checked Codec.Mem ranges.
[Extern(Abi: "C", Library: "libc.so.6")]
contract MemLibc
{
    i64 memmove(i64 destination, i64 source, i64 count);
    i64 memset(i64 pointer, i32 value, i64 count);
}

pub unit Move(u8[] destination, i64 destinationOffset, u8[] source, i64 sourceOffset, i64 count)
{
    clif {
        %db = payload %0
        %dp = iadd %db, %1
        %sb = payload %2
        %sp = iadd %sb, %3
        %r = call @memmove(%dp, %sp, %4) -> i64
    };
    return;
}

pub unit Zero(u8[] buffer, i64 offset, i64 count)
{
    clif {
        %b = payload %0
        %p = iadd %b, %1
        %z = iconst.i32 0
        %r = call @memset(%p, %z, %2) -> i64
    };
    return;
}
