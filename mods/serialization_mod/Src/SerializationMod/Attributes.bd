use Beskid.Compiler.Collect;
use Beskid.Syntax.Nodes;
use Core.Collections.Array;
use SerializationMod.Syntax;

/// The Mod owns the declaration; the host supplies attribute activation scope.
pub AttributeDeclarationSet Declarations() {
    NodeSpan origin = NodeSpan { start: 0_u64, end: 0_u64, lineStart: 0_u64, columnStart: 0_u64, lineEnd: 0_u64, columnEnd: 0_u64 };
    Syntax.Builder builder = Syntax.Create(origin);
    mut SpannedAttributeTarget[] targets = [];
    string[] names = ["type", "enum"];
    mut i64 index = 0_i64;
    while (index < 2_i64) {
        targets = Array.Append<SpannedAttributeTarget>(targets, Syntax.AttributeTargetValue(builder, names[index]));
        index = index + 1_i64;
    }
    SpannedType textType = Syntax.Primitive(builder, PrimitiveType::String);
    SpannedType boolType = Syntax.Primitive(builder, PrimitiveType::Bool);
    SpannedType widthType = Syntax.Primitive(builder, PrimitiveType::U8);
    SpannedExpression no = Syntax.LiteralValue(builder, Literal::Bool(false));
    SpannedAttributeParameter[] serialize = [Syntax.AttributeParameterValue(builder, "Version", textType, Syntax.Text(builder, "1"))];
    SpannedAttributeParameter[] field = [
        Syntax.AttributeParameterValue(builder, "Name", textType, Syntax.Text(builder, "")),
        Syntax.AttributeParameterValue(builder, "SkipSerialize", boolType, no),
        Syntax.AttributeParameterValue(builder, "SkipDeserialize", boolType, no),
        Syntax.AttributeParameterValue(builder, "Default", textType, Syntax.Text(builder, "")),
        Syntax.AttributeParameterValue(builder, "WordWidth", widthType, Syntax.LiteralValue(builder, Literal::Integer("0_u8"))),
        Syntax.AttributeParameterValue(builder, "Bytes", boolType, no),
        Syntax.AttributeParameterValue(builder, "Catchall", boolType, no),
    ];
    return AttributeDeclarationSet { declarations: [Syntax.AttributeDeclarationValue(builder, "Serialize", targets, serialize), Syntax.AttributeDeclarationValue(builder, "SerializeField", [Syntax.AttributeTargetValue(builder, "field")], field)] };
}
