/// Testing.Assert passing paths and the failure-record frame. A failed assertion ends the process,
/// so the failure path is covered by the `beskid test` journey tests and the frame is checked here.

use Testing.Assert;
use Testing.Assert.FailureRecord;

test AssertPassingHelpers {
    Assert.Equal<i64>(2 + 2, 4, "sum");
    Assert.NotEqual<i64>(1, 2, "differ");
    Assert.True(1 < 2, "ordering");
    Assert.False(2 < 1, "ordering");
    Assert.Contains("beskid", "kid", "needle");
}

test AssertHelpersTakeAnOptionalBecause {
    Assert.Equal(1, 1);
    Assert.NotEqual(1, 2);
    Assert.True(1 < 2);
    Assert.False(2 < 1);
    Assert.Contains("beskid", "kid");
}

test AssertEqualTakesEveryFormattingType
{
    Assert.Equal<i32>(-3_i32, -3_i32, "i32");
    Assert.Equal<u8>(9_u8, 9_u8, "u8");
    Assert.Equal<f64>(2.5_f64, 2.5_f64, "f64");
    Assert.Equal<bool>(true, true, "bool");
    Assert.Equal<char>('q', 'q', "char");
    Assert.Equal<string>("text", "text", "string");
    Assert.NotEqual<string>("a", "b", "strings differ");
    Assert.NotEqual<u64>(1_u64, 2_u64, "u64 values differ");
}

test FailureRecordFramesEveryFieldWithItsByteLength {
    FailureRecord record = FailureRecord {
        headline: "expected 3, found 4",
        because: "adds",
        expected: "3",
        actual: "4",
        file: "Src/Main.bd",
        line: 17_i64,
        column: 5_i64
    };
    Assert.Equal<string>(
        record.Frame(),
        "BESKID-TEST-FAILURE/2
19:expected 3, found 4
4:adds
1:3
1:4
11:Src/Main.bd
2:17
1:5
",
        "frame layout"
    );
}

test FailureRecordFramesTextThatHoldsSeparatorsAndNewlines {
    FailureRecord record = FailureRecord {
        headline: "h",
        because: "a ~~|~~ b:
c",
        expected: "",
        actual: "",
        file: "f",
        line: 1_i64,
        column: 1_i64
    };
    Assert.Equal<string>(
        record.Frame(),
        "BESKID-TEST-FAILURE/2
1:h
12:a ~~|~~ b:
c
0:
0:
1:f
1:1
1:1
",
        "length-prefixed fields keep their text"
    );
}
