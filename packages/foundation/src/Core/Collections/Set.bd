/// Unordered set backed by a linear typed-array scan.
/// @tier(supported)
use Core.Collections.Array;
use Core.Collections.Storage;

pub type Set<T> {
    T[] storage,
    i64 count,

    pub i64 Count() {
        return count;
    }

    pub bool IsEmpty() {
        return count == 0;
    }

    pub bool Contains(T value) {
        mut i64 index = 0;
        while index < count {
            if Array.Get<T>(storage, index) == value {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    pub Set<T> Add(T value) {
        if Contains(value) {
            return this;
        }
        T[] nextStorage = Storage.AppendAt<T>(storage, count, value);
        return Set<T> { storage: nextStorage, count: count + 1 };
    }

    pub Set<T> Remove(T value) {
        mut i64 index = 0;
        while index < count {
            if Array.Get<T>(storage, index) == value {
                return Set<T> { storage: Storage.CopyWithout<T>(storage, count, index), count: count - 1 };
            }
            index = index + 1;
        }
        return this;
    }

    /// Copies the members into a new array in insertion order.
    pub T[] ToArray() {
        return Storage.CopyRange<T>(this.storage, 0, this.count);
    }

    /// Members of this set followed by members of `other` that are not already present.
    pub Set<T> Union(Set<T> other) {
        mut T[] merged = Array.Empty<T>();
        mut i64 index = 0;
        while index < this.count {
            merged = Array.Append<T>(merged, Array.Get<T>(this.storage, index));
            index = index + 1;
        }
        mut i64 total = this.count;
        index = 0;
        while index < other.count {
            if Storage.IndexOf<T>(this.storage, this.count, Array.Get<T>(other.storage, index)) < 0 {
                merged = Array.Append<T>(merged, Array.Get<T>(other.storage, index));
                total = total + 1;
            }
            index = index + 1;
        }
        return Set<T> { storage: merged, count: total };
    }

    /// Members of this set that are also in `other`, in this set's order.
    pub Set<T> Intersect(Set<T> other) {
        mut T[] kept = Array.Empty<T>();
        mut i64 total = 0;
        mut i64 index = 0;
        while index < this.count {
            if Storage.IndexOf<T>(other.storage, other.count, Array.Get<T>(this.storage, index)) >= 0 {
                kept = Array.Append<T>(kept, Array.Get<T>(this.storage, index));
                total = total + 1;
            }
            index = index + 1;
        }
        return Set<T> { storage: kept, count: total };
    }

    /// Members of this set that are not in `other`, in this set's order.
    pub Set<T> Difference(Set<T> other) {
        mut T[] kept = Array.Empty<T>();
        mut i64 total = 0;
        mut i64 index = 0;
        while index < this.count {
            if Storage.IndexOf<T>(other.storage, other.count, Array.Get<T>(this.storage, index)) < 0 {
                kept = Array.Append<T>(kept, Array.Get<T>(this.storage, index));
                total = total + 1;
            }
            index = index + 1;
        }
        return Set<T> { storage: kept, count: total };
    }

    /// Returns true when every member of this set is also in `other`.
    pub bool IsSubsetOf(Set<T> other) {
        mut i64 index = 0;
        while index < this.count {
            if Storage.IndexOf<T>(other.storage, other.count, Array.Get<T>(this.storage, index)) < 0 {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

pub Set<T> New<T>() {
    return Set<T> { storage: Array.Empty<T>(), count: 0 };
}

/// Builds a set from `values`, keeping the first occurrence of each duplicate.
pub Set<T> FromArray<T>(T[] values) {
    mut T[] members = Array.Empty<T>();
    mut i64 total = 0;
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        if Storage.IndexOf<T>(members, total, Array.Get<T>(values, index)) < 0 {
            members = Array.Append<T>(members, Array.Get<T>(values, index));
            total = total + 1;
        }
        index = index + 1;
    }
    return Set<T> { storage: members, count: total };
}

/// Bulk constructor: packs call-site scalars into a set.
/// Iterates the bulk array and inserts each value via `Set.Add`.
pub Set<T> Of<T>(bulk T[] values) {
    mut Set<T> result = Set.New<T>();
    mut i64 index = 0;
    while index < Array.Len<T>(values) {
        result = result.Add(Array.Get<T>(values, index));
        index = index + 1;
    }
    return result;
}
