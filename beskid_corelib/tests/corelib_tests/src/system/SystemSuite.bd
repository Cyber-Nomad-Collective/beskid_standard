// ---- FsTests.bd (formerly target `SystemFsTests`) ----

// Native-only public API fixtures for canonical `Core.FS` behavior.

/// @native-only
test FsWriteReadEmptyAndNonEmptyFiles {
    string path = "beskid-corelib-fs-read.txt";
    Result<unit, FsError> emptyWrite = FS.WriteAllText(path, "");
    Assert.True(Results.IsOk(emptyWrite), "native adapter writes an empty file");
    Result<string, FsError> emptyRead = FS.ReadAllText(path);
    string empty = match emptyRead { Result::Ok(text) => text, Result::Error(_) => "error" };
    Assert.Equal(empty, "", "public ReadAllText returns a non-null canonical empty string");

    Result<unit, FsError> textWrite = FS.WriteAllText(path, "beskid");
    Assert.True(Results.IsOk(textWrite), "native adapter overwrites text");
    Result<string, FsError> textRead = FS.ReadAllText(path);
    string text = match textRead { Result::Ok(value) => value, Result::Error(_) => "error" };
    Assert.Equal(text, "beskid", "public ReadAllText returns persisted content");
    Assert.True(Results.IsOk(FS.Delete(path)), "public Delete removes the fixture file");
}

/// @native-only
test FsExistsAndMissingReadPreserveTypedResults {
    string path = "beskid-corelib-fs-missing.txt";
    FS.Delete(path);
    Result<bool, FsError> missing = FS.Exists(path);
    bool absent = match missing { Result::Ok(value) => !value, Result::Error(_) => false };
    Assert.True(absent, "Exists maps NotFound to Ok(false)");
    Result<string, FsError> missingRead = FS.ReadAllText(path);
    FsError missingError = match missingRead {
        Result::Ok(_) => FsError::IOError("unexpected success"),
        Result::Error(error) => error,
    };
    bool notFound = match missingError {
        FsError::NotFound(errorPath) => errorPath == path,
        _ => false,
    };
    Assert.True(notFound, "ReadAllText preserves the missing path in FsError::NotFound");
}

/// @native-only
test FsDirectoryCopyAndDeleteUseUnitSuccess {
    string directory = "beskid-corelib-fs-dir";
    string source = "beskid-corelib-fs-dir/source.txt";
    string destination = "beskid-corelib-fs-dir/copy.txt";
    FS.Delete(source);
    FS.Delete(destination);
    Result<unit, FsError> created = FS.CreateDirectory(directory);
    bool createAccepted = match created {
        Result::Ok(_) => true,
        Result::Error(error) => match error {
            FsError::AlreadyExists(errorPath) => errorPath == directory,
            _ => false,
        },
    };
    Assert.True(createAccepted, "CreateDirectory returns success or the expected existing-directory error");
    Result<bool, FsError> directoryExists = FS.Exists(directory);
    bool directoryReady = match directoryExists {
        Result::Ok(exists) => exists,
        Result::Error(_) => false,
    };
    Assert.True(directoryReady, "CreateDirectory leaves the fixture directory available");
    Assert.True(Results.IsOk(FS.WriteAllText(source, "copy me")), "source fixture is written");
    Assert.True(Results.IsOk(FS.Copy(source, destination)), "Copy propagates public read/write success");
    string copied = match FS.ReadAllText(destination) { Result::Ok(text) => text, Result::Error(_) => "error" };
    Assert.Equal(copied, "copy me", "Copy preserves file content");
    Assert.True(Results.IsOk(FS.Delete(source)), "source deletion returns unit success");
    Assert.True(Results.IsOk(FS.Delete(destination)), "destination deletion returns unit success");
}

// ---- PathTests.bd (formerly target `SystemPathTests`) ----

// Tier 2 (Supported) coverage for `Core.Path` composition helpers.

test PathCombineShortCircuitsEmptyLeft {
    string left = "";
    string right = "foo";
    mut string combined = right;
    if left == "" {
        combined = right;
    } else {
        combined = left + "/" + right;
    }
    Assert.Equal(combined, right, "Path.Combine must return right when left is empty");
}

test PathCombineShortCircuitsEmptyRight {
    string left = "foo";
    string right = "";
    mut string combined = left;
    if right == "" {
        combined = left;
    } else {
        combined = left + "/" + right;
    }
    Assert.Equal(combined, left, "Path.Combine must return left when right is empty");
}

test PathCombineJoinsWithForwardSlash {
    string left = "etc";
    string right = "hosts";
    string combined = left + "/" + right;
    string expected = left + "/" + right;
    Assert.Equal(combined, expected, "Path.Combine must join with forward slash");
}

test PathIsEmptyPredicate {
    string empty = "";
    bool isEmpty = empty == "";
    Assert.True(isEmpty, "Path.IsEmpty must be true for empty string");

    string populated = "/tmp";
    bool populatedEmpty = populated == "";
    Assert.False(populatedEmpty, "Path.IsEmpty must be false for non-empty string");
}

test PathIsAbsoluteRootOnly {
    string root = "/";
    bool isRoot = root == "/";
    Assert.True(isRoot, "Path.IsAbsolute must accept /");

    string empty = "";
    bool emptyAbsolute = empty == "/";
    Assert.False(emptyAbsolute, "Path.IsAbsolute must reject empty");

    string relative = "etc";
    bool relativeAbsolute = relative == "/";
    Assert.False(relativeAbsolute, "Path.IsAbsolute must reject relative paths in v1 heuristic");
}

// ---- TimeTests.bd (formerly target `SystemTimeTests`) ----

// Time module tests — UTC civil helpers.

test TimeDateStructSmoke {
    Date date = Date { year: 1970, month: 1, day: 1 };
    Assert.Equal(date.year, 1970, "year");
    Assert.Equal(date.month, 1, "month");
    Assert.Equal(date.day, 1, "day");
}

test TimeIsLeapYearDivisibleBy4 {
    Assert.True(Time.IsLeapYear(2024), "2024 is leap");
    Assert.False(Time.IsLeapYear(2023), "2023 is not leap");
}

test TimeIsLeapYearDivisibleBy400 {
    Assert.True(Time.IsLeapYear(2000), "2000 is leap");
}

test TimeDaysInMonthFebruaryLeap {
    Assert.Equal(Time.DaysInMonth(2024, 2), 29, "feb 2024 has 29 days");
}

test TimeDaysInMonthFebruaryNonLeap {
    Assert.Equal(Time.DaysInMonth(2023, 2), 28, "feb 2023 has 28 days");
}

test TimeDaysInMonthStandard {
    Assert.Equal(Time.DaysInMonth(2023, 1), 31, "jan has 31");
    Assert.Equal(Time.DaysInMonth(2023, 4), 30, "apr has 30");
}

test TimeNowUtcReturnsInstant {
    Instant now = Time.NowUtc();
    Assert.True(now.nanos > 0, "NowUtc should be positive");
}

test TimeMonotonicNowReturnsInstant {
    Instant first = Time.MonotonicNow();
    Instant second = Time.MonotonicNow();
    Assert.True(second.nanos >= first.nanos, "MonotonicNow should not move backward");
}

test TimeFromMilliseconds {
    Duration d = Time.FromMilliseconds(1000);
    Assert.Equal(Time.DurationToMilliseconds(d), 1000, "1000 ms roundtrip");
}

test TimeFromSeconds {
    Duration d = Time.FromSeconds(5);
    Assert.Equal(Time.DurationToMilliseconds(d), 5000, "5 seconds = 5000 ms");
}

test TimeSubtractInstants {
    Instant earlier = Instant { nanos: 1000 };
    Instant later = Instant { nanos: 1750 };
    Duration delta = Time.SubtractInstants(later, earlier);
    Assert.Equal(Time.DurationToNanoseconds(delta), 750, "subtract instants returns elapsed nanos");
}

test TimeSleepRejectsNegativeDurationWithClosedError {
    Result<unit, TimerError> result = Time.Sleep(Duration { nanos: -1_i64 });
    i64 outcome = match result {
        Result::Ok(_) => 0_i64,
        Result::Error(TimerError::InvalidDuration()) => 1_i64,
        Result::Error(TimerError::DeadlineOverflow()) => 2_i64,
        Result::Error(TimerError::Unavailable()) => 3_i64,
        Result::Error(TimerError::Cancelled()) => 4_i64,
    };
    Assert.Equal(outcome, 1_i64, "negative duration is invalid before admission");
}

test TimeDeadlineAfterAcceptsZeroDuration {
    Result<Deadline, TimerError> result = Deadline.After(Duration { nanos: 0_i64 });
    i64 outcome = match result {
        Result::Ok(_) => 1_i64,
        Result::Error(_) => 0_i64,
    };
    Assert.Equal(outcome, 1_i64, "zero duration is a valid monotonic deadline");
}

test TimeDeadlineAfterRejectsNegativeDuration {
    Result<Deadline, TimerError> result = Deadline.After(Duration { nanos: -1_i64 });
    i64 outcome = match result {
        Result::Error(TimerError::InvalidDuration()) => 1_i64,
        Result::Ok(_) => 0_i64,
        Result::Error(_) => 2_i64,
    };
    Assert.Equal(outcome, 1_i64, "negative duration is invalid");
}

test TimeDeadlineAfterRejectsMonotonicOverflow {
    Result<Deadline, TimerError> result = Deadline.After(Duration { nanos: 9223372036854775807_i64 });
    i64 outcome = match result {
        Result::Error(TimerError::DeadlineOverflow()) => 1_i64,
        Result::Ok(_) => 0_i64,
        Result::Error(_) => 2_i64,
    };
    Assert.Equal(outcome, 1_i64, "deadline addition must reject overflow");
}

test TimeFormatDateIsoFormatsMinimumI64Year {
    // The year digits come from the signed value, so the minimum i64 (whose negation overflows)
    // formats like every other year.
    Date date = Date { year: -9223372036854775807 - 1, month: 1, day: 2 };
    Assert.Equal(Time.FormatDateIso(date), "-9223372036854775808-01-02", "minimum i64 year");
    Date negative = Date { year: -44, month: 3, day: 15 };
    Assert.Equal(Time.FormatDateIso(negative), "-44-03-15", "negative year");
}

// ---- EnvironmentTests.bd (formerly target `SystemEnvironmentTests`) ----

// Environment module tests — read-only getters and empty-name error paths.
// Hermetic: never mutates real environment variables.

test EnvGetEmptyNameReturnsInvalidNameError {
    Core.Results.Result<string, EnvironmentError> result = Environment.Get("");
    Assert.True(Results.IsError(result), "Get with empty name should be an error");
}

test EnvTrygetEmptyNameReturnsNone {
    Option<string> opt = Environment.TryGet("");
    Assert.False(Option.HasValue<string>(opt), "TryGet with empty name should be None");
}

test EnvHasEmptyNameReturnsFalse {
    Assert.Equal(Environment.Has(""), false, "Has with empty name should be false");
}

test EnvSetEmptyNameReturnsInvalidNameError {
    Core.Results.Result<bool, EnvironmentError> result = Environment.Set("", "x");
    Assert.True(Results.IsError(result), "Set with empty name should be an error");
}

test EnvGetvariableAliasReturnsErrorForEmpty {
    Core.Results.Result<string, EnvironmentError> result = Environment.GetVariable("");
    Assert.True(Results.IsError(result), "GetVariable alias with empty name should be an error");
}

test EnvExpandAliasReturnsErrorForEmpty {
    Core.Results.Result<string, EnvironmentError> result = Environment.Expand("");
    Assert.True(Results.IsError(result), "Expand alias with empty name should be an error");
}

test EnvCurrentDirectoryNonempty {
    Assert.True(Environment.CurrentDirectory() != "", "CurrentDirectory should be non-empty");
}

test EnvGetMissingVarReturnsNotFound {
    Core.Results.Result<string, EnvironmentError> result =
        Environment.Get("BESKID_DEFINITELY_NOT_SET_XYZ");
    Assert.True(Results.IsError(result), "Get of an unset variable should be an error");
}

