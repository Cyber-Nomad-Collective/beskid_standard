/// Bordered panel control with optional title.
use Console;
use Console.Style;
use Console.Controls.Contracts;
use Console.Controls.Frame;
use Console.Controls.RenderContext;
use Console.Capabilities;
use Ansi.Text;
use Core.Collections.Array;
use Core.Math;
use Core.String;

pub type Panel : Contracts.PaddingProvider, Contracts.MarginProvider, Contracts.FramedControl, Contracts.ConsoleControl {
    string title,
    TitleAlignment align,
    Padding padding,
    Margin margin,
    bool forceAscii,
    string body,
}

pub Panel New(string body) {
    return Panel {
        title: "",
        align: TitleAlignment::Left(),
        padding: Padding::None(),
        margin: Margin::None(),
        forceAscii: false,
        body: body,
    };
}

pub Panel WithTitle(Panel panel, string title) {
    return Panel {
        title: title,
        align: panel.align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Panel WithAlignment(Panel panel, TitleAlignment align) {
    return Panel {
        title: panel.title,
        align: align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Panel WithAsciiFrame(Panel panel) {
    return Panel {
        title: panel.title,
        align: panel.align,
        padding: panel.padding,
        margin: panel.margin,
        forceAscii: true,
        body: panel.body,
    };
}

pub Panel WithPadding(Panel panel, Padding padding) {
    return Panel {
        title: panel.title,
        align: panel.align,
        padding: padding,
        margin: panel.margin,
        forceAscii: panel.forceAscii,
        body: panel.body,
    };
}

pub Padding Padding(Panel panel) {
    return panel.padding;
}

pub Margin Margin(Panel panel) {
    return panel.margin;
}

pub bool UseUnicodeFrame(Panel panel) {
    if panel.forceAscii {
        return false;
    }
    return Frame.PreferUnicodeFrame();
}

/// Body lines: the body split on line feeds (a trailing CR is dropped); an empty body is one
/// empty line.
pub string[] BodyLines(Panel panel) {
    string[] lines = String.Lines(panel.body);
    if Array.Len<string>(lines) == 0 {
        mut string[] onlyLine = Array.Empty<string>();
        onlyLine = Array.Append<string>(onlyLine, "");
        return onlyLine;
    }
    return lines;
}

/// Display columns of the widest body line; ANSI styling and wide characters are measured by
/// `Ansi.Text.VisibleWidth`, not by byte length.
pub i64 ContentWidth(Panel panel) {
    string[] lines = BodyLines(panel);
    mut i64 widest = 0;
    mut i64 i = 0;
    while i < Array.Len<string>(lines) {
        widest = Math.Max(widest, Text.VisibleWidth(Array.Get<string>(lines, i)));
        i = i + 1;
    }
    return widest;
}

/// Size of the rendered panel: borders plus one row per body line. The title sits inside the
/// top border and adds no row.
pub Console.ConsoleSize Measure(Panel panel, Console.ConsoleSize available) {
    i32 pad = Console.Style.ResolvePadding(panel.padding, available.columns);
    i32 margin = Console.Style.ResolveMargin(panel.margin, available.columns);
    i64 inner = ContentWidth(panel) + (pad * 2);
    i32 width = Console.Style.ClampWidth(inner + 2, 4, available.columns - margin);
    i32 rows = i32(Array.Len<string>(BodyLines(panel))) + 2;
    return Console.ConsoleSize { columns: width, rows: rows };
}

pub string TopBorder(Panel panel, Frame.FrameChars frame, i32 innerWidth) {
    if panel.title == "" {
        return "${frame.topLeft}${String.Repeat(frame.top, i64(innerWidth))}${frame.topRight}";
    }
    i32 titleLen = i32(Text.VisibleWidth(panel.title));
    mut i32 titleWidth = innerWidth - 2;
    if titleWidth < 1 {
        titleWidth = 1;
    }
    mut i32 leftFill = match panel.align {
        TitleAlignment::Left => 1,
        TitleAlignment::Center => (titleWidth - titleLen) / 2,
        TitleAlignment::Right => titleWidth - titleLen - 1,
    };
    mut i32 rightFill = match panel.align {
        TitleAlignment::Left => titleWidth - titleLen - leftFill,
        TitleAlignment::Center => titleWidth - titleLen - leftFill,
        TitleAlignment::Right => 1,
    };
    if leftFill < 0 {
        leftFill = 0;
    }
    if rightFill < 0 {
        rightFill = 0;
    }
    return "${frame.topLeft}${String.Repeat(frame.top, i64(leftFill))} ${panel.title} ${String.Repeat(frame.top, i64(rightFill))}${frame.topRight}";
}

/// One framed body row. Lines wider than the space inside the padding are truncated with an
/// ellipsis so the right border stays aligned.
pub string BodyLine(Panel panel, Frame.FrameChars frame, i32 innerWidth, string line) {
    i32 pad = Console.Style.ResolvePadding(panel.padding, innerWidth + 2);
    mut i64 room = i64(innerWidth) - i64(pad) * 2;
    if room < 1 {
        room = 1;
    }
    string fitted = Text.Truncate(line, room, "...");
    mut i64 padRight = i64(innerWidth) - Text.VisibleWidth(fitted) - i64(pad);
    if padRight < 0 {
        padRight = 0;
    }
    return frame.side + String.Repeat(" ", i64(pad)) + fitted + String.Repeat(" ", padRight) + frame.side;
}

pub string Render(Panel panel, Console.ConsoleSize size) {
    Frame.FrameChars frame = Frame.ForHost(UseUnicodeFrame(panel));
    mut i32 innerWidth = size.columns - 2;
    if innerWidth < 1 {
        innerWidth = 1;
    }
    string[] lines = BodyLines(panel);
    mut string block = TopBorder(panel, frame, innerWidth);
    mut i64 i = 0;
    while i < Array.Len<string>(lines) {
        block = block + String.Newline() + BodyLine(panel, frame, innerWidth, Array.Get<string>(lines, i));
        i = i + 1;
    }
    string bottomFill = String.Repeat(frame.bottom, i64(innerWidth));
    return block + String.Newline() + frame.bottomLeft + bottomFill + frame.bottomRight;
}

pub string RenderWithContext(Panel panel, Console.ConsoleSize size, RenderContext.RenderContext ctx) {
    string block = Render(panel, size);
    return RenderContext.RenderAt(ctx, block);
}
