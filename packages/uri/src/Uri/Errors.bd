/// Typed failures of the URI package. Every parser and helper fails closed with one of these.
pub enum UriError {
    /// The input is longer than the configured maximum.
    TooLong(),
    /// A byte that is not allowed anywhere in a URI reference (space, control, non-ASCII, `"<>\^`{|}`).
    InvalidCharacter(i64 index),
    /// A `%` that is not followed by two hexadecimal digits.
    InvalidPercentEncoding(i64 index),
    InvalidScheme(),
    InvalidAuthority(),
    InvalidUserinfo(),
    InvalidHost(),
    /// A numeric-looking host that is not a strict dotted-decimal IPv4 address.
    InvalidIpv4(),
    InvalidIpv6(),
    /// An IPvFuture literal where the caller did not allow it.
    IpvFutureNotAllowed(),
    InvalidPort(),
    PortOutOfRange(),
    InvalidPath(),
    InvalidQuery(),
    InvalidFragment(),
    /// A URI with a scheme was required (parse of an absolute URI, base of a resolution).
    NotAbsolute(),
    /// An authority was required but the reference has none.
    MissingAuthority(),
    /// No explicit port and no default port for the scheme.
    MissingPort(),
}

/// Stable small integer per variant, for tests and logs.
pub i64 Code(UriError error) {
    return match error {
        UriError::TooLong => 1_i64,
        UriError::InvalidCharacter(_) => 2_i64,
        UriError::InvalidPercentEncoding(_) => 3_i64,
        UriError::InvalidScheme => 4_i64,
        UriError::InvalidAuthority => 5_i64,
        UriError::InvalidUserinfo => 6_i64,
        UriError::InvalidHost => 7_i64,
        UriError::InvalidIpv4 => 8_i64,
        UriError::InvalidIpv6 => 9_i64,
        UriError::IpvFutureNotAllowed => 10_i64,
        UriError::InvalidPort => 11_i64,
        UriError::PortOutOfRange => 12_i64,
        UriError::InvalidPath => 13_i64,
        UriError::InvalidQuery => 14_i64,
        UriError::InvalidFragment => 15_i64,
        UriError::NotAbsolute => 16_i64,
        UriError::MissingAuthority => 17_i64,
        UriError::MissingPort => 18_i64,
    };
}
