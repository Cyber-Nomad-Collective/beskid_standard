use Core.Bytes.Slice;
use Crypto.ConstantTime;
use Crypto.Native;

/// Crypto provider selection (ruling R27).
///
/// Every public `Crypto` API (`Sha256.Hash`, `Sha512.Hash512`/`Hash384`, `Hmac.Compute`,
/// `Hmac.Digest`, `AesGcm`, `ChaCha20Poly1305`, and through them `Hkdf`) runs on the native
/// provider (OpenSSL 3 libcrypto EVP, `Crypto.Native`) when it is selected, and on the pure
/// Beskid CLIF kernels otherwise. Selection, once per process:
///
/// 1. `Pure` when `libcrypto.so.3` or one of its symbols is absent (`Native.Available()`).
/// 2. `Pure` when `BESKID_CRYPTO_PROVIDER=pure` is set (checked on every selection).
/// 3. Else the known-answer self-test decides; its result is cached in the process
///    environment as `BESKID_CRYPTO_PROVIDER_STATE` (`native` or `pure`), so it runs once.
///
/// The cache lives in the environment because Beskid has no process-wide mutable state.
/// Fibers are cooperative on one thread, so the first `setenv` cannot race with `getenv`;
/// a program that starts OS threads (`Core.Threading.Thread`) should select once
/// (`Provider.Current()`) before it does.
///
/// Streaming hash/HMAC states, X25519, P-256, ECDSA, RSA, the raw AES and ChaCha20 blocks
/// (QUIC header protection), and inputs of 2^30 bytes or more always use the pure kernels.
pub enum ProviderKind { Pure(), Native(), }

/// `BESKID_CRYPTO_PROVIDER` as a NUL-terminated C string.
pub u8[] SwitchName() { return [66_u8, 69_u8, 83_u8, 75_u8, 73_u8, 68_u8, 95_u8, 67_u8, 82_u8, 89_u8, 80_u8, 84_u8, 79_u8, 95_u8, 80_u8, 82_u8, 79_u8, 86_u8, 73_u8, 68_u8, 69_u8, 82_u8, 0_u8]; }

/// The switch value that forces the pure provider.
pub u8[] PureValue() { return [112_u8, 117_u8, 114_u8, 101_u8, 0_u8]; }

u8[] StateName() { return [66_u8, 69_u8, 83_u8, 75_u8, 73_u8, 68_u8, 95_u8, 67_u8, 82_u8, 89_u8, 80_u8, 84_u8, 79_u8, 95_u8, 80_u8, 82_u8, 79_u8, 86_u8, 73_u8, 68_u8, 69_u8, 82_u8, 95_u8, 83_u8, 84_u8, 65_u8, 84_u8, 69_u8, 0_u8]; }
u8[] NativeValue() { return [110_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 0_u8]; }
u8[] Empty() { return [0_u8]; }

/// True when `BESKID_CRYPTO_PROVIDER=pure` is set.
pub bool PureForced() { return Native.EnvEquals(SwitchName(), PureValue()); }

/// Sets (`true`) or clears (`false`) `BESKID_CRYPTO_PROVIDER=pure` in this process. AES-GCM
/// keys keep the provider they were created with; other calls follow the switch at once.
pub unit ForcePure(bool pure) {
    Native.SetEnv(SwitchName(), PureValue(), !pure);
    return;
}

/// True when the native provider serves calls now.
pub bool IsNative() {
    if !Native.Available() { return false; }
    if PureForced() { return false; }
    if Native.EnvEquals(StateName(), NativeValue()) { return true; }
    if Native.EnvEquals(StateName(), PureValue()) { return false; }
    bool passed = SelfTest();
    if passed { Native.SetEnv(StateName(), NativeValue(), false); } else { Native.SetEnv(StateName(), PureValue(), false); }
    return passed;
}

/// The provider that serves calls now (see the module comment).
pub ProviderKind Current() {
    if IsNative() { return ProviderKind::Native(); }
    return ProviderKind::Pure();
}

/// True when the OpenSSL 3 library and every symbol the provider uses resolved.
pub bool NativeAvailable() { return Native.Available(); }

bool Same(u8[] a, u8[] b) { return Slice.Len(a) == Slice.Len(b) && ConstantTime.Equal(a, b); }

u8[] Message() { return [2_u8, 7_u8, 12_u8, 17_u8, 22_u8, 27_u8, 32_u8, 37_u8, 42_u8, 47_u8, 52_u8, 57_u8, 62_u8, 67_u8, 72_u8, 77_u8, 82_u8, 87_u8, 92_u8, 97_u8, 102_u8, 107_u8, 112_u8, 117_u8, 122_u8, 127_u8, 132_u8, 137_u8, 142_u8, 147_u8, 152_u8, 157_u8, 162_u8, 167_u8, 172_u8, 177_u8, 182_u8, 187_u8, 192_u8, 197_u8]; }
u8[] Aad() { return [0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8]; }
u8[] Nonce() { return [9_u8, 16_u8, 23_u8, 30_u8, 37_u8, 44_u8, 51_u8, 58_u8, 65_u8, 72_u8, 79_u8, 86_u8]; }
u8[] HmacKey() { return [11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8, 11_u8]; }
u8[] Aes128Key() { return [0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8, 13_u8, 14_u8, 15_u8]; }
u8[] Aes256Key() { return [0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8, 13_u8, 14_u8, 15_u8, 16_u8, 17_u8, 18_u8, 19_u8, 20_u8, 21_u8, 22_u8, 23_u8, 24_u8, 25_u8, 26_u8, 27_u8, 28_u8, 29_u8, 30_u8, 31_u8]; }
u8[] ChaChaKey() { return [1_u8, 4_u8, 7_u8, 10_u8, 13_u8, 16_u8, 19_u8, 22_u8, 25_u8, 28_u8, 31_u8, 34_u8, 37_u8, 40_u8, 43_u8, 46_u8, 49_u8, 52_u8, 55_u8, 58_u8, 61_u8, 64_u8, 67_u8, 70_u8, 73_u8, 76_u8, 79_u8, 82_u8, 85_u8, 88_u8, 91_u8, 94_u8]; }

bool DigestKat() {
    u8[] abc = [97_u8, 98_u8, 99_u8];
    u8[] d256 = Slice.New(32_i64);
    Native.Sha256Into(abc, d256);
    if !Same(d256, [186_u8, 120_u8, 22_u8, 191_u8, 143_u8, 1_u8, 207_u8, 234_u8, 65_u8, 65_u8, 64_u8, 222_u8, 93_u8, 174_u8, 34_u8, 35_u8, 176_u8, 3_u8, 97_u8, 163_u8, 150_u8, 23_u8, 122_u8, 156_u8, 180_u8, 16_u8, 255_u8, 97_u8, 242_u8, 0_u8, 21_u8, 173_u8]) { return false; }
    u8[] d384 = Slice.New(48_i64);
    Native.Sha384Into(abc, d384);
    if !Same(d384, [203_u8, 0_u8, 117_u8, 63_u8, 69_u8, 163_u8, 94_u8, 139_u8, 181_u8, 160_u8, 61_u8, 105_u8, 154_u8, 198_u8, 80_u8, 7_u8, 39_u8, 44_u8, 50_u8, 171_u8, 14_u8, 222_u8, 209_u8, 99_u8, 26_u8, 139_u8, 96_u8, 90_u8, 67_u8, 255_u8, 91_u8, 237_u8, 128_u8, 134_u8, 7_u8, 43_u8, 161_u8, 231_u8, 204_u8, 35_u8, 88_u8, 186_u8, 236_u8, 161_u8, 52_u8, 200_u8, 37_u8, 167_u8]) { return false; }
    u8[] d512 = Slice.New(64_i64);
    Native.Sha512Into(abc, d512);
    return Same(d512, [221_u8, 175_u8, 53_u8, 161_u8, 147_u8, 97_u8, 122_u8, 186_u8, 204_u8, 65_u8, 115_u8, 73_u8, 174_u8, 32_u8, 65_u8, 49_u8, 18_u8, 230_u8, 250_u8, 78_u8, 137_u8, 169_u8, 126_u8, 162_u8, 10_u8, 158_u8, 238_u8, 230_u8, 75_u8, 85_u8, 211_u8, 154_u8, 33_u8, 146_u8, 153_u8, 42_u8, 39_u8, 79_u8, 193_u8, 168_u8, 54_u8, 186_u8, 60_u8, 35_u8, 163_u8, 254_u8, 235_u8, 189_u8, 69_u8, 77_u8, 68_u8, 35_u8, 100_u8, 60_u8, 232_u8, 14_u8, 42_u8, 154_u8, 201_u8, 79_u8, 165_u8, 76_u8, 164_u8, 159_u8]);
}

bool HmacKat() {
    u8[] h256 = Slice.New(32_i64);
    if Native.HmacInto(Native.Sha256Md(), HmacKey(), Message(), h256) == 0_i64 { return false; }
    if !Same(h256, [1_u8, 238_u8, 3_u8, 22_u8, 41_u8, 156_u8, 244_u8, 181_u8, 135_u8, 234_u8, 128_u8, 163_u8, 40_u8, 129_u8, 40_u8, 29_u8, 40_u8, 127_u8, 59_u8, 163_u8, 185_u8, 187_u8, 207_u8, 201_u8, 43_u8, 124_u8, 144_u8, 105_u8, 234_u8, 21_u8, 68_u8, 115_u8]) { return false; }
    u8[] h384 = Slice.New(48_i64);
    if Native.HmacInto(Native.Sha384Md(), HmacKey(), Message(), h384) == 0_i64 { return false; }
    return Same(h384, [125_u8, 72_u8, 163_u8, 55_u8, 27_u8, 53_u8, 178_u8, 219_u8, 76_u8, 220_u8, 170_u8, 198_u8, 245_u8, 117_u8, 244_u8, 62_u8, 246_u8, 11_u8, 150_u8, 239_u8, 155_u8, 193_u8, 170_u8, 25_u8, 58_u8, 10_u8, 176_u8, 91_u8, 47_u8, 117_u8, 214_u8, 30_u8, 85_u8, 73_u8, 206_u8, 223_u8, 246_u8, 100_u8, 170_u8, 242_u8, 127_u8, 140_u8, 113_u8, 133_u8, 110_u8, 135_u8, 88_u8, 34_u8]);
}

/// Seals the message with `cipher`/`key`, compares with `expected`, opens it again, and
/// checks that a flipped tag bit fails and wipes the output.
bool AeadKat(i64 cipher, u8[] key, u8[] expected) {
    i64 n = Slice.Len(Message());
    u8[] sealed = Slice.New(n + 16_i64);
    if !Native.AeadSeal(cipher, key, Nonce(), Aad(), Message(), 0_i64, n, sealed, 0_i64) { return false; }
    if !Same(sealed, expected) { return false; }
    u8[] opened = Slice.New(n);
    if Native.AeadOpen(cipher, key, Nonce(), Aad(), sealed, 0_i64, n, opened, 0_i64) != 1_i64 { return false; }
    if !Same(opened, Message()) { return false; }
    sealed[n] = (sealed[n] | 1_u8) - (sealed[n] & 1_u8);
    if Native.AeadOpen(cipher, key, Nonce(), Aad(), sealed, 0_i64, n, opened, 0_i64) != 2_i64 { return false; }
    return Same(opened, Slice.New(n));
}

/// Known-answer self-test of the native provider: SHA-256/384/512("abc") (FIPS 180-4),
/// HMAC-SHA-256/384, AES-128/256-GCM and ChaCha20-Poly1305 seal, open, and tag rejection
/// with output wiping. Expected values come from an independent implementation (Python
/// `hashlib`/`hmac` and pyca/cryptography). False when libcrypto is absent or misbehaves.
pub bool SelfTest() {
    if !Native.Available() { return false; }
    if !DigestKat() { return false; }
    if !HmacKat() { return false; }
    if !AeadKat(Native.AesGcmCipher(16_i64), Aes128Key(), [110_u8, 204_u8, 111_u8, 178_u8, 209_u8, 208_u8, 69_u8, 254_u8, 1_u8, 13_u8, 179_u8, 206_u8, 8_u8, 24_u8, 137_u8, 229_u8, 200_u8, 178_u8, 53_u8, 21_u8, 50_u8, 57_u8, 12_u8, 29_u8, 193_u8, 95_u8, 178_u8, 208_u8, 90_u8, 23_u8, 235_u8, 97_u8, 77_u8, 222_u8, 36_u8, 140_u8, 113_u8, 240_u8, 51_u8, 167_u8, 28_u8, 187_u8, 223_u8, 209_u8, 36_u8, 200_u8, 93_u8, 224_u8, 211_u8, 81_u8, 135_u8, 93_u8, 16_u8, 253_u8, 46_u8, 165_u8]) { return false; }
    if !AeadKat(Native.AesGcmCipher(32_i64), Aes256Key(), [178_u8, 150_u8, 102_u8, 42_u8, 160_u8, 80_u8, 44_u8, 107_u8, 44_u8, 24_u8, 147_u8, 181_u8, 153_u8, 205_u8, 118_u8, 139_u8, 239_u8, 45_u8, 124_u8, 51_u8, 17_u8, 244_u8, 19_u8, 176_u8, 68_u8, 98_u8, 172_u8, 144_u8, 61_u8, 198_u8, 43_u8, 254_u8, 20_u8, 166_u8, 189_u8, 45_u8, 105_u8, 43_u8, 3_u8, 205_u8, 11_u8, 148_u8, 247_u8, 202_u8, 87_u8, 149_u8, 87_u8, 1_u8, 163_u8, 77_u8, 40_u8, 200_u8, 195_u8, 71_u8, 1_u8, 122_u8]) { return false; }
    return AeadKat(Native.ChaChaCipher(), ChaChaKey(), [220_u8, 163_u8, 44_u8, 133_u8, 142_u8, 175_u8, 9_u8, 200_u8, 58_u8, 131_u8, 135_u8, 26_u8, 196_u8, 191_u8, 107_u8, 2_u8, 37_u8, 65_u8, 80_u8, 101_u8, 129_u8, 21_u8, 105_u8, 207_u8, 76_u8, 155_u8, 39_u8, 153_u8, 145_u8, 6_u8, 245_u8, 190_u8, 162_u8, 5_u8, 214_u8, 82_u8, 164_u8, 78_u8, 177_u8, 61_u8, 39_u8, 241_u8, 198_u8, 111_u8, 95_u8, 253_u8, 246_u8, 6_u8, 203_u8, 60_u8, 252_u8, 40_u8, 27_u8, 153_u8, 89_u8, 138_u8]);
}
