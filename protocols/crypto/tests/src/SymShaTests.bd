use Testing.Assert;
use Core.Bytes.Slice;
use Core.String;
use Crypto.Sha256;
use Crypto.Sha512;

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}
u8[] Hex(string text) {
    i64 n = String.Len(text) / 2_i64;
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = Nibble(String.ByteAt(text, 2_i64 * i)) * 16_u8 + Nibble(String.ByteAt(text, 2_i64 * i + 1_i64)); i = i + 1_i64; }
    return out;
}
u8[] Ascii(string text) {
    i64 n = String.Len(text);
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = String.ByteAt(text, i); i = i + 1_i64; }
    return out;
}
bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }

string Msg448() { return "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"; }
string Msg896() { return "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"; }

test sha256_abc { Assert.True(Same(Sha256.Hash(Ascii("abc")), Hex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")), "abc"); }
test sha256_empty { Assert.True(Same(Sha256.Hash(Ascii("")), Hex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")), "empty"); }
test sha256_448 { Assert.True(Same(Sha256.Hash(Ascii(Msg448())), Hex("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")), "448"); }
test sha256_896 { Assert.True(Same(Sha256.Hash(Ascii(Msg896())), Hex("cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")), "896"); }
test sha256_incremental_split {
    u8[] m = Ascii(Msg896());
    mut i64 split = 0_i64;
    while split <= Slice.Len(m) {
        Sha256State s = Sha256.New();
        Assert.True(Sha256.UpdateRange(s, m, 0_i64, split), "first part");
        Assert.True(Sha256.UpdateRange(s, m, split, Slice.Len(m) - split), "second part");
        Assert.True(Same(Sha256.Finish(s), Hex("cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")), "split");
        split = split + 7_i64;
    }
}
test sha256_clone_snapshot {
    Sha256State s = Sha256.New();
    Sha256.Update(s, Ascii("ab"));
    Sha256State snap = Sha256.Clone(s);
    Sha256.Update(snap, Ascii("c"));
    Assert.True(Same(Sha256.Finish(snap), Sha256.Hash(Ascii("abc"))), "clone abc");
    Sha256.Update(s, Ascii("c"));
    Assert.True(Same(Sha256.Finish(s), Sha256.Hash(Ascii("abc"))), "original unaffected");
    Assert.False(Sha256.Update(s, Ascii("x")), "update after finish rejected");
}
test sha512_abc { Assert.True(Same(Sha512.Hash512(Ascii("abc")), Hex("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")), "abc"); }
test sha512_empty { Assert.True(Same(Sha512.Hash512(Ascii("")), Hex("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")), "empty"); }
test sha512_448 { Assert.True(Same(Sha512.Hash512(Ascii(Msg448())), Hex("204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")), "448"); }
test sha512_896 { Assert.True(Same(Sha512.Hash512(Ascii(Msg896())), Hex("8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")), "896"); }
test sha384_abc { Assert.True(Same(Sha512.Hash384(Ascii("abc")), Hex("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")), "abc"); }
test sha384_empty { Assert.True(Same(Sha512.Hash384(Ascii("")), Hex("38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")), "empty"); }
test sha384_448 { Assert.True(Same(Sha512.Hash384(Ascii(Msg448())), Hex("3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b")), "448"); }
test sha384_896 { Assert.True(Same(Sha512.Hash384(Ascii(Msg896())), Hex("09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")), "896"); }
test sha512_incremental_split {
    u8[] m = Ascii(Msg896());
    mut i64 split = 0_i64;
    while split <= Slice.Len(m) {
        Sha512State s = Sha512.New384();
        Sha512.UpdateRange(s, m, 0_i64, split);
        Sha512.UpdateRange(s, m, split, Slice.Len(m) - split);
        Assert.True(Same(Sha512.Finish(s), Hex("09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")), "split");
        split = split + 13_i64;
    }
}
