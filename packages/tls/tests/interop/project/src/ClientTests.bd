use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Environment;
use Core.FS;
use Core.Time.Instant;
use Core.IO;
use Core.IO.IoError;
use Core.Optional.Option;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Time.TimerError;
use Codec.Hex;
use Network.Errors;
use Network.Tcp.TcpStream;
use Network.Types;
use Testing.Assert;
use Tls;
use Tls.Suites;
use Tls.TlsConfig;
use Tls.TlsErrors;
use Tls.TlsStream;
use X509.X509Errors;

// Beskid TLS client against `openssl s_server -www` (driven by tests/interop/run.sh).
// Environment: TLS_INTEROP_PORT, TLS_INTEROP_SUITE (4865/4866/4867), TLS_INTEROP_GROUP (29/23),
// TLS_INTEROP_ALPN (optional, expected protocol).

string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

unit Expect(i64 actual, string what) {
    if actual != 0_i64 { Assert.Fail(what + ": code " + Dec2(actual)); }
    return;
}

string Dec2(i64 v) {
    if v < 0_i64 { return "-" + Dec2(0_i64 - v); }
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec2(v / 10_i64) + String.DigitChar(v % 10_i64);
}

i64 EnvInt(string name, i64 fallback) {
    Option<string> v = Environment.TryGet(name);
    string text = Option.UnwrapOr<string>(v, "");
    i64 n = String.Len(text);
    if n == 0_i64 { return fallback; }
    mut i64 value = 0_i64;
    mut i64 i = 0_i64;
    while i < n { value = value * 10_i64 + (i64(String.ByteAt(text, i)) - 48_i64); i = i + 1_i64; }
    return value;
}

Option<Deadline> Soon() {
    Result<Deadline, TimerError> d = Deadline.After(Time.FromMilliseconds(30000_i64));
    return match d { Result::Ok(v) => Option.FromValue<Deadline>(v), Result::Error(_) => Option.Empty<Deadline>(), };
}

i64 Run() {
    i64 port = EnvInt("TLS_INTEROP_PORT", 44330_i64);
    i64 suite = EnvInt("TLS_INTEROP_SUITE", 4865_i64);
    i64 group = EnvInt("TLS_INTEROP_GROUP", 29_i64);
    string alpn = Option.UnwrapOr<string>(Environment.TryGet("TLS_INTEROP_ALPN"), "");
    Result<CertificateVerification, X509Error> trust = TlsConfig.Anchors(TlsConfig.Chain1(RootCertDer()));
    CertificateVerification mode = match trust { Result::Ok(m) => m, Result::Error(_) => TlsConfig.AcceptAnyCertificateForTestsOnly(), };
    TlsClientConfig c = TlsConfig.Client("localhost", mode);
    mut CipherSuite[] only = Array.Empty<CipherSuite>();
    Array.Append<CipherSuite>(only, Suites.FromCode(suite));
    c.cipherSuites = only;
    c.groups = [group];
    if String.Len(alpn) > 0_i64 {
        mut string[] offer = Array.Empty<string>();
        Array.Append<string>(offer, alpn);
        c.alpn = offer;
        c.alpnRequired = true;
    }
    SocketAddress target = SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(u8((port >> 8_i64) & 255_i64), u8(port & 255_i64)) };
    Result<TcpStream, NetworkError> connected = TcpStream.Connect(target, Network.Types.DefaultSocketOptions(), Soon());
    match connected {
        Result::Error(_) => { return 1_i64; },
        Result::Ok(tcp) => {
            Instant start = Time.MonotonicNow();
            Result<TlsStream, TlsError> tls = Tls.Connect(tcp, c, Soon());
            Instant end = Time.MonotonicNow();
            string timing = Option.UnwrapOr<string>(Environment.TryGet("TLS_INTEROP_TIMING"), "");
            if String.Len(timing) > 0_i64 { FS.WriteAllText(timing, Dec((end.nanos - start.nanos) / 1000000_i64)); }
            match tls {
                Result::Error(e) => { return TlsErrors.Code(e); },
                Result::Ok(s) => {
                    if String.Len(alpn) > 0_i64 && TlsStream.NegotiatedAlpn(s) != alpn { s.Close(); return 2_i64; }
                    if Suites.Code(TlsStream.NegotiatedSuite(s)) != suite { s.Close(); return 3_i64; }
                    // "GET / HTTP/1.0" CRLF CRLF
                    u8[] request = Hex.Of("474554202f20485454502f312e300d0a0d0a");
                    Result<unit, IoError> w = IO.WriteAll(s, request, 0_i64, Slice.Len(request));
                    match w { Result::Error(_) => { s.Close(); return 4_i64; }, Result::Ok(_) => {}, };
                    u8[] buf = Slice.New(12_i64);
                    Result<unit, IoError> r = IO.ReadExact(s, buf, 0_i64, 12_i64);
                    s.Close();
                    match r { Result::Error(_) => { return 5_i64; }, Result::Ok(_) => {}, };
                    // "HTTP/1.0 200"
                    if Slice.Compare(buf, Hex.Of("485454502f312e3020323030")) != 0_i64 { return 6_i64; }
                    return 0_i64;
                },
            };
        },
    };
}

unit RunInto(i64[] code) { code[0] = Run(); return; }

// Network operations run inside a spawned fiber.
test interop_client_against_openssl_s_server {
    i64[] code = [-1_i64];
    Fiber<unit> f = spawn (() => RunInto(code));
    f.Join();
    Expect(code[0], "Beskid client completes a request against openssl s_server");
}

// Test root generated with openssl (tests/interop/certs/ca.der).
pub u8[] RootCertDer() {
    string s = "3082019b30820141a00302010202143cc5b42faaa832daa7def808045536bbb6ddf944300a06082a8648ce3d040302301b3119301706035504030c104265736b6964205465737420526f6f74301e170d3236313030353131353130305a170d3336313030"
        + "323131353130305a301b3119301706035504030c104265736b6964205465737420526f6f743059301306072a8648ce3d020106082a8648ce3d030107034200048f4684a2e70c8677b376730c494a3546e98fb943810d320fcfffa26392a5110bc6e1f045"
        + "ac328a4017509ec27c8201c8e65d18f99bafb9e40ef52c7821d5d50aa3633061301d0603551d0e0416041446dda763d1978ccc27a6f76bd7519ff9619f4eb7301f0603551d2304183016801446dda763d1978ccc27a6f76bd7519ff9619f4eb7300f0603"
        + "551d130101ff040530030101ff300e0603551d0f0101ff040403020204300a06082a8648ce3d040302034800304502200c22ab56867a1fda253fb2c517682802dd87d91a6f152a0fd8ff2c4572d11bb2022100e8f98b28d498dfc5f8aae457d71cd4f433"
        + "94ab8ac6d6ca6d526e21bc35bd1e7a"
        ;
    return Hex.Of(s);
}
