use Core.Collections.Array;

pub type Header { pub string name, pub string value, }
pub type Limits { pub i64 maxStartLine, pub i64 maxHeaderBytes, pub i64 maxHeaders, pub i64 maxBodyBytes, }
pub Limits DefaultLimits() { return Limits { maxStartLine: 8192_i64, maxHeaderBytes: 65536_i64, maxHeaders: 128_i64, maxBodyBytes: 16777216_i64 }; }
/// Which framing rules of RFC 9112 section 6.3 apply to a message.
pub enum MessageRole { Request(), Response(), HeadResponse(), }
pub type Request { pub string method, pub string target, pub Header[] headers, pub u8[] body, }
/// `status` is a checked integer in 100..599; the parser and serializer reject any other value with InvalidStatus.
pub type Response { pub i64 status, pub string reason, pub Header[] headers, pub u8[] body, }
pub Request EmptyRequest(string method, string target) { return Request { method: method, target: target, headers: Array.Empty<Header>(), body: [] }; }
pub Response EmptyResponse(i64 status, string reason) { return Response { status: status, reason: reason, headers: Array.Empty<Header>(), body: [] }; }
