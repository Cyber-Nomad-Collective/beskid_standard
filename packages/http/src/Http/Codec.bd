                        Result::Error(error) => Result::Error(error),
                        Result::Ok(length) => {
                            if length == -2_i64 { return ChunkedEnd(bytes, end + 4_i64, limits); }
                            if length < 0_i64 { return Result::Ok(end + 4_i64); }
                            return Result::Ok(end + 4_i64 + length);
                        },
                    };
                },
            };
        },
    };
}
