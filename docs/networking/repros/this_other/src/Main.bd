// GAP: a type method calling a sibling method via `this.Other()` ICEs (CallExpression) when the test runs.
use Testing.Assert;

pub type C {
    i64 n,
    pub i64 A() { return this.n; }
    pub i64 B() { return this.A(); }
}

test this_dot_other {
    C c = C { n: 5_i64 };
    Assert.Equal<i64>(c.B(), 5_i64, "B via this.A()");
}
