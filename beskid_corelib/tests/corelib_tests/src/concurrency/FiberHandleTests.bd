/// Fiber handle runtime tests.
use Concurrency.Fiber;
use Concurrency.FiberError;
use Core.Results;
use Testing.Assert;

test invalid_fiber_join_returns_a_panicked_error {
    Fiber<i64> fiber = Fiber<i64> { handle: -1_i64 };
    Core.Results.Result<i64, FiberError> result = fiber.Join();
    match result {
        Result::Ok(_) => Assert.True(false, "invalid Fiber.Join must not return a value"),
        Result::Error(FiberError::Panicked(_, _)) => Assert.True(true, "invalid Fiber.Join is reported as panicked"),
        Result::Error(_) => Assert.True(false, "invalid Fiber.Join must use the panicked status"),
    };
}

test invalid_fiber_cancel_and_detach_are_safe_no_ops {
    Fiber<i64> fiber = Fiber<i64> { handle: -1_i64 };
    fiber.Cancel();
    fiber.Cancel();
    fiber.Detach();
}
