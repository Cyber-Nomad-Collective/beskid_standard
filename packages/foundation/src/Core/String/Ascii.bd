/// Core.String.Ascii — ASCII byte classes, digit values, and byte case mapping.
/// @tier(supported)
/// Every text module classifies bytes through these functions instead of comparing code points
/// inline. Bytes above 127 belong to no class and map to themselves.

/// `0-9`.
pub bool IsDigit(u8 b) {
    return b >= 48 && b <= 57;
}

/// `a-z`.
pub bool IsLower(u8 b) {
    return b >= 97 && b <= 122;
}

/// `A-Z`.
pub bool IsUpper(u8 b) {
    return b >= 65 && b <= 90;
}

/// `A-Z` or `a-z`.
pub bool IsAlpha(u8 b) {
    return IsLower(b) || IsUpper(b);
}

/// `A-Z`, `a-z`, or `0-9`.
pub bool IsAlphanumeric(u8 b) {
    return IsAlpha(b) || IsDigit(b);
}

/// Value `0..=15` of a hexadecimal digit (`0-9`, `a-f`, `A-F`), or `-1` for any other byte.
pub i64 HexValue(u8 b) {
    if IsDigit(b) {
        return i64(b) - 48;
    }
    if b >= 97 && b <= 102 {
        return i64(b) - 87;
    }
    if b >= 65 && b <= 70 {
        return i64(b) - 55;
    }
    return -1;
}

/// `0-9`, `a-f`, or `A-F`.
pub bool IsHexDigit(u8 b) {
    return HexValue(b) >= 0;
}

/// Space, tab, carriage return, or line feed.
pub bool IsWhitespace(u8 b) {
    return b == 32 || b == 9 || b == 13 || b == 10;
}

/// Identifier bytes: `A-Z`, `a-z`, and `_` anywhere, plus `0-9` after the first byte.
pub bool IsIdentifierByte(u8 b, bool first) {
    if IsAlpha(b) || b == 95 {
        return true;
    }
    return !first && IsDigit(b);
}

/// Maps `A-Z` to `a-z`; every other byte is returned unchanged.
pub u8 ToLower(u8 b) {
    if IsUpper(b) {
        return u8(i64(b) + 32);
    }
    return b;
}

/// Maps `a-z` to `A-Z`; every other byte is returned unchanged.
pub u8 ToUpper(u8 b) {
    if IsLower(b) {
        return u8(i64(b) - 32);
    }
    return b;
}
