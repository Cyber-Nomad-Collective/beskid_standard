use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Crypto.Errors;

/// AES-128/192/256 block encryption (FIPS 197), table-based ("T-table") implementation.
///
/// Constant-time limitation: table lookups are indexed by secret state bytes, so the
/// access pattern depends on key and data and can leak through cache timing to a
/// co-located attacker. Acceptable for the current scope; a bitsliced or
/// hardware-backed implementation should replace it before AES is a default cipher.
/// ChaCha20-Poly1305 has no such lookups.
pub type AesKey {
    u32[] roundKeys,
    i64 rounds,
    u32[] t0,
    u32[] t1,
    u32[] t2,
    u32[] t3,
    u8[] sbox,
}

