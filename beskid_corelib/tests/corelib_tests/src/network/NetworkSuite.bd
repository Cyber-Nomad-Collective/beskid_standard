Result<unit, NetworkError> SlotReuseResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    UdpSocket previous = UdpSocket.Bind(bindAddress)?;
    previous.Close()?;
    UdpSocket current = UdpSocket.Bind(bindAddress)?;
    Assert.True(match (previous.LocalAddress())
    {
        Result::Error(NetworkError::Closed) => true,
        _ => false,
    }, "stale generation cannot address replacement socket");
    previous.Close()?;
    SocketAddress address = current.LocalAddress()?;
    Assert.True(address.port.Value() > 0_i64, "stale close cannot release replacement socket");
    current.Close()?;
    return Result::Ok(());
}

test NetworkClosedResourceCannotReachAReusedSlot
{
    match (SlotReuseResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("slot reuse completes without a NetworkError"),
    };
}

// Binds until the runtime reports exhaustion. state[0] records the live count,
// state[1] the successful rebind after one close, state[2] the stop reason.
Result<unit, NetworkError> ExhaustionResult(SocketAddress address, i64[] state)
{
    List<UdpSocket> held = List.New<UdpSocket>();
    mut i64 stop = 0_i64;
    while (stop == 0_i64 && held.Count() <= 256_i64)
    {
        match (UdpSocket.Bind(address))
        {
            Result::Ok(socket) => {
                held.Push(socket);
            },
            Result::Error(NetworkError::ResourceExhausted) => {
                stop = 1_i64;
            },
            Result::Error(_) => {
                stop = 2_i64;
            },
        };
    }
    state[0] = held.Count();
    state[2] = stop;
    if (stop == 1_i64 && held.Count() > 0_i64)
    {
        match (held.Get(held.Count() - 1_i64))
        {
            Result::Ok(last) => {
                last.Close()?;
            },
            Result::Error(_) => Assert.Fail("the last live socket is held"),
        };
        held.Pop();
        UdpSocket replacement = UdpSocket.Bind(address)?;
        held.Push(replacement);
        state[1] = 1_i64;
    }
    mut i64 index = 0_i64;
    while (index < held.Count())
    {
        match (held.Get(index))
        {
            Result::Ok(socket) => {
                socket.Close()?;
            },
            Result::Error(_) => Assert.Fail("every live socket is held"),
        };
        index = index + 1_i64;
    }
    return Result::Ok(());
}

Result<unit, NetworkError> BindAndClose(SocketAddress address)
{
    UdpSocket socket = UdpSocket.Bind(address)?;
    socket.Close()?;
    return Result::Ok(());
}

test NetworkUdpExhaustionIsTyped
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    i64[] state = [0_i64, 0_i64, 0_i64];
    match (ExhaustionResult(bindAddress, state))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("exhaustion fixture releases every socket"),
    };
    Assert.Equal(state[2], 1_i64, "exhaustion is reported as ResourceExhausted");
    Assert.True(state[0] > 0_i64 && state[0] <= 256_i64, "exhaustion occurs at or before the slot count");
    Assert.Equal(state[1], 1_i64, "closing one live socket admits the next bind");
    match (BindAndClose(bindAddress))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("every exhausted socket was released"),
    };
}

Result<unit, NetworkError> UdpExpiredReceiveRecoversResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    match (Deadline.After(Time.FromMilliseconds(0_i64)))
    {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(expired) => match (receiver.ReceiveFrom(1_i64, Option.FromValue<Deadline>(expired)))
        {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an empty UDP receive times out at its expired deadline"),
        },
    };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    u8[] payload = [73_u8];
    sender.SendTo(payload, target, Option.Empty<Deadline>())?;
    Datagram datagram = receiver.ReceiveFrom(1_i64, Option.Empty<Deadline>())?;
    Assert.Equal(datagram.payload[0], 73_u8, "socket accepts a datagram after its receive timeout");
    Assert.Equal(payload[0], 73_u8, "timed operations retain caller-owned payloads");
    sender.Close()?;
    receiver.Close()?;
    return Result::Ok(());
}

unit UdpExpiredReceiveRecovers()
{
    match (UdpExpiredReceiveRecoversResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP timeout recovery completes without a NetworkError"),
    };
}

test NetworkUdpExpiredReceiveDeadlineTimesOutAndSocketRecovers
{
    Fiber<unit> scenario = spawn UdpExpiredReceiveRecovers();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "UDP timeout recovery scenario completes");
}

Result<unit, NetworkError> UdpExpiredSendKeepsPayloadResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    UdpSocket sender = UdpSocket.Bind(bindAddress)?;
    UdpSocket receiver = UdpSocket.Bind(bindAddress)?;
    SocketAddress target = receiver.LocalAddress()?;
    u8[] payload = [41_u8, 42_u8];
    match (Deadline.After(Time.FromMilliseconds(0_i64)))
    {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(expired) => match (sender.SendTo(payload, target, Option.FromValue<Deadline>(expired)))
        {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an expired UDP send returns TimedOut before submission"),
        },
    };
    Assert.Equal(payload[0], 41_u8, "timed-out send leaves caller payload intact");
    Assert.Equal(payload[1], 42_u8, "timed-out send retains the full caller payload");
    match (Deadline.After(Time.FromMilliseconds(100_i64)))
    {
        Result::Error(_) => Assert.Fail("short duration creates a typed receive deadline"),
        Result::Ok(receiveDeadline) => match (receiver.ReceiveFrom(2_i64, Option.FromValue<Deadline>(receiveDeadline)))
        {
            Result::Error(NetworkError::TimedOut) => (),
            _ => Assert.Fail("an expired send does not deliver a datagram"),
        },
    };
    sender.SendTo(payload, target, Option.Empty<Deadline>())?;
    Datagram delivered = receiver.ReceiveFrom(2_i64, Option.Empty<Deadline>())?;
    Assert.Equal(delivered.payload[0], 41_u8, "the caller can resend its payload after timeout");
    Assert.Equal(delivered.payload[1], 42_u8, "the resent payload is complete");
    sender.Close()?;
    receiver.Close()?;
    return Result::Ok(());
}

unit UdpExpiredSendKeepsPayload()
{
    match (UdpExpiredSendKeepsPayloadResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("UDP send timeout scenario completes without another NetworkError"),
    };
}

test NetworkUdpExpiredSendKeepsUnsentPayloadAndSocket
{
    Fiber<unit> scenario = spawn UdpExpiredSendKeepsPayload();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "UDP send timeout scenario completes");
}

// ---- Scope ----

Result<unit, NetworkError> ScopedListener(SocketAddress address)
{
    use TcpListener listener = TcpListener.Bind(address, 1_i64)?;
    return Result::Ok(());
}

test NetworkTcpDisposableUsesFoundationCleanupConversion
{
    SocketAddress address = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    Assert.True(match (ScopedListener(address))
    {
        Result::Ok(_) => true,
        _ => false,
    }, "scoped listener uses the explicit cleanup conversion");
}

// ---- Shutdown Leak ----

// BSP-REQ-8A21D67C43FE: closing a network resource releases its native socket
// at most once, and a duplicate close neither leaks nor double-closes. This
// exercises that against the runtime's fixed 256-slot socket table: enough
// open/close cycles to exceed the table size, each cycle closing twice. If a
// close ever failed to free its slot, the table would fill and a later Bind
// would fail with ResourceExhausted well before the loop finishes. Assertions
// only observe typed Results and port numbers -- no descriptor, handle, or
// platform constant is read or asserted on.

Result<unit, NetworkError> ShutdownLeakAuditResult()
{
    i64 leakAuditCycles = 600_i64; // exceeds the runtime's fixed 256-slot socket table
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    mut i64 cycle = 0_i64;
    while (cycle < leakAuditCycles)
    {
        UdpSocket socket = UdpSocket.Bind(bindAddress)?;
        Assert.True(socket.LocalAddress()?.port.Value() != 0_i64, "each cycle's socket is live before it closes");
        Assert.True(match (socket.Close())
        {
            Result::Ok(_) => true,
            _ => false,
        }, "first close in the cycle succeeds and releases the slot");
        Assert.True(match (socket.Close())
        {
            Result::Ok(_) => true,
            _ => false,
        }, "duplicate close in the cycle is safe: no double-close, no leak");
        cycle = cycle + 1_i64;
    }

    // A fresh socket still binds after every cycle: the slot table is exactly
    // as free as it started, proving no slot was leaked across leakAuditCycles
    // open/close pairs even though that number exceeds the 256-slot table.
    UdpSocket fresh = UdpSocket.Bind(bindAddress)?;
    Assert.True(fresh.LocalAddress()?.port.Value() != 0_i64, "post-cycle bind still succeeds");
    Assert.True(match (fresh.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "post-cycle socket closes cleanly");
    return Result::Ok(());
}

test NetworkShutdownIsIdempotentAndRepeatedCyclesDoNotLeakSlots
{
    match (ShutdownLeakAuditResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("shutdown leak audit completes without a NetworkError (a leak would surface as ResourceExhausted)"),
    };
}

// ---- Disposable ----

// BSP-REQ-4E7D12C9B6A0: TcpStream implements Foundation Core.Disposable and
// Core.IO.Stream. A stream used after Dispose() must fail closed with the
// existing typed IoError (not panic, not silently succeed); Dispose() itself
// must be idempotent; and a fresh stream must still work afterward.

Result<unit, NetworkError> ServeOnceResult(TcpListener listener)
{
    TcpStream accepted = listener.Accept(Option.Empty<Deadline>())?;
    Assert.True(match (accepted.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server closes its side");
    listener.Close()?;
    return Result::Ok(());
}

unit ServeOnce(TcpListener listener)
{
    match (ServeOnceResult(listener))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server completes without a NetworkError"),
    };
}

Result<unit, NetworkError> DisposedStreamFailsClosedResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Fiber<unit> server = spawn (() => ServeOnce(listener));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;

    Assert.True(match (client.Dispose())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "Dispose succeeds");

    u8[] bytes = Slice.New(1_i64);
    Assert.True(match (client.Read(bytes, 0_i64, 1_i64))
    {
        Result::Error(IoError::ReadFailed(TransferFailure::Closed)) => true,
        _ => false,
    }, "Read after Dispose fails closed with the typed Foundation IoError, not a panic");
    Assert.True(match (client.Write(bytes, 0_i64, 1_i64))
    {
        Result::Error(IoError::WriteFailed(TransferFailure::Closed)) => true,
        _ => false,
    }, "Write after Dispose fails closed with the typed Foundation IoError, not a panic");

    Assert.True(match (client.Dispose())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "Dispose is idempotent: a second call still succeeds");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "the Closer contract stays idempotent after Dispose too");

    match (server.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server exits without a leak"),
    };
    return Result::Ok(());
}

unit DisposedStreamFailsClosed()
{
    match (DisposedStreamFailsClosedResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("disposed-stream scenario completes without a NetworkError"),
    };
}

test NetworkTcpStreamAfterDisposeFailsClosedAndDisposeIsIdempotent
{
    Fiber<unit> scenario = spawn DisposedStreamFailsClosed();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("disposed-stream scenario completes"),
    };
}

Result<unit, NetworkError> FreshStreamAfterDisposeResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener firstListener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress firstAddress = firstListener.LocalAddress()?;
    Fiber<unit> firstServer = spawn (() => ServeOnce(firstListener));
    TcpStream disposedClient = TcpStream.Connect(firstAddress, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Assert.True(match (disposedClient.Dispose())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "first stream disposed");
    match (firstServer.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("first server exits"),
    };

    // A brand-new stream (and its listener) still works normally after the
    // previous one was disposed: Dispose does not corrupt shared runtime state.
    TcpListener secondListener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress secondAddress = secondListener.LocalAddress()?;
    Fiber<unit> secondServer = spawn (() => ServeOnce(secondListener));
    TcpStream freshClient = TcpStream.Connect(secondAddress, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Assert.True(freshClient.LocalAddress()?.port.Value() != 0_i64, "fresh stream after a prior Dispose is fully usable");
    Assert.True(match (freshClient.Dispose())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "fresh stream disposes cleanly too");
    match (secondServer.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("second server exits"),
    };
    return Result::Ok(());
}

unit FreshStreamAfterDispose()
{
    match (FreshStreamAfterDisposeResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("fresh-stream-after-dispose scenario completes without a NetworkError"),
    };
}

test NetworkTcpFreshStreamWorksAfterAPriorDispose
{
    Fiber<unit> scenario = spawn FreshStreamAfterDispose();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("fresh-stream-after-dispose scenario completes"),
    };
}

// ---- Network waits in the root fiber park like in any other fiber ----

test ResolveInTheRootFiberParksInsteadOfFailing
{
    ResolveIpv4();
}

unit CountTicks(i64[] ticks)
{
    Concurrency.Yield();
    Array.Set<i64>(ticks, 0_i64, Array.Get<i64>(ticks, 0_i64) + 1_i64);
    return;
}

test SleepInTheRootFiberRunsOtherFibers
{
    i64[] ticks = [0_i64];
    Fiber<unit> counter = spawn (() => CountTicks(ticks));
    match (Time.Sleep(Time.FromMilliseconds(20_i64)))
    {
        Result::Ok(_) => Assert.True(true, "the root sleep ends at its deadline"),
        Result::Error(_) => Assert.Fail("Sleep in the root fiber must park, not fail"),
    };
    Assert.Equal(Array.Get<i64>(ticks, 0_i64), 1_i64, "the spawned fiber ran while the root slept");
    counter.Detach();
}
