//! `NetworkSuite`: the network tests of corelib_tests in one target, so the matrix lowers
//! the network closure once. Sections group the tests by area.

use Core.Disposable;
use Core.Bytes.Slice;
use Core.Results;
use Network.Types;
use Network.Errors;
use Testing.Assert;
use Core.Collections.Array;
use Concurrency.Fiber;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Network.Dns;
use Concurrency;
use Concurrency.Channel;
use Concurrency.TryResult;
use Concurrency.WaitGroup;
use Core.IO;
use Core.IO.Stream;
use Core.IO.IoError;
use Core.IO.TransferFailure;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Network.Udp.UdpSocket;
use Core.Collections.List;

// ---- Types ----

test NetworkIpv4AndIpv6ValuesKeepBoundedPorts
{
    SocketAddress v4 = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    SocketAddress v6 = SocketAddress
    {
        address: IpAddress::V6(0_u32, 0_u32, 0_u32, 1_u32),
        port: Network.Types.PortBytes(255_u8, 255_u8),
    };
    Assert.Equal(v4.port.Value(), 0_i64, "bind permits an OS-selected port");
    Assert.Equal(v6.port.Value(), 65535_i64, "largest portable port");
    bool loopback = match (v6.address)
    {
        IpAddress::V6(_, _, _, last) => last == 1_u32,
        _ => false,
    };
    Assert.True(loopback, "IPv6 address groups survive the typed value");
}

test NetworkDatagramKeepsSourceAndTruncation
{
    SocketAddress source = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(1_u8, 187_u8),
    };
    Datagram value = Datagram
    {
        payload: [7_u8, 8_u8],
        source: source,
        truncated: true,
    };
    Assert.Equal(Slice.Len(value.payload), 2_i64, "one owned payload");
    Assert.Equal(value.source.port.Value(), 443_i64, "source metadata");
    Assert.True(value.truncated, "truncation remains visible");
}

test NetworkCleanupConversionIsExplicitAndPortable
{
    NetworkError error = Network.Errors.FromDisposeError(DisposeError::Failed);
    Assert.True(match (error)
    {
        NetworkError::CleanupFailed => true,
        _ => false,
    }, "cleanup maps only through the declared conversion");
    SocketOptions options = Network.Types.DefaultSocketOptions();
    Assert.False(options.noDelay, "default option has no native flag");
    Assert.False(options.keepAlive, "default option is portable");
}

// Exhaustive matching makes additions to the closed error vocabulary reviewable.
i64 ErrorOrdinal(NetworkError error)
{
    return match (error)
    {
        NetworkError::AddressInUse => 1_i64,
        NetworkError::AddressNotAvailable => 2_i64,
        NetworkError::ConnectionAborted => 3_i64,
        NetworkError::ConnectionRefused => 4_i64,
        NetworkError::ConnectionReset => 5_i64,
        NetworkError::HostNotFound => 6_i64,
        NetworkError::InvalidAddress => 7_i64,
        NetworkError::MessageTooLarge => 8_i64,
        NetworkError::NetworkDown => 9_i64,
        NetworkError::NotConnected => 10_i64,
        NetworkError::PermissionDenied => 11_i64,
        NetworkError::TimedOut => 12_i64,
        NetworkError::Cancelled => 13_i64,
        NetworkError::Closed => 14_i64,
        NetworkError::Busy => 15_i64,
        NetworkError::CleanupFailed => 16_i64,
        NetworkError::Unsupported => 17_i64,
        NetworkError::ResourceExhausted => 18_i64,
    };
}

test NetworkErrorUnionHasNoNativePayload
{
    Assert.Equal(ErrorOrdinal(NetworkError::Busy), 15_i64, "portable admission failure");
    Assert.Equal(ErrorOrdinal(NetworkError::Unsupported), 17_i64, "closed error vocabulary");
    Assert.Equal(ErrorOrdinal(NetworkError::ResourceExhausted), 18_i64, "exhaustion is distinct from NetworkDown");
}

test NetworkPortsRejectOutOfRangeNumbers
{
    Assert.True(match (Network.Types.PortNumber(-1_i64))
    {
        Result::Error(NetworkError::InvalidAddress) => true,
        _ => false,
    }, "negative port has no value");
    Assert.True(match (Network.Types.PortNumber(65536_i64))
    {
        Result::Error(NetworkError::InvalidAddress) => true,
        _ => false,
    }, "oversized port has no value");
    match (Network.Types.PortNumber(65535_i64))
    {
        Result::Ok(port) => Assert.Equal(port.Value(), 65535_i64, "maximum port is representable"),
        Result::Error(_) => Assert.Fail("valid bounded port"),
    };
}

// ---- Dns ----

unit ResolveIpv4()
{
    Result<SocketAddress[], NetworkError> result = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 80_u8), Option::Some(AddressFamily::V4), Option.Empty<Deadline>());
    match (result)
    {
        Result::Error(_) => Assert.Fail("numeric IPv4 resolution must succeed"),
        Result::Ok(addresses) => {
            Assert.True(Array.Len<SocketAddress>(addresses) > 0_i64, "resolver returns all matching results");
            mut i64 index = 0_i64;
            while (index < Array.Len<SocketAddress>(addresses))
            {
                SocketAddress address = addresses[index];
                Assert.Equal(address.port.Value(), 80_i64, "requested port survives resolution");
                Assert.True(match (address.address)
                {
                    IpAddress::V4(_, _, _, _) => true,
                    _ => false,
                }, "family filter excludes IPv6");
                index = index + 1_i64;
            }
        },
    };
}

test NetworkDnsIpv4FilterPreservesTypedAddresses
{
    Fiber<unit> scenario = spawn ResolveIpv4();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "resolver scenario completes");
}

test NetworkDnsPortZeroIsRejectedBeforeResolving
{
    Result<SocketAddress[], NetworkError> result = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 0_u8), Option::None, Option.Empty<Deadline>());
    Assert.True(match (result)
    {
        Result::Error(NetworkError::InvalidAddress) => true,
        _ => false,
    }, "port zero is reserved for binding");
}

unit ResolveTwice()
{
    Result<SocketAddress[], NetworkError> first = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 81_u8), Option::None, Option.Empty<Deadline>());
    Result<SocketAddress[], NetworkError> second = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 82_u8), Option::None, Option.Empty<Deadline>());
    match (first)
    {
        Result::Error(_) => Assert.Fail("first independent resolver call"),
        Result::Ok(addresses) => Assert.Equal(addresses[0].port.Value(), 81_i64, "first result retains its own port"),
    };
    match (second)
    {
        Result::Error(_) => Assert.Fail("second independent resolver call"),
        Result::Ok(addresses) => Assert.Equal(addresses[0].port.Value(), 82_i64, "second call has fresh results"),
    };
}

test NetworkDnsRepeatedCallsReturnIndependentlyOwnedResults
{
    Fiber<unit> scenario = spawn ResolveTwice();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "independent resolver scenario completes");
}

unit ResolveWithExpiredDeadline()
{
    match (Deadline.After(Time.FromMilliseconds(0_i64)))
    {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(deadline) => {
            Result<SocketAddress[], NetworkError> result = Dns.Resolve("127.0.0.1", Network.Types.PortBytes(0_u8, 53_u8), Option::Some(AddressFamily::V4), Option.FromValue<Deadline>(deadline));
            Assert.True(match (result)
            {
                Result::Error(NetworkError::TimedOut) => true,
                _ => false,
            }, "already expired DNS deadline wins before resolver submission");
        },
    };
}

test NetworkDnsExpiredTypedDeadlineTimesOutBeforeSubmission
{
    Fiber<unit> scenario = spawn ResolveWithExpiredDeadline();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "DNS deadline scenario completes");
}

// ---- Tcp ----

Result<unit, NetworkError> ServeResult(TcpListener listener)
{
    TcpStream accepted = listener.Accept(Option.Empty<Deadline>())?;
    u8[] bytes = [11_u8, 22_u8, 33_u8];
    Result<unit, IoError> written = IO.WriteAll(accepted, bytes, 0_i64, 3_i64);
    Assert.True(match (written)
    {
        Result::Ok(_) => true,
        _ => false,
    }, "TCP reuses Foundation WriteAll");
    accepted.ShutdownWrite()?;
    Assert.True(match (accepted.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "accepted close");
    listener.Close()?;
    return Result::Ok(());
}

unit Serve(TcpListener listener)
{
    match (ServeResult(listener))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("TCP server completes without a NetworkError"),
    };
}

i64 ReadStream(Stream stream, u8[] bytes)
{
    return match (stream.Read(bytes, 0_i64, 1_i64))
    {
        Result::Ok(count) => count,
        Result::Error(_) => -1_i64,
    };
}

Result<unit, NetworkError> TcpLoopbackResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Assert.True(address.port.Value() != 0_i64, "OS-selected port is reported");
    Fiber<unit> server = spawn (() => Serve(listener));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    u8[] bytes = Slice.New(3_i64);
    Result<unit, IoError> read = IO.ReadExact(client, bytes, 0_i64, 3_i64);
    Assert.True(match (read)
    {
        Result::Ok(_) => true,
        _ => false,
    }, "TCP reuses Foundation ReadExact");
    Assert.Equal(bytes[2], 33_u8, "full transfer retained final byte");
    Assert.Equal(ReadStream(client, bytes), 0_i64, "half-close delivers Foundation EOF");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "first close succeeds");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "duplicate close is idempotent");
    match (server.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server exits without a leak"),
    };
    return Result::Ok(());
}

unit TcpLoopback()
{
    match (TcpLoopbackResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("TCP loopback completes without a NetworkError"),
    };
}

test NetworkTcpReusesStreamTransferEofAndIdempotentClose
{
    Fiber<unit> scenario = spawn TcpLoopback();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("TCP loopback scenario completes"),
    };
}

test NetworkTcpInvalidBacklogHasTypedError
{
    SocketAddress address = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    Result<TcpListener, NetworkError> result = TcpListener.Bind(address, 0_i64);
    Assert.True(match (result)
    {
        Result::Error(NetworkError::InvalidAddress) => true,
        _ => false,
    }, "invalid bind is rejected before effects");
}

i64 CauseCode(TransferFailure cause)
{
    return match (cause)
    {
        TransferFailure::Busy => -1_i64,
        TransferFailure::PeerReset => -2_i64,
        TransferFailure::TimedOut => -6_i64,
        TransferFailure::Closed => -7_i64,
        _ => -3_i64,
    };
}

// A non-negative code is a completed count; a negative code names the failure cause.
i64 ReadCode(Result<i64, IoError> result)
{
    return match (result)
    {
        Result::Ok(count) => count,
        Result::Error(IoError::ReadFailed(cause)) => CauseCode(cause),
        Result::Error(_) => -4_i64,
    };
}

i64 ReadOne(TcpStream stream)
{
    u8[] bytes = Slice.New(1_i64);
    return ReadCode(stream.Read(bytes, 0_i64, 1_i64));
}

Result<unit, NetworkError> DelayedServeResult(TcpListener listener)
{
    TcpStream accepted = listener.Accept(Option.Empty<Deadline>())?;
    match (Time.Sleep(Time.FromMilliseconds(100_i64)))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server delay completes"),
    };
    Result<unit, IoError> written = IO.WriteAll(accepted, [7_u8], 0_i64, 1_i64);
    Assert.True(match (written)
    {
        Result::Ok(_) => true,
        _ => false,
    }, "delayed server writes one byte");
    Assert.True(match (accepted.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "delayed server closes");
    listener.Close()?;
    return Result::Ok(());
}

unit DelayedServe(TcpListener listener)
{
    match (DelayedServeResult(listener))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("delayed server completes without a NetworkError"),
    };
}

Result<unit, NetworkError> SecondReadResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Fiber<unit> server = spawn (() => DelayedServe(listener));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Fiber<i64> first = spawn (() => ReadOne(client));
    Concurrency.Yield();
    Concurrency.Yield();
    i64 second = ReadOne(client);
    i64 firstCode = match (first.Join())
    {
        Result::Ok(code) => code,
        Result::Error(_) => -5_i64,
    };
    Assert.True((firstCode == -1_i64 && second == 1_i64) || (firstCode == 1_i64 && second == -1_i64), "a second same-direction read reports ReadFailed(Busy)");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "client closes");
    match (server.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("delayed server exits"),
    };
    return Result::Ok(());
}

unit SecondRead()
{
    match (SecondReadResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("second-read scenario completes without a NetworkError"),
    };
}

test NetworkTcpSecondReadReportsBusyCause
{
    Fiber<unit> scenario = spawn SecondRead();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("second-read scenario completes"),
    };
}

Result<unit, NetworkError> TypedDeadlineReadRecoversResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Fiber<unit> server = spawn (() => DelayedServe(listener));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    match (Deadline.After(Time.FromMilliseconds(0_i64)))
    {
        Result::Ok(expired) => {
            TransferDeadlines policy = TransferDeadlines
            {
                read: Option.FromValue<Deadline>(expired),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(policy))
            {
                Result::Ok(_) => true,
                Result::Error(_) => false,
            }, "typed read deadline is accepted");
            u8[] bytes = [0_u8];
            match (client.Read(bytes, 0_i64, 1_i64))
            {
                Result::Error(IoError::ReadFailed(TransferFailure::TimedOut)) => (),
                _ => Assert.Fail("expired typed read returns TimedOut"),
            };
            TransferDeadlines cleared = TransferDeadlines
            {
                read: Option.Empty<Deadline>(),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(cleared))
            {
                Result::Ok(_) => true,
                Result::Error(_) => false,
            }, "clearing typed policy succeeds");
            match (client.Read(bytes, 0_i64, 1_i64))
            {
                Result::Ok(count) => Assert.Equal(count, 1_i64, "read succeeds after deadline clear"),
                Result::Error(_) => Assert.Fail("read remains usable after deadline clear"),
            };
            Assert.Equal(bytes[0], 7_u8, "later read receives peer data");
        },
        Result::Error(_) => Assert.Fail("zero duration creates a checked deadline"),
    };
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "deadline client closes");
    match (server.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("deadline server completes"),
    };
    return Result::Ok(());
}

unit TypedDeadlineReadRecovers()
{
    match (TypedDeadlineReadRecoversResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("typed deadline scenario completes without NetworkError"),
    };
}

test NetworkTcpTypedReadDeadlineTimesOutAndRecovers
{
    Fiber<unit> scenario = spawn TypedDeadlineReadRecovers();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("typed deadline scenario completes"),
    };
}

Result<unit, NetworkError> ServeAfterClearResult(TcpListener listener, Channel<i64> release)
{
    TcpStream accepted = listener.Accept(Option.Empty<Deadline>())?;
    match (Channel<i64>.Receive(release))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server receives release after read deadline clear"),
    };
    Assert.True(match (IO.WriteAll(accepted, [9_u8], 0_i64, 1_i64))
    {
        Result::Ok(_) => true,
        _ => false,
    }, "released server writes one byte");
    Assert.True(match (accepted.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "released server closes");
    listener.Close()?;
    return Result::Ok(());
}

unit ServeAfterClear(TcpListener listener, Channel<i64> release)
{
    match (ServeAfterClearResult(listener, release))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("released server completes"),
    };
}

Result<unit, NetworkError> PendingReadClearResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Channel<i64> release = Channel<i64>.Create();
    Fiber<unit> server = spawn (() => ServeAfterClear(listener, release));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Fiber<i64> pending = spawn (() => ReadOne(client));
    Concurrency.Yield();
    Concurrency.Yield();
    Assert.Equal(ReadOne(client), -1_i64, "second read proves the first read is pending");
    match (Deadline.After(Time.FromMilliseconds(20_i64)))
    {
        Result::Ok(deadline) => {
            TransferDeadlines armed = TransferDeadlines
            {
                read: Option.FromValue<Deadline>(deadline),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(armed))
            {
                Result::Ok(_) => true,
                _ => false,
            }, "pending read accepts typed deadline");
            TransferDeadlines cleared = TransferDeadlines
            {
                read: Option.Empty<Deadline>(),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(cleared))
            {
                Result::Ok(_) => true,
                _ => false,
            }, "pending read deadline clears");
        },
        Result::Error(_) => Assert.Fail("positive duration creates a checked deadline"),
    };
    match (Time.Sleep(Time.FromMilliseconds(50_i64)))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("wait past cleared deadline completes"),
    };
    Assert.True(match (Channel<i64>.Send(release, 1_i64))
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server is released after old deadline");
    i64 pendingCode = match (pending.Join())
    {
        Result::Ok(code) => code,
        Result::Error(_) => -5_i64,
    };
    Assert.Equal(pendingCode, 1_i64, "pending read completes from peer readiness after deadline clear");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "client closes after pending read");
    match (server.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("released server exits"),
    };
    Channel<i64>.Close(release);
    return Result::Ok(());
}

unit PendingReadClear()
{
    match (PendingReadClearResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("pending read deadline clear completes without NetworkError"),
    };
}

test NetworkTcpPendingTypedReadDeadlineClearPreservesReadiness
{
    Fiber<unit> scenario = spawn PendingReadClear();
    match (scenario.Join())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("pending read deadline clear scenario completes"),
    };
}

Result<unit, NetworkError> CloseServerOnReleaseResult(TcpListener listener, Channel<i64> release)
{
    TcpStream accepted = listener.Accept(Option.Empty<Deadline>())?;
    match (Channel<i64>.Receive(release))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server receives release after client read settles"),
    };
    Assert.True(match (accepted.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server closes accepted stream after release");
    listener.Close()?;
    return Result::Ok(());
}

unit CloseServerOnRelease(TcpListener listener, Channel<i64> release)
{
    match (CloseServerOnReleaseResult(listener, release))
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("server closes after client read settles"),
    };
}

Result<unit, NetworkError> PendingReadTimeoutResult()
{
    SocketAddress bindAddress = SocketAddress
    {
        address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8),
        port: Network.Types.PortBytes(0_u8, 0_u8),
    };
    TcpListener listener = TcpListener.Bind(bindAddress, 8_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    Channel<i64> release = Channel<i64>.Create();
    Fiber<unit> server = spawn (() => CloseServerOnRelease(listener, release));
    TcpStream client = TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Option.Empty<Deadline>())?;
    Fiber<i64> pending = spawn (() => ReadOne(client));
    Concurrency.Yield();
    Concurrency.Yield();
    Assert.Equal(ReadOne(client), -1_i64, "second read proves the first read is pending");
    match (Deadline.After(Time.FromMilliseconds(0_i64)))
    {
        Result::Ok(expired) => {
            TransferDeadlines policy = TransferDeadlines
            {
                read: Option.FromValue<Deadline>(expired),
                write: Option.Empty<Deadline>(),
            };
            Assert.True(match (client.SetDeadlines(policy))
            {
                Result::Ok(_) => true,
                _ => false,
            }, "expired typed policy reaches the pending read");
        },
        Result::Error(_) => Assert.Fail("zero duration creates a typed read deadline"),
    };
    i64 timedCode = match (pending.Join())
    {
        Result::Ok(code) => code,
        Result::Error(_) => -5_i64,
    };
    Assert.Equal(timedCode, -6_i64, "pending read reports exactly one TimedOut result");
    Assert.True(match (client.Close())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "client closes after timeout");
    Assert.True(match (Channel<i64>.Send(release, 1_i64))
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server is released after timeout");
    Assert.True(match (server.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "server exits after timeout");
    Channel<i64>.Close(release);
    return Result::Ok(());
}

unit PendingReadTimeout()
{
