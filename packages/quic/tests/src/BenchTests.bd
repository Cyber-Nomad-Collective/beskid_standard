/// QUIC stream throughput and handshake latency over UDP loopback (see
/// docs/networking/BENCHMARKS.md). The client writes 2 MiB on one bidirectional stream in
/// 4 KiB writes from one reused buffer (runtime array limit HQ3); the server reads into one
/// reused 4 KiB buffer. Endpoints, drivers and the reader are fibers of one process on one
/// thread. Each mode forces the crypto provider (ruling R27) before the connection: packet
/// protection keys keep the provider they were created with; header protection is always
/// the pure AES block.
use Testing.Assert;
use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Output;
use Core.Results;
use Core.String;
use Crypto.Provider;
use Network.Types;
use Quic.QuicConfig;
use Quic.QuicEndpoint;
use Quic.QuicErrors;
use Codec.Hex;
use Tls.PeerKeys;
use Tls.TlsConfig;

string Dec(i64 v) {
    if v < 0_i64 { return "-" + Dec(0_i64 - v); }
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

unit Throughput(string name, i64 bytes, i64 nanos) {
    i64 safe = nanos + 1_i64;
    i64 centi = bytes * 100000_i64 / safe;
    i64 frac = centi % 100_i64;
    mut string pad = "";
    if frac < 10_i64 { pad = "0"; }
    Output.WriteLine("BENCH " + name + ": " + Dec(centi / 100_i64) + "." + pad + Dec(frac) + " MB/s (" + Dec(safe / 1000_i64) + " us total)");
    return;
}

i64 Piece() { return 4096_i64; }
i64 Total() { return 2097152_i64; }
i64 Handshakes() { return 3_i64; }

SocketAddress LocalHost() {
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: Network.Types.PortBytes(0_u8, 0_u8) };
}

Endpoint Open(QuicConfig cfg, bool server) {
    Result<Endpoint, QuicError> r = QuicEndpoint.Bind(LocalHost(), cfg, server);
    return match r { Result::Ok(ep) => ep, Result::Error(_) => Fail(), };
}

Endpoint Fail() {
    Assert.Fail("bind");
    return Fail();
}

SocketAddress AddressOf(Endpoint ep) {
    return match QuicEndpoint.LocalAddress(ep) { Result::Ok(a) => a, Result::Error(_) => LocalHost(), };
}

i64 Value(Result<i64, QuicError> r) {
    return match r { Result::Ok(v) => v, Result::Error(e) => -1000_i64 - QuicErrors.WireCode(e), };
}

bool Done(Result<unit, QuicError> r) {
    return match r { Result::Ok(_) => true, Result::Error(_) => false, };
}

QuicConfig ServerQuic() {
    u8[] key = match PeerKeys.P256PrivateKeyFromDer(ServerKeyPkcs8()) { Result::Ok(k) => k, Result::Error(_) => Slice.New(0_i64), };
    return QuicConfig.TlsServerConfigFor(TlsConfig.Server(TlsConfig.Chain1(ServerCertDer()), key), ["bench/1"]);
}

QuicConfig ClientQuic() {
    return QuicConfig.TlsClientConfigFor(TlsConfig.Client("localhost", TlsConfig.AcceptAnyCertificateForTestsOnly()), ["bench/1"]);
}

// Server: accept `Handshakes()` connections; on the last one read one stream to its end.
// result[0] = bytes read (or a negative step), result[1] = monotonic nanos at the end.
i64 Sink(Endpoint ep, i64[] result) {
    mut i64 k = 0_i64;
    mut i64 conn = -1_i64;
    while k < Handshakes() {
        conn = Value(QuicEndpoint.Accept(ep, 30000_i64));
        if conn < 0_i64 { return conn; }
        k = k + 1_i64;
    }
    i64 stream = Value(QuicEndpoint.AcceptStream(ep, conn, 30000_i64));
    if stream < 0_i64 { return stream; }
    u8[] buf = Slice.New(Piece());
    mut i64 total = 0_i64;
    mut bool reading = true;
    while reading {
        i64 n = Value(QuicEndpoint.Read(ep, conn, stream, buf, 0_i64, Piece(), 30000_i64));
        if n < 0_i64 { return n; }
        if n == 0_i64 { reading = false; } else { total = total + n; }
    }
    result[1] = QuicEndpoint.NowNanos();
    return total;
}

// Client: `Handshakes()` connections (timed), then the transfer on the last one.
// times[0] = best handshake, times[1] = sum, times[2] = transfer start.
i64 Drive(Endpoint client, SocketAddress target, u8[] data, i64[] times) {
    mut i64 k = 0_i64;
    mut i64 conn = -1_i64;
    times[0] = 9223372036854775807_i64;
    while k < Handshakes() {
        i64 t0 = QuicEndpoint.NowNanos();
        conn = Value(QuicEndpoint.Connect(client, target, 30000_i64));
        i64 dt = QuicEndpoint.NowNanos() - t0;
        if conn < 0_i64 { return 100_i64 - conn; }
        if dt < times[0] { times[0] = dt; }
        times[1] = times[1] + dt;
        k = k + 1_i64;
    }
    i64 stream = Value(QuicEndpoint.OpenStream(client, conn, true, 5000_i64));
    if stream < 0_i64 { return 4_i64; }
    times[2] = QuicEndpoint.NowNanos();
    mut i64 sent = 0_i64;
    while sent < Total() {
        if !Done(QuicEndpoint.Write(client, conn, stream, data, 0_i64, Piece(), 30000_i64)) { return 5_i64; }
        sent = sent + Piece();
    }
    if !Done(QuicEndpoint.Finish(client, conn, stream)) { return 6_i64; }
    return 0_i64;
}

i64 Mode(string label, bool pure, u8[] data) {
    Provider.ForcePure(pure);
    Endpoint server = Open(ServerQuic(), true);
    Endpoint client = Open(ClientQuic(), false);
    SocketAddress target = AddressOf(server);
    Fiber<unit> serverDriver = QuicEndpoint.Start(server);
    Fiber<unit> clientDriver = QuicEndpoint.Start(client);
    i64[] result = [0_i64, 0_i64];
    Fiber<i64> sink = spawn (() => Sink(server, result));
    i64[] times = [0_i64, 0_i64, 0_i64];
    i64 step = Drive(client, target, data, times);
    i64 got = match sink.Join() { Result::Ok(v) => v, Result::Error(_) => -9_i64, };
    QuicEndpoint.Stop(client);
    QuicEndpoint.Stop(server);
    clientDriver.Join();
    serverDriver.Join();
    Provider.ForcePure(false);
    if step != 0_i64 { return step; }
    if got != Total() { return 20_i64; }
    Output.WriteLine("BENCH quic " + label + " handshake: best " + Dec(times[0] / 1000_i64) + " us, mean " + Dec(times[1] / Handshakes() / 1000_i64) + " us over " + Dec(Handshakes()));
    Throughput("quic " + label + " 2MiB stream in 4KiB writes", Total(), result[1] - times[2]);
    return 0_i64;
}

unit RunAll(i64[] codes) {
    u8[] data = Slice.New(Piece());
    mut i64 i = 0_i64;
    while i < Piece() { data[i] = u8((i * 13_i64) & 255_i64); i = i + 1_i64; }
    codes[0] = Mode("aes128gcm pure", true, data);
    codes[1] = Mode("aes128gcm native", false, data);
    return;
}

test bench_quic_loopback_stream_and_handshake {
    i64[] codes = [-1_i64, -1_i64];
    Fiber<unit> run = spawn (() => RunAll(codes));
    run.Join();
    Assert.Equal<i64>(codes[0], 0_i64, "pure");
    Assert.Equal<i64>(codes[1], 0_i64, "native");
}

