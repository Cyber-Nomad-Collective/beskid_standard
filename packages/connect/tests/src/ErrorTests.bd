use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.IO;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Connect;
use Connect.Failures;
use Connect.Policy;
use Testing.Assert;

// ---- shared loopback helpers (duplicated per target; targets are independent roots) ----

pub SocketAddress Loopback4(i64 port) {
    Port value = match Network.Types.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

pub SocketAddress Loopback6(i64 port) {
    Port value = match Network.Types.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V6(0_u32, 0_u32, 0_u32, 1_u32), port: value };
}

pub Option<Deadline> Within(i64 millis) {
    return match Deadline.After(Time.FromMilliseconds(millis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

// A port that refuses connections: bind, read the port, close.
pub Result<SocketAddress, NetworkError> ClosedPort4() {
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 1_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    listener.Close()?;
    return Result::Ok(address);
}

// A listener whose accept queue is full, so new connects hang until their deadline.
pub type Blackhole {
    TcpListener listener,
    TcpStream[] fillers,
    SocketAddress address,
}

pub Result<Blackhole, NetworkError> OpenBlackhole() {
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 1_i64)?;
    SocketAddress address = listener.LocalAddress()?;
    mut TcpStream[] fillers = Array.Empty<TcpStream>();
    mut i64 tries = 0_i64;
    mut bool hanging = false;
    while !hanging && tries < 16_i64 {
        match TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Within(100_i64)) {
            Result::Ok(stream) => { Array.Append<TcpStream>(fillers, stream); },
            Result::Error(_) => { hanging = true; },
        };
        tries = tries + 1_i64;
    }
    Assert.True(hanging, "a full accept queue makes new connects hang");
    return Result::Ok(Blackhole { listener: listener, fillers: fillers, address: address });
}

pub unit CloseBlackhole(Blackhole hole) {
    mut i64 index = 0_i64;
    while index < Array.Len<TcpStream>(hole.fillers) {
        TcpStream filler = hole.fillers[index];
        filler.Close();
        index = index + 1_i64;
    }
    hole.listener.Close();
    return;
}

// Accepts the connection a race produced, proves bytes flow, and closes both ends.
pub Result<unit, NetworkError> Exchange(TcpListener listener, TcpStream client) {
    TcpStream accepted = listener.Accept(Within(2000_i64))?;
    Assert.True(match IO.WriteAll(accepted, [42_u8], 0_i64, 1_i64) { Result::Ok(_) => true, _ => false, }, "server writes one byte");
    u8[] bytes = Slice.New(1_i64);
    Assert.True(match IO.ReadExact(client, bytes, 0_i64, 1_i64) { Result::Ok(_) => true, _ => false, }, "client reads the byte");
    Assert.Equal<u8>(bytes[0], 42_u8, "byte survives the winning stream");
    accepted.Close();
    client.Close();
    return Result::Ok(());
}

pub i64 PeerPort(TcpStream stream) {
    return match stream.PeerAddress() { Result::Ok(address) => address.port.Value(), Result::Error(_) => -1_i64, };
}

pub bool PeerIsV6(TcpStream stream) {
    return match stream.PeerAddress() {
        Result::Ok(address) => match address.address { IpAddress::V6(_, _, _, _) => true, _ => false, },
        Result::Error(_) => false,
    };
}

// Error kinds as small codes so tests compare without nested pattern matches.
pub i64 ErrorKind(ConnectError error) {
    return match error {
        ConnectError::InvalidPolicy => 1_i64,
        ConnectError::ResolutionFailed(_) => 2_i64,
        ConnectError::NoAddresses => 3_i64,
        ConnectError::AllAttemptsFailed(_) => 4_i64,
        ConnectError::DeadlineExceeded(_) => 5_i64,
        ConnectError::Cancelled(_) => 6_i64,
    };
}

pub i64 NetworkKind(NetworkError error) {
    return match error {
        NetworkError::ConnectionRefused => 1_i64,
        NetworkError::TimedOut => 2_i64,
        NetworkError::Cancelled => 3_i64,
        NetworkError::HostNotFound => 4_i64,
        _ => 9_i64,
    };
}

pub SocketAddress[] List1(SocketAddress a) {
    mut SocketAddress[] result = Array.Empty<SocketAddress>();
    Array.Append<SocketAddress>(result, a);
    return result;
}

pub SocketAddress[] List2(SocketAddress a, SocketAddress b) {
    mut SocketAddress[] result = List1(a);
    Array.Append<SocketAddress>(result, b);
    return result;
}

// ---- end shared helpers ----

pub i64 AttemptCount(ConnectError error) { return Array.Len<AttemptFailure>(Failures.Attempts(error)); }

pub i64 AttemptKind(ConnectError error, i64 index) {
    AttemptFailure[] attempts = Failures.Attempts(error);
    AttemptFailure failure = attempts[index];
    return NetworkKind(failure.error);
}

pub i64 AttemptPort(ConnectError error, i64 index) {
    AttemptFailure[] attempts = Failures.Attempts(error);
    AttemptFailure failure = attempts[index];
    return failure.address.port.Value();
}

pub i64 ResolutionCause(ConnectError error) {
    return match error {
        ConnectError::ResolutionFailed(cause) => NetworkKind(cause),
        _ => -1_i64,
    };
}

Result<unit, NetworkError> AllRefusedResult() {
    SocketAddress first = ClosedPort4()?;
    SocketAddress second = ClosedPort4()?;
    match Connect.ConnectAddresses(List2(first, second), Policy.Default()) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("closed ports cannot win"); },
        Result::Error(error) => {
            Assert.Equal<i64>(ErrorKind(error), 4_i64, "AllAttemptsFailed");
            Assert.Equal<i64>(AttemptCount(error), 2_i64, "every attempt is kept");
            Assert.Equal<i64>(AttemptKind(error, 0_i64), 1_i64, "first refused");
            Assert.Equal<i64>(AttemptKind(error, 1_i64), 1_i64, "second refused");
            Assert.Equal<i64>(AttemptPort(error, 0_i64), first.port.Value(), "first attempt address");
            Assert.Equal<i64>(AttemptPort(error, 1_i64), second.port.Value(), "second attempt address");
        },
    };
    return Result::Ok(());
}

unit AllRefused() {
    match AllRefusedResult() { Result::Ok(_) => (), Result::Error(_) => Assert.Fail("refused scenario has no NetworkError"), };
}

test errors_all_attempts_failed_keeps_each_attempt {
    Fiber<unit> scenario = spawn AllRefused();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "refused scenario joins");
}

Result<unit, NetworkError> MaxAttemptsResult() {
    SocketAddress refused = ClosedPort4()?;
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress good = listener.LocalAddress()?;
    match Connect.ConnectAddresses(List2(refused, good), Policy.WithMaxAttempts(Policy.Default(), 1_i64)) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("only one attempt is allowed"); },
        Result::Error(error) => {
            Assert.Equal<i64>(ErrorKind(error), 4_i64, "AllAttemptsFailed");
            Assert.Equal<i64>(AttemptCount(error), 1_i64, "max attempts bounds started attempts");
        },
    };
    listener.Close()?;
    return Result::Ok(());
}

unit MaxAttempts() {
    match MaxAttemptsResult() { Result::Ok(_) => (), Result::Error(_) => Assert.Fail("max attempts scenario has no NetworkError"), };
}

test errors_max_attempts_bounds_the_race {
    Fiber<unit> scenario = spawn MaxAttempts();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "max attempts scenario joins");
}

test errors_no_addresses_for_empty_list {
    match Connect.ConnectAddresses(Array.Empty<SocketAddress>(), Policy.Default()) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("empty list cannot connect"); },
        Result::Error(error) => Assert.Equal<i64>(ErrorKind(error), 3_i64, "NoAddresses"),
    };
}

test errors_no_addresses_after_family_filter {
    ConnectPolicy only6 = Policy.WithFamilyFilter(Policy.Default(), AddressFamily::V6());
    match Connect.ConnectAddresses(List1(Loopback4(80_i64)), only6) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("filtered list cannot connect"); },
        Result::Error(error) => Assert.Equal<i64>(ErrorKind(error), 3_i64, "NoAddresses"),
    };
}

test errors_invalid_policy_fails_closed {
    match Connect.ConnectAddresses(List1(Loopback4(80_i64)), Policy.WithMaxAttempts(Policy.Default(), 0_i64)) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("invalid policy cannot connect"); },
        Result::Error(error) => Assert.Equal<i64>(ErrorKind(error), 1_i64, "InvalidPolicy"),
    };
}

unit Unresolvable() {
    ConnectPolicy policy = Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(10000_i64));
    match Connect.ConnectHost("beskid-connect-test.invalid", Network.Types.PortBytes(0_u8, 80_u8), policy) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("an .invalid name cannot resolve"); },
        Result::Error(error) => {
            Assert.Equal<i64>(ErrorKind(error), 2_i64, "ResolutionFailed");
            Assert.Equal<i64>(ResolutionCause(error), 4_i64, "cause is HostNotFound");
        },
    };
}

test errors_resolution_failed_for_invalid_name {
    Fiber<unit> scenario = spawn Unresolvable();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "resolution scenario joins");
}

unit PortZero() {
    match Connect.ConnectHost("127.0.0.1", Network.Types.PortBytes(0_u8, 0_u8), Policy.Default()) {
        Result::Ok(stream) => { stream.Close(); Assert.Fail("port zero cannot connect"); },
        Result::Error(error) => Assert.Equal<i64>(ErrorKind(error), 2_i64, "port zero is a typed resolution failure"),
    };
}

test errors_port_zero_is_rejected {
    Fiber<unit> scenario = spawn PortZero();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "port zero scenario joins");
}
