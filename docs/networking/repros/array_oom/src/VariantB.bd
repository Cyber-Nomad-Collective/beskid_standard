// GAP: a single 192 KiB u8[] built by Slice.New traps with out_of_memory (append growth needs about 1.5x transiently).
use Core.Bytes.Slice;
use Core.Output;
use Core.String;
use Testing.Assert;

string Num(i64 n) {
    if n < 10_i64 { return String.DigitChar(n); }
    return Num(n / 10_i64) + String.DigitChar(n % 10_i64);
}

test variant_b_single_192k_array {
    Output.WriteLine("variant B: allocating one 196608-byte array");
    u8[] a = Slice.New(196608_i64);
    Output.WriteLine("variant B: allocated " + Num(Slice.Len(a)) + " bytes without a trap");
    Assert.Equal<i64>(Slice.Len(a), 196608_i64, "length");
}
