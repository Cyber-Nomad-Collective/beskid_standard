canaries {
  name = "canaries"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" {
  source = "path"
  path = "../.."
}

target "LambdaCall" {
  kind = Lib
  entry = "LambdaCall.bd"
}

target "ContractDispatch" {
  kind = Lib
  entry = "ContractDispatch.bd"
}

target "GenericLocal" {
  kind = Lib
  entry = "GenericLocal.bd"
}

target "ThisMethodCall" {
  kind = Lib
  entry = "ThisMethodCall.bd"
}

target "InlineEnumArgument" {
  kind = Lib
  entry = "InlineEnumArgument.bd"
}

target "NestedField" {
  kind = Lib
  entry = "NestedField.bd"
}

target "FieldOnCall" {
  kind = Lib
  entry = "FieldOnCall.bd"
}

target "CallInArrayLiteral" {
  kind = Lib
  entry = "CallInArrayLiteral.bd"
}

target "EnumArrayLiteral" {
  kind = Lib
  entry = "EnumArrayLiteral.bd"
}

target "BulkArgs" {
  kind = Lib
  entry = "BulkArgs.bd"
}

target "FloatToIntCast" {
  kind = Lib
  entry = "FloatToIntCast.bd"
}

target "FloatInterpolation" {
  kind = Lib
  entry = "FloatInterpolation.bd"
}

target "BoolInterpolation" {
  kind = Lib
  entry = "BoolInterpolation.bd"
}

target "EmptyConcat" {
  kind = Lib
  entry = "EmptyConcat.bd"
}

target "MinI64Interpolation" {
  kind = Lib
  entry = "MinI64Interpolation.bd"
}

target "TimeToUtc" {
  kind = Lib
  entry = "TimeToUtc.bd"
}

target "StringOrdering" {
  kind = Lib
  entry = "StringOrdering.bd"
}

target "ParameterShadowsField" {
  kind = Lib
  entry = "ParameterShadowsField.bd"
}

target "QualifiedGenericCall" {
  kind = Lib
  entry = "QualifiedGenericCall.bd"
}
