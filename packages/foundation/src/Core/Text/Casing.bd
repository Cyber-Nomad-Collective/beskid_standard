/// Identifier casing conversions for text tooling and codegen.
use Core.String;
use Core.String.Ascii;

/// `lower_run` → `LowerRun`.
pub string SnakeToPascal(string snake) {
    mut string out = "";
    mut bool upperNext = true;
    mut i64 i = 0;
    i64 len = String.Len(snake);
    while i < len {
        u8 b = String.ByteAt(snake, i);
        if b == 95 {
            upperNext = true;
            i = i + 1;
            continue;
        }
        if upperNext {
            out = out + String.CodeUnitChar(Ascii.ToUpper(b));
            upperNext = false;
        } else {
            out = out + String.CodeUnitChar(b);
        }
        i = i + 1;
    }
    return out;
}

/// `LowerRun` or `lowerRun` → `lower_run`: each uppercase letter starts a new lowercase word.
pub string ToSnake(string text) {
    mut string out = "";
    mut i64 i = 0;
    i64 len = String.Len(text);
    while i < len {
        u8 b = String.ByteAt(text, i);
        if Ascii.IsUpper(b) && String.Len(out) > 0 {
            out = out + "_";
        }
        out = out + String.CodeUnitChar(Ascii.ToLower(b));
        i = i + 1;
    }
    return out;
}

/// `lower_run` → `lowerRun`.
pub string SnakeToCamel(string snake) {
    string pascal = SnakeToPascal(snake);
    i64 len = String.Len(pascal);
    if len < 1 {
        return "";
    }
    return String.CodeUnitChar(Ascii.ToLower(String.ByteAt(pascal, 0))) + String.SubSlice(pascal, 1, len - 1);
}

/// `lower_run` with prefix `Parse` → `ParseLowerRun`.
pub string CallableFromSnake(string snake, string prefix) {
    return prefix + SnakeToPascal(snake);
}
