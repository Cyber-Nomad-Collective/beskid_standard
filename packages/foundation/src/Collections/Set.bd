/// Unordered set backed by linear `T[]` scan.
/// @tier(supported)
use Collections.Array;

pub type Set<T> {
    T[] storage,
    i64 count,
}

pub Set<T> New<T>() {
    return Set<T> { storage: Array.Empty<T>(), count: 0 };
}

pub i64 Count<T>(Set<T> set) {
    return set.count;
}

pub bool IsEmpty<T>(Set<T> set) {
    return set.count == 0;
}

pub Set<T> Add<T>(Set<T> set, T value) {
    if Contains<T>(set, value) {
        return set;
    }
    i64 next = set.count + 1;
    T[] nextStorage = Array.AppendAt<T>(set.storage, next, value);
    return Set<T> { storage: nextStorage, count: next };
}

pub Set<T> Remove<T>(Set<T> set, T value) {
    mut i64 i = 0;
    while i < set.count {
        T candidate = Array.Get<T>(set.storage, i);
        if candidate == value {
            T[] shifted = Array.Set<T>(set.storage, i, Array.Get<T>(set.storage, set.count - 1));
            return Set<T> { storage: shifted, count: set.count - 1 };
        }
        i = i + 1;
    }
    return set;
}

pub bool Contains<T>(Set<T> set, T value) {
    mut i64 i = 0;
    while i < set.count {
        if Array.Get<T>(set.storage, i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}
