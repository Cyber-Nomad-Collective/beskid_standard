use Codec.Hex;
use Codec.Mem;
use Testing.Assert;

mod MemTests
{
    test CopyOverlapsTowardsEnd
    {
        u8[] buffer = Hex.Of("01 02 03 04 05");
        Mem.Copy(buffer, 1_i64, buffer, 0_i64, 4_i64);
        Assert.Equal<string>(Hex.Encode(buffer), "0101020304", "overlap towards the end");
    }

    test CopyOverlapsTowardsStart
    {
        u8[] buffer = Hex.Of("01 02 03 04 05");
        Mem.Copy(buffer, 0_i64, buffer, 1_i64, 4_i64);
        Assert.Equal<string>(Hex.Encode(buffer), "0203040505", "overlap towards the start");
    }

    test ZeroPreservesBytesOutsideRange
    {
        u8[] buffer = Hex.Of("01 02 03 04 05");
        Assert.True(Mem.Zero(buffer, 1_i64, 3_i64), "valid range");
        Assert.False(Mem.Zero(buffer, 4_i64, 2_i64), "out of range");
        Assert.Equal<string>(Hex.Encode(buffer), "0100000005", "range and surrounding bytes");
    }
}
