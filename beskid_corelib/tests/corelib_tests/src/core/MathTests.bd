/// Math module tests — arithmetic, rounding, trig, and domain checks.
use Core.Math;

use Testing.Assert;

test AbsPositive
{
    Assert.Equal(Math.Abs(5), 5, "abs of positive");
}

test AbsNegative
{
    Assert.Equal(Math.Abs(-5), 5, "abs of negative");
}

test AbsZero
{
    Assert.Equal(Math.Abs(0), 0, "abs of zero");
}

test MinStandard
{
    Assert.Equal(Math.Min(3, 7), 3, "min picks smaller");
}

test MaxStandard
{
    Assert.Equal(Math.Max(3, 7), 7, "max picks larger");
}

test ClampWithinRange
{
    Assert.Equal(Math.Clamp(5, 0, 10), 5, "clamp within");
}

test ClampBelowRange
{
    Assert.Equal(Math.Clamp(-5, 0, 10), 0, "clamp below");
}

test ClampAboveRange
{
    Assert.Equal(Math.Clamp(15, 0, 10), 10, "clamp above");
}

test PowZeroExponent
{
    Assert.Equal(Math.Pow(7, 0), 1, "pow zero exp");
}

test PowOneExponent
{
    Assert.Equal(Math.Pow(7, 1), 7, "pow one exp");
}

test PowSmall
{
    Assert.Equal(Math.Pow(2, 3), 8, "pow 2^3");
}

test PiConstantPositive
{
    Assert.True(Math.Pi() > 3.14, "Pi > 3.14");
    Assert.True(Math.Pi() < 3.15, "Pi < 3.15");
}

test EConstantPositive
{
    Assert.True(Math.E() > 2.71, "E > 2.71");
    Assert.True(Math.E() < 2.72, "E < 2.72");
}

test DegreesToRadians
{
    f64 rad = Math.DegreesToRadians(180.0);
    Assert.True(rad > 3.14, "180 deg to rad > pi");
    Assert.True(rad < 3.142, "180 deg to rad < 3.142");
}

test RadiansToDegrees
{
    f64 deg = Math.RadiansToDegrees(3.141592653589793);
    Assert.True(deg > 179.9, "pi rad to deg near 180");
    Assert.True(deg < 180.1, "pi rad to deg near 180");
}

test FloorPositive
{
    Assert.True(Math.Floor(3.7) == 3.0, "floor drops fraction");
}

test CeilPositive
{
    Assert.True(Math.Ceil(3.2) == 4.0, "ceil raises");
}

test RoundDown
{
    Assert.True(Math.Round(3.2) == 3.0, "round down");
}

test RoundUp
{
    Assert.True(Math.Round(3.7) == 4.0, "round up");
}

test SqrtPerfect
{
    f64 s = Math.Sqrt(16.0);
    Assert.True(s > 3.99 && s < 4.01, "sqrt 16 = 4");
}

test SqrtNegativeSaturates
{
    f64 s = Math.Sqrt(-1.0);
    Assert.True(s == 0.0, "sqrt negative returns 0");
}

test LogPositive
{
    f64 l = Math.Log(1.0);
    Assert.True(l > -0.001 && l < 0.001, "ln(1) = 0");
}

test LogNonpositiveSaturates
{
    f64 l = Math.Log(0.0);
    Assert.True(l == 0.0, "ln(0) saturates to 0");
}

test FloatToIntegerConversionTruncatesTowardZero
{
    f64 positive = 2.9;
    f64 negative = -2.9;
    Assert.True(i64(positive) == 2, "truncates toward zero");
    Assert.True(i64(negative) == -2, "truncates a negative value toward zero");
    Assert.True(i32(-2.5_f32) == -2_i32, "f32 truncates toward zero");
}

test FloatToIntegerConversionSaturatesSignedTargets
{
    f64 big = 1.0e300;
    f64 low = -1.0e300;
    f64 zero = 0.0;
    f64 nan = zero / zero;
    Assert.True(i64(big) == 9223372036854775807, "i64 clamps to its maximum");
    Assert.True(i64(low) == -9223372036854775807 - 1, "i64 clamps to its minimum");
    Assert.True(i64(nan) == 0, "NaN converts to 0");
    Assert.True(i32(big) == 2147483647_i32, "i32 clamps to its maximum");
    Assert.True(i32(low) == -2147483648_i32, "i32 clamps to its minimum");
    Assert.True(i16(40000.0) == 32767_i16, "i16 clamps to its maximum");
    Assert.True(i16(-40000.0) == -32768_i16, "i16 clamps to its minimum");
    Assert.True(i8(200.0) == 127_i8, "i8 clamps to its maximum");
    Assert.True(i8(-200.0) == -128_i8, "i8 clamps to its minimum");
    Assert.True(i8(nan) == 0_i8, "NaN converts to 0 at 8 bits");
    Assert.True(i8(-100.7) == -100_i8, "an in-range i8 value truncates");
}

test FloatToIntegerConversionSaturatesUnsignedTargets
{
    f64 big = 1.0e300;
    f64 zero = 0.0;
    f64 nan = zero / zero;
    f64 aboveSignedRange = 10000000000000000000.0;
    Assert.True(u64(aboveSignedRange) == 10000000000000000000_u64, "u64 converts above the i64 range");
    Assert.True(u64(big) == 18446744073709551615_u64, "u64 clamps to its maximum");
    Assert.True(u64(-1.0) == 0_u64, "u64 clamps negatives to 0");
    Assert.True(u32(5000000000.0) == 4294967295_u32, "u32 clamps to its maximum");
    Assert.True(u32(-1.0) == 0_u32, "u32 clamps negatives to 0");
    Assert.True(u16(70000.0) == 65535_u16, "u16 clamps to its maximum");
    Assert.True(u16(40000.0) == 40000_u16, "u16 keeps values above the i16 range");
    Assert.True(u16(-1.0) == 0_u16, "u16 clamps negatives to 0");
    Assert.True(u8(300.0) == 255_u8, "u8 clamps to its maximum");
    Assert.True(u8(-5.0) == 0_u8, "u8 clamps negatives to 0");
    Assert.True(u8(nan) == 0_u8, "NaN converts to 0");
    Assert.True(word(-1.0) == word(0), "word clamps negatives to 0");
    Assert.True(u8(300.5_f32) == 255_u8, "an f32 source saturates");
    Assert.True(u16(-3.0_f32) == 0_u16, "an f32 source clamps negatives");
}
