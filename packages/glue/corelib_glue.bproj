corelib_glue {
  name = "corelib_glue"
  version = "0.1.0"
  root = "src"
  readme = "readme.md"
}

dependency "corelib_foundation" {
  source = "path"
  path = "../foundation"
}

dependency "corelib_serialization" {
  source = "path"
  path = "../serialization"
}

dependency "corelib_concurrency" {
  source = "path"
  path = "../concurrency"
}

target "GlueLib" {
  kind = Lib
}
