/// Runs the crypto known-answer vectors (FIPS 180-4, RFC 4231, NIST GCM, RFC 8439, and the
/// SymLongVectors digests) through both providers (ruling R27): `P*` helpers force the pure
/// kernels with `BESKID_CRYPTO_PROVIDER=pure`, `N*` helpers clear the switch so the native
/// OpenSSL provider serves the call. Also checks tag rejection, the no-plaintext-on-failure
/// rule, offsets, and provider selection. Needs a host with OpenSSL 3 (`libcrypto.so.3`).
use Testing.Assert;
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Crypto.AesGcm;
use Crypto.ChaCha20Poly1305;
use Crypto.Errors;
use Crypto.Hmac;
use Crypto.Sha256;
use Crypto.Sha512;
use Crypto.Provider;

unit UsePure() { Provider.ForcePure(true); return; }
unit UseNative() { Provider.ForcePure(false); return; }
u8[] PSha256(u8[] m) { UsePure(); u8[] r = Sha256.Hash(m); UseNative(); return r; }
u8[] NSha256(u8[] m) { UseNative(); return Sha256.Hash(m); }
u8[] PSha512(u8[] m) { UsePure(); u8[] r = Sha512.Hash512(m); UseNative(); return r; }
u8[] NSha512(u8[] m) { UseNative(); return Sha512.Hash512(m); }
u8[] PSha384(u8[] m) { UsePure(); u8[] r = Sha512.Hash384(m); UseNative(); return r; }
u8[] NSha384(u8[] m) { UseNative(); return Sha512.Hash384(m); }
u8[] PHmac(HashAlgorithm a, u8[] k, u8[] m) { UsePure(); u8[] r = Hmac.Compute(a, k, m); UseNative(); return r; }
u8[] NHmac(HashAlgorithm a, u8[] k, u8[] m) { UseNative(); return Hmac.Compute(a, k, m); }
u8[] PDigest(HashAlgorithm a, u8[] m) { UsePure(); u8[] r = Hmac.Digest(a, m); UseNative(); return r; }
u8[] NDigest(HashAlgorithm a, u8[] m) { UseNative(); return Hmac.Digest(a, m); }
Result<AesGcmKey, CryptoError> PAesKey(u8[] k) { UsePure(); Result<AesGcmKey, CryptoError> r = AesGcm.New(k); UseNative(); return r; }
Result<AesGcmKey, CryptoError> NAesKey(u8[] k) { UseNative(); return AesGcm.New(k); }
Result<u8[], CryptoError> PChaSeal(u8[] k, u8[] n, u8[] a, u8[] m) { UsePure(); Result<u8[], CryptoError> r = ChaCha20Poly1305.Seal(k, n, a, m); UseNative(); return r; }
Result<u8[], CryptoError> NChaSeal(u8[] k, u8[] n, u8[] a, u8[] m) { UseNative(); return ChaCha20Poly1305.Seal(k, n, a, m); }
Result<u8[], CryptoError> PChaOpen(u8[] k, u8[] n, u8[] a, u8[] m) { UsePure(); Result<u8[], CryptoError> r = ChaCha20Poly1305.Open(k, n, a, m); UseNative(); return r; }
Result<u8[], CryptoError> NChaOpen(u8[] k, u8[] n, u8[] a, u8[] m) { UseNative(); return ChaCha20Poly1305.Open(k, n, a, m); }
Result<unit, CryptoError> PChaSealInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo) { UsePure(); Result<unit, CryptoError> r = ChaCha20Poly1305.SealInto(k, n, a, i, io, c, o, oo); UseNative(); return r; }
Result<unit, CryptoError> NChaSealInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo) { UseNative(); return ChaCha20Poly1305.SealInto(k, n, a, i, io, c, o, oo); }
Result<i64, CryptoError> NChaOpenInto(u8[] k, u8[] n, u8[] a, u8[] i, i64 io, i64 c, u8[] o, i64 oo) { UseNative(); return ChaCha20Poly1305.OpenInto(k, n, a, i, io, c, o, oo); }

u8 Nibble(u8 c) {
    if c >= 48_u8 && c <= 57_u8 { return c - 48_u8; }
    if c >= 97_u8 && c <= 102_u8 { return c - 87_u8; }
    return c - 55_u8;
}
u8[] Hex(string text) {
    i64 n = String.Len(text) / 2_i64;
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = Nibble(String.ByteAt(text, 2_i64 * i)) * 16_u8 + Nibble(String.ByteAt(text, 2_i64 * i + 1_i64)); i = i + 1_i64; }
    return out;
}
u8[] Ascii(string text) {
    i64 n = String.Len(text);
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = String.ByteAt(text, i); i = i + 1_i64; }
    return out;
}
bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }
u8[] Prefix(u8[] data, i64 n) { u8[] o = Slice.New(n); Slice.Copy(o, 0_i64, data, 0_i64, n); return o; }
u8[] Pattern(i64 n, i64 mul, i64 add) {
    u8[] o = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { o[i] = u8((i * mul + add) & 255_i64); i = i + 1_i64; }
    return o;
}
u8[] Unwrap(Result<u8[], CryptoError> r) {
    return match r { Result::Ok(v) => v, Result::Error(_) => Slice.New(0_i64), };
}
bool AuthFailBytes(Result<u8[], CryptoError> r) {
    return match r { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, }, };
}
bool AuthFailLen(Result<i64, CryptoError> r) {
    return match r { Result::Ok(_) => false, Result::Error(e) => match e { CryptoError::AuthenticationFailed => true, _ => false, }, };
}
u8 Flip(u8 b) { return (b | 1_u8) - (b & 1_u8); }

string Msg448() { return "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"; }
string Msg896() { return "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"; }
string Sunscreen() { return "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."; }

unit CheckSha256(u8[] message, string expected) {
    Assert.True(Same(PSha256(message), Hex(expected)), "pure sha256");
    Assert.True(Same(NSha256(message), Hex(expected)), "native sha256");
    return;
}
unit CheckSha512(u8[] message, string expected) {
    Assert.True(Same(PSha512(message), Hex(expected)), "pure sha512");
    Assert.True(Same(NSha512(message), Hex(expected)), "native sha512");
    return;
}
unit CheckSha384(u8[] message, string expected) {
    Assert.True(Same(PSha384(message), Hex(expected)), "pure sha384");
    Assert.True(Same(NSha384(message), Hex(expected)), "native sha384");
    return;
}

unit CheckHmac(HashAlgorithm algorithm, string key, string message, i64 n, string expected) {
    u8[] pure = PHmac(algorithm, Hex(key), Hex(message));
    u8[] native = NHmac(algorithm, Hex(key), Hex(message));
    Assert.True(Same(Prefix(pure, n), Hex(expected)), "pure hmac");
    Assert.True(Same(pure, native), "native hmac equals pure");
    return;
}

unit CheckAes(u8[] key, u8[] nonce, u8[] aad, u8[] plaintext, string expected) {
    match PAesKey(key) {
        Result::Error(_) => { Assert.Fail("pure key"); },
        Result::Ok(pure) => {
            match NAesKey(key) {
                Result::Error(_) => { Assert.Fail("native key"); },
                Result::Ok(native) => {
                    u8[] a = Unwrap(AesGcm.Seal(pure, nonce, aad, plaintext));
                    u8[] b = Unwrap(AesGcm.Seal(native, nonce, aad, plaintext));
                    Assert.True(Same(a, Hex(expected)), "pure aes-gcm");
                    Assert.True(Same(b, Hex(expected)), "native aes-gcm");
                    Assert.True(Same(Unwrap(AesGcm.Open(native, nonce, aad, a)), plaintext), "native opens pure");
                    Assert.True(Same(Unwrap(AesGcm.Open(pure, nonce, aad, b)), plaintext), "pure opens native");
                },
            };
        },
    };
    return;
}

unit CheckChaCha(u8[] key, u8[] nonce, u8[] aad, u8[] plaintext, string expected) {
    u8[] a = Unwrap(PChaSeal(key, nonce, aad, plaintext));
    u8[] b = Unwrap(NChaSeal(key, nonce, aad, plaintext));
    Assert.True(Same(a, Hex(expected)), "pure chacha20-poly1305");
    Assert.True(Same(b, Hex(expected)), "native chacha20-poly1305");
    Assert.True(Same(Unwrap(NChaOpen(key, nonce, aad, a)), plaintext), "native opens pure");
    Assert.True(Same(Unwrap(PChaOpen(key, nonce, aad, b)), plaintext), "pure opens native");
    return;
}

/// SymLongVectors inputs: key 00 01 .., nonce 000000090000004a00000000, aad 00 .. 0c,
/// message byte i = (7 i + 3) mod 256; expected value is SHA-256(ciphertext || tag).
unit CheckLongChaCha(i64 n, string expected) {
    u8[] key = Pattern(32_i64, 1_i64, 0_i64);
    u8[] nonce = Hex("000000090000004a00000000");
    u8[] aad = Pattern(13_i64, 1_i64, 0_i64);
    u8[] message = Pattern(n, 7_i64, 3_i64);
    u8[] a = Unwrap(PChaSeal(key, nonce, aad, message));
    u8[] b = Unwrap(NChaSeal(key, nonce, aad, message));
    Assert.True(Same(PSha256(a), Hex(expected)), "pure long chacha");
    Assert.True(Same(a, b), "native long chacha equals pure");
    Assert.True(Same(Unwrap(NChaOpen(key, nonce, aad, b)), message), "native long chacha open");
    return;
}
unit CheckLongAes(i64 keyLength, i64 n, string expected) {
    u8[] key = Pattern(keyLength, 1_i64, 0_i64);
    u8[] nonce = Hex("000000090000004a00000000");
    u8[] aad = Pattern(13_i64, 1_i64, 0_i64);
    u8[] message = Pattern(n, 7_i64, 3_i64);
    match PAesKey(key) {
        Result::Error(_) => { Assert.Fail("pure key"); },
        Result::Ok(pure) => {
            match NAesKey(key) {
                Result::Error(_) => { Assert.Fail("native key"); },
                Result::Ok(native) => {
                    u8[] a = Unwrap(AesGcm.Seal(pure, nonce, aad, message));
                    u8[] b = Unwrap(AesGcm.Seal(native, nonce, aad, message));
                    Assert.True(Same(PSha256(a), Hex(expected)), "pure long aes");
                    Assert.True(Same(a, b), "native long aes equals pure");
                    Assert.True(Same(Unwrap(AesGcm.Open(native, nonce, aad, b)), message), "native long aes open");
                },
            };
        },
    };
    return;
}

