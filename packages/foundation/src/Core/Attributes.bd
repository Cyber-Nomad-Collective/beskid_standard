/// Attributes the compiler recognizes by name.
///
/// A use of one of these names resolves to the declaration here unless a declaration of the
/// same name in the using unit, or in a unit it imports, shadows it. A shadowing declaration is
/// an ordinary attribute and has no compiler meaning. The target lists here are the lists the
/// compiler enforces (E1510).

/// Exports a function or method under the C ABI (`Abi`, `Symbol`).
pub attribute Export(FunctionDefinition, MethodDefinition) { }

/// Declares a contract whose methods are foreign C symbols of `Library`.
pub attribute Extern(ContractDefinition) { }

/// Marks a function that the runtime corpus provides.
pub attribute Runtime(FunctionDefinition) { }

/// Marks a marker contract that the compiler proves structurally; declared conformance is rejected.
pub attribute CompilerDerived(ContractDefinition) { }

/// A transitively immutable type: every field is Shared and is assigned only in the struct literal.
pub attribute Immutable(TypeDefinition) { }

/// An externally unique type whose fields are Shared or Moved.
pub attribute Isolated(TypeDefinition) { }

/// Plain data copied on every transfer; its fields are Shared or Copied.
pub attribute Copyable(TypeDefinition) { }

/// An isolate-local handle that never crosses a heap boundary.
pub attribute NeverTransferable(TypeDefinition) { }

/// The one array field an `[Immutable]` corelib type may hold when nothing writes it.
pub attribute ImmutableStorage(Field) { }

/// The capture bound of a function-typed parameter or field: `[Captures(Bound: Transferable)]`.
/// A value read from a bounded parameter or field satisfies the same bound.
pub attribute Captures(Parameter, Field) { }

/// Corelib only: an `[Immutable]` view whose one `[ImmutableStorage]` array borrows storage of a
/// transferable element type for the lifetime of a scope; the view is Shared.
pub attribute ScopeBorrowed(TypeDefinition) { }

/// Brands a nominal type as a Glue handle of `Library`.
pub attribute GlueHandle(TypeDefinition) { }

/// Names the Rust owner of a Glue type or a fallible Glue import.
pub attribute RustOwner(TypeDefinition, ContractMethodSignature) { }

/// Marks the function that converts a cleanup error into the enclosing Result error.
pub attribute CleanupConversion(FunctionDefinition) { }
