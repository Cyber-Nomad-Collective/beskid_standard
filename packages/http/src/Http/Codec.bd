string DecimalText(i64 value) {if value==0_i64{return "0";}mut string out="";mut i64 v=value;while v>0_i64{out=String.CodeUnitChar(u8(48)+u8(v%10_i64))+out;v=v/10_i64;}return out;}
/// Returns the grown buffer: Array.Append may reallocate, so the caller rebinds the handle.
u8[] AppendText(mut u8[] destination, string text) { u8[] source = Convert.StringToBytes(text); mut i64 index = 0_i64; while index < Slice.Len(source) { Array.Append<u8>(destination, source[index]); index = index + 1_i64; } return destination; }
u8[] AppendCrlf(mut u8[] destination) { Array.Append<u8>(destination, u8(13)); Array.Append<u8>(destination, u8(10)); return destination; }
Result<u8[],HttpError> Serialize(string start,Header[] headers,u8[] body,Limits limits) {
    if Slice.Len(body)>limits.maxBodyBytes{return Result::Error(HttpError::BodyTooLarge());}
    mut u8[] bytes=[]; bytes=AppendText(bytes,start); bytes=AppendCrlf(bytes); mut i64 i=0_i64;
    while i<Array.Len<Header>(headers) { Header h=Array.Get<Header>(headers,i); if !Token(h.name)||!FieldValue(h.value){return Result::Error(HttpError::InvalidHeader());} string name=LowerAscii(h.name); if name=="content-length"||name=="transfer-encoding"{return Result::Error(HttpError::AmbiguousFraming());} bytes=AppendText(bytes,name+": "+TrimOws(h.value)); bytes=AppendCrlf(bytes); if Slice.Len(bytes)>limits.maxHeaderBytes{return Result::Error(HttpError::HeaderTooLarge());} i=i+1_i64; }
    bytes=AppendText(bytes,"content-length: "+DecimalText(Slice.Len(body))); bytes=AppendCrlf(bytes); bytes=AppendCrlf(bytes); i=0_i64; while i<Slice.Len(body){Array.Append<u8>(bytes,body[i]);i=i+1_i64;}return Result::Ok(bytes);
}
pub Result<u8[],HttpError> SerializeRequest(Request request,Limits limits) {if !Token(request.method){return Result::Error(HttpError::InvalidMethod());}if String.Len(request.target)==0_i64||String.IndexOfFrom(request.target,0_i64," ")>=0_i64{return Result::Error(HttpError::InvalidTarget());}Result<unit,HttpError> hostCheck=HostField(request.headers);return match hostCheck {Result::Error(error)=>Result::Error(error),Result::Ok(_)=>Serialize(request.method+" "+request.target+" HTTP/1.1",request.headers,request.body,limits),};}
pub Result<u8[],HttpError> SerializeResponse(Response response,Limits limits) {if response.status<100_i64||response.status>599_i64||!FieldValue(response.reason){return Result::Error(HttpError::InvalidStatus());}return Serialize("HTTP/1.1 "+DecimalText(response.status)+" "+response.reason,response.headers,response.body,limits);}
