// The private construction authority for generation-tagged resources.
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Internal;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Network.Udp.UdpSocket;

pub Result<TcpListener, NetworkError> BindTcpListener(SocketAddress address, i64 backlog) {
    if backlog <= 0_i64 || backlog > 2147483647_i64 { return Result::Error(NetworkError::InvalidAddress); }
    word[] result = [word(0)];
    i32 status = Internal.Open(1_i64, Internal.Encode(address), 0_i64, backlog, result);
    if status != 0_i32 { return Result::Error(Internal.Error(i64(status))); }
    return Result::Ok(TcpListener { handle: result[0] });
}

pub Result<TcpStream, NetworkError> ConnectTcpStream(SocketAddress address, Network.Types.SocketOptions options) {
    if address.port.Value() == 0_i64 { return Result::Error(NetworkError::InvalidAddress); }
    word[] result = [word(0)];
    i32 status = Internal.Open(2_i64, Internal.Encode(address), Internal.Options(options), 0_i64, result);
    if status != 0_i32 { return Result::Error(Internal.Error(i64(status))); }
    return Result::Ok(TcpStream { handle: result[0] });
}

pub Result<UdpSocket, NetworkError> BindUdpSocket(SocketAddress address) {
    word[] result = [word(0)];
    i32 status = Internal.Open(3_i64, Internal.Encode(address), 0_i64, 0_i64, result);
    if status != 0_i32 { return Result::Error(Internal.Error(i64(status))); }
    return Result::Ok(UdpSocket { handle: result[0] });
}

pub Result<TcpStream, NetworkError> AcceptTcpStream(word handle) {
    word[] accepted = [word(0)];
    i32 status = Internal.Accept(handle, accepted);
    if status != 0_i32 { return Result::Error(Internal.Error(i64(status))); }
    return Result::Ok(TcpStream { handle: accepted[0] });
}
