corelib_http3 {
  name = "corelib_http3"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_tls" { source = path path = "../tls" }
dependency "corelib_quic" { source = path path = "../quic" }
