use Core.Bsol.Syntax;

pub enum ErrorKind
{
    UnexpectedToken,

    UnexpectedEnd,

    InvalidEscape,

    InvalidUnicode,

    InvalidNumber,

    DuplicateKey,

    InputLimit,

    OutputLimit,

    ScalarLimit,

    DepthLimit,

    NodeLimit,

    InvalidSyntax,
}

pub type BsolError
{
    pub ErrorKind kind,

    pub Syntax.Span span,

    pub string message,
}
