corelib {
  name = "corelib"
  version = "0.1.0"
  type = Aggregate
  readme = "README.md"
}

dependency "corelib_foundation" {
  source = path
  path = "../packages/foundation"
}

dependency "corelib_runtime" {
  source = path
  path = "../packages/runtime"
}

dependency "corelib_compiler_sdk" {
  source = path
  path = "../packages/compiler-sdk"
}

dependency "corelib_console" {
  source = path
  path = "../packages/console"
}

dependency "corelib_concurrency" {
  source = path
  path = "../packages/concurrency"
}

dependency "corelib_interop" {
  source = path
  path = "../packages/interop"
}

dependency "corelib_glue" {
  source = path
  path = "../packages/glue"
}

dependency "corelib_network" {
  source = path
  path = "../packages/network"
}

dependency "corelib_http" {
  source = path
  path = "../packages/http"
}

dependency "corelib_uri" {
  source = path
  path = "../packages/uri"
}

dependency "corelib_codec" {
  source = path
  path = "../packages/codec"
}

dependency "corelib_connect" {
  source = path
  path = "../packages/connect"
}

dependency "corelib_crypto" {
  source = path
  path = "../packages/crypto"
}

dependency "corelib_x509" {
  source = path
  path = "../packages/x509"
}

dependency "corelib_tls" {
  source = path
  path = "../packages/tls"
}

dependency "corelib_http2" {
  source = path
  path = "../packages/http2"
}

dependency "corelib_websocket" {
  source = path
  path = "../packages/websocket"
}

dependency "corelib_quic" {
  source = path
  path = "../packages/quic"
}

dependency "corelib_http3" {
  source = path
  path = "../packages/http3"
}

dependency "corelib_web" {
  source = path
  path = "../packages/web"
}
