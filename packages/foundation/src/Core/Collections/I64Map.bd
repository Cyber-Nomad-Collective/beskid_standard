/// Core.Collections.I64Map — hash map from `i64` keys to values, with expected O(1) lookup,
/// insertion, and removal.
/// @tier(supported)
/// Keys hash with the SplitMix64 finalizer. Iteration order is insertion order until the first
/// removal. Maps are single-owner (linear) values: `Insert` and `Remove` return the updated map.
/// They update shared storage in place, so a version must not be used after a later operation on
/// it. Use `List`, `Map`, or `Set` when earlier versions must stay valid.
use Core.Collections.Hash;
use Core.Collections.HashTable;
use Core.Optional.Option;

pub type I64Map<V> {
    HashTable<i64, V> table,

    /// Number of entries.
    pub i64 Count() {
        return HashTable.Size<i64, V>(this.table);
    }

    /// Returns true when the map has no entries.
    pub bool IsEmpty() {
        return HashTable.Size<i64, V>(this.table) == 0;
    }

    /// Returns true when `key` is present.
    pub bool ContainsKey(i64 key) {
        return HashTable.Contains<i64, V>(this.table, key, Hash.I64(key));
    }

    /// Returns the value for `key`, or `None` when absent.
    pub Option<V> Get(i64 key) {
        return HashTable.Get<i64, V>(this.table, key, Hash.I64(key));
    }

    /// Returns the value for `key`, or `fallback` when absent.
    pub V GetOr(i64 key, V fallback) {
        return HashTable.GetOr<i64, V>(this.table, key, Hash.I64(key), fallback);
    }

    /// Inserts or replaces the value for `key`.
    pub I64Map<V> Insert(i64 key, V value) {
        return I64Map<V> { table: HashTable.Insert<i64, V>(this.table, key, Hash.I64(key), value) };
    }

    /// Removes `key` when present.
    pub I64Map<V> Remove(i64 key) {
        return I64Map<V> { table: HashTable.Remove<i64, V>(this.table, key, Hash.I64(key)) };
    }

    /// Copies the keys in iteration order.
    pub i64[] Keys() {
        return HashTable.Keys<i64, V>(this.table);
    }

    /// Copies the values in the same order as `Keys()`.
    pub V[] Values() {
        return HashTable.Values<i64, V>(this.table);
    }
}

/// Creates an empty map.
pub I64Map<V> New<V>() {
    return I64Map<V> { table: HashTable.New<i64, V>() };
}
