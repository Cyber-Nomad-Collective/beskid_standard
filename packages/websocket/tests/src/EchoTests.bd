use Concurrency;
use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Network.Types;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Testing.Assert;
use WebSocket.WsErrors;
use WebSocket.WsConnection;
use WebSocket.WsTransport;

// Loopback Beskid client <-> Beskid server over direct TCP (no resolver).

SocketAddress Loopback4(i64 port) {
    Port value = match Network.Types.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

Option<Deadline> Within(i64 millis) {
    return match Deadline.After(Time.FromMilliseconds(millis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

// Server: echoes text and binary; records [0] messages echoed, [1] close code seen.
unit EchoOnce(TcpListener listener, WsOptions options, i64[] seen) {
    match listener.Accept(Within(5000_i64)) {
        Result::Error(_) => { Assert.Fail("accept"); },
        Result::Ok(stream) => { ServeEcho(stream, options, seen); },
    };
    return;
}

unit ServeEcho(TcpStream stream, WsOptions options, i64[] seen) {
    match WsConnection.Accept(stream, options) {
        Result::Error(_) => { Assert.Fail("server handshake"); },
        Result::Ok(conn) => { EchoLoop(conn, seen); },
    };
    return;
}

unit EchoLoop(WsConnection conn, i64[] seen) {
    mut bool running = true;
    while running {
        match conn.Receive() {
            Result::Error(e) => { seen[1] = -WsErrors.Code(e); running = false; },
            Result::Ok(message) => { running = Echo(conn, message, seen); },
        };
    }
    return;
}

bool Echo(WsConnection conn, WsMessage message, i64[] seen) {
    seen[0] = seen[0] + 1_i64;
    return match message {
        WsMessage::Text(text) => Sent(conn.SendText(text)),
        WsMessage::Binary(data) => Sent(conn.SendBinary(data)),
        WsMessage::Close(code, _) => MarkClosed(seen, code),
    };
}

bool MarkClosed(i64[] seen, i64 code) { seen[1] = code; return false; }

bool Sent(Result<unit, WsError> r) { return match r { Result::Ok(_) => true, Result::Error(_) => false, }; }

string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

Result<WsConnection, WsError> Dial(SocketAddress address, WsOptions options) {
    return match TcpStream.Connect(address, Network.Types.DefaultSocketOptions(), Within(2000_i64)) {
        Result::Error(_) => Result::Error(WsError::ConnectFailed()),
        Result::Ok(stream) => WsConnection.ClientHandshake(WsTransport::Tcp(stream), "127.0.0.1:" + Dec(address.port.Value()), "/echo?x=1", options),
    };
}

string TextOf(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => TextOfMessage(m),
        Result::Error(e) => "<error " + Dec(WsErrors.Code(e)) + ">",
    };
}

string TextOfMessage(WsMessage m) { return match m { WsMessage::Text(t) => t, _ => "<not text>", }; }

u8[] BytesOf(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => BytesOfMessage(m),
        Result::Error(_) => Slice.New(0_i64),
    };
}

u8[] BytesOfMessage(WsMessage m) { return match m { WsMessage::Binary(b) => b, _ => Slice.New(0_i64), }; }

u8[] Pattern(i64 n) {
    u8[] out = Slice.New(n);
    mut i64 i = 0_i64;
    while i < n { out[i] = u8((i * 7_i64 + 3_i64) & 255_i64); i = i + 1_i64; }
    return out;
}

// Messages: text, 300-byte binary (16-bit length), fragmented UTF-8 text with an
// interleaved ping, empty text; then close 3000 with a reason.
unit ConversationScenario(SocketAddress address, i64[] seen) {
    WsOptions options = WsConnection.WithProtocols(WsConnection.DefaultOptions(), ["chat", "superchat"]);
    match Dial(address, options) {
        Result::Error(e) => { Assert.Equal<i64>(WsErrors.Code(e), 0_i64, "client handshake"); },
        Result::Ok(conn) => { Converse(conn, seen); },
    };
    return;
}

unit Converse(WsConnection conn, i64[] seen) {
    Assert.True(conn.Protocol() == "superchat", "server preference picks superchat");
    Assert.True(Sent(conn.SendText("hello")), "send text");
    Assert.True(TextOf(conn.Receive()) == "hello", "text echo");
    u8[] blob = Pattern(300_i64);
    Assert.True(Sent(conn.SendBinary(blob)), "send binary");
    Assert.True(Slice.Compare(BytesOf(conn.Receive()), blob) == 0_i64, "binary echo");
    // "zażółć" split inside a two-byte sequence, with a ping between fragments.
    u8[] text = [0x7A_u8, 0x61_u8, 0xC5_u8, 0xBC_u8, 0xC3_u8, 0xB3_u8, 0xC5_u8, 0x82_u8, 0xC4_u8, 0x87_u8];
    Assert.True(Sent(conn.SendFrame(false, 1_i64, Slice.SubSlice(text, 0_i64, 3_i64))), "first fragment");
    Assert.True(Sent(conn.Ping([1_u8, 2_u8, 3_u8])), "ping between fragments");
    Assert.True(Sent(conn.SendFrame(false, 0_i64, Slice.SubSlice(text, 3_i64, 4_i64))), "middle fragment");
    Assert.True(Sent(conn.SendFrame(true, 0_i64, Slice.SubSlice(text, 7_i64, 3_i64))), "last fragment");
    Assert.True(TextOf(conn.Receive()) == String.FromUtf8CodeUnits(text), "reassembled UTF-8 echo");
    Assert.Equal<i64>(conn.PongsReceived(), 1_i64, "pong consumed");
    Assert.True(Sent(conn.SendText("")), "empty text");
    Assert.True(TextOf(conn.Receive()) == "", "empty echo");
    Assert.True(Sent(conn.Close(3000_i64, "custom")), "close handshake");
    Assert.Equal<i64>(conn.CloseCodeReceived(), 3000_i64, "server echoed 3000");
    Assert.Equal<i64>(conn.State(), WsConnection.StateClosed(), "closed");
    Assert.False(Sent(conn.SendText("late")), "send after close fails");
    return;
}

unit RunConversation() {
    match TcpListener.Bind(Loopback4(0_i64), 4_i64) {
        Result::Error(_) => { Assert.Fail("bind"); },
        Result::Ok(listener) => { Conversation(listener); },
    };
    return;
}

unit Conversation(TcpListener listener) {
    match listener.LocalAddress() {
        Result::Error(_) => { Assert.Fail("address"); },
        Result::Ok(address) => {
            SocketAddress target = address;
            TcpListener l = listener;
            i64[] seen = [0_i64, 0_i64];
            WsOptions serverOptions = WsConnection.WithProtocols(WsConnection.DefaultOptions(), ["superchat", "chat"]);
            Fiber<unit> server = spawn (() => EchoOnce(l, serverOptions, seen));
            ConversationScenario(target, seen);
            server.Join();
            Assert.Equal<i64>(seen[0], 5_i64, "server saw 4 messages and a close");
            Assert.Equal<i64>(seen[1], 3000_i64, "server saw close 3000");
            l.Close();
        },
    };
    return;
}

test loopback_conversation {
    Fiber<unit> scenario = spawn RunConversation();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
}

// Server-initiated close with an empty payload: the client reports 1005 and echoes.
unit ServerCloses(TcpListener listener, i64[] seen) {
    match listener.Accept(Within(5000_i64)) {
        Result::Error(_) => { Assert.Fail("accept"); },
        Result::Ok(stream) => { ServerClosesOn(stream, seen); },
    };
    return;
}

unit ServerClosesOn(TcpStream stream, i64[] seen) {
    match WsConnection.Accept(stream, WsConnection.DefaultOptions()) {
        Result::Error(_) => { Assert.Fail("server handshake"); },
        Result::Ok(conn) => {
            Assert.True(Sent(conn.SendText("bye soon")), "server text");
            match conn.Close(0_i64, "") {
                Result::Ok(_) => { seen[0] = conn.CloseCodeReceived(); },
                Result::Error(e) => { seen[0] = -WsErrors.Code(e); },
            };
        },
    };
    return;
}

unit RunServerClose() {
    match TcpListener.Bind(Loopback4(0_i64), 4_i64) {
        Result::Error(_) => { Assert.Fail("bind"); },
        Result::Ok(listener) => { ServerCloseWith(listener); },
    };
    return;
}

string CloseText(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => CloseTextOf(m),
        Result::Error(e) => "<error " + Dec(WsErrors.Code(e)) + ">",
    };
}

string CloseTextOf(WsMessage m) { return match m { WsMessage::Close(code, reason) => Dec(code) + ":" + reason, _ => "<not close>", }; }

unit ServerCloseWith(TcpListener listener) {
    match listener.LocalAddress() {
        Result::Error(_) => { Assert.Fail("address"); },
        Result::Ok(address) => {
            SocketAddress target = address;
            TcpListener l = listener;
            i64[] seen = [0_i64];
            Fiber<unit> server = spawn (() => ServerCloses(l, seen));
            match Dial(target, WsConnection.DefaultOptions()) {
                Result::Error(_) => { Assert.Fail("client handshake"); },
                Result::Ok(conn) => {
                    Assert.True(TextOf(conn.Receive()) == "bye soon", "server text arrives");
                    Assert.True(CloseText(conn.Receive()) == "1005:", "empty close is 1005");
                    Assert.Equal<i64>(conn.State(), WsConnection.StateClosed(), "client closed");
                },
            };
            server.Join();
            Assert.Equal<i64>(seen[0], 1005_i64, "server got the empty echo");
            l.Close();
        },
    };
    return;
}

test loopback_server_initiated_close {
    Fiber<unit> scenario = spawn RunServerClose();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
}
