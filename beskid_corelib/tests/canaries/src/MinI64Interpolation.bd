/// Canary: Interpolating the minimum `i64` prints all its digits.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

test min_i64_interpolation {
    i64 min = -9223372036854775807_i64 - 1_i64;
    string s = "${min}";
    Assert.True(s == "-9223372036854775808", "minimum i64 prints in full");
}
