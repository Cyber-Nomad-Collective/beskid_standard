use Concurrency;
use Concurrency.Fiber;
use Core.Time;
use Core.Results;
use Network.Types;
use Network.Errors;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Connect;
use Connect.Policy;
use Testing.Assert;
use TestSupport;

// Refused first, good second: the refusal starts the next attempt at once,
// so the 2 s attempt delay is never waited for.
Result<unit, NetworkError> RefusedThenGoodResult()
{
    SocketAddress refused = ClosedPort4()?;
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress good = listener.LocalAddress()?;
    // The attempt delay is longer than the overall timeout, so a connection shows that the
    // second attempt did not wait for it.
    ConnectPolicy policy = Policy.WithAttemptDelay(Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(5000_i64)), Time.FromMilliseconds(60000_i64));
    match (Connect.ConnectAddresses(List2(refused, good), policy))
    {
        Result::Ok(stream) => {
            Assert.Equal<i64>(PeerPort(stream), good.port.Value(), "second address wins");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("refused-then-good falls back"),
    };
    listener.Close()?;
    return Result::Ok(());
}

unit RefusedThenGood()
{
    match (RefusedThenGoodResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("refused scenario has no NetworkError"),
    };
}

test FallbackRefusedFirstStartsNextImmediately
{
    Fiber<unit> scenario = spawn RefusedThenGood();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "refused scenario joins");
}

// Hanging first, good second: the second attempt starts after the attempt
// delay (not after the 5 s deadline) and the hanging attempt is cancelled.
Result<unit, NetworkError> HangingThenGoodResult()
{
    Blackhole hole = OpenBlackhole()?;
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress good = listener.LocalAddress()?;
    ConnectPolicy policy = Policy.WithAttemptDelay(Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(5000_i64)), Time.FromMilliseconds(150_i64));
    i64 before = Concurrency.NowMillis();
    match (Connect.ConnectAddresses(List2(hole.address, good), policy))
    {
        Result::Ok(stream) => {
            i64 elapsed = Concurrency.NowMillis() - before;
            Assert.True(elapsed >= 140_i64, "second attempt waits for the attempt delay");
            Assert.Equal<i64>(PeerPort(stream), good.port.Value(), "good address wins over the hanging one");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("hanging-then-good falls back"),
    };
    listener.Close()?;
    CloseBlackhole(hole);
    return Result::Ok(());
}

unit HangingThenGood()
{
    match (HangingThenGoodResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("hanging scenario has no NetworkError"),
    };
}

test FallbackHangingFirstIsRacedAfterAttemptDelay
{
    Fiber<unit> scenario = spawn HangingThenGood();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "hanging scenario joins");
}

// The attempt delay is clamped to at least 100 ms even when policy asks for less.
Result<unit, NetworkError> ClampedDelayResult()
{
    Blackhole hole = OpenBlackhole()?;
    TcpListener listener = TcpListener.Bind(Loopback4(0_i64), 8_i64)?;
    SocketAddress good = listener.LocalAddress()?;
    ConnectPolicy policy = Policy.WithAttemptDelay(Policy.WithTimeout(Policy.Default(), Time.FromMilliseconds(5000_i64)), Time.FromMilliseconds(1_i64));
    i64 before = Concurrency.NowMillis();
    match (Connect.ConnectAddresses(List2(hole.address, good), policy))
    {
        Result::Ok(stream) => {
            Assert.True(Concurrency.NowMillis() - before >= 90_i64, "attempt delay never drops below 100 ms");
            Exchange(listener, stream)?;
        },
        Result::Error(_) => Assert.Fail("clamped-delay race succeeds"),
    };
    listener.Close()?;
    CloseBlackhole(hole);
    return Result::Ok(());
}

unit ClampedDelay()
{
    match (ClampedDelayResult())
    {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("clamp scenario has no NetworkError"),
    };
}

test FallbackAttemptDelayHas100msFloor
{
    Fiber<unit> scenario = spawn ClampedDelay();
    Assert.True(match (scenario.Join())
    {
        Result::Ok(_) => true,
        _ => false,
    }, "clamp scenario joins");
}
