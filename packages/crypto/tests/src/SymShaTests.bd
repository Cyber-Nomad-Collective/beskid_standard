use Testing.Assert;
use Core.Bytes.Slice;
use Crypto.Sha256;
use Crypto.Sha512;
use TestSupport;
use Vectors;

u8[] ThousandA()
{
    return Slice.Fill(Slice.New(1000), 0, 1000, 97_u8);
}

mod Sha256Tests
{
    test MatchesFips180Examples
    {
        for v in Sha256Vectors()
        {
            Assert.True(Same(Sha256.Hash(v.message), Hex(v.digest)), v.label);
        }
    }

    test GivesTheSameDigestForEverySplitOfTheInput
    {
        u8[] m = Ascii(Fips180LongMessage());
        u8[] expected = Sha256.Hash(m);
        mut i64 split = 0;
        while (split <= Slice.Len(m))
        {
            Sha256State s = Sha256.New();
            Assert.True(Sha256.UpdateRange(s, m, 0, split), "first part");
            Assert.True(Sha256.UpdateRange(s, m, split, Slice.Len(m) - split), "second part");
            Assert.True(Same(Sha256.Finish(s), expected), "split");
            split = split + 7;
        }
    }

    test CloneSnapshotsTheStateAndFinishEndsIt
    {
        Sha256State s = Sha256.New();
        Sha256.Update(s, Ascii("ab"));
        Sha256State snap = Sha256.Clone(s);
        Sha256.Update(snap, Ascii("c"));
        Assert.True(Same(Sha256.Finish(snap), Sha256.Hash(Ascii("abc"))), "clone abc");
        Sha256.Update(s, Ascii("c"));
        Assert.True(Same(Sha256.Finish(s), Sha256.Hash(Ascii("abc"))), "original unaffected");
        Assert.False(Sha256.Update(s, Ascii("x")), "update after finish rejected");
    }

    test MatchesTheFips180MillionAExample
    {
        u8[] chunk = ThousandA();
        Sha256State s = Sha256.New();
        mut i64 i = 0;
        while (i < 1000)
        {
            Sha256.Update(s, chunk);
            i = i + 1;
        }
        Assert.True(Same(Sha256.Finish(s), Hex("cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")), "million a");
    }
}

mod Sha384Tests
{
    test MatchesFips180Examples
    {
        for v in Sha384Vectors()
        {
            Assert.True(Same(Sha512.Hash384(v.message), Hex(v.digest)), v.label);
        }
    }

    test GivesTheSameDigestForEverySplitOfTheInput
    {
        u8[] m = Ascii(Fips180LongMessage());
        u8[] expected = Sha512.Hash384(m);
        mut i64 split = 0;
        while (split <= Slice.Len(m))
        {
            Sha512State s = Sha512.New384();
            Sha512.UpdateRange(s, m, 0, split);
            Sha512.UpdateRange(s, m, split, Slice.Len(m) - split);
            Assert.True(Same(Sha512.Finish(s), expected), "split");
            split = split + 13;
        }
    }
}

mod Sha512Tests
{
    test MatchesFips180Examples
    {
        for v in Sha512Vectors()
        {
            Assert.True(Same(Sha512.Hash512(v.message), Hex(v.digest)), v.label);
        }
    }

    test MatchesTheFips180MillionAExample
    {
        u8[] chunk = ThousandA();
        Sha512State s = Sha512.New512();
        mut i64 i = 0;
        while (i < 1000)
        {
            Sha512.Update(s, chunk);
            i = i + 1;
        }
        Assert.True(Same(Sha512.Finish(s), Hex("e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")), "million a");
    }
}
