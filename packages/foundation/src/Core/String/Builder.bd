/// Core.String.Builder — incremental string construction.
/// @tier(supported)
/// Builders are values: every `Append*` returns the updated builder, and callers keep using the
/// returned value (`b = b.Append("x");`).
use Core.String.Core;
use Core.String.Transform;

pub type StringBuilder {
    string content,
    i64 length,

    /// Number of UTF-8 bytes appended so far.
    pub i64 Length() {
        return this.length;
    }

    /// Returns true when nothing has been appended.
    pub bool IsEmpty() {
        return this.length == 0;
    }

    /// Appends every byte of `text`.
    pub StringBuilder Append(string text) {
        return AppendText(this, text);
    }

    /// Appends `text` followed by a line feed.
    pub StringBuilder AppendLine(string text) {
        StringBuilder next = AppendText(this, text);
        return AppendCode(next, 10);
    }

    /// Appends one ASCII code unit (`0..=127`). Larger values are ignored because a lone byte
    /// above 127 is not valid UTF-8.
    pub StringBuilder AppendAscii(u8 code) {
        return AppendCode(this, code);
    }

    /// Appends the decimal form of `value`.
    pub StringBuilder AppendI64(i64 value) {
        return AppendText(this, DecimalText(value));
    }

    /// Appends `true` or `false`.
    pub StringBuilder AppendBool(bool value) {
        if value {
            return AppendText(this, "true");
        }
        return AppendText(this, "false");
    }

    /// Materializes the appended bytes as a string.
    pub string ToString() {
        return this.content;
    }
}

/// Appends through string concatenation, which the 0.5.2 runtime performs much faster than
/// growing a `u8[]` one element at a time.
StringBuilder AppendText(StringBuilder builder, string text) {
    string current = builder.content;
    string combined = Transform.Concat(current, text);
    i64 length = builder.length + Core.Len(text);
    return StringBuilder { content: combined, length: length };
}

/// Decimal text of `value`; the 0.5.2 runtime interpolates the minimum `i64` as `-` alone.
string DecimalText(i64 value) {
    if value == -9223372036854775807_i64 - 1_i64 {
        return "-9223372036854775808";
    }
    return "${value}";
}

StringBuilder AppendCode(StringBuilder builder, u8 code) {
    if code > 127 {
        return builder;
    }
    return AppendText(builder, Transform.FromAscii(code));
}

/// Creates an empty builder.
pub StringBuilder New() {
    return StringBuilder { content: "", length: 0 };
}

/// Creates a builder that starts with `text`.
pub StringBuilder From(string text) {
    return AppendText(New(), text);
}
