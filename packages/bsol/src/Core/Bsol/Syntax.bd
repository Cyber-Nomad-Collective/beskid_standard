/// Ordered typed syntax arena. Indices always refer to nodes in this document.
pub enum NodeKind
{
    Block,

    Assignment,

    Identifier,

    String,

    Number,

    Boolean,

    Reference,

    List,

    Map,

    Attribute,
}

pub type Span
{
    pub i64 start,

    pub i64 end,
}

pub type Trivia
{
    pub Span span,

    pub string raw,
}

pub type Node
{
    pub NodeKind kind,

    pub Span span,

    pub string raw,

    pub string text,

    pub string name,

    pub string label,

    pub bool hasLabel,

    pub bool schemaless,

    pub i64[] children,

    pub i64[] attributes,
}

pub type Document
{
    pub string source,

    pub Node[] nodes,

    pub i64[] roots,

    pub Trivia[] trivia,
}
