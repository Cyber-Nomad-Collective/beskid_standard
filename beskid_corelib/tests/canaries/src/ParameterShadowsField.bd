/// Canary: Inside a method, a parameter named like a field of `this` refers to the parameter.
/// On 0.5.2 the field silently wins, producing wrong results with no diagnostic.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

pub type Holder {
    string text,

    pub string Echo(string text) {
        return text;
    }
}

test method_parameter_shadows_field {
    Holder h = Holder { text: "field" };
    Assert.True(h.Echo("parameter") == "parameter", "parameter must win over the field");
}
