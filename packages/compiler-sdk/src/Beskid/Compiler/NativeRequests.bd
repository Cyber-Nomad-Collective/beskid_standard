// Native adapter factories are ordinary typed SDK source. The compiler selects
// their exact registered declarations and roots returned objects before another
// allocation. These functions do not authorize foreign pointers or source handles.
use Beskid.Compiler.Collect;
use Beskid.Compiler.Compilation;
use Beskid.Compiler.Workspace;
use Beskid.Compiler.ModCatalog;
use Beskid.Compiler.ModPackage;

pub Compilation CompilationValue(string projectName, string projectRoot, string targetTriple,
    u64 generation, string entryPath, string entryName, Beskid.Syntax.Nodes.NodeRef entryRoot) {
    return Compilation { activeProjectName: projectName, activeProjectRoot: projectRoot,
        targetTriple: targetTriple, syntaxGenerationId: generation,
        entrySourcePath: entryPath, entrySourceName: entryName, entryRoot: entryRoot };
}

pub WorkspaceMember MemberValue(string memberId, string projectName, string projectRoot,
    string sourceRoot) {
    return WorkspaceMember { memberId: memberId, projectName: projectName,
        projectRoot: projectRoot, sourceRoot: sourceRoot };
}

pub Workspace WorkspaceValue(string rootPath, WorkspaceMember[] members, string lockHash) {
    return Workspace { rootPath: rootPath, members: members, lockHash: lockHash };
}

pub ModContractRegistration RegistrationValue(string contractId, string typeId, string entrySymbol) {
    return ModContractRegistration { contractId: contractId, typeId: typeId, entrySymbol: entrySymbol };
}

pub ModPackage PackageValue(string packageId, string packageVersion, string projectName,
    string projectRoot, string sourceRoot, string manifestPath, string descriptorPath,
    string[] capabilities, ModContractRegistration[] registrations) {
    return ModPackage { packageId: packageId, packageVersion: packageVersion,
        projectName: projectName, projectRoot: projectRoot, sourceRoot: sourceRoot,
        manifestPath: manifestPath, descriptorPath: descriptorPath,
        capabilities: capabilities, registrations: registrations };
}

pub ModCatalog CatalogValue(ModPackage[] packages) {
    return ModCatalog { packages: packages };
}

pub CollectRequest CollectValue(Compilation compilation, Workspace workspace, ModCatalog catalog) {
    return CollectRequest { compilation: compilation, workspace: workspace, mods: catalog };
}

pub CollectTargetSet TargetsValue(string[] targetIds) {
    return CollectTargetSet { targetIds: targetIds };
}

pub GenerationRequest GenerationValue(CollectRequest context, CollectTargetSet targets) {
    return GenerationRequest { context: context, targets: targets };
}

pub AnalysisRequest AnalysisValue(CollectRequest context) {
    return AnalysisRequest { context: context };
}

pub AttributeGenerationRequest AttributeValue(CollectRequest context) {
    return AttributeGenerationRequest { context: context };
}


pub AttributeDeclarationSet AttributeDeclarationsValue(Beskid.Syntax.Nodes.SpannedAttributeDeclaration[] declarations) {
    return AttributeDeclarationSet { declarations: declarations };
}
