//! `QuerySuite`: the query tests of corelib_tests in one target, so the matrix lowers
//! the query closure once. Sections group the tests by area.

use Core.Collections.Array;
use Core.Optional.Option;
use Query.ArrayIterator;
use Query.Operators;
use Testing.Assert;

mod ArrayIteratorTests
{
    // Iterator-backed Query combinators over ArrayIterator.
    test HasNext
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 10);
        Array.Append<i64>(arr, 20);
        Array.Append<i64>(arr, 30);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.Equal(ArrayIterator.Remaining<i64>(it), 3, "iterator starts with full count");
    }

    test NextReturnsElements
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 42);
        Array.Append<i64>(arr, 99);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Option<i64> a = ArrayIterator.Current<i64>(it);
        Assert.True(Option.HasValue(a), "first element present");
        match (a)
        {
            Option::Some(v) => {
                Assert.Equal(v, 42, "first element is 42");
            },
            Option::None => { },
        };
    }

    test ExhaustionReturnsNone
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 7);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Option<i64> first = ArrayIterator.Current<i64>(it);
        it = ArrayIterator.MoveNext<i64>(it);
        Option<i64> second = ArrayIterator.Current<i64>(it);
        Assert.False(Option.HasValue(second), "second call on single-element returns None");
    }

    test ResetReplays
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 11);
        Array.Append<i64>(arr, 22);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64 v1 = ArrayIterator.Remaining<i64>(it);
        it = ArrayIterator.Reset<i64>(it);
        Assert.Equal(ArrayIterator.Remaining<i64>(it), v1, "reset restores remaining count");
    }
}

mod OperatorsTests
{
    test CountMatchesRemaining
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        Array.Append<i64>(arr, 3);
        Array.Append<i64>(arr, 4);
        Array.Append<i64>(arr, 5);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.Equal(Operators.Count<i64>(it), 5, "Count matches array length");
    }

    test TakeLimitsElements
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        Array.Append<i64>(arr, 3);
        Array.Append<i64>(arr, 4);
        Array.Append<i64>(arr, 5);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64[] taken = Operators.Take<i64>(it, 3);
        Assert.Equal(Array.Len<i64>(taken), 3, "Take limits to 3");
        Assert.Equal(Array.Get<i64>(taken, 0), 1, "first taken is 1");
    }

    test SkipDropsElements
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 10);
        Array.Append<i64>(arr, 20);
        Array.Append<i64>(arr, 30);
        Array.Append<i64>(arr, 40);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64[] skipped = Operators.Skip<i64>(it, 2);
        Assert.Equal(Array.Len<i64>(skipped), 2, "Skip leaves 2");
        Assert.Equal(Array.Get<i64>(skipped, 0), 30, "first after skip is 30");
    }

    test FirstReturnsHead
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 100);
        Array.Append<i64>(arr, 200);
        Array.Append<i64>(arr, 300);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Option<i64> first = Operators.First<i64>(it);
        Assert.True(Option.HasValue(first), "First returns value");
        match (first)
        {
            Option::Some(v) => {
                Assert.Equal(v, 100, "first element is 100");
            },
            Option::None => { },
        };
    }

    test LastReturnsTail
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        Array.Append<i64>(arr, 99);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Option<i64> last = Operators.Last<i64>(it);
        Assert.True(Option.HasValue(last), "Last returns value");
        match (last)
        {
            Option::Some(v) => {
                Assert.Equal(v, 99, "last element is 99");
            },
            Option::None => { },
        };
    }

    test AnyFindsMatchingElement
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 5);
        Array.Append<i64>(arr, 10);
        Array.Append<i64>(arr, 15);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.True(Operators.Any<i64>(it, 10), "Any finds 10");
    }

    test AllRequiresAllMatching
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 7);
        Array.Append<i64>(arr, 7);
        Array.Append<i64>(arr, 7);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.True(Operators.All<i64>(it, 7), "All seven");
    }

    test AllFailsMismatch
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 7);
        Array.Append<i64>(arr, 8);
        Array.Append<i64>(arr, 7);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.False(Operators.All<i64>(it, 7), "All fails with 8 present");
    }

    test IsEmptyOnExhausted
    {
        mut i64[] arr = Array.Empty<i64>();
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Assert.True(Operators.IteratorIsEmpty<i64>(it), "empty array iterator is empty");
    }

    test OrderByAscending
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 30);
        Array.Append<i64>(arr, 10);
        Array.Append<i64>(arr, 20);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64[] sorted = Operators.OrderBy(it, true);
        Assert.Equal(Array.Len<i64>(sorted), 3, "sorted length preserved");
        Assert.Equal(Array.Get<i64>(sorted, 0), 10, "first is smallest");
        Assert.Equal(Array.Get<i64>(sorted, 2), 30, "last is largest");
    }

    test OrderByDescending
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 10);
        Array.Append<i64>(arr, 30);
        Array.Append<i64>(arr, 20);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64[] sorted = Operators.OrderBy(it, false);
        Assert.Equal(Array.Get<i64>(sorted, 0), 30, "first is largest");
        Assert.Equal(Array.Get<i64>(sorted, 2), 10, "last is smallest");
    }

    test ToarrayCollectsAll
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        Array.Append<i64>(arr, 3);
        Array.Append<i64>(arr, 4);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64[] collected = Operators.ToArray<i64>(it);
        Assert.Equal(Array.Len<i64>(collected), 4, "ToArray preserves length");
    }

    test FoldI64Accumulates
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        Array.Append<i64>(arr, 3);
        Array.Append<i64>(arr, 4);
        mut ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        i64 sum = Operators.FoldI64(it, 0);
        Assert.Equal(sum, 10, "fold sum 1+2+3+4 = 10");
    }
}

mod ConformanceTests
{
    // `ArrayIterator<T>` conformance to the generic `Query.Iterator<T>` contract (`type Item`,
    // `This MoveNext()`), called with method syntax (`it.Current()`, `it.MoveNext()`). The
    // module-function form (`ArrayIterator.Current<T>(it)`) is covered by `QueryTests.bd`.
    test CurrentReturnsFirstElement
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 42);
        Array.Append<i64>(arr, 99);
        ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        Option<i64> first = it.Current();
        Assert.True(Option.HasValue(first), "Iterator<T> conformance: Current() returns Some for the first element");
        match (first)
        {
            Option::Some(v) => {
                Assert.Equal(v, 42, "first element via method dispatch is 42");
            },
            Option::None => { },
        };
    }

    test MovenextAdvancesAndReturnsThis
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 1);
        Array.Append<i64>(arr, 2);
        ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        ArrayIterator<i64> advanced = it.MoveNext();
        Option<i64> second = advanced.Current();
        Assert.True(Option.HasValue(second), "Iterator<T> conformance: MoveNext() advances (This-returning)");
        match (second)
        {
            Option::Some(v) => {
                Assert.Equal(v, 2, "second element after MoveNext is 2");
            },
            Option::None => { },
        };
    }

    test CurrentReturnsNonePastTheEnd
    {
        mut i64[] arr = Array.Empty<i64>();
        Array.Append<i64>(arr, 7);
        ArrayIterator<i64> it = ArrayIterator.Over<i64>(arr);
        ArrayIterator<i64> past = it.MoveNext();
        Option<i64> none = past.Current();
        Assert.False(Option.HasValue(none), "Iterator<T> conformance: Current() past the end is None");
    }
}
