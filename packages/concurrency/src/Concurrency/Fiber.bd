/// Cooperative fiber handle returned by `spawn`.
use Concurrency.FiberError;
use Concurrency.FiberJoinStatus;
use Core.Results;

/// Runtime fiber handle; declares cancellation event on the handle only.
pub type Fiber<T> {
    i64 handle,
    event OnCancelled(),
}

/// Waits for completion and returns the entry value or a `FiberError`.
/// The join status carries richer info: cancel reason/canceler, panic code/message,
/// and stack-overflow limit/requested bytes.
pub Core.Results.Result<T, FiberError> Join<T>(Fiber<T> self) {
    i64 raw = __fiber_join(self.handle);
    FiberJoinStatus status = FiberJoinStatus.FromCode(raw);
    return match status {
        FiberJoinStatus::Ok(_) => Result::Ok(__fiber_join_value(self.handle)),
        FiberJoinStatus::Cancelled(reason, cancelerId) => Result::Error(FiberError::Cancelled(reason, cancelerId)),
        FiberJoinStatus::StackOverflow(limitBytes, requestedBytes) => Result::Error(FiberError::StackOverflow(limitBytes, requestedBytes)),
        FiberJoinStatus::Panicked(code, message) => Result::Error(FiberError::Panicked(code, message)),
        FiberJoinStatus::NotDone => __panic_str("Fiber.Join saw NotDone"),
    };
}

/// Waives parent shutdown join; child panic still aborts the process in v1.
pub unit Detach<T>(Fiber<T> self) {
    __fiber_detach(self.handle);
    return;
}

/// Sets cancellation flag and raises `OnCancelled` on the child fiber.
/// The reason is stored in the fiber record and surfaced via `FiberError::Cancelled`.
pub unit Cancel<T>(Fiber<T> self, i64 reason) {
    __fiber_cancel(self.handle, reason);
    return;
}
