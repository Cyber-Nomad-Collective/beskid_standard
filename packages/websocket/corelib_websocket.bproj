corelib_websocket {
  name = "corelib_websocket"
  version = "0.1.0"
  root = "src"
  readme = "README.md"
}

dependency "corelib_foundation" { source = path path = "../foundation" }
dependency "corelib_network" { source = path path = "../network" }
dependency "corelib_uri" { source = path path = "../uri" }
dependency "corelib_codec" { source = path path = "../codec" }
dependency "corelib_connect" { source = path path = "../connect" }
dependency "corelib_crypto" { source = path path = "../crypto" }
dependency "corelib_x509" { source = path path = "../x509" }
dependency "corelib_tls" { source = path path = "../tls" }
target "WebSocketLib" { kind = Lib }
