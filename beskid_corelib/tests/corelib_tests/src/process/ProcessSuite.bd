//! `ProcessSuite`: typed child processes through the canonical runtime.
//! The child is the release fixture binary named by `BESKID_V06_RELEASE_FIXTURE`; every test fails closed
//! when the variable is absent. Fixture modes used here: `echo-argv-json <args...>` prints the arguments
//! after the mode as one compact JSON array and a newline; `cat-binary --chunk <n>` copies stdin to stdout
//! in writes of at most n bytes; `flood-stderr <bytes>` writes that many ASCII bytes to stderr; `exit <code>`
//! exits with the code; `sleep-forever` blocks until killed; `grandchild-inherits-pipes` starts a sleeping
//! grandchild that inherits its pipes and then blocks.

use Concurrency;
use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Environment;
use Core.IO.IoError;
use Core.IO.TransferFailure;
use Core.Optional;
use Core.Process;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Testing.Assert;

string Fixture()
{
    return match (Environment.Get("BESKID_V06_RELEASE_FIXTURE"))
    {
        Result::Ok(path) => path,
        Result::Error(_) => {
            Assert.Fail("BESKID_V06_RELEASE_FIXTURE must name the release fixture binary");
            return "";
        },
    };
}

Deadline DeadlineIn(i64 milliseconds)
{
    return match (Deadline.After(Time.FromMilliseconds(milliseconds)))
    {
        Result::Ok(deadline) => deadline,
        Result::Error(_) => {
            Assert.Fail("bounded monotonic deadline");
            return DeadlineIn(milliseconds);
        },
    };
}

ChildProcess Start(move string[] arguments)
{
    return match (Process.Spawn(ProcessStartInfo
    {
        executable: Fixture(),
        arguments: arguments,
        environment: EnvironmentPolicy::Inherit,
        cwd: "",
    }))
    {
        Result::Ok(child) => child,
        Result::Error(_) => {
            Assert.Fail("release fixture child starts");
            return Start(["exit", "0"]);
        },
    };
}

string ErrorName(ProcessError error)
{
    return match (error)
    {
        ProcessError::NotFound(executable) => "NotFound",
        ProcessError::PermissionDenied(executable) => "PermissionDenied",
        // The message carries the OS error code of a failed spawn, so a failing case names it.
        ProcessError::IOError(message) => "IOError(" + message + ")",
        ProcessError::InvalidInput => "InvalidInput",
        ProcessError::Cancelled => "Cancelled",
        ProcessError::TimedOut => "TimedOut",
        ProcessError::Closed => "Closed",
        ProcessError::Busy => "Busy",
        ProcessError::CleanupFailed => "CleanupFailed",
        ProcessError::Unsupported => "Unsupported",
    };
}

/// Compact JSON string of `text`: only quote and backslash need escaping for these fixture arguments;
/// UTF-8 is copied unchanged, as the fixture's serializer does.
string JsonString(string text)
{
    mut u8[] bytes = [34_u8];
    mut i64 index = 0_i64;
    while (index < String.Len(text))
    {
        u8 byte = String.ByteAt(text, index);
        if (byte == 34_u8 || byte == 92_u8)
        {
            Array.Append<u8>(bytes, 92_u8);
        }
        Array.Append<u8>(bytes, byte);
        index = index + 1_i64;
    }
    Array.Append<u8>(bytes, 34_u8);
    return String.FromUtf8CodeUnits(bytes);
}

test ProcessSpawnPassesUnicodeSpaceQuoteAndShellMetacharacterArgvExactly
{
    string[] passed = ["plain", "two words", "zażółć 🙂", "$(echo injected); rm -rf / | & > <", "*?[]", "quote\"and'apostrophe", "back\\slash", ""];
    mut string[] arguments = ["echo-argv-json"];
    mut string expected = "[";
    mut i64 index = 0_i64;
    while (index < Array.Len<string>(passed))
    {
        Array.Append<string>(arguments, passed[index]);
        if (index > 0_i64)
        {
            expected = expected + ",";
        }
        expected = expected + JsonString(passed[index]);
        index = index + 1_i64;
    }
    expected = expected + "]" + String.FromUtf8CodeUnits([10_u8]);
    match (Process.Run(Fixture(), arguments))
    {
        Result::Error(error) => Assert.Fail("argv fixture runs: " + ErrorName(error)),
        Result::Ok(output) => {
            Assert.Equal(output.exitCode, 0_i64, "argv fixture exits successfully");
            Assert.Equal(output.stdout, expected, "every argument, including the empty one, reaches the child exactly, without shell expansion or splitting");
        },
    };
}

test ProcessBinaryStdinStdoutRoundtripWithPartialTransfersPreservesOrder
{
    i64 total = 204800_i64;
    mut u8[] source = [];
    mut i64 index = 0_i64;
    while (index < total)
    {
        Array.Append<u8>(source, u8((index * 31_i64 + 7_i64) % 256_i64));
        index = index + 1_i64;
    }
    ChildProcess child = Start(["cat-binary", "--chunk", "7"]);
    ProcessWriter input = child.Stdin();
    ProcessReader output = child.Stdout();
    mut u8[] received = [];
    u8[] buffer = Slice.New(4096_i64);
    mut i64 written = 0_i64;
    mut i64 reads = 0_i64;
    mut bool inputClosed = false;
    mut bool eof = false;
    while (!eof)
    {
        mut bool progressed = false;
        if (written < total)
        {
            mut i64 count = total - written;
            if (count > 65536_i64)
            {
                count = 65536_i64;
            }
            match (input.TryWrite(source, written, count))
            {
                Result::Error(_) => Assert.Fail("stdin write to a live child"),
                Result::Ok(sent) => match (sent)
                {
                    Option::Some(bytes) => {
                        if (bytes > 0_i64)
                        {
                            written = written + bytes;
                            progressed = true;
                        }
                    },
                    // A pending write: the child is not ready for input yet.
                    Option::None => { },
                },
            };
        }
        else
        {
            if (!inputClosed)
            {
                Assert.True(Results.IsOk(input.Close()), "closing stdin signals end of input");
                inputClosed = true;
                progressed = true;
            }
        }
        match (output.TryRead(buffer, 0_i64, 4096_i64))
        {
            Result::Error(_) => Assert.Fail("stdout read from a live child"),
            Result::Ok(read) => {
                match (read)
                {
                    // 0 is end of stream.
                    Option::Some(bytes) => {
                        if (bytes == 0_i64)
                        {
                            eof = true;
                        }
                        mut i64 copied = 0_i64;
                        while (copied < bytes)
                        {
                            Array.Append<u8>(received, buffer[copied]);
                            copied = copied + 1_i64;
                        }
                        if (bytes > 0_i64)
                        {
                            reads = reads + 1_i64;
                            progressed = true;
                        }
                    },
                    // Pending readiness: no output is available yet.
                    Option::None => { },
                };
            },
        };
        if (!progressed && !eof)
        {
            match (Process.WaitReady(DeadlineIn(50_i64)))
            {
                Result::Ok(_) => { },
                Result::Error(error) => Assert.Equal(ErrorName(error), "TimedOut", "readiness wait only expires"),
            };
        }
    }
    Assert.Equal(Array.Len<u8>(received), total, "every byte crosses both pipes");
    Assert.True(reads > 1_i64, "the transfer is observed as several partial reads");
    index = 0_i64;
    mut i64 mismatches = 0_i64;
    while (index < total)
    {
        if (received[index] != source[index])
        {
            mismatches = mismatches + 1_i64;
        }
        index = index + 1_i64;
    }
    Assert.Equal(mismatches, 0_i64, "binary bytes, including NUL, CR, LF and 0x1A, keep their order");
    match (child.Wait(DeadlineIn(10000_i64)))
    {
        Result::Error(error) => Assert.Fail("binary fixture exits: " + ErrorName(error)),
        Result::Ok(exit) => Assert.Equal(exit.exitCode, 0_i64, "binary fixture exits successfully"),
    };
    Assert.True(Results.IsOk(child.Close()), "child resources are released");
}

test ProcessStderrFloodIsDrainedConcurrentlyWithoutDeadlock
{
    match (Process.Run(Fixture(), ["flood-stderr", "1048576"]))
    {
        Result::Error(error) => Assert.Fail("stderr flood completes: " + ErrorName(error)),
        Result::Ok(output) => {
            Assert.Equal(String.Len(output.stderr), 1048576_i64, "all of stderr is captured while stdout is also drained");
            Assert.Equal(output.stdout, "", "stdout stays separate from stderr");
            Assert.Equal(output.exitCode, 0_i64, "flood fixture exits successfully");
        },
    };
}

test ProcessWaitReturnsExitCodeAndRunReportsTypedExitAndMissingExecutable
{
    ChildProcess child = Start(["exit", "3"]);
    match (child.Wait(DeadlineIn(10000_i64)))
    {
        Result::Error(error) => Assert.Fail("exited child is waited: " + ErrorName(error)),
        Result::Ok(exit) => Assert.Equal(exit.exitCode, 3_i64, "Wait returns the child's exit code"),
    };
    Assert.True(Results.IsOk(child.Close()), "a reaped child closes cleanly");
    match (Process.Run(Fixture(), ["exit", "7"]))
    {
        Result::Error(error) => Assert.Fail("a child that ran is Ok whatever its exit code, not " + ErrorName(error)),
        Result::Ok(output) => Assert.Equal(output.exitCode, 7_i64, "Run reports the nonzero exit code in the output"),
    };
    match (Process.Run(Fixture(), ["exit", "0"]))
    {
        Result::Error(error) => Assert.Fail("a zero exit is success: " + ErrorName(error)),
        Result::Ok(output) => Assert.Equal(output.exitCode, 0_i64, "zero exit code"),
    };
    match (Process.Run(Fixture() + ".missing", ["exit", "0"]))
    {
        Result::Ok(_) => Assert.Fail("a missing executable cannot run"),
        Result::Error(error) => Assert.Equal(ErrorName(error), "NotFound", "a missing executable is the typed NotFound error"),
    };
}

test ProcessWaitDeadlineExpiryIsTimedOutAndCloseReaps
{
    ChildProcess child = Start(["sleep-forever"]);
    match (child.Wait(DeadlineIn(200_i64)))
    {
        Result::Ok(_) => Assert.Fail("a sleeping child does not exit before the deadline"),
        Result::Error(error) => Assert.Equal(ErrorName(error), "TimedOut", "deadline expiry is TimedOut, distinct from Cancelled"),
    };
    Assert.True(Results.IsOk(child.Close()), "Close terminates and reaps the expired child");
}

test ProcessTerminateAndCloseReapTheChildTree
{
    ChildProcess child = Start(["sleep-forever"]);
    Assert.True(Results.IsOk(child.Terminate()), "Terminate is delivered to a live child");
    match (child.Wait(DeadlineIn(60000_i64)))
    {
        Result::Ok(_) => { },
        Result::Error(error) => Assert.True(ErrorName(error) != "TimedOut", "a terminated child is reaped, it does not keep running"),
    };
    Assert.True(Results.IsOk(child.Close()), "the terminated child closes cleanly");
    ChildProcess tree = Start(["grandchild-inherits-pipes"]);
    // Give the child time to start its grandchild, so Close has a tree to reap.
    Time.Sleep(Time.FromMilliseconds(200_i64));
    Assert.True(Results.IsOk(tree.Close()), "Close terminates the contained tree, including a grandchild holding the pipes");
}

test ProcessCloseIsIdempotentThroughAliases
{
    ChildProcess child = Start(["sleep-forever"]);
    ChildProcess alias = child;
    Assert.True(Results.IsOk(child.Close()), "first Close settles the child");
    Assert.True(Results.IsOk(alias.Close()), "Close through an alias of a closed child is a no-op success");
    Assert.True(Results.IsOk(child.Close()), "repeated Close stays a no-op success");
    ChildProcess finished = Start(["exit", "0"]);
    Assert.True(Results.IsOk(finished.Stdin().Close()), "first stdin close");
    Assert.True(Results.IsOk(finished.Stdin().Close()), "second stdin close is a no-op success");
    Assert.True(Results.IsOk(finished.Close()), "the child closes after its pipes");
}

test ProcessFailedSpawnSetupLeavesNoChildAndLaterSpawnsSucceed
{
    match (Process.Spawn(ProcessStartInfo
    {
        executable: Fixture() + ".missing",
        arguments: ["exit", "0"],
        environment: EnvironmentPolicy::Inherit,
        cwd: "",
    }))
    {
        Result::Ok(child) => {
            child.Close();
            Assert.Fail("a missing executable cannot start");
        },
        Result::Error(error) => Assert.Equal(ErrorName(error), "NotFound", "missing executable fails during setup with NotFound"),
    };
    string withNul = String.FromUtf8CodeUnits([97_u8, 0_u8, 98_u8]);
    match (Process.Spawn(ProcessStartInfo
    {
        executable: Fixture(),
        arguments: ["echo-argv-json", withNul],
        environment: EnvironmentPolicy::Inherit,
        cwd: "",
    }))
    {
        Result::Ok(child) => {
            child.Close();
            Assert.Fail("an argument containing NUL cannot be passed exactly");
        },
        Result::Error(error) => Assert.Equal(ErrorName(error), "InvalidInput", "an unrepresentable argument fails setup with InvalidInput"),
    };
    mut i64 round = 0_i64;
    while (round < 3_i64)
    {
        match (Process.Run(Fixture(), ["exit", "0"]))
        {
            Result::Error(error) => Assert.Fail("spawning works after failed setups: " + ErrorName(error)),
            Result::Ok(output) => Assert.Equal(output.exitCode, 0_i64, "later child exits successfully"),
        };
        round = round + 1_i64;
    }
}

test ProcessSpawnFailureWithAnOsErrorIsTypedAndNamesTheCode
{
    // A missing working directory fails child creation itself: POSIX chdir reports ENOENT, the typed
    // NotFound; CreateProcessW reports ERROR_DIRECTORY, an IOError that must name the OS error code.
    string missing = Fixture() + ".missing-directory";
    match (Process.Spawn(ProcessStartInfo
    {
        executable: Fixture(),
        arguments: ["exit", "0"],
        environment: EnvironmentPolicy::Inherit,
        cwd: missing,
    }))
    {
        Result::Ok(child) => {
            child.Close();
            Assert.Fail("a missing working directory cannot start a child");
        },
        Result::Error(error) => match (error)
        {
            ProcessError::NotFound(executable) => { },
            ProcessError::IOError(message) => Assert.True(String.StartsWith(message, "child process spawn failed: OS error "), "the spawn IOError names the OS error code, not " + message),
            _ => Assert.Fail("a missing working directory is NotFound or an OS-coded IOError, not " + ErrorName(error)),
        },
    };
    match (Process.Run(Fixture(), ["exit", "0"]))
    {
        Result::Error(error) => Assert.Fail("spawning works after an OS-level spawn failure: " + ErrorName(error)),
        Result::Ok(output) => Assert.Equal(output.exitCode, 0_i64, "later child exits successfully"),
    };
}

// ---- Run keeps the output of a failing child, PATH lookup, readable errors ----

test RunKeepsStderrOfAChildThatExitsNonzero
{
    match (Process.Run(Fixture(), ["no-such-mode"]))
    {
        Result::Error(error) => Assert.Fail("a child that ran is Ok: " + Process.Message(error)),
        Result::Ok(output) => {
            Assert.Equal(output.exitCode, 64_i64, "the fixture's usage exit code is reported");
            Assert.True(String.Contains(output.stderr, "unknown mode"), "stderr of the failing child is kept");
            Assert.Equal(output.stdout, "", "stdout is kept (empty here) and separate from stderr");
        },
    };
}

i64 LastSeparator(string path)
{
    mut i64 last = -1_i64;
    mut i64 index = 0_i64;
    while (index < String.Len(path))
    {
        u8 code = String.ByteAt(path, index);
        if (code == 47_u8 || code == 92_u8)
        {
            last = index;
        }
        index = index + 1_i64;
    }
    return last;
}

test SpawnResolvesABareNameThroughPath
{
    string fixture = Fixture();
    i64 separator = LastSeparator(fixture);
    Assert.True(separator > 0_i64, "the fixture path names a directory");
    string directory = String.SubSlice(fixture, 0_i64, separator);
    string name = String.SubSlice(fixture, separator + 1_i64, String.Len(fixture) - separator - 1_i64);
    EnvironmentEntry[] path = [EnvironmentEntry
    {
        key: "PATH",
        value: directory,
    }];
    match (Process.Spawn(ProcessStartInfo
    {
        executable: name,
        arguments: ["exit", "5"],
        environment: EnvironmentPolicy::Extend(path),
        cwd: "",
    }))
    {
        Result::Error(error) => Assert.Fail("a bare name on PATH starts: " + Process.Message(error)),
        Result::Ok(child) => {
            match (child.Wait(DeadlineIn(10000_i64)))
            {
                Result::Ok(exit) => Assert.Equal(exit.exitCode, 5_i64, "the PATH-resolved child ran"),
                Result::Error(error) => Assert.Fail("the PATH-resolved child is waited: " + Process.Message(error)),
            };
            Assert.True(Results.IsOk(child.Close()), "the child closes");
        },
    };
    EnvironmentEntry[] same = [EnvironmentEntry
    {
        key: "PATH",
        value: directory,
    }];
    match (Process.Spawn(ProcessStartInfo
    {
        executable: "beskid-no-such-program",
        arguments: ["exit", "0"],
        environment: EnvironmentPolicy::Extend(same),
        cwd: "",
    }))
    {
        Result::Ok(child) => {
            child.Close();
            Assert.Fail("a name on no PATH entry cannot start");
        },
        Result::Error(error) => Assert.Equal(ErrorName(error), "NotFound", "a bare name on no PATH entry is NotFound"),
    };
}

test ProcessErrorMessageIsReadable
{
    Assert.Equal(Process.Message(ProcessError::NotFound("tool")), "executable not found: tool", "NotFound names the executable");
    Assert.Equal(Process.Message(ProcessError::IOError("child process spawn failed: OS error 2")), "child process spawn failed: OS error 2", "IOError is its message");
    Assert.Equal(Process.Message(ProcessError::TimedOut), "child process operation timed out", "unit variants have fixed text");
}

unit TickUntilStopped(i64[] state)
{
    while (Array.Get<i64>(state, 1_i64) == 0_i64)
    {
        Array.Set<i64>(state, 0_i64, Array.Get<i64>(state, 0_i64) + 1_i64);
        Concurrency.Yield();
    }
    return;
}

test RunInTheRootFiberLetsOtherFibersRun
{
    // state[0] counts ticks, state[1] stops the ticker.
    i64[] state = [0_i64, 0_i64];
    Fiber<unit> ticker = spawn (() => TickUntilStopped(state));
    match (Process.Run(Fixture(), ["exit", "0"]))
    {
        Result::Error(error) => Assert.Fail("the child runs: " + Process.Message(error)),
        Result::Ok(output) => Assert.Equal(output.exitCode, 0_i64, "the child exits successfully"),
    };
    Assert.True(Array.Get<i64>(state, 0_i64) > 0_i64, "another fiber ran while the root waited for its child");
    Array.Set<i64>(state, 1_i64, 1_i64);
    match (ticker.Join())
    {
        Result::Ok(_) => Assert.True(true, "the ticker stops"),
        Result::Error(_) => Assert.Fail("the ticker must stop"),
    };
}

// ---- Deadline-bound pipes, SpawnUntil and CloseUntil ----

/// Reads `reader` to end of stream; fails the test on a read error.
string ReadToEnd(ProcessReader reader)
{
    u8[] buffer = Slice.New(256_i64);
    mut u8[] collected = [];
    mut bool open = true;
    while (open)
    {
        match (reader.Read(buffer, 0_i64, 256_i64))
        {
            Result::Ok(count) => {
                if (count == 0_i64)
                {
                    open = false;
                }
                mut i64 index = 0_i64;
                while (index < count)
                {
                    Array.Append<u8>(collected, buffer[index]);
                    index = index + 1_i64;
                }
            },
            Result::Error(_) => {
                Assert.Fail("pipe read before end of stream");
                open = false;
            },
        };
    }
    return String.FromUtf8CodeUnits(collected);
}

test StdoutUntilTimesOutWhenTheChildWritesNothing
{
    ChildProcess child = Start(["sleep-forever"]);
    u8[] buffer = Slice.New(16_i64);
    match (child.StdoutUntil(DeadlineIn(100_i64)).Read(buffer, 0_i64, 16_i64))
    {
        Result::Ok(count) => Assert.Fail("a sleeping child writes nothing, read ${count} bytes"),
        Result::Error(error) => match (error)
        {
            IoError::ReadFailed(TransferFailure::TimedOut) => { },
            _ => Assert.Fail("an expired read deadline is ReadFailed(TimedOut)"),
        },
    };
    Assert.True(Results.IsOk(child.Close()), "the sleeping child closes");
}

test StdinUntilAndStdoutUntilRoundTripThroughTheChild
{
    ChildProcess child = Start(["cat-binary", "--chunk", "2"]);
    ProcessWriter input = child.StdinUntil(DeadlineIn(60000_i64));
    u8[] payload = [104_u8, 101_u8, 108_u8, 108_u8, 111_u8];
    mut i64 written = 0_i64;
    while (written < 5_i64)
    {
        match (input.Write(payload, written, 5_i64 - written))
        {
            Result::Ok(count) => {
                written = written + count;
            },
            Result::Error(_) => {
                Assert.Fail("a bounded stdin write to a live child");
                written = 5_i64;
            },
        };
    }
    Assert.True(Results.IsOk(input.Close()), "closing stdin ends the input");
    Assert.Equal(ReadToEnd(child.StdoutUntil(DeadlineIn(60000_i64))), "hello", "the child copies stdin to stdout");
    match (child.Wait(DeadlineIn(60000_i64)))
    {
        Result::Ok(exit) => Assert.Equal(exit.exitCode, 0_i64, "the copy fixture exits successfully"),
        Result::Error(error) => Assert.Fail("the copy fixture is waited: " + ErrorName(error)),
    };
    Assert.True(Results.IsOk(child.Close()), "the child closes");
}

test StderrAndStderrUntilReadOnlyTheErrorStream
{
    ChildProcess child = Start(["flood-stderr", "10"]);
    Assert.Equal(String.Len(ReadToEnd(child.Stderr())), 10_i64, "Stderr reads every byte the child wrote to stderr");
    Assert.Equal(ReadToEnd(child.Stdout()), "", "stdout carries nothing");
    Assert.True(Results.IsOk(child.Close()), "the child closes");
    ChildProcess bounded = Start(["flood-stderr", "300"]);
    Assert.Equal(String.Len(ReadToEnd(bounded.StderrUntil(DeadlineIn(60000_i64)))), 300_i64, "StderrUntil reads across several buffers");
    Assert.True(Results.IsOk(bounded.Close()), "the child closes");
}

test SpawnUntilStartsAChildAndReportsAMissingExecutable
{
    match (Process.SpawnUntil(ProcessStartInfo
    {
        executable: Fixture(),
        arguments: ["exit", "4"],
        environment: EnvironmentPolicy::Inherit,
        cwd: "",
    }, DeadlineIn(60000_i64)))
    {
        Result::Error(error) => Assert.Fail("SpawnUntil starts the fixture: " + ErrorName(error)),
        Result::Ok(child) => {
            match (child.Wait(DeadlineIn(60000_i64)))
            {
                Result::Ok(exit) => Assert.Equal(exit.exitCode, 4_i64, "the child's exit code"),
                Result::Error(error) => Assert.Fail("the child is waited: " + ErrorName(error)),
            };
            Assert.True(Results.IsOk(child.Close()), "the child closes");
        },
    };
    match (Process.SpawnUntil(ProcessStartInfo
    {
        executable: Fixture() + ".missing",
        arguments: ["exit", "0"],
        environment: EnvironmentPolicy::Inherit,
        cwd: "",
    }, DeadlineIn(60000_i64)))
    {
        Result::Ok(child) => {
            child.Close();
            Assert.Fail("a missing executable cannot start");
        },
        Result::Error(error) => Assert.Equal(ErrorName(error), "NotFound", "SpawnUntil reports NotFound like Spawn"),
    };
}

test CloseUntilReapsALiveChildAndIsIdempotent
{
    ChildProcess child = Start(["sleep-forever"]);
    Assert.True(Results.IsOk(child.CloseUntil(DeadlineIn(60000_i64))), "CloseUntil terminates and reaps a live child");
    Assert.True(Results.IsOk(child.CloseUntil(DeadlineIn(60000_i64))), "a second CloseUntil is a no-op success");
    Assert.True(Results.IsOk(child.Close()), "Close after CloseUntil is a no-op success");
}
