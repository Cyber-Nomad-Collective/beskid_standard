/// Canary: Array literals of enum values lower.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Collections.Array;

pub enum Shape {
    Dot,
    Line(i64 length),
}

test enum_values_in_array_literal {
    Shape[] shapes = [Shape::Dot, Shape::Line(3)];
    Assert.True(Array.Len<Shape>(shapes) == 2, "array literal of enum values");
}
