// WORKAROUND: allocate small and reuse. Four live 16 KiB arrays (64 KiB total) plus a reused 16 KiB scratch.
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Output;
use Testing.Assert;

pub type Blob { pub u8[] data, }

test small_live_arrays_work {
    mut Blob[] keep = Array.Empty<Blob>();
    mut i64 i = 0_i64;
    while i < 4_i64 {
        Array.Append<Blob>(keep, Blob { data: Slice.New(16384_i64) });
        i = i + 1_i64;
    }
    Output.WriteLine("workaround: kept 4 live 16 KiB arrays");
    Assert.Equal<i64>(Array.Len<Blob>(keep), 4_i64, "kept 4 arrays");
}
