/// Checked independent syntax, output, scalar and resolved-schema budgets.
pub type BsolLimits
{
    pub i64 maxInputBytes,

    pub i64 maxOutputBytes,

    pub i64 maxDepth,

    pub i64 maxNodes,

    pub i64 maxScalarBytes,

    pub i64 maxImports,

    pub i64 maxImportDepth,

    pub i64 maxResolvedSchemaBytes,
}

pub BsolLimits DefaultLimits()
{
    return BsolLimits
    {
        maxInputBytes: 8388608_i64,

        maxOutputBytes: 8388608_i64,

        maxDepth: 128_i64,

        maxNodes: 100000_i64,

        maxScalarBytes: 1048576_i64,

        maxImports: 256_i64,

        maxImportDepth: 32_i64,

        maxResolvedSchemaBytes: 8388608_i64,
    };
}

pub bool Valid(BsolLimits limits)
{
    return limits.maxInputBytes >= 0_i64 && limits.maxOutputBytes >= 0_i64 && limits.maxDepth >= 1_i64 && limits.maxNodes >= 1_i64 && limits.maxScalarBytes >= 0_i64 && limits.maxImports >= 0_i64 && limits.maxImportDepth >= 0_i64 && limits.maxResolvedSchemaBytes >= 0_i64;
}

/// A fresh descriptor admits already-bounded generated output without changing caller input policy.
pub BsolLimits OutputParseLimits(BsolLimits limits)
{
    return BsolLimits
    {
        maxInputBytes: limits.maxOutputBytes,

        maxOutputBytes: limits.maxOutputBytes,

        maxDepth: limits.maxDepth,

        maxNodes: limits.maxNodes,

        maxScalarBytes: limits.maxScalarBytes,

        maxImports: limits.maxImports,

        maxImportDepth: limits.maxImportDepth,

        maxResolvedSchemaBytes: limits.maxResolvedSchemaBytes,
    };
}
