/// Canary: Nested field access lowers through a generic struct field and through cross-module
/// struct types (`this.table.count`, `value.time.hour`).
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;
use Core.Time.Date;
use Core.Time.DateTime;
use Core.Time.TimeOfDay;

pub type Inner<T> {
    T[] items,
    i64 count,
}

pub type Outer<T> {
    Inner<T> inner,

    pub i64 Count() {
        return this.inner.count;
    }
}

test nested_field_through_generic_field {
    Outer<i64> o = Outer<i64> { inner: Inner<i64> { items: [1_i64], count: 1 } };
    Assert.True(o.Count() == 1, "this.inner.count");
}

test nested_field_through_module_types {
    DateTime value = DateTime { date: Date { year: 2026, month: 10, day: 7 }, time: TimeOfDay { hour: 12, minute: 0, second: 0, nanosecond: 0 } };
    Assert.True(value.time.hour == 12, "value.time.hour");
}
