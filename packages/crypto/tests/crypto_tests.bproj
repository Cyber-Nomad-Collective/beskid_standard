crypto_tests {
  name = "crypto_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "SymSha" { kind = Lib entry = "SymShaTests.bd" }
target "SymSha1" { kind = Lib entry = "SymSha1Tests.bd" }
target "SymHmacHkdf" { kind = Lib entry = "SymHmacHkdfTests.bd" }
target "SymChaCha" { kind = Lib entry = "SymChaChaTests.bd" }
target "SymAes" { kind = Lib entry = "SymAesTests.bd" }
target "SymLongVectors" { kind = Lib entry = "SymLongVectorsTests.bd" }
target "SymInPlaceRecords" { kind = Lib entry = "SymInPlaceRecordTests.bd" }
target "SymEntropy" { kind = Lib entry = "SymEntropyTests.bd" }
target "SymConstantTime" { kind = Lib entry = "SymConstantTimeTests.bd" }
target "Provider" { kind = Lib entry = "ProviderTests.bd" }
target "PkBigNatTests" { kind = Lib entry = "PkBigNatTests.bd" }
target "PkX25519Tests" { kind = Lib entry = "PkX25519Tests.bd" }
target "PkX25519IterTests" { kind = Lib entry = "PkX25519IterTests.bd" }
target "PkP256Tests" { kind = Lib entry = "PkP256Tests.bd" }
target "PkEcdsaTests" { kind = Lib entry = "PkEcdsaTests.bd" }
target "PkRsaTests" { kind = Lib entry = "PkRsaTests.bd" }
target "PkAdapterTests" { kind = Lib entry = "PkAdapterTests.bd" }
