/// Core.String search, transform, and builder tests.

use Testing.Assert;
use Core.Collections.Array;
use Core.String;
use Core.String.Builder;

test string_starts_ends_with {
    Assert.True(String.StartsWith("beskid", "bes"), "prefix matches");
    Assert.True(String.StartsWith("beskid", ""), "empty prefix matches");
    Assert.False(String.StartsWith("be", "bes"), "longer prefix misses");
    Assert.True(String.EndsWith("beskid", "kid"), "suffix matches");
    Assert.False(String.EndsWith("beskid", "bes"), "wrong suffix misses");
}

test string_index_and_last_index {
    Assert.Equal(String.IndexOf("abcabc", "bc"), 1, "first occurrence");
    Assert.Equal(String.LastIndexOf("abcabc", "bc"), 4, "last occurrence");
    Assert.Equal(String.LastIndexOf("abc", "x"), -1, "missing needle");
    Assert.Equal(String.LastIndexOf("abc", ""), 3, "empty needle matches at end");
}

test string_count_non_overlapping {
    Assert.Equal(String.Count("aaaa", "aa"), 2, "non-overlapping count");
    Assert.Equal(String.Count("abc", ""), 0, "empty needle counts zero");
}

test string_compare_ordinal {
    Assert.Equal(String.Compare("apple", "banana"), -1, "a before b");
    Assert.Equal(String.Compare("b", "a"), 1, "b after a");
    Assert.Equal(String.Compare("ab", "abc"), -1, "prefix sorts first");
    Assert.Equal(String.Compare("same", "same"), 0, "equal strings");
    Assert.True(String.Less("Z", "a"), "uppercase ASCII sorts before lowercase");
}

test string_is_blank {
    Assert.True(String.IsBlank(""), "empty is blank");
    Assert.True(String.IsBlank(" " + String.Tab() + String.Newline()), "whitespace is blank");
    Assert.False(String.IsBlank(" x "), "text is not blank");
}

test string_split_keeps_empty_fields {
    string[] parts = String.Split("a,,b,", ",");
    Assert.Equal(Array.Len<string>(parts), 4, "n separators give n + 1 parts");
    Assert.Equal(Array.Get<string>(parts, 0), "a", "first field");
    Assert.Equal(Array.Get<string>(parts, 1), "", "empty middle field");
    Assert.Equal(Array.Get<string>(parts, 2), "b", "third field");
    Assert.Equal(Array.Get<string>(parts, 3), "", "empty trailing field");
}

test string_split_multibyte_separator_and_empty_separator {
    string[] parts = String.Split("x::y", "::");
    Assert.Equal(Array.Len<string>(parts), 2, "two parts");
    Assert.Equal(Array.Get<string>(parts, 1), "y", "second part");
    string[] whole = String.Split("xy", "");
    Assert.Equal(Array.Len<string>(whole), 1, "empty separator returns input");
}

test string_lines_strip_cr_and_trailing_newline {
    string nl = String.Newline();
    string cr = String.FromAscii(13);
    string[] lines = String.Lines("one" + cr + nl + "two" + nl);
    Assert.Equal(Array.Len<string>(lines), 2, "trailing newline adds no line");
    Assert.Equal(Array.Get<string>(lines, 0), "one", "CR removed");
    Assert.Equal(Array.Get<string>(lines, 1), "two", "second line");
    Assert.Equal(Array.Len<string>(String.Lines("")), 0, "empty text has no lines");
}

test string_join_round_trips_split {
    string[] parts = String.Split("a-b-c", "-");
    Assert.Equal(String.Join(parts, "+"), "a+b+c", "join with new separator");
    Assert.Equal(String.Join(Array.Empty<string>(), ","), "", "join of nothing is empty");
}

test string_replace {
    Assert.Equal(String.Replace("a.b.c", ".", "::"), "a::b::c", "replace all");
    Assert.Equal(String.Replace("aaa", "aa", "b"), "ba", "left-to-right non-overlapping");
    Assert.Equal(String.Replace("abc", "", "x"), "abc", "empty pattern is a no-op");
}

test string_repeat_and_pad {
    Assert.Equal(String.Repeat("ab", 3), "ababab", "repeat");
    Assert.Equal(String.Repeat("ab", 0), "", "zero repeat");
    Assert.Equal(String.PadLeft("7", 3, "0"), "007", "pad left");
    Assert.Equal(String.PadRight("ab", 4, "."), "ab..", "pad right");
    Assert.Equal(String.PadLeft("long", 2, "0"), "long", "no truncation");
}

test string_ascii_case {
    Assert.Equal(String.ToUpperAscii("Beskid 0.5!"), "BESKID 0.5!", "upper");
    Assert.Equal(String.ToLowerAscii("BesKID"), "beskid", "lower");
}

test string_trim_start_end_and_affixes {
    Assert.Equal(String.TrimStart("  x "), "x ", "trim start");
    Assert.Equal(String.TrimEnd(" x" + String.Newline()), " x", "trim end includes LF");
    Assert.Equal(String.RemovePrefix("v1.2", "v"), "1.2", "prefix removed");
    Assert.Equal(String.RemovePrefix("1.2", "v"), "1.2", "absent prefix kept");
    Assert.Equal(String.RemoveSuffix("main.bd", ".bd"), "main", "suffix removed");
}

test string_builder_appends {
    mut StringBuilder b = Builder.New();
    b = b.Append("x=");
    b = b.AppendI64(42);
    b = b.AppendAscii(59);
    b = b.AppendBool(true);
    Assert.Equal(b.ToString(), "x=42;true", "builder output");
    Assert.Equal(b.Length(), 9, "builder length");
}

test string_builder_lines {
    mut StringBuilder b = Builder.From("a");
    b = b.AppendLine("");
    b = b.AppendLine("b");
    Assert.Equal(b.ToString(), "a" + String.Newline() + "b" + String.Newline(), "lines");
    Assert.True(Builder.New().IsEmpty(), "new builder is empty");
}
