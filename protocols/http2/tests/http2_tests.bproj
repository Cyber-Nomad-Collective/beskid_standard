http2_tests {
  name = "http2_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_http2" { source = path path = ".." }
target "Http2SmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "HpackIntegerTests" { kind = Lib entry = "HpackIntegerTests.bd" }
target "HpackFieldTests" { kind = Lib entry = "HpackFieldTests.bd" }
target "HpackRequestTests" { kind = Lib entry = "HpackRequestTests.bd" }
target "HpackResponseTests" { kind = Lib entry = "HpackResponseTests.bd" }
target "HpackHuffmanTests" { kind = Lib entry = "HpackHuffmanTests.bd" }
target "HpackMalformedTests" { kind = Lib entry = "HpackMalformedTests.bd" }
target "HpackTableTests" { kind = Lib entry = "HpackTableTests.bd" }
target "HpackEncoderTests" { kind = Lib entry = "HpackEncoderTests.bd" }
