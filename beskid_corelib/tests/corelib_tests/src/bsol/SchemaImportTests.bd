use Core.Bsol.Imports;

use Core.Bsol.Schema;

use Core.Bsol.Limits;

use Core.Hash.Sha256;

use Core.Results;

use Core.Collections.Array;

use Testing.Assert;

/// Owned root source with its verified content digest, as a host materializes it.
Imports.MaterializedSource MaterializeRoot(string source, string identity)
{
    match Sha256.HashUtf8(source, 8388608_i64)
    {
        Result::Error(_) => {
            Assert.Fail("fixture source hashes");
            return Imports.MaterializedSource { source: source, canonicalIdentity: identity, sourceSha256: Array.Empty<u8>() };
        },

        Result::Ok(digest) => {
            return Imports.MaterializedSource { source: source, canonicalIdentity: identity, sourceSha256: digest };
        },
    };
}

/// Deterministic host contract control; proves no production filesystem or lock authority.
type FixtureResolver : Imports.Resolver
{
    bool missing,

    bool corrupt,

    pub Result<Imports.MaterializedSource, Imports.ImportFailure> Resolve(Imports.ImportRequest request)
    {
        if (this.missing)
        {
            return Result::Error(Imports.ImportFailure { code: "MissingCache", message: "fixture has no materialized cache entry" });
        }
        Imports.MaterializedSource materialized = MaterializeRoot("profile \"base.v2\" { version = 2 }", "file:schemas/base.bsol");
        if (this.corrupt)
        {
            // The host claims the digest of other bytes: the library must reject it before parsing.
            Imports.MaterializedSource other = MaterializeRoot("profile \"other.v2\" { version = 2 }", "file:schemas/base.bsol");
            return Result::Ok(Imports.MaterializedSource { source: materialized.source, canonicalIdentity: materialized.canonicalIdentity, sourceSha256: other.sourceSha256 });
        }
        return Result::Ok(materialized);
    }
}

unit RejectImport(bool missing, bool corrupt, string code)
{
    Imports.MaterializedSource root = MaterializeRoot("profile \"local.v2\" { version = 2 import_schema \"base.v2\" { from = file path = \"schemas/base.bsol\" alias = base } }", "file:local.bsol");
    FixtureResolver resolver = FixtureResolver
    {
        missing: missing,

        corrupt: corrupt,
    };
    match Schema.LoadProfile<FixtureResolver>(root, resolver, Limits.DefaultLimits())
    {
        Result::Ok(_) => Assert.Fail("invalid host materialization rejected"),

        Result::Error(errors) => {
            mut bool found = false;
            mut i64 i = 0_i64;
            while (i < Array.Len<Schema.Diagnostic>(errors))
            {
                Schema.Diagnostic error = errors[i];
                if (error.code == code)
                {
                    found = true;
                    Assert.True(error.span.end > error.span.start, "failure points to import declaration");
                    Assert.Equal(error.profile, "local.v2", "import failure retains profile identity");
                }
                i = i + 1_i64;
            }
            Assert.True(found, "exact import materialization diagnostic");
        },
    };
}

/// @native-only
test bsol_schema_import_missing_materialized_cache_is_source_spanned
{
    RejectImport(true, false, "MissingCache");
}

/// @native-only
test bsol_schema_import_source_digest_mismatch_rejects
{
    RejectImport(false, true, "ImportDigestMismatch");
}
