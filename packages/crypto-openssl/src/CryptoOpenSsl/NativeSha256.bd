use Crypto.Scratch;
use CryptoOpenSsl.Native;

/// One-shot SHA-256 through OpenSSL `SHA256`; drop-in for `Crypto.Sha256.Hash`.
/// Streaming hashes (`Sha256State`) stay on the pure kernels.
pub u8[] Hash(u8[] data) {
    u8[] out = Scratch.Bytes(32_i64);
    Native.Sha256Into(data, out);
    return out;
}
