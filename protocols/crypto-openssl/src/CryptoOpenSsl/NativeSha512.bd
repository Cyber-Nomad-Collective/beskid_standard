use Crypto.Scratch;
use CryptoOpenSsl.Native;

/// One-shot SHA-512 through OpenSSL; drop-in for `Crypto.Sha512.Hash512`.
pub u8[] Hash512(u8[] data) {
    u8[] out = Scratch.Bytes(64_i64);
    Native.Sha512Into(data, out);
    return out;
}

/// One-shot SHA-384 through OpenSSL; drop-in for `Crypto.Sha512.Hash384`.
pub u8[] Hash384(u8[] data) {
    u8[] out = Scratch.Bytes(48_i64);
    Native.Sha384Into(data, out);
    return out;
}
