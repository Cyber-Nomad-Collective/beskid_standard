/// Data types for regex matching: spans, span lists, and internal match state.
pub type MatchSpan {
    pub i64 start,
    pub i64 end,
}

pub enum MatchSpanList {
    Nil,
    Cons(MatchSpan head, MatchSpanList tail),
}

pub type MatchStep {
    pub i64 patPos,
    pub i64 textPos,
    pub bool ok,
}
