/// Append for persistent collections that share backing storage.
/// @tier(supported)
use Core.Collections.Array;

/// Returns storage holding the first `logicalEnd` elements of `storage` followed by `value`.
/// Appends in place only when the caller owns the tip (`Len(storage) == logicalEnd`);
/// otherwise another version already grew this storage, so the prefix is copied first.
/// `Array.Append` grows in place when capacity allows, so persistent values must not
/// append to storage they share with a newer version.
pub T[] AppendAt<T>(T[] storage, i64 logicalEnd, T value) {
    if Array.Len<T>(storage) == logicalEnd {
        mut T[] grown = storage;
        Array.Append<T>(grown, value);
        return grown;
    }
    mut T[] copied = CopyPrefix<T>(storage, logicalEnd);
    Array.Append<T>(copied, value);
    return copied;
}

/// Returns fresh storage holding the first `count` elements of `storage`. Persistent values copy
/// through this before any in-place write, so the result never aliases `storage`.
pub T[] CopyPrefix<T>(T[] storage, i64 count) {
    mut T[] copied = Array.Empty<T>();
    mut i64 index = 0;
    while index < count {
        Array.Append<T>(copied, Array.Get<T>(storage, index));
        index = index + 1;
    }
    return copied;
}
