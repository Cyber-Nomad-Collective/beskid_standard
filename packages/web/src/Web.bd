/// Web package root: one HTTP client/server facade over HTTP/1.1 (corelib Http
/// codec), HTTP/2 (Http2), TLS 1.3 with ALPN (Tls) and HTTP/3 over QUIC (Http3,
/// Quic; see Web.WebConfig.Http3Mode).
pub mod Web.WebErrors;
pub mod Web.WebConfig;
pub mod Web.H1Wire;
pub mod Web.Prefixed;
pub mod Web.WebH3;
pub mod Web.WebClient;
pub mod Web.WebServer;

use Core.Results;
use Http.Types;
use Http2.Server;
use Network.Tcp.TcpListener;
use Tls.TlsConfig;
use Web.WebClient;
use Web.WebConfig;
use Web.WebErrors;
use Web.WebH3;
use Web.WebServer;

pub i64 PackageVersion() { return 1_i64; }

/// Sends `request` whose target is an absolute http:// or https:// URL and
/// returns the response (see Web.WebClient).
pub Result<Response, WebError> Send(Request request, WebClientConfig config) {
    return WebClient.Send(request, config);
}

/// Like Send, and also reports the protocol that carried the exchange.
pub Result<WebResponse, WebError> Exchange(Request request, WebClientConfig config) {
    return WebClient.Exchange(request, config);
}

/// Serves TLS connections, dispatching on the negotiated ALPN protocol.
pub Result<i64, WebError> ServeTls(TcpListener listener, TlsServerConfig tls, RequestHandler handler, WebServerConfig config) {
    return WebServer.ServeTls(listener, tls, handler, config);
}

/// Serves plain-TCP connections: HTTP/1.1, and h2c with prior knowledge.
pub Result<i64, WebError> ServePlain(TcpListener listener, RequestHandler handler, WebServerConfig config) {
    return WebServer.ServePlain(listener, handler, config);
}

/// Serves HTTP/3 over QUIC on `address` (an IP literal such as "127.0.0.1")
/// and UDP `port`, with the same handler shape as ServeTls. `tls` is used with
/// ALPN "h3" only. Must run inside a fiber.
pub Result<i64, WebError> ServeQuic(string address, i64 port, TlsServerConfig tls, RequestHandler handler, WebServerConfig config) {
    return WebH3.ServeQuic(address, port, tls, handler, config);
}
