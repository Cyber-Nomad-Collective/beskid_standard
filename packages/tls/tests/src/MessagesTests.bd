use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Results;
use Codec.Hex;
use Testing.Assert;
use Tls.Messages;
use Tls.TlsErrors;
use Tls.Wire;

bool Same(u8[] a, u8[] b) { return Slice.Compare(a, b) == 0_i64; }

u8[] Body(u8[] message) { return Slice.SubSlice(message, 4_i64, Slice.Len(message) - 4_i64); }

i64 ChCode(Result<Messages.ClientHello, TlsError> r) { return match r { Result::Ok(_) => 0_i64, Result::Error(e) => TlsErrors.Code(e), }; }
i64 ShCode(Result<Messages.ServerHello, TlsError> r) { return match r { Result::Ok(_) => 0_i64, Result::Error(e) => TlsErrors.Code(e), }; }

test rfc8448_client_hello_decodes_and_round_trips {
    match Messages.DecodeClientHello(Body(ClientHello())) {
        Result::Error(_) => { Assert.Fail("decode"); },
        Result::Ok(ch) => {
            Assert.Equal<i64>(ch.legacyVersion, 0x0303_i64, "legacy version");
            Assert.Equal<i64>(Slice.Len(ch.sessionId), 0_i64, "empty session id");
            Assert.Equal<i64>(Array.Len<i64>(ch.cipherSuites), 3_i64, "three suites");
            Assert.Equal<i64>(ch.cipherSuites[1], 0x1303_i64, "chacha second");
            Assert.Equal<i64>(Array.Len<Extension>(ch.extensions), 9_i64, "nine extensions");
            Assert.True(Same(Messages.EncodeClientHello(ch), ClientHello()), "re-encodes byte for byte");
            match Messages.ServerName(Messages.Data(ch.extensions, Wire.ExtServerName())) {
                Result::Ok(name) => { Assert.True(name == "server", "SNI server"); },
                Result::Error(_) => { Assert.Fail("sni"); },
            };
            match Messages.ClientShares(Messages.Data(ch.extensions, Wire.ExtKeyShare())) {
                Result::Ok(shares) => {
                    Assert.Equal<i64>(Array.Len<KeyShareEntry>(shares), 1_i64, "one share");
                    KeyShareEntry s = shares[0];
                    Assert.Equal<i64>(s.group, 0x1d_i64, "x25519");
                    Assert.True(Same(s.keyExchange, Hex.Of("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c")), "client public");
                },
                Result::Error(_) => { Assert.Fail("shares"); },
            };
            match Messages.ClientVersions(Messages.Data(ch.extensions, Wire.ExtSupportedVersions())) {
                Result::Ok(vs) => { Assert.True(Messages.InList(vs, 0x0304_i64), "offers 1.3"); },
                Result::Error(_) => { Assert.Fail("versions"); },
            };
            match Messages.U16List(Messages.Data(ch.extensions, Wire.ExtSignatureAlgorithms()), 2_i64) {
                Result::Ok(schemes) => { Assert.Equal<i64>(Array.Len<i64>(schemes), 15_i64, "15 schemes"); },
                Result::Error(_) => { Assert.Fail("schemes"); },
            };
        },
    };
}

test rfc8448_server_messages_decode {
    match Messages.DecodeServerHello(Body(ServerHello())) {
        Result::Error(_) => { Assert.Fail("sh"); },
        Result::Ok(sh) => {
            Assert.Equal<i64>(sh.cipherSuite, 0x1301_i64, "suite");
            Assert.False(Messages.IsRetryRequest(sh), "not HRR");
            Assert.True(Same(Messages.EncodeServerHello(sh), ServerHello()), "SH round trip");
            match Messages.ServerShare(Messages.Data(sh.extensions, Wire.ExtKeyShare())) {
                Result::Ok(s) => { Assert.Equal<i64>(Slice.Len(s.keyExchange), 32_i64, "server share"); },
                Result::Error(_) => { Assert.Fail("server share"); },
            };
        },
    };
    match Messages.DecodeEncryptedExtensions(Body(EncryptedExtensions())) {
        Result::Error(_) => { Assert.Fail("ee"); },
        Result::Ok(exts) => { Assert.Equal<i64>(Array.Len<Extension>(exts), 3_i64, "EE extensions"); },
    };
    match Messages.DecodeCertificate(Body(Certificate())) {
        Result::Error(_) => { Assert.Fail("cert"); },
        Result::Ok(cert) => {
            Assert.Equal<i64>(Array.Len<CertificateEntry>(cert.entries), 1_i64, "one certificate");
            CertificateEntry leaf = cert.entries[0];
            Assert.Equal<i64>(Slice.Len(leaf.data), 432_i64, "432-byte certificate");
            Assert.True(Same(Messages.EncodeCertificate(cert.context, cert.entries), Certificate()), "certificate round trip");
        },
    };
    match Messages.DecodeCertificateVerify(Body(CertificateVerify())) {
        Result::Error(_) => { Assert.Fail("cv"); },
        Result::Ok(cv) => {
            Assert.Equal<i64>(cv.scheme, 0x0804_i64, "rsa_pss_rsae_sha256");
            Assert.Equal<i64>(Slice.Len(cv.signature), 128_i64, "signature");
        },
    };
    match Messages.DecodeNewSessionTicket(Body(NewSessionTicket())) {
        Result::Error(_) => { Assert.Fail("nst"); },
        Result::Ok(t) => {
            Assert.Equal<i64>(t.lifetime, 30_i64, "lifetime");
            Assert.Equal<i64>(Slice.Len(t.ticket), 178_i64, "ticket");
            Assert.Equal<i64>(Array.Len<Extension>(t.extensions), 1_i64, "early_data ext");
        },
    };
}

test malformed_client_hellos_rejected {
    u8[] body = Body(ClientHello());
    i64 n = Slice.Len(body);
    Assert.Equal<i64>(ChCode(Messages.DecodeClientHello(Slice.SubSlice(body, 0_i64, n - 1_i64))), 1050_i64, "truncated: decode_error");
    u8[] longer = Slice.New(n + 1_i64);
    Slice.Copy(longer, 0_i64, body, 0_i64, n);
    Assert.Equal<i64>(ChCode(Messages.DecodeClientHello(longer)), 1050_i64, "trailing byte: decode_error");
    u8[] badSuites = Slice.SubSlice(body, 0_i64, n);
    badSuites[36] = 7_u8;
    Assert.Equal<i64>(ChCode(Messages.DecodeClientHello(badSuites)), 1050_i64, "odd suite length: decode_error");
    u8[] longSession = Slice.SubSlice(body, 0_i64, n);
    longSession[34] = 33_u8;
    Assert.Equal<i64>(ChCode(Messages.DecodeClientHello(longSession)), 1050_i64, "session id above 32: decode_error");
    // Duplicate extension: rewrite the second extension type (ec_point/renegotiation_info) to server_name.
    u8[] dup = Slice.SubSlice(body, 0_i64, n);
    dup[62] = 0_u8;
    dup[63] = 0_u8;
    Assert.Equal<i64>(ChCode(Messages.DecodeClientHello(dup)), 1047_i64, "duplicate extension: illegal_parameter");
}

test malformed_server_hello_and_extensions_rejected {
    u8[] body = Body(ServerHello());
    i64 n = Slice.Len(body);
    Assert.Equal<i64>(ShCode(Messages.DecodeServerHello(Slice.SubSlice(body, 0_i64, 35_i64))), 1050_i64, "truncated SH");
    Result<i64, TlsError> ku = Messages.DecodeKeyUpdate([2_u8]);
    Assert.True(match ku { Result::Error(e) => TlsErrors.Code(e) == 1047_i64, _ => false, }, "KeyUpdate 2 is illegal_parameter");
    Result<string[], TlsError> emptyName = Messages.AlpnList(Hex.Of("0003000000"));
    Assert.True(match emptyName { Result::Error(_) => true, _ => false, }, "empty ALPN name rejected");
    Result<string[], TlsError> alpn = Messages.AlpnList(Messages.EncodeAlpn(["h2", "http/1.1"]));
    Assert.True(match alpn { Result::Ok(l) => Array.Len<string>(l) == 2_i64, _ => false, }, "ALPN round trip");
    Result<string, TlsError> dotted = Messages.ServerName(Messages.EncodeServerName("example.com."));
    Assert.True(match dotted { Result::Error(_) => true, _ => false, }, "trailing dot SNI rejected");
    Result<i64, TlsError> big = Messages.MessageLength(Hex.Of("0b010000"), 0_i64, 4_i64);
    Assert.True(match big { Result::Error(_) => true, _ => false, }, "oversized handshake message rejected");
    Assert.Equal<i64>(n, 86_i64, "SH body length");
}

// RFC 8448 section 3 values.
pub u8[] ClientHello() {
    string s = "010000c00303cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7000006130113031302010000910000000b0009000006"
        + "736572766572ff01000100000a00140012001d0017001800190100010101020103010400230000003300260024001d002099381de560e4bd43d23d8e"
        + "435a7dbafeb3c06e51c13cae4d5413691e529aaf2c002b0003020304000d0020001e0403050306030203080408050806040105010601020104020502"
        + "06020202002d00020101001c00024001";
    return Hex.Of(s);
}
pub u8[] ServerHello() {
    string s = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe"
        + "66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";
    return Hex.Of(s);
}
pub u8[] EncryptedExtensions() { return Hex.Of("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"); }
pub u8[] Certificate() {
    string s = "0b0001b9000001b50001b0308201ac30820115a003020102020102300d06092a864886f70d01010b0500300e310c300a06035504031303727361301e"
        + "170d3136303733303031323335395a170d3236303733303031323335395a300e310c300a0603550403130372736130819f300d06092a864886f70d01"
        + "0101050003818d0030818902818100b4bb498f8279303d980836399b36c6988c0c68de55e1bdb826d3901a2461eafd2de49a91d015abbc9a95137ace"
        + "6c1af19eaa6af98c7ced43120998e187a80ee0ccb0524b1b018c3e0b63264d449a6d38e22a5fda430846748030530ef0461c8ca9d9efbfae8ea6d1d0"
        + "3e2bd193eff0ab9a8002c47428a6d35a8d88d79f7f1e3f0203010001a31a301830090603551d1304023000300b0603551d0f0404030205a0300d0609"
        + "2a864886f70d01010b05000381810085aad2a0e5b9276b908c65f73a7267170618a54c5f8a7b337d2df7a594365417f2eae8f8a58c8f8172f9319cf3"
        + "6b7fd6c55b80f21a03015156726096fd335e5e67f2dbf102702e608ccae6bec1fc63a42a99be5c3eb7107c3c54e9b9eb2bd5203b1c3b84e0a8b2f759"
        + "409ba3eac9d91d402dcc0cc8f8961229ac9187b42b4de10000";
    return Hex.Of(s);
}
pub u8[] CertificateVerify() {
    string s = "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c"
        + "5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e"
        + "063dda65cdf5aea20d53dfacd42f74f3";
    return Hex.Of(s);
}
pub u8[] NewSessionTicket() {
    string s = "040000c90000001efad6aac502000000b22c035d829359ee5ff7af4ec900000000262a6494dc486d2c8a34cb33fa90bf1b0070ad3c498883c9367c09"
        + "a2be785abc55cd226097a3a982117283f82a03a143efd3ff5dd36d64e861be7fd61d2827db279cce145077d454a3664d4e6da4d29ee03725a6a4dafc"
        + "d0fc67d2aea70529513e3da2677fa5906c5b3f7d8f92f228bda40dda721470f9fbf297b5aea617646fac5c03272e970727c621a79141ef5f7de6505e"
        + "5bfbc388e93343694093934ae4d3570008002a000400000400";
    return Hex.Of(s);
}
