}

/// AES-CTR over 64-byte groups (four blocks interleaved) from input offset `meta[0]` up
/// to `meta[2]`; `meta[1]` is the output minus input offset, `meta[3]` the 32-bit block
/// counter, `meta[5]` the round count. Precondition: all ranges are in bounds.
i64 Blocks4(u8[] keys, u8[] tables, u8[] counterBlock, u8[] input, u8[] output, u8[] state, i64[] meta) {
    mut i64 last = 0_i64;
    while meta[0] < meta[2] {
        last = clif {
            %kp1 = payload %0
            %tp2 = payload %1
            %sp3 = payload %5
            %mp4 = payload %6
            %jp5 = payload %2
            %ctr6 = load.i32 %mp4+24
            %j07 = load.i8x16 %jp5
            %v8 = bitcast.i32x4 little %j07
            %v9 = bswap %ctr6
            %v10 = insertlane %v8, %v9, 3
            %cb11 = bitcast.i8x16 little %v10
            %c12 = iconst.i32 1
            %v13 = iadd %ctr6, %c12
            %v14 = bswap %v13
            %v15 = insertlane %v8, %v14, 3
            %cb16 = bitcast.i8x16 little %v15
            %c17 = iconst.i32 2
            %v18 = iadd %ctr6, %c17
            %v19 = bswap %v18
            %v20 = insertlane %v8, %v19, 3
