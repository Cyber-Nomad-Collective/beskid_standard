websocket_tests {
  name = "websocket_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_websocket" { source = path path = ".." }
target "WebSocketSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "WsFrameTests" { kind = Lib entry = "FrameTests.bd" }
target "WsUtf8Tests" { kind = Lib entry = "Utf8Tests.bd" }
target "WsHandshakeTests" { kind = Lib entry = "HandshakeTests.bd" }
target "WsLoopbackTests" { kind = Lib entry = "LoopbackTests.bd" }
target "WsEchoTests" { kind = Lib entry = "EchoTests.bd" }
target "WsServerViolationTests" { kind = Lib entry = "ServerViolationTests.bd" }
target "WsClientViolationTests" { kind = Lib entry = "ClientViolationTests.bd" }
target "WsLargeTests" { kind = Lib entry = "LargeTests.bd" }
target "WsTlsTests" { kind = Lib entry = "TlsTests.bd" }
