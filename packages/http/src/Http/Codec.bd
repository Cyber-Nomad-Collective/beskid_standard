            } else {
                if !HostByte(b) { return false; }
                i = i + 1_i64;
            }
        }
        if i == 0_i64 { return false; }
    }
    if i == count { return true; }
    if String.ByteAt(value, i) != u8(58) { return false; }
    return HostPort(value, i + 1_i64);
}
/// RFC 9112 section 3.2: exactly one Host field line with a valid value. Runs before body framing.
Result<unit,HttpError> HostField(Header[] headers) {
