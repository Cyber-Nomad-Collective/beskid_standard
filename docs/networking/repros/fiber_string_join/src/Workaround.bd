// WORKAROUND: return a code (Fiber<i64>) or a Result instead of a string.
use Concurrency.Fiber;
use Core.Results;
use Testing.Assert;

i64 Code() { return 42_i64; }

test fiber_i64_join {
    Fiber<i64> f = spawn (() => Code());
    Assert.Equal<i64>(match f.Join() { Result::Ok(v) => v, Result::Error(_) => -1_i64, }, 42_i64, "i64 join");
}
