/// Scheduler entry points (`fiber_yield`, monotonic clock, worker pool sizing).
/// Cooperative reschedule of the current fiber.
pub unit Yield() {
    __fiber_yield();
    return;
}

/// Monotonic milliseconds since an unspecified epoch (not wall clock).
pub i64 NowMillis() {
    return __fiber_now_millis();
}

/// Active scheduler worker count. Always 1 in 0.6.0: one mutator thread runs every fiber of a runtime.
pub i64 ProcessorCount() {
    return __fiber_processor_count();
}

/// Sets scheduler worker pool size (Go `GOMAXPROCS` analogue).
/// No-op in 0.6.0; CPU parallelism is planned through isolates (0.6.1-0.6.5).
pub unit SetProcessorCount(i64 count) {
    return;
}
