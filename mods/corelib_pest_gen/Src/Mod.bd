/// Mod AOT entry: SDK Collector + Generator for Pest grammar combinator emission.
/// The Generator contributes typed `FunctionDefinition` syntax only (see `Emit.BuildAll`).
use Beskid.Compiler.Collect;
use Targets;
use Emit;

pub type PestCollector : Collector
{
    pub CollectTargetSet Collect(CollectRequest request)
    {
        return CollectTargetSet
        {
            targetIds: Targets.GrammarTargetIds(),
        };
    }
}

pub type PestGen : Generator
{
    pub GeneratedSyntaxContribution Generate(GenerationRequest request)
    {
        return Emit.BuildAll();
    }
}

pub type PestCollectorFactory : ModFactory<PestCollector>
{
    pub PestCollector Create(CollectRequest context)
    {
        return PestCollector { };
    }
}

pub type PestGenFactory : ModFactory<PestGen>
{
    pub PestGen Create(CollectRequest context)
    {
        return PestGen { };
    }
}
