codec_tests {
  name = "codec_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "CodecSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "CodecBeTests" { kind = Lib entry = "BeTests.bd" }
target "CodecVarintTests" { kind = Lib entry = "VarintTests.bd" }
target "CodecCursorTests" { kind = Lib entry = "CursorTests.bd" }
target "CodecVecTests" { kind = Lib entry = "VecTests.bd" }
target "CodecBuilderTests" { kind = Lib entry = "BuilderTests.bd" }
target "CodecLineTests" { kind = Lib entry = "LineTests.bd" }
target "CodecBufferedTests" { kind = Lib entry = "BufferedTests.bd" }
