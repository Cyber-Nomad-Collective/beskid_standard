use SerializationMod.Syntax;
use SerializationMod.Scalars;
use SerializationMod.Read;
use SerializationMod.Policies;
use SerializationMod.Attributes;
use Core.Collections.Array;
use Beskid.Compiler.Semantic;
use Beskid.Syntax.Nodes;
use Core.Results;
use Testing.Assert;

test serialization_ast_builder_retains_origin_and_unique_labels {
    let origin = Semantic.SpanValue(12_u64, 24_u64, 1_u64, 12_u64, 1_u64, 24_u64);
    let builder = Syntax.Create(origin);
    let first = Syntax.IdentifierValue(builder, "first");
    let second = Syntax.IdentifierValue(builder, "second");
    Assert.True(first.id != second.id, "builder issues unique labels");
    Assert.Equal<u64>(12_u64, first.span.start, "serialization value");
    Assert.Equal<u64>(24_u64, second.span.end, "serialization value");
    Assert.Equal<string>("first", first.node.name, "serialization value");
}

test serialization_scalar_generation_rejects_pointer_and_unconfigured_word {
    let builder = Syntax.CreateWithPaths(Semantic.SpanValue(0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64), FixturePaths());
    let value = Syntax.Local(builder, "value");
    match Scalars.Write(builder, PrimitiveType::Pointer, value, 0_u8) {
        Result::Error(error) => { Assert.Equal<string>("SerializationPointer", error.code, "serialization value"); },
        Result::Ok(_) => { Assert.Fail("pointer must not become a scalar contribution"); },
    };
    match Scalars.Write(builder, PrimitiveType::Word, value, 0_u8) {
        Result::Error(error) => { Assert.Equal<string>("SerializationWordWidth", error.code, "serialization value"); },
        Result::Ok(_) => { Assert.Fail("word requires source-declared width"); },
    };
}

test serialization_scalar_generation_preserves_fixed_width_profile {
    let builder = Syntax.CreateWithPaths(Semantic.SpanValue(0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64), FixturePaths());
    let value = Syntax.Local(builder, "value");
    PrimitiveType[] primitives = [PrimitiveType::Bool, PrimitiveType::I8, PrimitiveType::I16, PrimitiveType::I32, PrimitiveType::I64, PrimitiveType::U8, PrimitiveType::U16, PrimitiveType::U32, PrimitiveType::U64, PrimitiveType::F32, PrimitiveType::F64, PrimitiveType::Char, PrimitiveType::String, PrimitiveType::Unit];
    mut i64 index = 0_i64;
    while (index < 14_i64) {
        match Scalars.Write(builder, primitives[index], value, 0_u8) {
            Result::Ok(_) => { },
            Result::Error(_) => { Assert.Fail("complete fixed width profile must generate"); },
        };
        index = index + 1_i64;
    }
}

test serialization_read_rejects_unbound_nominal_factory {
    Syntax.Builder builder = Syntax.CreateWithPaths(NodeSpan { start: 1_u64, end: 5_u64, lineStart: 1_u64, columnStart: 1_u64, lineEnd: 1_u64, columnEnd: 5_u64 }, FixturePaths());
    SpannedType nominal = Syntax.Named(builder, ["Unbound"], []);
    match Read.Value(builder, nominal, 0_u8, false, Read.Plan([], [], Syntax.PathValue(builder, ["Result"], [])), 0_i64) {
        Result::Ok(_) => { Assert.True(false, "unbound nominal must not receive an invented read factory"); },
        Result::Error(error) => { Assert.Equal<string>("SerializationReadBinding", error.code, "serialization value"); },
    };
}

test serialization_read_array_uses_typed_locals {
    Syntax.Builder builder = Syntax.CreateWithPaths(NodeSpan { start: 1_u64, end: 5_u64, lineStart: 1_u64, columnStart: 1_u64, lineEnd: 1_u64, columnEnd: 5_u64 }, FixturePaths());
    SpannedType array = Syntax.ArrayType(builder, Syntax.Primitive(builder, PrimitiveType::I16));
    match Read.Value(builder, array, 0_u8, false, Read.Plan([], [], Syntax.PathValue(builder, ["Result"], [])), 0_i64) {
        Result::Error(_) => { Assert.True(false, "typed signed array read must generate"); },
        Result::Ok(body) => {
            Assert.Equal<i64>(6_i64, Array.Len(body.statements), "count, limit check, accumulator, index, loop, end");
            Assert.True(Results.IsOk(Syntax.Status(builder)), "every array read path is planned");
            match body.statements[2_i64].node {
                Statement::Let(value) => { Assert.True(value.node.mutable, "array accumulator must be mutable"); },
                _ => { Assert.True(false, "expected typed array accumulator"); },
            };
        },
    };
}

// Structural builder fixtures do not issue semantic path authority. Production
// obtains these routes from the invocation-scoped canonical planner and the
// host revalidates the resulting contributed declarations.
Syntax.CanonicalPath[] FixturePaths() {
    return [
        Syntax.CanonicalPath { logicalName: "Core.Numeric.FloatBits.ToBits32", segments: ["Fixture", "ToBits32"] },
        Syntax.CanonicalPath { logicalName: "Core.Numeric.FloatBits.ToBits64", segments: ["Fixture", "ToBits64"] },
        Syntax.CanonicalPath { logicalName: "Core.Numeric.FloatBits.FromBits32", segments: ["Fixture", "FromBits32"] },
        Syntax.CanonicalPath { logicalName: "Core.Numeric.FloatBits.FromBits64", segments: ["Fixture", "FromBits64"] },
        Syntax.CanonicalPath { logicalName: "Core.Collections.Array.Append", segments: ["Fixture", "Append"] },
        Syntax.CanonicalPath { logicalName: "Core.Serialization.Errors.Diagnostic", segments: ["Fixture", "Diagnostic"] },
    ];
}


test serialization_field_policy_retains_direction_name_and_default_syntax {
    Syntax.Builder builder = Syntax.Create(Semantic.SpanValue(1_u64, 9_u64, 1_u64, 1_u64, 1_u64, 9_u64));
    mut SpannedField field = Syntax.DataField(builder, "sourceName", Syntax.Primitive(builder, PrimitiveType::I32));
    field.node.attributes = SpannedAttributeList { items: [Syntax.AttributeValue(builder, "SerializeField", [
        Syntax.AttributeArgumentValue(builder, "Name", Syntax.Text(builder, "é😀")),
        Syntax.AttributeArgumentValue(builder, "SkipSerialize", Syntax.LiteralValue(builder, Literal::Bool(true))),
        Syntax.AttributeArgumentValue(builder, "Default", Syntax.Text(builder, "Defaults.MakeCount")),
    ])] };
    match Policies.Field(builder, field) {
        Result::Error(_) => { Assert.True(false, "valid source policy must parse"); },
        Result::Ok(policy) => {
            Assert.Equal<string>("é😀", policy.wireName, "serialization value");
            Assert.True(policy.skipWrite, "encoding skip retained");
            Assert.True(!policy.skipRead, "decoding remains active");
            match policy.defaultFactory {
                OptionalSpannedPath::Some(path) => { Assert.Equal<i64>(2_i64, Array.Len(path.node.segments.items), "serialization value"); Assert.Equal<string>("MakeCount", path.node.segments.items[1_i64].node.name.node.name, "serialization value"); },
                _ => { Assert.True(false, "typed factory syntax retained, not a fabricated value"); },
            };
        },
    };
}

test serialization_field_policy_rejects_repeated_arguments_and_missing_skip_default {
    Syntax.Builder builder = Syntax.Create(Semantic.SpanValue(1_u64, 9_u64, 1_u64, 1_u64, 1_u64, 9_u64));
    mut SpannedField field = Syntax.DataField(builder, "count", Syntax.Primitive(builder, PrimitiveType::I32));
    field.node.attributes = SpannedAttributeList { items: [Syntax.AttributeValue(builder, "SerializeField", [
        Syntax.AttributeArgumentValue(builder, "Name", Syntax.Text(builder, "one")), Syntax.AttributeArgumentValue(builder, "Name", Syntax.Text(builder, "two")),
    ])] };
    match Policies.Field(builder, field) { Result::Ok(_) => { Assert.True(false, "repeated policy argument must reject"); }, _ => { }, };
    field.node.attributes = SpannedAttributeList { items: [Syntax.AttributeValue(builder, "SerializeField", [Syntax.AttributeArgumentValue(builder, "SkipDeserialize", Syntax.LiteralValue(builder, Literal::Bool(true)))])] };
    match Policies.Field(builder, field) { Result::Ok(_) => { Assert.True(false, "skipped read must have a source factory"); }, _ => { }, };
}

test serialization_mod_declares_typed_field_policy_parameters {
    let declarations = Attributes.Declarations();
    Assert.Equal<i64>(2_i64, Array.Len(declarations.declarations), "serialization value");
    Assert.Equal<string>("SerializeField", declarations.declarations[1_i64].node.name.node.name, "serialization value");
    Assert.Equal<i64>(7_i64, Array.Len(declarations.declarations[1_i64].node.parameters.items), "six field policies plus the catchall selection");
    Assert.Equal<string>("Catchall", declarations.declarations[1_i64].node.parameters.items[6_i64].node.name.node.name, "catchall is an explicit field policy");
}
