/// Typed failures shared by the symmetric primitives and the entropy source.
pub enum CryptoError {
    /// An AEAD tag or MAC did not verify. No plaintext is released.
    AuthenticationFailed(),
    /// A key has a length the algorithm does not accept.
    InvalidKeyLength(),
    /// A nonce or IV has a length the algorithm does not accept.
    InvalidNonceLength(),
    /// An input is too short, too long, or not a multiple of the required size.
    InvalidLength(),
    /// A requested output exceeds the algorithm limit (for example HKDF 255 * HashLen).
    OutputTooLong(),
    /// The operating system CSPRNG is not available or returned an error.
    EntropyUnavailable(),
}
