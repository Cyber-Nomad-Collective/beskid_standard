/// Core.Collections.Array hub — typed array helpers and checked iterators.
/// @tier(standard)
pub mod Core.Collections.Array.ArrayIter;

use Core.Collections.Array.ArrayIter;

/// Allocates an empty managed array using the descriptor for `T`.
pub T[] Empty<T>()
{
    return __array_new<T>(0);
}

/// Allocates `length` zero-filled elements (null for reference elements) in one rooted
/// allocation. Length and capacity both equal `length`; a negative length traps (`bounds`).
pub T[] Zeroed<T>(i64 length)
{
    return __array_new<T>(length);
}

/// Bulk constructor: packs call-site scalars into a typed array.
/// The `bulk` parameter is the array itself; `Of` is the identity that gives
/// call-site packing semantics (N scalars → one rooted array).
pub T[] Of<T>(bulk T[] values)
{
    return values;
}

/// Returns the array's logical element count.
pub i64 Len<T>(T[] values)
{
    return __array_len(values);
}

pub bool IsEmpty<T>(T[] values)
{
    return Len<T>(values) == 0;
}

pub ArrayIter<T> Iterate<T>(T[] values)
{
    return ArrayIter<T>
    {
        index: 0,
        length: Len<T>(values),
    };
}

pub bool HasNext<T>(ArrayIter<T> iterator)
{
    return iterator.index < iterator.length;
}

pub T Current<T>(T[] values, ArrayIter<T> iterator)
{
    return values[iterator.index];
}

pub ArrayIter<T> Advance<T>(ArrayIter<T> iterator)
{
    return ArrayIter<T>
    {
        index: iterator.index + 1,
        length: iterator.length,
    };
}

pub i64 Index<T>(ArrayIter<T> iterator)
{
    return iterator.index;
}

/// Uses direct typed bounds-checked array access.
pub T Get<T>(T[] values, i64 index)
{
    return values[index];
}

/// Uses direct typed bounds-checked array access and returns the owning handle.
pub T[] Set<T>(T[] values, i64 index, T value)
{
    values[index] = value;
    return values;
}

/// Returns allocation capacity without changing logical length.
pub i64 Capacity<T>(T[] values)
{
    // Canonical calls are lowered to a direct header read. This body remains ordinary and
    // conservative when inspected independently.
    return Len<T>(values);
}

/// Appends `value` and returns the array that holds it.
/// When the first argument owns its array (a local, a `mut` parameter or an aggregate field), the
/// compiler lowers the call to the rooted growth operation and updates the owner's slot, so
/// `Array.Append<T>(items, v);` needs no rebinding. Growing one handle never changes what another
/// handle to the same array sees (its length, or the elements written after the growth): when
/// another handle can see the array (`ys = xs`, a field, a capture, a list element, an argument
/// kept by the callee, a returned array), the growth copies it into a new array that only the
/// owner holds. An array no other handle can see grows in place while capacity remains; growth is
/// geometric (the replacement holds twice the length, at least 4 elements), so a sequence of
/// appends costs amortized O(1) per element.
/// A `mut` parameter is passed by value: its growth changes only the callee's copy of the handle.
/// While the parameter still holds the caller's handle, the first growth copies the array, so the
/// caller's array never changes, whatever its capacity; return the grown array to publish it.
/// Any other array (a parameter that is not `mut`, a loop or pattern variable, a call result, an
/// element) is not owned by the caller: this body copies it into a fresh array, appends there and
/// returns the copy, and the argument is unchanged.
pub T[] Append<T>(mut T[] values, T value)
{
    mut T[] grown = Copy<T>(values);
    Append<T>(grown, value);
    return grown;
}

/// Checked rooted append. False leaves the owner and logical contents unchanged; an array whose
/// owner is not proven (see `Append`) is never extended, so the call returns false.
/// Argument evaluation follows ordinary source semantics before checked admission.
pub bool TryAppend<T>(mut T[] values, T value)
{
    // Exact registered declaration is lowered as a checked owner transaction.
    return false;
}

/// Clears a live slot through descriptor-aware typed storage. The length does not change: like
/// any element write, the cleared slot is visible through every handle to the array.
pub T[] Clear<T>(T[] values, i64 index)
{
    // Canonical calls lower to a descriptor-typed zero store at `index`.
    return values;
}

/// Clears the final live slot and decreases logical length by one, and returns the shortened
/// array. Shrinking one handle never changes what another handle to the same array sees: when the
/// first argument owns its array (a local, a `mut` parameter or an aggregate field, as for
/// `Append`) and no other handle can see it, the array is shortened in place; when another handle
/// can see it, the owner receives a shortened copy and the other handles keep the old length and
/// last element. Any other array (a parameter that is not `mut`, an element, a call result) is
/// not owned by the caller: the call returns a shortened copy and the argument is unchanged.
pub T[] RemoveLast<T>(T[] values)
{
    // Canonical calls lower to the owner-aware shrink described above.
    return values;
}

/// A new array with the same elements (a shallow copy). The copy is owned by the caller, so it
/// can be stored where a borrowed array cannot.
pub T[] Copy<T>(T[] values)
{
    i64 length = __array_len(values);
    T[] copy = __array_new<T>(length);
    CopyRange<T>(copy, 0, values, 0, length);
    return copy;
}

pub unit CopyRange<T>(T[] destination, i64 destinationOffset, T[] source, i64 sourceOffset, i64 length)
{
    mut i64 index = 0;
    while (index < length)
    {
        Set<T>(destination, destinationOffset + index, Get<T>(source, sourceOffset + index));
        index = index + 1;
    }
    return;
}
