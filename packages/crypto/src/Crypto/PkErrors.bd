/// Typed failures of the public-key half of Crypto (X25519, P-256, ECDSA, RSA, big integers).
/// Every public-key entry point fails closed with one of these values; none carries secret data.
pub enum PkError {
    /// An input byte string has the wrong length for its role.
    InvalidLength(),
    /// A big-integer encoding does not fit the requested width, or a value is out of its range.
    OutOfRange(),
    /// A modulus is even, too small, or larger than the supported maximum.
    InvalidModulus(),
    /// A public exponent is even, below 3, or not below the modulus.
    InvalidExponent(),
    /// A SEC1 point encoding is malformed, off the curve, or the identity.
    InvalidPoint(),
    /// A private scalar is zero or not below the group order.
    InvalidScalar(),
    /// A key agreement produced the all-zero or identity shared secret.
    ZeroSharedSecret(),
    /// A signature is malformed (encoding, length, or range) before any verification math.
    MalformedSignature(),
    /// A well-formed signature does not verify.
    BadSignature(),
    /// A digest length does not match the selected hash.
    InvalidDigest(),
    /// Signing failed to find a usable nonce within the bounded retry count.
    SigningFailed(),
}
