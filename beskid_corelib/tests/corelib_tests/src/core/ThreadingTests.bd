/// Threading module tests — OS-thread surface (gate-level; Spawn/Join bodies not evaluated).

use Testing.Assert;
use Core.Threading.Thread;
use Core.Threading.ThreadError;
use Core.Results;


test thread_yield_returns_unit {
    Thread.Yield();
    Assert.True(true, "Yield returns unit without crashing");
}

test thread_spawn_returns_result_shape {
    Core.Results.Result<Thread.Thread, ThreadError> result =
        Thread.Spawn(0_i64, 0_i64);
    Assert.True(Results.IsOk(result) || Results.IsError(result), "Spawn returns a Result");
}
