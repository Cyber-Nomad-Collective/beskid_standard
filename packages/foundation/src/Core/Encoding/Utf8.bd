/// UTF-8 encoding (language default).
/// @tier(standard)
use Core.Bytes.Slice;
use Core.Collections.Array;
use Core.Encoding.EncodingError;
use Core.Results;
use Core.String;

pub u8[] CopyCodeUnits(string text) {
    i64 len = String.Len(text);
    u8[] buf = Slice.New(len);
    mut i64 i = 0;
    while i < len {
        Slice.Set(buf, i, String.ByteAt(text, i));
        i = i + 1;
    }
    return buf;
}

pub Core.Results.Result<u8[], EncodingError> EncodeToBytes(string text) {
    return Result::Ok(CopyCodeUnits(text));
}

pub bool IsValid(u8[] data) {
    i64 len = Slice.Len(data);
    mut i64 i = 0;
    while i < len {
        u8 b = Slice.Get(data, i);
        if b < 128 {
            i = i + 1;
            continue;
        }
        // RFC 3629: C0/C1 are overlong leads; F5..FF exceed the Unicode range.
        if b < 194 || b > 244 {
            return false;
        }
        i64 need = String.Utf8RuneByteLen(b);
        if need > len - i {
            return false;
        }
        u8 second = Slice.Get(data, i + 1);
        if b == 224 && second < 160 { return false; }
        if b == 237 && second >= 160 { return false; }
        if b == 240 && second < 144 { return false; }
        if b == 244 && second >= 144 { return false; }
        mut i64 j = 1;
        while j < need {
            u8 cont = Slice.Get(data, i + j);
            if cont < 128 || cont >= 192 {
                return false;
            }
            j = j + 1;
        }
        i = i + need;
    }
    return true;
}

pub Core.Results.Result<string, EncodingError> DecodeFromBytes(u8[] data) {
    if !IsValid(data) {
        return Result::Error(EncodingError::InvalidSequence(EncodingErrorDetail { position: 0, value: 0 }));
    }
    return Result::Ok(String.FromUtf8CodeUnits(data));
}

/// Appends the UTF-8 encoding of scalar value `cp` (`0..=0x10FFFF`, not a surrogate) to `bytes`.
pub u8[] AppendCodePoint(u8[] bytes, i64 cp) {
    mut u8[] out = bytes;
    if cp < 128 {
        out = Array.Append<u8>(out, u8(cp));
        return out;
    }
    if cp < 2048 {
        out = Array.Append<u8>(out, u8(192 + cp / 64));
        out = Array.Append<u8>(out, u8(128 + cp % 64));
        return out;
    }
    if cp < 65536 {
        out = Array.Append<u8>(out, u8(224 + cp / 4096));
        out = Array.Append<u8>(out, u8(128 + (cp / 64) % 64));
        out = Array.Append<u8>(out, u8(128 + cp % 64));
        return out;
    }
    out = Array.Append<u8>(out, u8(240 + cp / 262144));
    out = Array.Append<u8>(out, u8(128 + (cp / 4096) % 64));
    out = Array.Append<u8>(out, u8(128 + (cp / 64) % 64));
    out = Array.Append<u8>(out, u8(128 + cp % 64));
    return out;
}
