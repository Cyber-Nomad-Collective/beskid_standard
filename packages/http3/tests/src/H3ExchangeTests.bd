mod ExchangeTests
{
    test GetExchangeInMemory {
        QuicLink[] pair = H3Quic.NewPair();
        mut H3Conn client = H3Client.Connect(Array.Get<QuicLink>(pair, 0_i64), Config(false));
        mut H3Conn server = H3Server.Accept(Array.Get<QuicLink>(pair, 1_i64), Config(false));
        i64 id = StartOk(client, Get("/hello"));
        Assert.Equal<i64>(id, 0_i64, "first client bidirectional stream");
        H3Incoming incoming = H3Server.Next(server);
        Assert.Equal<i64>(incoming.streamId, 0_i64, "request arrives");
        Request request = incoming.request;
        Assert.Equal<string>(request.method, "GET", "method");
        Assert.Equal<string>(request.target, "/hello", "target");
        Header hostHeader = Array.Get<Header>(request.headers, 0_i64);
        Assert.Equal<string>(hostHeader.value, "example.com", "host from :authority");
        Assert.True(H3Connection.PeerSettingsReceived(server), "server saw client SETTINGS");
        H3Incoming none = H3Server.Next(server);
        Assert.Equal<i64>(none.streamId, -1_i64, "delivered once");
        RespondOk(server, id, "hello");
        H3Outcome outcome = H3Client.Poll(client, id);
        Assert.Equal<i64>(outcome.state, H3Client.Ready(), "response ready");
        Response response = outcome.response;
        Assert.Equal<i64>(response.status, 200_i64, "status");
        Assert.Equal<string>(response.reason, "OK", "default reason phrase");
        Assert.True(Hpack.BytesEqual(response.body, Convert.StringToBytes("hello")), "body");
        Assert.True(H3Connection.PeerSettingsReceived(client), "client saw server SETTINGS");
        Assert.Equal<i64>(H3Connection.ErrorCode(client), -1_i64, "client healthy");
        Assert.Equal<i64>(H3Connection.ErrorCode(server), -1_i64, "server healthy");
    }

    test PostDynamicQpackAndTrailers {
        QuicLink[] pair = H3Quic.NewPair();
        mut H3Conn client = H3Client.Connect(Array.Get<QuicLink>(pair, 0_i64), Config(true));
        mut H3Conn server = H3Server.Accept(Array.Get<QuicLink>(pair, 1_i64), Config(true));
        mut i64 round = 0_i64;
        while round < 3_i64 {
            // Each round sends its own body: the request owns it once stored.
            u8[] body = Slice.New(20000_i64);
            body[19999] = 7_u8;
            mut Header[] headers = Array.Empty<Header>();
            Array.Append<Header>(headers, Header { name: "Host", value: "example.com" });
            Array.Append<Header>(headers, Header { name: "X-Custom-Token", value: "abcdefghijklmnop" });
            Request post = Request { method: "POST", target: "/upload", headers: headers, body: body };
            i64 id = StartOk(client, post);
            Assert.Equal<i64>(id, round * 4_i64, "request stream id");
            H3Incoming incoming = H3Server.Next(server);
            Assert.Equal<i64>(incoming.streamId, id, "request arrives");
            Request request = incoming.request;
            Assert.Equal<i64>(Slice.Len(request.body), 20000_i64, "body spans two DATA frames");
            Assert.Equal<i64>(i64(request.body[19999]), 7_i64, "body content");
            mut HeaderField[] trailers = Array.Empty<HeaderField>();
            Array.Append<HeaderField>(trailers, Hpack.Field("x-checksum", "42"));
            Response response = Types.EmptyResponse(201_i64, "Created");
            Result<unit,H3Error> sent = H3Server.RespondWithTrailers(server, id, response, trailers);
            H3Outcome outcome = H3Client.Poll(client, id);
            Assert.Equal<i64>(outcome.state, H3Client.Ready(), "response ready");
            Response got = outcome.response;
            Assert.Equal<i64>(got.status, 201_i64, "status");
            HeaderField[] received = H3Client.Trailers(client, id);
            Assert.Equal<i64>(Array.Len<HeaderField>(received), 1_i64, "trailers");
            round = round + 1_i64;
        }
        QDecoder serverDecoder = server.decoder;
        Assert.True(QpackTable.InsertCount(serverDecoder.table) > 0_i64, "client encoder used the dynamic table");
        QEncoder clientEncoder = client.encoder;
        Assert.True(QpackEncoder.KnownReceived(clientEncoder) > 0_i64, "inserts acknowledged");
        Assert.Equal<i64>(H3Connection.ErrorCode(client), -1_i64, "client healthy");
        Assert.Equal<i64>(H3Connection.ErrorCode(server), -1_i64, "server healthy");
    }

    test GoawayGracefulShutdown {
        QuicLink[] pair = H3Quic.NewPair();
        mut H3Conn client = H3Client.Connect(Array.Get<QuicLink>(pair, 0_i64), Config(false));
        mut H3Conn server = H3Server.Accept(Array.Get<QuicLink>(pair, 1_i64), Config(false));
        i64 first = StartOk(client, Get("/a"));
        H3Incoming incoming = H3Server.Next(server);
        Assert.Equal<i64>(incoming.streamId, first, "first request accepted");
        Assert.True(H3Server.Shutdown(server), "GOAWAY sent");
        i64 second = StartOk(client, Get("/b"));
        Assert.Equal<i64>(second, 4_i64, "second request raced the GOAWAY");
        RespondOk(server, first, "a");
        H3Incoming rejected = H3Server.Next(server);
        Assert.Equal<i64>(rejected.streamId, -1_i64, "request above the GOAWAY id is not delivered");
        H3Outcome done = H3Client.Poll(client, first);
        Assert.Equal<i64>(done.state, H3Client.Ready(), "accepted request completes");
        Assert.Equal<i64>(H3Connection.GoawayReceived(client), 4_i64, "GOAWAY id");
        H3Outcome retry = H3Client.Poll(client, second);
        Assert.Equal<i64>(retry.state, H3Client.Failed(), "raced request fails");
        Assert.Equal<i64>(H3Errors.CodeOf(retry.error), H3Errors.RequestRejected(), "safe to retry");
        Result<i64,H3Error> refused = H3Client.Start(client, Get("/c"));
        match refused {
            Result::Ok(_) => { Assert.Fail("no new requests after GOAWAY"); },
            Result::Error(error) => { Assert.Equal<i64>(H3Errors.CodeOf(error), H3Errors.RequestRejected(), "going away"); },
        };
        H3Client.Close(client);
        Assert.Equal<i64>(H3Quic.CloseCode(Array.Get<QuicLink>(pair, 1_i64)), H3Errors.NoError(), "closed with H3_NO_ERROR");
    }
}

mod PeerTests
{
    test ClientRejectsPushAndServerRules {
        QuicLink[] p1 = H3Quic.NewPair();
        QuicLink fake1 = Array.Get<QuicLink>(p1, 1_i64);
        i64 c1 = Uni(fake1, "000400");
        mut H3Conn client1 = H3Client.Connect(Array.Get<QuicLink>(p1, 0_i64), H3Connection.DefaultConfig());
        i64 id1 = PeerStartOk(client1);
        bool promised = H3Quic.Write(fake1, id1, Hex.Of("050100"), false);
        H3Outcome o1 = H3Client.Poll(client1, id1);
        Assert.Equal<i64>(H3Connection.ErrorCode(client1), H3Errors.IdError(), "PUSH_PROMISE without MAX_PUSH_ID");
        QuicLink[] p2 = H3Quic.NewPair();
        QuicLink fake2 = Array.Get<QuicLink>(p2, 1_i64);
        i64 c2 = Uni(fake2, "0004000d0100");
        mut H3Conn client2 = H3Client.Connect(Array.Get<QuicLink>(p2, 0_i64), H3Connection.DefaultConfig());
        i64 id2 = PeerStartOk(client2);
        H3Outcome o2 = H3Client.Poll(client2, id2);
        Assert.Equal<i64>(H3Connection.ErrorCode(client2), H3Errors.FrameUnexpected(), "MAX_PUSH_ID sent to a client");
        QuicLink[] p3 = H3Quic.NewPair();
        QuicLink fake3 = Array.Get<QuicLink>(p3, 1_i64);
        i64 c3 = Uni(fake3, "000400");
        mut H3Conn client3 = H3Client.Connect(Array.Get<QuicLink>(p3, 0_i64), H3Connection.DefaultConfig());
        i64 id3 = PeerStartOk(client3);
        i64 serverBidi = H3Quic.OpenBidi(fake3);
        H3Outcome o3 = H3Client.Poll(client3, id3);
        Assert.Equal<i64>(H3Connection.ErrorCode(client3), H3Errors.StreamCreationError(), "server-initiated bidirectional stream");
        QuicLink[] p4 = H3Quic.NewPair();
        QuicLink fake4 = Array.Get<QuicLink>(p4, 1_i64);
        i64 c4 = Uni(fake4, "000400070102");
        mut H3Conn client4 = H3Client.Connect(Array.Get<QuicLink>(p4, 0_i64), H3Connection.DefaultConfig());
        i64 id4 = PeerStartOk(client4);
        H3Outcome o4 = H3Client.Poll(client4, id4);
        Assert.Equal<i64>(H3Connection.ErrorCode(client4), H3Errors.IdError(), "GOAWAY with a non-request stream id");
    }

    test BlockedRequestResumesAfterEncoderData {
        QuicLink[] p = H3Quic.NewPair();
        QuicLink fake = Array.Get<QuicLink>(p, 0_i64);
        i64 control = Uni(fake, "000400");
        i64 encoderStream = Uni(fake, "02");
        mut H3Conn server = H3Server.Accept(Array.Get<QuicLink>(p, 1_i64), H3Connection.DefaultConfig());
        H3Incoming before = H3Server.Next(server);
        // Required Insert Count 1, Base 1; :method GET :scheme https :path /
        // static, then the dynamic entry 0 (:authority example.com).
        i64 id = H3Quic.OpenBidi(fake);
        bool sent = H3Quic.Write(fake, id, Hex.Of("0106" + "0200d1d7c180"), true);
        H3Incoming blocked = H3Server.Next(server);
        Assert.Equal<i64>(blocked.streamId, -1_i64, "blocked on the encoder stream");
        Assert.Equal<i64>(H3Connection.ErrorCode(server), -1_i64, "blocking is not an error");
        bool inserted = H3Quic.Write(fake, encoderStream, Hex.Of("3fe11f" + "c00b6578616d706c652e636f6d"), false);
        H3Incoming resumed = H3Server.Next(server);
        Assert.Equal<i64>(resumed.streamId, id, "request decoded after the insert");
        Request request = resumed.request;
        Header hostHeader = Array.Get<Header>(request.headers, 0_i64);
        Assert.Equal<string>(hostHeader.value, "example.com", "authority from the dynamic table");
        u8[] acks = H3Quic.Read(fake, 11_i64, 64_i64);
        Assert.Equal<string>(Hex.Encode(acks), "0380", "decoder stream type, then Section Acknowledgment for stream 0");
    }
}

// HTTP/3 over real QUIC + TLS 1.3 on 127.0.0.1: a Beskid HTTP/3 client and
// server (RFC 9114) over the Beskid QUIC endpoint (RFC 9000/9001). One heavy
// test (codegen reaches TLS, X.509, QUIC and HTTP/3): ALPN "h3", a GET with a
// response body, a POST with a 20000-byte body, the server's GOAWAY, then the
// client's GOAWAY and CONNECTION_CLOSE with H3_NO_ERROR.

// ------------------------------------------------------------ scenario
mod QuicLoopbackTests
{
    test OverQuicTlsLoopback
    {
        Fiber<i64> scenario = spawn Scenario();
        i64 result = match (scenario.Join())
        {
            Result::Ok(v) => v,
            Result::Error(_) => -1_i64,
        };
        if (result != 0_i64)
        {
            Assert.Fail("HTTP/3 over QUIC loopback failed at step " + Dec(result));
        }
        Assert.Equal<i64>(result, 0_i64, "HTTP/3 over QUIC loopback");
    }
}
