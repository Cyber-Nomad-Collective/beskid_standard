/// Testing.Expect — typed expectations whose failure messages show the expected and actual
/// values, complementing the generic `Testing.Assert` helpers.
/// @tier(supported)
/// Every helper fails the running test through `Assert.Fail`, so the first failed expectation
/// stops the test. `Equal` shows values through `Core.Text.Formatting`; array helpers show
/// strings quoted; f64 values use `Number.FormatGeneral`.
use Core.Collections.Array;
use Core.Optional.Option;
use Core.Results;
use Core.String.Search;
use Core.Text.Formatting;
use Core.Text.Number;
use Testing.Assert;

/// Message tail for an optional `because` explanation.
string Reason(string because) {
    if because == "" {
        return "";
    }
    return " (" + because + ")";
}

string Quoted(string text) {
    return "\"" + text + "\"";
}

/// Fails unless `actual == expected`. The failure shows both values through `Formatting`.
/// @par(T) Type of values being compared.
pub unit Equal<T>(T actual, T expected, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) where T: Formatting {
    if actual != expected {
        Assert.FailEqual(expected.Format(), actual.Format(), because, file, line, column);
    }
}

/// Fails unless `actual` is within `tolerance` of `expected`. NaN never matches.
pub unit NearF64(f64 actual, f64 expected, f64 tolerance, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    f64 diff = actual - expected;
    if !(diff <= tolerance && diff >= 0.0 - tolerance) {
        Assert.Fail("expected " + Number.FormatGeneral(expected) + " +/- " + Number.FormatGeneral(tolerance) + " but was " + Number.FormatGeneral(actual) + Reason(because), file, line, column);
    }
}

/// Fails unless `text` contains `needle`.
pub unit ContainsText(string text, string needle, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    if Search.IndexOf(text, needle) < 0 {
        Assert.Fail("expected " + Quoted(text) + " to contain " + Quoted(needle) + Reason(because), file, line, column);
    }
}

/// Fails unless `text` starts with `prefix`.
pub unit StartsWithText(string text, string prefix, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    if !Search.StartsWith(text, prefix) {
        Assert.Fail("expected " + Quoted(text) + " to start with " + Quoted(prefix) + Reason(because), file, line, column);
    }
}

/// Fails unless the arrays have equal lengths and elements, naming the first difference.
pub unit EqualI64Array(i64[] actual, i64[] expected, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    i64 actualCount = Array.Len<i64>(actual);
    i64 expectedCount = Array.Len<i64>(expected);
    if actualCount != expectedCount {
        Assert.Fail("expected " + "${expectedCount}" + " elements but was " + "${actualCount}" + Reason(because), file, line, column);
        return;
    }
    mut i64 i = 0;
    while i < actualCount {
        if Array.Get<i64>(actual, i) != Array.Get<i64>(expected, i) {
            Assert.Fail("element " + "${i}" + ": expected " + "${Array.Get<i64>(expected, i)}" + " but was " + "${Array.Get<i64>(actual, i)}" + Reason(because), file, line, column);
            return;
        }
        i = i + 1;
    }
}

/// Fails unless the arrays have equal lengths and elements, naming the first difference.
pub unit EqualStringArray(string[] actual, string[] expected, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    i64 actualCount = Array.Len<string>(actual);
    i64 expectedCount = Array.Len<string>(expected);
    if actualCount != expectedCount {
        Assert.Fail("expected " + "${expectedCount}" + " elements but was " + "${actualCount}" + Reason(because), file, line, column);
        return;
    }
    mut i64 i = 0;
    while i < actualCount {
        if Array.Get<string>(actual, i) != Array.Get<string>(expected, i) {
            Assert.Fail("element " + "${i}" + ": expected " + Quoted(Array.Get<string>(expected, i)) + " but was " + Quoted(Array.Get<string>(actual, i)) + Reason(because), file, line, column);
            return;
        }
        i = i + 1;
    }
}

/// Fails unless `value` is `Some`.
pub unit IsSome<T>(Option<T> value, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    match value {
        Option::Some(_) => {
            return;
        },
        Option::None => {
            Assert.Fail("expected Some but was None" + Reason(because), file, line, column);
        },
    };
}

/// Fails unless `value` is `None`.
pub unit IsNone<T>(Option<T> value, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    match value {
        Option::Some(_) => {
            Assert.Fail("expected None but was Some" + Reason(because), file, line, column);
        },
        Option::None => {
            return;
        },
    };
}

/// Fails unless `value` is `Ok`.
pub unit IsOk<T, E>(Result<T, E> value, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    match value {
        Result::Ok(_) => {
            return;
        },
        Result::Error(_) => {
            Assert.Fail("expected Ok but was Error" + Reason(because), file, line, column);
        },
    };
}

/// Fails unless `value` is `Error`.
pub unit IsError<T, E>(Result<T, E> value, string because = "", [CallerFilePath] string file = "", [CallerLineNumber] i64 line = 0, [CallerColumnNumber] i64 column = 0) {
    match value {
        Result::Ok(_) => {
            Assert.Fail("expected Error but was Ok" + Reason(because), file, line, column);
        },
        Result::Error(_) => {
            return;
        },
    };
}
