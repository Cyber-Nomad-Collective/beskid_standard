//! The known-answer vectors of the crypto tests, defined once. `SymShaTests`, `SymHmacHkdfTests`,
//! `SymAesTests`, `SymChaChaTests` and `SymLongVectorsTests` run them through the selected provider;
//! `ProviderTests` runs the same vectors through the pure kernels and the native provider.
use Crypto.Hmac;
use TestSupport;

/// A message and its expected digest (hex).
pub type DigestVector
{
    pub string label;
    pub u8[] message;
    pub string digest;
}

/// An RFC 4231 HMAC case: key and message (hex), the compared tag length and the expected tag.
pub type HmacVector
{
    pub string label;
    pub HashAlgorithm algorithm;
    pub string key;
    pub string message;
    pub i64 length;
    pub string tag;
}

/// An AEAD case: inputs and the expected ciphertext followed by the tag (hex).
pub type AeadVector
{
    pub string label;
    pub u8[] key;
    pub u8[] nonce;
    pub u8[] aad;
    pub u8[] plaintext;
    pub string sealed;
}

/// A long AEAD case over `LongKey`, `LongNonce`, `LongAad` and `LongMessage`: the expected
/// value is SHA-256(ciphertext || tag).
pub type LongAeadVector
{
    pub string label;
    pub i64 keyLength;
    pub i64 length;
    pub string sealedDigest;
}

/// FIPS 180-4 two-block example message (448 bits).
pub string Fips180TwoBlockMessage()
{
    return "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
}

/// FIPS 180-4 example message of 896 bits.
pub string Fips180LongMessage()
{
    return "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
}

/// RFC 8439 section 2.8.2 plaintext.
pub string Sunscreen()
{
    return "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
}

/// FIPS 180-4 SHA-256 examples.
pub DigestVector[] Sha256Vectors()
{
    return [DigestVector
    {
        label: "SHA-256 abc",
        message: Ascii("abc"),
        digest: "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    }, DigestVector
    {
        label: "SHA-256 empty message",
        message: Ascii(""),
        digest: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    }, DigestVector
    {
        label: "SHA-256 448-bit message",
        message: Ascii(Fips180TwoBlockMessage()),
        digest: "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    }, DigestVector
    {
        label: "SHA-256 896-bit message",
        message: Ascii(Fips180LongMessage()),
        digest: "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
    }];
}

