crypto_tests {
  name = "crypto_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_crypto" { source = path path = ".." }
target "CryptoSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "SymSha" { kind = Lib entry = "SymShaTests.bd" }
target "SymShaMillion" { kind = Lib entry = "SymShaMillionTests.bd" }
target "SymHmacHkdf" { kind = Lib entry = "SymHmacHkdfTests.bd" }
target "SymChaCha" { kind = Lib entry = "SymChaChaTests.bd" }
target "SymAes" { kind = Lib entry = "SymAesTests.bd" }
target "SymEntropy" { kind = Lib entry = "SymEntropyTests.bd" }
target "SymConstantTime" { kind = Lib entry = "SymConstantTimeTests.bd" }
target "SymThroughput" { kind = Lib entry = "SymThroughputTests.bd" }
