/// Concrete fluent SGR builder implementing `Ansi.Contracts.AnsiStyleStep` shapes.
use Ansi.Contracts.AnsiStyleStep;
use Ansi.Escape;
use Ansi.Sgr;
use Console.Capabilities;

/// Real `AnsiStyleStep` conformance through inline type-body methods, the same shape as the
/// other step builders (`CursorBuilder`, `EraseBuilder`, ...). Each step returns `This`, as the
/// contract declares, and emits exactly the bytes of the free function of the same name below. The free functions stay
/// for existing callers. A bare `Name(...)` call inside a method resolves to the sibling method
/// of that name when one exists, so the methods call `AppendCode`/`IntoPrefix` as methods and
/// never delegate to a same-named free function.
pub type StyleChain : AnsiStyleStep {
    string openCodes,

    pub This Bold() {
        return AppendCode("1");
    }

    pub This Dim() {
        return AppendCode("2");
    }

    pub This Italic() {
        return AppendCode("3");
    }

    pub This Underline() {
        return AppendCode("4");
    }

    pub This Inverse() {
        return AppendCode("7");
    }

    pub This Strike() {
        return AppendCode("9");
    }

    pub This FgBasic(i64 code) {
        return AppendCode("${code}");
    }

    pub This BgBasic(i64 code) {
        return AppendCode("${code}");
    }

    pub This Fg256(i64 index) {
        return AppendCode("38;5;${index}");
    }

    pub This Bg256(i64 index) {
        return AppendCode("48;5;${index}");
    }

    pub This FgRgb(i64 r, i64 g, i64 b) {
        return AppendCode(Ansi.Sgr.ForegroundColorArgs(r, g, b));
    }

    pub This BgRgb(i64 r, i64 g, i64 b) {
        return AppendCode(Ansi.Sgr.BackgroundColorArgs(r, g, b));
    }

    pub string ApplyTo(string text) {
        if !Capabilities.ShouldEmitAnsi() {
            return text;
        }
        return "${IntoPrefix()}${text}${Reset()}";
    }

    pub string IntoPrefix() {
        if openCodes == "" {
            return "";
        }
        return Escape.Csi(openCodes, "m");
    }

    pub This AppendCode(string code) {
        if openCodes == "" {
            return StyleChain { openCodes: code };
        }
        return StyleChain { openCodes: "${openCodes};${code}" };
    }
}

/// Starts a new style chain.
pub StyleChain New() {
    return StyleChain { openCodes: "" };
}

pub StyleChain Bold(StyleChain chain) {
    return AppendCode(chain, "1");
}

pub StyleChain Dim(StyleChain chain) {
    return AppendCode(chain, "2");
}

pub StyleChain Italic(StyleChain chain) {
    return AppendCode(chain, "3");
}

pub StyleChain Underline(StyleChain chain) {
    return AppendCode(chain, "4");
}

pub StyleChain Inverse(StyleChain chain) {
    return AppendCode(chain, "7");
}

pub StyleChain Strike(StyleChain chain) {
    return AppendCode(chain, "9");
}

pub StyleChain FgBasic(StyleChain chain, i64 code) {
    return AppendCode(chain, "${code}");
}

pub StyleChain BgBasic(StyleChain chain, i64 code) {
    return AppendCode(chain, "${code}");
}

pub StyleChain Fg256(StyleChain chain, i64 index) {
    return AppendCode(chain, "38;5;${index}");
}

pub StyleChain Bg256(StyleChain chain, i64 index) {
    return AppendCode(chain, "48;5;${index}");
}

pub StyleChain FgRgb(StyleChain chain, i64 r, i64 g, i64 b) {
    return AppendCode(chain, Ansi.Sgr.ForegroundColorArgs(r, g, b));
}

pub StyleChain BgRgb(StyleChain chain, i64 r, i64 g, i64 b) {
    return AppendCode(chain, Ansi.Sgr.BackgroundColorArgs(r, g, b));
}

pub StyleChain Foreground256(StyleChain chain, i64 index) {
    return Fg256(chain, index);
}

pub StyleChain Background256(StyleChain chain, i64 index) {
    return Bg256(chain, index);
}

pub StyleChain ForegroundRgb(StyleChain chain, i64 r, i64 g, i64 b) {
    return FgRgb(chain, r, g, b);
}

pub StyleChain BackgroundRgb(StyleChain chain, i64 r, i64 g, i64 b) {
    return BgRgb(chain, r, g, b);
}

pub string IntoPrefix(StyleChain chain) {
    return Open(chain);
}

pub string Open(StyleChain chain) {
    if chain.openCodes == "" {
        return "";
    }
    return Escape.Csi(chain.openCodes, "m");
}

pub string ApplyTo(StyleChain chain, string text) {
    return Apply(chain, text);
}

pub string Apply(StyleChain chain, string text) {
    if !Capabilities.ShouldEmitAnsi() {
        return text;
    }
    return "${Open(chain)}${text}${Reset()}";
}

pub string Reset() {
    return Escape.Csi("0", "m");
}

pub StyleChain AppendCode(StyleChain chain, string code) {
    if chain.openCodes == "" {
        return StyleChain { openCodes: code };
    }
    return StyleChain { openCodes: "${chain.openCodes};${code}" };
}
