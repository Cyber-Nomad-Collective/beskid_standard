web_tests {
  name = "web_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_web" { source = path path = ".." }
target "WebSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "WebPlain" { kind = Lib entry = "WebPlainTests.bd" }
target "WebHttpsH1" { kind = Lib entry = "WebHttpsH1Tests.bd" }
target "WebHttpsH2" { kind = Lib entry = "WebHttpsH2Tests.bd" }
target "WebHttp3" { kind = Lib entry = "WebHttp3Tests.bd" }
target "WebHttp3Fallback" { kind = Lib entry = "WebHttp3FallbackTests.bd" }
