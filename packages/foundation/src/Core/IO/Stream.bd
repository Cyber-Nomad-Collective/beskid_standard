use Core.IO.Reader;
use Core.IO.Writer;
use Core.IO.Closer;

/// A byte stream: the Reader, Writer, and idempotent Closer obligations in one contract.
/// A Stream value converts to each embedded contract, so transports reuse Core.IO.ReadExact
/// and WriteAll directly.
/// @tier(standard)
pub contract Stream {
    Reader;
    Writer;
    Closer;
}
