use Testing.Assert;
use Core.Bytes.Slice;
use Crypto.ConstantTime;

test constant_time_equal {
    u8[] a = [1_u8, 2_u8, 3_u8, 4_u8];
    u8[] b = [1_u8, 2_u8, 3_u8, 4_u8];
    u8[] c = [1_u8, 2_u8, 3_u8, 5_u8];
    u8[] d = [129_u8, 2_u8, 3_u8, 4_u8];
    Assert.True(ConstantTime.Equal(a, b), "equal");
    Assert.False(ConstantTime.Equal(a, c), "last byte differs");
    Assert.False(ConstantTime.Equal(a, d), "high bit differs");
    Assert.False(ConstantTime.Equal(a, [1_u8, 2_u8, 3_u8]), "length differs");
    Assert.True(ConstantTime.Equal(Slice.New(0_i64), Slice.New(0_i64)), "empty");
}

test constant_time_equal_range {
    u8[] a = [9_u8, 1_u8, 2_u8, 3_u8];
    u8[] b = [1_u8, 2_u8, 3_u8];
    Assert.True(ConstantTime.EqualRange(a, 1_i64, b, 0_i64, 3_i64), "range equal");
    Assert.False(ConstantTime.EqualRange(a, 0_i64, b, 0_i64, 3_i64), "range differs");
    Assert.False(ConstantTime.EqualRange(a, 2_i64, b, 0_i64, 3_i64), "out of range is false");
    Assert.False(ConstantTime.EqualRange(a, -1_i64, b, 0_i64, 1_i64), "negative offset is false");
}

test constant_time_is_zero_and_wipe {
    Assert.Equal<u32>(ConstantTime.IsZero(0_u32), 1_u32, "zero");
    Assert.Equal<u32>(ConstantTime.IsZero(1_u32), 0_u32, "one");
    Assert.Equal<u32>(ConstantTime.IsZero(0x80000000_u32), 0_u32, "top bit");
    Assert.Equal<u32>(ConstantTime.IsZero(0xFFFFFFFF_u32), 0_u32, "all ones");
    u8[] key = [7_u8, 8_u8, 9_u8];
    ConstantTime.Wipe(key);
    Assert.True(ConstantTime.Equal(key, Slice.New(3_i64)), "wiped");
}
