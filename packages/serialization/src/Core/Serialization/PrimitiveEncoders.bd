use Core.Results;
use Core.Numeric.FloatBits;
use Core.Serialization.Contracts;
use Core.Serialization.Errors;
use Core.Serialization.Limits;

// Canonical leaf field writes. The field codec correspondence issues these exact functions for
// an abstract field whose current application is a scalar; each one writes its declared width,
// the same calls the generated encoder makes for a declared scalar field. A target-width word
// has no declared wire width here and is never issued.

pub Result<unit, SerializationError> WriteUnit<E>(unit value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteUnit()?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteBoolean<E>(bool value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteBoolean(value)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteSigned8<E>(i8 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteSigned(i64(value), 8_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteSigned16<E>(i16 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteSigned(i64(value), 16_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteSigned32<E>(i32 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteSigned(i64(value), 32_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteSigned64<E>(i64 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteSigned(value, 64_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteUnsigned8<E>(u8 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteUnsigned(u64(value), 8_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteUnsigned16<E>(u16 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteUnsigned(u64(value), 16_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteUnsigned32<E>(u32 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteUnsigned(u64(value), 32_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteUnsigned64<E>(u64 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteUnsigned(value, 64_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteFloat32<E>(f32 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteFloat(u64(FloatBits.ToBits32(value)), 32_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteFloat64<E>(f64 value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteFloat(FloatBits.ToBits64(value), 64_u8)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteScalar<E>(char value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteScalar(value)?;
    return Result::Ok(());
}

pub Result<unit, SerializationError> WriteString<E>(string value, E encoder, SerializationLimits limits) where E: Encoder {
    encoder.WriteString(value)?;
    return Result::Ok(());
}
