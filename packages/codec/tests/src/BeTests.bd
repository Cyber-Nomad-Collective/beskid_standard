use Testing.Assert;
use Core.Results;
use Codec.Be;
use Codec.Errors;
use Codec.Hex;

bool IsErr<T>(Result<T, CodecError> r) { return match r { Result::Error(_) => true, Result::Ok(_) => false, }; }
bool IsKind(Result<i64, CodecError> r, CodecError want) {
    return match r {
        Result::Ok(_) => false,
        Result::Error(e) => match e {
            CodecError::Truncated => match want { CodecError::Truncated => true, _ => false, },
            CodecError::Overflow => match want { CodecError::Overflow => true, _ => false, },
            CodecError::InvalidValue => match want { CodecError::InvalidValue => true, _ => false, },
            _ => false,
        },
    };
}
i64 Val(Result<i64, CodecError> r) { return match r { Result::Ok(v) => v, Result::Error(_) => -999_i64, }; }

test read_u8_u16_u24_u32 {
    u8[] b = Hex.Of("01 02 03 04 05 06 07 08");
    Assert.Equal<i64>(Val(Be.ReadU8(b, 0_i64)), 1_i64, "u8");
    Assert.Equal<i64>(Val(Be.ReadU16(b, 0_i64)), 0x0102_i64, "u16");
    Assert.Equal<i64>(Val(Be.ReadU24(b, 0_i64)), 0x010203_i64, "u24");
    Assert.Equal<i64>(Val(Be.ReadU32(b, 0_i64)), 0x01020304_i64, "u32");
    Assert.Equal<i64>(Val(Be.ReadU16(b, 6_i64)), 0x0708_i64, "u16 at end");
}

test read_u48_u64 {
    u8[] b = Hex.Of("01 02 03 04 05 06 07 08");
    Assert.Equal<i64>(Val(Be.ReadU48(b, 1_i64)), 0x020304050607_i64, "u48");
    Assert.Equal<i64>(Val(Be.ReadU64(b, 0_i64)), 0x0102030405060708_i64, "u64");
}

test high_bit_values_are_unsigned_below_width_8 {
    u8[] b = Hex.Of("ff ff ff ff ff ff ff ff");
    Assert.Equal<i64>(Val(Be.ReadU16(b, 0_i64)), 65535_i64, "u16");
    Assert.Equal<i64>(Val(Be.ReadU24(b, 0_i64)), 16777215_i64, "u24");
    Assert.Equal<i64>(Val(Be.ReadU32(b, 0_i64)), 4294967295_i64, "u32");
    Assert.Equal<i64>(Val(Be.ReadU48(b, 0_i64)), 281474976710655_i64, "u48");
    Assert.Equal<i64>(Val(Be.ReadU64(b, 0_i64)), -1_i64, "u64 raw pattern");
}

test read_truncated_and_bad_args {
    u8[] b = Hex.Of("01 02 03");
    Assert.True(IsKind(Be.ReadU32(b, 0_i64), CodecError::Truncated()), "u32 of 3 bytes");
    Assert.True(IsKind(Be.ReadU16(b, 2_i64), CodecError::Truncated()), "u16 at last byte");
    Assert.True(IsKind(Be.ReadU8(b, 3_i64), CodecError::Truncated()), "u8 past end");
    Assert.True(IsKind(Be.ReadU8(b, -1_i64), CodecError::Truncated()), "negative offset");
    Assert.True(IsKind(Be.ReadUint(b, 0_i64, 0_i64), CodecError::InvalidValue()), "width 0");
    Assert.True(IsKind(Be.ReadUint(b, 0_i64, 9_i64), CodecError::InvalidValue()), "width 9");
}

test write_round_trip {
    u8[] b = Hex.Of("00 00 00 00 00 00 00 00 00 00");
    Assert.False(IsErr(Be.WriteU16(b, 0_i64, 0xBEEF_i64)), "w16");
    Assert.False(IsErr(Be.WriteU24(b, 2_i64, 0xABCDEF_i64)), "w24");
    Assert.False(IsErr(Be.WriteU32(b, 5_i64, 0xDEADBEEF_i64)), "w32");
    Assert.Equal<string>(Hex.Encode(b), "beefabcdefdeadbeef00", "layout");
    Assert.Equal<i64>(Val(Be.ReadU16(b, 0_i64)), 0xBEEF_i64, "r16");
    Assert.Equal<i64>(Val(Be.ReadU32(b, 5_i64)), 0xDEADBEEF_i64, "r32");
}

test write_u48_u64 {
    u8[] b = Hex.Of("00 00 00 00 00 00 00 00 00 00 00 00 00 00");
    Assert.False(IsErr(Be.WriteU48(b, 0_i64, 0x010203040506_i64)), "w48");
    Assert.False(IsErr(Be.WriteU64(b, 6_i64, -2_i64)), "w64 pattern");
    Assert.Equal<string>(Hex.Encode(b), "010203040506fffffffffffffffe", "layout");
    Assert.Equal<i64>(Val(Be.ReadU64(b, 6_i64)), -2_i64, "r64");
}

test write_overflow_and_bounds {
    u8[] b = Hex.Of("11 11 11 11");
    Assert.True(IsErr(Be.WriteU8(b, 0_i64, 256_i64)), "u8 256");
    Assert.True(IsErr(Be.WriteU8(b, 0_i64, -1_i64)), "u8 -1");
    Assert.True(IsErr(Be.WriteU16(b, 0_i64, 65536_i64)), "u16 65536");
    Assert.True(IsErr(Be.WriteU24(b, 0_i64, 16777216_i64)), "u24 overflow");
    Assert.True(IsErr(Be.WriteU32(b, 0_i64, 4294967296_i64)), "u32 overflow");
    Assert.True(IsErr(Be.WriteU32(b, 1_i64, 1_i64)), "u32 past end");
    Assert.Equal<string>(Hex.Encode(b), "11111111", "failed writes leave buffer unchanged");
}

test encode_helper {
    Result<u8[], CodecError> r = Be.Encode(3_i64, 0x010203_i64);
    match r {
        Result::Ok(b) => { Assert.Equal<string>(Hex.Encode(b), "010203", "enc"); },
        Result::Error(_) => { Assert.Fail("encode failed"); },
    };
    Assert.True(IsErr(Be.Encode(2_i64, 70000_i64)), "overflow");
}
