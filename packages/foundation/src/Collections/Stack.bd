/// LIFO stack backed by `T[]` storage.
/// @tier(supported)
use Collections.Array;
use Core.Results;

pub type Stack<T> {
    T[] storage,
    i64 count,
}

pub Stack<T> New<T>() {
    return Stack<T> { storage: Array.Empty<T>(), count: 0 };
}

pub i64 Count<T>(Stack<T> stack) {
    return stack.count;
}

pub Stack<T> Push<T>(Stack<T> stack, T value) {
    i64 next = stack.count + 1;
    T[] nextStorage = Array.AppendAt<T>(stack.storage, next, value);
    return Stack<T> { storage: nextStorage, count: next };
}

pub Stack<T> Pop<T>(Stack<T> stack) {
    if stack.count <= 0 {
        return Stack<T> { storage: stack.storage, count: 0 };
    }
    return Stack<T> { storage: stack.storage, count: stack.count - 1 };
}

pub Result<T, string> Peek<T>(Stack<T> stack) {
    if stack.count <= 0 {
        return Result::Error("stack is empty");
    }
    return Result::Ok(Array.Get<T>(stack.storage, stack.count - 1));
}
