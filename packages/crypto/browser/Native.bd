use Core.Bytes.Slice;
use Core.Environment;
use Core.Optional.Option;
use Core.String.Utf8;
use Crypto.ConstantTime;

/// OpenSSL remains an optional C binding. The browser profile always reports it absent.
[Extern(Abi: "C", Library: "libcrypto.so.3", Optional: true)]
pub contract LibCrypto
{
    bool Available();
    i64 SHA256(i64 data, i64 count, i64 digest);
    i64 SHA384(i64 data, i64 count, i64 digest);
    i64 SHA512(i64 data, i64 count, i64 digest);
    i64 EVP_sha256();
    i64 EVP_sha384();
    i64 EVP_sha512();
    i64 HMAC(i64 md, i64 key, i32 keyLength, i64 data, i64 count, i64 digest, i64 digestLength);
    i64 EVP_aes_128_gcm();
    i64 EVP_aes_192_gcm();
    i64 EVP_aes_256_gcm();
    i64 EVP_chacha20_poly1305();
    i64 EVP_CIPHER_CTX_new();
    i64 EVP_CIPHER_CTX_free(i64 context);
    i32 EVP_CIPHER_CTX_ctrl(i64 context, i32 command, i32 argument, i64 pointer);
    i32 EVP_EncryptInit_ex(i64 context, i64 cipher, i64 engine, i64 key, i64 iv);
    i32 EVP_EncryptUpdate(i64 context, i64 output, i64 outputLength, i64 input, i32 inputLength);
    i32 EVP_EncryptFinal_ex(i64 context, i64 output, i64 outputLength);
    i32 EVP_DecryptInit_ex(i64 context, i64 cipher, i64 engine, i64 key, i64 iv);
    i32 EVP_DecryptUpdate(i64 context, i64 output, i64 outputLength, i64 input, i32 inputLength);
    i32 EVP_DecryptFinal_ex(i64 context, i64 output, i64 outputLength);
}

pub bool Available()
{
    return LibCrypto.Available();
}

pub i64 MaxEvpLength()
{
    return 1073741824_i64;
}

/// A call to a native-only wrapper cannot expose a browser-managed array payload to C.
pub unit Sha256Into(u8[] data, u8[] digest)
{
    __panic_str("extern_unavailable: SHA256 from libcrypto.so.3");
}

pub unit Sha384Into(u8[] data, u8[] digest)
{
    __panic_str("extern_unavailable: SHA384 from libcrypto.so.3");
}

pub unit Sha512Into(u8[] data, u8[] digest)
{
    __panic_str("extern_unavailable: SHA512 from libcrypto.so.3");
}

pub i64 HmacInto(i64 md, u8[] key, u8[] data, u8[] digest)
{
    __panic_str("extern_unavailable: HMAC from libcrypto.so.3");
}

pub i64 Sha256Md()
{
    return LibCrypto.EVP_sha256();
}

pub i64 Sha384Md()
{
    return LibCrypto.EVP_sha384();
}

pub i64 Sha512Md()
{
    return LibCrypto.EVP_sha512();
}

pub i64 AesGcmCipher(i64 keyLength)
{
    if (keyLength == 16_i64)
    {
        return LibCrypto.EVP_aes_128_gcm();
    }
    if (keyLength == 24_i64)
    {
        return LibCrypto.EVP_aes_192_gcm();
    }
    if (keyLength == 32_i64)
    {
        return LibCrypto.EVP_aes_256_gcm();
    }
    return 0_i64;
}

pub i64 ChaChaCipher()
{
    return LibCrypto.EVP_chacha20_poly1305();
}

pub bool AeadSeal(i64 cipher, u8[] key, u8[] nonce, u8[] aad, u8[] input, i64 inputOffset, i64 count, u8[] output, i64 outputOffset)
{
    if (cipher == 0_i64)
    {
        return false;
    }
    __panic_str("extern_unavailable: EVP_CIPHER_CTX_new from libcrypto.so.3");
}

pub i64 AeadOpen(i64 cipher, u8[] key, u8[] nonce, u8[] aad, u8[] sealed, i64 sealedOffset, i64 count, u8[] output, i64 outputOffset)
{
    if (cipher == 0_i64)
    {
        return 0_i64;
    }
    __panic_str("extern_unavailable: EVP_CIPHER_CTX_new from libcrypto.so.3");
}

pub unit Wipe(u8[] buffer, i64 offset, i64 count)
{
    ConstantTime.WipeRange(buffer, offset, count);
    return;
}

/// Provider variables live in the browser instance's virtual environment.
pub bool EnvEquals(u8[] name, u8[] value)
{
    string expected = CString(value);
    return match (Environment.TryGet(CString(name)))
    {
        Option::Some(found) => found == expected,
        Option::None => false,
    };
}

pub unit SetEnv(u8[] name, u8[] value, bool remove)
{
    string key = CString(name);
    if (remove)
    {
        Environment.Set(key, "");
    }
    else
    {
        Environment.Set(key, CString(value));
    }
    return;
}

string CString(u8[] buffer)
{
    mut i64 length = 0_i64;
    while (length < Slice.Len(buffer) && buffer[length] != 0_u8)
    {
        length = length + 1_i64;
    }
    return Utf8.FromUtf8CodeUnits(Slice.SubSlice(buffer, 0_i64, length));
}
