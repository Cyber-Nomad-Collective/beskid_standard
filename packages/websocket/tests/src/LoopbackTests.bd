use Concurrency;
use Concurrency.Fiber;
use Core.Bytes.Slice;
use Core.Results;
use Core.String;
use Core.Time;
use Core.Time.Deadline;
use Core.Optional.Option;
use Network.Types;
use Network.Tcp.TcpListener;
use Network.Tcp.TcpStream;
use Testing.Assert;
use WebSocket.WsErrors;
use WebSocket.WsConnection;

SocketAddress Loopback4(i64 port) {
    Port value = match Network.Types.PortNumber(port) { Result::Ok(p) => p, Result::Error(_) => Network.Types.PortBytes(0_u8, 0_u8), };
    return SocketAddress { address: IpAddress::V4(127_u8, 0_u8, 0_u8, 1_u8), port: value };
}

Option<Deadline> Within(i64 millis) {
    return match Deadline.After(Time.FromMilliseconds(millis)) {
        Result::Ok(deadline) => Option.FromValue<Deadline>(deadline),
        Result::Error(_) => Option.Empty<Deadline>(),
    };
}

// Echo server for one connection: echoes text and binary until a close arrives.
unit EchoOnce(TcpListener listener) {
    match listener.Accept(Within(5000_i64)) {
        Result::Error(_) => { Assert.Fail("accept"); },
        Result::Ok(stream) => { ServeEcho(stream); },
    };
    return;
}

unit ServeEcho(TcpStream stream) {
    match WsConnection.Accept(stream, WsConnection.DefaultOptions()) {
        Result::Error(_) => { Assert.Fail("server handshake"); },
        Result::Ok(conn) => { EchoLoop(conn); },
    };
    return;
}

unit EchoLoop(WsConnection conn) {
    mut bool running = true;
    while running {
        match conn.Receive() {
            Result::Error(_) => { running = false; },
            Result::Ok(message) => { running = Echo(conn, message); },
        };
    }
    return;
}

bool Echo(WsConnection conn, WsMessage message) {
    return match message {
        WsMessage::Text(text) => Sent(conn.SendText(text)),
        WsMessage::Binary(data) => Sent(conn.SendBinary(data)),
        WsMessage::Close(_, _) => false,
    };
}

bool Sent(Result<unit, WsError> r) { return match r { Result::Ok(_) => true, Result::Error(_) => false, }; }

string Url(TcpListener listener) {
    return match listener.LocalAddress() {
        Result::Ok(address) => "ws://127.0.0.1:" + Dec(address.port.Value()) + "/echo",
        Result::Error(_) => "",
    };
}

string Dec(i64 v) {
    if v < 10_i64 { return String.DigitChar(v); }
    return Dec(v / 10_i64) + String.DigitChar(v % 10_i64);
}

string TextOf(Result<WsMessage, WsError> r) {
    return match r {
        Result::Ok(m) => match m { WsMessage::Text(t) => t, _ => "<not text>", },
        Result::Error(_) => "<error>",
    };
}

unit TextEchoScenario() {
    match TcpListener.Bind(Loopback4(0_i64), 4_i64) {
        Result::Error(_) => { Assert.Fail("bind"); },
        Result::Ok(listener) => {
            TcpListener l = listener;
            Fiber<unit> server = spawn (() => EchoOnce(l));
            match WsConnection.Open(Url(l), WsConnection.DefaultOptions()) {
                Result::Error(e) => { Assert.Equal<i64>(WsErrors.Code(e), 0_i64, "client open"); },
                Result::Ok(conn) => {
                    Assert.True(Sent(conn.SendText("hello")), "send");
                    Assert.True(TextOf(conn.Receive()) == "hello", "echo");
                    Assert.True(Sent(conn.Close(1000_i64, "bye")), "close");
                    Assert.Equal<i64>(conn.CloseCodeReceived(), 1000_i64, "server echoed 1000");
                },
            };
            server.Join();
            l.Close();
        },
    };
    return;
}

test loopback_text_echo {
    Fiber<unit> scenario = spawn TextEchoScenario();
    Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "scenario joins");
}
