/// Handle of one runtime instance (isolate): a process-wide id and nothing else.
///
/// `Isolate` is `[Immutable]`, so it is Shared and may be captured by any task body or sent
/// through a port. It exposes no thread, heap or scheduler.

[Immutable]
pub type Isolate {
    i64 id,

    /// True when both handles name the same isolate.
    pub bool Equals(Isolate other) {
        return this.id == other.id;
    }

    /// Requests cancellation of this isolate alone. Idempotent; a finished isolate ignores it.
    /// The isolate observes the request at its next safepoint.
    pub unit Cancel() {
        __isolate_cancel(this.id);
        return;
    }
}

/// The isolate executing the caller.
pub Isolate Current() {
    return Isolate { id: __isolate_current() };
}

/// The process's first isolate.
pub Isolate Main() {
    return Isolate { id: __isolate_main() };
}

/// The isolate that runs the task `handle` of a live scope. `Scope.Isolate` returns it; the
/// runtime fails closed (traps) on a handle that names no task.
pub Isolate OfTask(i64 handle) {
    return Isolate { id: __isolate_task_isolate(handle) };
}
