        %v603 = bxor %v592, %v602
        %v604 = bitcast.i32x4 little %v603
        %v605 = ushr %v604, %c10
        %v606 = bitcast.i8x16 little %v605
        %k607 = load.i8x16 %tp2+16
        %v608 = swizzle %k607, %v602
        %v609 = bxor %v602, %v606
        %k610 = load.i8x16 %tp2+0
        %v611 = swizzle %k610, %v606
        %v612 = bxor %v611, %v608
        %v613 = swizzle %k610, %v609
        %v614 = bxor %v613, %v608
        %v615 = swizzle %k610, %v612
        %v616 = bxor %v615, %v609
        %v617 = swizzle %k610, %v614
        %v618 = bxor %v617, %v606
        %k619 = load.i8x16 %tp2+80
        %v620 = swizzle %k619, %v616
        %k621 = load.i8x16 %tp2+96
        %v622 = swizzle %k621, %v618
        %v623 = bxor %v620, %v622
        %v624 = bxor %v623, %v600
        %k625 = load.i8x16 %tp2+336
        %v626 = swizzle %v624, %k625
        %k627 = load.i8x16 %tp2+384
        %v628 = bxor %v626, %k627
        %k629 = load.i8x16 %tp2+32
        %v630 = band %v628, %k629
        %v631 = bxor %v628, %v630
        %v632 = bitcast.i32x4 little %v631
        %v633 = ushr %v632, %c10
        %v634 = bitcast.i8x16 little %v633
        %k635 = load.i8x16 %tp2+400
        %v636 = swizzle %k635, %v630
        %k637 = load.i8x16 %tp2+416
        %v638 = swizzle %k637, %v634
        %v639 = bxor %v636, %v638
        store %v18, %op3+0
        store %v39, %op3+16
        store %v88, %op3+32
        store %v131, %op3+48
        store %v179, %op3+64
        store %v222, %op3+80
        store %v270, %op3+96
        store %v313, %op3+112
        store %v361, %op3+128
        store %v404, %op3+144
        store %v452, %op3+160
        store %v495, %op3+176
        store %v543, %op3+192
        store %v586, %op3+208
        store %v639, %op3+224
