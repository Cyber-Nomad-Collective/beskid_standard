                %v36 = bitcast.i32x4 little %v31
                %v37 = ushr %v33, %c32
                %v38 = ushr %v34, %c32
                %v39 = ushr %v35, %c32
                %v40 = ushr %v36, %c32
                %v41 = bitcast.i8x16 little %v37
