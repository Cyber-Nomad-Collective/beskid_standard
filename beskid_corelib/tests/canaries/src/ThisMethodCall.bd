/// Canary: A method can call another method on `this`.
/// Fails on 0.5.2; passes once the gap is fixed.

use Testing.Assert;

pub type Counter {
    i64 n,

    pub i64 Double() {
        return this.n * 2;
    }

    pub i64 Quadruple() {
        return this.Double() * 2;
    }
}

test method_calls_sibling_method_on_this {
    Assert.True(Counter { n: 3 }.Quadruple() == 12, "this.Method() inside a method");
}
