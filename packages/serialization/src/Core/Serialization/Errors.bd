use Core.Results;

/// Diagnostic storage is private: published failures cannot be mutated by callers.
pub type ErrorDiagnostic {
    string code,
    string path,
    i64 start,
    i64 end,
    bool hasRelated,
    i64 relatedStart,
    i64 relatedEnd,
}

/// The payload-free failure is suitable for exact-specialization admission.
/// Constructing this variant in ordinary code still uses normal allocation.
/// Only the canonical checked boundary returns a reserved, rooted Result cell.
pub enum SerializationError {
    Diagnostic(ErrorDiagnostic value),
    AllocationFailure(),
}

pub SerializationError Diagnostic(string code, string path, i64 start, i64 end, bool hasRelated, i64 relatedStart, i64 relatedEnd) {
    return SerializationError::Diagnostic(ErrorDiagnostic { code: code, path: path, start: start, end: end, hasRelated: hasRelated, relatedStart: relatedStart, relatedEnd: relatedEnd });
}

pub SerializationError NumericError(string code) {
    return Diagnostic(code, "", -1_i64, -1_i64, false, -1_i64, -1_i64);
}

pub string Code(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.code; }, SerializationError::AllocationFailure => { return "AllocationFailed"; }, };
}
pub string Path(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.path; }, SerializationError::AllocationFailure => { return ""; }, };
}
pub i64 Start(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.start; }, SerializationError::AllocationFailure => { return -1_i64; }, };
}
pub i64 End(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.end; }, SerializationError::AllocationFailure => { return -1_i64; }, };
}
pub bool HasRelated(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.hasRelated; }, SerializationError::AllocationFailure => { return false; }, };
}
pub i64 RelatedStart(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.relatedStart; }, SerializationError::AllocationFailure => { return -1_i64; }, };
}
pub i64 RelatedEnd(SerializationError error) {
    match error { SerializationError::Diagnostic(value) => { return value.relatedEnd; }, SerializationError::AllocationFailure => { return -1_i64; }, };
}

/// Source constructor for admission of one concrete Result specialization.
/// It allocates normally and therefore must finish before checked invocation.
pub Result<T, SerializationError> AllocationFailureResult<T>() {
    return Result::Error(SerializationError::AllocationFailure);
}
