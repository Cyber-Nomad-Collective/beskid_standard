x509_tests {
  name = "x509_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../beskid_corelib" }
target "X509SmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "Der" { kind = Lib entry = "DerTests.bd" }
target "Pem" { kind = Lib entry = "PemTests.bd" }
target "Certificates" { kind = Lib entry = "CertificateTests.bd" }
target "Hostname" { kind = Lib entry = "HostnameTests.bd" }
target "ChainRsa" { kind = Lib entry = "ChainRsaTests.bd" }
target "ChainEc" { kind = Lib entry = "ChainEcTests.bd" }
target "Bundle" { kind = Lib entry = "BundleTests.bd" }
target "CertReject" { kind = Lib entry = "CertRejectTests.bd" }
