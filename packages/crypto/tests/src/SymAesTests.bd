use Testing.Assert;
use Core.Bytes.Slice;
use Core.Results;
use Crypto.Errors;
use Crypto.Aes;
use Crypto.AesGcm;
use TestSupport;
use Vectors;

u8[] Range(i64 n)
{
    return Pattern(n, 1, 0);
}

test AesEncryptsTheFips197AppendixCBlocks
{
    u8[] plaintext = Hex("00112233445566778899aabbccddeeff");
    Assert.True(Same(Unwrap(Aes.Encrypt(Range(16), plaintext)), Hex("69c4e0d86a7b0430d8cdb78070b4c55a")), "AES-128 C.1");
    Assert.True(Same(Unwrap(Aes.Encrypt(Range(24), plaintext)), Hex("dda97ca4864cdfe06eaf70a0ec0d7191")), "AES-192 C.2");
    Assert.True(Same(Unwrap(Aes.Encrypt(Range(32), plaintext)), Hex("8ea2b7ca516745bfeafc49904b496089")), "AES-256 C.3");
}

test AesRejectsA20ByteKey
{
    bool rejected = match (Aes.NewKey(Slice.New(20_i64)))
    {
        Result::Ok(_) => false,
        Result::Error(e) => match (e)
        {
            CryptoError::InvalidKeyLength => true,
            _ => false,
        },
    };
    Assert.True(rejected, "20-byte key");
}

test AesGcmMatchesTheGcmSpecification
{
    for v in AesGcmVectors()
    {
        match (AesGcm.New(v.key))
        {
            Result::Error(_) => {
                Assert.Fail("key " + v.label);
            },
            Result::Ok(key) => {
                u8[] sealed = Unwrap(AesGcm.Seal(key, v.nonce, v.aad, v.plaintext));
                Assert.True(Same(sealed, Hex(v.sealed)), "sealed " + v.label);
                Assert.True(Same(Unwrap(AesGcm.Open(key, v.nonce, v.aad, sealed)), v.plaintext), "opened " + v.label);
            },
        };
    }
}

test AesGcmRejectsTamperedInputsAndBadNonces
{
    match (AesGcm.New(Hex("feffe9928665731c6d6a8f9467308308")))
    {
        Result::Error(_) => {
            Assert.Fail("key");
        },
        Result::Ok(key) => {
            u8[] sealed = Unwrap(AesGcm.Seal(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), Hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")));
            mut i64 position = 0_i64;
            while (position < Slice.Len(sealed))
            {
                u8[] copy = Slice.SubSlice(sealed, 0_i64, Slice.Len(sealed));
                copy[position] = (copy[position] | 0x80_u8) - (copy[position] & 0x80_u8);
                bool failed = match (AesGcm.Open(key, Hex("cafebabefacedbaddecaf888"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), copy))
                {
                    Result::Ok(_) => false,
                    Result::Error(e) => match (e)
                    {
                        CryptoError::AuthenticationFailed => true,
                        _ => false,
                    },
                };
                Assert.True(failed, "tampered byte rejected");
                position = position + 7_i64;
            }
            bool wrongNonce = match (AesGcm.Open(key, Hex("cafebabefacedbaddecaf889"), Hex("feedfacedeadbeeffeedfacedeadbeefabaddad2"), sealed))
            {
                Result::Ok(_) => false,
                Result::Error(_) => true,
            };
            Assert.True(wrongNonce, "nonce bound");
            bool badNonce = match (AesGcm.Seal(key, Hex("cafebabe"), Hex(""), Hex("")))
            {
                Result::Ok(_) => false,
                Result::Error(e) => match (e)
                {
                    CryptoError::InvalidNonceLength => true,
                    _ => false,
                },
            };
            Assert.True(badNonce, "nonce length");
        },
    };
}
