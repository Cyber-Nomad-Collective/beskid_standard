/// ErrorHandling module tests — ErrorInfo construction and emptiness predicate.

use Testing.Assert;
use Core.ErrorHandling;


test error_info_new_populates_fields {
    ErrorHandling.ErrorInfo info = ErrorHandling.NewErrorInfo("E1", "boom");
    Assert.Equal(info.code, "E1", "code should be populated");
    Assert.Equal(info.message, "boom", "message should be populated");
}

test error_info_empty_when_both_blank {
    Assert.True(ErrorHandling.IsErrorInfoEmpty(ErrorHandling.NewErrorInfo("", "")),
        "IsErrorInfoEmpty should be true when both fields are blank");
}

test error_info_not_empty_when_code_set {
    Assert.False(ErrorHandling.IsErrorInfoEmpty(ErrorHandling.NewErrorInfo("E1", "")),
        "IsErrorInfoEmpty should be false when code is set");
}

test error_info_not_empty_when_message_set {
    Assert.False(ErrorHandling.IsErrorInfoEmpty(ErrorHandling.NewErrorInfo("", "x")),
        "IsErrorInfoEmpty should be false when message is set");
}
