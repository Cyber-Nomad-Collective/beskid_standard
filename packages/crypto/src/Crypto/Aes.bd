                %v29 = bxor %v21, %v26
                %k30 = load.i8x16 %tp2+0
                %v31 = swizzle %k30, %v26
                %v32 = bxor %v31, %v28
                %v33 = swizzle %k30, %v29
                %v34 = bxor %v33, %v28
                %v35 = swizzle %k30, %v32
                %v36 = bxor %v35, %v29
                %v37 = swizzle %k30, %v34
                %v38 = bxor %v37, %v26
                %k39 = load.i8x16 %tp2+80
                %v40 = swizzle %k39, %v36
                %v41 = bxor %v40, %rk10
                %k42 = load.i8x16 %tp2+96
                %v43 = swizzle %k42, %v38
                %v44 = bxor %v41, %v43
                %k45 = load.i8x16 %tp2+112
                %v46 = swizzle %k45, %v36
                %k47 = load.i8x16 %tp2+128
                %v48 = swizzle %k47, %v38
                %v49 = bxor %v46, %v48
                %v50 = swizzle %v44, %k15
                %v51 = bxor %v49, %v50
                %v52 = swizzle %v44, %k19
                %v53 = swizzle %v51, %k15
                %v54 = bxor %v51, %v52
                %v55 = bxor %v53, %v54
