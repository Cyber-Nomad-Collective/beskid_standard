use Core.Bytes.Slice;

/// Portable bulk byte operations for checked Codec.Mem ranges.
pub unit Move(u8[] destination, i64 destinationOffset, u8[] source, i64 sourceOffset, i64 count)
{
    Slice.Copy(destination, destinationOffset, source, sourceOffset, count);
    return;
}

pub unit Zero(u8[] buffer, i64 offset, i64 count)
{
    mut i64 i = 0_i64;
    while (i < count)
    {
        Slice.Set(buffer, offset + i, 0_u8);
        i = i + 1_i64;
    }
    return;
}
