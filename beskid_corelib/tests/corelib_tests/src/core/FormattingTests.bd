/// Core.Text.Formatting: the text form of every primitive type, read directly and through a
/// generic function bounded by `Formatting`.

use Testing.Assert;
use Core.Text.Formatting;

string Show<T>(T value) where T: Formatting
{
    return value.Format();
}

test SignedIntegersFormatAsDecimalDigits
{
    Assert.Equal<string>(Show<i8>(-128_i8), "-128", "i8 minimum");
    Assert.Equal<string>(Show<i16>(32767_i16), "32767", "i16 maximum");
    Assert.Equal<string>(Show<i32>(-7_i32), "-7", "i32");
    Assert.Equal<string>(Show<i64>(9223372036854775807_i64), "9223372036854775807", "i64 maximum");
}

test UnsignedIntegersFormatAsDecimalDigits
{
    Assert.Equal<string>(Show<u8>(255_u8), "255", "u8 maximum");
    Assert.Equal<string>(Show<u16>(65535_u16), "65535", "u16 maximum");
    Assert.Equal<string>(Show<u32>(4294967295_u32), "4294967295", "u32 maximum");
    Assert.Equal<string>(Show<u64>(18446744073709551615_u64), "18446744073709551615", "u64 above the i64 range");
    Assert.Equal<string>(Show<u64>(0_u64), "0", "u64 zero");
    Assert.Equal<string>(Show<word>(word(42_i64)), "42", "word");
}

test FloatsBoolsCharsAndStringsFormatAsText
{
    Assert.Equal<string>(Show<f64>(1.5_f64), "1.5", "f64");
    Assert.Equal<string>(Show<f32>(0.25_f32), "0.25", "f32");
    Assert.Equal<string>(Show<bool>(true), "true", "bool true");
    Assert.Equal<string>(Show<bool>(false), "false", "bool false");
    Assert.Equal<string>(Show<char>('A'), "A", "one-byte char");
    Assert.Equal<string>(Show<char>('é'), "é", "two-byte char");
    Assert.Equal<string>(Show<char>('€'), "€", "three-byte char");
    Assert.Equal<string>(Show<char>('🙂'), "🙂", "four-byte char");
    Assert.Equal<string>(Show<string>("beskid"), "beskid", "string is unchanged");
}
