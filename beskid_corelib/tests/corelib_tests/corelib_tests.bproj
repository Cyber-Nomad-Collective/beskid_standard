corelib_tests {
  name = "corelib_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" {
  source = "path"
  path = "../.."
}

dependency "serialization_mod" {
  source = "path"
  path = "../../../mods/serialization_mod"
}

target "SystemSuite" {
  kind = Lib
  entry = "system/SystemSuite.bd"
}

target "ConsoleSuite" {
  kind = Lib
  entry = "console/ConsoleSuite.bd"
}

target "CoreSuite" {
  kind = Lib
  entry = "core/CoreSuite.bd"
}

target "TestingAssertTests" {
  kind = Lib
  entry = "core/AssertTests.bd"
}

target "TestingExpectTests" {
  kind = Lib
  entry = "core/ExpectTests.bd"
}

target "CoreJsonTests" {
  kind = Lib
  entry = "core/JsonTests.bd"
}

target "CoreMathTests" {
  kind = Lib
  entry = "core/MathTests.bd"
}

target "CoreGenericsTests" {
  kind = Lib
  entry = "core/GenericsTests.bd"
}

target "CompilerSdkSuite" {
  kind = Lib
  entry = "compiler-sdk/CompilerSdkSuite.bd"
}

target "ConcurrencySuite" {
  kind = Lib
  entry = "concurrency/ConcurrencySuite.bd"
}

target "ParallelSuite" {
  kind = Lib
  entry = "parallel/ParallelSuite.bd"
}

target "CollectionsSuite" {
  kind = Lib
  entry = "collections/CollectionsSuite.bd"
}

target "CollectionsExtendedTests" {
  kind = Lib
  entry = "collections/CollectionsExtendedTests.bd"
}

target "QuerySuite" {
  kind = Lib
  entry = "query/QuerySuite.bd"
}

target "TextSuite" {
  kind = Lib
  entry = "text/TextSuite.bd"
}

target "TextNumberTests" {
  kind = Lib
  entry = "text/NumberTests.bd"
}

target "NetworkSuite" {
  kind = Lib
  entry = "network/NetworkSuite.bd"
}

target "HttpCodecTests" {
  kind = Lib
  entry = "http/CodecTests.bd"
}

target "HttpValidationTests" {
  kind = Lib
  entry = "http/ValidationTests.bd"
}

target "HttpSerializationTests" {
  kind = Lib
  entry = "http/SerializationTests.bd"
}

target "HttpExchangeTests" {
  kind = Lib
  entry = "http/ExchangeTests.bd"
}

target "BsolSuite" {
  kind = Lib
  entry = "bsol/BsolSuite.bd"
}

target "BsolLoopStringTests" {
  kind = Lib
  entry = "bsol/LoopStringTests.bd"
}

target "BsolSchemaTests" {
  kind = Lib
  entry = "bsol/SchemaTests.bd"
}

target "BsolSchemaRulesSuite" {
  kind = Lib
  entry = "bsol/SchemaRulesSuite.bd"
}

target "BsolSemanticPrerequisiteTests" {
  kind = Lib
  entry = "bsol/SemanticPrerequisiteTests.bd"
}

target "BsolMigrationTests" {
  kind = Lib
  entry = "bsol/MigrationTests.bd"
}

target "BsolSerializationWireTests" {
  kind = Lib
  entry = "bsol/SerializationWireTests.bd"
}

target "Sha256Tests" {
  kind = Lib
  entry = "hash/Sha256Tests.bd"
}

target "SerializationSuite" {
  kind = Lib
  entry = "serialization/SerializationSuite.bd"
}

target "UnicodeScalarTests" {
  kind = Lib
  entry = "numeric/UnicodeScalarTests.bd"
}

target "SerializationGeneratedSuite" {
  kind = Lib
  entry = "serialization/GeneratedTests.bd"
}

target "SerializationModEligibilitySuite" {
