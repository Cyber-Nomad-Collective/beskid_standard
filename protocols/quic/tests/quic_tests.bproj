quic_tests {
  name = "quic_tests"
  version = "0.1.0"
  root = "src"
}

dependency "corelib" { source = path path = "../../../../corelib-0.5.2-pristine/beskid_corelib" }
dependency "corelib_codec" { source = path path = "../../codec" }
dependency "corelib_quic" { source = path path = ".." }
target "QuicSmokeTests" { kind = Lib entry = "SmokeTests.bd" }
target "QuicProtection" { kind = Lib entry = "ProtectionTests.bd" }
target "QuicFrames" { kind = Lib entry = "FrameTests.bd" }
target "QuicStreams" { kind = Lib entry = "StreamTests.bd" }
target "QuicRecovery" { kind = Lib entry = "RecoveryTests.bd" }
